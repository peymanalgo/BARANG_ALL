<nav class="grid-pagination barang-pagination" aria-label="@AriaLabel">
    <BarangButton Text="@PreviousText" Disabled="@(Disabled || Page <= 1)" Clicked="Previous" />
    <span>@PageLabel @Page</span>
    <BarangButton Text="@NextText" Disabled="Disabled || !HasNext" Clicked="Next" />
</nav>
@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public bool HasNext { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? PageLabel { get; set; }
    [Parameter] public string? PreviousText { get; set; }
    [Parameter] public string? NextText { get; set; }
    [Parameter] public EventCallback Previous { get; set; }
    [Parameter] public EventCallback Next { get; set; }
}
