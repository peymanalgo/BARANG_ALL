@using System.Globalization
@using System.Text.Json
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState

<section class="crud-card stock-adjustment-section" data-adjustment-grid data-warehouse-options="@WarehouseOptions.Count" data-product-options="@ProductOptions.Count" data-reason-options="@ReasonOptions.Count">
    <header class="section-header"><div><h2>@T("اصلاح موجودی", "تسوية المخزون", "Stock Adjustments")</h2><p>@T("اصلاح کنترل‌شده و قابل ردیابی موجودی", "تسوية المخزون المضبوطة والقابلة للتتبع", "Controlled, traceable inventory corrections")</p></div><button type="button" class="btn btn-primary" @onclick="New"><BarangIcon Name="plus" /> @T("افزودن اصلاح", "إضافة تسوية", "Add adjustment")</button></header>
    <div class="crud-toolbar"><label class="crud-search"><span>@T("جستجو", "بحث", "Search")</span><input value="@Search" @oninput="SearchChanged" placeholder='@T("جستجوی مرجع، انبار یا SKU", "بحث عن المرجع أو المستودع أو SKU", "Search reference, warehouse or SKU")' /></label><label class="compact-filter"><span>@T("انبار", "المستودع", "Warehouse")</span><SearchableSelect Options="@WarehouseOptions" Value="@Warehouse" ValueChanged="WarehouseChanged" Placeholder='@T("همه انبارها", "كل المستودعات", "All warehouses")' /></label><button type="button" class="btn btn-secondary" disabled="@Loading" @onclick="Reset"><BarangIcon Name="reset" /> @T("بازنشانی", "إعادة ضبط", "Reset")</button></div>
    @if (Message is not null) { <div class="@(Success ? "inline-success" : "inline-error")" role="@(Success ? "status" : "alert")">@Message</div> }
    @if (FormError is not null && !Dialog) { <div class="inline-error" role="alert">@FormError</div> }
    @if (Loading) { <BarangLoadingState Text='@T("در حال بارگذاری…", "جار التحميل…", "Loading…")' /> }
    else if (LoadError is not null) { <div class="inline-error" role="alert"><span>@LoadError</span><button type="button" class="btn btn-secondary" @onclick="Load" disabled="@Loading">@T("تلاش دوباره", "إعادة المحاولة", "Retry")</button></div> }
    else if (Rows.Count == 0) { <CrudEmptyState Title='@T("اصلاحی یافت نشد", "لم يتم العثور على تسويات", "No adjustments found")' /> }
    else { <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("مرجع", "المرجع", "Reference")</th><th>@T("انبار", "المستودع", "Warehouse")</th><th>@T("محصول / SKU", "منتج / SKU", "Product / SKU")</th><th>@T("تغییر مقدار", "تغير الكمية", "Quantity change")</th><th>@T("دلیل", "السبب", "Reason")</th><th>@T("نوع", "النوع", "Type")</th><th>@T("عملیات", "الإجراءات", "Actions")</th></tr></thead><tbody>@foreach (var row in Rows) { <tr><td dir="ltr">@row.Reference</td><td><strong>@row.WarehouseName</strong><small class="muted">@row.WarehouseCode</small></td><td><strong>@row.ProductName</strong><small class="muted">@row.Sku</small></td><td dir="ltr" class="@(row.QuantityDelta < 0 ? "text-danger" : "text-success")">@row.QuantityDelta.ToString("+#,##0.##;-#,##0.##;0", CultureInfo.CurrentCulture) @row.UomCode</td><td>@row.ReasonCode</td><td><span class="status-badge">@TypeLabel(row.Type)</span></td><td><BarangActionMenu><BarangIconButton Icon="eye" Semantic="info" Label='@T("مشاهده", "عرض", "View")' Clicked="@(() => Open(row))" /></BarangActionMenu></td></tr> }</tbody></table></div><BarangPagination Page="@Page" HasNext="@(Page * PageSize < TotalCount)" Disabled="@Loading" PageLabel="" PreviousText='@T("قبلی", "السابق", "Previous")' NextText='@T("بعدی", "التالي", "Next")' Previous="Previous" Next="Next" /> }
</section>

<BarangModal Open="@Dialog" Title='@T("افزودن اصلاح موجودی", "إضافة تسوية مخزون", "Add stock adjustment")' Size="large" CloseRequested="Close"><ChildContent><div class="form-grid"><label><span>@T("انبار", "المستودع", "Warehouse")</span><SearchableSelect Options="@WarehouseOptions" Value="@Warehouse" ValueChanged="WarehouseChanged" Placeholder='@T("انتخاب انبار", "اختر المستودع", "Choose warehouse")' /></label><label><span>@T("محصول", "المنتج", "Product")</span><SearchableSelect Options="@ProductOptions" Value="@Product" ValueChanged="ProductChanged" Placeholder='@T("انتخاب محصول", "اختر المنتج", "Choose product")' /></label><label><span>SKU</span><SearchableSelect Options="@VariantOptions" Value="@Variant" ValueChanged="VariantChanged" Placeholder='@T("انتخاب SKU", "اختر SKU", "Choose SKU")' /></label><label><span>@T("نوع اصلاح", "نوع التسوية", "Adjustment type")</span><select @bind="Kind"><option value="positive">@T("اضافی", "فائض", "Surplus")</option><option value="negative">@T("کسری", "عجز", "Loss")</option><option value="opening">@T("موجودی اولیه", "الرصيد الافتتاحي", "Opening balance")</option></select></label><label><span>@T("مقدار", "الكمية", "Quantity")</span><input type="number" min="0.01" step="0.01" @bind="Quantity" /></label><label><span>@T("دلیل", "السبب", "Reason")</span><SearchableSelect Options="@ReasonOptions" Value="@Reason" ValueChanged="ReasonChanged" Placeholder='@T("انتخاب دلیل", "اختر السبب", "Choose reason")' /></label><label><span>@T("مرجع", "المرجع", "Reference")</span><input @bind="Reference" dir="ltr" /></label></div>@if (Availability is not null) { <dl class="detail-list"><dt>@T("موجودی فعلی", "المخزون الحالي", "On hand")</dt><dd dir="ltr">@Availability!.OnHand.ToString("N2", CultureInfo.CurrentCulture)</dd><dt>@T("رزروشده", "المحجوز", "Reserved")</dt><dd dir="ltr">@Availability!.Reserved.ToString("N2", CultureInfo.CurrentCulture)</dd><dt>@T("قابل دسترس", "المتاح", "Available")</dt><dd dir="ltr">@Availability!.Available.ToString("N2", CultureInfo.CurrentCulture)</dd><dt>@T("موجودی پس از اصلاح", "المخزون بعد التسوية", "Projected on hand")</dt><dd dir="ltr">@((Availability!.OnHand + SignedQuantity()).ToString("N2", CultureInfo.CurrentCulture))</dd></dl> }@if (FormError is not null) { <div class="inline-error" role="alert">@FormError</div> }</ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="Close">@T("انصراف", "إلغاء", "Cancel")</button><button type="button" class="btn btn-primary" @onclick="AskPost" disabled="@Busy">@T("ثبت اصلاح", "ترحيل التسوية", "Post adjustment")</button></Footer></BarangModal>
<BarangModal Open="@ViewDialog" Title='@T("جزئیات اصلاح موجودی", "تفاصيل تسوية المخزون", "Adjustment details")' Size="medium" CloseRequested="CloseView"><ChildContent>@if (Selected is not null) { <dl class="detail-list"><dt>@T("مرجع", "المرجع", "Reference")</dt><dd dir="ltr">@Selected.Reference</dd><dt>@T("انبار", "المستودع", "Warehouse")</dt><dd>@Selected.WarehouseName (@Selected.WarehouseCode)</dd><dt>@T("محصول / SKU", "منتج / SKU", "Product / SKU")</dt><dd>@Selected.ProductName (@Selected.Sku)</dd><dt>@T("مقدار", "الكمية", "Quantity")</dt><dd dir="ltr">@Selected.QuantityDelta.ToString("N2", CultureInfo.CurrentCulture) @Selected.UomCode</dd><dt>@T("دلیل", "السبب", "Reason")</dt><dd>@Selected.ReasonCode</dd><dt>@T("تاریخ", "التاريخ", "Date")</dt><dd dir="ltr">@Selected.OccurredAtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</dd></dl> }</ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="CloseView">@T("بستن", "إغلاق", "Close")</button></Footer></BarangModal>
<BarangConfirmDialog Open="@ConfirmOpen" Title='@T("ثبت اصلاح موجودی", "ترحيل تسوية المخزون", "Post stock adjustment")' Description="@ConfirmDescription" CancelText='@T("انصراف", "إلغاء", "Cancel")' ConfirmText='@T("تأیید", "تأكيد", "Confirm")' Busy="@Busy" Cancel="CancelConfirm" Confirm="Post" />

@code {
    private sealed record Row(Guid Id,Guid WarehouseId,string WarehouseCode,string WarehouseName,Guid ProductVariantId,string ProductCode,string ProductName,string Sku,string Type,decimal QuantityDelta,string UomCode,string ReasonCode,string Reference,DateTimeOffset OccurredAtUtc,Guid ActorUserId);
    private sealed record Balance(decimal OnHand,decimal Reserved,decimal Available);
    private List<SearchableSelectOption> ReasonOptions=[];
    private string Search="",Warehouse="",Product="",Variant="",Kind="positive",Reason="",Reference="ADJ-"+Guid.NewGuid().ToString("N")[..10].ToUpperInvariant(); private decimal Quantity=1; private int Page=1,TotalCount; private const int PageSize=20; private bool Loading,Dialog,ViewDialog,ConfirmOpen,Busy,Success; private string? Message,ConfirmDescription,FormError,LoadError; private Row? Selected; private Balance? Availability; private List<Row> Rows=[]; private List<SearchableSelectOption> WarehouseOptions=[],ProductOptions=[],VariantOptions=[]; private CancellationTokenSource? SearchCancellation;
    private string Lang=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; private string T(string fa,string ar,string en)=>Lang switch {"en"=>en,"ar"=>ar,_=>fa}; private string TypeLabel(string type)=>type switch {"Adjustment" or "4"=>T("اصلاح","تسوية","Adjustment"),"OpeningBalance" or "7"=>T("موجودی اولیه","الرصيد الافتتاحي","Opening balance"),_=>type};
    private async Task<(string Token,Guid Company)?> Session(){var u=await AuthState.GetAuthenticationStateAsync();return Guid.TryParse(u.User.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.User.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
    protected override async Task OnInitializedAsync(){await LoadSelectors();await LoadReasons();if(ReasonOptions.Count==0)await LoadReasonValues();await Load();}
    private async Task LoadReasons(){try{var s=await Session();if(s is null)return;var r=await Core.GetAsync("api/v1/lookups/inventory.adjustment.reason/options?culture="+Lang+"&activeOnly=false",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess)return;var root=r.Value.ValueKind==JsonValueKind.Array?r.Value:r.Value.TryGetProperty("items",out var items)?items:default;if(root.ValueKind==JsonValueKind.Array)ReasonOptions=root.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("code").ToString(),x.TryGetProperty("displayName",out var name)?name.ToString():x.GetProperty("code").ToString())).ToList();}catch{}}
    private async Task LoadReasonValues(){try{var s=await Session();if(s is null)return;var r=await Core.GetAsync("api/v1/lookups/types/inventory.adjustment.reason/values?activeOnly=false",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess)return;var root=r.Value.ValueKind==JsonValueKind.Array?r.Value:r.Value.TryGetProperty("items",out var items)?items:default;if(root.ValueKind==JsonValueKind.Array)ReasonOptions=root.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("code").ToString(),x.GetProperty("code").ToString())).ToList();}catch{}}
    private async Task LoadSelectors(){try{var s=await Session();if(s is null)return;var w=await Core.GetAsync("api/v1/organization/warehouses?pageNumber=1&pageSize=100&sort=code",s.Value.Token,s.Value.Company,default);if(w.IsSuccess){var wi=w.Value.ValueKind==JsonValueKind.Array?w.Value:w.Value.TryGetProperty("items",out var pageItems)?pageItems:default; if(wi.ValueKind==JsonValueKind.Array)WarehouseOptions=[new("",T("همه انبارها","كل المستودعات","All warehouses")),..wi.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("id").ToString(),$"{x.GetProperty("code")} - {x.GetProperty("name")}"))];}var p=await Core.GetAsync("api/v1/products?search=&pageSize=100&activeOnly=true",s.Value.Token,s.Value.Company,default);if(p.IsSuccess){var pi=p.Value.ValueKind==JsonValueKind.Array?p.Value:p.Value.TryGetProperty("items",out var pageItems)?pageItems:default;if(pi.ValueKind==JsonValueKind.Array)ProductOptions=pi.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("id").ToString(),$"{x.GetProperty("productCode")} - {x.GetProperty("name")}")).ToList();}}catch{}}
    private async Task Load(){Loading=true;LoadError=null;try{var s=await Session();if(s is null){LoadError=T("شرکت فعال برای بارگذاری اصلاحات انتخاب نشده است.","لم يتم اختيار شركة نشطة لتحميل التسويات.","No active company is selected for loading adjustments.");return;}var warehouse=Guid.TryParse(Warehouse,out _) ? "&warehouseId="+Warehouse:"";var r=await Core.GetAsync($"api/v1/inventory/adjustments?search={Uri.EscapeDataString(Search)}{warehouse}&pageNumber={Page}&pageSize={PageSize}",s.Value.Token,s.Value.Company,default);Rows=[];TotalCount=0;if(r.IsSuccess&&r.Value.TryGetProperty("items",out var items)){TotalCount=r.Value.TryGetProperty("totalCount",out var total)?total.GetInt32():0;Rows=items.EnumerateArray().Select(Parse).ToList();}else if(!r.IsSuccess)LoadError=T("دریافت اصلاح‌ها انجام نشد؛ دوباره تلاش کنید.","تعذر تحميل التسويات؛ حاول مرة أخرى.","Adjustments could not be loaded; try again.");}catch{Rows=[];TotalCount=0;LoadError=T("دریافت اصلاح‌ها انجام نشد؛ دوباره تلاش کنید.","تعذر تحميل التسويات؛ حاول مرة أخرى.","Adjustments could not be loaded; try again.");}finally{Loading=false;}}
    private static Row Parse(JsonElement x)=>new(x.GetProperty("id").GetGuid(),x.GetProperty("warehouseId").GetGuid(),x.GetProperty("warehouseCode").ToString(),x.GetProperty("warehouseName").ToString(),x.GetProperty("productVariantId").GetGuid(),x.GetProperty("productCode").ToString(),x.GetProperty("productName").ToString(),x.GetProperty("sku").ToString(),x.GetProperty("type").ValueKind==JsonValueKind.Number?x.GetProperty("type").GetInt32().ToString(CultureInfo.InvariantCulture):x.GetProperty("type").ToString(),x.GetProperty("quantityDelta").GetDecimal(),x.GetProperty("uomCode").ToString(),x.GetProperty("reasonCode").ToString(),x.GetProperty("reference").ToString(),x.GetProperty("occurredAtUtc").GetDateTimeOffset(),x.GetProperty("actorUserId").GetGuid());
    private async Task SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";Page=1;SearchCancellation?.Cancel();SearchCancellation?.Dispose();SearchCancellation=new();try{await Task.Delay(250,SearchCancellation.Token);await Load();}catch(OperationCanceledException){}}
    private Task WarehouseChanged(string value){Warehouse=value;Page=1;return Load();} private Task ReasonChanged(string value){Reason=value;return Task.CompletedTask;}
    private async Task ProductChanged(string value){Product=value;Variant="";var s=await Session();if(s is null||!Guid.TryParse(Product,out var id)){VariantOptions=[];return;}var r=await Core.GetAsync($"api/v1/products/{id}/variants/options?limit=100",s.Value.Token,s.Value.Company,default);VariantOptions=r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array?r.Value.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("id").ToString(),x.TryGetProperty("sku",out var sku)?sku.ToString():x.ToString())).ToList():[];}
    private async Task VariantChanged(string value){Variant=value;await LoadAvailability();} private async Task LoadAvailability(){Availability=null;var s=await Session();if(s is null||!Guid.TryParse(Warehouse,out var w)||!Guid.TryParse(Variant,out var v))return;var r=await Core.GetAsync($"api/v1/inventory/balances?warehouseId={w}&variantId={v}&pageNumber=1&pageSize=1",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess)return;var items=r.Value.ValueKind==JsonValueKind.Array?r.Value:r.Value.TryGetProperty("items",out var envelope)?envelope:default;if(items.ValueKind==JsonValueKind.Array&&items.GetArrayLength()>0){var x=items[0];Availability=new(x.GetProperty("onHand").GetDecimal(),x.GetProperty("reserved").GetDecimal(),x.GetProperty("available").GetDecimal());}}
    private decimal SignedQuantity()=>Kind=="negative"?-Math.Abs(Quantity):Math.Abs(Quantity); private Task Reset(){Search=Warehouse="";Page=1;Message=FormError=null;Success=false;return Load();} private Task Previous(){if(Page>1){Page--;return Load();}return Task.CompletedTask;} private Task Next(){if(Page*PageSize<TotalCount){Page++;return Load();}return Task.CompletedTask;}
    private void New(){Dialog=true;FormError=Message=null;Product=Variant=Reason=Warehouse="";VariantOptions=[];Kind="positive";Quantity=1;Reference="ADJ-"+Guid.NewGuid().ToString("N")[..10].ToUpperInvariant();Availability=null;} private void Open(Row row){Selected=row;ViewDialog=true;} private void Close()=>Dialog=false;private void CloseView()=>ViewDialog=false;
    private void AskPost(){if(Kind=="opening"){FormError=T("موجودی اولیه از مسیر اصلاح موجودی پشتیبانی نمی‌شود.","الرصيد الافتتاحي غير مدعوم من مسار تسوية المخزون.","Opening balance is not supported by the stock-adjustment path.");return;}if(!Guid.TryParse(Warehouse,out _)||!Guid.TryParse(Variant,out _)||string.IsNullOrWhiteSpace(Reason)||Quantity<=0){FormError=T("انبار، SKU، دلیل و مقدار مثبت الزامی است.","المستودع وSKU والسبب والكمية الموجبة مطلوبة.","Warehouse, SKU, reason and a positive quantity are required.");return;}ConfirmDescription=T("این اصلاح در موجودی و کاردکس ثبت شود؟","هل تريد ترحيل هذه التسوية إلى المخزون والكاردكس؟","Post this adjustment to stock and Kardex?");ConfirmOpen=true;}
    private void CancelConfirm()=>ConfirmOpen=false; private async Task Post(){ConfirmOpen=false;Busy=true;var s=await Session();if(s is null){Busy=false;return;}var body=new{warehouseId=Guid.Parse(Warehouse),productVariantId=Guid.Parse(Variant),quantity=Math.Abs(Quantity),reference=Reference,reasonCode=Reason};var path=$"api/v1/inventory/adjustments/{(Kind=="positive"?"true":"false")}";var r=await Core.SendAsync(HttpMethod.Post,path,body,s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("اصلاح موجودی ثبت شد.","تم ترحيل تسوية المخزون.","Stock adjustment posted."):T("ثبت اصلاح موجودی انجام نشد.","تعذر ترحيل تسوية المخزون.","Stock adjustment could not be posted.");if(r.IsSuccess){Dialog=false;await Load();}else FormError=Message;Busy=false;}
}
