@if(Value.ValueKind==System.Text.Json.JsonValueKind.Array){var rows=Value.EnumerateArray().ToArray();if(rows.Length==0){<div class="state-box">@L["NoRecords"]</div>}else if(rows[0].ValueKind==System.Text.Json.JsonValueKind.Object){var columns=rows.SelectMany(x=>x.EnumerateObject()).Where(x=>Scalar(x.Value)).Select(x=>x.Name).Distinct().Take(10).ToArray();<div class="table-wrap"><table><thead><tr>@foreach(var c in columns){<th>@Humanize(c)</th>}</tr></thead><tbody>@foreach(var row in rows){<tr>@foreach(var c in columns){<td>@(row.TryGetProperty(c,out var cell)?Display(cell):"—")</td>}</tr>}</tbody></table></div>}else{<ul>@foreach(var row in rows){<li>@Display(row)</li>}</ul>}}
else if(Value.ValueKind==System.Text.Json.JsonValueKind.Object){var scalars=Value.EnumerateObject().Where(x=>Scalar(x.Value)).ToArray();if(scalars.Length>0){<dl class="detail-grid">@foreach(var p in scalars){<dt>@Humanize(p.Name)</dt><dd>@Display(p.Value)</dd>}</dl>}@foreach(var p in Value.EnumerateObject().Where(x=>!Scalar(x.Value)&&x.Value.ValueKind!=System.Text.Json.JsonValueKind.Null)){<section class="nested-detail"><h3>@Humanize(p.Name)</h3><JsonDataView Value="p.Value" /></section>}}
else{<p>@Display(Value)</p>}
@code{[Parameter]public System.Text.Json.JsonElement Value{get;set;}[Inject]private IStringLocalizer<AppStrings>L{get;set;}=default!;[Inject]private BARANG.Backoffice.Localization.Order360FieldLabelResolver Labels{get;set;}=default!;private static bool Scalar(System.Text.Json.JsonElement x)=>x.ValueKind is not(System.Text.Json.JsonValueKind.Array or System.Text.Json.JsonValueKind.Object);private static string Display(System.Text.Json.JsonElement x)=>x.ValueKind switch{System.Text.Json.JsonValueKind.Null=>"—",System.Text.Json.JsonValueKind.True=>"✓",System.Text.Json.JsonValueKind.False=>"—",_=>x.ToString()};private string Humanize(string v)=>Labels.Resolve(v);}
