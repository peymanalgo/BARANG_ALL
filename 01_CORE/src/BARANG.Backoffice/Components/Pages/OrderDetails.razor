@page "/orders/{OrderId:guid}"
@page "/orders/{OrderId:guid}/360"
@rendermode InteractiveServer
@implements IAsyncDisposable
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Net
@using System.Text.Json
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<Order360Strings> S
@inject IStringLocalizer<Order360AdditionsStrings> A
@inject IStringLocalizer<Order360EntryStrings> Entry
@inject IStringLocalizer<Order360FieldsStrings> FD
@inject IStringLocalizer<Order360ErrorsStrings> X
@inject IStringLocalizer<EffectiveStatusStrings> ES
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates
@inject NavigationManager Navigation

<link rel="stylesheet" href="/order360.css" />
<link rel="stylesheet" href="/order360-additions.css" />
<PageTitle>@S["Eyebrow"]</PageTitle>
@if (Loading) { <section class="panel state-box"><span class="spinner"></span><p>@L["Loading"]</p></section> }
else if (Failed) { <section class="panel state-box"><div class="inline-error" role="alert">@ErrorMessage</div><button type="button" class="secondary-action" @onclick="Load">@S["Retry"]</button></section> }
else
{
    <main class="order360-shell @ThemeClass @(Embedded ? "order360-embedded" : "")">
        <section class="order360-modal" role="dialog" aria-modal="true" aria-labelledby="order360-title">
            <header class="order360-head"><div><span class="eyebrow">@S["Eyebrow"]</span><h1 id="order360-title">@Number</h1><small>@CustomerName · @Date(Summary, "orderDate")</small></div><div class="order360-head-actions"><span class="order360-pill">@StatusText(Status)</span><PriorityIndicator Priority="@Text(Summary, "priority", "Normal")" /><button type="button" class="order360-close" aria-label="@S["Close"]" title="@S["Close"]" @onclick="Close">×</button></div></header>

            <div class="order360-metrics"><div class="order360-metric"><small>@S["MetricsTotal"]</small><strong dir="ltr">@Money(Pricing, "finalTotal") @Currency</strong></div><div class="order360-metric"><small>@S["MetricsPaid"]</small><strong dir="ltr">—</strong></div><div class="order360-metric"><small>@S["MetricsBalance"]</small><strong dir="ltr">—</strong></div><div class="order360-metric"><small>@S["MetricsDue"]</small><strong>@Date(Summary, "requestedDeliveryDate")</strong></div></div>
            <div class="order360-overview">
                <section class="order360-card"><h2>@S["Overview"]</h2><dl class="order360-fields"><Field K="@S["Customer"]" V="@CustomerName" /><Field K="@S["Status"]" V="@StatusText(Status)" /><Field K="@S["Source"]" V="@Text(Summary, "source", S["NoData"])" /><Field K="@S["OrderDate"]" V="@Date(Summary, "orderDate")" /><Field K="@S["ExpectedDate"]" V="@Date(Summary, "requestedDeliveryDate")" /></dl></section>
                <section class="order360-card order360-orbit"><div class="order360-orbit-ring"><button type="button" class="order360-orbit-node @(Active == "customer" ? "active" : null)" @onclick="SelectCustomer">@S["Customer"]</button><button type="button" class="order360-orbit-node @(Active == "items" ? "active" : null) items-node" @onclick="SelectItems">@A["Items"]</button><button type="button" class="order360-orbit-node @(Active == "prints" ? "active" : null)" @onclick="SelectPrints">@S["PrintOperations"]</button><button type="button" class="order360-orbit-node @(Active == "pricing" ? "active" : null)" @onclick="SelectPricing">@S["PriceSnapshot"]</button><button type="button" class="order360-orbit-node @(Active == "delivery" ? "active" : null)" @onclick="SelectDelivery">@S["Delivery"]</button><button type="button" class="order360-orbit-node @(Active == "services" ? "active" : null)" @onclick="SelectServices">@S["SelectedServices"]</button><button type="button" class="order360-orbit-node @(Active == "history" ? "active" : null)" @onclick="SelectHistory">@S["Timeline"]</button><div class="order360-orbit-center"><svg class="order360-shirt" viewBox="0 0 160 180" role="img" aria-label="@L["Product"]"><path d="M42 22 16 39 4 75l25 12 10-18v87c0 9 7 16 16 16h60c9 0 16-7 16-16V69l10 18 25-12-12-36-26-17-20 13H62z"/><path d="M61 22c2 18 36 18 38 0" fill="none"/></svg><button type="button" class="order360-artwork-marker @(HasArtwork ? null : "is-empty")" disabled="@(!HasArtwork)" aria-disabled="@(!HasArtwork)" aria-label="@L["Artwork"]" title="@L["Artwork"]" @onclick="OpenArtwork">@L["Artwork"]</button></div></div></section>
                <aside class="order360-card order360-detail"><h2>@SectionTitle(Active)<span class="order360-pill">@S["ReadOnly"]</span></h2><div class="order360-detail-scroll">@Detail()</div></aside>
            </div>
            <div class="order360-progress"><span>@S["Progress"] · @Progress٪</span><div class="order360-track"><span style="width:@($"{Progress}%")"></span></div></div>
            <button type="button" class="order360-specification-banner" @onclick="OpenSpecification"><span class="order360-specification-icon" aria-hidden="true">▤</span><span><strong>@A["FullSpecification"]</strong><small>@Entry["Subtitle"]</small></span><span aria-hidden="true">›</span></button>
        </section>
    </main>
}

@if (SpecificationOpen)
{
    <div class="order360-specification-backdrop" role="dialog" aria-modal="true" aria-labelledby="full-specification-title">
        <section class="order360-specification-modal">
            <header class="order360-specification-header"><div><span class="eyebrow">@A["FullSpecification"]</span><h2 id="full-specification-title">@Number</h2></div><button type="button" class="order360-close" aria-label="@A["SpecificationClose"]" @onclick="CloseSpecification">×</button></header>
            <div class="order360-specification-body">
                <section class="order360-spec-card"><h3>@S["Overview"]</h3><dl class="order360-fields"><Field K="@S["Status"]" V="@StatusText(Status)" /><Field K="@S["OrderDate"]" V="@Date(Summary, "orderDate")" /><Field K="@S["Source"]" V="@Text(Summary, "source", A["NotSpecified"])" /><Field K="@A["Company"]" V="@Text(Get(Data, "company"), "displayName", A["NotSpecified"])" /><Field K="@A["Branch"]" V="@Text(Get(Data, "branch"), "displayName", A["NotSpecified"])" /><Field K="@A["Notes"]" V="@Text(Get(Data, "businessProfile"), "notes", A["NotSpecified"])" /><Field K="@L["ExternalReference"]" V="@Text(Summary, "externalReference", A["NotSpecified"])" /></dl></section>
                <section class="order360-spec-card"><h3>@S["Customer"]</h3><dl class="order360-fields"><Field K="@S["Customer"]" V="@CustomerName" /><Field K="@FD["CustomerCode"]" V="@Text(Customer, "customerCode", A["NotSpecified"])" /><Field K="@FD["CustomerType"]" V="@DisplayValue(Text(Customer, "customerType", A["NotSpecified"]))" /><Field K="@L["Mobile"]" V="@Text(Customer, "primaryMobile", A["NotSpecified"])" /><Field K="@L["Email"]" V="@Text(Customer, "primaryEmail", A["NotSpecified"])" /></dl></section>
                <section class="order360-spec-card"><h3>@A["Items"]</h3>
                    @if (Items.Length == 0) { <div class="order360-empty">@S["NoData"]</div> }
                    else { <div class="order360-spec-list">@foreach (var item in Items) { <article class="order360-spec-item"><h4>#@Text(item, "lineNumber") · @Text(item, "snapshotProductName", S["NoData"])</h4><dl class="order360-fields"><Field K="@S["Product"]" V="@Text(item, "snapshotProductCode", A["NotSpecified"])" /><Field K="@A["Variant"]" V="@Text(item, "snapshotVariantDisplayName", Text(item, "snapshotVariantSku", A["NotSpecified"]))" /><Field K="@S["Quantity"]" V="@Text(item, "quantity")" /><Field K="@S["Unit"]" V="@Text(item, "snapshotUomCode", A["NotSpecified"])" /><Field K="@FD["Size"]" V="@Text(item, "snapshotSizeCode", A["NotSpecified"])" /><Field K="@FD["Color"]" V="@Text(item, "snapshotColorCode", A["NotSpecified"])" /><Field K="@A["Notes"]" V="@Text(item, "notes", A["NotSpecified"])" /></dl></article> } </div>}
                </section>
                <section class="order360-spec-card"><h3>@S["PrintOperations"]</h3>
                    @if (Prints.Length == 0) { <div class="order360-empty">@S["NoData"]</div> } else { @foreach (var p in Prints) { <article class="order360-spec-row"><strong>@ItemName(Text(p, "orderItemId"))</strong><dl class="order360-fields"><Field K="@S["PrintOperations"]" V="@Text(p, "printPositionCode", A["NotSpecified"])" /><Field K="@FD["PrintMethod"]" V="@DisplayValue(Text(p, "printMethodCode", A["NotSpecified"]))" /><Field K="@A["Dimensions"]" V="@Dimensions(p)" /><Field K="@A["Notes"]" V="@Text(p, "notes", A["NotSpecified"])" /></dl></article> } }
                </section>
                <section class="order360-spec-card"><h3>@A["Artwork"]</h3>
                    @if (Gallery.Length == 0) { <div class="order360-empty">@S["NoData"]</div> } else { <div class="order360-spec-list">@foreach (var g in Gallery) { <article class="order360-spec-row"><strong>@Text(g, "artworkTitle", Text(g, "fileName", S["Files"]))</strong><span>@Text(g, "artworkCode", A["NotSpecified"]) · @Text(g, "fileName", A["NotSpecified"])</span></article> }</div><button type="button" class="secondary-action" @onclick="OpenArtwork">@A["Preview"]</button>}
                </section>
                <section class="order360-spec-card"><h3>@S["SelectedServices"]</h3>
                    @if (Services.Length == 0) { <div class="order360-empty">@S["NoData"]</div> } else { <table class="order360-grid"><thead><tr><th>@S["SelectedServices"]</th><th>@S["Quantity"]</th><th>@S["Item"]</th></tr></thead><tbody>@foreach (var service in Services) { <tr><td>@Text(service, "serviceCode", A["NotSpecified"])</td><td>@Text(service, "quantity")</td><td>@ItemName(Text(service, "orderItemId"))</td></tr> }</tbody></table>}
                </section>
                <section class="order360-spec-card"><h3>@S["Packaging"]</h3><dl class="order360-fields"><Field K="@S["Packaging"]" V="@Text(Get(Data, "businessProfile"), "packagingTypeCode", A["NotSpecified"])" /><Field K="@L["Invoice"]" V="@Text(Get(Data, "businessProfile"), "includeInvoiceInPackage", A["NotSpecified"])" /></dl></section>
                <section class="order360-spec-card"><h3>@S["Delivery"]</h3><dl class="order360-fields"><Field K="@S["ShippingMethod"]" V="@Text(Get(Data, "businessProfile"), "shippingMethodCode", A["NotSpecified"])" /><Field K="@L["Recipient"]" V="@Text(Get(Data, "shippingAddress"), "recipientName", A["NotSpecified"])" /><Field K="@L["Phone"]" V="@Text(Get(Data, "shippingAddress"), "recipientPhone", A["NotSpecified"])" /><Field K="@S["Address"]" V="@Text(Get(Data, "shippingAddress"), "addressLine1", A["NotSpecified"])" /><Field K="@L["PostalCode"]" V="@Text(Get(Data, "shippingAddress"), "postalCode", A["NotSpecified"])" /></dl></section>
                <div class="order360-spec-workflow-row">
                <section class="order360-spec-card"><h3>@S["PriceSnapshot"]</h3>
                    @if (Components.Length == 0) { <div class="order360-empty">@S["NoData"]</div> } else { <table class="order360-grid"><thead><tr><th>@S["Details"]</th><th>@S["FinalTotal"]</th></tr></thead><tbody>@foreach (var component in Components) { <tr><td>@DisplayValue(Text(component, "componentType", FD["Unknown"]))</td><td dir="ltr">@Money(component, "totalAmount") @Currency</td></tr> }</tbody></table>}<p class="order360-total">@S["FinalTotal"]: @Money(Pricing, "finalTotal") @Currency</p>
                </section>
                <section class="order360-spec-card"><h3>@A["Workflow"]</h3><dl class="order360-fields"><Field K="@A["Workflow"]" V="@Text(Get(Get(Data, "workflow"), "instance"), "version", A["NotSpecified"])" /><Field K="@S["Status"]" V="@StatusText(Status)" /><Field K="@A["Items"]" V="@ActiveStatus()" /></dl></section>
                </div>
            </div>
        </section>
    </div>
}

@if (GalleryOpen) { <div class="order360-gallery" role="dialog" aria-modal="true" aria-labelledby="artwork-gallery-title"><section class="order360-gallery-card"><header class="order360-gallery-head"><h2 id="artwork-gallery-title">@S["Files"]</h2><button type="button" class="order360-close" aria-label="@S["Close"]" @onclick="CloseArtwork">×</button></header>@if (Gallery.Length == 0) { <div class="order360-empty">@S["NoData"]</div> } else { var a = Gallery[GalleryIndex]; <div class="order360-gallery-preview">@if (Text(a, "mediaType").StartsWith("image/", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(Text(a, "fileId")) && !string.IsNullOrWhiteSpace(Text(a, "fileVersionId"))) { <img src="@FileUrl(a)" alt="@Text(a, "artworkTitle", S["Files"])" /> } else { <span>@L["FileVersion"] · @Text(a, "fileName", S["NoData"])</span> }</div><dl class="order360-gallery-meta"><Field K="@S["Item"]" V="@ItemName(Text(a, "orderItemId"))" /><Field K="@L["PrintLocation"]" V="@Text(a, "printPositionCode", S["NoData"])" /><Field K="@L["Artwork"]" V="@Text(a, "artworkTitle", S["NoData"])" /><Field K="@L["FileVersion"]" V="@Text(a, "fileVersion", S["NoData"])" /></dl><div class="order360-gallery-actions"><button type="button" class="secondary-action" @onclick="PreviousArtwork" disabled="@(GalleryIndex == 0)">@L["Previous"]</button><span>@(GalleryIndex + 1) / @Gallery.Length</span><button type="button" class="secondary-action" @onclick="NextArtwork" disabled="@(GalleryIndex >= Gallery.Length - 1)">@L["Next"]</button></div> }</section></div> }

@code {
    [Parameter] public Guid OrderId { get; set; } [Parameter] public bool Embedded { get; set; } [Parameter] public Guid? TaskId { get; set; }
    private bool Loading = true, Failed, GalleryOpen, SpecificationOpen, _disposed; private int GalleryIndex; private string Active = "customer", Number = "", Status = "", CustomerName = "", Currency = "—"; private string? ErrorMessage; private int Progress; private JsonElement Data, Summary, Customer, Pricing; private JsonElement[] Items = [], Prints = [], Services = [], Components = [], Timeline = [], WorkflowTimeline = [], Gallery = []; private CancellationTokenSource? _loadCts; private bool HasArtwork => Gallery.Length > 0;
    private string ThemeClass => Status.ToLowerInvariant() switch { "workflowcompleted" => "theme-registered", "inworkflow" => "theme-registered", "submitted" => "theme-registered", "cancelled" => "theme-cancelled", _ => "theme-draft" };
    protected override async Task OnParametersSetAsync() => await Load();
    private async Task Load()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        CancellationToken ct = _loadCts.Token;
        Loading = true; Failed = false; ErrorMessage = null;
        try
        {
            var s = await Session();
            if (s is null) { Failed = true; ErrorMessage = X["LoadFailed"].Value; return; }
            string path = $"api/v1/orders/{OrderId}/360" + (TaskId is Guid task ? $"?taskId={task}" : "");
            var r = await Core.GetAsync(path, s.Value.Token, s.Value.Company, ct);
            if (!r.IsSuccess) { Failed = true; ErrorMessage = X["LoadFailed"].Value; return; }
            Data = r.Value; Summary = Get(Data, "summary"); Customer = Get(Data, "customer"); Pricing = Get(Data, "pricing"); Number = Text(Summary, "orderNumber", OrderId.ToString()); Status = Text(Get(Data, "workflowStatus"), "code", Text(Summary, "status")); CustomerName = Text(Customer, "displayName", S["NoData"]); Currency = Text(Pricing, "currencyCode", "—"); Items = Array(Data, "items"); Prints = Array(Data, "printOperations"); Services = Array(Data, "services"); Components = Array(Data, "pricingComponents"); Timeline = Array(Data, "timeline"); WorkflowTimeline = Array(Data, "workflowTimeline"); Gallery = Array(Data, "artworkGallery"); Progress = Status.Equals("Submitted", StringComparison.OrdinalIgnoreCase) || Status.Equals("WorkflowCompleted", StringComparison.OrdinalIgnoreCase) ? 100 : Items.Length > 0 ? 35 : 10;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (JsonException) { Failed = true; ErrorMessage = X["LoadFailed"].Value; }
        catch (HttpRequestException) { Failed = true; ErrorMessage = X["LoadFailed"].Value; }
        catch (InvalidOperationException) { Failed = true; ErrorMessage = X["LoadFailed"].Value; }
        finally { if (!_disposed) Loading = false; }
    }
    public async ValueTask DisposeAsync() { _disposed = true; _loadCts?.Cancel(); _loadCts?.Dispose(); await Task.CompletedTask; }
    private string FileUrl(JsonElement a) => $"/api/v1/files/{Text(a, "fileId")}/versions/{Text(a, "fileVersionId")}/thumbnail"; private void SelectCustomer() => Active = "customer"; private void SelectItems() => Active = "items"; private void SelectPrints() => Active = "prints"; private void SelectPricing() => Active = "pricing"; private void SelectDelivery() => Active = "delivery"; private void SelectServices() => Active = "services"; private void SelectHistory() => Active = "history"; private void OpenArtwork() { if (HasArtwork) { GalleryIndex = 0; GalleryOpen = true; } } private void CloseArtwork() => GalleryOpen = false; private void OpenSpecification() => SpecificationOpen = true; private void CloseSpecification() => SpecificationOpen = false; private void PreviousArtwork() { if (GalleryIndex > 0) GalleryIndex--; } private void NextArtwork() { if (GalleryIndex + 1 < Gallery.Length) GalleryIndex++; }
    private string SectionTitle(string k) => k switch { "customer" => S["Customer"], "items" => A["Items"], "prints" => S["PrintOperations"], "pricing" => S["PriceSnapshot"], "delivery" => S["Delivery"], "services" => S["SelectedServices"], "history" => S["Timeline"], _ => S["Overview"] };
    private RenderFragment Detail() => builder => builder.AddMarkupContent(0, BuildDetail(Active));
    private string BuildDetail(string k) => k switch { "customer" => $"<dl class='order360-fields'>{F(S["Customer"], CustomerName)}{F(FD["CustomerCode"], Text(Customer, "customerCode", S["NoData"]))}{F(FD["CustomerType"], DisplayValue(Text(Customer, "customerType", S["NoData"])))}{F(L["SourceMobile"], Text(Customer, "primaryMobile", S["NoData"]))}{F(L["Email"], Text(Customer, "primaryEmail", S["NoData"]))}</dl>", "items" => ItemsTable(), "prints" => PrintsTable(), "services" => ServicesTable(), "delivery" => $"<dl class='order360-fields'>{F(S["ShippingMethod"], Text(Get(Data, "businessProfile"), "shippingMethodCode", S["NoData"]))}{F(S["Customer"], Text(Get(Data, "shippingAddress"), "recipientName", S["NoData"]))}{F(S["Address"], Text(Get(Data, "shippingAddress"), "addressLine1", S["NoData"]))}{F(L["PostalCode"], Text(Get(Data, "shippingAddress"), "postalCode", S["NoData"]))}{F(S["ExpectedDate"], Date(Summary, "requestedDeliveryDate"))}</dl>", "pricing" => PricingTable(), "history" => HistoryTable(), _ => $"<dl class='order360-fields'>{F(S["OrderDate"], Date(Summary, "orderDate"))}{F(S["ExpectedDate"], Date(Summary, "requestedDeliveryDate"))}{F(S["Source"], Text(Summary, "source", S["NoData"]))}{F(S["Status"], StatusText(Status))}</dl>" };
    private string ItemsTable() => Items.Length == 0 ? $"<div class='order360-empty'>{S["NoData"]}</div>" : $"<table class='order360-grid'><thead><tr><th>{S["Product"]}</th><th>{L["Variant"]}</th><th>{S["Quantity"]}</th><th>{S["Unit"]}</th></tr></thead><tbody>{string.Concat(Items.Select(i => $"<tr><td>{E(Text(i, "snapshotProductName", S["NoData"]))}</td><td>{E(Text(i, "snapshotVariantSku", S["NoData"]))}</td><td>{E(Text(i, "quantity"))}</td><td>{E(Text(i, "snapshotUomCode", S["NoData"]))}</td></tr>"))}</tbody></table>";
    private string PrintsTable() => Prints.Length == 0 ? $"<div class='order360-empty'>{S["NoData"]}</div>" : $"<table class='order360-grid'><thead><tr><th>{S["Item"]}</th><th>{S["PrintOperations"]}</th><th>{L["FileVersion"]}</th></tr></thead><tbody>{string.Concat(Prints.Select(p => $"<tr><td>{E(ItemName(Text(p, "orderItemId")))}</td><td>{E(Text(p, "printPositionCode", S["NoData"]))}</td><td>{E(Text(p, "fileVersionId", S["NoData"]))}</td></tr>"))}</tbody></table>";
    private string ServicesTable() => Services.Length == 0 ? $"<div class='order360-empty'>{S["NoData"]}</div>" : $"<table class='order360-grid'><thead><tr><th>{S["SelectedServices"]}</th><th>{S["Quantity"]}</th><th>{S["Item"]}</th></tr></thead><tbody>{string.Concat(Services.Select(x => $"<tr><td>{E(Text(x, "serviceCode", S["NoData"]))}</td><td>{E(Text(x, "quantity"))}</td><td>{E(ItemName(Text(x, "orderItemId")))}</td></tr>"))}</tbody></table>";
    private string PricingTable() => Components.Length == 0 ? $"<div class='order360-empty'>{S["NoData"]}</div><p class='order360-total'>{S["FinalTotal"]}: {E(Money(Pricing, "finalTotal"))} {E(Currency)}</p>" : $"<table class='order360-grid'><thead><tr><th>{S["Details"]}</th><th>{S["FinalTotal"]}</th></tr></thead><tbody>{string.Concat(Components.Select(x => $"<tr><td>{E(Text(x, "componentType", S["NoData"]))}</td><td>{E(Money(x, "totalAmount"))}</td></tr>"))}</tbody></table><p class='order360-total'>{S["FinalTotal"]}: {E(Money(Pricing, "finalTotal"))} {E(Currency)}</p>";
    private string HistoryTable() { JsonElement[] events = WorkflowTimeline.Length > 0 ? WorkflowTimeline : Timeline; return events.Length == 0 ? $"<div class='order360-empty'>{S["NoHistory"]}</div>" : $"<ul class='order360-timeline'>{string.Concat(events.Select(x => $"<li class='{(Text(x, "status") == "Completed" ? "completed" : "current")}'><div class='order360-timeline-entry'><small>{E(DateTimeValue(x, "occurredAtUtc"))}</small><b>{E(StageTitle(x))}</b><span>{E(Text(x, "positionTitle", Text(x, "outcome", StatusText(Text(x, "eventType", S["NoData"])))))}{(string.IsNullOrWhiteSpace(Text(x, "note")) ? "" : $" · {E(Text(x, "note"))}")}</span>{HistoryAttachments(x)}</div></li>"))}</ul>"; }
    private string HistoryAttachments(JsonElement occurrence) { JsonElement[] files = Array(occurrence, "attachments"); return files.Length == 0 ? "" : $"<div class='order360-history-attachments'><small>{E(S["Files"])}</small><ul>{string.Concat(files.Select(file => $"<li><a href='/api/v1/files/{E(Text(file, "fileId"))}/versions/{E(Text(file, "fileVersionId"))}/download' target='_blank' rel='noopener'>{E(Text(file, "fileName", A["NotSpecified"]))}</a></li>"))}</ul></div>"; }
    private string Dimensions(JsonElement x) => string.IsNullOrWhiteSpace(Text(x, "width")) && string.IsNullOrWhiteSpace(Text(x, "height")) ? A["NotSpecified"] : $"{Text(x, "width", "—")} × {Text(x, "height", "—")}";
    private string ItemName(string id) { var i = Items.FirstOrDefault(x => Text(x, "id") == id); return i.ValueKind != JsonValueKind.Undefined ? Text(i, "snapshotProductName", S["NoData"]) : S["NoData"]; }
    private string StageTitle(JsonElement x) { if (x.TryGetProperty("stageTitle", out var t) && t.ValueKind == JsonValueKind.Object) { string lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; return t.TryGetProperty(lang, out var v) ? v.ToString() : t.TryGetProperty("en", out var en) ? en.ToString() : S["NoData"]; } return Text(x, "stageTitle", StatusText(Text(x, "eventType", S["NoData"]))); }
    private string DisplayValue(string value) => value switch { "Individual" => FD["CustomerTypeIndividual"].Value, "LegalEntity" => FD["CustomerTypeLegalEntity"].Value, "Person" => FD["CustomerTypeIndividual"].Value, "Organization" => FD["CustomerTypeLegalEntity"].Value, "Front" => L["PrintFront"].Value, "Back" => L["PrintBack"].Value, "Sleeve" => L["PrintSleeve"].Value, _ => value };
    private static string E(string? x) => WebUtility.HtmlEncode(x ?? ""); private static string F(string k, string v) => $"<div><dt>{E(k)}</dt><dd>{E(v)}</dd></div>"; private string Money(JsonElement x, string k) => x.ValueKind == JsonValueKind.Object && x.TryGetProperty(k, out var v) && v.TryGetDecimal(out var d) ? d.ToString("N2", CultureInfo.CurrentCulture) : "—"; private string Date(JsonElement x, string k) => Dates.TryParseCanonical(Text(x, k), out var d) ? Dates.Format(d, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName) : S["NoData"]; private string DateTimeValue(JsonElement x, string k) => DateTimeOffset.TryParse(Text(x, k), out var d) ? Dates.Format(d, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName) : S["NoData"];


    private string StatusText(string x) => x switch { "WorkflowCompleted" => ES["WorkflowCompleted"].Value, "AuditRejected" => ES["AuditRejected"].Value, "InWorkflow" => ActiveStatus(), "Submitted" => ES["Registered"].Value, "Draft" => ES["Draft"].Value, "Cancelled" => ES["Cancelled"].Value, _ => string.IsNullOrWhiteSpace(x) ? S["NoData"] : L[$"Status{x}"] };
    private string ActiveStatus() { var stages = Array(Get(Data, "workflowStatus"), "activeStages"); var titles = stages.Select(StageTitle).Where(x => !string.IsNullOrWhiteSpace(x)).ToArray(); return titles.Length == 0 ? ES["Registered"].Value : string.Join(" / ", titles.Select(x => $"{ES["InCartable"].Value} {x}")); }
    private static JsonElement[] Array(JsonElement x, string k) => x.ValueKind == JsonValueKind.Object && x.TryGetProperty(k, out var a) && a.ValueKind == JsonValueKind.Array ? a.EnumerateArray().ToArray() : []; private static JsonElement Get(JsonElement x, string k) => x.ValueKind == JsonValueKind.Object && x.TryGetProperty(k, out var v) ? v : default; private static string Text(JsonElement x, string k, string f = "") => x.ValueKind == JsonValueKind.Object && x.TryGetProperty(k, out var v) && v.ValueKind != JsonValueKind.Null ? v.ToString() : f; private async Task<(string Token, Guid Company)?> Session() { var u = (await AuthState.GetAuthenticationStateAsync()).User; return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value, out var c) && u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t ? (t, c) : null; } private void Close() => Navigation.NavigateTo("/workspace/orders");
}
