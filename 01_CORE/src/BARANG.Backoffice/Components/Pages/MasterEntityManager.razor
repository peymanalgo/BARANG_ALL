@page "/master/products"
@page "/master/branches"
@page "/master/companies"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<CrudStrings> T
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@Title · BARANG</PageTitle><nav class="breadcrumbs"><span>@L["Module_master-data"]</span><span>/</span><span>@Title</span></nav><header class="crud-header"><div><h1>@Title</h1><p>@L["AuthoritativeCoreData"]</p></div><button type="button" class="btn btn-primary" @onclick="New"><BarangIcon Name="plus" />@T["Add"]</button></header>
<section class="crud-card"><div class="crud-toolbar"><label class="search-box"><BarangIcon Name="search" /><input @bind="Search" @bind:event="oninput" placeholder="@T["SearchHint"]"/></label><select @bind="State"><option value="">@T["Status"]</option><option value="active">@T["Active"]</option><option value="inactive">@T["Inactive"]</option></select><button type="button" class="btn btn-secondary" @onclick="Load"><BarangIcon Name="refresh" />@T["Refresh"]</button></div>@if(Loading){<BarangLoadingState Text="@T["Loading"]" />}else if(!Filtered.Any()){<CrudEmptyState/>}else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T["Code"]</th><th>@T["Name"]</th>@if(Kind=="equipment"){<th>@L["EquipmentType"]</th><th>@L["Branch"]</th>}<th>@T["Status"]</th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(var x in Filtered){<tr><td><span class="code-pill">@x.Code</span></td><td>@x.Name</td>@if(Kind=="equipment"){<td>@Friendly(x.Type)</td><td>@BranchName(x.Branch)</td>}<td><StatusBadge Active="x.Active"/></td><td><BarangActionMenu><BarangIconButton Icon="eye" Label="@T["View"]" Semantic="info" Clicked="()=>Open(x,false)" /><BarangIconButton Icon="edit" Label="@T["Edit"]" Semantic="edit" Clicked="()=>Open(x,true)" /><BarangIconButton Icon="power" Label="@(x.Active?T["Deactivate"]:T["Activate"])" Semantic="@(x.Active?"warning":"success")" Clicked="()=>Toggle(x)" />@if(Kind=="suppliers"){<BarangIconButton Icon="workflow" Label="@L["LinkProduct"]" Semantic="info" Href="@($"/master/suppliers/{x.Id}/products")" />}</BarangActionMenu></td></tr>}</tbody></table></div>}</section>
@if(Dialog){<div class="dialog-backdrop" @onclick="Close"><section class="crud-dialog" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation><header><h2>@Title</h2><button type="button" class="dialog-close" title="@T["Close"]" aria-label="@T["Close"]" @onclick="Close"><BarangIcon Name="close" /></button></header><div class="form-grid"><label><span>@T["Code"]</span><input @bind="Code" disabled="@(Id is not null)"/></label><label><span>@T["Name"]</span><input @bind="Name" disabled="@(!Editable)"/></label>@if(Kind=="equipment"){<label><span>@L["EquipmentType"]</span><ReferenceSelect TypeCode="equipment.type" UseCode="true" @bind-Value="Type" Disabled="@(!Editable)" /></label><label><span>@L["Status"]</span><ReferenceSelect TypeCode="equipment.status" UseCode="true" @bind-Value="Status" Disabled="@(!Editable)" /></label><label><span>@L["Branch"]</span><SearchableSelect Options="BranchOptions" @bind-Value="BranchId" Disabled="@(!Editable)" Placeholder="@L["Choose"]" /></label>}</div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<footer><button type="button" class="btn btn-secondary" @onclick="Close">@T["Cancel"]</button>@if(Editable){<button type="button" class="btn btn-primary" @onclick="Save">@T["Save"]</button>}</footer></section></div>}
@code{
 [Parameter]public string Kind{get;set;}="suppliers";private Guid?Id;private long Version;private bool Active=true,Success,Dialog,Editable,Loading;private string Code="",Name="",Type="PRINTER",Status="AVAILABLE",BranchId="",Search="",State="";private string?Message;private List<Row>Rows=[];private List<Option>Branches=[];private IReadOnlyList<SearchableSelectOption>BranchOptions=>Branches.Select(x=>new SearchableSelectOption(x.Id.ToString(),x.Name)).ToArray();private string Title=>L[$"Master_{Kind}"];private string Base()=>Kind=="equipment"?"api/v1/equipment":"api/v1/suppliers";private IEnumerable<Row>Filtered=>Rows.Where(x=>(Search.Length==0||(x.Code+x.Name).Contains(Search,StringComparison.CurrentCultureIgnoreCase))&&(State.Length==0||(State=="active")==x.Active));
 protected override async Task OnParametersSetAsync(){await LoadBranches();await Load();}private void New(){Id=null;Version=0;Active=true;Code=Name=BranchId="";Type="PRINTER";Status="AVAILABLE";Editable=Dialog=true;}private void Open(Row x,bool edit){Id=x.Id;Version=x.Version;Active=x.Active;Code=x.Code;Name=x.Name;Type=x.Type;Status=x.Status;BranchId=x.Branch;Editable=edit;Dialog=true;}private void Close()=>Dialog=false;
 private async Task LoadBranches(){var s=await Session();if(s is null)return;var r=await Core.GetAsync("api/v1/organization/branches",s.Value.Token,s.Value.Company,default);if(r.IsSuccess)Branches=r.Value.EnumerateArray().Where(x=>B(x,"isActive",true)).Select(x=>new Option(x.GetProperty("id").GetGuid(),G(x,"displayName"))).ToList();}
 private async Task Load(){Loading=true;Rows=[];var s=await Session();if(s is not null){var r=await Core.GetAsync(Base()+"?pageSize=100",s.Value.Token,s.Value.Company,default);if(r.IsSuccess){var root=r.Value.TryGetProperty("items",out var a)?a:r.Value;foreach(var x in root.EnumerateArray())Rows.Add(new(x.GetProperty("id").GetGuid(),G(x,Kind=="equipment"?"equipmentCode":"supplierCode"),G(x,Kind=="equipment"?"name":"displayName"),B(x,"isActive",true),N(x,"version"),G(x,"equipmentTypeCode"),G(x,"operationalStatusCode"),G(x,"branchId")));}else Show(r);}Loading=false;}
 private async Task Save(){var s=await Session();if(s is null)return;Guid?branch=Guid.TryParse(BranchId,out var b)?b:null;object body=Kind=="equipment"?new{equipmentCode=Code,name=Name,equipmentTypeCode=Type,operationalStatusCode=Status,branchId=branch,version=Version}:new{supplierCode=Code,displayName=Name,version=Version};var r=await Core.SendAsync(Id is null?HttpMethod.Post:HttpMethod.Put,Base()+(Id is Guid id?$"/{id}":""),body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){Dialog=false;await Load();}}
 private async Task Toggle(Row x){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,$"{Base()}/{x.Id}/activation",new{isActive=!x.Active,version=x.Version},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private string BranchName(string id)=>Guid.TryParse(id,out var x)?Branches.FirstOrDefault(b=>b.Id==x)?.Name??"—":"—";private string Friendly(string x)=>System.Globalization.CultureInfo.CurrentUICulture.TextInfo.ToTitleCase(x.Replace('_',' ').ToLowerInvariant());private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private static bool B(System.Text.Json.JsonElement x,string n,bool d=false)=>x.TryGetProperty(n,out var p)&&p.ValueKind is System.Text.Json.JsonValueKind.True or System.Text.Json.JsonValueKind.False?p.GetBoolean():d;private static long N(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.GetInt64():0;private sealed record Row(Guid Id,string Code,string Name,bool Active,long Version,string Type,string Status,string Branch);private sealed record Option(Guid Id,string Name);
}
