@page "/workspace/quality"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject NavigationManager Navigation

<PageTitle>@L["Module_quality"]</PageTitle>
<div class="page-heading"><h1>@L["Module_quality"]</h1></div>
@if (Message is not null) { <div class="@(Success ? "inline-success" : "inline-error")">@L[Message]</div> }
<section class="panel quality-workspace">
    <h2>@L["Action_Inspect"]</h2>
    <div class="form-grid">
        <label><span>@L["Action_Execute"]</span><input @bind="ProductionJobId" placeholder="GUID" /></label>
        <label><span>@L["Action_Inspect"]</span><input @bind="TemplateId" placeholder="GUID" /></label>
        <label><span>@L["Action_Inspect"]</span><input @bind="InspectionId" placeholder="GUID" /></label>
        <label><span>@L["Version"]</span><input type="number" @bind="Version" /></label>
    </div>
    <div class="form-actions">
        <button type="button" @onclick="Start">@L["Action_Inspect"]</button>
        <button type="button" @onclick="LoadInspection">@L["Refresh"]</button>
    </div>
    <pre class="quality-json">@InspectionData</pre>
</section>

<section class="panel quality-workspace">
    <h2>@L["Action_Complete"]</h2>
    <div class="form-grid">
        <label><span>@L["Action_Complete"]</span><input type="number" step="0.0001" @bind="AcceptedQuantity" /></label>
        <label><span>@L["ValidationError"]</span><input type="number" step="0.0001" @bind="RejectedQuantity" /></label>
        <label><span>@L["Action_Reproduction"]</span><input type="number" step="0.0001" @bind="ReproductionQuantity" /></label>
        <label><span>@L["Reason"]</span><input @bind="AcceptedReason" /></label>
        <label><span>@L["Reason"]</span><input @bind="RejectedReason" /></label>
        <label><span>@L["Reason"]</span><input @bind="ReproductionReason" /></label>
    </div>
    <div class="form-actions">
        <button type="button" @onclick="SaveDisposition">@L["Save"]</button>
        <button type="button" @onclick="Approve">@L["Action_Complete"]</button>
        <button type="button" @onclick="Reject">@L["ValidationError"]</button>
    </div>
    <pre class="quality-json">@DispositionData</pre>
</section>

<section class="panel quality-workspace">
    <h2>@L["Action_Defect"]</h2>
    <div class="form-grid">
        <label><span>@L["ValidationError"]</span><input @bind="CriterionId" placeholder="GUID" /></label>
        <label><span>@L["Action_Defect"]</span><input @bind="DefectTypeId" placeholder="GUID" /></label>
        <label><span>@L["Reason"]</span><input @bind="Reason" /></label>
    </div>
    <div class="form-actions">
        <button type="button" @onclick="Result">@L["Save"]</button>
        <button type="button" @onclick="Defect">@L["Action_Defect"]</button>
        <button type="button" @onclick="Suspend">@L["Action_Cancel"]</button>
        <button type="button" @onclick="Review">@L["Action_Approval"]</button>
    </div>
</section>

<section class="panel quality-workspace">
    <h2>@L["Action_Reproduction"]</h2>
    <div class="form-actions">
        <button type="button" @onclick="Reproduce">@L["Action_Request"]</button>
        <button type="button" @onclick="GenerateJobs">@L["Action_Create"]</button>
        <button type="button" @onclick="LoadHistory">@L["Timeline"]</button>
    </div>
    <pre class="quality-json">@HistoryData</pre>
</section>

@code {
    private string ProductionJobId = "", TemplateId = "", InspectionId = "", ReproductionRequestId = "", CriterionId = "", DefectTypeId = "";
    private string InspectionData = "", DispositionData = "", HistoryData = "", Reason = "quality review";
    private string AcceptedReason = "accepted by inspection", RejectedReason = "", ReproductionReason = "";
    private decimal AcceptedQuantity, RejectedQuantity, ReproductionQuantity;
    private long Version, DispositionVersion = 1;
    private bool Success;
    private string? Message;

    private Task Start() => Post("api/v1/quality/inspections", new { productionJobId = ProductionJobId, templateId = TemplateId, parentInspectionId = (Guid?)null });
    private async Task LoadInspection()
    {
        var s = await Session(); if (s is null || !Guid.TryParse(InspectionId, out Guid id)) return;
        var r = await Core.GetAsync($"api/v1/quality/inspections/{id}", s.Value.Token, s.Value.Company, default); Show(r);
        if (r.IsSuccess) { InspectionData = r.Value.ToString(); Version = r.Value.GetProperty("version").GetInt64(); }
    }
    private Task SaveDisposition() => Put($"api/v1/quality/inspections/{InspectionId}/disposition", new { acceptedQuantity = AcceptedQuantity, rejectedQuantity = RejectedQuantity, reproductionRequiredQuantity = ReproductionQuantity, acceptedReason = AcceptedReason, rejectedReason = string.IsNullOrWhiteSpace(RejectedReason) ? null : RejectedReason, reproductionReason = string.IsNullOrWhiteSpace(ReproductionReason) ? null : ReproductionReason, version = DispositionVersion });
    private Task Result() => Post($"api/v1/quality/inspections/{InspectionId}/results", new { criterionId = CriterionId, passFailValue = true, numericValue = (decimal?)null, textValue = (string?)null, choiceCode = (string?)null });
    private Task Defect() => Post($"api/v1/quality/inspections/{InspectionId}/defects", new { criteriaResultId = (Guid?)null, defectTypeId = DefectTypeId, quantity = RejectedQuantity + ReproductionQuantity, severity = "Major", notes = Reason, evidenceFileVersionId = (Guid?)null });
    private Task Approve() => Post($"api/v1/quality/inspections/{InspectionId}/approve", new { version = Version });
    private Task Suspend() => Post($"api/v1/quality/inspections/{InspectionId}/suspend", new { reason = Reason, version = Version });
    private Task Review() => Post($"api/v1/quality/inspections/{InspectionId}/review", new { reason = Reason, version = Version });
    private Task Reject() => Post($"api/v1/quality/inspections/{InspectionId}/reject", new { reason = Reason, version = Version });
    private Task Reproduce() => Post($"api/v1/quality/inspections/{InspectionId}/reproduction", new { requestedStage = "FullItem", quantity = ReproductionQuantity, reason = ReproductionReason });
    private Task GenerateJobs() => Post($"api/v1/quality/reproductions/{ReproductionRequestId}/jobs", new { version = Version });
    private async Task LoadHistory() { var s = await Session(); if (s is null || !Guid.TryParse(InspectionId, out Guid id)) return; var r = await Core.GetAsync($"api/v1/quality/history/{id}", s.Value.Token, s.Value.Company, default); HistoryData = r.IsSuccess ? r.Value.ToString() : ""; Show(r); }
    private async Task Post(string path, object body) { var s = await Session(); if (s is null) return; var r = await Core.SendAsync(HttpMethod.Post, path, body, s.Value.Token, s.Value.Company, default); Show(r); if (r.IsSuccess && r.Value.ValueKind == System.Text.Json.JsonValueKind.Object) { if (path.Contains("/reproduction", StringComparison.OrdinalIgnoreCase) && r.Value.TryGetProperty("id", out var reproduction)) ReproductionRequestId = reproduction.ToString(); else if (r.Value.TryGetProperty("id", out var id)) InspectionId = id.ToString(); if (r.Value.TryGetProperty("version", out var v)) Version = v.GetInt64(); InspectionData = r.Value.ToString(); } }
    private async Task Put(string path, object body) { var s = await Session(); if (s is null) return; var r = await Core.SendAsync(HttpMethod.Put, path, body, s.Value.Token, s.Value.Company, default); Show(r); if (r.IsSuccess) DispositionData = r.Value.ToString(); }
    private void Show(ApiResult<System.Text.Json.JsonElement> r) { Success = r.IsSuccess; Message = r.IsSuccess ? "OperationSucceeded" : r.Failure switch { ApiFailure.Unauthorized => "SessionExpired", ApiFailure.Forbidden => "Unauthorized", ApiFailure.Conflict => "ConcurrencyConflict", ApiFailure.Validation => "ValidationError", _ => "GenericError" }; }
    private async Task<(string Token, Guid Company)?> Session() { var u = (await AuthState.GetAuthenticationStateAsync()).User; return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value, out var c) && u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t ? (t, c) : null; }
}
