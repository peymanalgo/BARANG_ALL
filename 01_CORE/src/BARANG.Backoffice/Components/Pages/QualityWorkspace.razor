@page "/workspace/quality"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject NavigationManager Navigation
<PageTitle>@L["Module_quality"]</PageTitle><div class="page-heading"><h1>@L["Module_quality"]</h1></div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<div class="management-grid"><section class="panel"><h2>@L["Action_Inspect"]</h2><div class="form-grid single"><label><span>@L["Code"]</span><input @bind="Code" /></label><label><span>@L["Name"]</span><input @bind="Name" /></label><label><span>@L["EntityId"]</span><input @bind="Entity" /></label><label><span>@L["Version"]</span><input type="number" @bind="Version" /></label><label><span>@L["Reason"]</span><input @bind="Reason" /></label></div><div class="form-actions"><button type="button" @onclick="Template">@L["Action_Create"]</button><button type="button" @onclick="DefectType">@L["Action_Defect"]</button><button type="button" @onclick="Inspection">@L["Action_Inspect"]</button><button type="button" @onclick="LoadInspection">@L["Refresh"]</button></div><BarangJsonGrid Json="@InspectionData" /></section><section class="panel"><h2>@L["Action_Defect"]</h2><label><span>@L["Permission"]</span><input @bind="Related" /></label><label><span>@L["Action_Defect"]</span><ReferenceSelect TypeCode="defect.type" @bind-Value="SelectedDefectType" /></label><div class="form-actions"><button type="button" @onclick="Result">@L["Save"]</button><button type="button" @onclick="Defect">@L["Action_Defect"]</button><button type="button" @onclick="Approve">@L["Action_Complete"]</button><button type="button" @onclick="Suspend">@L["Action_Cancel"]</button><button type="button" @onclick="Review">@L["Action_Approval"]</button><button type="button" @onclick="Reject">@L["ValidationError"]</button></div></section></div><section class="panel"><h2>@L["Action_Reproduction"]</h2><div class="form-actions"><button type="button" @onclick="Reproduce">@L["Action_Request"]</button><button type="button" @onclick="GenerateJobs">@L["Action_Create"]</button><button type="button" @onclick="LoadHistory">@L["Timeline"]</button><button type="button" @onclick="Analytics">@L["Refresh"]</button></div><BarangJsonGrid Json="@History" /><BarangJsonGrid Json="@AnalyticsData" /></section>
@code{private string Code="B21QC",Name="Backoffice QC",Entity="",Related="",SelectedDefectType="",Reason="Backoffice review",InspectionData="",History="",AnalyticsData="";private long Version;private bool Success;private string?Message;private Task Template()=>Post("api/v1/quality/templates",new{code=Code,name=Name,applicableJobType=(string?)null,productTypeCode=(string?)null,criteria=new[]{new{code="PASS",name=Name,criterionType="PassFail",isRequired=true,sortOrder=1,minimumValue=(decimal?)null,maximumValue=(decimal?)null,allowedChoiceCodes=(string?)null}}});private void DefectType()=>Navigation.NavigateTo("/master/reference-data/quality/defect.type");private Task Inspection()=>Post("api/v1/quality/inspections",new{productionJobId=Entity,templateId=Related,parentInspectionId=(Guid?)null});private async Task LoadInspection(){var s=await Session();if(s is null)return;var r=await Core.GetAsync($"api/v1/quality/inspections/{Entity}",s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){InspectionData=r.Value.ToString();Version=r.Value.GetProperty("version").GetInt64();}}private Task Result()=>Post($"api/v1/quality/inspections/{Entity}/results",new{criterionId=Related,passFailValue=true,numericValue=(decimal?)null,textValue=(string?)null,choiceCode=(string?)null});private Task Defect()=>Post($"api/v1/quality/inspections/{Entity}/defects",new{criteriaResultId=(Guid?)null,defectTypeId=SelectedDefectType,quantity=1,severity="Major",notes=Reason,evidenceFileVersionId=(Guid?)null});private Task Approve()=>Post($"api/v1/quality/inspections/{Entity}/approve",new{version=Version});private Task Suspend()=>Post($"api/v1/quality/inspections/{Entity}/suspend",new{reason=Reason,version=Version});private Task Review()=>Post($"api/v1/quality/inspections/{Entity}/review",new{reason=Reason,version=Version});private Task Reject()=>Post($"api/v1/quality/inspections/{Entity}/reject",new{reason=Reason,version=Version});private Task Reproduce()=>Post($"api/v1/quality/inspections/{Entity}/reproduction",new{requestedStage="FullItem",quantity=1,reason=Reason});private Task GenerateJobs()=>Post($"api/v1/quality/reproductions/{Entity}/jobs",new{version=Version});private async Task LoadHistory(){var s=await Session();if(s is null)return;var r=await Core.GetAsync($"api/v1/quality/history/{Entity}",s.Value.Token,s.Value.Company,default);History=r.IsSuccess?r.Value.ToString():"";}private async Task Analytics(){var s=await Session();if(s is null)return;var r=await Core.GetAsync($"api/v1/quality/analytics?from={Uri.EscapeDataString(DateTimeOffset.UtcNow.AddYears(-1).ToString("O"))}&to={Uri.EscapeDataString(DateTimeOffset.UtcNow.ToString("O"))}&top=10",s.Value.Token,s.Value.Company,default);AnalyticsData=r.IsSuccess?r.Value.ToString():"";}private async Task Post(string p,object b){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,p,b,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess&&r.Value.ValueKind==System.Text.Json.JsonValueKind.Object){Entity=G(r.Value,"id");Version=r.Value.TryGetProperty("version",out var v)?v.GetInt64():Version;InspectionData=r.Value.ToString();}}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.ToString():"";}
