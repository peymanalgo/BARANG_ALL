@page "/master/equipment"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Rendering
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<CrudStrings> T
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates

<PageTitle>@L["Master_equipment"] · BARANG</PageTitle>
<nav class="breadcrumbs"><span>@L["Module_master-data"]</span><span>/</span><span>@L["Master_equipment"]</span></nav>
<header class="crud-header"><div><h1>@L["Master_equipment"]</h1><p>@T["Details"]</p></div><button type="button" class="btn btn-primary" @onclick="New"><BarangIcon Name="plus" />@T["Add"]</button></header>
<section class="crud-card" data-equipment-directory>
    <div class="crud-toolbar"><label class="search-box"><BarangIcon Name="search" /><input value="@Search" @oninput="SearchChanged" placeholder="@T["SearchHint"]" /></label><select aria-label="@L["EquipmentStatus"]" @onchange="StatusChanged"><option value="">@T["All"]</option><option value="active">@T["Active"]</option><option value="inactive">@T["Inactive"]</option></select><button type="button" class="btn btn-secondary" @onclick="Load"><BarangIcon Name="reset" />@T["Reset"]</button></div>
    @if (Loading) { <BarangLoadingState Text="@T["Loading"]" /> }
    else if (Rows.Count == 0) { <CrudEmptyState /> }
    else { <div class="data-grid-wrap"><table class="data-grid equipment-grid"><thead><tr><th>@L["EquipmentNumber"]</th><th>@T["Name"]</th><th>@L["EquipmentCategory"]</th><th>@L["BrandModel"]</th><th>@L["SerialNumber"]</th><th>@L["EquipmentStatus"]</th><th class="actions-column">@T["Actions"]</th></tr></thead><tbody>@foreach (var row in Rows) { <tr><td>@Text(row,"equipmentCode")</td><td>@Text(row,"name")<small>@Text(row,"assetTag")</small></td><td>@Text(row,"equipmentCategoryCode")</td><td>@Text(row,"brandCode") / @Text(row,"model")</td><td>@Text(row,"serialNumber")</td><td>@LifecycleLabel(Text(row,"lifecycleStatusCode"))</td><td><BarangActionMenu><BarangIconButton Icon="eye" Label="@T["View"]" Semantic="info" Clicked="@(() => Open(Text(row,"id"), true))" /><BarangIconButton Icon="edit" Label="@T["Edit"]" Semantic="edit" Clicked="@(() => Open(Text(row,"id"), false))" /><BarangIconButton Icon="power" Label="@(Bool(row,"isActive") ? L["Deactivate"] : L["Activate"])" Semantic="@(Bool(row,"isActive") ? "warning" : "success")" Clicked="@(() => Toggle(Text(row,"id"), Bool(row,"isActive"), RowVersion(row)))" /></BarangActionMenu></td></tr> }</tbody></table></div> }
</section>

<BarangModal Open="@Dialog" Title="@(Viewing ? T["View"] : (Id.Length == 0 ? T["Add"] : T["Edit"]))" Description="@L["Master_equipment"]" Size="xl" ShowCloseButton="false" CloseRequested="Close" data-equipment-editor="true">
    <ChildContent>
        <div class="equipment-editor-layout">
            <BarangTabs Class="is-vertical equipment-tabs" Orientation="vertical" AriaLabel="@L["Master_equipment"]">
                @foreach (var tab in Tabs) { <button type="button" role="tab" aria-selected="@(Tab == tab)" class="@(Tab == tab ? "active" : null)" data-equipment-tab="@tab" @onclick="@(() => Tab = tab)">@TabLabel(tab)</button> }
            </BarangTabs>
            <div class="equipment-tab-content">
                @if (Tab == "general") { <section class="form-section"><h3>@L["GeneralInformation"]</h3><div class="form-grid">@Field("equipmentCode", L["EquipmentNumber"])@Field("name", T["Name"])@Field("assetNumber", L["AssetNumber"])@Field("assetTag", L["AssetTag"])@Field("equipmentCategoryCode", L["EquipmentCategory"], "equipment.category")@Field("equipmentTypeCode", L["EquipmentType"], "equipment.type")@Field("equipmentSubtypeCode", L["EquipmentSubtype"], "equipment.subtype")@Field("conditionCode", L["EquipmentCondition"], "equipment.condition")@Field("criticalityCode", L["Criticality"], "equipment.criticality")@Field("description", T["Description"], null, true)</div></section> }
                @if (Tab == "technical") { <section class="form-section"><h3>@L["TechnicalSpecifications"]</h3><div class="form-grid">@Field("brandCode", L["Brand"], "equipment.brand")@Field("model", L["Model"])@Field("manufacturerCode", L["Manufacturer"], "equipment.manufacturer")@Field("serialNumber", L["SerialNumber"])@Field("notes", T["Notes"], null, true)</div><p class="field-help">@L["StructuredSpecificationsHelp"]</p></section> }
                @if (Tab == "assignment") { <section class="form-section"><h3>@L["AssignmentLocation"]</h3><div class="form-grid">@Field("physicalLocation", L["PhysicalLocation"])@Field("branchId", L["Branch"])@Field("organizationalUnitId", L["OrganizationalUnit"])@Field("warehouseId", L["Warehouse"])@Field("responsiblePersonId", L["ResponsiblePerson"])@Field("assignedPersonId", L["AssignedPerson"])</div><p class="field-help">@L["AssignmentHistoryPreserved"]</p></section> }
                @if (Tab == "acquisition") { <section class="form-section"><h3>@L["AcquisitionWarranty"]</h3><div class="form-grid">@Field("ownershipTypeCode", L["OwnershipType"], "equipment.ownership")@Field("acquisitionMethodCode", L["AcquisitionMethod"], "equipment.acquisition")@Field("purchaseDate", L["PurchaseDate"])@Field("purchasePrice", L["PurchasePrice"])@Field("currencyCode", L["Currency"])@Field("purchaseReference", L["PurchaseReference"])@Field("warrantyStart", L["WarrantyStart"])@Field("warrantyEnd", L["WarrantyEnd"])@Field("warrantyProvider", L["WarrantyProvider"])@Field("warrantyNotes", L["WarrantyNotes"], null, true)</div></section> }
                @if (Tab == "lifecycle") { <section class="form-section"><h3>@L["Lifecycle"]</h3><div class="form-grid">@Field("lifecycleStatusCode", L["LifecycleStatus"], "equipment.status")@Field("operationalStatusCode", L["OperationalStatus"], "equipment.status")@Field("retirementDate", L["RetirementDate"])@Field("retirementReasonCode", L["RetirementReason"], "equipment.retirement.reason")@Field("expectedUsefulLifeMonths", L["UsefulLifeMonths"])</div><div class="row-actions lifecycle-actions"><button type="button" class="btn btn-secondary" disabled="@Viewing" @onclick="@(()=>SetLifecycle("IN_SERVICE"))">@L["InService"]</button><button type="button" class="btn btn-secondary" disabled="@Viewing" @onclick="@(()=>SetLifecycle("OUT_OF_SERVICE"))">@L["OutOfService"]</button><button type="button" class="btn btn-secondary" disabled="@Viewing" @onclick="@(()=>SetLifecycle("UNDER_REPAIR"))">@L["UnderRepair"]</button><button type="button" class="btn btn-secondary" disabled="@Viewing" @onclick="@(()=>SetLifecycle("UNDER_MAINTENANCE"))">@L["UnderMaintenance"]</button><button type="button" class="btn btn-secondary" disabled="@Viewing" @onclick="@(()=>SetLifecycle("RESERVED"))">@L["Reserved"]</button><button type="button" class="btn btn-danger" disabled="@Viewing" @onclick="@(()=>SetLifecycle("RETIRED"))">@L["RetiredDisposed"]</button></div></section> }
                @if (Tab == "documents") { <section class="form-section"><h3>@L["DocumentsAttachments"]</h3><p class="field-help">@L["EquipmentDocumentsHelp"]</p><InputFile disabled="@Viewing" accept="application/pdf,image/*,.doc,.docx" OnChange="UploadEquipmentDocument" />@if (!string.IsNullOrWhiteSpace(DocumentMessage)) { <p class="field-help">@DocumentMessage</p> }</section> }
                @if (Tab == "failures") { <section class="form-section"><h3>@TabLabel(Tab)</h3><div class="form-grid">@ChildField("failureNumber", L["FailureNumber"])@ChildField("failureTypeCode", L["FailureType"], "equipment.failure.type")@ChildField("failureCauseCode", L["FailureCause"], "equipment.failure.cause")@ChildField("severityCode", L["Severity"])@ChildField("failureAtUtc", L["FailureDateTime"])@ChildField("description", T["Description"], null, true)</div><button type="button" class="btn btn-primary" disabled="@(Viewing || Id.Length == 0)" @onclick="AddFailure">@T["Add"]</button>@ChildRows("failures")</section> }
                @if (Tab == "repairs") { <section class="form-section"><h3>@TabLabel(Tab)</h3><div class="form-grid">@ChildField("repairNumber", L["RepairNumber"])@ChildField("repairTypeCode", L["RepairType"], "equipment.repair.type")@ChildField("startedAtUtc", L["StartDateTime"])@ChildField("workPerformed", L["WorkPerformed"], null, true)@ChildField("laborCost", L["LaborCost"])@ChildField("partsCost", L["PartsCost"])</div><button type="button" class="btn btn-primary" disabled="@(Viewing || Id.Length == 0)" @onclick="AddRepair">@T["Add"]</button>@ChildRows("repairs")</section> }
                @if (Tab == "maintenance") { <section class="form-section"><h3>@TabLabel(Tab)</h3><div class="form-grid">@ChildField("maintenanceTypeCode", L["MaintenanceType"], "equipment.service.type")@ChildField("serviceDate", L["ServiceDate"])@ChildField("nextServiceDate", L["NextServiceDate"])@ChildField("workPerformed", L["WorkPerformed"], null, true)@ChildField("cost", L["Cost"])</div><button type="button" class="btn btn-primary" disabled="@(Viewing || Id.Length == 0)" @onclick="AddMaintenance">@T["Add"]</button>@ChildRows("maintenance")</section> }
                @if (Tab == "inspection") { <section class="form-section"><h3>@TabLabel(Tab)</h3><div class="form-grid">@ChildField("inspectionTypeCode", L["InspectionType"], "equipment.inspection.type")@ChildField("date", L["Date"])@ChildField("nextDueDate", L["NextDueDate"])@ChildField("certificateNumber", L["CertificateNumber"])<label><span>@L["Passed"]</span><input type="checkbox" @onchange="OnPassedChanged" disabled="@Viewing" /></label></div><button type="button" class="btn btn-primary" disabled="@(Viewing || Id.Length == 0)" @onclick="AddInspection">@T["Add"]</button>@ChildRows("inspections")</section> }
            </div>
        </div>
    </ChildContent>
    <Footer><button type="button" class="btn btn-secondary" @onclick="Close">@T["Cancel"]</button>@if (!Viewing) { <button type="button" class="btn btn-primary" @onclick="Save">@T["Save"]</button> }</Footer>
</BarangModal>

@code {
    private JsonElement Detail;
    private Dictionary<string,string> Child = [];
    private RenderFragment ChildField(string key, string label, string? type = null, bool wide = false) => builder => { var s=0; builder.OpenElement(s++, "label"); if(wide) builder.AddAttribute(s++,"class","span-2"); builder.AddContent(s++,label); if(type is null){builder.OpenElement(s++,"input");builder.AddAttribute(s++,"value",Child.GetValueOrDefault(key,""));builder.AddAttribute(s++,"disabled",Viewing);builder.AddAttribute(s++,"oninput",EventCallback.Factory.Create<ChangeEventArgs>(this,e=>ChildSet(key,e.Value)));builder.CloseElement();}else{builder.OpenComponent<ReferenceSelect>(s++);builder.AddAttribute(s++,"TypeCode",type);builder.AddAttribute(s++,"UseCode",true);builder.AddAttribute(s++,"Value",Child.GetValueOrDefault(key,""));builder.AddAttribute(s++,"ValueChanged",EventCallback.Factory.Create<string>(this,v=>ChildSet(key,v)));builder.AddAttribute(s++,"Disabled",Viewing);builder.CloseComponent();}builder.CloseElement();};
    private void ChildSet(string key, object? value) => Child[key] = value?.ToString() ?? ""; private void OnPassedChanged(ChangeEventArgs e) => ChildSet("passed", e.Value);
    private string ChildValue(string key) => Child.TryGetValue(key, out var value) ? value : "";
    private RenderFragment ChildRows(string key) => builder => { var s=0; if(Detail.ValueKind != JsonValueKind.Object || !Detail.TryGetProperty(key,out var list) || list.ValueKind != JsonValueKind.Array)return; builder.OpenElement(s++,"div");builder.AddAttribute(s++,"class","data-grid-wrap");builder.OpenElement(s++,"table");builder.AddAttribute(s++,"class","data-grid equipment-grid");builder.OpenElement(s++,"thead");builder.OpenElement(s++,"tr");builder.OpenElement(s++,"th");builder.AddContent(s++,ChildTitle(key));builder.CloseElement();builder.OpenElement(s++,"th");builder.AddContent(s++,L["Status"]);builder.CloseElement();builder.OpenElement(s++,"th");builder.AddContent(s++,T["Actions"]);builder.CloseElement();builder.CloseElement();builder.CloseElement();builder.OpenElement(s++,"tbody");foreach(var item in list.EnumerateArray()){var childId=Text(item,"id");var version=RowVersion(item);builder.OpenElement(s++,"tr");builder.OpenElement(s++,"td");builder.AddContent(s++,item.TryGetProperty("failureNumber",out var fn)?fn.ToString():item.TryGetProperty("repairNumber",out var rn)?rn.ToString():item.TryGetProperty("maintenanceTypeCode",out var mt)?mt.ToString():item.TryGetProperty("inspectionTypeCode",out var it)?it.ToString():childId);builder.CloseElement();builder.OpenElement(s++,"td");builder.AddContent(s++,item.TryGetProperty("resolutionStatus",out var rs)?rs.ToString():item.TryGetProperty("status",out var st)?st.ToString():item.TryGetProperty("passed",out var ps)?(ps.ValueKind==JsonValueKind.True?L["Passed"]:L["Failed"]):"");builder.CloseElement();if(!Viewing){builder.OpenElement(s++,"td");builder.AddAttribute(s++,"class","row-actions");builder.AddContent(s++,ChildActions(key,childId,version,key=="failures"&&item.TryGetProperty("resolutionStatus",out var status)&&status.ToString()!="Resolved",key=="repairs"&&item.TryGetProperty("status",out var repairStatus)&&repairStatus.ToString()!="Completed"));builder.CloseElement();}builder.CloseElement();}builder.CloseElement();builder.CloseElement();builder.CloseElement();};
    private RenderFragment ChildActions(string key,string childId,long version,bool canResolve,bool canComplete)=>builder=>{var s=0;builder.OpenComponent<BarangActionMenu>(s++);builder.AddAttribute(s++,"ChildContent",(RenderFragment)(menu=>{var inner=0;if(canResolve)AddChildAction(menu,ref inner,"check",L["Resolve"],()=>ResolveFailure(childId,version));if(canComplete)AddChildAction(menu,ref inner,"check",L["Complete"],()=>CompleteRepair(childId,version));AddChildAction(menu,ref inner,"trash",L["Delete"],()=>DeleteChild(key,childId,version));}));builder.CloseComponent();};
    private void AddChildAction(RenderTreeBuilder b,ref int seq,string icon,string label,Func<Task> action){b.OpenComponent<BarangIconButton>(seq++);b.AddAttribute(seq++,"Icon",icon);b.AddAttribute(seq++,"Label",label);b.AddAttribute(seq++,"Semantic",icon=="trash"?"danger":"info");b.AddAttribute(seq++,"Clicked",EventCallback.Factory.Create<MouseEventArgs>(this,action));b.CloseComponent();}
    private async Task DeleteChild(string key,string childId,long version){if(Token is null||!Guid.TryParse(Id,out var id)||!Guid.TryParse(childId,out var cid))return;var route=key switch{"failures"=>$"failures/{cid}","repairs"=>$"repairs/{cid}","maintenance"=>$"maintenance/{cid}","inspections"=>$"inspections/{cid}",_=>""};if(route.Length>0)await Core.SendAsync(HttpMethod.Delete,$"api/v1/company-equipment/{id}/{route}?version={version}",null,Token,Company,default);await RefreshDetail();}
    private async Task ResolveFailure(string childId,long version){if(Token is null||!Guid.TryParse(Id,out var id)||!Guid.TryParse(childId,out var cid))return;await Core.SendAsync(HttpMethod.Post,$"api/v1/company-equipment/{id}/failures/{cid}/resolve",new{version},Token,Company,default);await RefreshDetail();}
    private async Task CompleteRepair(string childId,long version){if(Token is null||!Guid.TryParse(Id,out var id)||!Guid.TryParse(childId,out var cid))return;await Core.SendAsync(HttpMethod.Post,$"api/v1/company-equipment/{id}/repairs/{cid}/complete",new{completedAtUtc=DateTimeOffset.UtcNow,version},Token,Company,default);await RefreshDetail();}
    private async Task AddFailure(){if(Token is null||!Guid.TryParse(Id,out var id))return;await Core.SendAsync(HttpMethod.Post,$"api/v1/company-equipment/{id}/failures",new{failureNumber=ChildValue("failureNumber") is {Length:>0} ? ChildValue("failureNumber") : "FAIL-"+DateTime.UtcNow.Ticks,failureAtUtc=DateTimeOffset.UtcNow,failureTypeCode=ChildValue("failureTypeCode") is {Length:>0} ? ChildValue("failureTypeCode") : "GENERAL",failureCauseCode=(string?)null,severityCode=(string?)null,description=(string?)null,resolutionStatus="Open",notes=(string?)null},Token,Company,default);await RefreshDetail();}
    private async Task AddRepair(){if(Token is null||!Guid.TryParse(Id,out var id))return;await Core.SendAsync(HttpMethod.Post,$"api/v1/company-equipment/{id}/repairs",new{repairNumber=ChildValue("repairNumber") is {Length:>0} ? ChildValue("repairNumber") : "REP-"+DateTime.UtcNow.Ticks,repairTypeCode=ChildValue("repairTypeCode") is {Length:>0} ? ChildValue("repairTypeCode") : "GENERAL",startedAtUtc=DateTimeOffset.UtcNow,external=false,status="Open",workPerformed=(string?)ChildValue("workPerformed"),laborCost=DecimalOrNullChild("laborCost"),partsCost=DecimalOrNullChild("partsCost")},Token,Company,default);await RefreshDetail();}
    private async Task AddMaintenance(){if(Token is null||!Guid.TryParse(Id,out var id))return;var today=DateOnly.FromDateTime(DateTime.UtcNow);await Core.SendAsync(HttpMethod.Post,$"api/v1/company-equipment/{id}/maintenance",new{maintenanceTypeCode=Child.GetValueOrDefault("maintenanceTypeCode","GENERAL"),preventive=true,serviceDate=today,nextServiceDate=DateOrNullChild("nextServiceDate"),status="Completed",cost=DecimalOrNullChild("cost")},Token,Company,default);await RefreshDetail();}
    private async Task AddInspection(){if(Token is null||!Guid.TryParse(Id,out var id))return;var today=DateOnly.FromDateTime(DateTime.UtcNow);await Core.SendAsync(HttpMethod.Post,$"api/v1/company-equipment/{id}/inspections",new{inspectionTypeCode=ChildValue("inspectionTypeCode") is {Length:>0} ? ChildValue("inspectionTypeCode") : "GENERAL",date=today,nextDueDate=DateOrNullChild("nextDueDate"),certificateNumber=(string?)ChildValue("certificateNumber"),passed=ChildValue("passed")=="True"},Token,Company,default);await RefreshDetail();}
    private DateOnly? DateOrNullChild(string k)=>Dates.TryParseCanonical(Child.GetValueOrDefault(k,""),out var d)?d:null; private decimal? DecimalOrNullChild(string k)=>decimal.TryParse(Child.GetValueOrDefault(k,""),NumberStyles.Number,CultureInfo.InvariantCulture,out var d)?d:null;
    private async Task RefreshDetail(){if(Token is null||!Guid.TryParse(Id,out var id))return;var r=await Core.GetAsync($"api/v1/equipment/{id}",Token,Company,default);if(r.IsSuccess)Detail=r.Value;}
    private async Task Toggle(string id, bool active, long version) { if (Token is null) return; await Core.SendAsync(HttpMethod.Post, $"api/v1/equipment/{id}/activation", new { isActive = !active, version }, Token, Company, default); await Load(); }
    private static bool Bool(JsonElement x, string k) => x.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.True;
    private static long RowVersion(JsonElement x) => x.TryGetProperty("version", out var v) && v.TryGetInt64(out var n) ? n : 0;
    private readonly string[] Tabs = ["general", "technical", "assignment", "acquisition", "failures", "repairs", "maintenance", "inspection", "documents", "lifecycle"];
    private List<JsonElement> Rows = []; private Dictionary<string,string> Data = []; private string Search = "", StatusFilter = "", Tab = "general", Id = ""; private bool Loading, Dialog, Viewing; private string? Token; private Guid Company;
    protected override async Task OnInitializedAsync() { var state = await AuthState.GetAuthenticationStateAsync(); Token = state.User.FindFirst(AuthClaimTypes.AccessToken)?.Value; Guid.TryParse(state.User.FindFirst(AuthClaimTypes.CompanyId)?.Value, out Company); await Load(); }
    private async Task Load() { if (Token is null) return; Loading = true; var active = StatusFilter == "active" ? "true" : "false"; var r = await Core.GetAsync($"api/v1/equipment/?search={Uri.EscapeDataString(Search)}&activeOnly={active}&pageNumber=1&pageSize=20", Token, Company, default); Rows = r.IsSuccess ? r.Value.GetProperty("items").EnumerateArray().Where(x => StatusFilter != "inactive" || !Bool(x, "isActive")).ToList() : []; Loading = false; }
    private async Task StatusChanged(ChangeEventArgs e) { StatusFilter = e.Value?.ToString() ?? ""; await Load(); }
    private async Task SearchChanged(ChangeEventArgs e) { Search = e.Value?.ToString() ?? ""; await Load(); }
    private void New() { Id = ""; Data = Defaults(); Tab = "general"; Viewing = false; Dialog = true; }
    private async Task Open(string id, bool view) { if (Token is null) return; var r = await Core.GetAsync($"api/v1/equipment/{id}", Token, Company, default); if (!r.IsSuccess) return; Id = id; Detail = r.Value; Data = Read(r.Value); Child = []; Tab = "general"; Viewing = view; Dialog = true; }
    private async Task Save() { if (Token is null) return; var body = new { equipmentCode = V("equipmentCode"), name = V("name"), equipmentTypeCode = V("equipmentTypeCode"), operationalStatusCode = V("operationalStatusCode"), lifecycleStatusCode = V("lifecycleStatusCode"), assetNumber = N("assetNumber"), assetTag = N("assetTag"), equipmentCategoryCode = N("equipmentCategoryCode"), equipmentSubtypeCode = N("equipmentSubtypeCode"), brandCode = N("brandCode"), manufacturerCode = N("manufacturerCode"), conditionCode = N("conditionCode"), criticalityCode = N("criticalityCode"), ownershipTypeCode = N("ownershipTypeCode"), acquisitionMethodCode = N("acquisitionMethodCode"), branchId = GuidOrNull("branchId"), organizationalUnitId = GuidOrNull("organizationalUnitId"), warehouseId = GuidOrNull("warehouseId"), physicalLocation = N("physicalLocation"), responsiblePersonId = GuidOrNull("responsiblePersonId"), assignedPersonId = GuidOrNull("assignedPersonId"), manufacturer = N("manufacturer"), model = N("model"), serialNumber = N("serialNumber"), description = N("description"), notes = N("notes"), purchaseDate = DateOrNull("purchaseDate"), purchasePrice = DecimalOrNull("purchasePrice"), currencyCode = N("currencyCode"), supplierId = GuidOrNull("supplierId"), purchaseReference = N("purchaseReference"), commissioningDate = DateOrNull("commissioningDate"), warrantyStart = DateOrNull("warrantyStart"), warrantyEnd = DateOrNull("warrantyEnd"), warrantyProvider = N("warrantyProvider"), warrantyNotes = N("warrantyNotes"), expectedUsefulLifeMonths = IntOrNull("expectedUsefulLifeMonths"), retirementDate = DateOrNull("retirementDate"), retirementReasonCode = N("retirementReasonCode"), version = LongOrZero("version") }; var r = await Core.SendAsync(Id.Length == 0 ? HttpMethod.Post : HttpMethod.Put, "api/v1/equipment" + (Id.Length == 0 ? "/" : "/" + Id), body, Token, Company, default); if (r.IsSuccess) { Dialog = false; await Load(); } }
    private void Close() => Dialog = false; private string DocumentMessage = "";
    private async Task SetLifecycle(string status){Data["lifecycleStatusCode"]=status;await Save();}
    private async Task UploadEquipmentDocument(InputFileChangeEventArgs args) { if (Viewing || Token is null || !Guid.TryParse(Id, out var equipment) || args.File is null) return; await using var stream = args.File.OpenReadStream(25 * 1024 * 1024); var uploaded = await Core.UploadAsync("api/v1/files/upload", args.File.Name, args.File.ContentType, stream, args.File.Size, Token, Company, default); if (!uploaded.IsSuccess) { DocumentMessage = L["UploadFailed"]; return; } var file = uploaded.Value; var linked = await Core.SendAsync(HttpMethod.Post, $"api/v1/files/{file.GetProperty("fileId").GetGuid()}/links", new { fileVersionId = file.GetProperty("fileVersionId").GetGuid(), entityType = "Equipment", entityId = equipment, purpose = "Attachment" }, Token, Company, default); DocumentMessage = linked.IsSuccess ? L["UploadComplete"] : L["UploadFailed"]; }
    private RenderFragment Field(string key, string label, string? type = null, bool wide = false) => builder => { var s = 0; builder.OpenElement(s++, "label"); if (wide) builder.AddAttribute(s++, "class", "span-2"); builder.AddContent(s++, label); if (type is null) { builder.OpenElement(s++, "input"); builder.AddAttribute(s++, "name", key); builder.AddAttribute(s++, "value", V(key)); builder.AddAttribute(s++, "disabled", Viewing); builder.AddAttribute(s++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => Set(key, e.Value))); builder.CloseElement(); } else { builder.OpenComponent<ReferenceSelect>(s++); builder.AddAttribute(s++, "TypeCode", type); builder.AddAttribute(s++, "Name", key); builder.AddAttribute(s++, "UseCode", true); builder.AddAttribute(s++, "Value", V(key)); builder.AddAttribute(s++, "ValueChanged", EventCallback.Factory.Create<string>(this, value => Set(key, value))); builder.AddAttribute(s++, "Disabled", Viewing); builder.CloseComponent(); } builder.CloseElement(); };
    private Dictionary<string,string> Defaults() => new() { ["equipmentCode"] = "EQ-" + DateTime.UtcNow.Ticks, ["name"] = "", ["equipmentTypeCode"] = "", ["operationalStatusCode"] = "", ["lifecycleStatusCode"] = "IN_SERVICE" };
    private static Dictionary<string,string> Read(JsonElement x) => x.EnumerateObject().ToDictionary(p => p.Name, p => p.Value.ValueKind == JsonValueKind.Null ? "" : p.Value.ToString()); private string V(string k) => Data.GetValueOrDefault(k, ""); private string? N(string k) => string.IsNullOrWhiteSpace(V(k)) ? null : V(k); private Guid? GuidOrNull(string k) => Guid.TryParse(V(k), out var v) ? v : null; private DateOnly? DateOrNull(string k) => Dates.TryParseCanonical(V(k), out var v) ? v : null; private decimal? DecimalOrNull(string k) => decimal.TryParse(V(k), NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : null; private int? IntOrNull(string k) => int.TryParse(V(k), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) ? v : null; private long LongOrZero(string k) => long.TryParse(V(k), out var v) ? v : 0; private void Set(string k, object? value) => Data[k] = value?.ToString() ?? ""; private static string Text(JsonElement x, string k) => x.TryGetProperty(k, out var v) && v.ValueKind != JsonValueKind.Null ? v.ToString() : "";
    private string TabLabel(string x) => x switch { "general" => L["GeneralInformation"], "technical" => L["TechnicalSpecifications"], "assignment" => L["AssignmentLocation"], "acquisition" => L["AcquisitionWarranty"], "failures" => L["FailureHistory"], "repairs" => L["RepairHistory"], "maintenance" => L["ServiceMaintenance"], "inspection" => L["InspectionCalibration"], "documents" => L["DocumentsAttachments"], _ => L["Lifecycle"] }; private string ChildTitle(string x)=>x switch{"failures"=>L["FailureHistory"],"repairs"=>L["RepairHistory"],"maintenance"=>L["ServiceMaintenance"],"inspections"=>L["InspectionCalibration"],_=>x}; private string LifecycleLabel(string x)=>x switch{"IN_SERVICE"=>L["InService"],"OUT_OF_SERVICE"=>L["OutOfService"],"UNDER_REPAIR"=>L["UnderRepair"],"UNDER_MAINTENANCE"=>L["UnderMaintenance"],"RESERVED"=>L["Reserved"],"RETIRED"=>L["RetiredDisposed"],_=>x};
}
