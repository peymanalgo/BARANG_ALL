@page "/system/design-audit"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@using BARANG.Backoffice.Localization
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject IStringLocalizer<NavigationStrings> Navi
@inject IStringLocalizer<DesignAuditStrings> D

<PageTitle>@D["da_title"] · BARANG</PageTitle>
<main class="page-shell design-audit-page">
    <header class="crud-header">
        <div>
            <span class="eyebrow">@Navi["Nav_SystemManagement"]</span>
            <h1>@D["da_title"]</h1>
            <p>@D["da_sub"]</p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="OpenNew"><span aria-hidden="true">＋</span>@D["da_new"]</button>
    </header>

    @if (Denied)
    {
        <section class="panel"><p class="muted">@ProblemText</p></section>
    }
    else if (Loading)
    {
        <section class="panel"><div class="crud-loading"><span></span>@D["da_loading"]</div></section>
    }
    else
    {
        <section class="panel crud-card">
            @if (Toast is not null)
            {
                <div class="alert @(ToastOk ? "alert-ok" : "alert-error")" role="status">@Toast</div>
            }
            @if (Rules.Count == 0)
            {
                <div class="crud-empty"><span>🛡</span><strong>@D["da_empty"]</strong><p>@D["da_sub"]</p></div>
            }
            else
            {
                <div class="data-grid-wrap">
                    <table class="data-grid">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>@D["da_code"]</th>
                                <th>@CultureTitle</th>
                                <th>@D["da_type"]</th>
                                <th>@D["da_size"]</th>
                                <th>@D["da_params"]</th>
                                <th>@D["da_active"]</th>
                                <th class="actions-column">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int row = 1; }
                            @foreach (var r in Rules)
                            {
                                <tr>
                                    <td>@(row++)</td>
                                    <td dir="ltr"><span class="code-pill">@r.Code</span></td>
                                    <td><strong>@Title(r)</strong></td>
                                    <td>@TypeLabel(r.RuleType)</td>
                                    <td>@(r.PrintSizeCode ?? D["da_all"])</td>
                                    <td dir="ltr"><span class="code-pill">@ParamsText(r)</span></td>
                                    <td><span class="status-badge @(r.IsActive ? "status-active" : "status-inactive")"><span></span>@(r.IsActive ? D["da_active"] : "—")</span></td>
                                    <td>
                                        <BarangActionMenu>
                                            <BarangIconButton Icon="eye" Label="@D["da_view"]" Clicked="() => OpenView(r)" />
                                            <BarangIconButton Icon="edit" Label="@D["da_edit"]" Clicked="() => OpenEdit(r)" />
                                            <BarangIconButton Icon="trash" Semantic="danger" Label="@L["Delete"]" Clicked="() => AskDelete(r)" />
                                        </BarangActionMenu>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</main>

@* پاپ‌آپ مشاهده *@
@if (Viewing is not null)
{
    <BarangModal Open Size="medium" Title="@D["da_view"]" Description="@Viewing.Code" CloseRequested="CloseDialog">
        <ChildContent>
        <div class="form-grid da-grid">
            <label class="form-field"><span>@D["da_code"]</span><input dir="ltr" value="@Viewing.Code" readonly /></label>
            <label class="form-field"><span>@D["da_type"]</span><input value="@TypeLabel(Viewing.RuleType)" readonly /></label>
            <label class="form-field"><span>@D["da_size"]</span><input value="@(Viewing.PrintSizeCode ?? D["da_all"])" readonly /></label>
            <label class="form-field"><span>@D["da_active"]</span><input value="@(Viewing.IsActive ? D["da_active"] : "—")" readonly /></label>
            <label class="form-field span-2"><span>@CultureTitle</span><input value="@Title(Viewing)" readonly /></label>
            <label class="form-field span-2"><span>@D["da_title_en"]</span><input dir="ltr" value="@Viewing.TitleEn" readonly /></label>
            <label class="form-field span-2"><span>@D["da_params"]</span><input dir="ltr" value="@ParamsText(Viewing)" readonly /></label>
        </div>
        </ChildContent>
    </BarangModal>
}

@* پاپ‌آپ ایجاد/ویرایش *@
@if (Editing is not null)
{
    <BarangModal Open Size="medium" Title="@(IsNew ? D["da_new"] : D["da_edit"])" Description="@(IsNew ? "" : Editing.Code)" CloseRequested="CloseDialog">
        <ChildContent>
        <div class="form-grid da-grid">
            @if (IsNew)
            {
                <label class="form-field"><span>@D["da_code"]</span><input dir="ltr" @bind="EditCode" placeholder="res-a4" /></label>
            }
            <label class="form-field"><span>@D["da_type"]</span>
                <select @bind="EditType">
                    <option value="min_resolution">@D["da_type_res"]</option>
                    <option value="text_in_bounds">@D["da_type_text"]</option>
                    <option value="contrast">@D["da_type_contrast"]</option>
                </select>
            </label>
            <label class="form-field"><span>@D["da_title_fa"]</span><input @bind="EditTitleFa" /></label>
            <label class="form-field"><span>@D["da_title_en"]</span><input dir="ltr" @bind="EditTitleEn" /></label>
            <label class="form-field"><span>عنوان (عربی)</span><input dir="rtl" @bind="EditTitleAr" /></label>
            <label class="form-field"><span>عنوان (اسپانیایی)</span><input dir="ltr" @bind="EditTitleEs" /></label>
            <label class="form-field"><span>@D["da_size"]</span>
                <select @bind="EditPrintSize">
                    <option value="">@D["da_all"]</option>
                    <option value="A3">A3</option>
                    <option value="A4">A4</option>
                    <option value="A5">A5</option>
                </select>
            </label>
            <div class="form-grid da-grid">
                @if (EditType == "min_resolution")
                {
                    <label class="form-field"><span>@D["da_minpx"]</span><input type="number" dir="ltr" min="100" @bind="EditMinPx" /></label>
                }
                else if (EditType == "text_in_bounds")
                {
                    <label class="form-field"><span>@D["da_margin"]</span><input type="number" step="0.5" dir="ltr" min="0" @bind="EditMargin" /></label>
                }
                else
                {
                    <label class="form-field"><span>@D["da_delta"]</span><input type="number" step="0.05" dir="ltr" min="0" max="1" @bind="EditDelta" /></label>
                }
            </div>
            <label class="form-check"><input type="checkbox" @bind="EditActive" /><span>@D["da_active"]</span></label>
        </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseDialog" disabled="@Saving">@D["da_cancel"]</button>
            <button type="button" class="btn btn-primary" disabled="@Saving" @onclick="SaveAsync">@D["da_save"]</button>
        </Footer>
    </BarangModal>
}

@* پاپ‌آپ تأیید حذف *@
@if (Deleting is not null)
{
    <BarangModal Open Size="small" Title="@D["da_delete_title"]" Description="@D["da_confirm_del"]" CloseRequested="CloseDelete">
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseDelete" disabled="@Saving">@D["da_cancel"]</button>
            <button type="button" class="btn btn-primary" style="background:#8a453b;border-color:#8a453b" disabled="@Saving" @onclick="DeleteAsync">@L["Delete"]</button>
        </Footer>
    </BarangModal>
}

@code {
    [Inject] IStringLocalizer<AppStrings> L { get; set; } = default!;
    [Inject] Microsoft.JSInterop.IJSRuntime Js { get; set; } = default!;

    private bool Denied, Loading = true;
    private string? ProblemText, Toast;
    private bool ToastOk;
    private IReadOnlyList<RuleRow> Rules = [];
    private RuleRow? Viewing, Editing, Deleting;
    private bool IsNew, Saving;

    private string EditCode = "", EditType = "min_resolution", EditTitleFa = "", EditTitleEn = "", EditTitleAr = "", EditTitleEs = "", EditPrintSize = "";
    private int EditMinPx = 800; private double EditMargin = 5, EditDelta = 0.3;
    private bool EditActive = true; private long EditVersion;

    private string Culture => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant() is var c && c is "en" or "ar" or "es" ? c : "fa";
    private string CultureTitle => Culture switch { "en" => "Title (English)", "ar" => "العنوان", "es" => "Título", _ => "عنوان" };

    private sealed record RuleRow(Guid Id, string Code, string RuleType, string TitleFa, string TitleEn, string TitleAr, string TitleEs,
        string? PrintSizeCode, JsonElement Params, bool IsActive, long Version);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        bool system = auth.User.IsInRole("system.administrator");
        if (!(system || auth.User.HasClaim(AuthClaimTypes.Permission, "designaudit.manage")))
        {
            Denied = true; ProblemText = D["da_sub"].Value; Loading = false; return;
        }
        await LoadAsync();
    }

    private async Task<(string Token, Guid Company)?> Session()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        return Guid.TryParse(user.FindFirst(AuthClaimTypes.CompanyId)?.Value, out var c) && user.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t ? (t, c) : null;
    }

    private async Task LoadAsync()
    {
        Loading = true;
        var s2 = await Session();
        if (s2 is null || !s2.HasValue) { Loading = false; return; }
        ApiResult<JsonElement> res = await Core.GetAsync("api/v1/system/design-audit-rules", s2!.Value.Token, s2!.Value.Company, default);
        if (res.IsSuccess && res.Value.ValueKind == JsonValueKind.Array)
        {
            Rules = res.Value.EnumerateArray().Select(x => new RuleRow(
                x.TryGetProperty("id", out var i) && Guid.TryParse(i.GetString(), out var g) ? g : Guid.Empty,
                x.TryGetProperty("code", out var c) ? c.GetString() ?? "" : "",
                x.TryGetProperty("ruleType", out var t) ? t.GetString() ?? "" : "",
                x.TryGetProperty("titleFa", out var tf) ? tf.GetString() ?? "" : "",
                x.TryGetProperty("titleEn", out var te) ? te.GetString() ?? "" : "",
                x.TryGetProperty("titleAr", out var ta) ? ta.GetString() ?? "" : "",
                x.TryGetProperty("titleEs", out var ts) ? ts.GetString() ?? "" : "",
                x.TryGetProperty("printSizeCode", out var ps) && ps.ValueKind == JsonValueKind.String ? ps.GetString() : null,
                x.TryGetProperty("params", out var pp) && pp.ValueKind == JsonValueKind.Object ? pp.Clone() : JsonSerializer.SerializeToElement(new { }),
                x.TryGetProperty("isActive", out var ac) && ac.ValueKind == JsonValueKind.True,
                x.TryGetProperty("version", out var v) && v.TryGetInt64(out var vv) ? vv : 0)).ToList();
        }
        else if (!res.IsSuccess) { Denied = true; ProblemText = res.ProblemCode ?? D["da_error"]; }
        Loading = false;
    }

    private string Title(RuleRow r) => Culture switch
    {
        "en" => string.IsNullOrWhiteSpace(r.TitleEn) ? r.TitleFa : r.TitleEn,
        "ar" => string.IsNullOrWhiteSpace(r.TitleAr) ? r.TitleFa : r.TitleAr,
        "es" => string.IsNullOrWhiteSpace(r.TitleEs) ? r.TitleEn is { Length: > 0 } e ? e : r.TitleFa : r.TitleEs,
        _ => r.TitleFa
    };
    private string TypeLabel(string t) => t switch
    {
        "text_in_bounds" => D["da_type_text"],
        "contrast" => D["da_type_contrast"],
        _ => D["da_type_res"]
    };
    private string ParamsText(RuleRow r)
    {
        if (r.RuleType == "min_resolution" && r.Params.TryGetProperty("minPx", out var px)) return D["da_minpx"] + "=" + px.GetRawText();
        if (r.RuleType == "text_in_bounds" && r.Params.TryGetProperty("safeMarginMm", out var mm)) return D["da_margin"] + "=" + mm.GetRawText();
        if (r.RuleType == "contrast" && r.Params.TryGetProperty("minDelta", out var d)) return D["da_delta"] + "=" + d.GetRawText();
        return "{}";
    }

    private void OpenView(RuleRow r) { Viewing = r; Toast = null; }
    private void OpenNew()
    {
        IsNew = true; Editing = new(Guid.Empty, "", "min_resolution", "", "", "", "", null, JsonSerializer.SerializeToElement(new { }), true, 0);
        EditCode = ""; EditType = "min_resolution"; EditTitleFa = EditTitleEn = EditTitleAr = EditTitleEs = ""; EditPrintSize = "";
        EditMinPx = 800; EditMargin = 5; EditDelta = 0.3; EditActive = true; EditVersion = 0;
        Toast = null;
    }
    private void OpenEdit(RuleRow r)
    {
        IsNew = false; Editing = r;
        EditCode = r.Code; EditType = r.RuleType; EditTitleFa = r.TitleFa; EditTitleEn = r.TitleEn; EditTitleAr = r.TitleAr; EditTitleEs = r.TitleEs;
        EditPrintSize = r.PrintSizeCode ?? ""; EditActive = r.IsActive; EditVersion = r.Version;
        EditMinPx = r.Params.TryGetProperty("minPx", out var px) && px.TryGetInt32(out var pxi) ? pxi : 800;
        EditMargin = r.Params.TryGetProperty("safeMarginMm", out var mm) ? mm.GetDouble() : 5;
        EditDelta = r.Params.TryGetProperty("minDelta", out var d) ? d.GetDouble() : 0.3;
        Toast = null;
    }
    private void AskDelete(RuleRow r) { Deleting = r; Toast = null; }
    private void CloseDialog() { Editing = null; Viewing = null; }
    private void CloseDelete() { Deleting = null; }

    private string ParamsJson() => EditType switch
    {
        "min_resolution" => JsonSerializer.Serialize(new { minPx = EditMinPx }),
        "text_in_bounds" => JsonSerializer.Serialize(new { safeMarginMm = EditMargin }),
        _ => JsonSerializer.Serialize(new { minDelta = EditDelta })
    };

    private async Task SaveAsync()
    {
        if (Editing is null) return;
        if (IsNew && string.IsNullOrWhiteSpace(EditCode)) { ToastOk = false; Toast = D["da_error"]; return; }
        if (string.IsNullOrWhiteSpace(EditTitleFa)) { ToastOk = false; Toast = D["da_error"]; return; }
        Saving = true; Toast = null;
        object body = IsNew
            ? new { code = EditCode.Trim(), ruleType = EditType, titleFa = EditTitleFa.Trim(), titleEn = EditTitleEn.Trim(), titleAr = EditTitleAr.Trim(), titleEs = EditTitleEs.Trim(), @params = JsonSerializer.Deserialize<JsonElement>(ParamsJson()), printSizeCode = string.IsNullOrWhiteSpace(EditPrintSize) ? null : EditPrintSize, isActive = EditActive }
            : new { ruleType = EditType, titleFa = EditTitleFa.Trim(), titleEn = EditTitleEn.Trim(), titleAr = EditTitleAr.Trim(), titleEs = EditTitleEs.Trim(), @params = JsonSerializer.Deserialize<JsonElement>(ParamsJson()), printSizeCode = string.IsNullOrWhiteSpace(EditPrintSize) ? null : EditPrintSize, isActive = EditActive, version = EditVersion };
        var s2 = await Session();
        if (s2 is null || !s2.HasValue) { Saving = false; return; }
        ApiResult<JsonElement> res = IsNew
            ? await Core.SendAsync(HttpMethod.Post, "api/v1/system/design-audit-rules", body, s2!.Value.Token, s2!.Value.Company, default)
            : await Core.SendAsync(HttpMethod.Put, $"api/v1/system/design-audit-rules/{Editing.Id}", body, s2!.Value.Token, s2!.Value.Company, default);
        Saving = false;
        if (res.IsSuccess) { Editing = null; ToastOk = true; Toast = D["da_saved"]; await LoadAsync(); }
        else { ToastOk = false; Toast = D["da_error"]; }
    }

    private async Task DeleteAsync()
    {
        if (Deleting is null) return;
        Saving = true;
        var s2 = await Session();
        if (s2 is null || !s2.HasValue) { Saving = false; return; }
        ApiResult<JsonElement> res = await Core.SendAsync(HttpMethod.Delete, $"api/v1/system/design-audit-rules/{Deleting.Id}", null, s2!.Value.Token, s2!.Value.Company, default);
        Saving = false;
        if (res.IsSuccess || res.StatusCode == 204) { Deleting = null; ToastOk = true; Toast = D["da_deleted"]; await LoadAsync(); }
        else { ToastOk = false; Toast = D["da_error"]; }
    }
}
