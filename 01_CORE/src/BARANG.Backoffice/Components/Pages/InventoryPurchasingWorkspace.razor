@page "/workspace/inventory"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject IJSRuntime JS

<PageTitle>@T("موجودی و خرید","المخزون والمشتريات","Inventory & Purchasing")</PageTitle>
<nav class="breadcrumbs"><a href="/workspace/inventory">@T("موجودی و خرید","المخزون والمشتريات","Inventory & Purchasing")</a></nav>
<header class="page-heading"><div><h1>@T("موجودی و خرید","المخزون والمشتريات","Inventory & Purchasing")</h1><p>@T("مدیریت انبار، گردش موجودی و خرید","إدارة المستودعات وحركة المخزون والمشتريات","Warehouse, stock and purchasing operations")</p></div></header>
<section class="reference-workspace inventory-workspace">
    <aside class="reference-navigation" aria-label="@T("بخش‌های موجودی و خرید","أقسام المخزون والمشتريات","Inventory and purchasing sections")">
        <h2>@T("انواع عملیات","أنواع العمليات","Operations")</h2>
        <nav>
            @foreach (var item in Menu)
            { <a href="@($"/workspace/inventory?section={item.Key}")" class="@(Section==item.Key?"active":"")" aria-current="@(Section==item.Key?"page":null)" @onclick="()=>Select(item.Key)" @onclick:preventDefault>@item.Label(Lang)</a> }
        </nav>
    </aside>
    <main class="reference-content">
        @if (Section == "warehouses") { <WarehouseSection /> } else if (Section == "stock") { <InventorySection /> } else if (Section is "reservations" or "shortages") { <ReservationsShortagesSection InitialMode="@Section" /> } else if (Section == "returns") { <InventoryReturnSection /> } else if (Section == "transfers") { <WarehouseTransferSection /> } else if (Section == "adjustments") { <StockAdjustmentSection /> } else if (Section == "requests") { <PurchaseRequestSection /> } else if (Section == "orders") { <PurchaseOrderSection /> } else if (Section == "receipts") { <GoodsReceiptSection /> } else if (Section == "history") { <PurchaseHistorySection /> } else {
        <section class="crud-card">
            <header class="section-header"><div><h2>@CurrentLabel</h2><p>@CurrentDescription</p></div><button type="button" class="btn btn-primary" @onclick="OpenCreate">@T("افزودن","إضافة","Add")</button></header>
            <div class="crud-toolbar"><label class="crud-search"><span>@T("جستجو","بحث","Search")</span><input value="@Search" @oninput="SearchChanged" placeholder="@T("جستجوی سروری","بحث خادمي","Server search")" /></label><button type="button" class="btn btn-secondary" @onclick="ResetGrid">@T("بازنشانی","إعادة ضبط","Reset")</button></div>
            @if (Section is "warehouses" or "adjustments" or "transfers" or "shortages" or "orders" or "receipts")
            {<section class="inventory-operation-panel"><div class="form-grid">@if(Section=="warehouses"){<label><span>@T("کد انبار","رمز المستودع","Warehouse code")</span><input @bind="Code" /></label><label><span>@T("نام انبار","اسم المستودع","Warehouse name")</span><input @bind="Name" /></label><label><span>@T("نوع انبار","نوع المستودع","Warehouse type")</span><input @bind="WarehouseType" /></label>}else{<label><span>@T("انبار","المستودع","Warehouse")</span><input @bind="Warehouse" /></label><label><span>@T("SKU","SKU","SKU")</span><input @bind="Variant" /></label><label><span>@T("مقدار","الكمية","Quantity")</span><input type="number" @bind="Quantity" /></label><label><span>@T("مرجع","المرجع","Reference")</span><input @bind="Reference" /></label><label><span>@T("دلیل","السبب","Reason")</span><input @bind="Reason" /></label>@if(Section=="transfers"){<label><span>@T("انبار مقصد","المستودع الوجهة","Destination warehouse")</span><input @bind="Destination" /></label>}@if(Section is "orders" or "receipts"){<label><span>@T("تأمین‌کننده","المورد","Supplier")</span><input @bind="Supplier" /></label><label><span>@T("هزینه خرید","تكلفة الشراء","Purchase cost")</span><input type="number" @bind="UnitPrice" /></label>}}</div><div class="form-actions">@if(Section=="warehouses"){<button type="button" class="btn btn-primary" @onclick="SaveWarehouse">@T("ذخیره انبار","حفظ المستودع","Save warehouse")</button>}@if(Section=="adjustments"){<button type="button" class="btn btn-primary" @onclick="(()=>PostAdjustment(true))">@T("افزایش موجودی","زيادة المخزون","Positive adjustment")</button><button type="button" class="btn btn-secondary" @onclick="(()=>PostAdjustment(false))">@T("کاهش موجودی","خفض المخزون","Negative adjustment")</button>}@if(Section=="transfers"){<button type="button" class="btn btn-primary" @onclick="StartTransfer">@T("شروع انتقال","بدء التحويل","Start transfer")</button><button type="button" class="btn btn-secondary" @onclick="CompleteTransfer">@T("تکمیل انتقال","إكمال التحويل","Complete transfer")</button>}@if(Section=="shortages"){<button type="button" class="btn btn-primary" @onclick="Reserve">@T("رزرو موجودی","حجز المخزون","Reserve stock")</button><button type="button" class="btn btn-secondary" @onclick="ReleaseReservation">@T("آزادسازی رزرو","تحرير الحجز","Release reservation")</button><button type="button" class="btn btn-secondary" @onclick="ConsumeReservation">@T("مصرف رزرو","استهلاک الحجز","Consume reservation")</button>}@if(Section=="orders"){<button type="button" class="btn btn-primary" @onclick="CreateOrder">@T("ایجاد سفارش خرید","إنشاء أمر شراء","Create purchase order")</button><button type="button" class="btn btn-secondary" @onclick="SubmitOrder">@T("ارسال برای پردازش","إرسال للمعالجة","Submit order")</button><button type="button" class="btn btn-secondary" @onclick="CloseOrder">@T("بستن سفارش","إغلاق الأمر","Close order")</button>}@if(Section=="receipts"){<button type="button" class="btn btn-primary" @onclick="ReceiveOrder">@T("ثبت رسید","تسجيل الاستلام","Post receipt")</button>}</div></section>}
            @if(Section=="orders"){<div class="inventory-line-editor"><h3>@T("ردیف‌های سفارش خرید","بنود أمر الشراء","Purchase order lines")</h3><div class="form-grid"><label><span>@T("شناسه SKU","معرف SKU","SKU")</span><input @bind="Variant" /></label><label><span>@T("مقدار","الكمية","Quantity")</span><input type="number" @bind="Quantity" /></label><label><span>@T("هزینه خرید","تكلفة الشراء","Purchase cost")</span><input type="number" @bind="UnitPrice" /></label><button type="button" class="btn btn-secondary" @onclick="AddOrderLine">@T("افزودن ردیف","إضافة سطر","Add line")</button></div>@if(OrderLines.Count>0){<table class="data-grid"><thead><tr><th>SKU</th><th>@T("مقدار","الكمية","Quantity")</th><th>@T("هزینه","التكلفة","Cost")</th><th>@T("عملیات","الإجراءات","Actions")</th></tr></thead><tbody>@for(var i=0;i<OrderLines.Count;i++){var line=OrderLines[i];<tr><td>@line.Variant</td><td>@line.Quantity</td><td>@line.UnitPrice</td><td><button type="button" class="icon-button" @onclick="(()=>RemoveOrderLine(i))" title="@T("حذف","حذف","Remove")">×</button></td></tr>}</tbody></table>}</div>}
            @if(Section=="receipts"){<section class="inventory-receipt-editor"><h3>@T("ویرایشگر رسید کالا","محرر إيصال الاستلام","Goods receipt editor")</h3><div class="form-grid"><label><span>@T("شناسه سفارش خرید","معرف أمر الشراء","Purchase order id")</span><input @bind="PurchaseId" /></label><button type="button" class="btn btn-secondary" @onclick="LoadPurchaseOrder">@T("بارگذاری سفارش","تحميل الأمر","Load order")</button><label><span>@T("شناسه ردیف سفارش","معرف بند الأمر","PO line id")</span><input @bind="Entity" /></label><label><span>@T("مقدار رسید","كمية الاستلام","Receipt quantity")</span><input type="number" @bind="Quantity" /></label></div>@if(ReceiptLines.Count>0){<table class="data-grid"><thead><tr><th>SKU</th><th>@T("سفارش‌شده","المطلوب","Ordered")</th><th>@T("دریافت‌شده","المستلم","Received")</th><th>@T("باقی‌مانده","المتبقي","Remaining")</th></tr></thead><tbody>@foreach(var line in ReceiptLines){<tr><td>@line.Variant</td><td>@line.Ordered</td><td>@line.Received</td><td>@(line.Ordered-line.Received)</td></tr>}</tbody></table>}</section>}
            @if (Loading) { <div class="crud-loading">@T("در حال بارگذاری","جار التحميل","Loading")</div> }
            else if (Error is not null) { <div class="inline-error">@T(Error.Value.Fa,Error.Value.Ar,Error.Value.En)</div> }
            else if (Rows.Count == 0) { <div class="crud-empty">@T("رکوردی وجود ندارد.","لا توجد سجلات.","No records found.")</div> }
            else { <div class="data-grid-wrap"><table class="data-grid"><thead><tr>@foreach(var column in Columns){<th>@DisplayColumn(column)</th>}<th>@T("عملیات","الإجراءات","Actions")</th></tr></thead><tbody>@foreach(var row in Rows){<tr>@foreach(var column in Columns){<td>@DisplayCell(row,column)</td>}<td class="row-actions"><button type="button" class="icon-button" title="@T("مشاهده","عرض","View")" @onclick="()=>View(row)">◉</button><button type="button" class="icon-button" title="@T("ویرایش","تحرير","Edit")" @onclick="()=>Edit(row)">✎</button><button type="button" class="icon-button" title="@T("تاریخچه","السجل","History")" @onclick="()=>History(row)">↺</button></td></tr>}</tbody></table></div><BarangPagination Page="Page" HasNext="@(Rows.Count==PageSize)" Disabled="Loading" PageLabel="" PreviousText="@T("قبلی","السابق","Previous")" NextText="@T("بعدی","التالي","Next")" Previous="@Previous" Next="@Next" /> }
        </section>
        @if (Dialog) { <div class="dialog-backdrop" @onclick="Close"><section class="crud-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation><header><h2>@(ReadOnly?T("مشاهده","عرض","View"):T("عملیات موجودی و خرید","عملية المخزون والمشتريات","Inventory & Purchasing operation"))</h2><button class="dialog-close" type="button" @onclick="Close">×</button></header><div class="form-grid">@if(Section=="warehouses"){<label><span>@T("کد انبار","رمز المستودع","Warehouse code")</span><input @bind="Code" readonly="@ReadOnly" /></label><label><span>@T("نام انبار","اسم المستودع","Warehouse name")</span><input @bind="Name" readonly="@ReadOnly" /></label><label><span>@T("نوع انبار","نوع المستودع","Warehouse type")</span><input @bind="WarehouseType" readonly="@ReadOnly" /></label>}else{<label><span>@T("انبار","المستودع","Warehouse")</span><input @bind="Warehouse" /></label><label><span>@T("شناسه SKU","معرف SKU","SKU identifier")</span><input @bind="Variant" /></label><label><span>@T("مقدار","الكمية","Quantity")</span><input type="number" @bind="Quantity" /></label><label><span>@T("مرجع","المرجع","Reference")</span><input @bind="Reference" /></label><label><span>@T("دلیل","السبب","Reason")</span><input @bind="Reason" /></label>}</div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@Message</div>}<footer><button class="btn btn-secondary" type="button" @onclick="Close">@T("انصراف","إلغاء","Cancel")</button>@if(!ReadOnly){<button class="btn btn-primary" type="button" @onclick="Save">@T("ذخیره","حفظ","Save")</button>}</footer></section></div> }
        }
    </main>
</section>

@code {
    [SupplyParameterFromQuery(Name = "section")] public string? WorkspaceSection { get; set; }
    private sealed record MenuItem(string Key, string Fa, string Ar, string En) { public string Label(string lang)=>lang switch { "fa"=>Fa,"ar"=>Ar,_=>En}; }
    private static readonly MenuItem[] Menu=[new("warehouses","انبارها","المستودعات","Warehouses"),new("stock","موجودی","المخزون","Inventory / Stock"),new("reservations","رزرو موجودی","حجوزات المخزون","Inventory Reservations"),new("shortages","کمبود موجودی","نواقص المخزون","Stock Shortages"),new("returns","برگشت warehouse","إرجاع المستودع","Warehouse Returns"),new("transfers","انتقال بین انبارها","التحويلات","Transfers"),new("adjustments","اصلاح موجودی","التسويات","Adjustments"),new("requests","درخواست‌های خرید","طلبات الشراء","Purchase Requests"),new("orders","سفارش‌های خرید","أوامر الشراء","Purchase Orders"),new("receipts","رسید کالا","إيصالات الاستلام","Goods Receipts"),new("history","تاریخچه خرید","سجل المشتريات","Purchasing History")];
    private string Section="stock", Search="", Warehouse="", Variant="", Destination="", Entity="", Supplier="", PurchaseId="", Code="", Name="", WarehouseType="RawMaterials", Reference="INV-"+Guid.NewGuid().ToString("N")[..8], Reason=""; private decimal Quantity=1,UnitPrice; private long Version; private int Page=1; private const int PageSize=25; private bool Loading,Dialog,ReadOnly,Success; private string? Message; private (string Fa,string Ar,string En)? Error; private List<Dictionary<string,string>> Rows=[]; private string[] Columns=[]; private string Lang=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; private CancellationTokenSource? SearchCancellation; private readonly List<OrderLineDraft> OrderLines=[];
    private sealed record OrderLineDraft(string Variant,decimal Quantity,decimal UnitPrice); private sealed record ReceiptLine(string Variant,decimal Ordered,decimal Received); private readonly List<ReceiptLine> ReceiptLines=[];
    private MenuItem Current=>Menu.First(x=>x.Key==Section); private string CurrentLabel=>Current.Label(Lang); private string CurrentDescription=>Section switch{"stock"=>T("موجودی قابل دسترس و گردش کالا","الرصيد المتاح وحركة المخزون","Balances and stock movements"),"orders"=>T("چرخه سفارش خرید و دریافت","دورة أمر الشراء والاستلام","Purchase orders and receipts"),_=>T("عملیات کنترل‌شده و قابل ردیابی","عمليات مضبوطة وقابلة للتتبع","Controlled traceable operations")};
    protected override async Task OnInitializedAsync(){ApplyWorkspaceQuery();await Load();}
    protected override async Task OnParametersSetAsync(){if(ApplyWorkspaceQuery())await Load();}
    private bool ApplyWorkspaceQuery(){if(string.IsNullOrWhiteSpace(WorkspaceSection)||!Menu.Any(x=>x.Key==WorkspaceSection)||Section==WorkspaceSection)return false;ClearTransient();Section=WorkspaceSection;Page=1;OrderLines.Clear();ReceiptLines.Clear();Entity=PurchaseId="";return true;}
    private string T(string fa,string ar,string en)=>Lang switch{"fa"=>fa,"ar"=>ar,_=>en};
    private async Task Select(string key){if(Section==key)return;ClearTransient();Section=key;Page=1;OrderLines.Clear();ReceiptLines.Clear();Entity=PurchaseId="";await Load();}
    private void ClearTransient(){Message=null;Error=null;Success=false;}
    private async Task Load(){
        if(Section is "warehouses" or "stock" or "shortages" or "transfers" or "adjustments") { Loading=false; return; }
        Loading=true;Error=null;Rows=[];StateHasChanged();var s=await Session();if(s is null){Loading=false;return;}string page=$"pageNumber={Page}&pageSize={PageSize}";string path=Section switch{"orders"=>$"api/v1/purchasing/orders?search={Uri.EscapeDataString(Search)}&{page}","warehouses"=>"api/v1/organization/warehouses",_=>$"api/v1/inventory/transactions?{page}"};var r=await Core.GetAsync(path,s.Value.Token,s.Value.Company,default);if(r.IsSuccess)Parse(r.Value);else Error=("دریافت اطلاعات انجام نشد.","تعذر تحميل البيانات.","Unable to load data.");Loading=false;}
    private void Parse(System.Text.Json.JsonElement root){if(root.ValueKind==System.Text.Json.JsonValueKind.Object&&root.TryGetProperty("items",out var items))root=items;Rows=[];if(root.ValueKind==System.Text.Json.JsonValueKind.Array){foreach(var x in root.EnumerateArray())if(x.ValueKind==System.Text.Json.JsonValueKind.Object)Rows.Add(x.EnumerateObject().Where(p=>p.Value.ValueKind is not(System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array)).ToDictionary(p=>p.Name,p=>p.Value.ToString()));}Columns=Rows.SelectMany(x=>x.Keys).Distinct().Where(x=>!x.Equals("id",StringComparison.OrdinalIgnoreCase)&&!x.Equals("version",StringComparison.OrdinalIgnoreCase)).Take(8).ToArray();}
    private string Cell(Dictionary<string,string> row,string key)=>row.TryGetValue(key,out var value)?value:"—";
    private string DisplayColumn(string key)=>key.ToLowerInvariant() switch {"warehouseid"=>T("انبار","المستودع","Warehouse"),"productvariantid"=>T("محصول/SKU","المنتج/SKU","Product/SKU"),"onhand"=>T("موجودی","المخزون","On hand"),"reserved"=>T("رزرو شده","محجوز","Reserved"),"available"=>T("قابل دسترس","المتاح","Available"),"quantitydelta"=>T("تغییر مقدار","تغير الكمية","Quantity change"),"transactiontype"=>T("نوع گردش","نوع الحركة","Movement type"),"reference"=>T("مرجع","المرجع","Reference"),"purchaseordernumber"=>T("شماره سفارش خرید","رقم أمر الشراء","PO number"),"supplierid"=>T("تأمین‌کننده","المورد","Supplier"),"status"=>T("وضعیت","الحالة","Status"),"isactive"=>T("فعال","نشط","Active"),"version"=>T("نسخه","الإصدار","Version"),_=>key};
    private string DisplayCell(Dictionary<string,string> row,string key){var value=Cell(row,key);if(key.Equals("isActive",StringComparison.OrdinalIgnoreCase))return bool.TryParse(value,out var active)?(active?T("فعال","نشط","Active"):T("غیرفعال","غير نشط","Inactive")):value;if(key.Equals("status",StringComparison.OrdinalIgnoreCase)||key.Equals("transactionType",StringComparison.OrdinalIgnoreCase))return value switch {"InTransit"=>T("در حال انتقال","قيد التحويل","In transit"),"Completed"=>T("تکمیل‌شده","مكتمل","Completed"),"Receipt"=>T("رسید","استلام","Receipt"),"Adjustment"=>T("اصلاح","تسوية","Adjustment"),_=>value};return value;}
    private async Task SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";Page=1;SearchCancellation?.Cancel();SearchCancellation?.Dispose();SearchCancellation=new();try{await Task.Delay(250,SearchCancellation.Token);await Load();}catch(OperationCanceledException){}}
    private Task Reload()=>Load(); private Task ResetGrid(){Search="";Warehouse=Variant="";Page=1;ClearTransient();return Load();} private async Task Previous(){if(Page>1){Page--;await Load();}} private async Task Next(){if(Rows.Count==PageSize){Page++;await Load();}}
    private void OpenCreate(){Dialog=true;ReadOnly=false;Message=null;Code="";Name="";WarehouseType="RawMaterials";} private void View(Dictionary<string,string> row){ReadOnly=true;Dialog=true;Message=null;BindRow(row);} private void Edit(Dictionary<string,string> row){ReadOnly=false;Dialog=true;Message=null;BindRow(row);} private void BindRow(Dictionary<string,string> row){Entity=Value(row,"id");Version=Long(row,"version");Warehouse=Entity;Code=Value(row,"code");Name=Value(row,"name");WarehouseType=Value(row,"type");} private void History(Dictionary<string,string> row){Message=T("تاریخچه در مسیر عملیاتی اصلی قابل مشاهده است.","السجل متاح من مسار العملية.","History is available from the originating operation.");} private void Close(){Dialog=false;}
    private async Task Save(){if(Section=="stock"){await Post("api/v1/inventory/receipts",new{warehouseId=GuidOrEmpty(Warehouse),productVariantId=GuidOrEmpty(Variant),quantity=Quantity,reference=Reference,reasonCode=Reason});}else if(Section=="adjustments"){await Post("api/v1/inventory/adjustments/true",new{warehouseId=GuidOrEmpty(Warehouse),productVariantId=GuidOrEmpty(Variant),quantity=Quantity,reference=Reference,reasonCode=Reason});}else if(Section=="warehouses"){await SaveWarehouse();}else{Message=T("این عملیات از مسیر تخصصی خود اجرا می‌شود.","يتم تنفيذ هذه العملية من مسارها المتخصص.","This operation is executed from its specialized workflow.");}}
    private async Task SaveWarehouse(){var s=await Session();if(s is null)return;var type=WarehouseType switch{"WorkInProcess"=>1,"FinishedGoods"=>2,"Shipping"=>3,"Returns"=>4,"Scrap"=>5,_=>0};var editing=Guid.TryParse(Entity,out var id);var route=editing?$"api/v1/organization/warehouses/{id}":"api/v1/organization/warehouses";var method=editing?HttpMethod.Put:HttpMethod.Post;object body=editing?new{name=Name,type,branchId=(Guid?)null,version=Version}:new{code=Code,name=Name,type,branchId=(Guid?)null};var r=await Core.SendAsync(method,route,body,s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("انبار ذخیره شد.","تم حفظ المستودع.","Warehouse saved."):T("ذخیره انبار انجام نشد.","تعذر حفظ المستودع.","Warehouse could not be saved.");if(r.IsSuccess){Dialog=false;await Load();}}
    private async Task ToggleWarehouse(Dictionary<string,string> row){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Put,$"api/v1/organization/warehouses/{GuidOrEmpty(Value(row,"id"))}/activation",new{isActive=!IsActive(row),version=Long(row,"version")},s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("وضعیت انبار تغییر کرد.","تم تغيير حالة المستودع.","Warehouse status changed."):T("تغییر وضعیت ممکن نیست.","تعذر تغيير الحالة.","Status change failed.");if(r.IsSuccess)await Load();}
    private void ProtectedDelete(Dictionary<string,string> row){Success=false;Message=T("حذف مستقیم انبار مجاز نیست؛ برای حفظ سوابق از غیرفعال‌سازی استفاده کنید.","لا يسمح بحذف المستودع مباشرة؛ استخدم التعطيل لحفظ السجل.","Direct warehouse deletion is protected; deactivate it to preserve history.");}
    private Task PostAdjustment(bool increase)=>Post($"api/v1/inventory/adjustments/{increase.ToString().ToLowerInvariant()}",new{warehouseId=GuidOrEmpty(Warehouse),productVariantId=GuidOrEmpty(Variant),quantity=Quantity,reference=Reference,reasonCode=Reason});
    private Task StartTransfer()=>Post("api/v1/inventory/transfers",new{sourceWarehouseId=GuidOrEmpty(Warehouse),destinationWarehouseId=GuidOrEmpty(Destination),productVariantId=GuidOrEmpty(Variant),quantity=Quantity,reference=Reference});
    private Task CompleteTransfer()=>Post($"api/v1/inventory/transfers/{GuidOrEmpty(Entity)}/complete",new{version=Version});
    private Task Reserve()=>Post("api/v1/inventory/reservations",new{orderItemId=GuidOrEmpty(Entity),warehouseId=GuidOrEmpty(Warehouse),quantity=Quantity,expiresAtUtc=(DateTimeOffset?)null,idempotencyKey=Reference});
    private Task ReleaseReservation()=>Post($"api/v1/inventory/reservations/{GuidOrEmpty(Entity)}/release",new{quantity=Quantity,version=Version});
    private Task ConsumeReservation()=>Post($"api/v1/inventory/reservations/{GuidOrEmpty(Entity)}/issue",new{quantity=Quantity,version=Version,reference=Reference});
    private void AddOrderLine(){if(Guid.TryParse(Variant,out _)&&Quantity>0)OrderLines.Add(new(Variant,Quantity,UnitPrice));}
    private void RemoveOrderLine(int index){if(index>=0&&index<OrderLines.Count)OrderLines.RemoveAt(index);}
    private async Task LoadPurchaseOrder(){var s=await Session();if(s is null||!Guid.TryParse(PurchaseId,out var id))return;var r=await Core.GetAsync($"api/v1/purchasing/orders/{id}",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Message=T("سفارش خرید یافت نشد.","لم يتم العثور على أمر الشراء.","Purchase order was not found.");Success=false;return;}ReceiptLines.Clear();if(r.Value.TryGetProperty("items",out var items)&&items.ValueKind==System.Text.Json.JsonValueKind.Array)foreach(var item in items.EnumerateArray()){var itemId=item.GetProperty("id").ToString();if(string.IsNullOrWhiteSpace(Entity))Entity=itemId;ReceiptLines.Add(new ReceiptLine(item.GetProperty("productVariantId").ToString(),item.GetProperty("orderedQuantity").GetDecimal(),item.GetProperty("receivedQuantity").GetDecimal()));}Message=T("اطلاعات سفارش بارگذاری شد.","تم تحميل بيانات الأمر.","Purchase order loaded.");Success=true;}
    private Task CreateOrder()=>Post("api/v1/purchasing/orders",new{supplierId=GuidOrEmpty(Supplier),warehouseId=GuidOrEmpty(Warehouse),currencyCode="IRR",expectedDeliveryDate=(string?)null,items=(OrderLines.Count==0?new[]{new OrderLineDraft(Variant,Quantity,UnitPrice)}:OrderLines.ToArray()).Select(x=>new{productVariantId=GuidOrEmpty(x.Variant),quantity=x.Quantity,unitPurchasePrice=x.UnitPrice}).ToArray()});
    private Task SubmitOrder()=>Post($"api/v1/purchasing/orders/{GuidOrEmpty(PurchaseId)}/submit?version={Version}",null!);
    private Task CloseOrder()=>Post($"api/v1/purchasing/orders/{GuidOrEmpty(PurchaseId)}/close",new{cancel=false,reason=Reason,version=Version});
    private Task ReceiveOrder()=>Post($"api/v1/purchasing/orders/{GuidOrEmpty(PurchaseId)}/receipts",new{purchaseOrderItemId=GuidOrEmpty(Entity),quantity=Quantity,reference=Reference});
    private async Task Post(string path,object body){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,path,body,s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("عملیات با موفقیت انجام شد.","تم تنفيذ العملية بنجاح.","Operation completed successfully."):T("عملیات انجام نشد.","تعذر تنفيذ العملية.","Operation failed.");if(r.IsSuccess){var entity=r.Value;if(entity.ValueKind==System.Text.Json.JsonValueKind.Object&&entity.TryGetProperty("reservation",out var reservation))entity=reservation;if(entity.ValueKind==System.Text.Json.JsonValueKind.Object){if(entity.TryGetProperty("id",out var id))Entity=id.ToString();if(entity.TryGetProperty("purchaseOrderId",out var po))PurchaseId=po.ToString();if(entity.TryGetProperty("version",out var v)&&v.TryGetInt64(out var version))Version=version;}Dialog=false;await Load();}}
    private static Guid GuidOrEmpty(string value)=>Guid.TryParse(value,out var id)?id:Guid.Empty;
    private static string Value(Dictionary<string,string> row,string key)=>row.TryGetValue(key,out var value)?value:"";
    private static long Long(Dictionary<string,string> row,string key)=>long.TryParse(Value(row,key),out var value)?value:0;
    private static bool IsActive(Dictionary<string,string> row)=>bool.TryParse(Value(row,"isActive"),out var value)&&value;
    private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string token?(token,c):null;}
}
