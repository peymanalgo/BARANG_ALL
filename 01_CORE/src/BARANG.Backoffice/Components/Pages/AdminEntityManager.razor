@page "/admin/{Kind}"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<CrudStrings> T
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@Title · BARANG</PageTitle><nav class="breadcrumbs"><span>@L["Module_foundation"]</span><span>/</span><span>@Title</span></nav>
<header class="crud-header"><div><h1>@Title</h1><p>@L["AuthoritativeCoreData"]</p></div><button type="button" class="btn btn-primary" @onclick="New"><BarangIcon Name="plus" /> @T["Add"]</button></header>
<section class="crud-card"><div class="crud-toolbar"><label class="search-box"><BarangIcon Name="search" /><input placeholder="@T["SearchHint"]" @bind="Search" @bind:event="oninput" /></label><button type="button" class="btn btn-secondary" @onclick="Load"><BarangIcon Name="reset" /> @T["Reset"]</button></div>
@if(Loading){<BarangLoadingState Text="@T["Loading"]" />}else if(!Filtered.Any()){<CrudEmptyState Title="@T["NoRecords"]" Description="@T["NoRecordsHelp"]"/>}else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th><BarangSortHeader Label="@T["Code"]" Active="@(SortColumn=="code")" Descending="@(!SortAscending)" Clicked='()=>SortBy("code")' /></th><th><BarangSortHeader Label="@T["Name"]" Active="@(SortColumn=="name")" Descending="@(!SortAscending)" Clicked='()=>SortBy("name")' /></th>@if(Kind!="settings"){<th>@L["Branch"]</th>}<th><BarangSortHeader Label="@T["Status"]" Active="@(SortColumn=="status")" Descending="@(!SortAscending)" Clicked='()=>SortBy("status")' /></th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(var x in Paged){<tr><td><span class="code-pill">@x.Code</span></td><td>@x.Name</td>@if(Kind!="settings"){<td>@BranchName(x.BranchId)</td>}<td><StatusBadge Active="x.Active" /></td><td><BarangActionMenu><BarangIconButton Icon="eye" Label="@T["View"]" Semantic="info" Clicked="()=>Open(x,false)" /><BarangIconButton Icon="edit" Label="@T["Edit"]" Semantic="edit" Clicked="()=>Open(x,true)" /><BarangIconButton Icon="power" Label="@(x.Active?T["Deactivate"]:T["Activate"])" Semantic="@(x.Active?"warning":"success")" Disabled="@Busy" Clicked="()=>Toggle(x)" /></BarangActionMenu></td></tr>}</tbody></table></div><div class="grid-pagination"><button type="button" class="btn btn-secondary btn-small" disabled="@(Page==1)" @onclick="PreviousPage">@T["Previous"]</button><span>@T["PageOf",Page,PageCount]</span><button type="button" class="btn btn-secondary btn-small" disabled="@(Page==PageCount)" @onclick="NextPage">@T["Next"]</button></div>}</section>
@if(Dialog){<div class="dialog-backdrop" @onclick="Close"><section class="crud-dialog" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation><header><h2>@Title</h2><button type="button" class="dialog-close" title="@T["Close"]" aria-label="@T["Close"]" @onclick="Close"><BarangIcon Name="close" /></button></header><div class="form-grid"><label><span>@T["Code"]</span><input @bind="Code" maxlength="64" disabled="@(Id is not null||!Editable)" /></label><label><span>@T["Name"]</span><input @bind="Name" maxlength="2000" disabled="@(!Editable)" /></label>@if(Kind=="settings"){<label><span>@L["ValueType"]</span><SearchableSelect Options="@ValueTypeOptions" Value="@EnumValue.ToString()" ValueChanged="SetEnum" Disabled="@(!Editable)" Placeholder="@T["SearchOptions"]" /></label>}@if(Kind is "units" or "warehouses"){<label><span>@L["Branch"]</span><SearchableSelect Options="@BranchOptions" @bind-Value="BranchId" Disabled="@(!Editable)" Placeholder="@T["SearchOptions"]" /></label>}@if(Kind=="units"){<label><span>@L["Parent"]</span><SearchableSelect Options="@ParentOptions" @bind-Value="ParentId" Disabled="@(!Editable)" Placeholder="@T["SearchOptions"]" /></label>}@if(Kind=="warehouses"){<label><span>@L["Classification"]</span><SearchableSelect Options="@WarehouseTypeOptions" Value="@EnumValue.ToString()" ValueChanged="SetEnum" Disabled="@(!Editable)" Placeholder="@T["SearchOptions"]" /></label>}</div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<footer><button type="button" class="btn btn-secondary" disabled="@Busy" @onclick="Close">@T["Cancel"]</button>@if(Editable){<button type="button" class="btn btn-primary" disabled="@Busy" @onclick="Save">@(Busy?T["Saving"]:T["Save"])</button>}</footer></section></div>}
@code{
[Parameter]public string Kind{get;set;}="settings";private Guid?Id;private long Version;private int EnumValue,Page=1;private const int PageSize=10;private bool Active=true,Success,Dialog,Editable,Loading,Busy,SortAscending=true;private string Code="",Name="",BranchId="",ParentId="",Search="",SortColumn="code";private string?Message;private List<Row>Rows=[];private List<Option>Branches=[],UnitOptions=[];private string Title=>L[$"Admin_{Kind}"];private IEnumerable<Row>Filtered=>ApplySort(Rows.Where(x=>Search.Length==0||(x.Code+x.Name+BranchName(x.BranchId)).Contains(Search,StringComparison.CurrentCultureIgnoreCase)));private IEnumerable<Row>Paged=>Filtered.Skip((Page-1)*PageSize).Take(PageSize);private int PageCount=>Math.Max(1,(int)Math.Ceiling(Filtered.Count()/(double)PageSize));private string Base()=>Kind switch{"settings"=>"api/v1/organization/settings","units"=>"api/v1/organization/organizational-units",_=>"api/v1/organization/warehouses"};
private IReadOnlyList<SearchableSelectOption>BranchOptions=>[new("",L["Choose"]),..Branches.Select(x=>new SearchableSelectOption(x.Id.ToString(),x.Name))];private IReadOnlyList<SearchableSelectOption>ParentOptions=>[new("",L["Choose"]),..UnitOptions.Where(x=>x.Id!=Id).Select(x=>new SearchableSelectOption(x.Id.ToString(),x.Name))];private IReadOnlyList<SearchableSelectOption>ValueTypeOptions=>Enumerable.Range(0,4).Select(x=>new SearchableSelectOption(x.ToString(),ValueTypeName(x))).ToArray();private IReadOnlyList<SearchableSelectOption>WarehouseTypeOptions=>Enumerable.Range(0,6).Select(x=>new SearchableSelectOption(x.ToString(),WarehouseTypeName(x))).ToArray();
protected override async Task OnParametersSetAsync(){await LoadOptions();await Load();}private void New(){Id=null;Version=EnumValue=0;Active=true;Code=Name=BranchId=ParentId="";Message=null;Editable=Dialog=true;}private void Open(Row x,bool edit){Id=x.Id;Version=x.Version;Active=x.Active;Code=x.Code;Name=x.Name;EnumValue=x.EnumValue;BranchId=x.BranchId;ParentId=x.ParentId;Message=null;Editable=edit;Dialog=true;}private void Close()=>Dialog=false;
private async Task LoadOptions(){var s=await Session();if(s is null)return;var b=await Core.GetAsync("api/v1/organization/branches",s.Value.Token,s.Value.Company,default);if(b.IsSuccess)Branches=b.Value.EnumerateArray().Where(x=>B(x,"isActive",true)).Select(x=>new Option(x.GetProperty("id").GetGuid(),G(x,"displayName"))).ToList();var u=await Core.GetAsync("api/v1/organization/organizational-units",s.Value.Token,s.Value.Company,default);if(u.IsSuccess)UnitOptions=u.Value.EnumerateArray().Where(x=>B(x,"isActive",true)).Select(x=>new Option(x.GetProperty("id").GetGuid(),G(x,"displayName"))).ToList();}
private async Task Load(){Loading=true;Rows=[];Page=1;var s=await Session();if(s is not null){var r=await Core.GetAsync(Base(),s.Value.Token,s.Value.Company,default);if(r.IsSuccess)foreach(var x in r.Value.EnumerateArray())Rows.Add(new(x.GetProperty("id").GetGuid(),G(x,Kind=="settings"?"key":"code"),G(x,Kind=="settings"?"value":Kind=="units"?"displayName":"name"),B(x,"isActive",true),N(x,"version"),I(x,Kind=="settings"?"valueType":"type"),G(x,"branchId"),G(x,"parentId")));else Show(r);}Loading=false;}
private async Task Save(){if(Busy)return;if(string.IsNullOrWhiteSpace(Code)||string.IsNullOrWhiteSpace(Name)){Success=false;Message="ValidationError";return;}Busy=true;try{var s=await Session();if(s is null)return;Guid?branch=Guid.TryParse(BranchId,out var b)?b:null,parent=Guid.TryParse(ParentId,out var p)?p:null;object body=Kind switch{"settings"=>Id is null?new{key=Code,value=Name,valueType=EnumValue}:new{value=Name,valueType=EnumValue,version=Version},"units"=>Id is null?new{code=Code,displayName=Name,branchId=branch,parentId=parent}:new{displayName=Name,branchId=branch,parentId=parent,version=Version},_=>Id is null?new{code=Code,name=Name,type=EnumValue,branchId=branch}:new{name=Name,type=EnumValue,branchId=branch,version=Version}};var r=await Core.SendAsync(Id is null?HttpMethod.Post:HttpMethod.Put,Base()+(Id is Guid id?$"/{id}":""),body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){Dialog=false;await LoadOptions();await Load();}}finally{Busy=false;}}
private async Task Toggle(Row x){if(Busy)return;Busy=true;try{var s=await Session();if(s is null)return;var suffix=Kind=="settings"?"deactivation":"activation";object body=Kind=="settings"?new{version=x.Version}:new{isActive=!x.Active,version=x.Version};var r=await Core.SendAsync(HttpMethod.Put,$"{Base()}/{x.Id}/{suffix}",body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}finally{Busy=false;}}
private Task SetEnum(string value){if(int.TryParse(value,out var parsed))EnumValue=parsed;return Task.CompletedTask;}private void SortBy(string column){if(SortColumn==column)SortAscending=!SortAscending;else{SortColumn=column;SortAscending=true;}Page=1;}private IEnumerable<Row>ApplySort(IEnumerable<Row>rows){Func<Row,object>key=SortColumn switch{"name"=>x=>x.Name,"status"=>x=>x.Active,_=>x=>x.Code};return SortAscending?rows.OrderBy(key):rows.OrderByDescending(key);}private void PreviousPage()=>Page=Math.Max(1,Page-1);private void NextPage()=>Page=Math.Min(PageCount,Page+1);private string BranchName(string id)=>Guid.TryParse(id,out var x)?Branches.FirstOrDefault(b=>b.Id==x)?.Name??"—":"—";private string ValueTypeName(int x)=>x switch{0=>L["Text"],1=>L["Boolean"],2=>L["WholeNumber"],_=>L["DecimalNumber"]};private string WarehouseTypeName(int x)=>L[x switch{0=>"RawMaterials",1=>"WorkInProcess",2=>"FinishedGoods",3=>"Shipping",4=>"Returns",_=>"Scrap"}];private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private static bool B(System.Text.Json.JsonElement x,string n,bool d=false)=>x.TryGetProperty(n,out var p)&&p.ValueKind is System.Text.Json.JsonValueKind.True or System.Text.Json.JsonValueKind.False?p.GetBoolean():d;private static long N(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.GetInt64():0;private static int I(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.TryGetInt32(out var v)?v:0;private sealed record Row(Guid Id,string Code,string Name,bool Active,long Version,int EnumValue,string BranchId,string ParentId);private sealed record Option(Guid Id,string Name);}
