@page "/manage/products"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<CrudStrings> T
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject IJSRuntime JS
@inject ILocaleDateService Dates

<PageTitle>@T["Products"] · BARANG</PageTitle>
<nav class="breadcrumbs"><span>@L["Module_master-data"]</span><span>/</span><span>@T["Products"]</span></nav>
<header class="crud-header"><div><h1>@T["Products"]</h1><p>@T["Details"]</p></div><button type="button" class="btn btn-primary" @onclick="New">@T["AddProduct"]</button></header>
<section class="crud-card" data-product-directory>
 <div class="crud-toolbar"><label class="search-box"><input value="@Search" @oninput="SearchChanged" placeholder="@T["SearchHint"]" /></label><button type="button" class="btn btn-secondary" @onclick="Load"><BarangIcon Name="reset" /> @T["Reset"]</button></div>
 @if (Loading) { <BarangLoadingState Text="@T["Loading"]" /> } else if (Rows.Count==0) { <CrudEmptyState /> } else { <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th><BarangSortHeader Label="@T["Code"]" Active="@(SortColumn=="code")" Descending="@SortDescending" Clicked='()=>SortBy("code")' /></th><th><BarangSortHeader Label="@T["Name"]" Active="@(SortColumn=="name")" Descending="@SortDescending" Clicked='()=>SortBy("name")' /></th><th>@T["ProductType"]</th><th>@T["Uom"]</th><th><BarangSortHeader Label="@T["Status"]" Active="@(SortColumn=="status")" Descending="@SortDescending" Clicked='()=>SortBy("status")' /></th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(var row in OrderedRows){<tr><td dir="ltr">@Text(row,"productCode")</td><td>@Text(row,"name")</td><td>@Caption("product.type",Text(row,"productTypeCode"))</td><td dir="ltr">@Caption("unit.of.measure",Text(row,"unitOfMeasureCode"))</td><td><StatusBadge Active="@Active(row)" /></td><td><div class="row-actions"><BarangIconButton Icon="eye" Label="@T["View"]" Semantic="info" Clicked="@(()=>Open(Id(row),true))" /><BarangIconButton Icon="edit" Label="@T["Edit"]" Semantic="edit" Clicked="@(()=>Open(Id(row),false))" /><BarangIconButton Icon="power" Label="@(Active(row)?T["Deactivate"]:T["Activate"])" Semantic="warning" Clicked="@(()=>Toggle(row))" /><BarangIconButton Icon="trash" Label="@T["Delete"]" Semantic="danger" Clicked="@(()=>Delete(row))" /></div></td></tr>}</tbody></table></div> }
</section>

<BarangModal Open="@Dialog" Title="@(Viewing?T["View"]:(IdValue.Length==0?T["AddProduct"]:T["Edit"]))" Description="@T["Products"]" Size="extra-large" ReserveSelectorSpace="true" ShowCloseButton="false" CloseRequested="Close">
 <ChildContent><div class="equipment-editor-layout"><BarangTabs Class="is-vertical equipment-tabs" Orientation="vertical" AriaLabel="@T["Products"]"><button type="button" role="tab" class="@(Tab=="general"?"active":null)" @onclick='()=>Tab="general"'>@T["Details"]</button><button type="button" role="tab" class="@(Tab=="classification"?"active":null)" @onclick='()=>Tab="classification"'>@T["ProductType"]</button><button type="button" role="tab" class="@(Tab=="variants"?"active":null)" @onclick='()=>Tab="variants"'>@T["Variants"]</button><button type="button" role="tab" class="@(Tab=="sourcing"?"active":null)" @onclick='()=>Tab="sourcing"'>@L["Master_suppliers"]</button><button type="button" role="tab" class="@(Tab=="pricing"?"active":null)" @onclick='()=>Tab="pricing"'>@T["Pricing"]</button></BarangTabs>
 <div class="equipment-tab-content">
 @if(Tab=="general"){<section class="form-section"><h3>@T["Details"]</h3><div class="form-grid"><label><span>@T["Code"] *</span><input name="product-code" value="@Val("productCode")" dir="ltr" disabled="@(IdValue.Length>0||Viewing)" @oninput='e=>Set("productCode",e.Value)' /></label><label><span>@T["Name"] *</span><input name="product-name" value="@Val("name")" disabled="@Viewing" @oninput='e=>Set("name",e.Value)' /></label><label class="span-2"><span>@T["Description"]</span><textarea name="product-description" disabled="@Viewing" @oninput='e=>Set("description",e.Value)'>@Val("description")</textarea></label></div></section>}
 @if(Tab=="classification"){<section class="form-section"><h3>@T["ProductType"]</h3><div class="form-grid"><label><span>@T["ProductType"] *</span><ReferenceSelect Name="product-type" TypeCode="product.type" UseCode="true" IncludeInactive="true" Value="@Val("productTypeCode")" ValueChanged='v=>Set("productTypeCode",v)' Disabled="@Viewing" /></label><label><span>@T["Uom"] *</span><ReferenceSelect Name="product-uom" TypeCode="unit.of.measure" UseCode="true" IncludeInactive="true" Value="@Val("unitOfMeasureCode")" ValueChanged='v=>Set("unitOfMeasureCode",v)' Disabled="@Viewing" /></label><label><span>@ProductRefLabel("brand")</span><ReferenceSelect Name="product-brand" TypeCode="product.brand" UseCode="true" IncludeInactive="true" Value="@TVal("brandCode")" ValueChanged='v=>TSet("brandCode",v)' Disabled="@Viewing" /></label><label><span>@ProductRefLabel("material")</span><ReferenceSelect Name="product-material" TypeCode="product.material" UseCode="true" IncludeInactive="true" Value="@TVal("materialCode")" ValueChanged='v=>TSet("materialCode",v)' Disabled="@Viewing" /></label><label><span>@ProductRefLabel("gender")</span><ReferenceSelect Name="product-gender" TypeCode="product.gender" UseCode="true" IncludeInactive="true" Value="@TVal("genderCode")" ValueChanged='v=>TSet("genderCode",v)' Disabled="@Viewing" /></label><label><span>@ProductRefLabel("fit")</span><ReferenceSelect Name="product-fit" TypeCode="product.fit" UseCode="true" IncludeInactive="true" Value="@TVal("fitCode")" ValueChanged='v=>TSet("fitCode",v)' Disabled="@Viewing" /></label><label><span>@ProductRefLabel("style")</span><ReferenceSelect Name="product-style" TypeCode="product.style" UseCode="true" IncludeInactive="true" Value="@TVal("styleCode")" ValueChanged='v=>TSet("styleCode",v)' Disabled="@Viewing" /></label></div></section>}
 @if(Tab=="variants"){<section class="form-section"><div class="section-header"><h3>@T["Variants"]</h3>@if(!Viewing&&IdValue.Length>0){<button type="button" class="btn btn-primary btn-small" @onclick="NewVariant">@T["AddVariant"]</button>}</div><div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T["Sku"]</th><th>@T["Name"]</th><th>@T["Barcode"]</th><th>@T["Size"]</th><th>@T["Color"]</th><th>@T["Status"]</th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(var v in Variants){<tr><td dir="ltr">@Text(v,"sku")</td><td>@Text(v,"displayName")</td><td dir="ltr">@Text(v,"barcode")</td><td>@Caption("product.size",Text(v,"sizeCode"))</td><td>@Caption("product.color",Text(v,"colorCode"))</td><td><StatusBadge Active="@Active(v)" /></td><td>@if(!Viewing){<div class="row-actions"><BarangIconButton Icon="edit" Label="@T["Edit"]" Semantic="edit" Clicked="@(()=>EditVariant(v))" /><BarangIconButton Icon="power" Label="@(Active(v)?T["Deactivate"]:T["Activate"])" Semantic="warning" Clicked="@(()=>ToggleVariant(v))" /><BarangIconButton Icon="trash" Label="@T["Delete"]" Semantic="danger" Clicked="@(()=>DeleteVariant(v))" /></div>}</td></tr>}</tbody></table></div></section>}
@if(Tab=="sourcing"){<section class="form-section"><div class="section-header"><h3>@L["Master_suppliers"]</h3>@if(!Viewing){<button type="button" class="btn btn-primary btn-small" @onclick="NewSourcing">@T["Add"]</button>}</div><div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T["Name"]</th><th>@T["Sku"]</th><th>@T["SupplierItemCode"]</th><th>@T["Status"]</th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(var s in Sources){<tr><td>@Text(s,"supplierName")</td><td dir="ltr">@Text(s,"sku")</td><td dir="ltr">@Text(s,"supplierItemCode")</td><td><StatusBadge Active="@Bool(s,"isActive")" /></td><td>@if(!Viewing){<div class="row-actions"><BarangIconButton Icon="edit" Label="@T["Edit"]" Semantic="edit" Clicked="@(()=>EditSourcing(s))" /><BarangIconButton Icon="power" Label="@(Bool(s,"isActive")?T["Deactivate"]:T["Activate"])" Semantic="warning" Clicked="@(()=>ToggleSourcing(s))" /></div>}</td></tr>}</tbody></table></div></section>}
 @if(Tab=="pricing"){<section class="form-section"><div class="section-header"><div><h3>@T["Pricing"]</h3><small class="muted">@SalesPriceSubtitle()</small></div>@if(!Viewing){<button type="button" class="btn btn-primary btn-small" @onclick="NewPrice">@T["NewPrice"]</button>}</div><div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T["Sku"]</th><th>@T["Amount"]</th><th>@T["Currency"]</th><th>@T["ValidFrom"]</th><th>@T["ValidTo"]</th><th>@T["Status"]</th><th>@T["Actions"]</th></tr></thead><tbody>@if(PricingRows.Count==0){<tr><td colspan="7">@T["NoPricing"]</td></tr>}else foreach(var p in PricingRows){<tr><td dir="ltr">@VariantCaption(Text(p,"productVariantId"))</td><td>@Text(p,"amount")</td><td dir="ltr">@Text(p,"currencyCode")</td><td>@PriceDate(p,"startDate")</td><td>@PriceDate(p,"endDate")</td><td><StatusBadge Active="@Bool(p,"isActive")" /></td><td><div class="row-actions"><BarangIconButton Icon="eye" Label="@T["View"]" Semantic="info" Clicked="@(()=>OpenPrice(p,true))" />@if(!Viewing){<BarangIconButton Icon="edit" Label="@T["Edit"]" Semantic="edit" Clicked="@(()=>OpenPrice(p,false))" /><BarangIconButton Icon="power" Label="@(Bool(p,"isActive")?T["Deactivate"]:T["Activate"])" Semantic="warning" Clicked="@(()=>TogglePrice(p))" /><BarangIconButton Icon="trash" Label="@T["Delete"]" Semantic="danger" Clicked="@(()=>DeletePrice(p))" />}</div></td></tr>}</tbody></table></div></section>}
 </div></div></ChildContent>
 <Footer><button type="button" class="btn btn-secondary" @onclick="Close">@T["Cancel"]</button>@if(!Viewing){<button type="button" class="btn btn-primary" @onclick="Save">@T["Save"]</button>}</Footer>
</BarangModal>

<BarangModal Open="@PriceDialog" Title="@(PriceViewing?T["View"]:T["Add"] + " · " + T["Pricing"])" Description="@T["Pricing"]" Size="large" ReserveSelectorSpace="true" ShowCloseButton="false" CloseRequested="ClosePrice"><ChildContent><section class="form-section"><div class="form-grid"><label><span>@T["Sku"]</span><SearchableSelect Name="sales-price-sku" Options="@VariantOptions" @bind-Value="PriceVariantId" Disabled="@PriceViewing" Placeholder="@ProductLevelText()" /></label><label><span>@T["Amount"] *</span><input type="number" min="0" step="0.01" @bind="PriceAmount" disabled="@PriceViewing" /></label><label><span>@T["Currency"] *</span><input maxlength="3" @bind="PriceCurrency" disabled="@PriceViewing" /></label><label><span>@T["ValidFrom"] *</span><LocaleDateInput Value="PriceStart" ValueChanged="@(x=>PriceStart=x??PriceStart)" Disabled="@PriceViewing" /></label><label><span>@T["ValidTo"]</span><LocaleDateInput Value="PriceEnd" ValueChanged="@(x=>PriceEnd=x)" Disabled="@PriceViewing" /></label></div>@if(PriceMessage is not null){<div class="@(PriceSuccess?"inline-success":"inline-error")" role="status">@PriceMessage</div>}</section></ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="ClosePrice">@T["Cancel"]</button>@if(!PriceViewing){<button type="button" class="btn btn-primary" @onclick="SavePrice">@T["Save"]</button>}</Footer></BarangModal>

<BarangModal Open="@VariantDialog" Title="@(VariantId.Length==0?T["AddVariant"]:T["Edit"])" Description="@T["Variants"]" Size="large" ReserveSelectorSpace="true" ShowCloseButton="false" CloseRequested="CloseVariant"><ChildContent><section class="form-section"><div class="form-grid"><label><span>@T["Sku"] *</span><input name="variant-sku" value="@VVal("sku")" dir="ltr" disabled="@(VariantId.Length>0)" @oninput='e=>VSet("sku",e.Value)' /></label><label><span>@T["Name"]</span><input name="variant-name" value="@VVal("displayName")" @oninput='e=>VSet("displayName",e.Value)' /></label><label><span>@T["Barcode"]</span><input name="variant-barcode" value="@VVal("barcode")" dir="ltr" @oninput='e=>VSet("barcode",e.Value)' /></label><label><span>@T["Size"]</span><ReferenceSelect Name="variant-size" TypeCode="product.size" UseCode="true" IncludeInactive="true" Value="@VVal("sizeCode")" ValueChanged='v=>VSet("sizeCode",v)' /></label><label><span>@T["Color"]</span><ReferenceSelect Name="variant-color" TypeCode="product.color" UseCode="true" IncludeInactive="true" Value="@VVal("colorCode")" ValueChanged='v=>VSet("colorCode",v)' /></label></div></section></ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="CloseVariant">@T["Cancel"]</button><button type="button" class="btn btn-primary" @onclick="SaveVariant">@T["Save"]</button></Footer></BarangModal>

<BarangModal Open="@SourcingDialog" Title="@(SourcingId.Length==0?T["Add"]:T["Edit"])" Description="@L["Master_suppliers"]" Size="large" ReserveSelectorSpace="true" ShowCloseButton="false" CloseRequested="CloseSourcing"><ChildContent><section class="form-section"><div class="form-grid"><label><span>@L["Master_suppliers"] *</span><SearchableSelect Name="supplier" Options="@SupplierOptions" Value="@SourcingSupplierId" ValueChanged="SupplierChanged" Disabled="@(SourcingId.Length>0)" Placeholder="@T["SearchHint"]" /></label><label><span>@T["Sku"]</span><SearchableSelect Name="supplier-sku" Options="@VariantOptions" Value="@SourcingVariantId" ValueChanged="v=>SourcingVariantId=v" Disabled="@(SourcingId.Length>0)" Placeholder="@T["SearchHint"]" /></label><label><span>@T["SupplierItemCode"]</span><input value="@SourcingItemCode" disabled="@Viewing" @oninput="e=>SourcingItemCode=e.Value?.ToString()??string.Empty" /></label><label class="check-field"><input type="checkbox" checked="@SourcingPreferred" disabled="@Viewing" @onchange="e=>SourcingPreferred=(bool)e.Value!" /><span>@T["Preferred"]</span></label></div></section></ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="CloseSourcing">@T["Cancel"]</button>@if(!Viewing){<button type="button" class="btn btn-primary" @onclick="SaveSourcing">@T["Save"]</button>}</Footer></BarangModal>

@code {
 private static string? Null(string value)=>string.IsNullOrWhiteSpace(value)?null:value;
 private List<JsonElement> Rows=[]; private List<JsonElement> Variants=[]; private List<JsonElement> Sources=[]; private List<JsonElement> PricingRows=[]; private List<SearchableSelectOption> SupplierOptions=[]; private List<SearchableSelectOption> VariantOptions=[]; private Dictionary<string,string> Data=[]; private Dictionary<string,string> Technical=[]; private Dictionary<string,string> VData=[]; private string Search="",IdValue="",Tab="general",VariantId="",SortColumn="code"; private bool SortDescending; private bool Loading,Dialog,Viewing,VariantDialog,SourcingDialog,PriceDialog,PriceViewing,PriceSuccess; private string?Token,PriceMessage; private Guid Company; private string SourcingId="",SourcingSupplierId="",SourcingVariantId="",SourcingItemCode="",PriceId="",PriceVariantId="",PriceCurrency="IRR"; private bool SourcingPreferred; private long SourcingVersion,PriceVersion; private decimal PriceAmount; private DateOnly PriceStart=DateOnly.FromDateTime(DateTime.Today); private DateOnly? PriceEnd;
 private readonly Dictionary<string,Dictionary<string,string>> Captions=[];
 private string Val(string k)=>Data.GetValueOrDefault(k,""); private string TVal(string k)=>Technical.GetValueOrDefault(k,""); private string VVal(string k)=>VData.GetValueOrDefault(k,""); private void Set(string k,object? v)=>Data[k]=v?.ToString()??""; private void TSet(string k,object? v)=>Technical[k]=v?.ToString()??""; private void VSet(string k,object? v)=>VData[k]=v?.ToString()??""; private string ProductRefLabel(string key)=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"ar"=>key switch{"brand"=>"العلامة التجارية","material"=>"المادة","gender"=>"الجنس","fit"=>"القصة","style"=>"النمط",_=>key},"en"=>key switch{"brand"=>"Brand","material"=>"Material / Fabric","gender"=>"Gender group","fit"=>"Fit","style"=>"Style",_=>key},_=>key switch{"brand"=>"برند","material"=>"ماده / پارچه","gender"=>"گروه جنسیتی","fit"=>"قالب","style"=>"سبک",_=>key}};
 protected override async Task OnInitializedAsync(){var u=(await AuthState.GetAuthenticationStateAsync()).User;Token=u.FindFirst(AuthClaimTypes.AccessToken)?.Value;Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out Company);await LoadCaptions();await Load();}
 private async Task LoadCaptions(){foreach(var type in new[]{"product.type","unit.of.measure","product.size","product.color"}){var r=await Core.GetAsync($"api/v1/lookups/{type}/options?culture={CultureInfo.CurrentUICulture.TwoLetterISOLanguageName}&activeOnly=false",Token!,Company,default);if(r.IsSuccess)Captions[type]=r.Value.EnumerateArray().ToDictionary(x=>Text(x,"code"),x=>Text(x,"displayName"));}}
 private string Caption(string type,string code)=>code.Length==0?"—":Captions.GetValueOrDefault(type)?.GetValueOrDefault(code,code)??code;
 private async Task Load(){if(Token is null)return;Loading=true;var r=await Core.GetAsync($"api/v1/products?search={Uri.EscapeDataString(Search)}&pageSize=100&activeOnly=true",Token,Company,default);Rows=r.IsSuccess&&r.Value.TryGetProperty("items",out var a)?a.EnumerateArray().ToList():[];Loading=false;}
 private IEnumerable<JsonElement> OrderedRows => (SortColumn switch { "name" => Rows.OrderBy(x=>Text(x,"name"),StringComparer.CurrentCultureIgnoreCase), "status" => Rows.OrderBy(x=>Active(x)), _ => Rows.OrderBy(x=>Text(x,"productCode"),StringComparer.OrdinalIgnoreCase) }) is var ordered && SortDescending ? ordered.Reverse() : ordered;
 private void SortBy(string column){if(SortColumn==column)SortDescending=!SortDescending;else{SortColumn=column;SortDescending=false;}}
 private async Task SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";await Load();}
 private void New(){IdValue="";Data=new(){["productCode"]="",["name"]="",["description"]="",["productTypeCode"]="apparel",["unitOfMeasureCode"]="pcs"};Technical=[];Tab="general";Viewing=false;Variants=[];Sources=[];PricingRows=[];Dialog=true;}
 private async Task Open(string id,bool view){if(Token is null)return;var r=await Core.GetAsync($"api/v1/products/{id}",Token,Company,default);if(!r.IsSuccess)return;IdValue=id;Data=Read(r.Value);Technical=[];var profile=await Core.GetAsync($"api/v1/products/{id}/technical-profile",Token,Company,default);if(profile.IsSuccess)Technical=Read(profile.Value);Viewing=view;Tab="general";Dialog=true;await LoadVariants();await LoadSources();await LoadPricing();}
 private async Task LoadPricing(){if(Token is null||!Guid.TryParse(IdValue,out var id)){PricingRows=[];return;}var r=await Core.GetAsync($"api/v1/products/{id}/sales-prices?includeInactive=true",Token,Company,default);PricingRows=r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array?r.Value.EnumerateArray().ToList():[];}
 private void NewPrice(){PriceViewing=false;PriceId="";PriceVariantId="";PriceAmount=0;PriceCurrency="IRR";PriceStart=DateOnly.FromDateTime(DateTime.Today);PriceEnd=null;PriceVersion=0;PriceMessage=null;PriceDialog=true;}
 private void OpenPrice(JsonElement row,bool view){PriceViewing=view;PriceId=Text(row,"id");PriceVariantId=Text(row,"productVariantId");PriceAmount=row.GetProperty("amount").GetDecimal();PriceCurrency=Text(row,"currencyCode");PriceStart=Dates.TryParseCanonical(Text(row,"startDate"),out var start)?start:DateOnly.FromDateTime(DateTime.Today);PriceEnd=Dates.TryParseCanonical(Text(row,"endDate"),out var end)?end:null;PriceVersion=Version(row);PriceDialog=true;}
 private void ClosePrice()=>PriceDialog=false;
 private async Task SavePrice(){if(Token is null||!Guid.TryParse(IdValue,out var product))return;Guid? variant=Guid.TryParse(PriceVariantId,out var v)?v:null;var body=new{productVariantId=variant,amount=PriceAmount,currencyCode=PriceCurrency,startDate=PriceStart,endDate=PriceEnd,version=PriceVersion};var r=await Core.SendAsync(PriceVersion==0?HttpMethod.Post:HttpMethod.Put,PriceVersion==0?$"api/v1/products/{product}/sales-prices":$"api/v1/product-sales-prices/{PriceId}",body,Token,Company,default);PriceSuccess=r.IsSuccess;PriceMessage=r.IsSuccess?T["SaveSuccess"]:T["SaveFailed"];if(r.IsSuccess){PriceDialog=false;await LoadPricing();}}
 private async Task TogglePrice(JsonElement row){if(Token is null||!await JS.InvokeAsync<bool>("confirm",Bool(row,"isActive")?T["DeactivateConfirm"]:T["ActivateConfirm"]))return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/product-sales-prices/{Text(row,"id")}/activation",new{isActive=!Bool(row,"isActive"),version=Version(row)},Token,Company,default);if(r.IsSuccess)await LoadPricing();}
 private async Task DeletePrice(JsonElement row){if(Token is null||!await JS.InvokeAsync<bool>("confirm",T["DeleteConfirm"]))return;var r=await Core.SendAsync(HttpMethod.Delete,$"api/v1/product-sales-prices/{Text(row,"id")}?version={Version(row)}",null,Token,Company,default);PriceSuccess=r.IsSuccess;PriceMessage=r.IsSuccess?T["DeleteSuccess"]:T["DeleteBlocked"];if(r.IsSuccess)await LoadPricing();}
 private string SalesPriceSubtitle()=>T["RawProductSalesPriceSubtitle"];
 private string ProductLevelText()=>T["ProductLevel"];
 private string PriceDate(JsonElement x,string key){string value=Text(x,key);if(value.Length==0)return "—";return Dates.TryParseCanonical(value,out var d)?Dates.Format(d,CultureInfo.CurrentUICulture.TwoLetterISOLanguageName):value;}
 private async Task LoadVariants(){if(Token is null||IdValue.Length==0){Variants=[];return;}var r=await Core.GetAsync($"api/v1/products/{IdValue}/variants?activeOnly=false",Token,Company,default);Variants=r.IsSuccess?r.Value.EnumerateArray().ToList():[];VariantOptions=Variants.Select(x=>new SearchableSelectOption(Id(x),Text(x,"sku"))).ToList();}
 private async Task LoadSources(){Sources=[];if(Token is null||IdValue.Length==0)return;var r=await Core.GetAsync($"api/v1/products/{IdValue}/supplier-sourcing",Token,Company,default);if(r.IsSuccess)Sources=r.Value.EnumerateArray().ToList();}
 private async Task Save(){if(Token is null)return;var r=await Core.SendAsync(IdValue.Length==0?HttpMethod.Post:HttpMethod.Put,"api/v1/products"+(IdValue.Length==0?"":$"/{IdValue}"),new{productCode=Val("productCode"),name=Val("name"),description=Val("description"),productTypeCode=Val("productTypeCode"),unitOfMeasureCode=Val("unitOfMeasureCode"),version=Long(Data)},Token,Company,default);if(r.IsSuccess){if(IdValue.Length==0&&r.Value.TryGetProperty("id",out var id))IdValue=id.GetGuid().ToString();if(IdValue.Length>0)await Core.SendAsync(HttpMethod.Put,$"api/v1/products/{IdValue}/technical-profile",new{productVariantId=(Guid?)null,brandCode=Null(TVal("brandCode")),materialCode=Null(TVal("materialCode")),genderCode=Null(TVal("genderCode")),fitCode=Null(TVal("fitCode")),styleCode=Null(TVal("styleCode")),technicalAttributes=(string?)null,version=Long(Technical)},Token,Company,default);await Load();if(IdValue.Length>0){var fresh=await Core.GetAsync($"api/v1/products/{IdValue}",Token,Company,default);if(fresh.IsSuccess)Data=Read(fresh.Value);}Dialog=false;}}
 private async Task Toggle(JsonElement r){if(Token is not null)await Core.SendAsync(HttpMethod.Post,$"api/v1/products/{Id(r)}/activation",new{isActive=!Active(r),version=Version(r)},Token,Company,default);await Load();}
 private async Task Delete(JsonElement r){if(Token is not null)await Core.SendAsync(HttpMethod.Delete,$"api/v1/products/{Id(r)}?version={Version(r)}",null,Token,Company,default);await Load();}
 private void Close()=>Dialog=false;
 private void NewVariant(){VariantId="";VData=new();VariantDialog=true;} private void EditVariant(JsonElement r){VariantId=Id(r);VData=Read(r);VariantDialog=true;} private void CloseVariant()=>VariantDialog=false;
 private async Task SaveVariant(){if(Token is null||IdValue.Length==0)return;var r=await Core.SendAsync(VariantId.Length==0?HttpMethod.Post:HttpMethod.Put,VariantId.Length==0?$"api/v1/products/{IdValue}/variants":$"api/v1/product-variants/{VariantId}",new{sku=VVal("sku"),displayName=VVal("displayName"),barcode=VVal("barcode"),sizeCode=VVal("sizeCode"),colorCode=VVal("colorCode"),version=Long(VData)},Token,Company,default);if(r.IsSuccess){VariantDialog=false;await LoadVariants();}}
 private async Task ToggleVariant(JsonElement r){if(Token is not null)await Core.SendAsync(HttpMethod.Post,$"api/v1/product-variants/{Id(r)}/activation",new{isActive=!Active(r),version=Version(r)},Token,Company,default);await LoadVariants();} private async Task DeleteVariant(JsonElement r){if(Token is not null)await Core.SendAsync(HttpMethod.Delete,$"api/v1/product-variants/{Id(r)}?version={Version(r)}",null,Token,Company,default);await LoadVariants();}
 private async Task NewSourcing(){await LoadSuppliers();SourcingId="";SourcingSupplierId="";SourcingVariantId="";SourcingItemCode="";SourcingPreferred=false;SourcingVersion=0;SourcingDialog=true;} private async Task LoadSuppliers(){if(Token is null)return;var r=await Core.GetAsync("api/v1/suppliers/options?limit=100",Token,Company,default);if(r.IsSuccess)SupplierOptions=r.Value.EnumerateArray().Select(x=>new SearchableSelectOption(Text(x,"id"),$"{Text(x,"name")} - {Text(x,"code")}")).ToList();}
 private Task SupplierChanged(string value){SourcingSupplierId=value;return Task.CompletedTask;}
 private async Task EditSourcing(JsonElement row){await LoadSuppliers();SourcingId=Text(row,"supplierProductId");SourcingSupplierId=Text(row,"supplierId");SourcingVariantId=Text(row,"productVariantId");SourcingItemCode=Text(row,"supplierItemCode");SourcingPreferred=Bool(row,"isPreferred");SourcingVersion=Long(row,"version");SourcingDialog=true;}
 private async Task SaveSourcing(){if(Token is null||!Guid.TryParse(SourcingSupplierId,out var supplier)||!Guid.TryParse(IdValue,out var product))return;Guid? variant=Guid.TryParse(SourcingVariantId,out var v)?v:null;var body=new{productId=product,productVariantId=variant,supplierItemCode=SourcingItemCode,isPreferred=SourcingPreferred,version=SourcingVersion};var path=$"api/v1/suppliers/{supplier}/products"+(SourcingId.Length==0?"":$"/{SourcingId}");var r=await Core.SendAsync(SourcingId.Length==0?HttpMethod.Post:HttpMethod.Put,path,body,Token,Company,default);if(r.IsSuccess){SourcingDialog=false;await LoadSources();}}
 private void CloseSourcing()=>SourcingDialog=false; private async Task ToggleSourcing(JsonElement row){if(Token is null)return;var supplier=Text(row,"supplierId");var id=Text(row,"supplierProductId");if(supplier.Length==0||id.Length==0)return;await Core.SendAsync(HttpMethod.Post,$"api/v1/suppliers/{supplier}/products/{id}/activation",new{isActive=!Bool(row,"isActive"),version=Long(row,"version")},Token,Company,default);await LoadSources();}
 private string VariantCaption(string id)=>string.IsNullOrWhiteSpace(id)?ProductLevelText():Variants.FirstOrDefault(x=>Id(x)==id) is JsonElement variant?Text(variant,"sku"):id; private static Dictionary<string,string>Read(JsonElement x)=>x.EnumerateObject().ToDictionary(p=>p.Name,p=>p.Value.ValueKind==JsonValueKind.Null?"":p.Value.ToString()); private static string Text(JsonElement x,string k)=>x.TryGetProperty(k,out var v)?v.ToString():""; private static string Id(JsonElement x)=>Text(x,"id").Length>0?Text(x,"id"):Text(x,"supplierProductId"); private static bool Active(JsonElement x)=>Bool(x,"isActive"); private static bool Bool(JsonElement x,string k)=>x.TryGetProperty(k,out var v)&&v.ValueKind==JsonValueKind.True; private static long Version(JsonElement x)=>Long(x,"version"); private static long Long(JsonElement x,string k)=>x.TryGetProperty(k,out var v)&&v.ValueKind==JsonValueKind.Number?v.GetInt64():0; private static long Long(Dictionary<string,string>x)=>long.TryParse(x.GetValueOrDefault("version"),out var v)?v:0;
}
