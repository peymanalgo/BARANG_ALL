@page "/workspace/production"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["Module_production"]</PageTitle><div class="page-heading"><h1>@L["Module_production"]</h1></div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<section class="toolbar"><label><span>@L["Status"]</span><select @bind="Status"><option value="">@L["All"]</option><option value="Planned">@L["StatusPlanned"]</option><option value="Ready">@L["StatusReady"]</option><option value="InProgress">@L["StatusInProgress"]</option><option value="Suspended">@L["StatusSuspended"]</option><option value="Failed">@L["StatusFailed"]</option><option value="Completed">@L["StatusCompleted"]</option></select></label><button type="button" @onclick="Load">@L["Refresh"]</button></section><div class="management-grid"><section class="panel"><div class="record-list">@foreach(var x in Jobs){<button type="button" class="record-row" @onclick="()=>Pick(x)"><span><strong>@x.Type · @L[$"Status{x.Status}"]</strong><small>@x.Id</small></span></button>}</div></section><section class="panel"><div class="form-grid single"><label><span>@L["Module_orders"]</span><input @bind="Order" /></label><label><span>@L["EntityId"]</span><input @bind="Job" /></label><label><span>@L["User"]</span><input @bind="Operator" /></label><label><span>@L["Action_Equipment"]</span><input @bind="Equipment" /></label><label><span>@L["Version"]</span><input type="number" @bind="Version" /></label><label><span>@L["Reason"]</span><input @bind="Reason" /></label></div><div class="form-actions"><button type="button" @onclick="Generate">@L["Action_Create"]</button><button type="button" @onclick="Plan">@L["Action_Plan"]</button><button type="button" @onclick="AssignOperator">@L["Action_Assign"]</button><button type="button" @onclick="AssignEquipment">@L["Action_Equipment"]</button><button type="button" @onclick="Start">@L["Action_Execute"]</button><button type="button" @onclick="Complete">@L["Action_Complete"]</button><button type="button" @onclick="Suspend">@L["Action_Cancel"]</button><button type="button" @onclick="Resume">@L["Action_Execute"]</button><button type="button" @onclick="Fail">@L["ValidationError"]</button></div></section></div><section class="panel"><h2>@L["Timeline"]</h2><BarangJsonGrid Json="@History" /><h2>@L["Capacity"]</h2><BarangJsonGrid Json="@Capacity" /></section>
@code{private string Status="",Order="",Job="",Operator="",Equipment="",Reason="Backoffice",History="",Capacity="";private long Version;private bool Success;private string?Message;private List<Row>Jobs=[];protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){var s=await Session();if(s is null)return;var r=await Core.GetAsync("api/v1/production/jobs?page=1&pageSize=100"+(string.IsNullOrWhiteSpace(Status)?"":$"&status={Status}"),s.Value.Token,s.Value.Company,default);if(r.IsSuccess)Jobs=r.Value.GetProperty("items").EnumerateArray().Select(x=>new Row(x.GetProperty("id").GetGuid(),G(x,"jobType"),G(x,"status"),x.GetProperty("version").GetInt64())).ToList();var c=await Core.GetAsync("api/v1/production/capacity",s.Value.Token,s.Value.Company,default);Capacity=c.IsSuccess?c.Value.ToString():"";}private async Task Pick(Row x){Job=x.Id.ToString();Version=x.Version;var s=await Session();if(s is null)return;var h=await Core.GetAsync($"api/v1/production/jobs/{x.Id}/history",s.Value.Token,s.Value.Company,default);History=h.IsSuccess?h.Value.ToString():"";}private Task Generate()=>Post($"api/v1/production/orders/{Order}/jobs",null);private Task Plan()=>Put($"api/v1/production/jobs/{Job}/plan",new{priority="Normal",plannedStartUtc=(DateTimeOffset?)null,plannedEndUtc=(DateTimeOffset?)null,queuePosition=0,version=Version});private Task AssignOperator()=>Put($"api/v1/production/jobs/{Job}/operator",new{operatorUserId=Operator,version=Version});private Task AssignEquipment()=>Put($"api/v1/production/jobs/{Job}/equipment",new{equipmentId=string.IsNullOrWhiteSpace(Equipment)?null:Equipment,version=Version});private Task Start()=>Post($"api/v1/production/jobs/{Job}/start",new{version=Version});private Task Complete()=>Post($"api/v1/production/jobs/{Job}/complete",new{quantityCompleted=(decimal?)null,notes=Reason,version=Version});private Task Fail()=>Post($"api/v1/production/jobs/{Job}/fail",new{reason=Reason,version=Version});private Task Suspend()=>Post($"api/v1/production/jobs/{Job}/suspend",new{reason=Reason,version=Version});private Task Resume()=>Post($"api/v1/production/jobs/{Job}/resume",new{version=Version});private Task Put(string p,object b)=>Send(HttpMethod.Put,p,b);private Task Post(string p,object?b)=>Send(HttpMethod.Post,p,b);private async Task Send(HttpMethod m,string p,object?b){var s=await Session();if(s is null)return;var r=await Core.SendAsync(m,p,b,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){if(r.Value.ValueKind==System.Text.Json.JsonValueKind.Object){Job=G(r.Value,"id");Version=r.Value.TryGetProperty("version",out var v)?v.GetInt64():Version;}await Load();}}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private sealed record Row(Guid Id,string Type,string Status,long Version);}
