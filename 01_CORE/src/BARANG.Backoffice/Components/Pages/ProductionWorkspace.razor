@page "/workspace/production"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates
<PageTitle>@L["Module_production"]</PageTitle>
<header class="crud-header"><div><span class="eyebrow">@L["OperationalWorkspace"]</span><h1>@L["Module_production"]</h1><p>@T("برنامه‌ریزی، صف چاپ و پرس، ظرفیت و عملکرد اپراتورها","Production planning, print & press queues, capacity and operator performance","برنامه‌ریزی تولید، صف چاپ و کوبش، ظرفیت و عملکرد اپراتورها")</p></div><div class="row-actions"><button type="button" class="btn btn-secondary" @onclick="ToggleMine">@(MineOnly?T("همه کارها","All jobs","همه کارها"):T("کارهای من","My jobs","کارهای من"))</button><button type="button" class="btn btn-secondary" @onclick="Load"><BarangIcon Name="reset" /> @L["Refresh"]</button></div></header>
<div class="production-summary">
 <div class="panel production-stat"><small>@T("در صف","In queue","در صف")</small><strong>@QueueCount</strong></div>
 <div class="panel production-stat"><small>@T("در جریان","In progress","در جریان")</small><strong>@InProgressCount</strong></div>
 <div class="panel production-stat"><small>@T("متوقف","Suspended","متوقف")</small><strong>@SuspendedCount</strong></div>
 <div class="panel production-stat"><small>@T("بدون تحویل کالا","Awaiting stock","بی تحویل انبار")</small><strong>@PendingWarehouseCount</strong></div>
</div>
<section class="crud-card">
 <div class="crud-toolbar"><label class="compact-filter"><span>@L["Status"]</span><select @bind="Status" @bind:after="FilterChanged"><option value="">@L["All"]</option><option value="Planned">@St("Planned")</option><option value="Ready">@St("Ready")</option><option value="InProgress">@St("InProgress")</option><option value="Suspended">@St("Suspended")</option><option value="Failed">@St("Failed")</option><option value="Completed">@St("Completed")</option></select></label><label class="compact-filter"><span>@T("نوع کار","Job type","نوع کار")</span><select @bind="JobType" @bind:after="FilterChanged"><option value="">@L["All"]</option><option value="DesignPreparation">@Jt("DesignPreparation")</option><option value="Print">@Jt("Print")</option><option value="HeatPress">@Jt("HeatPress")</option></select></label><label class="compact-filter"><span>@T("اولویت","Priority","الأولوية")</span><select @bind="Priority" @bind:after="FilterChanged"><option value="">@L["All"]</option><option value="Urgent">@Pt("Urgent")</option><option value="High">@Pt("High")</option><option value="Normal">@Pt("Normal")</option><option value="Low">@Pt("Low")</option></select></label></div>
 @if(Busy){<BarangLoadingState Text="@L["Loading"]" />}
 else if(Rows.Count==0){<CrudEmptyState Title="@L["NoRecords"]" Description="@T("پس از ثبت نهایی سفارش‌ها، کارهای تولید به‌صورت خودکار اینجا ساخته می‌شوند.","Production jobs are created automatically after orders are submitted.","بعد من الاعتماد النهائي للطلبات تُنشأ أعمال الإنتاج تلقائياً.")" />}
 else{
  <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("نوع کار","Job type","نوع")</th><th>@L["Module_orders"]</th><th>@T("محصول","Product","المنتج")</th><th>@T("عملیات چاپ","Print op","الطباعة")</th><th>@T("مقدار برنامه","Planned qty","الكمية")</th><th>@T("اپراتور","Operator","المشغل")</th><th>@T("دستگاه","Equipment","الجهاز")</th><th>@T("کالا از انبار","Stock issued","الصنف من المستودع")</th><th>@L["Status"]</th><th class="actions-column">@L["Actions"]</th></tr></thead><tbody>
   @foreach(var row in Rows){
    <tr class="@(Selected?.Id==row.Id?"is-selected":null)">
     <td><span class="status-pill">@Jt(row.JobType)</span></td>
     <td dir="ltr"><span class="code-pill">@(row.OrderNumber.Length==0?"—":row.OrderNumber)</span></td>
     <td>@(row.ProductTitle.Length==0?"—":row.ProductTitle)</td>
     <td>@(row.PrintPosition.Length==0?"—":row.PrintPosition)</td>
     <td>@(row.PlannedQuantity>0?row.PlannedQuantity.ToString("0.##",CultureInfo.InvariantCulture):"—")</td>
     <td>@(row.OperatorName??"—")</td>
     <td>@(row.EquipmentName??"—")</td>
     <td>@if(row.JobType=="DesignPreparation"){<span class="concept-meta">—</span>}else if(row.WarehouseIssued){<span class="wh-badge ok" title="@T("کالا از انبار تحویل شده است","Stock issued from warehouse","تم تسليم الصنف من المستودع")">✔</span>}else{<span class="wh-badge pending" title="@T("منتظر تحویل کالا از انبار","Awaiting stock issue","بانتظار تسليم الصنف")">⏳</span>}</td>
     <td><span class="status-pill">@St(row.Status)</span></td>
     <td><BarangActionMenu><BarangIconButton Icon="eye" Semantic="info" Label="@L["View"]" Clicked="@(()=>Pick(row))" />@if(!Viewing){@StateActions(row)}</BarangActionMenu></td>
    </tr>
   }
  </tbody></table></div>
  <BarangPagination Page="@Page" HasNext="@(Page*PageSize<Total)" Disabled="@Busy" PageLabel="@L["Page"]" PreviousText="@L["Previous"]" NextText="@L["Next"]" Previous="@PreviousPage" Next="@NextPage" />
 }
</section>

@if(Selected is not null){
<section class="crud-card production-detail" data-production-detail>
 <div class="production-detail-head"><h2>@T("جزئیات کار","Job details","تفاصيل العملية") · @Jt(Selected.JobType)</h2><div class="row-actions"><span class="wh-badge @(Selected.WarehouseIssued?"ok":"pending")">@(Selected.WarehouseIssued?T("کالا تحویل شد","Stock issued","تم التسليم"):T("منتظر کالا","Awaiting stock","بانتظار الصنف"))</span><button type="button" class="btn btn-secondary btn-small" @onclick="CloseDetail">@L["Cancel"]</button></div></div>
 <div class="form-grid production-spec">
  <label><span>@L["Module_orders"]</span><input value="@Selected.OrderNumber" readonly /></label>
  <label><span>@T("محصول","Product","المنتج")</span><input value="@Selected.ProductTitle" readonly /></label>
  <label><span>@T("عملیات چاپ","Print operation","الطباعة")</span><input value="@(Selected.PrintPosition.Length==0?"—":Selected.PrintPosition)" readonly /></label>
  <label><span>@T("مقدار برنامه","Planned quantity","الكمية المخططة")</span><input value="@(Selected.PlannedQuantity>0?Selected.PlannedQuantity.ToString("0.##",CultureInfo.InvariantCulture):"—")" readonly /></label>
  <label><span>@T("تکمیل‌شده","Completed qty","المكتمل")</span><input value="@(Selected.QuantityCompleted?.ToString("0.##",CultureInfo.InvariantCulture)??"—")" readonly /></label>
  <label><span>@T("اولویت","Priority","الأولوية")</span><input value="@Pt(Selected.Priority)" readonly /></label>
  <label><span>@T("شروع برنامه‌ریزی","Planned start","بداية التخطيط")</span><input value="@RangeLabel(Selected.PlannedStart,Selected.PlannedEnd)" readonly /></label>
  <label><span>@T("اجرای واقعی","Actual run","التنفيذ الفعلي")</span><input value="@RangeLabel(Selected.StartedAt,Selected.CompletedAt)" readonly /></label>
  @if(!string.IsNullOrWhiteSpace(Selected.FailureReason)){<label class="span-2"><span>@T("علت خطا","Failure reason","سبب الفشل")</span><input value="@Selected.FailureReason" readonly /></label>}
  @if(!string.IsNullOrWhiteSpace(Selected.SuspensionReason)){<label class="span-2"><span>@T("علت توقف","Suspension reason","سبب التعليق")</span><input value="@Selected.SuspensionReason" readonly /></label>}
  @if(Selected.ReproductionDepth>0){<label class="span-2"><span>@T("زنجیره بازتولید","Reproduction chain","سلسلة إعادة الإنتاج")</span><input value="@T($"بازتولید شماره {Selected.ReproductionDepth} از درخواست ثبت‌شده کنترل کیفیت",$"Reproduction depth {Selected.ReproductionDepth} from a QC request",$"إعادة إنتاج مستوى {Selected.ReproductionDepth} من طلب مراقبة الجودة")" readonly /></label>}
 </div>
 @if(!Viewing&&ActionBusy){<BarangLoadingState Text="@L["Loading"]" />}
 @if(!Viewing&&!ActionBusy){<div class="form-actions production-actions"><BarangActionMenu>@StateActions(Selected)</BarangActionMenu></div>}
 @if(!string.IsNullOrWhiteSpace(ActionError)){<div class="inline-error" role="alert">@ActionError</div>}
 <h3>@L["Timeline"]</h3>
 @if(History.Count==0){<p class="field-help">@L["NoRecords"]</p>}else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@D2("رویداد","Event","الحدث")</th><th>@D2("زمان","When","الوقت")</th><th>@D2("شرح","Summary","الوصف")</th></tr></thead><tbody>@foreach(var h in History){<tr><td>@h.EventType</td><td>@Dates.Format(h.At,CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)</td><td>@(h.Summary??"—")</td></tr>}</tbody></table></div>}
</section>
}

<section class="crud-card"><h2>@T("ظرفیت خطوط (بر اساس شیفت‌ها)","Line capacity (shift based)","الطاقة حسب الورديات")</h2>@if(CapacityBusy){<BarangLoadingState Text="@L["Loading"]" />}else if(Capacity.Count==0){<p class="field-help">@T("تجهیز فعالی ثبت نشده است.","No active equipment.","لا يوجد عدة نشطة.")</p>}else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("دستگاه","Equipment","الجهاز")</th><th>@T("ظرفیت در ساعت","Capacity/hour","الطاقة/ساعة")</th><th>@T("ظرفیت بازه","Window capacity","طاقة الفترة")</th><th>@T("بار برنامه","Planned load","الحمل المخطط")</th><th>@T("بهره‌وری","Utilization","الاستغلال")</th><th>@T("در جریان","In progress","قيد التنفيذ")</th></tr></thead><tbody>@foreach(var c in Capacity){<tr><td>@c.EquipmentName <small dir="ltr">@c.EquipmentCode</small></td><td>@(c.CapacityPerHour?.ToString("0.#",CultureInfo.InvariantCulture)??"—")</td><td>@(c.AvailableUnits?.ToString("0.#",CultureInfo.InvariantCulture)??"—")</td><td>@(c.LoadUnits?.ToString("0.#",CultureInfo.InvariantCulture)??"—")</td><td>@if(c.UtilizationPercent is null){<span>—</span>}else{<span class="util-badge @(c.UtilizationPercent>100?"over":c.UtilizationPercent>70?"high":"ok")">@c.UtilizationPercent?.ToString("0.#",CultureInfo.InvariantCulture)٪</span>}</td><td>@c.InProgress</td></tr>}</tbody></table></div>}<p class="field-help">@T("شیفت‌های فعال:","Active shifts:","الورديات النشطة:") @ShiftSummary</p></section>

<section class="crud-card"><h2>@T("عملکرد اپراتورها","Operator performance","أداء المشغلين")</h2><div class="crud-toolbar compact"><label class="compact-filter"><span>@T("از تاریخ","From","من")</span><LocaleDateInput Name="perf-from" Value="@PerfFrom" ValueChanged="PerfFromChanged" /></label><label class="compact-filter"><span>@T("تا تاریخ","To","إلى")</span><LocaleDateInput Name="perf-to" Value="@PerfTo" ValueChanged="PerfToChanged" /></label></div>@if(PerfBusy){<BarangLoadingState Text="@L["Loading"]" />}else if(Performance.Count==0){<p class="field-help">@T("در این بازه کاری تکمیل نشده است.","No completed jobs in this period.","لا توجد عمليات مكتملة في هذه الفترة.")</p>}else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("اپراتور","Operator","المشغل")</th><th>@T("کارهای تکمیل‌شده","Completed jobs","عمليات مكتملة")</th><th>@T("مجموع مقدار","Total units","مجموع الكمية")</th><th>@T("میانگین مدت (دقیقه)","Avg duration (min)","متوسط المدة (دقيقة)")</th><th>@T("به‌موقع","On time","في الوقت")</th><th>@T("با تأخیر","Late","متأخر")</th></tr></thead><tbody>@foreach(var p in Performance){<tr><td>@p.OperatorName</td><td>@p.CompletedJobs</td><td>@p.UnitsCompleted.ToString("0.##",CultureInfo.InvariantCulture)</td><td>@p.AvgDurationMinutes.ToString("0.#",CultureInfo.InvariantCulture)</td><td>@p.OnTimeCount</td><td>@p.LateCount</td></tr>}</tbody></table></div>}</section>

<BarangModal Open="@Dialog" Title="@DialogTitle" Size="medium" ShowCloseButton="true" CloseRequested="()=>Dialog=false">
 <ChildContent><div class="form-grid single">
  @if(DialogKind=="plan"){<label><span>@T("اولویت","Priority","الأولوية")</span><select @bind="FormPriority"><option value="Normal">@Pt("Normal")</option><option value="High">@Pt("High")</option><option value="Urgent">@Pt("Urgent")</option><option value="Low">@Pt("Low")</option></select></label><label><span>@T("تاریخ شروع","Start date","تاريخ البداية")</span><LocaleDateInput Name="plan-start-date" Value="@FormStartDate" ValueChanged="FormStartDateChanged" /></label><label><span>@T("ساعت شروع","Start time","وقت البداية")</span><input type="time" value="@FormStartTime" @oninput="StartTimeInputChanged" /></label><label><span>@T("تاریخ پایان","End date","تاريخ النهاية")</span><LocaleDateInput Name="plan-end-date" Value="@FormEndDate" ValueChanged="FormEndDateChanged" /></label><label><span>@T("ساعت پایان","End time","وقت النهاية")</span><input type="time" value="@FormEndTime" @oninput="EndTimeInputChanged" /></label><label><span>@T("جایگاه در صف","Queue position","موقع في الصف")</span><input type="number" @bind="FormQueue" /></label>}
  @if(DialogKind=="operator"){<label><span>@T("اپراتور","Operator","المشغل")</span><SearchableSelect Name="prod-operator" Options="@OperatorOptions" @bind-Value="FormOperator" Placeholder="@SelectPlaceholder" /></label>}
  @if(DialogKind=="equipment"){<label><span>@T("دستگاه","Equipment","الجهاز")</span><SearchableSelect Name="prod-equipment" Options="@EquipmentOptions" @bind-Value="FormEquipment" Placeholder="@SelectPlaceholder" /></label>}
  @if(DialogKind=="complete"){<label><span>@T("مقدار تولیدشده","Completed quantity","الكمية المنتجة")</span><input type="number" step="0.01" min="0" @bind="FormQuantity" /></label><label><span>@T("یادداشت","Notes","ملاحظات")</span><input @bind="FormNotes" /></label>}
  @if(DialogKind is "suspend" or "fail"){<label><span>@T("دلیل (الزامی)","Reason (required)","السبب (إلزامي)")</span><input @bind="FormReason" /></label>}
  @if(!string.IsNullOrWhiteSpace(ActionError)){<div class="inline-error" role="alert">@ActionError</div>}
 </div></ChildContent>
 <Footer><button type="button" class="btn btn-secondary" @onclick="()=>Dialog=false">@L["Cancel"]</button><button type="button" class="btn btn-primary" disabled="@ActionBusy" @onclick="SubmitDialog">@L["Save"]</button></Footer>
</BarangModal>

@code {
 private const int PageSize=20;
 private bool Busy,ActionBusy,Viewing,MineOnly,CapacityBusy,PerfBusy; private string Status="",JobType="",Priority="",ActionError="";
 private int Page=1; private long Total; private List<ProductionRow> Rows=[]; private ProductionRow? Selected;
 private List<HistoryRow> History=[]; private List<CapacityRow> Capacity=[]; private List<PerfRow> Performance=[];
 private bool Dialog; private string DialogKind="",DialogTitle=""; private string FormPriority="Normal",FormOperator="",FormEquipment="",FormNotes="",FormReason=""; private int FormQueue; private decimal FormQuantity; private DateOnly? PerfFrom,PerfTo;
 private List<SearchableSelectOption> OperatorOptions=[],EquipmentOptions=[];
 private int QueueCount,InProgressCount,SuspendedCount,PendingWarehouseCount;
 private string? Token; private Guid Company;
 private DateOnly? FormStartDate; private DateOnly? FormEndDate; private string FormStartTime="08:00"; private string FormEndTime="10:00";
 private Task FormStartDateChanged(DateOnly? v){FormStartDate=v;return Task.CompletedTask;}
 private Task FormEndDateChanged(DateOnly? v){FormEndDate=v;return Task.CompletedTask;}
 private void StartTimeInputChanged(ChangeEventArgs e)=>FormStartTime=e.Value?.ToString()??"08:00";
 private void EndTimeInputChanged(ChangeEventArgs e)=>FormEndTime=e.Value?.ToString()??"10:00";
 private string SelectPlaceholder=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"en"=>"Select","ar"=>"اختر",_=>"انتخاب کنید"};
 private string ShiftSummary=>string.Join(" · ",ShiftList.Select(s=>$"{s.Title} ({s.Start:HH:mm}–{s.End:HH:mm})"));
 private readonly List<(string Title,TimeOnly Start,TimeOnly End)> ShiftList=[];
 protected override async Task OnInitializedAsync(){var u=(await AuthState.GetAuthenticationStateAsync()).User;Token=u.FindFirst(AuthClaimTypes.AccessToken)?.Value;Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out Company);await LoadShifts();await Load();}
 private string T(string fa,string en,string ar)=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"en"=>en,"ar"=>ar,_=>fa};
 private string D2(string fa,string en,string ar)=>T(fa,en,ar);
 private string St(string s)=>s switch{"Planned"=>T("برنامه‌ریزی‌شده","Planned","مخطط"),"Ready"=>T("آماده","Ready","جاهز"),"InProgress"=>T("در جریان","In progress","قيد التنفيذ"),"Suspended"=>T("متوقف","Suspended","معلق"),"Failed"=>T("خطا","Failed","فشل"),"Completed"=>T("تکمیل‌شده","Completed","مكتمل"),_=>s};
 private string Jt(string t)=>t switch{"DesignPreparation"=>T("آماده‌سازی طرح","Design preparation","تجهيز التصميم"),"Print"=>T("چاپ","Print","طباعة"),"HeatPress"=>T("پرس حرارتی","Heat press","كبس حراري"),_=>t};
 private string Pt(string p)=>p switch{"Urgent"=>T("فوری","Urgent","عاجل"),"High"=>T("مهم","High","مرتفع"),"Normal"=>T("عادی","Normal","عادي"),"Low"=>T("کم","Low","منخفض"),_=>p};
 private string RangeLabel(DateTimeOffset? from,DateTimeOffset? to){if(from is null&&to is null)return "—";string f=from is null?"—":Dates.Format(from.Value,CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);string t2=to is null?"—":Dates.Format(to.Value,CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);return $"{f} → {t2}";}
 private async Task LoadShifts(){if(Token is null)return;var r=await Core.GetAsync("api/v1/production/shifts",Token,Company,default);ShiftList.Clear();if(r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array)foreach(var x in r.Value.EnumerateArray())ShiftList.Add((Text(x,"title"),TimeOnly.Parse(Text(x,"startTime")),TimeOnly.Parse(Text(x,"endTime"))));}
 private async Task ToggleMine(){MineOnly=!MineOnly;Page=1;await Load();}
 private Task FilterChanged(){Page=1;return Load();}
 private async Task Load(){if(Token is null)return;Busy=true;await InvokeAsync(StateHasChanged);try{string q=$"api/v1/production/jobs?page={Page}&pageSize={PageSize}"+(string.IsNullOrWhiteSpace(Status)?"":$"&status={Status}")+(string.IsNullOrWhiteSpace(JobType)?"":$"&jobType={JobType}")+(string.IsNullOrWhiteSpace(Priority)?"":$"&priority={Priority}")+(MineOnly?$"&operatorUserId={UserId()}":"");var r=await Core.GetAsync(q,Token,Company,default);Rows.Clear();Total=0;if(r.IsSuccess&&r.Value.TryGetProperty("items",out var items)&&items.ValueKind==JsonValueKind.Array){Rows=items.EnumerateArray().Select(ParseRow).ToList();Total=r.Value.TryGetProperty("total",out var tt)?tt.GetInt64():Rows.Count;}QueueCount=Rows.Count(x=>x.Status is "Planned" or "Ready");InProgressCount=Rows.Count(x=>x.Status=="InProgress");SuspendedCount=Rows.Count(x=>x.Status=="Suspended");PendingWarehouseCount=Rows.Count(x=>!x.WarehouseIssued&&x.JobType!="DesignPreparation"&&x.Status is not ("Completed" or "Failed"));}
 finally{Busy=false;await InvokeAsync(StateHasChanged);}await LoadCapacity();await LoadPerformance();}
 private string UserId(){var u=AuthState.GetAuthenticationStateAsync().Result.User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out _)&&u.FindFirst("sub")?.Value is string id?id:u.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value??"";}
 private async Task LoadCapacity(){if(Token is null)return;CapacityBusy=true;var r=await Core.GetAsync("api/v1/production/capacity",Token,Company,default);Capacity.Clear();if(r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array)foreach(var x in r.Value.EnumerateArray())Capacity.Add(new CapacityRow(Guid.Parse(x.GetProperty("equipmentId").GetGuid().ToString()),Text(x,"equipmentCode"),Text(x,"equipmentName"),NullInt(x,"capacityPerHour"),NullDec(x,"availableUnits"),NullDec(x,"loadUnits"),x.TryGetProperty("utilizationPercent",out var u)&&u.ValueKind==JsonValueKind.Number?u.GetDouble():(double?)null,x.TryGetProperty("inProgressJobs",out var ip)?ip.GetInt32():0));CapacityBusy=false;}
 private async Task LoadPerformance(){if(Token is null)return;PerfBusy=true;await InvokeAsync(StateHasChanged);try{string q="api/v1/production/performance"+(PerfFrom is null?"":$"&fromUtc={Uri.EscapeDataString(new DateTimeOffset(PerfFrom.Value.ToDateTime(TimeOnly.MinValue),TimeSpan.Zero).ToString("yyyy-MM-dd'T'HH:mm:ss'Z'"))}")+(PerfTo is null?"":$"&toUtc={Uri.EscapeDataString(new DateTimeOffset(PerfTo.Value.ToDateTime(TimeOnly.MinValue),TimeSpan.Zero).AddDays(1).ToString("yyyy-MM-dd'T'HH:mm:ss'Z'"))}");var r=await Core.GetAsync(q,Token,Company,default);Performance.Clear();if(r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array)foreach(var x in r.Value.EnumerateArray())Performance.Add(new PerfRow(Guid.Empty,Text(x,"operatorName"),x.TryGetProperty("completedJobs",out var cj)?cj.GetInt32():0,x.TryGetProperty("unitsCompleted",out var uc)?uc.GetDecimal():0,x.TryGetProperty("avgDurationMinutes",out var av)?av.GetDouble():0,x.TryGetProperty("onTimeCount",out var ot)?ot.GetInt32():0,x.TryGetProperty("lateCount",out var lc)?lc.GetInt32():0));}finally{PerfBusy=false;await InvokeAsync(StateHasChanged);}}
 private Task PerfFromChanged(DateOnly? v){PerfFrom=v;return LoadPerformance();}
 private Task PerfToChanged(DateOnly? v){PerfTo=v;return LoadPerformance();}
 private async Task Pick(ProductionRow row){Viewing=true;Selected=row;ActionError="";History.Clear();await InvokeAsync(StateHasChanged);var r=await Core.GetAsync($"api/v1/production/jobs/{row.Id}/history",Token!,Company,default);History.Clear();if(r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array)foreach(var x in r.Value.EnumerateArray())History.Add(new HistoryRow(Text(x,"eventType"),x.GetProperty("occurredAtUtc").GetDateTimeOffset(),Text(x,"summary")));}
 private void CloseDetail(){Viewing=false;Selected=null;ActionError="";}
 private ProductionRow? Job(string id)=>Rows.FirstOrDefault(x=>x.Id==id)??(Selected?.Id==id?Selected:null);
 private RenderFragment StateActions(ProductionRow row)=>@<text>
  @if(row.Status is "Planned"){<BarangIconButton Icon="calendar" Semantic="info" Label="@T("برنامه‌ریزی","Plan","تخطيط")" Clicked="@(()=>OpenDialog("plan",row))" />}
  @if(row.Status is "Planned" or "Ready"){<BarangIconButton Icon="person" Semantic="info" Label="@T("تخصیص اپراتور","Assign operator","إسناد مشغل")" Clicked="@(()=>OpenDialog("operator",row))" />}
  @if(row.JobType!="DesignPreparation"&&row.Status is "Planned" or "Ready"){<BarangIconButton Icon="warehouse" Semantic="info" Label="@T("تخصیص دستگاه","Assign equipment","إسناد جهاز")" Clicked="@(()=>OpenDialog("equipment",row))" />}
  @if(row.Status=="Ready"){<BarangIconButton Icon="print" Semantic="success" Label="@T("شروع","Start","بدء")" Clicked="@(()=>Simple(row,"start"))" />}
  @if(row.Status=="InProgress"){<BarangIconButton Icon="check" Semantic="success" Label="@T("تکمیل","Complete","إتمام")" Clicked="@(()=>OpenDialog("complete",row))" /><BarangIconButton Icon="minus" Semantic="warning" Label="@T("توقف","Suspend","تعليق")" Clicked="@(()=>OpenDialog("suspend",row))" />}
  @if(row.Status=="Suspended"){<BarangIconButton Icon="refresh" Semantic="success" Label="@T("ادامه","Resume","استئناف")" Clicked="@(()=>Simple(row,"resume"))" />}
  @if(row.Status is "Ready" or "InProgress" or "Suspended"){<BarangIconButton Icon="close" Semantic="danger" Label="@T("خطا","Fail","فشل")" Clicked="@(()=>OpenDialog("fail",row))" />}
 </text>;
 private ProductionRow? DialogRow;
 private void OpenDialog(string kind,ProductionRow row){DialogRow=row;DialogKind=kind;Dialog=true;ActionError="";FormPriority=row.Priority is "Urgent"?"Urgent":row.Priority is "High"?"High":"Normal";FormStartDate=row.PlannedStart is null?DateOnly.FromDateTime(DateTime.Now):DateOnly.FromDateTime(row.PlannedStart.Value.LocalDateTime);FormStartTime=row.PlannedStart?.LocalDateTime.ToString("HH:mm")??"08:00";FormEndDate=row.PlannedEnd is null?DateOnly.FromDateTime(DateTime.Now.AddHours(2)):DateOnly.FromDateTime(row.PlannedEnd.Value.LocalDateTime);FormEndTime=row.PlannedEnd?.LocalDateTime.ToString("HH:mm")??"10:00";FormQuantity=row.PlannedQuantity;FormOperator=row.OperatorUserId?.ToString()??"";FormEquipment=row.EquipmentId?.ToString()??"";FormNotes="";FormReason="";DialogTitle=kind switch{"plan"=>T("برنامه‌ریزی کار","Plan job","تخطيط العملية"),"operator"=>T("تخصیص اپراتور","Assign operator","إسناد مشغل"),"equipment"=>T("تخصیص دستگاه","Assign equipment","إسناد جهاز"),"complete"=>T("تکمیل کار","Complete job","إتمام العملية"),"suspend"=>T("توقف کار","Suspend job","تعليق العملية"),_=>T("ثبت خطا","Fail job","تسجيل الفشل")};if(kind=="operator")_ = LoadOperators();if(kind=="equipment")_ = LoadEquipmentOptions(row);}
 private async Task LoadOperators(){if(OperatorOptions.Count>0)return;var r=await Core.GetAsync("api/v1/production/operators",Token!,Company,default);OperatorOptions.Clear();if(r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array)foreach(var x in r.Value.EnumerateArray())OperatorOptions.Add(new SearchableSelectOption(x.GetProperty("userId").GetString()??"",Text(x,"displayName")));}
 private async Task LoadEquipmentOptions(ProductionRow row){EquipmentOptions.Clear();var r=await Core.GetAsync("api/v1/production/capacity",Token!,Company,default);if(!r.IsSuccess||r.Value.ValueKind!=JsonValueKind.Array)return;string want=row.JobType=="Print"?"PRINT":row.JobType=="HeatPress"?"HEAT":"";foreach(var x in r.Value.EnumerateArray()){string code=Text(x,"equipmentCode").ToUpperInvariant();if(want.Length==0||code.Contains(want,StringComparison.OrdinalIgnoreCase))EquipmentOptions.Add(new SearchableSelectOption(x.GetProperty("equipmentId").GetString()??"",Text(x,"equipmentName")));}}
 private async Task Simple(ProductionRow row,string action){if(Token is null)return;ActionBusy=true;ActionError="";await InvokeAsync(StateHasChanged);try{var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/production/jobs/{row.Id}/{action}",new{version=row.Version},Token,Company,default);if(!r.IsSuccess)ActionError=T("عملیات انجام نشد. دسترسی یا داده را بررسی کنید.","Operation failed. Check access or data.","فشلت العملية. تحقق من الوصول أو البيانات.");await ReloadAfterAction(row);}finally{ActionBusy=false;await InvokeAsync(StateHasChanged);}}
 private async Task SubmitDialog(){if(Token is null||DialogRow is null)return;var row=DialogRow;ActionBusy=true;ActionError="";await InvokeAsync(StateHasChanged);try{ApiResult<JsonElement> r;switch(DialogKind){
  case "plan":{if(FormStartDate is null||FormEndDate is null||!TimeOnly.TryParse(FormStartTime,out var st)||!TimeOnly.TryParse(FormEndTime,out var en)){ActionError=T("بازه برنامه‌ریزی الزامی است.","Planning window is required.","فترة التخطيط إلزامية.");return;}DateTimeOffset s=new DateTimeOffset(FormStartDate.Value.ToDateTime(st),TimeSpan.Zero).ToUniversalTime();DateTimeOffset e=new DateTimeOffset(FormEndDate.Value.ToDateTime(en),TimeSpan.Zero).ToUniversalTime();if(e<=s){ActionError=T("پایان باید بعد از شروع باشد.","End must be after start.","يجب أن تكون النهاية بعد البداية.");return;}r=await Core.SendAsync(HttpMethod.Put,$"api/v1/production/jobs/{row.Id}/plan",new{priority=FormPriority,plannedStartUtc=s,plannedEndUtc=e,queuePosition=FormQueue,version=row.Version},Token,Company,default);break;}
  case "operator":{if(!Guid.TryParse(FormOperator,out Guid op)){ActionError=T("انتخاب اپراتور الزامی است.","Select an operator.","اختيار المشغل إلزامي.");return;}r=await Core.SendAsync(HttpMethod.Put,$"api/v1/production/jobs/{row.Id}/operator",new{operatorUserId=op,version=row.Version},Token,Company,default);break;}
  case "equipment":{Guid? eq=Guid.TryParse(FormEquipment,out Guid eid)?eid:(Guid?)null;r=await Core.SendAsync(HttpMethod.Put,$"api/v1/production/jobs/{row.Id}/equipment",new{equipmentId=eq,version=row.Version},Token,Company,default);break;}
  case "complete":{if(FormQuantity<=0){ActionError=T("مقدار تولیدشده الزامی است.","Completed quantity is required.","الكمية المنتجة إلزامية.");return;}r=await Core.SendAsync(HttpMethod.Post,$"api/v1/production/jobs/{row.Id}/complete",new{quantityCompleted=FormQuantity,notes=string.IsNullOrWhiteSpace(FormNotes)?null:FormNotes,version=row.Version},Token,Company,default);break;}
  default:{if(string.IsNullOrWhiteSpace(FormReason)){ActionError=T("ثبت دلیل الزامی است.","Reason is required.","السبب إلزامي.");return;}r=await Core.SendAsync(HttpMethod.Post,$"api/v1/production/jobs/{row.Id}/{DialogKind}",new{reason=FormReason,version=row.Version},Token,Company,default);break;}}
  if(!r.IsSuccess)ActionError=T("عملیات انجام نشد. دسترسی، مقدار یا گیت انبار را بررسی کنید.","Operation failed. Check access, quantity or the warehouse gate.","فشلت العملية. تحقق من الوصول أو الكمية أو بوابة المستودع.");else Dialog=false;await ReloadAfterAction(row);}finally{ActionBusy=false;await InvokeAsync(StateHasChanged);}}
 private async Task ReloadAfterAction(ProductionRow row){await Load();var fresh=Rows.FirstOrDefault(x=>x.Id==row.Id)??Rows.FirstOrDefault(x=>x.OrderNumber==row.OrderNumber&&x.JobType==row.JobType);if(fresh is not null&&Selected is not null&&Selected.Id==row.Id){Selected=fresh;await Pick(fresh);}else if(Selected is not null){var s2=Rows.FirstOrDefault(x=>x.Id==Selected.Id);if(s2 is not null)Selected=s2;}}
 private async Task PreviousPage(){if(Page>1){Page--;await Load();}}
 private async Task NextPage(){if(Page*PageSize<Total){Page++;await Load();}}
 private static string Text(JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=JsonValueKind.Null?p.ToString():"";
 private static int NullInt(JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind==JsonValueKind.Number?p.GetInt32():0;
 private static decimal? NullDec(JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind==JsonValueKind.Number?p.GetDecimal():(decimal?)null;
 private static Guid NullGuid(JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind==JsonValueKind.String&&Guid.TryParse(p.GetString(),out var g)?g:Guid.Empty;
 private ProductionRow ParseRow(JsonElement x)=>new(x.GetProperty("id").GetGuid().ToString(),Text(x,"jobType"),Text(x,"status"),Text(x,"priority"),Text(x,"orderNumber"),Text(x,"productTitle"),x.TryGetProperty("plannedQuantity",out var pq)&&pq.ValueKind==JsonValueKind.Number?pq.GetDecimal():0,Text(x,"printPosition"),x.TryGetProperty("warehouseIssued",out var w)&&w.ValueKind==JsonValueKind.True,Text(x,"operatorName"),Text(x,"equipmentName"),x.TryGetProperty("quantityCompleted",out var qc)&&qc.ValueKind==JsonValueKind.Number?qc.GetDecimal():(decimal?)null,x.TryGetProperty("plannedStartUtc",out var ps)&&ps.ValueKind==JsonValueKind.String?ps.GetDateTimeOffset():(DateTimeOffset?)null,x.TryGetProperty("plannedEndUtc",out var pe)&&pe.ValueKind==JsonValueKind.String?pe.GetDateTimeOffset():(DateTimeOffset?)null,x.TryGetProperty("startedAtUtc",out var sa)&&sa.ValueKind==JsonValueKind.String?sa.GetDateTimeOffset():(DateTimeOffset?)null,x.TryGetProperty("completedAtUtc",out var ca)&&ca.ValueKind==JsonValueKind.String?ca.GetDateTimeOffset():(DateTimeOffset?)null,NullGuid(x,"operatorUserId")==Guid.Empty?"":NullGuid(x,"operatorUserId").ToString(),NullGuid(x,"equipmentId")==Guid.Empty?"":NullGuid(x,"equipmentId").ToString(),Text(x,"failureReason"),Text(x,"suspensionReason"),x.TryGetProperty("reproductionDepth",out var rd)?rd.GetInt32():0,x.TryGetProperty("version",out var v)?v.GetInt64():0);
 private sealed record ProductionRow(string Id,string JobType,string Status,string Priority,string OrderNumber,string ProductTitle,decimal PlannedQuantity,string PrintPosition,bool WarehouseIssued,string OperatorName,string EquipmentName,decimal? QuantityCompleted,DateTimeOffset? PlannedStart,DateTimeOffset? PlannedEnd,DateTimeOffset? StartedAt,DateTimeOffset? CompletedAt,string OperatorUserId,string EquipmentId,string FailureReason,string SuspensionReason,int ReproductionDepth,long Version);
 private sealed record HistoryRow(string EventType,DateTimeOffset At,string? Summary);
 private sealed record CapacityRow(Guid Id,string EquipmentCode,string EquipmentName,int? CapacityPerHour,decimal? AvailableUnits,decimal? LoadUnits,double? UtilizationPercent,int InProgress);
 private sealed record PerfRow(Guid UserId,string OperatorName,int CompletedJobs,decimal UnitsCompleted,double AvgDurationMinutes,int OnTimeCount,int LateCount);
}
