  if(!r.IsSuccess)ActionError=T("عملیات انجام نشد؛ قواعد لجستیک (وضعیت بسته/انبار/تکراری) را بررسی کنید.","Operation failed; check logistics rules (package status/warehouse/duplicate).","فشلت العملية؛ تحقق من قواعد اللوجستيات.");else{Dialog=false;await Load();}}finally{Busy=false;await InvokeAsync(StateHasChanged);}}
