@page "/workspace/logistics"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<CrudStrings> T2
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates
<PageTitle>@T("لجستیک","Logistics","اللوجستيات")</PageTitle>
<header class="crud-header logistics-hero"><div><span class="eyebrow logistics-kicker"><span class="logistics-ink-dot" aria-hidden="true"></span>@L["OperationalWorkspace"]</span><h1>@T("لجستیک","Logistics","اللوجستيات")</h1><p>@T("بسته‌بندی، تحویل به انبار ارسال، مرسولات و پیگیری تحویل","Packaging, handoff, shipments and delivery tracking","التغليف والتسليم والشحنات وتتبع التوصيل")</p></div><div class="row-actions"><button type="button" class="btn btn-primary" @onclick="OpenNewPackage"><BarangIcon Name="plus" /> @T("بسته جدید","New package","طرد جديد")</button><button type="button" class="btn btn-secondary" @onclick="Load"><BarangIcon Name="reset" /> @L["Refresh"]</button></div></header>

<div class="production-kpis">
 <button type="button" class="kpi-card kpi-indigo" @onclick="@(async()=>{PackageStatusFilter="Draft";PackagePage=1;await Load();})"><span class="kpi-icon"><BarangIcon Name="box" /></span><span class="kpi-body"><strong>@DraftPackages</strong><small>@T("در بسته‌بندی","Packaging","في التغليف")</small></span></button>
 <button type="button" class="kpi-card kpi-teal" @onclick="@(async()=>{PackageStatusFilter="AtShippingWarehouse";PackagePage=1;await Load();})"><span class="kpi-icon"><BarangIcon Name="warehouse" /></span><span class="kpi-body"><strong>@AtWarehousePackages</strong><small>@T("انبار ارسال","Shipping wh.","مستودع الشحن")</small></span></button>
 <button type="button" class="kpi-card kpi-amber" @onclick="@(async()=>{PackageStatusFilter="";ShipmentStatusFilter="Shipped";ShipmentPage=1;await Load();})"><span class="kpi-icon"><BarangIcon Name="truck" /></span><span class="kpi-body"><strong>@InTransitShipments</strong><small>@T("مرسولات در راه","In transit","في الطريق")</small></span></button>
 <button type="button" class="kpi-card kpi-green" @onclick="@(async()=>{ShipmentStatusFilter="Delivered";ShipmentPage=1;await Load();})"><span class="kpi-icon"><BarangIcon Name="check" /></span><span class="kpi-body"><strong>@DeliveredShipments</strong><small>@T("تحویل‌شده","Delivered","تم التسليم")</small></span></button>
 <button type="button" class="kpi-card kpi-coral" @onclick="@(async()=>{ShipmentStatusFilter="FailedDelivery";ShipmentPage=1;await Load();})"><span class="kpi-icon"><BarangIcon Name="close" /></span><span class="kpi-body"><strong>@ProblemShipments</strong><small>@T("ناموفق/برگشتی","Failed/Returned","فاشل/مرجع")</small></span></button>
</div>

<section class="prod-panel prod-tint-indigo prod-full">
 <header class="prod-panel-head"><span class="prod-panel-icon chip-indigo"><BarangIcon Name="box" /></span><div><h2>@T("بسته‌ها","Packages","الطرود")</h2><small>@T("بسته‌بندی سفارش‌های تأییدشده","Packaging of approved orders","تغليف الطلبات المعتمدة")</small></div><button type="button" class="prod-chart-btn" title="@T("توزیع وضعیت بسته‌ها","Package status mix","توزيع حالات الطرود")" @onclick="@(()=>OpenChart("packageStatus",@T("توزیع وضعیت بسته‌ها","Package status mix","توزيع حالات الطرود")))"><BarangIcon Name="chart" /></button></header>
 <div class="prod-panel-body">
  <div class="crud-toolbar compact"><label class="compact-filter"><span>@L["Status"]</span><select @bind="PackageStatusFilter" @bind:after="FilterChanged"><option value="">@L["All"]</option><option value="Draft">@PkSt("Draft")</option><option value="Completed">@PkSt("Completed")</option><option value="AtShippingWarehouse">@PkSt("AtShippingWarehouse")</option><option value="ReleasedToShipment">@PkSt("ReleasedToShipment")</option></select></label></div>
  @if(Busy){<BarangLoadingState Text="@L["Loading"]" />}
  else if(PackageRows.Count==0){<CrudEmptyState Title="@L["NoRecords"]" Description="@T("برای سفارش‌های تأییدشده، از دکمه «بسته جدید» بسته بسازید.","Create packages for approved orders via New package.","أنشئ طروداً للطلبات المعتمدة عبر زر طرد جديد.")" />}
  else{
   <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("شماره بسته","Package no.","رقم الطرد")</th><th>@L["Module_orders"]</th><th>@T("نوع","Type","النوع")</th><th>@T("وزن (kg)","Weight","الوزن")</th><th>@T("ابعاد (cm)","Dims","الأبعاد")</th><th>@T("اقلام","Items","الأصناف")</th><th>@L["Status"]</th><th class="actions-column">@L["Actions"]</th></tr></thead><tbody>
    @foreach(var row in PackageRows){
     <tr class="@(SelectedPackageId==row.Id?"is-selected":null)">
      <td dir="ltr"><span class="code-pill">@row.PackageNumber</span></td>
      <td dir="ltr"><span class="code-pill">@(row.OrderNumber.Length==0?"—":row.OrderNumber)</span></td>
      <td>@(row.PackageTypeCode.Length==0?"—":row.PackageTypeCode)</td>
      <td>@row.WeightKg.ToString("0.#",CultureInfo.InvariantCulture)</td>
      <td dir="ltr">@row.LengthCm.ToString("0.#")×@row.WidthCm.ToString("0.#")×@row.HeightCm.ToString("0.#")</td>
      <td>@row.ItemsCount</td>
      <td><span class="status-dot pkst-@row.Status.ToLowerInvariant()"></span><span>@PkSt(row.Status)</span></td>
      <td><BarangActionMenu><BarangIconButton Icon="eye" Semantic="info" Label="@L["View"]" Clicked="@(()=>SelectPackage(row))" />@if(row.Status=="Draft"){<BarangIconButton Icon="check" Semantic="success" Label="@T("تکمیل بسته","Complete","إكمال")" Clicked="@(()=>PackageComplete(row))" /><BarangIconButton Icon="truck" Semantic="info" Label="@T("تحویل به انبار ارسال","Handoff","تسليم")" Clicked="@(()=>OpenHandoff(row))" />}</BarangActionMenu></td>
     </tr>
    }
   </tbody></table></div>
   <BarangPagination Page="@PackagePage" HasNext="@(PackagePage*PageSize<PackageTotal)" Disabled="@Busy" PageLabel="@L["Page"]" PreviousText="@L["Previous"]" NextText="@L["Next"]" Previous="@PreviousPackagePage" Next="@NextPackagePage" />
  }
  </div>
</section>

<section class="prod-panel prod-tint-teal prod-full">
 <header class="prod-panel-head"><span class="prod-panel-icon chip-teal"><BarangIcon Name="truck" /></span><div><h2>@T("مرسولات","Shipments","الشحنات")</h2><small>@T("ارسال، حمل و تحویل به مشتری","Shipment, transit and delivery","الشحن والنقل والتسليم")</small></div><button type="button" class="prod-chart-btn" title="@T("توزیع وضعیت مرسولات","Shipment status mix","توزيع حالات الشحنات")" @onclick="@(()=>OpenChart("shipmentStatus",@T("توزیع وضعیت مرسولات","Shipment status mix","توزيع حالات الشحنات")))"><BarangIcon Name="chart" /></button><button type="button" class="prod-chart-btn" title="@T("مرسوله جدید","New shipment","شحنة جديدة")" @onclick="OpenNewShipment"><BarangIcon Name="plus" /></button></header>
 <div class="prod-panel-body">
  <div class="crud-toolbar compact"><label class="compact-filter"><span>@L["Status"]</span><select @bind="ShipmentStatusFilter" @bind:after="FilterChanged"><option value="">@L["All"]</option><option value="Ready">@ShSt("Ready")</option><option value="Shipped">@ShSt("Shipped")</option><option value="InTransit">@ShSt("InTransit")</option><option value="Delivered">@ShSt("Delivered")</option><option value="FailedDelivery">@ShSt("FailedDelivery")</option><option value="Returned">@ShSt("Returned")</option></select></label></div>
  @if(Busy){<BarangLoadingState Text="@L["Loading"]" />}
  else if(ShipmentRows.Count==0){<CrudEmptyState Title="@L["NoRecords"]" Description="@T("پس از آماده شدن بسته‌ها، مرسوله جدید بسازید.","Create shipments once packages are ready.","أنشئ شحنات عند جهوزية الطرود.")" />}
  else{
   <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("شماره مرسوله","Shipment no.","رقم الشحنة")</th><th>@L["Module_orders"]</th><th>@T("حمل‌کننده","Carrier","الناقل")</th><th>@T("روش ارسال","Method","الطريقة")</th><th>@T("کد رهگیری","Tracking","التتبع")</th><th>@T("بسته‌ها","Pkgs","الطرود")</th><th>@T("تحویل برنامه‌ای","Expected","المتوقع")</th><th>@L["Status"]</th><th class="actions-column">@L["Actions"]</th></tr></thead><tbody>
    @foreach(var row in ShipmentRows){
     <tr class="@(SelectedShipmentId==row.Id?"is-selected":null)">
      <td dir="ltr"><span class="code-pill">@row.ShipmentNumber</span></td>
      <td dir="ltr"><span class="code-pill">@(row.OrderNumber.Length==0?"—":row.OrderNumber)</span></td>
      <td>@CarrierLabel(row.CarrierCode)</td>
      <td>@row.ShippingMethodCode</td>
      <td dir="ltr">@(row.TrackingCode.Length==0?"—":row.TrackingCode)</td>
      <td>@row.PackagesCount</td>
      <td>@(row.ExpectedDelivery is null?"—":Dates.Format(row.ExpectedDelivery.Value.ToDateTime(TimeOnly.MinValue),CultureInfo.CurrentUICulture.TwoLetterISOLanguageName))</td>
      <td><span class="status-dot shst-@row.Status.ToLowerInvariant()"></span><span>@ShSt(row.Status)</span></td>
      <td><BarangActionMenu><BarangIconButton Icon="eye" Semantic="info" Label="@L["View"]" Clicked="@(()=>SelectShipment(row))" />@ShipmentActions(row)</BarangActionMenu></td>
     </tr>
    }
   </tbody></table></div>
   <BarangPagination Page="@ShipmentPage" HasNext="@(ShipmentPage*PageSize<ShipmentTotal)" Disabled="@Busy" PageLabel="@L["Page"]" PreviousText="@L["Previous"]" NextText="@L["Next"]" Previous="@PreviousShipmentPage" Next="@NextShipmentPage" />
  }
  </div>
</section>

@if(SelectedShipment is not null){
<section class="crud-card production-detail" data-logistics-detail>
 <div class="production-detail-head logistics-detail-head"><h2>@T("مرسوله","Shipment","الشحنة") · @SelectedShipment.ShipmentNumber</h2><div class="row-actions"><span class="wh-badge @(SelectedShipment.Status=="Delivered"?"ok":SelectedShipment.Status is "FailedDelivery" or "Returned"?"pending":"none")">@ShSt(SelectedShipment.Status)</span><button type="button" class="btn btn-secondary btn-small" @onclick="CloseShipmentDetail">@L["Cancel"]</button></div></div>
 <div class="form-grid production-spec">
  <label><span>@L["Module_orders"]</span><input value="@SelectedShipment.OrderNumber" readonly /></label>
  <label><span>@T("حمل‌کننده","Carrier","الناقل")</span><input value="@CarrierLabel(SelectedShipment.CarrierCode)" readonly /></label>
  <label><span>@T("روش ارسال","Method","الطريقة")</span><input value="@SelectedShipment.ShippingMethodCode" readonly /></label>
  <label><span>@T("کد رهگیری","Tracking","التتبع")</span><input value="@(SelectedShipment.TrackingCode.Length==0?"—":SelectedShipment.TrackingCode)" readonly /></label>
  <label><span>@T("تاریخ ارسال","Shipped at","تاريخ الشحن")</span><input value="@(SelectedShipment.ShipmentDate is null?"—":Dates.Format(SelectedShipment.ShipmentDate.Value,CultureInfo.CurrentUICulture.TwoLetterISOLanguageName))" readonly /></label>
  <label><span>@T("تحویل در","Delivered at","التسليم في")</span><input value="@(SelectedShipment.DeliveredAt is null?"—":Dates.Format(SelectedShipment.DeliveredAt.Value,CultureInfo.CurrentUICulture.TwoLetterISOLanguageName))" readonly /></label>
  @if(!string.IsNullOrWhiteSpace(SelectedShipment.LastReason)){<label class="span-2"><span>@T("آخرین علت","Last reason","آخر سبب")</span><input value="@SelectedShipment.LastReason" readonly /></label>}
 </div>
 <h3>@T("تاریخچه وضعیت‌ها","Status history","سجل الحالات")</h3>
 @if(ShipmentHistory.Count==0){<p class="field-help">@L["NoRecords"]</p>}else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("وضعیت","Status","الحالة")</th><th>@T("زمان","When","الوقت")</th><th>@T("منبع","Source","المصدر")</th><th>@T("دلیل","Reason","السبب")</th></tr></thead><tbody>@foreach(var h in ShipmentHistory){<tr><td>@ShSt(h.Status)</td><td>@Dates.Format(h.At,CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)</td><td dir="ltr">@h.Source</td><td>@(h.Reason??"—")</td></tr>}</tbody></table></div>}
</section>
}

<BarangModal Open="@Dialog" Title="@DialogTitle" Size="medium" ShowCloseButton="true" CloseRequested="()=>Dialog=false">
 <ChildContent><div class="form-grid single">
  @if(DialogKind=="newPackage"){<label><span>@T("سفارش تأییدشده","Submitted order","طلب معتمد")</span><SearchableSelect Name="log-order" Options="@SubmittedOrderOptions" @bind-Value="FormOrder" Placeholder="@SelectPlaceholder" /></label><label><span>@T("نوع بسته","Package type","نوع الطرد")</span><ReferenceSelect Name="log-package-type" TypeCode="packaging.type" UseCode="true" @bind-Value="FormPackageType" Placeholder="@SelectPlaceholder" /></label><label><span>@T("وزن (kg)","Weight (kg)","الوزن")</span><input type="number" step="0.01" min="0.01" @bind="FormWeight" /></label><label><span>@T("ابعاد L/W/H (cm)","L/W/H (cm)","الأبعاد")</span><div class="dims-row"><input type="number" step="0.1" min="0.1" @bind="FormLength" /><input type="number" step="0.1" min="0.1" @bind="FormWidth" /><input type="number" step="0.1" min="0.1" @bind="FormHeight" /></div></label>}
  @if(DialogKind=="handoff"){<label><span>@T("انبار ارسال (Shipping)","Shipping warehouse","مستودع الشحن")</span><SearchableSelect Name="log-warehouse" Options="@WarehouseOptions" @bind-Value="FormWarehouse" Placeholder="@SelectPlaceholder" /></label>}
  @if(DialogKind=="newShipment"){<label><span>@T("بسته آماده","Ready package","طرد جاهز")</span><SearchableSelect Name="log-ship-pkg" Options="@ReadyPackageOptions" @bind-Value="FormPackageId" Placeholder="@SelectPlaceholder" /></label><label><span>@T("حمل‌کننده","Carrier","الناقل")</span><SearchableSelect Name="log-carrier" Options="@CarrierOptions" @bind-Value="FormCarrier" Placeholder="@SelectPlaceholder" /></label><label><span>@T("روش ارسال","Shipping method","طريقة الشحن")</span><ReferenceSelect Name="log-method" TypeCode="shipping.method" UseCode="true" @bind-Value="FormMethod" Placeholder="@SelectPlaceholder" /></label><label><span>@T("تحویل برنامه‌ای","Expected delivery","التوصيل المتوقع")</span><LocaleDateInput Name="log-expected" Value="@FormExpected" ValueChanged="FormExpectedChanged" /></label>}
  @if(DialogKind=="tracking"){<label><span>@T("کد رهگیری","Tracking code","رمز التتبع")</span><input dir="ltr" @bind="FormTracking" /></label>}
  @if(DialogKind=="reason"){<label><span>@T("کد دلیل","Reason code","رمز السبب")</span><input dir="ltr" @bind="FormReasonCode" /></label><label><span>@T("شرح دلیل","Reason text","شرح السبب")</span><input @bind="FormReasonText" /></label>}
  @if(!string.IsNullOrWhiteSpace(ActionError)){<div class="inline-error" role="alert">@ActionError</div>}
 </div></ChildContent>
 <Footer><button type="button" class="btn btn-secondary" @onclick="()=>Dialog=false">@L["Cancel"]</button><button type="button" class="btn btn-primary" disabled="@Busy" @onclick="SubmitDialog">@L["Save"]</button></Footer>
</BarangModal>

<BarangModal Open="@ChartOpen" Title="@ChartTitle" Size="large" CssClass="chart-popup-modal" ShowCloseButton="true" CloseRequested="()=>ChartOpen=false">
 <ChildContent><div class="chart-body-inline popup-chart">
  @if(ChartKind=="packageStatus"){
   <div class="chart-flex">
    <div class="donut-wrap"><div class="donut" style="@PackageDonutStyle()"><div class="donut-hole"><strong>@PackageStatusTotal</strong><small>@T("بسته","packages","طرد")</small></div></div></div>
    <ul class="chart-legend">
     @foreach(var seg in PackageSegments){<li><span class="legend-dot" style="background:@seg.Color"></span><span class="legend-label">@seg.Label</span><strong dir="ltr">@seg.Count</strong></li>}
    </ul>
   </div>
  }
  else if(ChartKind=="shipmentStatus"){
   <div class="chart-flex">
    <div class="donut-wrap"><div class="donut" style="@ShipmentDonutStyle()"><div class="donut-hole"><strong>@ShipmentStatusTotal</strong><small>@T("مرسوله","shipments","شحنة")</small></div></div></div>
    <ul class="chart-legend">
     @foreach(var seg in ShipmentSegments){<li><span class="legend-dot" style="background:@seg.Color"></span><span class="legend-label">@seg.Label</span><strong dir="ltr">@seg.Count</strong></li>}
    </ul>
   </div>
  }
 </div></ChildContent>
 <Footer><button type="button" class="btn btn-secondary" @onclick="()=>ChartOpen=false">@L["Cancel"]</button></Footer>
</BarangModal>

@code {
 private void CloseShipmentDetail(){SelectedShipment=null;ShipmentHistory.Clear();}
 private Task FormExpectedChanged(DateOnly? v){FormExpected=v;return Task.CompletedTask;}
 private const int PageSize=20;
 private bool Busy,Dialog; private string PackageStatusFilter="",ShipmentStatusFilter="",ActionError="",DialogKind="",DialogTitle="";
 private int PackagePage=1,ShipmentPage=1; private long PackageTotal,ShipmentTotal,PackageStatusTotal,ShipmentStatusTotal;
 private List<QPkg> PackageRows=[]; private List<QShp> ShipmentRows=[];
 private string? SelectedPackageId,SelectedShipmentId; private QShp? SelectedShipment;
 private int DraftPackages,AtWarehousePackages,InTransitShipments,DeliveredShipments,ProblemShipments;
 private Dictionary<string,long> PackageCounts=new(); private Dictionary<string,long> ShipmentCounts=new();
 private bool ChartOpen; private string ChartKind="",ChartTitle="";
 private string FormOrder="",FormPackageType="",FormWarehouse="",FormCarrier="",FormMethod="",FormTracking="",FormReasonCode="",FormReasonText="",FormPackageId=""; private decimal FormWeight=1,FormLength=25,FormWidth=20,FormHeight=5; private DateOnly? FormExpected;
 private Guid ActionPackageId; private string ActionShipmentId="" ; private long ActionPackageVersion;
 private List<SearchableSelectOption> SubmittedOrderOptions=[],WarehouseOptions=[],CarrierOptions=[],ReadyPackageOptions=[];
 private string? Token; private Guid Company;
 private string SelectPlaceholder=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"en"=>"Select","ar"=>"اختر",_=>"انتخاب کنید"};
 protected override async Task OnInitializedAsync(){var u=(await AuthState.GetAuthenticationStateAsync()).User;Token=u.FindFirst(AuthClaimTypes.AccessToken)?.Value;Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out Company);await Load();}
 private string T(string fa,string en,string ar)=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"en"=>en,"ar"=>ar,_=>fa};
 private string PkSt(string s)=>s switch{"Draft"=>T("در بسته‌بندی","Packaging","في التغليف"),"Completed"=>T("بسته‌بندی‌شده","Packaged","معبأ"),"AtShippingWarehouse"=>T("انبار ارسال","At shipping wh.","مستودع الشحن"),"ReleasedToShipment"=>T("آزاد برای ارسال","Released","مفرج للشحن"),_=>s};
 private string ShSt(string s)=>s switch{"Ready"=>T("آماده ارسال","Ready to ship","جاهز للشحن"),"Shipped"=>T("ارسال‌شده","Shipped","مشحون"),"InTransit"=>T("در حال حمل","In transit","في الطريق"),"Delivered"=>T("تحویل‌شده","Delivered","تم التسليم"),"FailedDelivery"=>T("ارسال ناموفق","Failed delivery","فشل التسليم"),"Returned"=>T("برگشتی","Returned","مرتجع"),_=>s};
 private string CarrierLabel(string code)=>code.Length==0?"—":char.ToUpperInvariant(code[0])+code[1..];
 private List<(string Label,long Count,string Color)> PackageSegments=>new(){(PkSt("Draft"),PackageCounts.GetValueOrDefault("Draft",0),"#6c8cff"),(PkSt("Completed"),PackageCounts.GetValueOrDefault("Completed",0),"#06b6d4"),(PkSt("AtShippingWarehouse"),PackageCounts.GetValueOrDefault("AtShippingWarehouse",0),"#f59e0b"),(PkSt("ReleasedToShipment"),PackageCounts.GetValueOrDefault("ReleasedToShipment",0),"#22c55e")};
 private List<(string Label,long Count,string Color)> ShipmentSegments=>new(){(ShSt("Ready"),ShipmentCounts.GetValueOrDefault("Ready",0),"#6c8cff"),(ShSt("Shipped"),ShipmentCounts.GetValueOrDefault("Shipped",0),"#f59e0b"),(ShSt("InTransit"),ShipmentCounts.GetValueOrDefault("InTransit",0),"#06b6d4"),(ShSt("Delivered"),ShipmentCounts.GetValueOrDefault("Delivered",0),"#22c55e"),(ShSt("FailedDelivery"),ShipmentCounts.GetValueOrDefault("FailedDelivery",0),"#ef6b63"),(ShSt("Returned"),ShipmentCounts.GetValueOrDefault("Returned",0),"#8b5cf6")};
 private string PackageDonutStyle()=>DonutCore(PackageSegments,ref _pkgTotal); private long _pkgTotal;
 private string ShipmentDonutStyle()=>DonutCore(ShipmentSegments,ref _shpTotal); private long _shpTotal;
 private string DonutCore(List<(string Label,long Count,string Color)> segs,ref long store){long total=segs.Sum(x=>x.Count);store=total;if(total==0)return "background:conic-gradient(#e2e0ee 0turn 1turn)";double acc=0;var parts=new List<string>();foreach(var seg in segs){if(seg.Count<=0)continue;double from=acc/(double)total,to=(acc+seg.Count)/(double)total;parts.Add($"{seg.Color} {from:0.####}turn {to:0.####}turn");acc+=seg.Count;}if(parts.Count==0)return "background:conic-gradient(#e2e0ee 0turn 1turn)";return $"background:conic-gradient({string.Join(',',parts)})";}
 private void OpenChart(string kind,string title){ChartKind=kind;ChartTitle=title;ChartOpen=true;}
 private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out Guid c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
 private async Task Load(){if(await Session() is not (string token,Guid company))return;Busy=true;await InvokeAsync(StateHasChanged);try{
  string pq=$"api/v1/logistics/packages?page={PackagePage}&pageSize={PageSize}"+(string.IsNullOrWhiteSpace(PackageStatusFilter)?"":$"&status={PackageStatusFilter}");
  var pr=await Core.GetAsync(pq,token,company,default);PackageRows.Clear();PackageTotal=0;if(pr.IsSuccess&&pr.Value.TryGetProperty("items",out var pi)&&pi.ValueKind==JsonValueKind.Array){PackageRows=pi.EnumerateArray().Select(ParsePackage).ToList();PackageTotal=pr.Value.TryGetProperty("total",out var pt)?pt.GetInt64():PackageRows.Count;}
  string sq=$"api/v1/logistics/shipments?page={ShipmentPage}&pageSize={PageSize}"+(string.IsNullOrWhiteSpace(ShipmentStatusFilter)?"":$"&status={ShipmentStatusFilter}");
  var sr=await Core.GetAsync(sq,token,company,default);ShipmentRows.Clear();ShipmentTotal=0;if(sr.IsSuccess&&sr.Value.TryGetProperty("items",out var si)&&si.ValueKind==JsonValueKind.Array){ShipmentRows=si.EnumerateArray().Select(ParseShipment).ToList();ShipmentTotal=sr.Value.TryGetProperty("total",out var stt)?stt.GetInt64():ShipmentRows.Count;}
  await LoadCounts(token,company);
 }finally{Busy=false;await InvokeAsync(StateHasChanged);}}
 private async Task LoadCounts(string token,Guid company){DraftPackages=AtWarehousePackages=InTransitShipments=DeliveredShipments=ProblemShipments=0;PackageCounts=new();ShipmentCounts=new();
  foreach(string st in new[]{"Draft","Completed","AtShippingWarehouse","ReleasedToShipment"}){var r=await Core.GetAsync($"api/v1/logistics/packages?status={st}&page=1&pageSize=1",token,company,default);long n=r.IsSuccess&&r.Value.TryGetProperty("total",out var t)?t.GetInt64():0;PackageCounts[st]=n;if(st=="Draft")DraftPackages=(int)n;if(st=="AtShippingWarehouse")AtWarehousePackages=(int)n;}
  foreach(string st in new[]{"Ready","Shipped","InTransit","Delivered","FailedDelivery","Returned"}){var r=await Core.GetAsync($"api/v1/logistics/shipments?status={st}&page=1&pageSize=1",token,company,default);long n=r.IsSuccess&&r.Value.TryGetProperty("total",out var t)?t.GetInt64():0;ShipmentCounts[st]=n;if(st=="Shipped"||st=="InTransit")InTransitShipments+=(int)n;if(st=="Delivered")DeliveredShipments=(int)n;if(st=="FailedDelivery"||st=="Returned")ProblemShipments+=(int)n;}
  PackageStatusTotal=PackageCounts.Values.Sum();ShipmentStatusTotal=ShipmentCounts.Values.Sum();}
