 private async Task SubmitDialog(){if(await Session() is not (string token,Guid company))return;ActionError="";Busy=true;await InvokeAsync(StateHasChanged);try{ApiResult<JsonElement> r;switch(DialogKind){
  case "newPackage":{if(!Guid.TryParse(FormOrder,out Guid order)){ActionError=T("انتخاب سفارش الزامی است.","Select an order.","اختيار الطلب إلزامي.");return;}if(string.IsNullOrWhiteSpace(FormPackageType)){ActionError=T("نوع بسته الزامی است.","Package type is required.","نوع الطرد إلزامي.");return;}if(FormWeight<=0||FormLength<=0||FormWidth<=0||FormHeight<=0){ActionError=T("وزن و ابعاد باید مثبت باشند.","Weight and dims must be positive.","يجب أن تكون الوزن والأبعاد موجبة.");return;}r=await Core.SendAsync(HttpMethod.Post,"api/v1/logistics/packages",new{orderId=order,packageTypeCode=FormPackageType,weightKg=FormWeight,lengthCm=FormLength,widthCm=FormWidth,heightCm=FormHeight},token,company,default);break;}
