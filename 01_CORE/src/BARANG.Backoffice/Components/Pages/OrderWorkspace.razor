@page "/workspace/orders"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Text.Json
@using System.Globalization
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<EffectiveStatusStrings> E
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates
@inject NavigationManager Navigation
<PageTitle>@L["Module_orders"]</PageTitle>
<header class="crud-header"><div><span class="eyebrow">@L["OperationalWorkspace"]</span><h1>@L["Module_orders"]</h1><p>@L["AuthoritativeCoreData"]</p></div><a class="btn btn-primary" href="/orders/new"><BarangIcon Name="plus" /> @L["NewOrder"]</a></header>
<section class="crud-card" data-orders-grid><div class="crud-toolbar"><label class="crud-search"><BarangIcon Name="search" /><span class="visually-hidden">@L["Search"]</span><input value="@Search" @oninput="SearchChanged" placeholder="@L["SearchPlaceholder"]" aria-label="@L["Search"]" /></label><label class="compact-filter"><span>@L["Status"]</span><select @bind="Status" @bind:after="StatusChanged"><option value="">@L["All"]</option><option value="Draft">@L["StatusDraft"]</option><option value="Submitted">@L["StatusSubmitted"]</option><option value="Cancelled">@L["StatusCancelled"]</option></select></label><button type="button" class="btn btn-secondary" @onclick="ResetGrid"><BarangIcon Name="reset" /> @L["Reset"]</button></div>@if(Loading){<BarangLoadingState Text="@L["Loading"]" />}else if(Rows.Count==0){<CrudEmptyState Title="@L["NoRecords"]" Description="@L["NoRecordsDescription"]" />}else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@L["OrderNumber"]</th><th>@L["OrderDate"]</th><th>@L["Customer"]</th><th>@L["OrderSource"]</th><th>@L["Status"]</th><th class="actions-column">@L["Actions"]</th></tr></thead><tbody>@foreach(var row in Rows){<tr><td dir="ltr"><span class="code-pill">@(row.Number.Length==0?"—":row.Number)</span></td><td>@DateLabel(row.Date)</td><td>@row.Customer</td><td>@SourceLabel(row.Source)</td><td><span class="status-pill">@StatusLabel(row)</span></td><td class="row-actions"><BarangIconButton Icon="eye" Semantic="info" Label="@L["Order360"]" Clicked="@(()=>Navigation.NavigateTo($"/orders/{row.Id}/360"))" />@if(row.LifecycleStatus.Equals("Draft",StringComparison.OrdinalIgnoreCase)){<BarangIconButton Icon="edit" Semantic="edit" Label="@L["Edit"]" Clicked="@(()=>Navigation.NavigateTo($"/orders/{row.Id}/edit"))" /><BarangIconButton Icon="send" Semantic="success" Label="@L["Action_Submit"]" Clicked="@(()=>Submit(row))" />}@if(row.LifecycleStatus.Equals("Draft",StringComparison.OrdinalIgnoreCase)||row.LifecycleStatus.Equals("Submitted",StringComparison.OrdinalIgnoreCase)){<BarangIconButton Icon="close" Semantic="warning" Label="@L["Action_Cancel"]" Clicked="@(()=>Cancel(row))" />}</td></tr>}</tbody></table></div><BarangPagination Page="@Page" HasNext="@(Page*PageSize<Total)" Disabled="@Loading" PageLabel="@L["Page"]" PreviousText="@L["Previous"]" NextText="@L["Next"]" Previous="@PreviousPage" Next="@NextPage" />}</section>
@code { private const int PageSize=20;private string Search="",Status="";private int Page=1;private long Total;private bool Loading;private List<Row> Rows=[];private CancellationTokenSource? SearchCancellation;private int LoadGeneration;protected override async Task OnInitializedAsync()=>await Load();private async Task SearchChanged(ChangeEventArgs a){Search=a.Value?.ToString()??"";SearchCancellation?.Cancel();SearchCancellation?.Dispose();SearchCancellation=new();try{await Task.Delay(300,SearchCancellation.Token);Page=1;await Load(SearchCancellation.Token);}catch(OperationCanceledException){}}private async Task Load(CancellationToken ct=default){int g=++LoadGeneration;Loading=true;var s=await Session();if(s is null){Loading=false;return;}string q=$"api/v1/orders?page={Page}&pageSize={PageSize}&customerSearch={Uri.EscapeDataString(Search)}&orderNumber={Uri.EscapeDataString(Search)}"+(string.IsNullOrWhiteSpace(Status)?"":$"&status={Uri.EscapeDataString(Status)}");var r=await Core.GetAsync(q,s.Value.Token,s.Value.Company,ct);if(g!=LoadGeneration)return;if(r.IsSuccess){Total=r.Value.TryGetProperty("totalCount",out var t)?t.GetInt64():0;Rows=r.Value.TryGetProperty("items",out var a)&&a.ValueKind==JsonValueKind.Array?a.EnumerateArray().Select(Parse).ToList():[];}Loading=false;}private async Task StatusChanged(){Page=1;await Load();}private async Task ResetGrid(){Search="";Status="";Page=1;await Load();}private async Task PreviousPage(){if(Page>1){Page--;await Load();}}private async Task NextPage(){if(Page*PageSize<Total){Page++;await Load();}}private async Task Submit(Row row){var s=await Session();if(s is null)return;if((await Core.SendAsync(HttpMethod.Post,$"api/v1/orders/{row.Id}/submit",new{version=row.Version},s.Value.Token,s.Value.Company,default)).IsSuccess)await Load();}private async Task Cancel(Row row){var s=await Session();if(s is null)return;if((await Core.SendAsync(HttpMethod.Post,$"api/v1/orders/{row.Id}/cancel",new{reasonCode="BACKOFFICE",reasonText=(string?)null,version=row.Version},s.Value.Token,s.Value.Company,default)).IsSuccess)await Load();}private string DateLabel(string v)=>Dates.TryParseCanonical(v,out var d)?Dates.Format(d,System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName):v;private string StatusLabel(Row row){if(row.WorkflowStatusCode=="WorkflowCompleted")return E["WorkflowCompleted"].Value;if(row.WorkflowStatusCode=="InWorkflow"&&row.Stages.Length>0){var lang=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;var titles=row.Stages.Select(x=>x.ValueKind==JsonValueKind.Object&&x.TryGetProperty(lang,out var t)?t.ToString():x.ToString());return string.Join(" / ",titles.Select(x=>$"{E["InCartable"].Value} {x}"));}return string.IsNullOrWhiteSpace(row.LifecycleStatus)?"—":L[$"Status{row.LifecycleStatus}"];}private string SourceLabel(string s)=>string.IsNullOrWhiteSpace(s)?"—":L[$"Source{s}"];private static Row Parse(JsonElement x){var stages=x.TryGetProperty("workflowStages",out var s)&&s.ValueKind==JsonValueKind.Array?s.EnumerateArray().Select(v=>v.TryGetProperty("titleFa",out var f)?(JsonElement)JsonDocument.Parse($"{{\"fa\":{JsonSerializer.Serialize(f.ToString())},\"en\":{JsonSerializer.Serialize(v.TryGetProperty("titleEn",out var e)?e.ToString():f.ToString())},\"ar\":{JsonSerializer.Serialize(v.TryGetProperty("titleAr",out var a)?a.ToString():f.ToString())}}}").RootElement.Clone():v).ToArray():[];return new(x.GetProperty("id").GetGuid(),Text(x,"orderNumber"),Text(x,"customerName"),Text(x,"orderDate"),Text(x,"status"),Text(x,"source"),Text(x,"workflowStatusCode"),stages,x.TryGetProperty("version",out var ver)&&ver.TryGetInt64(out var n)?n:0);}private static string Text(JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=JsonValueKind.Null?p.ToString():"";private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private sealed record Row(Guid Id,string Number,string Customer,string Date,string LifecycleStatus,string Source,string WorkflowStatusCode,JsonElement[] Stages,long Version);}
