@page "/master/lookups"
@page "/master/print-technologies"
@page "/master/packaging-types"
@page "/master/shipping-methods"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<CrudStrings> T
@inject IStringLocalizer<ClassificationStrings> X
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@DisplayTitle · BARANG</PageTitle><nav class="breadcrumbs"><span>@L["Module_master-data"]</span><span>/</span><span>@DisplayTitle</span></nav><header class="crud-header"><div><h1>@DisplayTitle</h1><p>@L["AuthoritativeCoreData"]</p></div><button type="button" class="btn btn-primary" @onclick="Add"><BarangIcon Name="plus" /> @T["Add"]</button></header>
@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@T[Message]</div>}
<div class="@(IsClassification?"detail-stack":"management-grid")"><section class="crud-card"><div class="crud-toolbar"><label class="search-box"><BarangIcon Name="search" /><input @bind="Search" @bind:event="oninput" placeholder="@T["SearchHint"]"/></label><button type="button" class="btn btn-secondary" @onclick="Reload"><BarangIcon Name="refresh" /> @T["Refresh"]</button></div>
@if(Loading){<BarangLoadingState Text="@T["Loading"]" />}else if(IsClassification){@ValuesGrid()}else if(!FilteredTypes.Any()){<CrudEmptyState/>}else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T["Code"]</th><th>@T["Name"]</th><th>@T["Status"]</th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(var x in FilteredTypes){<tr class="@(TypeId==x.Id?"selected-row":"")"><td><span class="code-pill">@x.Code</span></td><td>@x.Name</td><td><StatusBadge Active="x.Active"/></td><td><div class="row-actions"><BarangIconButton Icon="eye" Label="@T["View"]" Semantic="info" Clicked="()=>SelectType(x)" /><BarangIconButton Icon="edit" Label="@T["Edit"]" Semantic="edit" Clicked="()=>EditType(x)" /><BarangIconButton Icon="power" Label="@(x.Active?T["Deactivate"]:T["Activate"])" Semantic="@(x.Active?"warning":"success")" Clicked="()=>ToggleType(x)" /></div></td></tr>}</tbody></table></div>}</section>
@if(!IsClassification){<section class="crud-card"><header class="section-header"><h2>@T["Details"]</h2>@if(TypeId is not null){<button type="button" class="btn btn-primary btn-small" @onclick="NewValue"><BarangIcon Name="plus" /> @T["Add"]</button>}</header>@ValuesGrid()</section>}</div>
@if(Dialog){<div class="dialog-backdrop" @onclick="Close"><section class="crud-dialog" role="dialog" aria-modal="true" aria-label="@(EditingType?Title:T["Details"])" @onclick:stopPropagation><header><h2>@(EditingType?Title:T["Details"])</h2><button type="button" class="dialog-close" title="@T["Close"]" aria-label="@T["Close"]" @onclick="Close"><BarangIcon Name="close" /></button></header><div class="form-grid">@if(EditingType){<label><span>@T["Code"]</span><input @bind="TypeCode" disabled="@(TypeId is not null||IsClassification)"/></label><label><span>@T["Name"]</span><input @bind="TypeName"/></label>}else{<label><span>@T["Code"]</span><input @bind="ValueCode" disabled="@(ValueId is not null)"/></label><label><span>@T["DisplayName"] (fa)</span><input dir="rtl" @bind="Fa"/></label><label><span>@T["DisplayName"] (en)</span><input dir="ltr" @bind="En"/></label><label><span>@T["DisplayName"] (ar)</span><input dir="rtl" @bind="Ar"/></label><label><span>@L["DisplayOrder"]</span><input type="number" @bind="Order"/></label>}</div><footer><button type="button" class="btn btn-secondary" @onclick="Close">@T["Cancel"]</button><button type="button" class="btn btn-primary" @onclick="Save">@T["Save"]</button></footer></section></div>}
@code{
 private string DisplayTitle=>FixedCode switch{"print.method"=>X["PrintTechnologies"],"packaging.type"=>X["PackagingTypes"],"shipping.method"=>X["ShippingMethods"],_=>L["Lookups"]};
 private Guid?TypeId,ValueId;private long TypeVersion,ValueVersion;private bool TypeActive=true,ValueActive=true,Success,Loading,Dialog,EditingType;private string TypeCode="",TypeName="",ValueCode="",Fa="",En="",Ar="",Search="";private int Order;private string?Message;private List<TypeRow>Types=[];private List<ValueRow>Values=[];private string Path=>new Uri(Nav.Uri).AbsolutePath;private string?FixedCode=>Path.EndsWith("print-technologies")?"print.method":Path.EndsWith("packaging-types")?"packaging.type":Path.EndsWith("shipping-methods")?"shipping.method":null;private bool IsClassification=>FixedCode is not null;private string Title=>DisplayTitle;private IEnumerable<TypeRow>FilteredTypes=>Types.Where(x=>Search.Length==0||(x.Code+x.Name).Contains(Search,StringComparison.CurrentCultureIgnoreCase));private IEnumerable<ValueRow>FilteredValues=>Values.Where(x=>Search.Length==0||(x.Code+x.Fa+x.En+x.Ar).Contains(Search,StringComparison.CurrentCultureIgnoreCase));
 protected override Task OnInitializedAsync()=>Reload();private RenderFragment ValuesGrid()=>@<text>@if(TypeId is null){<CrudEmptyState Title="@T["NoRecords"]" Description="@T["NoRecordsHelp"]"/>}else if(!FilteredValues.Any()){<CrudEmptyState/>}else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T["Code"]</th><th>fa</th><th>en</th><th>ar</th><th>@T["Status"]</th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(var x in FilteredValues){<tr><td><span class="code-pill">@x.Code</span></td><td dir="rtl">@x.Fa</td><td dir="ltr">@x.En</td><td dir="rtl">@x.Ar</td><td><StatusBadge Active="x.Active"/></td><td><div class="row-actions"><BarangIconButton Icon="eye" Label="@T["View"]" Semantic="info" Clicked="()=>ViewValue(x)" /><BarangIconButton Icon="edit" Label="@T["Edit"]" Semantic="edit" Clicked="()=>EditValue(x)" /><BarangIconButton Icon="power" Label="@(x.Active?T["Deactivate"]:T["Activate"])" Semantic="@(x.Active?"warning":"success")" Clicked="()=>ToggleValue(x)" /></div></td></tr>}</tbody></table></div>}</text>;
 private void Add(){if(TypeId is null)NewType();else NewValue();}private void NewType(){TypeId=null;TypeVersion=0;TypeCode=FixedCode??"";TypeName="";EditingType=Dialog=true;}private async Task EditType(TypeRow x){await SelectType(x);EditingType=Dialog=true;}private async Task SelectType(TypeRow x){TypeId=x.Id;TypeVersion=x.Version;TypeActive=x.Active;TypeCode=x.Code;TypeName=x.Name;await LoadValues();}private void NewValue(){ValueId=null;ValueVersion=0;ValueCode=Fa=En=Ar="";Order=0;EditingType=false;Dialog=true;}private void EditValue(ValueRow x){PickValue(x);EditingType=false;Dialog=true;}private void ViewValue(ValueRow x){PickValue(x);EditingType=false;Dialog=true;}private void PickValue(ValueRow x){ValueId=x.Id;ValueVersion=x.Version;ValueActive=x.Active;ValueCode=x.Code;Fa=x.Fa;En=x.En;Ar=x.Ar;Order=x.Order;}private void Close()=>Dialog=false;
 private async Task Reload(){Loading=true;Types=[];var s=await Session();if(s is not null){var r=await Core.GetAsync("api/v1/lookups/types",s.Value.Token,s.Value.Company,default);if(r.IsSuccess)Types=r.Value.EnumerateArray().Select(x=>new TypeRow(x.GetProperty("id").GetGuid(),G(x,"code"),G(x,"displayName"),B(x,"isActive"),N(x,"version"))).ToList();else Show(r);if(FixedCode is string code&&Types.FirstOrDefault(x=>x.Code==code) is TypeRow fixedType)await SelectType(fixedType);}Loading=false;}
 private Task Save()=>EditingType?SaveType():SaveValue();private async Task SaveType(){var s=await Session();if(s is null)return;object body=TypeId is null?new{code=TypeCode,displayName=TypeName,allowCustomValues=false}:new{displayName=TypeName,allowCustomValues=false,version=TypeVersion};var r=await Core.SendAsync(TypeId is null?HttpMethod.Post:HttpMethod.Put,"api/v1/lookups/types"+(TypeId is Guid id?$"/{id}":""),body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){Dialog=false;await Reload();}}
 private async Task ToggleType(TypeRow x){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/lookups/types/{x.Id}/activation",new{isActive=!x.Active,version=x.Version},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Reload();}
 private async Task LoadValues(){Values=[];var s=await Session();if(s is null||TypeCode.Length==0)return;var r=await Core.GetAsync($"api/v1/lookups/types/{TypeCode}/values",s.Value.Token,s.Value.Company,default);if(r.IsSuccess)foreach(var x in r.Value.EnumerateArray()){var t=x.TryGetProperty("translations",out var ts)?ts:default;Values.Add(new(x.GetProperty("id").GetGuid(),G(x,"code"),Translation(t,"fa"),Translation(t,"en"),Translation(t,"ar"),B(x,"isActive"),N(x,"version"),I(x,"displayOrder")));}else Show(r);}
 private async Task SaveValue(){var s=await Session();if(s is null||TypeCode.Length==0)return;ApiResult<System.Text.Json.JsonElement>r;if(ValueId is null)r=await Core.SendAsync(HttpMethod.Post,$"api/v1/lookups/types/{TypeCode}/values",new{code=ValueCode,displayOrder=Order,translations=new Dictionary<string,string>{{"fa",Fa},{"en",En},{"ar",Ar}}},s.Value.Token,s.Value.Company,default);else{r=await Core.SendAsync(HttpMethod.Put,$"api/v1/lookups/values/{ValueId}",new{displayOrder=Order,version=ValueVersion},s.Value.Token,s.Value.Company,default);if(r.IsSuccess)foreach(var pair in new[]{("fa",Fa),("en",En),("ar",Ar)}){var current=await Core.GetAsync($"api/v1/lookups/values/{ValueId}",s.Value.Token,s.Value.Company,default);var version=current.IsSuccess?N(current.Value,"version"):ValueVersion;r=await Core.SendAsync(HttpMethod.Put,$"api/v1/lookups/values/{ValueId}/translations/{pair.Item1}",new{displayName=pair.Item2,description=(string?)null,version},s.Value.Token,s.Value.Company,default);if(!r.IsSuccess)break;}}Show(r);if(r.IsSuccess){Dialog=false;await LoadValues();}}
 private async Task ToggleValue(ValueRow x){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/lookups/values/{x.Id}/activation",new{isActive=!x.Active,version=x.Version},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await LoadValues();}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Forbidden=>"Forbidden",ApiFailure.Conflict=>"ConcurrencyConflict",_=>"ValidationError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private static bool B(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.GetBoolean();private static long N(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.GetInt64():0;private static int I(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.GetInt32():0;private static string Translation(System.Text.Json.JsonElement x,string c){if(x.ValueKind==System.Text.Json.JsonValueKind.Array)foreach(var t in x.EnumerateArray())if(G(t,"culture")==c)return G(t,"displayName");return "";}private sealed record TypeRow(Guid Id,string Code,string Name,bool Active,long Version);private sealed record ValueRow(Guid Id,string Code,string Fa,string En,string Ar,bool Active,long Version,int Order);
}
