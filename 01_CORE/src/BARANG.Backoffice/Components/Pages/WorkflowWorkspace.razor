  private static int? OperatorNumber(JsonElement value) => value.ValueKind == JsonValueKind.Number ? value.GetInt32() : value.ValueKind == JsonValueKind.String ? value.GetString() switch { "Equal" => 0, "NotEqual" => 1, "GreaterThan" => 2, "GreaterThanOrEqual" => 3, "LessThan" => 4, "LessThanOrEqual" => 5, "IsTrue" => 6, "IsFalse" => 7, _ => null } : null;
  private static VersionModel ParseVersion(JsonElement x) => new() { Id = x.GetProperty("id").GetGuid(), Number = x.GetProperty("number").GetInt32(), Status = x.GetProperty("status").GetString() ?? "", Created = x.GetProperty("createdAtUtc").GetDateTimeOffset(), ReadOnly = x.GetProperty("isReadOnly").GetBoolean() };
  private static VersionModel ParseHistory(JsonElement x) => new() { Id = x.GetProperty("id").GetGuid(), Number = x.GetProperty("number").GetInt32(), Status = x.GetProperty("status").GetString() ?? "", Created = x.GetProperty("createdAtUtc").GetDateTimeOffset(), ReadOnly = true };
  private static string Txt(JsonElement root, string parent, string key) => root.TryGetProperty(parent, out JsonElement container) && container.ValueKind == JsonValueKind.Object && container.TryGetProperty(key, out JsonElement value) && value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : "";
