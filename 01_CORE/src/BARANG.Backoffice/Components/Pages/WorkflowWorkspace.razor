@page "/workspace/workflow"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Text.Json
@using System.Net.Http.Json
@using BARANG.Backoffice.Localization
@inject IStringLocalizer<WorkflowDesignerStrings> D
@inject IStringLocalizer<WorkflowInteractionStrings> I
@inject IStringLocalizer<WorkflowUiStrings> U
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject LocaleDateService Dates

<PageTitle>@D["Designer"]</PageTitle>
<div class="workflow-designer-page">
<header class="workflow-toolbar">
  <div><h1>@D["Designer"]</h1><small>@D["Version"] @Current.Number · @Status(Current.Status) @if (IsDirty) { <span class="workflow-dirty-indicator" aria-hidden="true">•</span> }</small></div>
  <div class="workflow-toolbar-actions">
    @if (ReadOnly) { <BarangButton Variant="secondary" Icon="edit" Text='@D["BeginEdit"]' Clicked="BeginEditClick" /> }
    else { <BarangButton Variant="primary" Icon="save" Text='@D["SaveDraft"]' Busy="@Saving" BusyText='@D["SaveDraft"]' Disabled="@ReadOnly" Clicked="SaveClick" /> }
    <BarangButton Variant="secondary" Icon="check" Text='@D["Validate"]' Busy="@Validating" BusyText='@D["Validate"]' Disabled="@(Saving || Validating)" Clicked="@(async _ => await Validate())" />
    @if (Current.Status == "Draft" && !ReadOnly) { <BarangButton Variant="primary" Icon="publish" Text='@D["Publish"]' Busy="@Publishing" BusyText='@D["Publish"]' Disabled="@(Saving || Validating || Publishing)" Clicked="PublishClick" /> }
    <BarangIconButton Icon="restore" Label='@I["Undo"]' Disabled="@(ReadOnly || UndoStack.Count == 0)" Clicked="UndoClick" />
    <BarangIconButton Icon="refresh" Label='@I["Redo"]' Disabled="@(ReadOnly || RedoStack.Count == 0)" Clicked="RedoClick" />
  </div>
</header>
@if (ReadOnly) { <div class="workflow-readonly"><span>@D["ReadOnly"]</span><BarangButton Variant="secondary" Icon="restore" Text='@D["BackToCurrent"]' Clicked="ReturnCurrentClick" /></div> }
@if (Message is not null) { <div class="inline-error" role="alert">@Message</div> }
<div class="workflow-designer-grid">
  <aside class="workflow-palette panel">
    <h2>@D["Palette"]</h2>
    <div class="palette-group">
      <button type="button" draggable="true" class="workflow-palette-item palette-start" aria-label="@D["Start"]" @ondragstart="e => StartPaletteDragHtml(0)" @ondragend="EndPaletteDragHtml" @onpointerdown="e => StartPaletteDrag(0,e)" @onpointerup="PalettePointerUp" @onclick="() => PaletteClick(0)"><span class="palette-shape" aria-hidden="true"></span><span>@D["Start"]</span></button>
      <button type="button" draggable="true" class="workflow-palette-item palette-end" aria-label="@D["End"]" @ondragstart="e => StartPaletteDragHtml(1)" @ondragend="EndPaletteDragHtml" @onpointerdown="e => StartPaletteDrag(1,e)" @onpointerup="PalettePointerUp" @onclick="() => PaletteClick(1)"><span class="palette-shape" aria-hidden="true"></span><span>@D["End"]</span></button>
      <button type="button" draggable="true" class="workflow-palette-item palette-task" aria-label="@D["UserTask"]" @ondragstart="e => StartPaletteDragHtml(2)" @ondragend="EndPaletteDragHtml" @onpointerdown="e => StartPaletteDrag(2,e)" @onpointerup="PalettePointerUp" @onclick="() => PaletteClick(2)"><span class="palette-shape" aria-hidden="true"><BarangIcon Name="workflow" /></span><span>@D["UserTask"]</span></button>
      <button type="button" draggable="true" class="workflow-palette-item palette-exclusive" aria-label="@D["ExclusiveGateway"]" @ondragstart="e => StartPaletteDragHtml(3)" @ondragend="EndPaletteDragHtml" @onpointerdown="e => StartPaletteDrag(3,e)" @onpointerup="PalettePointerUp" @onclick="() => PaletteClick(3)"><span class="palette-shape" aria-hidden="true">×</span><span>@D["ExclusiveGateway"]</span></button>
      <button type="button" draggable="true" class="workflow-palette-item palette-parallel" aria-label="@D["ParallelGateway"]" @ondragstart="e => StartPaletteDragHtml(4)" @ondragend="EndPaletteDragHtml" @onpointerdown="e => StartPaletteDrag(4,e)" @onpointerup="PalettePointerUp" @onclick="() => PaletteClick(4)"><span class="palette-shape" aria-hidden="true">+</span><span>@D["ParallelGateway"]</span></button>
    </div>
    <BarangButton Variant="@(ConnectMode ? "primary" : "secondary")" Icon="workflow" Text='@D["SequenceFlow"]' Disabled="@ReadOnly" Clicked="ToggleConnectClick" />
    @if (ConnectMode) { <small class="workflow-help">@D["ConnectHint"]</small> }
  </aside>
  <main class="workflow-canvas panel" aria-label="@D["Canvas"]">
    <div class="workflow-canvas-heading"><h2>@D["Canvas"]</h2><div class="workflow-canvas-tools"><BarangIconButton Icon="plus" Label='@D["Fit"]' Clicked="ZoomInClick" Disabled="@ReadOnly" /><span class="workflow-zoom-value">@($"{Zoom:P0}")</span><BarangIconButton Icon="minus" Label='@D["Fit"]' Clicked="ZoomOutClick" Disabled="@ReadOnly" /><BarangButton Variant="secondary" Icon="move" Text='@D["Fit"]' Disabled="@ReadOnly" Clicked="FitClick" /><BarangButton Variant="secondary" Icon="@EdgeStyleIcon" Text='@(OrthogonalEdges ? T("خط شکسته", "Elbow", "متعرجة") : T("خط مستقیم", "Straight", "مستقيمة"))' Disabled="@ReadOnly" Clicked="ToggleEdgeStyleClick" /><BarangButton Variant="secondary" Icon="grid" Text='@(SnapToGrid ? T("شبکه: روشن", "Grid: on", "الشبكة: مفعّلة") : T("شبکه: خاموش", "Grid: off", "الشبكة: متوقفة"))' Clicked="ToggleSnapClick" /><BarangButton Variant="secondary" Icon="magic" Text='@T("مرتب‌سازی خودکار", "Auto arrange", "ترتيب تلقائي")' Disabled="@ReadOnly" Clicked="AutoArrangeClick" /><BarangButton Variant="secondary" Icon="align" Text='@T("هم‌ترازی با شبکه", "Snap all", "محاذاة للشبكة")' Disabled="@ReadOnly" Clicked="SnapAllClick" /></div></div>
    <div class="workflow-canvas-viewport"><div class="workflow-canvas-surface @(PaletteDragType is not null ? "drop-active" : null)" tabindex="0" style="width:@($"{SurfaceWidth}px");height:@($"{SurfaceHeight}px")" @ondragover:preventDefault @ondragover="HandleDragOver" @ondrop="HandleDrop" @onpointermove="HandlePointerMove" @onpointerup="HandlePointerUp" @onpointerleave="HandlePointerLeave" @onclick="CanvasClicked" @onkeydown="HandleCanvasKeyDown">
      <svg class="workflow-connections" width="100%" height="100%" aria-hidden="true">
        <defs><marker id="workflow-arrow" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto"><path d="M0,0 L0,6 L7,3 z" /></marker></defs>
        @foreach (TransitionModel edge in Transitions)
        {
          <path class="@(SelectedEdge == edge ? "selected" : null)" d="@EdgePath(edge)" fill="none"
                 marker-end="url(#workflow-arrow)" @onclick="() => SelectEdge(edge)" @onclick:stopPropagation="true" />
          @if (SelectedEdge == edge && !ReadOnly)
          {
            <circle class="workflow-edge-anchor" cx="@(EdgeX(edge, true))" cy="@(EdgeY(edge, true))" r="7" @onpointerdown="e => StartEdgeAnchorDrag(edge, true, e)" @onpointerdown:stopPropagation="true" />
            <circle class="workflow-edge-anchor" cx="@(EdgeX(edge, false))" cy="@(EdgeY(edge, false))" r="7" @onpointerdown="e => StartEdgeAnchorDrag(edge, false, e)" @onpointerdown:stopPropagation="true" />
          }
        }
        @if (DragEdge is not null && SnapVisible) { <circle class="workflow-edge-snap" cx="@SnapX" cy="@SnapY" r="11" /> }
      </svg>
      @foreach (TransitionModel edge in Transitions.Where(x => !string.IsNullOrWhiteSpace(EdgeLabel(x)))) { <span class="workflow-edge-label" style="left:@($"{EdgeMidX(edge)}px");top:@($"{EdgeMidY(edge)}px")">@EdgeLabel(edge)</span> }
      @if (PaletteDragType is not null) { <div class="workflow-drop-ghost @NodeCss(PaletteDragType.Value)" style="left:@($"{DropX * Zoom}px");top:@($"{DropY * Zoom}px")"><span class="workflow-shape">@NodeIcon(PaletteDragType.Value)</span><span>@NodeType(PaletteDragType.Value)</span></div> }
      @if (Nodes.Count == 0) { <p class="empty-state">@D["NoNodes"]</p> }
      @foreach (NodeModel node in Nodes)
      {
        <button type="button" aria-label="@NodeTitle(node)" data-node-key="@node.Key" data-node-type="@NodeCss(node.Type)" class="workflow-node @NodeCss(node.Type) @(Selected == node ? "selected" : null) @(ConnectMode && ConnectSource == node ? "connect-source" : null) @(ConnectMode && IsValidTarget(ConnectSource, node) ? "connect-target" : null)" style="left:@($"{node.X * Zoom}px");top:@($"{node.Y * Zoom}px")" @onclick="() => NodeClicked(node)" @onclick:stopPropagation="true" @onpointerdown="e => StartDrag(node,e)" @onpointerdown:stopPropagation="true">
          <span class="workflow-connection-handle handle-in" title="@D["From"]" role="button" tabindex="0" @onclick="e => StartHandle(node)" @onclick:stopPropagation="true" @onpointerdown="e => StartHandle(node)" @onpointerdown:stopPropagation="true"></span><span class="workflow-connection-handle handle-out" title="@D["To"]" role="button" tabindex="0" @onclick="e => StartHandle(node)" @onclick:stopPropagation="true" @onpointerdown="e => StartHandle(node)" @onpointerdown:stopPropagation="true"></span>
          <span class="workflow-shape">@NodeIcon(node.Type)</span><span class="workflow-node-label">@NodeTitle(node)</span><small>@(node.Type == 2 ? PositionTitle(node.PositionId) : node.Key)</small>
        </button>
      }
    </div>
    </div>
  </main>
  <aside class="workflow-properties panel">
    <h2>@D["Properties"]</h2>
    @if (SelectedEdge is not null) { <h3>@D["Transition"]</h3><p>@SelectedEdge.FromKey → @SelectedEdge.ToKey</p><label><span>@D["TitleFa"]</span><input @bind="SelectedEdge.TitleFa" /></label><label><span>@D["TitleAr"]</span><input @bind="SelectedEdge.TitleAr" /></label><label><span>@D["TitleEn"]</span><input @bind="SelectedEdge.TitleEn" /></label>@if (IsExclusiveSource(SelectedEdge)) { <label><span>@I["Outcome"]</span><select @bind="SelectedEdge.OutcomeCode"><option value="">—</option><option value="Approve">@I["Approve"]</option><option value="Reject">@I["Reject"]</option><option value="AuditReject">@I["AuditReject"]</option></select></label><label><span>@D["ConditionField"]</span><select @bind="SelectedEdge.FieldCode"><option value="">—</option><option value="Order.Total">@D["OrderTotal"]</option><option value="Order.CustomerType">@D["CustomerType"]</option><option value="Order.Source">@D["OrderSource"]</option><option value="Order.ItemCount">@D["ItemCount"]</option><option value="Order.TotalQuantity">@D["TotalQuantity"]</option></select></label><label><span>@D["Operator"]</span><select @bind="SelectedEdge.Operator"><option value="">—</option>@foreach (int op in OperatorsFor(SelectedEdge.FieldCode)) { <option value="@op">@OperatorLabel(op)</option> }</select></label><label><span>@D["Value"]</span><input @bind="SelectedEdge.Value" /></label><label><span>@I["SourceAnchor"]</span><select @bind="SelectedEdge.SourceAnchor"><option value="Auto">@I["Auto"]</option>@foreach (string anchor in AnchorsFor(SelectedEdge, true)) { <option value="@anchor">@AnchorLabel(anchor)</option> }</select></label><label><span>@I["TargetAnchor"]</span><select @bind="SelectedEdge.TargetAnchor"><option value="Auto">@I["Auto"]</option>@foreach (string anchor in AnchorsFor(SelectedEdge, false)) { <option value="@anchor">@AnchorLabel(anchor)</option> }</select></label><label><input type="checkbox" @bind="SelectedEdge.IsDefault" /> @D["Default"]</label> }<BarangButton Variant="danger" Icon="trash" Text='@D["Delete"]' Disabled="@ReadOnly" Clicked="DeleteSelectedClick" /> }
    else if (Selected is null) { <p class="empty-state">@D["NoSelection"]</p> }
    else
    {
      <label><span>@D["NodeKey"]</span><input value="@Selected.Key" readonly /></label>
      <label><span>@D["NodeType"]</span><input value="@NodeType(Selected.Type)" readonly /></label>
      @if (Selected.Type == 2)
      {
        <label><span>@D["Position"]</span><select @bind="Selected.PositionId"><option value="">—</option>@foreach (PositionModel p in Positions) { <option value="@p.Id">@p.Title</option> }</select></label>
      }
      <label><span>@D["TitleFa"]</span><input @bind="Selected.TitleFa" /></label>
      <label><span>@D["TitleEn"]</span><input @bind="Selected.TitleEn" /></label>
      <label><span>@D["TitleAr"]</span><input @bind="Selected.TitleAr" /></label>
      <label><span>@D["Description"] (@D["TitleFa"])</span><textarea @bind="Selected.DescriptionFa"></textarea></label>
      <label><span>@D["Description"] (@D["TitleEn"])</span><textarea @bind="Selected.DescriptionEn"></textarea></label>
      <label><span>@D["Description"] (@D["TitleAr"])</span><textarea @bind="Selected.DescriptionAr"></textarea></label>
      <div class="workflow-coordinate-grid"><label>@D["CoordinateX"]<input type="number" @bind="Selected.X" /></label><label>@D["CoordinateY"]<input type="number" @bind="Selected.Y" /></label></div>
      <div class="workflow-selection-actions"><BarangButton Variant="secondary" Icon="copy" Text='@I["Duplicate"]' Disabled="@(ReadOnly || Selected.Type != 2)" Clicked="DuplicateSelectedClick" /><BarangButton Variant="danger" Icon="trash" Text='@D["Delete"]' Disabled="@ReadOnly" Clicked="DeleteSelectedClick" /></div>
    }
  </aside>
</div>
<section class="workflow-validation panel"><h2>@D["ValidationResults"]</h2>@if (Issues.Count == 0 && Validated && Message is null) { <p class="inline-success">@D["NoIssues"]</p> } @if (Message is not null && Validated) { <div class="workflow-issue">@Message</div> } @foreach (IssueModel issue in Issues) { <div class="workflow-issue">@ValidationText(issue) <small>@issue.NodeKey</small></div> }</section>
@if (PendingDelete is not null || PendingDeleteEdge is not null) { <div class="workflow-delete-confirm" role="alert"><span>@I["DeleteConfirmation"]</span><div><BarangButton Variant="secondary" Text='@I["Cancel"]' Clicked="CancelDeleteClick" /><BarangButton Variant="danger" Icon="trash" Text='@D["Delete"]' Clicked="ConfirmDeleteClick" /></div></div> }
<section class="workflow-history panel"><button type="button" class="workflow-history-toggle" aria-expanded="@HistoryOpen" @onclick="ToggleHistory"><span><BarangIcon Name="history" /> @D["History"]</span><span aria-hidden="true">@(HistoryOpen ? "−" : "+")</span></button>@if (HistoryOpen) { <div class="workflow-history-list">@foreach (VersionModel version in History) { <button type="button" class="workflow-history-row @(version.Id == Current.Id ? "selected" : null)" @onclick="() => OpenVersion(version.Id)"><span>@D["Version"] @version.Number</span><span>@Status(version.Status)</span><span>@Date(version.Created)</span></button> }</div> }</section>
</div>

@code {
  private TransitionModel? DragEdge; private bool DragEdgeSource; private decimal EdgeDragX; private decimal EdgeDragY; private bool OrthogonalEdges = true; private bool SnapToGrid = true; private bool SnapVisible; private decimal SnapX; private decimal SnapY; private const decimal GridSize = 20m;
  private string T(string fa, string en, string ar) => CurrentCulture switch { "en" => en, "ar" => ar, _ => fa };
  private string EdgeStyleIcon => OrthogonalEdges ? "workflow" : "route";
  private decimal Snap(decimal value) => SnapToGrid ? Math.Round(value / GridSize) * GridSize : value;
  private List<NodeModel> Nodes = []; private List<TransitionModel> Transitions = []; private List<PositionModel> Positions = []; private List<VersionModel> History = []; private VersionModel Current = new(); private NodeModel? Selected; private TransitionModel? SelectedEdge; private NodeModel? PendingDelete; private TransitionModel? PendingDeleteEdge; private string? Message; private bool Validated; private bool IsDirty; private List<IssueModel> Issues = []; private bool Editing; private bool HistoryOpen; private bool ConnectMode; private NodeModel? ConnectSource; private NodeModel? DragNode; private double DragStartX; private double DragStartY; private decimal DragNodeX; private decimal DragNodeY; private int? PaletteDragType; private bool PalettePointerMoved; private decimal DropX = 160; private decimal DropY = 120; private decimal Zoom = 1m; private bool Saving; private bool Validating; private bool Publishing; private readonly Stack<EditorSnapshot> UndoStack = []; private readonly Stack<EditorSnapshot> RedoStack = []; private bool ReadOnly => Current.ReadOnly && !Editing; private int SurfaceWidth => Math.Max(1400, (int)(Nodes.Count == 0 ? 0 : Nodes.Max(x => x.X) * Zoom) + 420); private int SurfaceHeight => Math.Max(900, (int)(Nodes.Count == 0 ? 0 : Nodes.Max(x => x.Y) * Zoom) + 300);
  [CascadingParameter(Name = "BarangCulture")] private string? Culture { get; set; }
  private string CurrentCulture => LocalePolicy.Resolve(Culture).Code;
  private string Date(DateTimeOffset value) => Dates.Format(value, CurrentCulture);
  protected override async Task OnInitializedAsync() { await Load(null); await LoadPositions(); }
  private async Task Load(Guid? versionId) { var s = await Session(); if (s is null) return; var r = await Core.GetAsync($"api/v1/workflows/definition{(versionId is null ? "" : $"?versionId={versionId}")}", s.Value.Token, s.Value.Company, default); if (!r.IsSuccess) { Message = D["LoadFailed"]; return; } JsonElement root = r.Value; Current = ParseVersion(root.GetProperty("current")); History = root.GetProperty("history").EnumerateArray().Select(ParseHistory).ToList(); Nodes = root.GetProperty("current").GetProperty("nodes").EnumerateArray().Select(ParseNode).ToList(); Transitions = root.GetProperty("current").GetProperty("transitions").EnumerateArray().Select(ParseTransition).ToList(); Selected = Nodes.FirstOrDefault(); SelectedEdge = null; Validated = false; IsDirty = false; Issues = []; UndoStack.Clear(); RedoStack.Clear(); }
  private async Task LoadPositions() { var s = await Session(); if (s is null) return; var r = await Core.GetAsync("api/v1/workflows/definition/positions?limit=100", s.Value.Token, s.Value.Company, default); if (r.IsSuccess) Positions = r.Value.EnumerateArray().Select(x => new PositionModel(x.GetProperty("id").GetGuid(), x.GetProperty("title").GetString() ?? x.GetProperty("code").GetString() ?? "")).ToList(); }
  private void Add(int type) => AddAt(type, 80 + Nodes.Count * 220, 100 + (Nodes.Count % 4) * 140);
  private void AddAt(int type, decimal x, decimal y) { if (ReadOnly) return; PushUndo(); string key = $"{TypeKey(type)}-{NextKeyNumber(type)}"; NodeModel node = new() { Key = key, Type = type, TitleFa = NodeType(type), TitleEn = NodeType(type), TitleAr = NodeType(type), X = Snap(Math.Max(0, x)), Y = Snap(Math.Max(0, y)) }; Nodes.Add(node); Selected = node; SelectedEdge = null; IsDirty = true; }
  private int NextKeyNumber(int type) { HashSet<int> used = Nodes.Select(x => x.Key).Where(x => x.StartsWith(TypeKey(type) + "-", StringComparison.OrdinalIgnoreCase)).Select(x => int.TryParse(x[(TypeKey(type).Length + 1)..], out int n) ? n : 0).ToHashSet(); int value = 1; while (used.Contains(value)) value++; return value; }
  private void PaletteClick(int type) { if (PalettePointerMoved) { PalettePointerMoved = false; return; } Add(type); }
  private void StartPaletteDrag(int type, PointerEventArgs _) { if (ReadOnly) return; PaletteDragType = type; PalettePointerMoved = false; }
  private void StartPaletteDragHtml(int type) { if (ReadOnly) return; PaletteDragType = type; PalettePointerMoved = true; }
  private void EndPaletteDragHtml(DragEventArgs _) { if (PaletteDragType is not null) PaletteDragType = null; }
  private void PalettePointerUp(PointerEventArgs _) { if (!PalettePointerMoved) PaletteDragType = null; }
  private void UpdateDropPoint(PointerEventArgs e) { DropX = Math.Max(0, (decimal)e.OffsetX / Zoom - 65); DropY = Math.Max(0, (decimal)e.OffsetY / Zoom - 35); }
  private void UpdateDropPoint(DragEventArgs e) { DropX = Math.Max(0, (decimal)e.OffsetX / Zoom - 65); DropY = Math.Max(0, (decimal)e.OffsetY / Zoom - 35); }
  private void HandleDragOver(DragEventArgs e) { if (PaletteDragType is not null) UpdateDropPoint(e); }
  private void HandleDrop(DragEventArgs e) { if (ReadOnly || PaletteDragType is not int paletteType) return; UpdateDropPoint(e); AddAt(paletteType, DropX, DropY); PaletteDragType = null; PalettePointerMoved = true; }
  private void HandlePointerMove(PointerEventArgs e) { if (PaletteDragType is int paletteType) { UpdateDropPoint(e); PalettePointerMoved = true; return; } if (DragEdge is not null) { decimal x = Math.Max(0, (decimal)e.OffsetX / Zoom), y = Math.Max(0, (decimal)e.OffsetY / Zoom); (NodeModel? snapNode, string snapAnchor, decimal distance) = NearestAnchor(x, y, DragEdgeSource); if (snapNode is not null && distance <= 110m) { SnapVisible = true; SnapX = AnchorPoint(snapNode, snapAnchor, true); SnapY = AnchorPoint(snapNode, snapAnchor, false); EdgeDragX = SnapX / Zoom; EdgeDragY = SnapY / Zoom; } else { SnapVisible = false; EdgeDragX = x; EdgeDragY = y; } return; } MoveDrag(e); }
  private void HandlePointerUp(PointerEventArgs e) { if (PaletteDragType is int paletteType) { UpdateDropPoint(e); if (PalettePointerMoved) AddAt(paletteType, DropX, DropY); PaletteDragType = null; PalettePointerMoved = true; return; } if (DragEdge is not null) { FinishEdgeAnchorDrag(e); return; } EndDrag(e); }
  private void HandlePointerLeave(PointerEventArgs e) { if (PaletteDragType is null && DragEdge is null) EndDrag(e); }
  private void CanvasClicked() { if (PaletteDragType is null && DragNode is null) { Selected = null; SelectedEdge = null; } }
  private void BeginEdit() { Editing = true; SelectedEdge = null; }
  private void BeginEditClick(MouseEventArgs _) => BeginEdit();
  private Task SaveClick(MouseEventArgs _) => Save();
  private Task ValidateClick(MouseEventArgs _) => Validate();
  private Task ReturnCurrentClick(MouseEventArgs _) => ReturnCurrent();
  private void ToggleConnectClick(MouseEventArgs _) => ToggleConnect();
  private void DeleteSelectedClick(MouseEventArgs _) => DeleteSelected();
  private void DuplicateSelectedClick(MouseEventArgs _) => DuplicateSelected();
  private void ConfirmDeleteClick(MouseEventArgs _) => ConfirmDelete();
  private void CancelDeleteClick(MouseEventArgs _) { PendingDelete = null; PendingDeleteEdge = null; }
  private void UndoClick(MouseEventArgs _) => Undo();
  private void RedoClick(MouseEventArgs _) => Redo();
  private void ZoomInClick(MouseEventArgs _) => ZoomBy(.1m);
  private void ZoomOutClick(MouseEventArgs _) => ZoomBy(-.1m);
  private void FitClick(MouseEventArgs _) => Fit();
  private void ToggleHistory(MouseEventArgs _) => HistoryOpen = !HistoryOpen;
  private void Select(NodeModel node) { Selected = node; SelectedEdge = null; }
  private void SelectEdge(TransitionModel edge) { if (ReadOnly) return; SelectedEdge = edge; Selected = null; }
  private void StartEdgeAnchorDrag(TransitionModel edge, bool source, PointerEventArgs e) { if (ReadOnly) return; PushUndo(); SelectedEdge = edge; Selected = null; DragEdge = edge; DragEdgeSource = source; EdgeDragX = EdgeX(edge, source) / Zoom; EdgeDragY = EdgeY(edge, source) / Zoom; }
  private void FinishEdgeAnchorDrag(PointerEventArgs e) { if (DragEdge is null) return; decimal x = EdgeDragX, y = EdgeDragY; (NodeModel? node, string anchor, decimal distance) = NearestAnchor(x, y, DragEdgeSource); if (node is not null && distance <= 110m) { if (DragEdgeSource) { DragEdge.FromKey = node.Key; DragEdge.SourceAnchor = anchor; } else { DragEdge.ToKey = node.Key; DragEdge.TargetAnchor = anchor; } IsDirty = true; } DragEdge = null; SnapVisible = false; }
  private (NodeModel? Node, string Anchor, decimal Distance) NearestAnchor(decimal x, decimal y, bool source) { NodeModel? bestNode = null; string bestAnchor = "Auto"; decimal best = decimal.MaxValue; foreach (NodeModel node in Nodes) { if (source && node.Type == 1 || !source && node.Type == 0) continue; foreach (string anchor in AnchorsForNode(node)) { decimal ax = AnchorPoint(node, anchor, true) / Zoom, ay = AnchorPoint(node, anchor, false) / Zoom; decimal distance = Math.Abs(ax - x) + Math.Abs(ay - y); if (distance < best) { best = distance; bestNode = node; bestAnchor = anchor; } } } return (bestNode, bestAnchor, best); }
  private static IEnumerable<string> AnchorsForNode(NodeModel node) => node.Type is 3 or 4 ? ["Top", "Right", "Bottom", "Left"] : node.Type == 2 ? ["TopCenter", "RightCenter", "BottomCenter", "LeftCenter"] : ["Top", "Right", "Bottom", "Left"];
  private void ToggleConnect() { if (ReadOnly) return; ConnectMode = !ConnectMode; ConnectSource = null; }
  private void NodeClicked(NodeModel node) { if (!ConnectMode) { Select(node); return; } if (ConnectSource is null) { ConnectSource = node; Select(node); return; } if (ConnectSource != node && node.Type != 0 && ConnectSource.Type != 1 && !Transitions.Any(x => x.FromKey == ConnectSource.Key && x.ToKey == node.Key)) { PushUndo(); TransitionModel edge = new() { FromKey = ConnectSource.Key, ToKey = node.Key, SortOrder = Transitions.Count, SourceAnchor = DefaultAnchor(ConnectSource), TargetAnchor = DefaultAnchor(node) }; Transitions.Add(edge); SelectedEdge = edge; Selected = null; IsDirty = true; } ConnectSource = null; ConnectMode = false; }
  private static string DefaultAnchor(NodeModel node) => node.Type switch { 3 or 4 => "Right", 0 => "Right", 1 => "Left", _ => "Auto" };
  private void StartHandle(NodeModel node) { if (ReadOnly) return; ConnectMode = true; ConnectSource = node; Select(node); }
  private void DeleteSelected() { if (ReadOnly) return; if (SelectedEdge is not null) { PendingDeleteEdge = SelectedEdge; PendingDelete = null; return; } if (Selected is not null) { PendingDelete = Selected; PendingDeleteEdge = null; } }
  private void ConfirmDelete() { if (ReadOnly) return; PushUndo(); if (PendingDeleteEdge is not null) Transitions.Remove(PendingDeleteEdge); if (PendingDelete is not null) { string key = PendingDelete.Key; Transitions.RemoveAll(x => x.FromKey == key || x.ToKey == key); Nodes.Remove(PendingDelete); } PendingDelete = null; PendingDeleteEdge = null; Selected = null; SelectedEdge = null; IsDirty = true; }
  private void DuplicateSelected() { if (ReadOnly || Selected is null || Selected.Type != 2) return; PushUndo(); NodeModel copy = CloneNode(Selected); copy.Id = Guid.Empty; copy.Key = $"task-{NextKeyNumber(2)}"; copy.X += 50; copy.Y += 50; Nodes.Add(copy); Selected = copy; SelectedEdge = null; IsDirty = true; }
  private void StartDrag(NodeModel node, PointerEventArgs e) { if (ReadOnly || ConnectMode) return; PushUndo(); DragNode = node; DragStartX = e.ClientX; DragStartY = e.ClientY; DragNodeX = node.X; DragNodeY = node.Y; Select(node); }
  private void MoveDrag(PointerEventArgs e) { if (DragNode is null || ReadOnly) return; DragNode.X = Snap(Math.Max(0, DragNodeX + (decimal)((e.ClientX - DragStartX) / (double)Zoom))); DragNode.Y = Snap(Math.Max(0, DragNodeY + (decimal)((e.ClientY - DragStartY) / (double)Zoom))); IsDirty = true; }
  private void PushUndo() { UndoStack.Push(Capture()); if (UndoStack.Count > 50) { var items = UndoStack.Take(50).ToArray(); UndoStack.Clear(); foreach (var item in items.Reverse()) UndoStack.Push(item); } RedoStack.Clear(); }
  private EditorSnapshot Capture() => new(Nodes.Select(CloneNode).ToList(), Transitions.Select(CloneTransition).ToList());
  private void Restore(EditorSnapshot snapshot) { Nodes = snapshot.Nodes.Select(CloneNode).ToList(); Transitions = snapshot.Transitions.Select(CloneTransition).ToList(); Selected = null; SelectedEdge = null; IsDirty = true; }
  private void Undo() { if (ReadOnly || UndoStack.Count == 0) return; RedoStack.Push(Capture()); Restore(UndoStack.Pop()); }
  private void Redo() { if (ReadOnly || RedoStack.Count == 0) return; UndoStack.Push(Capture()); Restore(RedoStack.Pop()); }
  private void EndDrag(PointerEventArgs _) { if (DragNode is not null) IsDirty = true; DragNode = null; }
  private void HandleCanvasKeyDown(KeyboardEventArgs e) { if (ReadOnly) return; if (e.Key is "Delete" or "Backspace") DeleteSelected(); else if (e.CtrlKey && e.Key.Equals("z", StringComparison.OrdinalIgnoreCase)) Undo(); else if (e.CtrlKey && e.Key.Equals("y", StringComparison.OrdinalIgnoreCase)) Redo(); else if (Selected is not null && e.Key.StartsWith("Arrow")) { decimal step = SnapToGrid ? GridSize : 5m; decimal dx = e.Key == "ArrowLeft" ? -step : e.Key == "ArrowRight" ? step : 0m; decimal dy = e.Key == "ArrowUp" ? -step : e.Key == "ArrowDown" ? step : 0m; if (dx != 0m || dy != 0m) { Selected.X = Math.Max(0, Selected.X + dx); Selected.Y = Math.Max(0, Selected.Y + dy); IsDirty = true; } } }
  private static NodeModel CloneNode(NodeModel source) => new() { Id = source.Id, Key = source.Key, Type = source.Type, TitleFa = source.TitleFa, TitleEn = source.TitleEn, TitleAr = source.TitleAr, DescriptionFa = source.DescriptionFa, DescriptionEn = source.DescriptionEn, DescriptionAr = source.DescriptionAr, PositionId = source.PositionId, X = source.X, Y = source.Y };
  private static TransitionModel CloneTransition(TransitionModel source) => new() { Id = source.Id, FromKey = source.FromKey, ToKey = source.ToKey, FieldCode = source.FieldCode, Operator = source.Operator, Value = source.Value, IsDefault = source.IsDefault, SortOrder = source.SortOrder, OutcomeCode = source.OutcomeCode, SourceAnchor = source.SourceAnchor, TargetAnchor = source.TargetAnchor, TitleFa = source.TitleFa, TitleEn = source.TitleEn, TitleAr = source.TitleAr };
  private void ZoomBy(decimal delta) => Zoom = Math.Clamp(Zoom + delta, .5m, 2m);
