  private static NodeModel ParseNode(JsonElement x) => new() { Id = x.GetProperty("id").GetGuid(), Key = x.GetProperty("key").GetString() ?? "", Type = TypeNumber(x.GetProperty("type")), PositionId = x.TryGetProperty("positionId", out var p) && p.ValueKind != JsonValueKind.Null ? p.GetGuid() : Guid.Empty, X = x.GetProperty("x").GetDecimal(), Y = x.GetProperty("y").GetDecimal(), TitleFa = Txt(x, "title", "fa"), TitleEn = Txt(x, "title", "en"), TitleAr = Txt(x, "title", "ar"), DescriptionFa = Txt(x, "description", "fa"), DescriptionEn = Txt(x, "description", "en"), DescriptionAr = Txt(x, "description", "ar") };
  private static TransitionModel ParseTransition(JsonElement x) => new() { Id = x.GetProperty("id").GetGuid(), FromKey = x.GetProperty("fromKey").GetString() ?? "", ToKey = x.GetProperty("toKey").GetString() ?? "", FieldCode = x.GetProperty("fieldCode").GetString() ?? "", Value = x.TryGetProperty("value", out var v) && v.ValueKind != JsonValueKind.Null ? v.ToString() : null, IsDefault = x.GetProperty("isDefault").GetBoolean(), SortOrder = x.GetProperty("sortOrder").GetInt32(), Operator = OperatorNumber(x.TryGetProperty("operator", out var o) && o.ValueKind != JsonValueKind.Null ? o : default), OutcomeCode = x.TryGetProperty("outcomeCode", out var oc) ? oc.GetString() ?? "" : "", SourceAnchor = x.TryGetProperty("sourceAnchor", out var sa) ? sa.GetString() ?? "Auto" : "Auto", TargetAnchor = x.TryGetProperty("targetAnchor", out var ta) ? ta.GetString() ?? "Auto" : "Auto", TitleFa = Txt(x, "title", "fa"), TitleEn = Txt(x, "title", "en"), TitleAr = Txt(x, "title", "ar") };
