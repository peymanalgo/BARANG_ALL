  private object BuildGraphPayload() => new { versionId = Current.Id, name = new { fa = "گردش کار سفارش بارنگ", en = "BARANG Order Workflow", ar = "سير عمل طلبات بارنگ" }, changeNote = new { fa = "", en = "", ar = "" }, nodes = Nodes.Select(x => new { key = x.Key, type = x.Type, title = new { fa = x.TitleFa, en = x.TitleEn, ar = x.TitleAr }, description = new { fa = x.DescriptionFa, en = x.DescriptionEn, ar = x.DescriptionAr }, positionId = x.PositionId == Guid.Empty ? (Guid?)null : x.PositionId, x = x.X, y = x.Y }), transitions = Transitions.Select(x => new { fromKey = x.FromKey, toKey = x.ToKey, fieldCode = x.FieldCode, @operator = x.Operator, value = x.Value, isDefault = x.IsDefault, sortOrder = x.SortOrder, outcomeCode = x.OutcomeCode, sourceAnchor = x.SourceAnchor, targetAnchor = x.TargetAnchor, title = new { fa = x.TitleFa, en = x.TitleEn, ar = x.TitleAr } }) };
  private string ServerError(string? code) => code switch { "workflow.definition.start_count" => D["ExactlyOneStart"], "workflow.definition.end_missing" => D["AtLeastOneEnd"], "workflow.definition.task_position_required" => D["TaskPositionRequired"], "workflow.definition.exclusive_default_required" => D["ExclusiveNeedsDefault"], "workflow.definition.exclusive_multiple_defaults" => D["OnlyOneDefault"], "workflow.definition.condition_invalid" => D["InvalidCondition"], "workflow.definition.cycle" => D["CyclesNotSupported"], "workflow.definition.parallel_split" => D["ParallelSplitNeedsBranches"], "workflow.definition.parallel_join" => D["ParallelJoinNeedsBranches"], "workflow.definition.parallel_join_outgoing" => D["ParallelJoinOneOutgoing"], "workflow.definition.node_outgoing_required" => D["NodeNeedsOutgoing"], _ => D["SaveFailed"] };
  private bool ValidateLocal()
  {
    Issues = [];
    List<NodeModel> starts = Nodes.Where(x => x.Type == 0).ToList();
    if (starts.Count != 1) Issues.Add(new("", "ExactlyOneStart"));
    if (!Nodes.Any(x => x.Type == 1)) Issues.Add(new("", "AtLeastOneEnd"));
    foreach (NodeModel node in Nodes)
    {
      int incoming = Transitions.Count(x => x.ToKey == node.Key), outgoing = Transitions.Count(x => x.FromKey == node.Key);
      if (node.Type == 0 && incoming > 0) Issues.Add(new(node.Key, "StartHasIncoming"));
      if (node.Type == 0 && outgoing == 0) Issues.Add(new(node.Key, "StartNeedsOutgoing"));
      if (node.Type == 1 && outgoing > 0) Issues.Add(new(node.Key, "EndHasOutgoing"));
      if (node.Type != 0 && node.Type != 1 && outgoing == 0) Issues.Add(new(node.Key, "NodeNeedsOutgoing"));
      if (node.Type == 2 && (node.PositionId is null || node.PositionId == Guid.Empty)) Issues.Add(new(node.Key, "TaskPositionRequired"));
    }
    foreach (TransitionModel edge in Transitions.Where(x => Nodes.All(n => n.Key != x.FromKey) || Nodes.All(n => n.Key != x.ToKey))) Issues.Add(new(edge.FromKey, "DanglingTransition"));
    Validated = true;
    return Issues.Count == 0;
  }
  private async Task Validate() { if (Validating || Saving) return; Validating = true; Message = null; Issues = []; try { var s = await Session(); if (s is null) { Message = D["LoadFailed"]; return; } var r = await Core.SendAsync(HttpMethod.Post, "api/v1/workflows/definition/validate", BuildGraphPayload(), s.Value.Token, s.Value.Company, default); if (r.IsSuccess) { JsonElement payload = r.Value; if (payload.ValueKind == JsonValueKind.Array) Issues = payload.EnumerateArray().Select(x => new IssueModel(x.TryGetProperty("nodeKey", out JsonElement nk) ? nk.GetString() ?? "" : "", x.TryGetProperty("messageKey", out JsonElement mk) ? mk.GetString() ?? "UnknownValidation" : "UnknownValidation")).ToList(); else if (payload.ValueKind == JsonValueKind.Object && payload.TryGetProperty("value", out JsonElement value) && value.ValueKind == JsonValueKind.Array) Issues = value.EnumerateArray().Select(x => new IssueModel(x.TryGetProperty("nodeKey", out JsonElement nk) ? nk.GetString() ?? "" : "", x.TryGetProperty("messageKey", out JsonElement mk) ? mk.GetString() ?? "UnknownValidation" : "UnknownValidation")).ToList(); else Message = D["LoadFailed"]; } else Message = ServerError(r.ProblemCode); Validated = true; } catch (Exception) { Message = D["LoadFailed"]; Validated = true; } finally { Validating = false; } }
