  private static int? OperatorNumber(JsonElement value) => value.ValueKind == JsonValueKind.Number ? value.GetInt32() : value.ValueKind == JsonValueKind.String ? value.GetString() switch { "Equal" => 0, "NotEqual" => 1, "GreaterThan" => 2, "GreaterThanOrEqual" => 3, "LessThan" => 4, "LessThanOrEqual" => 5, "IsTrue" => 6, "IsFalse" => 7, _ => null } : null;
  private static VersionModel ParseVersion(JsonElement x) => new() { Id = x.GetProperty("id").GetGuid(), Number = x.GetProperty("number").GetInt32(), Status = Scalar(x, "status"), Created = x.GetProperty("createdAtUtc").GetDateTimeOffset(), ReadOnly = x.GetProperty("isReadOnly").GetBoolean() };
