  private void SnapAllClick(MouseEventArgs _) { if (ReadOnly || Nodes.Count == 0) return; PushUndo(); foreach (NodeModel node in Nodes) { node.X = Snap(node.X); node.Y = Snap(node.Y); } IsDirty = true; }
  private bool IsValidTarget(NodeModel? source, NodeModel target) => source is not null && source.Key != target.Key && target.Type != 0 && source.Type != 1 && !Transitions.Any(x => x.FromKey == source.Key && x.ToKey == target.Key);
  private void AutoArrange()
  {
    if (ReadOnly || Nodes.Count == 0) return;
    PushUndo();
    NodeModel? start = Nodes.FirstOrDefault(x => x.Type == 0) ?? Nodes.First();
    Dictionary<string, int> layers = new() { [start.Key] = 0 };
    Queue<NodeModel> queue = new();
    queue.Enqueue(start);
    while (queue.Count > 0)
    {
      NodeModel current = queue.Dequeue();
      foreach (TransitionModel transition in Transitions.Where(x => x.FromKey == current.Key))
      {
        NodeModel? next = Nodes.FirstOrDefault(x => x.Key == transition.ToKey);
        if (next is null || layers.ContainsKey(next.Key)) continue;
        layers[next.Key] = layers[current.Key] + 1;
        queue.Enqueue(next);
      }
    }
    int fallback = layers.Values.DefaultIfEmpty(0).Max() + 1;
    foreach (NodeModel node in Nodes.Where(x => !layers.ContainsKey(x.Key))) layers[node.Key] = fallback;
    foreach (var column in layers.GroupBy(x => x.Value).OrderBy(x => x.Key))
    {
      int row = 0;
      foreach (string key in column.OrderBy(x => x).Select(x => x.Key))
      {
        NodeModel? node = Nodes.FirstOrDefault(x => x.Key == key);
        if (node is null) continue;
        node.X = Snap(80 + column.Key * 280);
        node.Y = Snap(80 + row++ * 160);
      }
    }
    IsDirty = true;
  }
  private void Fit() { if (Nodes.Count == 0) { Zoom = 1m; return; } decimal width = Math.Max(1m, Nodes.Max(x => x.X) - Nodes.Min(x => x.X) + 180m); decimal height = Math.Max(1m, Nodes.Max(x => x.Y) - Nodes.Min(x => x.Y) + 140m); decimal widthFit = 900m / width; decimal heightFit = 620m / height; Zoom = Math.Clamp(Math.Min(widthFit, heightFit), .5m, 2m); }
  private decimal CenterX(string key) { NodeModel? n = Nodes.FirstOrDefault(x => x.Key == key); return n is null ? 0 : (n.X + 70) * Zoom; }
  private decimal CenterY(string key) { NodeModel? n = Nodes.FirstOrDefault(x => x.Key == key); return n is null ? 0 : (n.Y + 32) * Zoom; }
  private decimal EdgeX(TransitionModel edge, bool source) => DragEdge == edge && DragEdgeSource == source ? EdgeDragX * Zoom : AnchorPoint(Nodes.FirstOrDefault(x => x.Key == (source ? edge.FromKey : edge.ToKey)), source ? edge.SourceAnchor : edge.TargetAnchor, true);
  private decimal EdgeY(TransitionModel edge, bool source) => DragEdge == edge && DragEdgeSource == source ? EdgeDragY * Zoom : AnchorPoint(Nodes.FirstOrDefault(x => x.Key == (source ? edge.FromKey : edge.ToKey)), source ? edge.SourceAnchor : edge.TargetAnchor, false);
  private decimal AnchorPoint(NodeModel? node, string anchor, bool xAxis) { if (node is null) return 0; decimal w = node.Type is 0 or 1 ? 48 : node.Type is 3 or 4 ? 62 : 142; decimal h = node.Type is 0 or 1 ? 48 : node.Type is 3 or 4 ? 62 : 70; decimal x = node.X + w / 2m, y = node.Y + h / 2m; return (anchor, xAxis) switch { ("Top", true) => x, ("Top", false) => node.Y, ("TopCenter", true) => x, ("TopCenter", false) => node.Y, ("Right", true) => node.X + w, ("Right", false) => y, ("RightCenter", true) => node.X + w, ("RightCenter", false) => y, ("Bottom", true) => x, ("Bottom", false) => node.Y + h, ("BottomCenter", true) => x, ("BottomCenter", false) => node.Y + h, ("Left", true) => node.X, ("Left", false) => y, ("LeftCenter", true) => node.X, ("LeftCenter", false) => y, _ => xAxis ? x : y } * Zoom; }
  private decimal EdgeMidX(TransitionModel edge) { var pts = EdgePoints(edge); int mid = pts.Length / 2 - 1; return (pts[mid].X + pts[mid + 1].X) / 2m; }
  private decimal EdgeMidY(TransitionModel edge) { var pts = EdgePoints(edge); int mid = pts.Length / 2 - 1; return (pts[mid].Y + pts[mid + 1].Y) / 2m - 5m; }
  private (decimal X, decimal Y)[] EdgePoints(TransitionModel edge)
  {
    decimal x1 = EdgeX(edge, true), y1 = EdgeY(edge, true), x2 = EdgeX(edge, false), y2 = EdgeY(edge, false);
    if (!OrthogonalEdges) return [(x1, y1), (x2, y2)];
    NodeModel? source = Nodes.FirstOrDefault(x => x.Key == edge.FromKey);
    string side = source is null
      ? (Math.Abs(x2 - x1) >= Math.Abs(y2 - y1) ? "H" : "V")
      : edge.SourceAnchor switch
      {
        "Top" or "TopCenter" or "Bottom" or "BottomCenter" => "V",
        "Left" or "LeftCenter" or "Right" or "RightCenter" => "H",
        _ => Math.Abs(x2 - x1) >= Math.Abs(y2 - y1) ? "H" : "V"
      };
    return side == "H"
      ? [(x1, y1), ((x1 + x2) / 2m, y1), ((x1 + x2) / 2m, y2), (x2, y2)]
      : [(x1, y1), (x1, (y1 + y2) / 2m), (x2, (y1 + y2) / 2m), (x2, y2)];
  }
  private string EdgePath(TransitionModel edge)
  {
    var pts = EdgePoints(edge);
    return string.Join(" ", pts.Select((p, i) => (i == 0 ? "M" : "L") + " " + p.X.ToString(System.Globalization.CultureInfo.InvariantCulture) + " " + p.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)));
  }
