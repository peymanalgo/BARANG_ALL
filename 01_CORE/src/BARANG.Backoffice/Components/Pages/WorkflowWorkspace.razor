  private async Task Save() { if (Saving || ReadOnly) return; Saving = true; try { if (!ValidateLocal()) return; var s = await Session(); if (s is null) return; var body = BuildGraphPayload(); var r = await Core.SendAsync(HttpMethod.Put, "api/v1/workflows/definition/draft", body, s.Value.Token, s.Value.Company, default); if (!r.IsSuccess) { Message = ServerError(r.ProblemCode); return; } Message = null; await Load(null); } finally { Saving = false; } }
