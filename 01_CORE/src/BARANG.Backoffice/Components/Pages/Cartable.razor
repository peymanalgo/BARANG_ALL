    private string Age(Row row)
    {
        TimeSpan age = DateTimeOffset.UtcNow - row.ActionDate;
        if (age.TotalDays >= 1) return $"{(int)age.TotalDays} {AgingText("DaysUnit")}";
        if (age.TotalHours >= 1) return $"{(int)age.TotalHours} {AgingText("HoursUnit")}";
        return $"{Math.Max(0, (int)age.TotalMinutes)} {AgingText("MinutesUnit")}";
    }

