    private async Task OpenPreview(Row row)
    {
        try { PreviewCancel?.Cancel(); } catch (ObjectDisposedException) { }
        CancellationTokenSource requestCancellation = new();
        PreviewCancel = requestCancellation;
        int generation = ++PreviewGeneration;
        DetailTabCancel?.Cancel();
        DetailTabCancel?.Dispose();
        PreviewRow = row;
        Preview = null;
        PreviewContext = null;
        PreviewError = null;
        PreviewLoading = true;
        PreviewOpen = true;
        var session = await Session();
        if (session is null) { PreviewLoading = false; PreviewError = G["PreviewFailed"].Value; if (ReferenceEquals(PreviewCancel, requestCancellation)) PreviewCancel = null; requestCancellation.Dispose(); return; }
        try
        {
            var response = await Core.GetAsync($"api/v1/workflows/definition/runtime/tasks/{row.Id}/quick-preview", session.Value.Token, session.Value.Company, requestCancellation.Token);
            if (!IsCurrentPreview(row.Id, generation)) return;
            if (response.IsSuccess)
            {
                Preview = ParsePreview(response.Value);
                if (Tab == "received")
                {
                    var context = await Core.GetAsync($"api/v1/workflows/definition/runtime/tasks/{row.Id}/context", session.Value.Token, session.Value.Company, requestCancellation.Token);
                    if (IsCurrentPreview(row.Id, generation) && context.IsSuccess) PreviewContext = context.Value.Deserialize<CartableWorkflowContextView>();
                }
            }
            else PreviewError = G["PreviewFailed"].Value;
        }
        catch (OperationCanceledException) when (requestCancellation.IsCancellationRequested) { }
        catch (JsonException exception) { Logger.LogWarning(exception, "Quick Preview JSON failed for task {TaskId}", row.Id); if (IsCurrentPreview(row.Id, generation)) PreviewError = G["PreviewFailed"].Value; }
        catch (HttpRequestException exception) { Logger.LogWarning(exception, "Quick Preview HTTP failed for task {TaskId}", row.Id); if (IsCurrentPreview(row.Id, generation)) PreviewError = G["PreviewFailed"].Value; }
        catch (ObjectDisposedException exception) { Logger.LogDebug(exception, "Quick Preview request was disposed for task {TaskId}", row.Id); }
        catch (InvalidOperationException exception) { Logger.LogWarning(exception, "Quick Preview client/render preparation failed for task {TaskId}", row.Id); if (IsCurrentPreview(row.Id, generation)) PreviewError = G["PreviewFailed"].Value; }
        catch (FormatException exception) { Logger.LogWarning(exception, "Quick Preview payload format failed for task {TaskId}", row.Id); if (IsCurrentPreview(row.Id, generation)) PreviewError = G["PreviewFailed"].Value; }
        catch (Exception exception) { Logger.LogError(exception, "Quick Preview failed for task {TaskId}", row.Id); if (IsCurrentPreview(row.Id, generation)) PreviewError = G["PreviewFailed"].Value; }
        finally
        {
            if (IsCurrentPreview(row.Id, generation))
            {
                PreviewLoading = false;
                if (!_disposed) await InvokeAsync(StateHasChanged);
            }
            if (ReferenceEquals(PreviewCancel, requestCancellation)) PreviewCancel = null;
            requestCancellation.Dispose();
        }
    }

    private bool IsCurrentPreview(Guid rowId, int generation) => !_disposed && PreviewOpen && PreviewRow?.Id == rowId && PreviewGeneration == generation;

    private Task ReloadPreview() => PreviewRow is null ? Task.CompletedTask : OpenPreview(PreviewRow);
    private void ClosePreview() { try { PreviewCancel?.Cancel(); } catch (ObjectDisposedException) { } PreviewCancel = null; PreviewOpen = false; PreviewLoading = false; PreviewError = null; Preview = null; PreviewContext = null; PreviewRow = null; }
    private void PreviewKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") ClosePreview(); }
    private string TimeSince(DateTimeOffset occurredAtUtc)
    {
        TimeSpan elapsed = DateTimeOffset.UtcNow - occurredAtUtc;
        if (elapsed.TotalDays >= 1) return $"{(int)elapsed.TotalDays} {AgingText("DaysUnit")}";
        if (elapsed.TotalHours >= 1) return $"{(int)elapsed.TotalHours} {AgingText("HoursUnit")}";
        return $"{Math.Max(0, (int)elapsed.TotalMinutes)} {AgingText("MinutesUnit")}";
    }
    private string CurrentStatus(string code, IReadOnlyList<LocalizedText>? currentStages) => code switch { "AuditRejected" => E["AuditRejected"].Value, "WorkflowCompleted" => E["WorkflowCompleted"].Value, "InWorkflow" => CartableStatus(currentStages ?? []), "Registered" => E["Registered"].Value, "Draft" => E["Draft"].Value, "Cancelled" => E["Cancelled"].Value, _ => E["Registered"].Value };
    private string WorkbenchStatus(string code, IReadOnlyList<WorkflowLocalizedText>? currentStages) => code switch { "AuditRejected" => E["AuditRejected"].Value, "WorkflowCompleted" => E["WorkflowCompleted"].Value, "InWorkflow" => currentStages is null || currentStages.Count == 0 ? E["InCartable"].Value : $"{E["InCartable"].Value} {string.Join(" / ", currentStages.Select(Localized))}", "Registered" => E["Registered"].Value, "Draft" => E["Draft"].Value, "Cancelled" => E["Cancelled"].Value, _ => E["Registered"].Value };

    private PreviewData ParsePreview(JsonElement x)
    {
        LocalizedText[] currentStages = x.TryGetProperty("currentStages", out var stages) && stages.ValueKind == JsonValueKind.Array ? stages.EnumerateArray().Select(v => new LocalizedText(Text(v, "fa"), Text(v, "en"), Text(v, "ar"))).ToArray() : [];
        return new(
            Text(x, "runtimeTaskId").Length == 0 ? Guid.Empty : Guid.Parse(Text(x, "runtimeTaskId")),
            Text(x, "orderNumber"), GetText(x, "stage"), Text(x, "positionTitle"), Text(x, "customerName") ?? "—", Text(x, "branchName") ?? "—",
            Dates.TryParseCanonical(Text(x, "orderDate"), out var date) ? date : default,
            x.TryGetProperty("itemCount", out var count) ? count.GetInt32() : 0,
            x.TryGetProperty("totalQuantity", out var quantity) ? quantity.GetDecimal() : 0m,
            Text(x, "currencyCode"), x.TryGetProperty("grandTotal", out var total) && total.ValueKind != JsonValueKind.Null ? total.GetDecimal() : null,
            Text(x, "effectiveStatusCode") ?? "Registered", GetText(x, "currentStage"), currentStages,
            GetText(x, "previousStage"), Text(x, "previousPositionTitle"), Text(x, "previousOutcome"), NullableDateTime(x, "previousActionAtUtc"),
            GetText(x, "destinationStage"), Text(x, "destinationPositionTitle"), Text(x, "outcome") ?? "", x.GetProperty("occurredAtUtc").GetDateTimeOffset(), NullableDateTime(x, "completedAtUtc"), Text(x, "priority", "Normal"), NullableDateTime(x, "followUpAtUtc"));
    }
    private static DateTimeOffset? NullableDateTime(JsonElement x, string name) => x.TryGetProperty(name, out var value) && value.ValueKind != JsonValueKind.Null ? value.GetDateTimeOffset() : null;

    private async Task RefreshAgingAsync(CancellationToken cancellationToken)
    {
        try
        {
            using PeriodicTimer timer = new(TimeSpan.FromMinutes(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private bool ShortcutsInitialized;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) { ShortcutReference = DotNetObjectReference.Create(this); await JS.InvokeVoidAsync("barangCartableShortcuts.init", ShortcutReference); ShortcutsInitialized = true; } }
    [JSInvokable] public async Task HandleShortcut(string shortcut) { if (shortcut == "focus-search") { await JS.InvokeVoidAsync("barangCartableShortcuts.focusSearch"); return; } if (shortcut == "escape") { if (PreviewOpen) ClosePreview(); KeyboardHelpOpen = false; StateHasChanged(); return; } Row? row = SelectedRow ?? Rows.FirstOrDefault(); if (shortcut == "reload") await Load(); else if (shortcut == "preview" && row is not null) await OpenPreview(row); else if (shortcut == "view" && row is not null) Open(row); }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        AgingRefreshCancel?.Cancel();
        AgingRefreshCancel?.Dispose();
        PreviewCancel?.Cancel();
        PreviewCancel?.Dispose();
        SelectedDetailCancel?.Cancel();
        SelectedDetailCancel?.Dispose();
        SearchCancel?.Cancel();
        SearchCancel?.Dispose();
        if (ShortcutsInitialized) { try { await JS.InvokeVoidAsync("barangCartableShortcuts.dispose"); } catch (JSDisconnectedException) { } catch (InvalidOperationException) { } }
        ShortcutReference?.Dispose();
    }
   private async Task<(string Token, Guid Company)?> Session() { var u = (await AuthState.GetAuthenticationStateAsync()).User; return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value, out var c) && u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t ? (t, c) : null; }
    private string FollowUp(Row row) => row.FollowUpAtUtc is not DateTimeOffset at ? "—" : $"{F[at <= DateTimeOffset.UtcNow ? "FollowUpReached" : "FutureFollowUp"]}: {Dates.Format(at, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)}";
