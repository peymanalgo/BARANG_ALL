@page "/cartable"
@rendermode InteractiveServer
@implements IAsyncDisposable
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.WebUtilities
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Localization
@using BARANG.Core.Application.Workflow
@using BARANG.Core.Application.Orders

@inject IStringLocalizer<CartableStrings> CartableText
@inject IStringLocalizer<AppStrings> A
@inject IStringLocalizer<CartableGridStrings> G
@inject IStringLocalizer<EffectiveStatusStrings> E
@inject IStringLocalizer<CartablePriorityStrings> P
@inject IStringLocalizer<CartableSavedViewStrings> V
@inject IStringLocalizer<CartableFollowUpStrings> F
@inject IStringLocalizer<CartableDecisionStrings> D
@inject IStringLocalizer<CartableDelegationStrings> H
@inject IStringLocalizer<CartableKeyboardStrings> K
@inject IStringLocalizer<CartableAccordionStrings> SA
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Cartable> Logger

<PageTitle>@C["MyCartable"]</PageTitle>
<link rel="stylesheet" href="/cartable.css" />
<link rel="stylesheet" href="/cartable-grid.css" />
<link rel="stylesheet" href="/cartable-v2.css" />
<link rel="stylesheet" href="/cartable-filters-v3.css" />
<link rel="stylesheet" href="/cartable-detail-tabs.css" />
<link rel="stylesheet" href="/cartable-actions-v5.css" />
<link rel="stylesheet" href="/cartable-layout-final.css" />
<div class="cartable-context"><div class="cartable-context-copy"><span class="cartable-title-mark" aria-hidden="true"><BarangIcon Name="inbox" /></span><div><h1>@C["MyCartable"]</h1><small>@C["Subtitle"]</small></div></div><div class="cartable-print-art" aria-hidden="true"><svg viewBox="0 0 120 96"><path d="M40 14 21 25 10 53l18 9 8-14v34c0 6 5 10 11 10h26c6 0 11-4 11-10V48l8 14 18-9-11-28-19-11-10 7H50z"/><path d="M49 14c1 10 21 10 22 0"/></svg><i></i><b></b></div></div>
<section class="cartable-tabs" role="tablist" aria-label='@C["MyCartable"]'><button type="button" class="@(Tab == "received" ? "active" : "")" role="tab" aria-selected="@(Tab == "received")" @onclick='() => SwitchTab("received")'>@C["Received"] <span>@ReceivedTotal</span></button><button type="button" class="@(Tab == "referrals" ? "active" : "")" role="tab" aria-selected="@(Tab == "referrals")" @onclick='() => SwitchTab("referrals")'>@C["MyReferrals"] <span>@ReferralTotal</span></button></section>
@if (Workload is not null && Tab == "received")
{
    <section class="cartable-workload-strip" aria-label='@Ui("WorkloadSummary")'>
        <div class="cartable-workload-title"><BarangIcon Name="briefcase" /><span>@Ui("WorkloadSummary")</span></div>
        <div class="cartable-workload-metric"><span>@Ui("TotalReceived")</span><strong>@Workload.TotalReceived</strong></div>
        <div class="cartable-workload-metric workload-urgent"><span>@Ui("Urgent")</span><strong>@Workload.Urgent</strong></div>
        <div class="cartable-workload-metric workload-attention"><span>@Ui("NeedsAttention")</span><strong>@Workload.NeedsAttention</strong></div>
        <div class="cartable-workload-metric workload-followup"><span>@Ui("FollowUpReached")</span><strong>@Workload.FollowUpReached</strong></div>
    </section>
}

<section class="cartable-grid-page cartable-v2-page">
<section class="cartable-search-accordion" aria-labelledby="cartable-search-panel-title">
    <button type="button" class="cartable-search-accordion-header" aria-expanded="@SearchPanelOpen" aria-controls="cartable-search-panel-content" @onclick="ToggleSearchPanel">
        <span class="cartable-search-accordion-title" id="cartable-search-panel-title"><BarangIcon Name="search" />@SA["Title"]</span>
        @if (ActiveFilterCount > 0) { <span class="cartable-search-filter-count" aria-label='@SA["ActiveFilters"]'>@ActiveFilterCount</span> }
        <span class="cartable-search-chevron @(SearchPanelOpen ? "open" : "")" aria-hidden="true">⌄</span>
    </button>
    @if (SearchPanelOpen)
    {
<div class="cartable-v2-toolbar" id="cartable-search-panel-content">
        <label class="cartable-v2-search"><BarangIcon Name="search" /><span class="cartable-control-label">@C["Search"]</span><input value="@State.Search" @oninput="SearchInput" placeholder='@C["SearchPlaceholder"]' aria-label='@C["Search"]' /></label>
        <div class="cartable-v2-filters">
            <div class="cartable-filter-row">
                <label class="cartable-filter"><span>@G["StageFilter"]</span><select value="@State.StageKey" @onchange="StageChanged"><option value="">@G["AllStages"]</option>@foreach (StageOption stage in Stages) { <option value="@stage.Key">@Localized(stage.Title)</option> }</select></label>
                <label class="cartable-filter cartable-customer-filter"><span>@G["CustomerFilter"]</span><SearchableSelect Value="@State.CustomerId" ValueChanged="CustomerChanged" SearchChanged="CustomerSearch" Options="@CustomerOptions" Placeholder='@G["CustomerPlaceholder"]' AriaLabel='@G["CustomerFilter"]' /></label>
                @if (Tab == "received") { <label class="cartable-filter"><span>@AgingText("Filter")</span><select value="@State.Aging" @onchange="AgingChanged"><option value="">@AgingText("All")</option><option value="Normal">@AgingText("Normal")</option><option value="Attention">@AgingText("Attention")</option><option value="LongWaiting">@AgingText("LongWaiting")</option></select></label> }
                @if (Tab == "referrals") { <label class="cartable-filter"><span>@G["OutcomeFilter"]</span><select value="@State.Outcome" @onchange="OutcomeChanged"><option value="">@G["AllOutcomes"]</option>@foreach (string outcome in Outcomes) { <option value="@outcome">@Outcome(outcome)</option> }</select></label> }
            </div>
            <div class="cartable-filter-row">
                <label class="cartable-filter"><span>@G["FromDate"]</span><LocaleDateInput Value="@State.FromDate" ValueChanged="FromDateChanged" Name="cartable-from" /></label>
                <label class="cartable-filter"><span>@G["ToDate"]</span><LocaleDateInput Value="@State.ToDate" ValueChanged="ToDateChanged" Name="cartable-to" /></label>
                <label class="cartable-personal-filter"><input type="checkbox" checked="@State.StarredOnly" @onchange="StarredOnlyChanged" /> <span>@G["StarredOnly"]</span></label>
            </div>
            @if (MoreFiltersOpen)
            {
            <div class="cartable-filter-row cartable-filter-row-secondary cartable-more-filters-panel" aria-label='@Ui("MoreFilters")'>
                @if (Tab == "referrals") { <label class="cartable-filter"><span>@G["StatusFilter"]</span><select value="@State.Status" @onchange="StatusChanged"><option value="">@G["AllStatuses"]</option><option value="Registered">@E["Registered"]</option><option value="InWorkflow">@E["InCartable"]</option><option value="WorkflowCompleted">@E["WorkflowCompleted"]</option><option value="AuditRejected">@E["AuditRejected"]</option></select></label> }
                @if (Tab == "received") { <label class="cartable-filter"><span>@F["FollowUpFilter"]</span><select value="@State.FollowUp" @onchange="FollowUpChanged"><option value="">@F["AllFollowUps"]</option><option value="HasFollowUp">@F["HasFollowUp"]</option><option value="Reached">@F["ReachedFilter"]</option><option value="Future">@F["FutureFilter"]</option></select></label> }
                <label class="cartable-filter"><span>@P["Priority"]</span><select value="@State.Priority" @onchange="PriorityChanged"><option value="">@P["All"]</option><option value="Normal">@P["Normal"]</option><option value="Important">@P["Important"]</option><option value="Urgent">@P["Urgent"]</option></select></label>
                <label class="cartable-filter cartable-sort"><span>@G["Sort"]</span><select value="@SortValue" @onchange="SortChanged"><option value="created:desc">@G["Newest"]</option><option value="created:asc">@G["Oldest"]</option><option value="order:asc">@G["OrderNumberSort"]</option><option value="customer:asc">@G["CustomerSort"]</option><option value="stage:asc">@G["StageSort"]</option><option value="priority:desc">@P["Highest"]</option><option value="priority:asc">@P["Lowest"]</option>@if (Tab == "received") { <option value="age:desc">@AgingText("Longest")</option><option value="age:asc">@AgingText("Shortest")</option><option value="followup:asc">@F["NearestFollowUp"]</option><option value="followup:desc">@F["LatestFollowUp"]</option> }@if (Tab == "referrals") { <option value="outcome:asc">@G["OutcomeSort"]</option> }</select></label>
            </div>
            }
        </div>
        <div class="cartable-saved-views" aria-label='@V["MyViews"]'><span class="cartable-saved-views-label">@V["MyViews"]</span><select value="@SelectedViewId" @onchange="SavedViewChanged"><option value="">—</option>@foreach (SavedView view in SavedViews) { <option value="@view.Id">@view.Name</option> }</select>@if (SavedViewModified) { <span class="cartable-saved-views-modified">@Ui("Modified")</span> }<button type="button" class="cartable-view-action" @onclick="OpenSaveView">@V["Save"]</button>@if (SelectedViewId is not null) { <button type="button" class="cartable-view-action" @onclick="UpdateSavedView">@V["Update"]</button><button type="button" class="cartable-view-action danger" @onclick="DeleteSavedView">@V["Delete"]</button> }@if (SavedViewsMessage is not null) { <span class="cartable-saved-views-error" role="alert">@SavedViewsMessage</span> }</div>
        <div class="cartable-v2-actions">@if (MoreFilterCount > 0 || MoreFiltersOpen) { <button type="button" class="cartable-more-filters @(MoreFiltersOpen ? "active" : "")" @onclick='() => MoreFiltersOpen = !MoreFiltersOpen' aria-expanded="@MoreFiltersOpen"><BarangIcon Name="filter" /> <span>@Ui(MoreFiltersOpen ? "HideFilters" : "MoreFilters")</span>@if (MoreFilterCount > 0) { <b>@MoreFilterCount</b> }</button> } else { <button type="button" class="cartable-more-filters" @onclick='() => MoreFiltersOpen = !MoreFiltersOpen' aria-expanded="@MoreFiltersOpen"><BarangIcon Name="filter" /> <span>@Ui("MoreFilters")</span></button> }@if (HasFilters) { <button type="button" class="cartable-clear" @onclick="ClearFilters">@G["ClearFilters"]</button> }<button type="button" class="cartable-keyboard-help" @onclick='() => KeyboardHelpOpen = true' aria-label='@K["KeyboardShortcuts"]'><BarangIcon Name="keyboard" /> <span>@K["KeyboardShortcuts"]</span></button><BarangButton Variant="secondary" Icon="refresh" Text='@C["Reload"]' Disabled="@Loading" Clicked="Reload" /></div>
    </div>
    }
</section>
    <div class="cartable-workbench @(Tab == "referrals" ? "cartable-workbench-history" : "")">
        <section class="cartable-workbench-grid" aria-label='@C["MyCartable"]'>
            @if (Loading) { <BarangLoadingState Text='@C["Loading"]' /> }
            else if (Rows.Count == 0) { <CrudEmptyState Title='@(HasFilters ? G["NoFilteredResults"] : (Tab == "received" ? C["Empty"] : C["ReferralEmpty"]))' Description="" /> }
            else
            {
                <div class="data-grid-wrap cartable-standard-grid cartable-v2-grid"><table class="data-grid"><thead><tr><th class="personal-column">@Personal("PersonalState")</th><th>@C["OrderNumber"]</th><th>@C["Customer"]</th><th>@C["OrderDate"]</th><th>@C["Stage"]</th><th>@C["CurrentStatus"]</th><th>@P["Priority"]</th>@if (Tab == "received") { <th>@AgingText("TimeInStage")</th><th>@F["FollowUp"]</th> }@if (Tab == "received") { <th>@G["PreviousAction"]</th><th>@G["ReceivedAt"]</th><th>@G["Position"]</th> } else { <th>@G["MyAction"]</th><th>@G["Destination"]</th><th>@G["ActionDate"]</th> }<th class="actions-column">@C["Actions"]</th></tr></thead><tbody>@foreach (Row row in Rows) { <tr tabindex="0" aria-selected="@(SelectedRow?.Id == row.Id)" class="@(SelectedRow?.Id == row.Id ? "cartable-row-selected" : row.IsSeen ? "cartable-row-seen" : "cartable-row-new")" @onclick='@(() => SelectRow(row))' @onkeydown='@(e => RowKeyDown(e, row))'><td class="personal-cell"><BarangIconButton Icon="@(row.IsStarred ? "star-filled" : "star")" Semantic="@(row.IsStarred ? "warning" : "neutral")" Label='@(row.IsStarred ? Personal("Unstar") : Personal("Star"))' Class="cartable-star-button" Clicked='@(() => ToggleStar(row))' />@if (!row.IsSeen) { <span class="cartable-new-badge">@Personal("New")</span> }</td><td dir="ltr"><span class="code-pill">@(row.OrderNumber ?? "—")</span></td><td>@row.Customer</td><td>@Date(row.OrderDate)</td><td><span class="stage-chip">@Stage(row)</span></td><td><span class="status-pill cartable-status-chip">@CurrentStatus(row)</span></td><td><PriorityIndicator Priority="@row.Priority" /></td>@if (Tab == "received") { <td><span class="aging-indicator aging-@AgingCategory(row)" title="@AgingTooltip(row)"><BarangIcon Name="history" /> <span>@Age(row)</span><small>@AgingText(AgingCategory(row))</small></span></td><td>@FollowUp(row)</td> }@if (Tab == "received") { <td><span class="context-action">@PreviousAction(row)</span></td><td>@DateTime(row.ActionDate)</td><td>@(row.Position ?? "—")</td> } else { <td><span class="outcome-pill outcome-@row.Outcome.ToLowerInvariant()">@Outcome(row.Outcome)</span></td><td><span class="context-action">@Destination(row)</span></td><td>@DateTime(row.ActionDate)</td> }<td class="row-actions" @onclick:stopPropagation="true"><BarangIconButton Icon="preview" Semantic="info" Label='@G["QuickPreview"]' Class="cartable-preview-trigger" Clicked='@(() => OpenPreview(row))' /><BarangIconButton Icon="eye" Semantic="info" Label='@C["View"]' Clicked='@(() => Open(row))' /></td></tr> }</tbody></table></div><BarangPagination Page="@State.Page" HasNext="@(State.Page * PageSize < CurrentTotal)" Disabled="@Loading" PageLabel='@C["Page"]' PreviousText='@C["Previous"]' NextText='@C["Next"]' Previous="Previous" Next="Next" />
            }
        </section>
        <aside class="cartable-workbench-detail" aria-live="polite">
            @if (SelectedRow is null)
            {
                <div class="cartable-workbench-empty"><span class="cartable-workbench-empty-icon"><BarangIcon Name="inbox" /></span><h2>@Ui("SelectOrder")</h2><p>@Ui("SelectOrderHint")</p></div>
            }
            else if (SelectedDetailLoading)
            {
                <div class="cartable-workbench-detail-loading"><span class="cartable-detail-skeleton skeleton-wide"></span><span class="cartable-detail-skeleton"></span><span class="cartable-detail-skeleton"></span><span class="cartable-detail-skeleton skeleton-short"></span></div>
            }
            else if (SelectedDetailError is not null)
            {
                <div class="cartable-workbench-error" role="alert"><BarangIcon Name="circle" /><p>@SelectedDetailError</p><button type="button" class="btn btn-secondary btn-small" @onclick="RetrySelectedDetail">@C["Reload"]</button></div>
            }
            else if (SelectedDetail is not null)
            {
                <header class="cartable-workbench-detail-header"><div><span class="eyebrow">@Ui("SelectedOrder")</span><h2 dir="ltr">@(SelectedDetail.Summary.OrderNumber ?? SelectedRow.OrderNumber ?? "—")</h2><p>@(SelectedDetail.Summary.CustomerName ?? SelectedRow.Customer)</p></div><div class="cartable-detail-header-meta"><span class="status-pill cartable-status-chip">@WorkbenchStatus(SelectedDetail.Summary.EffectiveStatusCode, SelectedDetail.Summary.CurrentStages)</span><PriorityIndicator Priority="@SelectedDetail.Summary.Priority.ToString()" /><BarangIconButton Icon="eye" Semantic="info" Label='@C["View"]' Clicked='@(() => Open(SelectedRow))' /></div></header>
                @if (Tab == "received")
                {
                    <section class="cartable-v5-operations" aria-label='@Ui("OperationalWorkspace")'>
                        @if (SelectedDetail.WorkflowContext is not null)
                        {
                            <div class="cartable-v5-stepper" aria-label='@Ui("WorkflowStepper")'>
                                <div class="cartable-v5-step completed"><span class="cartable-v5-step-node">✓</span><div class="cartable-v5-step-body"><small class="cartable-v5-step-label">@Ui("PreviousContext")</small><strong class="cartable-v5-step-stage">@(SelectedDetail.WorkflowContext.PreviousStage is null ? "—" : Localized(SelectedDetail.WorkflowContext.PreviousStage))</strong><em class="cartable-v5-step-position">@SelectedDetail.WorkflowContext.PreviousOutcome</em></div></div>
                                <div class="cartable-v5-step current"><span class="cartable-v5-step-node">●</span><div class="cartable-v5-step-body"><small class="cartable-v5-step-label">@Ui("CurrentContext")</small><strong class="cartable-v5-step-stage">@Localized(SelectedDetail.WorkflowContext.CurrentStage)</strong><em class="cartable-v5-step-position">@(SelectedDetail.WorkflowContext.CurrentPositionTitle ?? "—")</em></div></div>
                                <div class="cartable-v5-step future"><span class="cartable-v5-step-node">→</span><div class="cartable-v5-step-body"><small class="cartable-v5-step-label">@Ui("PossibleNextContext")</small>@if (SelectedDetail.WorkflowContext.NextDependsOnDecision) { <strong class="cartable-v5-step-stage">@Ui("DependsOnDecision")</strong> } else if (SelectedDetail.WorkflowContext.PossibleNext.Count == 0) { <strong class="cartable-v5-step-stage">@Ui("NoNext")</strong> } else { @foreach (var next in SelectedDetail.WorkflowContext.PossibleNext) { <strong class="cartable-v5-step-stage">@NextDestination(next)</strong> } }</div></div>
                            </div>
                        }
                        <div class="cartable-v5-context-line"><div><small>@Ui("Priority")</small><strong><PriorityIndicator Priority="@SelectedRow.Priority" /></strong></div><div><small>@Ui("Ownership")</small><strong>@OwnershipLabel(SelectedRow)</strong></div>@if (!string.IsNullOrWhiteSpace(SelectedRow.OnBehalfOfName)) { <div class="cartable-v5-substitute"><small>@H["Principal"]</small><strong>@H["Principal"] @SelectedRow.OnBehalfOfName</strong></div> }</div>
                        @if (ActionMessage is not null) { <div class="cartable-v5-error" role="alert">@ActionMessage</div> }
                        <div class="cartable-v5-action-groups">
                            <section class="cartable-v5-action-group"><h3>@Ui("OperationalWorkspace")</h3><div class="cartable-v5-buttons">@if (SelectedRow.ClaimedByUserId is null) { <BarangButton Variant="primary" Icon="user-plus" Text='@C["Claim"]' Busy="@ActionBusy" Clicked="OpenOperationalPopup" /> } else if (IsCurrentClaimant(SelectedRow)) { <BarangButton Variant="primary" Icon="check" Text='@C["Actions"]' Busy="@ActionBusy" Clicked="OpenOperationalPopup" /> } else { <span class="cartable-v5-claimed-note"><BarangIcon Name="lock" />@OwnershipLabel(SelectedRow)</span> }</div></section>
                        </div>
                    </section>
                }
<div class="cartable-workbench-detail-tabs" role="tablist" aria-label='@Ui("DetailTabs")'><button type="button" class="@(ActiveDetailTab == "details" ? "active" : "")" role="tab" aria-selected="@(ActiveDetailTab == "details")" @onclick='@(() => OpenDetailTab("details"))'><BarangIcon Name="document" />@Ui("Details")</button><button type="button" class="@(ActiveDetailTab == "files" ? "active" : "")" role="tab" aria-selected="@(ActiveDetailTab == "files")" @onclick='@(() => OpenDetailTab("files"))'><BarangIcon Name="paperclip" />@Ui("Files")</button><button type="button" class="@(ActiveDetailTab == "history" ? "active" : "")" role="tab" aria-selected="@(ActiveDetailTab == "history")" @onclick='@(() => OpenDetailTab("history"))'><BarangIcon Name="history" />@Ui("History")@(SelectedWorkflowHistory.Length > 0 ? $" ({SelectedWorkflowHistory.Length})" : "")</button></div>
                @if (ActiveDetailTab == "details")
                {
                    <div class="cartable-detail-visual-summary"><div class="cartable-detail-visual" aria-hidden="true"><div class="cartable-shirt-placeholder"><span></span></div></div><div class="cartable-detail-summary-copy"><strong>@(SelectedDetail.Summary.OrderNumber ?? "—")</strong><span>@(SelectedDetail.Summary.CustomerName ?? SelectedRow.Customer)</span><small>@Ui("Items"): @SelectedDetail.Summary.ItemCount · @SelectedDetail.Summary.TotalQuantity</small></div></div><div class="cartable-workbench-summary"><div class="cartable-detail-fact"><small>@C["Customer"]</small><strong>@(SelectedDetail.Summary.CustomerName ?? "—")</strong></div><div class="cartable-detail-fact"><small>@C["OrderDate"]</small><strong>@Date(SelectedDetail.Summary.OrderDate)</strong></div><div class="cartable-detail-fact"><small>@C["Stage"]</small><strong>@(SelectedDetail.Summary.CurrentStage is null ? "—" : Localized(SelectedDetail.Summary.CurrentStage))</strong></div><div class="cartable-detail-fact"><small>@C["CurrentStatus"]</small><strong>@WorkbenchStatus(SelectedDetail.Summary.EffectiveStatusCode, SelectedDetail.Summary.CurrentStages)</strong></div><div class="cartable-detail-fact"><small>@P["Priority"]</small><strong><PriorityIndicator Priority="@SelectedDetail.Summary.Priority.ToString()" /></strong></div><div class="cartable-detail-fact"><small>@Ui("Items")</small><strong>@SelectedDetail.Summary.ItemCount · @SelectedDetail.Summary.TotalQuantity</strong></div>@if (SelectedDetail.Summary.GrandTotal is decimal total) { <div class="cartable-detail-fact"><small>@Ui("Total")</small><strong>@total.ToString("N2", CultureInfo.CurrentCulture) @(SelectedDetail.Summary.CurrencyCode ?? "")</strong></div> }</div>
                }
                else if (DetailTabLoading)
                {
                    <div class="cartable-workbench-detail-loading"><span class="cartable-detail-skeleton skeleton-wide"></span><span class="cartable-detail-skeleton"></span><span class="cartable-detail-skeleton skeleton-short"></span></div>
                }
                else if (DetailTabError is not null)
                {
                    <div class="cartable-workbench-error" role="alert"><BarangIcon Name="circle" /><p>@DetailTabError</p><button type="button" class="btn btn-secondary btn-small" @onclick='@(() => OpenDetailTab(ActiveDetailTab))'>@C["Reload"]</button></div>
                }
                else if (ActiveDetailTab == "files")
                {
                    <div class="cartable-detail-tab-content"><h3><BarangIcon Name="paperclip" />@Ui("Files")</h3>@if (SelectedAttachments is null || SelectedAttachments.Count == 0) { <p class="cartable-tab-empty">@Ui("NoFiles")</p> } else { <ul class="cartable-file-list">@foreach (DecisionAttachmentView file in SelectedAttachments) { <li><BarangIcon Name="document" /><span title="@file.FileName">@file.FileName</span><small>@file.MediaType · @file.SizeBytes bytes<br />@DateTime(file.CreatedAtUtc)</small><button type="button" class="cartable-file-open" @onclick='@(() => DownloadAttachment(file))'>@Ui("Open")</button></li> }</ul> }</div>
                }
                else if (ActiveDetailTab == "history")
                {
                    <div class="cartable-detail-tab-content"><h3><BarangIcon Name="history" />@Ui("History")</h3>@if (SelectedWorkflowHistory.Length == 0) { <p class="cartable-tab-empty">@Ui("NoHistory")</p> } else { <ol class="cartable-history-list">@foreach (JsonElement item in SelectedWorkflowHistory) { <li><span class="cartable-history-dot"></span><div><strong>@HistoryStage(item)</strong><small>@HistoryDate(item)</small><p>@Outcome(Text(item, "outcome", "Active"))@(string.IsNullOrWhiteSpace(Text(item, "positionTitle")) ? "" : $" · {Text(item, "positionTitle")}")</p>@if (!string.IsNullOrWhiteSpace(Text(item, "note"))) { <p>@Text(item, "note")</p> }@if (item.TryGetProperty("attachments", out var files) && files.ValueKind == JsonValueKind.Array) { @foreach (var file in files.EnumerateArray()) { <small class="cartable-history-attachment">@Text(file, "fileName")</small> } }</div></li> }</ol> }</div>
                }
            }
        </aside>
    </div>
</section>
@if (OperationalPopupOpen && SelectedRow is not null)
{
    <CartableDecisionPopup Visible="true" OrderNumber="@(SelectedRow.OrderNumber ?? "—")" Stage="@Localized(SelectedRow.Stage)" Note="@DecisionNote" NoteChanged="@(value => DecisionNote = value)" Outcomes="@SelectedRow.Outcomes" Busy="@ActionBusy" Decision="ExecuteOperationalDecision" Cancel="CloseOperationalPopup" />
}
@if (ReleaseConfirm)
{
    <div class="dialog-backdrop"><section class="dialog-card cartable-v5-dialog" role="dialog" aria-modal="true"><h2>@F["ReleaseTask"]</h2><p>@F["ReleasePrompt"]</p><div class="form-actions"><BarangButton Variant="primary" Text='@F["ReleaseTask"]' Busy="@ActionBusy" Clicked="ReleaseSelected" /><BarangButton Variant="secondary" Text='@C["Cancel"]' Disabled="@ActionBusy" Clicked='@(() => ReleaseConfirm = false)' /></div></section></div>
}
@if (ForwardOpen)
{
    <div class="dialog-backdrop"><section class="dialog-card cartable-v5-dialog" role="dialog" aria-modal="true" aria-labelledby="cartable-forward-title"><h2 id="cartable-forward-title">@H["Forward"]</h2><p>@H["ForwardPrompt"]</p><label for="cartable-forward-search">@H["TargetSearch"]</label><div class="form-actions"><input id="cartable-forward-search" @bind="ForwardSearch" @bind:event="oninput" /><BarangButton Variant="secondary" Icon="search" Text='@C["Search"]' Clicked="LoadForwardTargets" /></div>@if (ForwardTargets.Count == 0) { <p class="muted">@H["NoTargets"]</p> } else { <label for="cartable-forward-target">@H["ForwardTo"]</label><select id="cartable-forward-target" @bind="ForwardTargetUserId"><option value="">—</option>@foreach (var target in ForwardTargets) { <option value="@target.Id">@target.Name · @target.Position</option> }</select>}<label for="cartable-forward-reason">@H["ForwardReason"]</label><textarea id="cartable-forward-reason" @bind="ForwardReason"></textarea><div class="form-actions"><BarangButton Variant="primary" Text='@H["Forward"]' Busy="@ActionBusy" Clicked="ForwardSelected" /><BarangButton Variant="secondary" Text='@C["Cancel"]' Disabled="@ActionBusy" Clicked='@(() => ForwardOpen = false)' /></div></section></div>
}
@if (SaveViewOpen)
{
    <div class="cartable-save-view-backdrop" @onclick="CloseSaveView"><section class="cartable-save-view-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation><h2>@V["Save"]</h2><label><span>@V["Name"]</span><input @bind="SaveViewName" placeholder='@V["NamePlaceholder"]' maxlength="120" /></label><div class="cartable-save-view-actions"><button type="button" class="btn btn-secondary" @onclick="CloseSaveView">@V["Cancel"]</button><button type="button" class="btn btn-primary" @onclick="SaveCurrentView">@V["Save"]</button></div></section></div>
}
@if (PreviewOpen)
{
    <div class="cartable-preview-backdrop" @onclick="ClosePreview">
        <aside class="cartable-quick-preview" role="dialog" aria-modal="true" aria-label='@G["QuickPreview"]' tabindex="-1" autofocus @onclick:stopPropagation @onkeydown="PreviewKeyDown">
            <header class="cartable-preview-header"><div class="cartable-preview-title"><span class="cartable-preview-icon"><BarangIcon Name="preview" /></span><div><span class="eyebrow">@G["QuickPreview"]</span><h2>@(Preview?.OrderNumber ?? PreviewRow?.OrderNumber ?? "—")</h2></div></div><BarangIconButton Icon="close" Label='@C["Close"]' Clicked="ClosePreview" /></header>
            @if (PreviewLoading) { <div class="cartable-preview-loading"><BarangIcon Name="history" /> @G["PreviewLoading"]</div> }
            else if (PreviewError is not null) { <div class="cartable-preview-error" role="alert"><BarangIcon Name="circle" /><span>@PreviewError</span><button type="button" class="btn btn-secondary btn-small" @onclick="ReloadPreview">@C["Reload"]</button></div> }
            else if (Preview is not null)
            {
                <div class="cartable-preview-body">
                    <div class="cartable-preview-identity"><strong>@Preview.CustomerName</strong><span>@Preview.BranchName</span><small>@Date(Preview.OrderDate)</small></div>
                    <div class="cartable-preview-chips"><span class="stage-chip">@Localized(Preview.Stage)</span><span class="status-pill cartable-status-chip">@CurrentStatus(Preview.EffectiveStatusCode, Preview.CurrentStages)</span><PriorityIndicator Priority="@Preview.Priority" /></div>
                    @if (PreviewContext is not null)
                    {
                        <div class="cartable-context-mini" aria-label='@Ui("WorkflowContext")'><div><span>@Ui("PreviousContext")</span><strong>@(PreviewContext.PreviousStage is null ? "—" : Localized(PreviewContext.PreviousStage))</strong><small>@(PreviewContext.PreviousOutcome ?? "")</small></div><div class="context-current"><span>@Ui("CurrentContext")</span><strong>@Localized(PreviewContext.CurrentStage)</strong><small>@(PreviewContext.CurrentPositionTitle ?? "—")</small></div><div><span>@Ui("PossibleNextContext")</span>@if (PreviewContext.NextDependsOnDecision) { <strong>@Ui("DependsOnDecision")</strong> } else if ((PreviewContext.PossibleNext ?? []).Count == 0) { <strong>@Ui("NoNext")</strong> } else { @foreach (var next in PreviewContext.PossibleNext ?? []) { <strong>@(next.DestinationStage is null ? Ui("Terminal") : Localized(next.DestinationStage))</strong> } }</div></div>
                    }
                    @if (Tab == "referrals")
                    {
                        <div class="cartable-referral-flow" aria-label='@G["MyAction"]'><span class="flow-node">@Localized(Preview.Stage)</span><span class="flow-arrow" aria-hidden="true">→</span><span class="outcome-pill outcome-@Preview.Outcome.ToLowerInvariant()">@Outcome(Preview.Outcome)</span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node">@(Preview.DestinationStage is null ? G["NoDestination"] : Localized(Preview.DestinationStage))</span></div>
                        <dl class="cartable-preview-facts"><dt>@G["MyAction"]</dt><dd>@Outcome(Preview.Outcome)</dd><dt>@G["Destination"]</dt><dd>@(Preview.DestinationStage is null ? G["NoDestination"] : Localized(Preview.DestinationStage))</dd><dt>@G["CurrentState"]</dt><dd>@CurrentStatus(Preview.EffectiveStatusCode, Preview.CurrentStages)</dd><dt>@G["TimeSinceAction"]</dt><dd>@TimeSince(Preview.OccurredAtUtc)</dd></dl>
                    }
                    else
                    {
                        <dl class="cartable-preview-facts"><dt>@G["Position"]</dt><dd>@(Preview.PositionTitle ?? "—")</dd><dt>@G["PreviousAction"]</dt><dd>@(Preview.PreviousStage is null ? "—" : $"{Localized(Preview.PreviousStage)} · {Outcome(Preview.PreviousOutcome ?? "Approve")}")</dd><dt>@G["ReceivedAt"]</dt><dd>@DateTime(Preview.OccurredAtUtc)</dd>@if (Preview.FollowUpAtUtc is DateTimeOffset followUp) { <dt>@F["FollowUp"]</dt><dd>@DateTime(followUp)</dd> }</dl>
                    }
                    <div class="cartable-preview-metrics"><div><strong>@Preview.ItemCount</strong><span>@G["ItemCount"]</span></div><div><strong>@Preview.TotalQuantity.ToString("N2", CultureInfo.CurrentCulture)</strong><span>@G["Quantity"]</span></div>@if (Preview.GrandTotal is decimal total) { <div><strong>@total.ToString("N2", CultureInfo.CurrentCulture) @(Preview.CurrencyCode ?? "")</strong><span>@G["GrandTotal"]</span></div> }</div>
                </div>
            }
        </aside>
    </div>
}
@if (KeyboardHelpOpen)
{
    <div class="cartable-keyboard-backdrop" @onclick="() => KeyboardHelpOpen = false">
        <section class="cartable-keyboard-dialog" role="dialog" aria-modal="true" aria-labelledby="cartable-keyboard-title" @onclick:stopPropagation>
            <header><h2 id="cartable-keyboard-title">@K["KeyboardShortcuts"]</h2><BarangIconButton Icon="close" Label='@Ui("Close")' Clicked='() => KeyboardHelpOpen = false' /></header>
            <dl><dt>/</dt><dd>@K["ShortcutFocusSearch"]</dd><dt>R</dt><dd>@K["ShortcutReload"]</dd><dt>P</dt><dd>@K["ShortcutPreview"]</dd><dt>Enter</dt><dd>@K["ShortcutView"]</dd><dt>Esc</dt><dd>@K["ShortcutEscape"]</dd></dl>
        </section>
    </div>
}
@if (Message is not null) { <div class="inline-error" role="alert">@Message</div> }

