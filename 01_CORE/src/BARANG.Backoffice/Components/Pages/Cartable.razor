@page "/cartable"
@rendermode InteractiveServer
@implements IAsyncDisposable
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.WebUtilities
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Localization
@using BARANG.Core.Application.Workflow
@using BARANG.Core.Application.Orders

@inject IStringLocalizer<CartableStrings> CartableText
@inject IStringLocalizer<AppStrings> A
@inject IStringLocalizer<CartableGridStrings> G
@inject IStringLocalizer<EffectiveStatusStrings> E
@inject IStringLocalizer<CartablePriorityStrings> P
@inject IStringLocalizer<CartableSavedViewStrings> V
@inject IStringLocalizer<CartableFollowUpStrings> F
@inject IStringLocalizer<CartableDecisionStrings> D
@inject IStringLocalizer<CartableDelegationStrings> H
@inject IStringLocalizer<CartableKeyboardStrings> K
@inject IStringLocalizer<CartableAccordionStrings> SA
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Cartable> Logger
@inject FeatureFlagsService Features

<PageTitle>@C["MyCartable"]</PageTitle>
<link rel="stylesheet" href="/cartable.css" />
<link rel="stylesheet" href="/cartable-grid.css" />
<link rel="stylesheet" href="/cartable-v2.css" />
<link rel="stylesheet" href="/cartable-filters-v3.css" />
<link rel="stylesheet" href="/cartable-detail-tabs.css" />
<link rel="stylesheet" href="/cartable-actions-v5.css" />
<link rel="stylesheet" href="/cartable-layout-final.css" />
<div class="cartable-context"><div class="cartable-context-copy"><span class="cartable-title-mark" aria-hidden="true"><BarangIcon Name="inbox" /></span><div><h1>@C["MyCartable"]</h1><small>@C["Subtitle"]</small></div></div><div class="cartable-print-art" aria-hidden="true"><svg viewBox="0 0 120 96"><path d="M40 14 21 25 10 53l18 9 8-14v34c0 6 5 10 11 10h26c6 0 11-4 11-10V48l8 14 18-9-11-28-19-11-10 7H50z"/><path d="M49 14c1 10 21 10 22 0"/></svg><i></i><b></b></div></div>
<section class="cartable-tabs" role="tablist" aria-label='@C["MyCartable"]'><button type="button" class="@(Tab == "received" ? "active" : "")" role="tab" aria-selected="@(Tab == "received")" @onclick='() => SwitchTab("received")'>@C["Received"] <span>@ReceivedTotal</span></button><button type="button" class="@(Tab == "referrals" ? "active" : "")" role="tab" aria-selected="@(Tab == "referrals")" @onclick='() => SwitchTab("referrals")'>@C["MyReferrals"] <span>@ReferralTotal</span></button></section>
@if (Workload is not null && Tab == "received")
{
    <section class="cartable-workload-strip" aria-label='@Ui("WorkloadSummary")'>
        <div class="cartable-workload-title"><BarangIcon Name="briefcase" /><span>@Ui("WorkloadSummary")</span></div>
        <div class="cartable-workload-metric"><span>@Ui("TotalReceived")</span><strong>@Workload.TotalReceived</strong></div>
        <div class="cartable-workload-metric workload-urgent"><span>@Ui("Urgent")</span><strong>@Workload.Urgent</strong></div>
        <div class="cartable-workload-metric workload-attention"><span>@Ui("NeedsAttention")</span><strong>@Workload.NeedsAttention</strong></div>
        <div class="cartable-workload-metric workload-followup"><span>@Ui("FollowUpReached")</span><strong>@Workload.FollowUpReached</strong></div>
    </section>
}

<section class="cartable-grid-page cartable-v2-page">
<section class="cartable-search-accordion" aria-labelledby="cartable-search-panel-title">
    <button type="button" class="cartable-search-accordion-header" aria-expanded="@SearchPanelOpen" aria-controls="cartable-search-panel-content" @onclick="ToggleSearchPanel">
        <span class="cartable-search-accordion-title" id="cartable-search-panel-title"><BarangIcon Name="search" />@SA["Title"]</span>
        @if (ActiveFilterCount > 0) { <span class="cartable-search-filter-count" aria-label='@SA["ActiveFilters"]'>@ActiveFilterCount</span> }
        <span class="cartable-search-chevron @(SearchPanelOpen ? "open" : "")" aria-hidden="true">⌄</span>
    </button>
    @if (SearchPanelOpen)
    {
<div class="cartable-v2-toolbar" id="cartable-search-panel-content">
        <label class="cartable-v2-search"><BarangIcon Name="search" /><span class="cartable-control-label">@C["Search"]</span><input value="@State.Search" @oninput="SearchInput" placeholder='@C["SearchPlaceholder"]' aria-label='@C["Search"]' /></label>
        <div class="cartable-v2-filters">
            <div class="cartable-filter-row">
                <label class="cartable-filter"><span>@G["StageFilter"]</span><select value="@State.StageKey" @onchange="StageChanged"><option value="">@G["AllStages"]</option>@foreach (StageOption stage in Stages) { <option value="@stage.Key">@Localized(stage.Title)</option> }</select></label>
                <label class="cartable-filter cartable-customer-filter"><span>@G["CustomerFilter"]</span><SearchableSelect Value="@State.CustomerId" ValueChanged="CustomerChanged" SearchChanged="CustomerSearch" Options="@CustomerOptions" Placeholder='@G["CustomerPlaceholder"]' AriaLabel='@G["CustomerFilter"]' /></label>
                @if (Tab == "received") { <label class="cartable-filter"><span>@AgingText("Filter")</span><select value="@State.Aging" @onchange="AgingChanged"><option value="">@AgingText("All")</option><option value="Normal">@AgingText("Normal")</option><option value="Attention">@AgingText("Attention")</option><option value="LongWaiting">@AgingText("LongWaiting")</option></select></label> }
                @if (Tab == "referrals") { <label class="cartable-filter"><span>@G["OutcomeFilter"]</span><select value="@State.Outcome" @onchange="OutcomeChanged"><option value="">@G["AllOutcomes"]</option>@foreach (string outcome in Outcomes) { <option value="@outcome">@Outcome(outcome)</option> }</select></label> }
            </div>
            <div class="cartable-filter-row">
                <label class="cartable-filter"><span>@G["FromDate"]</span><LocaleDateInput Value="@State.FromDate" ValueChanged="FromDateChanged" Name="cartable-from" /></label>
                <label class="cartable-filter"><span>@G["ToDate"]</span><LocaleDateInput Value="@State.ToDate" ValueChanged="ToDateChanged" Name="cartable-to" /></label>
                <label class="cartable-personal-filter"><input type="checkbox" checked="@State.StarredOnly" @onchange="StarredOnlyChanged" /> <span>@G["StarredOnly"]</span></label>
            </div>
            @if (MoreFiltersOpen)
            {
            <div class="cartable-filter-row cartable-filter-row-secondary cartable-more-filters-panel" aria-label='@Ui("MoreFilters")'>
                @if (Tab == "referrals") { <label class="cartable-filter"><span>@G["StatusFilter"]</span><select value="@State.Status" @onchange="StatusChanged"><option value="">@G["AllStatuses"]</option><option value="Registered">@E["Registered"]</option><option value="InWorkflow">@E["InCartable"]</option><option value="WorkflowCompleted">@E["WorkflowCompleted"]</option><option value="AuditRejected">@E["AuditRejected"]</option></select></label> }
                @if (Tab == "received") { <label class="cartable-filter"><span>@F["FollowUpFilter"]</span><select value="@State.FollowUp" @onchange="FollowUpChanged"><option value="">@F["AllFollowUps"]</option><option value="HasFollowUp">@F["HasFollowUp"]</option><option value="Reached">@F["ReachedFilter"]</option><option value="Future">@F["FutureFilter"]</option></select></label> }
                <label class="cartable-filter"><span>@P["Priority"]</span><select value="@State.Priority" @onchange="PriorityChanged"><option value="">@P["All"]</option><option value="Normal">@P["Normal"]</option><option value="Important">@P["Important"]</option><option value="Urgent">@P["Urgent"]</option></select></label>
                <label class="cartable-filter cartable-sort"><span>@G["Sort"]</span><select value="@SortValue" @onchange="SortChanged"><option value="created:desc">@G["Newest"]</option><option value="created:asc">@G["Oldest"]</option><option value="order:asc">@G["OrderNumberSort"]</option><option value="customer:asc">@G["CustomerSort"]</option><option value="stage:asc">@G["StageSort"]</option><option value="priority:desc">@P["Highest"]</option><option value="priority:asc">@P["Lowest"]</option>@if (Tab == "received") { <option value="age:desc">@AgingText("Longest")</option><option value="age:asc">@AgingText("Shortest")</option><option value="followup:asc">@F["NearestFollowUp"]</option><option value="followup:desc">@F["LatestFollowUp"]</option> }@if (Tab == "referrals") { <option value="outcome:asc">@G["OutcomeSort"]</option> }</select></label>
            </div>
            }
        </div>
        <div class="cartable-saved-views" aria-label='@V["MyViews"]'><span class="cartable-saved-views-label">@V["MyViews"]</span><select value="@SelectedViewId" @onchange="SavedViewChanged"><option value="">—</option>@foreach (SavedView view in SavedViews) { <option value="@view.Id">@view.Name</option> }</select>@if (SavedViewModified) { <span class="cartable-saved-views-modified">@Ui("Modified")</span> }<button type="button" class="cartable-view-action" @onclick="OpenSaveView">@V["Save"]</button>@if (SelectedViewId is not null) { <button type="button" class="cartable-view-action" @onclick="UpdateSavedView">@V["Update"]</button><button type="button" class="cartable-view-action danger" @onclick="DeleteSavedView">@V["Delete"]</button> }@if (SavedViewsMessage is not null) { <span class="cartable-saved-views-error" role="alert">@SavedViewsMessage</span> }</div>
        <div class="cartable-v2-actions">@if (MoreFilterCount > 0 || MoreFiltersOpen) { <button type="button" class="cartable-more-filters @(MoreFiltersOpen ? "active" : "")" @onclick='() => MoreFiltersOpen = !MoreFiltersOpen' aria-expanded="@MoreFiltersOpen"><BarangIcon Name="filter" /> <span>@Ui(MoreFiltersOpen ? "HideFilters" : "MoreFilters")</span>@if (MoreFilterCount > 0) { <b>@MoreFilterCount</b> }</button> } else { <button type="button" class="cartable-more-filters" @onclick='() => MoreFiltersOpen = !MoreFiltersOpen' aria-expanded="@MoreFiltersOpen"><BarangIcon Name="filter" /> <span>@Ui("MoreFilters")</span></button> }@if (HasFilters) { <button type="button" class="cartable-clear" @onclick="ClearFilters">@G["ClearFilters"]</button> }<button type="button" class="cartable-keyboard-help" @onclick='() => KeyboardHelpOpen = true' aria-label='@K["KeyboardShortcuts"]'><BarangIcon Name="keyboard" /> <span>@K["KeyboardShortcuts"]</span></button><BarangButton Variant="secondary" Icon="refresh" Text='@C["Reload"]' Disabled="@Loading" Clicked="Reload" /></div>
    </div>
    }
</section>
    <div class="cartable-workbench @(Tab == "referrals" ? "cartable-workbench-history" : "")">
        <section class="cartable-workbench-grid" aria-label='@C["MyCartable"]'>
            @if (Loading) { <BarangLoadingState Text='@C["Loading"]' /> }
            else if (Rows.Count == 0) { <CrudEmptyState Title='@(HasFilters ? G["NoFilteredResults"] : (Tab == "received" ? C["Empty"] : C["ReferralEmpty"]))' Description="" /> }
            else
            {
                <div class="data-grid-wrap cartable-standard-grid cartable-v2-grid"><table class="data-grid"><thead><tr><th class="personal-column">@Personal("PersonalState")</th><th>@C["OrderNumber"]</th><th>@C["Customer"]</th><th>@C["OrderDate"]</th><th>@C["Stage"]</th><th>@C["CurrentStatus"]</th><th>@P["Priority"]</th>@if (Tab == "received") { <th>@AgingText("TimeInStage")</th><th>@F["FollowUp"]</th> }@if (Tab == "received") { <th>@G["PreviousAction"]</th><th>@G["ReceivedAt"]</th><th>@G["Position"]</th> } else { <th>@G["MyAction"]</th><th>@G["Destination"]</th><th>@G["ActionDate"]</th> }<th class="actions-column">@C["Actions"]</th></tr></thead><tbody>@foreach (Row row in Rows) { <tr tabindex="0" class="@(row.IsSeen ? "cartable-row-seen" : "cartable-row-new")" @onclick='@(() => Open(row))' @onkeydown='@(e => RowKeyDown(e, row))'><td class="personal-cell" @onclick:stopPropagation="true"><BarangIconButton Icon="@(row.IsStarred ? "star-filled" : "star")" Semantic="@(row.IsStarred ? "warning" : "neutral")" Label='@(row.IsStarred ? Personal("Unstar") : Personal("Star"))' Class="cartable-star-button" Clicked='@(() => ToggleStar(row))' />@if (!row.IsSeen) { <span class="cartable-new-badge">@Personal("New")</span> }</td><td dir="ltr"><span class="code-pill">@(row.OrderNumber ?? "—")</span></td><td>@row.Customer</td><td>@Date(row.OrderDate)</td><td><span class="stage-chip">@Stage(row)</span></td><td><span class="status-pill cartable-status-chip">@CurrentStatus(row)</span></td><td><PriorityIndicator Priority="@row.Priority" /></td>@if (Tab == "received") { <td><span class="aging-indicator aging-@AgingCategory(row)" title="@AgingTooltip(row)"><BarangIcon Name="history" /> <span>@Age(row)</span><small>@AgingText(AgingCategory(row))</small></span></td><td>@FollowUp(row)</td> }@if (Tab == "received") { <td><span class="context-action">@PreviousAction(row)</span></td><td>@DateTime(row.ActionDate)</td><td>@(row.Position ?? "—")</td> } else { <td><span class="outcome-pill outcome-@row.Outcome.ToLowerInvariant()">@Outcome(row.Outcome)</span></td><td><span class="context-action">@Destination(row)</span></td><td>@DateTime(row.ActionDate)</td> }<td @onclick:stopPropagation="true"><BarangIconButton Icon="eye" Semantic="info" Label='@C["View"]' Clicked='@(() => Open(row))' /></td></tr> }</tbody></table></div><BarangPagination Page="@State.Page" HasNext="@(State.Page * PageSize < CurrentTotal)" Disabled="@Loading" PageLabel='@C["Page"]' PreviousText='@C["Previous"]' NextText='@C["Next"]' Previous="Previous" Next="Next" />
            }
        </section>
    </div>
</section>
@if (KeyboardHelpOpen)
{
    <div class="cartable-keyboard-backdrop" @onclick="() => KeyboardHelpOpen = false">
        <section class="cartable-keyboard-dialog" role="dialog" aria-modal="true" aria-labelledby="cartable-keyboard-title" @onclick:stopPropagation>
            <header><h2 id="cartable-keyboard-title">@K["KeyboardShortcuts"]</h2><BarangIconButton Icon="close" Label='@Ui("Close")' Clicked='() => KeyboardHelpOpen = false' /></header>
            <dl><dt>/</dt><dd>@K["ShortcutFocusSearch"]</dd><dt>R</dt><dd>@K["ShortcutReload"]</dd><dt>Enter</dt><dd>@K["ShortcutView"]</dd><dt>Esc</dt><dd>@K["ShortcutEscape"]</dd></dl>
        </section>
    </div>
}
@if (SaveViewOpen)
{
    <div class="cartable-save-view-backdrop" @onclick="CloseSaveView"><section class="cartable-save-view-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation><h2>@V["Save"]</h2><label><span>@V["Name"]</span><input @bind="SaveViewName" placeholder='@V["NamePlaceholder"]' maxlength="120" /></label><div class="cartable-save-view-actions"><button type="button" class="btn btn-secondary" @onclick="CloseSaveView">@V["Cancel"]</button><button type="button" class="btn btn-primary" @onclick="SaveCurrentView">@V["Save"]</button></div></section></div>
}
@if (Message is not null) { <div class="inline-error" role="alert">@Message</div> }

@code {
    private CartableTextProxy C => new(CartableText, A);
    private sealed class CartableTextProxy(IStringLocalizer<CartableStrings> cartable, IStringLocalizer<AppStrings> app)
    {
        public Microsoft.Extensions.Localization.LocalizedString this[string key]
        {
            get
            {
                Microsoft.Extensions.Localization.LocalizedString value = cartable[key];
                return key == "View" || value.ResourceNotFound ? app[key] : value;
            }
        }
    }
    private bool KeyboardHelpOpen, MoreFiltersOpen, SearchPanelOpen;
    private CartableWorkloadSummary? Workload;
    private DotNetObjectReference<Cartable>? ShortcutReference;
    private string Tab = "received";
    private const int PageSize = 20; private int ReceivedTotal, ReferralTotal, Generation; private bool Loading; private string? Message; private string? SavedViewsMessage; private List<Row> Rows = []; private List<StageOption> Stages = []; private List<SearchableSelectOption> CustomerOptions = []; private readonly string[] Outcomes = ["Approve", "Reject", "AuditReject"]; private CancellationTokenSource? SearchCancel; private CancellationTokenSource? AgingRefreshCancel; private List<SavedView> SavedViews = []; private string? SelectedViewId; private bool SaveViewOpen; private string SaveViewName = "";
    private GridState ReceivedState = new(), ReferralState = new(); private GridState State => Tab == "received" ? ReceivedState : ReferralState; private int CurrentTotal => Tab == "received" ? ReceivedTotal : ReferralTotal; private int MoreFilterCount => (string.IsNullOrWhiteSpace(State.Priority) ? 0 : 1) + (Tab == "received" && !string.IsNullOrWhiteSpace(State.FollowUp) ? 1 : 0) + (Tab == "referrals" && !string.IsNullOrWhiteSpace(State.Status) ? 1 : 0) + (State.Sort != "created" || !State.Descending ? 1 : 0); private bool HasFilters => !string.IsNullOrWhiteSpace(State.Search) || !string.IsNullOrWhiteSpace(State.StageKey) || !string.IsNullOrWhiteSpace(State.CustomerId) || State.FromDate is not null || State.ToDate is not null || !string.IsNullOrWhiteSpace(State.Outcome) || !string.IsNullOrWhiteSpace(State.Status) || State.StarredOnly || !string.IsNullOrWhiteSpace(State.Aging) || !string.IsNullOrWhiteSpace(State.Priority) || !string.IsNullOrWhiteSpace(State.FollowUp) || State.Sort != "created" || !State.Descending; private int ActiveFilterCount => (SelectedViewId is null ? 0 : 1) + (string.IsNullOrWhiteSpace(State.Search) ? 0 : 1) + (string.IsNullOrWhiteSpace(State.StageKey) ? 0 : 1) + (string.IsNullOrWhiteSpace(State.CustomerId) ? 0 : 1) + (State.FromDate is null ? 0 : 1) + (State.ToDate is null ? 0 : 1) + (string.IsNullOrWhiteSpace(State.Outcome) ? 0 : 1) + (string.IsNullOrWhiteSpace(State.Status) ? 0 : 1) + (State.StarredOnly ? 1 : 0) + (string.IsNullOrWhiteSpace(State.Aging) ? 0 : 1) + (string.IsNullOrWhiteSpace(State.Priority) ? 0 : 1) + (string.IsNullOrWhiteSpace(State.FollowUp) ? 0 : 1) + (State.Sort != "created" || !State.Descending ? 1 : 0);
    private string SortValue { get => $"{State.Sort}:{(State.Descending ? "desc" : "asc")}"; set { string[] parts = value.Split(':'); State.Sort = parts[0]; State.Descending = parts.Length < 2 || parts[1] == "desc"; } }
    private IReadOnlyList<SearchableSelectOption> CustomerOptionsView => CustomerOptions;
    protected override async Task OnInitializedAsync() { if (!await Features.RedirectIfDisabledAsync(Navigation, "cartable")) return; RestoreQueryState(); await LoadStages(); await LoadSavedViews(); await Load(); AgingRefreshCancel = new(); _ = RefreshAgingAsync(AgingRefreshCancel.Token); }
    private void ToggleSearchPanel() => SearchPanelOpen = !SearchPanelOpen;
    private async Task SwitchTab(string tab) { if (Tab == tab) return; Tab = tab; SearchPanelOpen = false; SelectedViewId = null; Rows = []; await LoadSavedViews(); await Load(); }
    private async Task Load() { int generation = ++Generation; Loading = true; Message = null; var s = await Session(); if (s is null) { Loading = false; Message = C["LoadFailed"]; return; } string receivedPath = BuildPath("eligible", new GridState(), false, 1); string referralPath = BuildPath("referrals", new GridState(), true, 1); var receivedTask = Core.GetAsync(receivedPath, s.Value.Token, s.Value.Company, default); var referralTask = Core.GetAsync(referralPath, s.Value.Token, s.Value.Company, default); var currentPath = BuildPath(Tab == "received" ? "eligible" : "referrals", State, Tab == "referrals", State.Page); var currentTask = Core.GetAsync(currentPath, s.Value.Token, s.Value.Company, default); var workloadTask = Core.GetAsync("api/v1/workflows/definition/runtime/workload-summary", s.Value.Token, s.Value.Company, default); await Task.WhenAll(receivedTask, referralTask, currentTask, workloadTask); if (generation != Generation) return; if (!receivedTask.Result.IsSuccess || !referralTask.Result.IsSuccess || !currentTask.Result.IsSuccess) { Rows = []; Workload = null; Message = C["LoadFailed"]; Loading = false; return; } ReceivedTotal = Total(receivedTask.Result.Value); ReferralTotal = Total(referralTask.Result.Value); Rows = Items(currentTask.Result.Value).Select(Parse).ToList(); Workload = workloadTask.Result.IsSuccess ? ParseWorkload(workloadTask.Result.Value) : null; Loading = false; }
    private string BuildPath(string endpoint, GridState state, bool referrals, int page) { List<string> q = [$"search={Uri.EscapeDataString(state.Search.Trim())}", $"page={page}", $"pageSize={PageSize}", $"descending={state.Descending.ToString().ToLowerInvariant()}", $"starredOnly={state.StarredOnly.ToString().ToLowerInvariant()}"]; if (!string.IsNullOrWhiteSpace(state.FollowUp)) q.Add($"followUp={Uri.EscapeDataString(state.FollowUp)}"); if (!string.IsNullOrWhiteSpace(state.Priority)) q.Add($"priority={Uri.EscapeDataString(state.Priority)}"); if (!string.IsNullOrWhiteSpace(state.StageKey)) q.Add($"stageKey={Uri.EscapeDataString(state.StageKey)}"); if (Guid.TryParse(state.CustomerId, out Guid customer)) q.Add($"customerId={customer}"); if (state.FromDate is DateOnly from) q.Add($"fromDate={from:yyyy-MM-dd}"); if (state.ToDate is DateOnly to) q.Add($"toDate={to:yyyy-MM-dd}"); if (referrals && !string.IsNullOrWhiteSpace(state.Outcome)) q.Add($"outcome={Uri.EscapeDataString(state.Outcome)}"); if (referrals && !string.IsNullOrWhiteSpace(state.Status)) q.Add($"status={Uri.EscapeDataString(state.Status)}"); if (!referrals && !string.IsNullOrWhiteSpace(state.Aging)) q.Add($"aging={Uri.EscapeDataString(state.Aging)}"); if (!string.IsNullOrWhiteSpace(state.Sort)) q.Add($"sort={Uri.EscapeDataString(state.Sort)}"); return $"api/v1/workflows/definition/runtime/tasks/{endpoint}?{string.Join("&", q)}"; }
    private async Task SearchInput(ChangeEventArgs e) { State.Search = e.Value?.ToString() ?? ""; State.Page = 1; await DebouncedLoad(); } private async Task DebouncedLoad() { SearchCancel?.Cancel(); SearchCancel?.Dispose(); SearchCancel = new(); try { await Task.Delay(280, SearchCancel.Token); await Load(); } catch (OperationCanceledException) { } }
    private async Task AgingChanged(ChangeEventArgs e) { State.Aging = e.Value?.ToString() ?? ""; State.Page = 1; await Load(); } private async Task FollowUpChanged(ChangeEventArgs e) { State.FollowUp = e.Value?.ToString() ?? ""; State.Page = 1; await Load(); }
    private async Task StarredOnlyChanged(ChangeEventArgs e) { State.StarredOnly = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase); State.Page = 1; await Load(); }
    private async Task ToggleStar(Row row) { var s = await Session(); if (s is null) return; var next = !row.IsStarred; var r = await Core.SendAsync(HttpMethod.Post, $"api/v1/workflows/definition/runtime/tasks/{row.Id}/personal-state", new { isStarred = next, seen = false }, s.Value.Token, s.Value.Company, default); if (r.IsSuccess) { int index = Rows.FindIndex(x => x.Id == row.Id); if (index >= 0) Rows[index] = row with { IsStarred = next }; } }
    private Task Reload(MouseEventArgs _) => Load(); private async Task PriorityChanged(ChangeEventArgs e) { State.Priority = e.Value?.ToString() ?? ""; State.Page = 1; await Load(); } private async Task StageChanged(ChangeEventArgs e) { State.StageKey = e.Value?.ToString() ?? ""; State.Page = 1; await Load(); } private async Task OutcomeChanged(ChangeEventArgs e) { State.Outcome = e.Value?.ToString() ?? ""; State.Page = 1; await Load(); } private async Task StatusChanged(ChangeEventArgs e) { State.Status = e.Value?.ToString() ?? ""; State.Page = 1; await Load(); } private async Task SortChanged(ChangeEventArgs e) { SortValue = e.Value?.ToString() ?? "created:desc"; State.Page = 1; await Load(); } private async Task FromDateChanged(DateOnly? value) { State.FromDate = value; State.Page = 1; await Load(); } private async Task ToDateChanged(DateOnly? value) { State.ToDate = value; State.Page = 1; await Load(); } private async Task CustomerChanged(string value) { State.CustomerId = value; State.Page = 1; await Load(); }
    private async Task CustomerSearch(string value) { var s = await Session(); if (s is null || string.IsNullOrWhiteSpace(value)) return; var r = await Core.GetAsync($"api/v1/customers/options?search={Uri.EscapeDataString(value)}&activeOnly=true&limit=12", s.Value.Token, s.Value.Company, default); if (r.IsSuccess) CustomerOptions = (r.Value.ValueKind == JsonValueKind.Array ? r.Value.EnumerateArray() : r.Value.TryGetProperty("items", out var items) ? items.EnumerateArray() : []).Select(x => new SearchableSelectOption(Text(x, "id"), Text(x, "displayName") ?? Text(x, "name") ?? Text(x, "customerCode"))).ToList(); }
  private void RowKeyDown(KeyboardEventArgs e, Row row) { if (e.Key is "Enter" or " ") Open(row); }
   private async Task ClearFilters() { if (Tab == "received") ReceivedState = new(); else ReferralState = new(); MoreFiltersOpen = false; Rows = []; await Load(); }
