@using System.Globalization
@using System.Text.Json
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject ICoreApiClient Core
@inject ILocaleDateService Dates
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<section class="crud-card discount-rules-panel" data-pricing-grid="discounts">
    <header class="section-header"><h2>@T("قواعد تخفیف", "قواعد الخصم", "Discount rules")</h2><button class="btn btn-primary btn-small" type="button" @onclick="New"><BarangIcon Name="plus" /> @T("افزودن", "إضافة", "Add")</button></header>
    <div class="crud-toolbar"><label class="search-box"><input value="@Search" @oninput="SearchChanged" placeholder="@T("جست‌وجو", "بحث", "Search")" aria-label="@T("جست‌وجو", "بحث", "Search")" /></label><button class="btn btn-secondary" type="button" @onclick="ResetGrid"><BarangIcon Name="reset" /> @T("بازنشانی", "إعادة ضبط", "Reset")</button></div>
<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("کد", "الرمز", "Code")</th><th>@T("نام", "الاسم", "Name")</th><th>@T("منبع", "المصدر", "Source")</th><th>@T("سطح", "النطاق", "Scope")</th><th>@T("مقدار", "القيمة", "Value")</th><th>@T("اولویت", "الأولوية", "Priority")</th><th>@T("وضعیت", "الحالة", "Status")</th><th>@T("عملیات", "الإجراءات", "Actions")</th></tr></thead><tbody>@if(Loading){<tr><td colspan="8">@T("در حال بارگذاری…", "جار التحميل…", "Loading…")</td></tr>}else if(Rows.Count==0){<tr><td colspan="8">@T("قاعده‌ای یافت نشد.", "لم يتم العثور على قواعد.", "No discount rules found.")</td></tr>}else foreach(var x in Rows){<tr><td>@x.Code</td><td>@x.Name</td><td>@SourceText(x.Source)</td><td>@ScopeText(x.ApplicationScope)</td><td>@x.Value.ToString("N2") @(x.Type=="Percentage"?"%":x.Currency)</td><td>@x.Priority</td><td><span class="status-pill @(x.Active?"status-active":"status-inactive")">@(x.Active?T("فعال","نشط","Active"):T("غیرفعال","غير نشط","Inactive"))</span></td><td class="row-actions"><BarangIconButton Icon="eye" Semantic="info" Label="@T("مشاهده","عرض","View")" Clicked="@(()=>Open(x,false))" /><BarangIconButton Icon="edit" Label="@T("ویرایش","تحرير","Edit")" Clicked="@(()=>Open(x,true))" /><BarangIconButton Icon="history" Semantic="info" Label="@T("تاریخچه","السجل","History")" Clicked="@(()=>OpenHistory(x))" /><BarangIconButton Icon="power" Semantic="warning" Label="@(x.Active?T("غیرفعال‌سازی","تعطيل","Deactivate"):T("فعال‌سازی","تفعيل","Activate"))" Clicked="@(()=>Toggle(x))" /><BarangIconButton Icon="trash" Label="@T("حذف","حذف","Delete")" Clicked="@(()=>Delete(x))" /></td></tr>}</tbody></table></div>
    @if(Message is not null){<div class="@(Success?"inline-success":"inline-error")" role="status">@Message</div>}
</section>

<BarangModal Open="@Dialog" Title="@(Editing is null?T("ایجاد قاعده تخفیف","إنشاء قاعدة خصم","Create discount rule"):T("ویرایش قاعده تخفیف","تحرير قاعدة الخصم","Edit discount rule"))" Size="large" CloseRequested="Close">
    <div class="form-grid">
        <label><span>@T("کد", "الرمز", "Code")</span><input @bind="Code" disabled="@(Editing is not null)" /></label><label><span>@T("نام", "الاسم", "Name")</span><input @bind="Name" disabled="@ReadOnly" /></label>
        <label><span>@T("منبع", "المصدر", "Source")</span><select @bind="Source" disabled="@ReadOnly"><option value="Automatic">@T("خودکار","تلقائي","Automatic")</option><option value="Manual">@T("دستی","يدوي","Manual")</option></select></label><label><span>@T("سطح اعمال", "نطاق التطبيق", "Application scope")</span><select @bind="ApplicationScope" disabled="@ReadOnly"><option value="Item">@T("قلم سفارش","بند الطلب","Order item")</option><option value="Order">@T("سفارش","الطلب","Order")</option></select></label>
        <label><span>@T("نوع محاسبه", "نوع الحساب", "Calculation type")</span><select @bind="Type" disabled="@ReadOnly"><option value="Percentage">@T("درصدی","نسبة مئوية","Percentage")</option><option value="FixedAmount">@T("مبلغ ثابت","مبلغ ثابت","Fixed amount")</option></select></label><label><span>@T("محدوده واجد شرایط", "نطاق الأهلية", "Eligibility")</span><select @bind="Eligibility" disabled="@ReadOnly"><option value="General">@T("عمومی","عام","General")</option><option value="Customer">@T("مشتری","عميل","Customer")</option><option value="PartnerSource">@T("منبع سفارش","مصدر الطلب","Order source")</option></select></label>
        <label><span>@T("مقدار", "القيمة", "Value")</span><input type="number" min="0" step="0.01" @bind="Value" disabled="@ReadOnly" /></label><label><span>@T("ارز", "العملة", "Currency")</span><input maxlength="3" @bind="Currency" disabled="@ReadOnly" /></label><label><span>@T("اولویت", "الأولوية", "Priority")</span><input type="number" min="0" step="1" @bind="Priority" disabled="@ReadOnly" /></label>
        <label><span>@T("حداقل تعداد", "الحد الأدنى للكمية", "Minimum quantity")</span><input type="number" min="0" step="0.01" @bind="MinimumQuantity" disabled="@ReadOnly" /></label><label><span>@T("حداقل مبلغ", "الحد الأدنى للمبلغ", "Minimum amount")</span><input type="number" min="0" step="0.01" @bind="MinimumAmount" disabled="@ReadOnly" /></label><label class="inline-check"><input type="checkbox" @bind="Combinable" disabled="@ReadOnly" /> @T("قابل ترکیب", "قابل للدمج", "Combinable")</label><label class="inline-check"><input type="checkbox" @bind="ReasonRequired" disabled="@ReadOnly" /> @T("نیازمند دلیل", "يتطلب سبباً", "Reason required")</label>
        <label><span>@T("از تاریخ", "من تاريخ", "Valid from")</span><LocaleDateInput Value="From" ValueChanged="@(x=>From=x??From)" Disabled="@ReadOnly" /></label><label><span>@T("تا تاریخ", "إلى تاريخ", "Valid to")</span><LocaleDateInput Value="To" ValueChanged="@(x=>To=x)" Disabled="@ReadOnly" /></label><label class="span-2"><span>@T("شرح/دلیل", "الوصف/السبب", "Description/reason")</span><textarea @bind="Description" disabled="@ReadOnly"></textarea></label>
    </div><div class="form-actions"><button class="secondary-action" type="button" @onclick="Close">@T("انصراف","إلغاء","Cancel")</button>@if(!ReadOnly){<button class="primary-link" type="button" @onclick="Save">@T("ذخیره","حفظ","Save")</button>}</div>
</BarangModal>

<BarangModal Open="@HistoryDialog" Title="@T("سابقه قاعده تخفیف","سجل قاعدة الخصم","Discount history")" Size="large" CloseRequested="@(()=>HistoryDialog=false)">
    @if(History is null || History.Value.ValueKind != JsonValueKind.Array || !History.Value.EnumerateArray().Any()){<div class="empty-state">@T("سابقه‌ای ثبت نشده است.","لا يوجد سجل.","No history recorded.")</div>}else{<div class="record-list">@foreach(var item in History.Value.EnumerateArray()){<div class="record-row"><strong>@HistoryAction(item.GetProperty("action").GetString())</strong><small>@item.GetProperty("occurredAtUtc").GetDateTimeOffset().ToLocalTime().ToString("g")</small></div>}</div>}
    <div class="form-actions"><button class="secondary-action" type="button" @onclick="@(()=>HistoryDialog=false)">@T("بستن","إغلاق","Close")</button></div>
</BarangModal>

@code {
    private List<Row> Rows=[]; private bool Loading,Dialog,HistoryDialog,ReadOnly,Success; private string? Message; private Row? Editing; private string Search="", Code="",Name="",Description="",Source="Automatic",ApplicationScope="Order",Type="Percentage",Eligibility="General",Currency="IRR"; private decimal Value,MinimumQuantity,MinimumAmount; private int Priority; private bool Combinable,ReasonRequired; private DateOnly From=DateOnly.FromDateTime(DateTime.Today); private DateOnly? To; private JsonElement? History;
    protected override async Task OnInitializedAsync()=>await Load();
    private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
    private async Task Load(){Loading=true;var s=await Session();if(s is not null){var query="api/v1/pricing/discount-rules?includeInactive=false"+(string.IsNullOrWhiteSpace(Search)?"":"&search="+Uri.EscapeDataString(Search));var r=await Core.GetAsync(query,s.Value.Token,s.Value.Company,default);if(r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array)Rows=r.Value.EnumerateArray().Select(Parse).ToList();}Loading=false;}
    private Task ResetGrid(){Search="";return Load();}
    private async Task SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";await Load();}
    private void New(){Editing=null;ReadOnly=false;Code=Name=Description="";Source="Automatic";ApplicationScope="Order";Type="Percentage";Eligibility="General";Value=0;MinimumQuantity=MinimumAmount=0;Priority=0;Combinable=ReasonRequired=false;Currency="IRR";From=DateOnly.FromDateTime(DateTime.Today);To=null;Dialog=true;}
    private void Open(Row x,bool edit){Editing=x;ReadOnly=!edit;Code=x.Code;Name=x.Name;Description=x.Description??"";Source=x.Source;ApplicationScope=x.ApplicationScope;Type=x.Type;Eligibility=x.Eligibility;Value=x.Value;MinimumQuantity=x.MinimumQuantity??0;MinimumAmount=x.MinimumAmount??0;Priority=x.Priority;Combinable=x.Combinable;ReasonRequired=x.ReasonRequired;Currency=x.Currency;From=x.From;To=x.To;Dialog=true;}
    private async Task Save(){var s=await Session();if(s is null)return;object body=new{code=Code,discountType=Type=="Percentage"?1:0,scope=Eligibility switch{"Customer"=>1,"PartnerSource"=>2,_=>0},customerId=(Guid?)null,source=(int?)null,value=Value,currencyCode=Currency,validFrom=From,validTo=To,name=Name,description=Description,discountSource=Source=="Manual"?1:0,applicationScope=ApplicationScope=="Item"?0:1,customerGroupId=(Guid?)null,productId=(Guid?)null,productVariantId=(Guid?)null,minimumQuantity=MinimumQuantity==0?(decimal?)null:MinimumQuantity,minimumAmount=MinimumAmount==0?(decimal?)null:MinimumAmount,priority=Priority,isCombinable=Combinable,reasonRequired=ReasonRequired,version=Editing?.Version??0};ApiResult<JsonElement> r=Editing is null?await Core.SendAsync(HttpMethod.Post,"api/v1/pricing/discount-rules",body,s.Value.Token,s.Value.Company,default):await Core.SendAsync(HttpMethod.Put,$"api/v1/pricing/discount-rules/{Editing.Id}",new{command=body,isActive=Editing.Active},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){Dialog=false;await Load();}}
    private async Task Toggle(Row x){if(!await JS.InvokeAsync<bool>("confirm",x.Active?T("قاعده غیرفعال شود؟","تعطيل القاعدة؟","Deactivate this discount rule?"):T("قاعده فعال شود؟","تفعيل القاعدة؟","Activate this discount rule?")))return;var s=await Session();if(s is null)return;var body=new{command=new{code=x.Code,discountType=x.Type=="Percentage"?1:0,scope=x.Eligibility=="Customer"?1:x.Eligibility=="PartnerSource"?2:0,customerId=(Guid?)null,source=(int?)null,value=x.Value,currencyCode=x.Currency,validFrom=x.From,validTo=x.To,name=x.Name,description=x.Description,discountSource=x.Source=="Manual"?1:0,applicationScope=x.ApplicationScope=="Item"?0:1,priority=x.Priority,isCombinable=x.Combinable,reasonRequired=x.ReasonRequired,version=x.Version},isActive=!x.Active};var r=await Core.SendAsync(HttpMethod.Put,$"api/v1/pricing/discount-rules/{x.Id}",body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}
    private async Task Delete(Row x){if(!await JS.InvokeAsync<bool>("confirm",T("این قاعده حذف شود؟","حذف هذه القاعدة؟","Delete this discount rule?")))return;var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Delete,$"api/v1/pricing/discount-rules/{x.Id}?version={x.Version}",null,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}
    private async Task OpenHistory(Row x){var s=await Session();if(s is null)return;var r=await Core.GetAsync($"api/v1/pricing/discount-rules/{x.Id}/history",s.Value.Token,s.Value.Company,default);History=r.IsSuccess?r.Value:null;HistoryDialog=true;}
    private void Close()=>Dialog=false;private string HistoryAction(string? x)=>x switch{"pricing.discount.created"=>T("ایجاد","إنشاء","Created"),"pricing.discount.updated"=>T("ویرایش","تحرير","Edited"),"pricing.discount.activated"=>T("فعال‌سازی","تفعيل","Activated"),"pricing.discount.deactivated"=>T("غیرفعال‌سازی","تعطيل","Deactivated"),"pricing.discount.applied"=>T("اعمال","تطبيق","Applied"),"pricing.discount.deleted"=>T("حذف","حذف","Deleted"),_=>x??""};private void Show(ApiResult<JsonElement> r){Success=r.IsSuccess;Message=r.IsSuccess?T("عملیات با موفقیت انجام شد.","تمت العملية بنجاح.","Operation completed."):Error(r.ProblemCode);}
    private string Error(string? c)=>c switch{"pricing.discount.reason_required"=>T("دلیل تخفیف الزامی است.","سبب الخصم مطلوب.","A discount reason is required."),"pricing.discount.used"=>T("قاعده در سابقه قیمت‌گذاری استفاده شده و قابل حذف نیست.","القاعدة مستخدمة في سجل التسعير ولا يمكن حذفها.","The discount rule is used and cannot be deleted."),"pricing.tariff.overlap"=>T("بازه زمانی با قاعده فعال دیگری همپوشانی دارد.","الفترة تتداخل مع قاعدة نشطة أخرى.","The effective period overlaps another active rule."),_=>T("عملیات انجام نشد؛ جزئیات را بررسی کنید.","تعذر تنفيذ العملية؛ راجع التفاصيل.","Operation failed; review the details.")};
    private Row Parse(JsonElement x)=>new(x.GetProperty("id").GetGuid(),G(x,"code"),G(x,"name"),G(x,"description"),G(x,"discountType"),G(x,"discountSource"),G(x,"applicationScope"),G(x,"scope"),x.GetProperty("value").GetDecimal(),x.GetProperty("currencyCode").ToString(),x.GetProperty("priority").GetInt32(),x.GetProperty("isCombinable").GetBoolean(),x.GetProperty("reasonRequired").GetBoolean(),Canonical(x.GetProperty("validFrom").GetString()!),x.TryGetProperty("validTo",out var to)&&to.ValueKind!=JsonValueKind.Null?Canonical(to.GetString()!):null,x.GetProperty("isActive").GetBoolean(),x.GetProperty("version").GetInt64(),x.TryGetProperty("minimumQuantity",out var q)&&q.ValueKind!=JsonValueKind.Null?q.GetDecimal():null,x.TryGetProperty("minimumAmount",out var a)&&a.ValueKind!=JsonValueKind.Null?a.GetDecimal():null);
    private DateOnly Canonical(string value)=>Dates.TryParseCanonical(value,out var date)?date:default;private static string G(JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=JsonValueKind.Null?p.ToString():"";private string SourceText(string x)=>x=="Manual"?T("دستی","يدوي","Manual"):T("خودکار","تلقائي","Automatic");private string ScopeText(string x)=>x=="Item"?T("قلم سفارش","بند الطلب","Order item"):T("سفارش","الطلب","Order");private string T(string fa,string ar,string en)=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"en"=>en,"ar"=>ar,_=>fa};
    private sealed record Row(Guid Id,string Code,string Name,string? Description,string Type,string Source,string ApplicationScope,string Eligibility,decimal Value,string Currency,int Priority,bool Combinable,bool ReasonRequired,DateOnly From,DateOnly? To,bool Active,long Version,decimal? MinimumQuantity,decimal? MinimumAmount);
}
