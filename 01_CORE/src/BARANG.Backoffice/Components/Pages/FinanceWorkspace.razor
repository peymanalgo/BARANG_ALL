@page "/workspace/finance"
@page "/finance/{OrderId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["Module_finance"]</PageTitle>
<div class="page-heading"><h1>@L["Module_finance"]</h1></div>
@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}
<section class="panel"><label><span>@L["Module_orders"]</span><input @bind="OrderText" /></label><button type="button" class="secondary-action" @onclick="Load">@L["Refresh"]</button></section>
@if(OrderId is Guid){
<div class="management-grid"><section class="panel"><h2>@L["Action_Payment"]</h2>
<div class="form-grid single"><label><span>@L["Method"]</span><input @bind="Method" /></label><label><span>@L["Amount"]</span><input type="number" step="0.01" @bind="Amount" /></label><label><span>@L["Currency"]</span><input @bind="Currency" /></label><label><span>@L["ExternalReference"]</span><input @bind="Reference" /></label></div>
<button type="button" class="primary-link" @onclick="Pay">@L["Action_Payment"]</button><div class="record-list">@foreach(var x in Payments){<button type="button" class="record-row" @onclick="()=>PaymentId=x.Id"><span><strong>@x.Type · @x.Amount @x.Currency</strong><small>@x.Reference</small></span></button>}</div><label><span>@L["Reason"]</span><input @bind="Reason" /></label><button type="button" class="secondary-action" @onclick="Reverse">@L["Action_Release"]</button></section>
<section class="panel"><h2>@L["Action_Approval"]</h2><dl>@foreach(var x in Balance){<dt>@x.Key</dt><dd>@x.Value</dd>}</dl><label><span>@L["Status"]</span><select @bind="Decision"><option value="Approved">@L["DecisionApproved"]</option><option value="Rejected">@L["DecisionRejected"]</option><option value="Suspended">@L["DecisionSuspended"]</option><option value="Pending">@L["DecisionPending"]</option></select></label><label><span>@L["Reason"]</span><input @bind="Reason" /></label><button type="button" class="primary-link" @onclick="Decide">@L["Save"]</button></section></div>
<section class="panel"><h2>@L["Action_Invoice"]</h2><div class="form-actions"><button type="button" @onclick="InvoiceProforma">@L["InvoiceProforma"]</button><button type="button" @onclick="InvoiceFinal">@L["Action_Invoice"]</button></div><BarangJsonGrid Json="@Invoices" /></section>
<section class="panel"><h2>@L["Timeline"]</h2><div class="record-list">@foreach(var x in History){<div class="record-row"><span><strong>@x.Type</strong><small>@x.At · @x.Summary</small></span></div>}</div></section>}
@code{
[Parameter]public Guid?OrderId{get;set;}private string OrderText="",Method="Cash",Currency="IRR",Reference="",Reason="",Decision="Approved",Invoices="";private decimal Amount;private long FinanceVersion;private Guid?PaymentId;private bool Success;private string?Message;private List<Payment>Payments=[];private List<Event>History=[];private Dictionary<string,string>Balance=[];
protected override async Task OnParametersSetAsync(){if(OrderId is Guid id){OrderText=id.ToString();await Load();}}
private async Task Load(){if(!Guid.TryParse(OrderText,out var id))return;OrderId=id;var s=await Session();if(s is null)return;var ps=await Core.GetAsync($"api/v1/orders/{id}/finance/payments",s.Value.Token,s.Value.Company,default);if(ps.IsSuccess)Payments=ps.Value.EnumerateArray().Select(x=>new Payment(x.GetProperty("id").GetGuid(),G(x,"recordType"),x.GetProperty("amount").GetDecimal(),G(x,"currencyCode"),G(x,"referenceNumber"))).ToList();var b=await Core.GetAsync($"api/v1/orders/{id}/finance/balance",s.Value.Token,s.Value.Company,default);if(b.IsSuccess)foreach(var k in new[]{"orderTotal","paid","reversed","netPaid","remaining","overpaid","currencyCode"})Balance[k]=G(b.Value,k);var f=await Core.GetAsync($"api/v1/orders/{id}/finance/status",s.Value.Token,s.Value.Company,default);if(f.IsSuccess){FinanceVersion=f.Value.GetProperty("version").GetInt64();Decision=G(f.Value,"status");}var h=await Core.GetAsync($"api/v1/orders/{id}/finance/history",s.Value.Token,s.Value.Company,default);if(h.IsSuccess)History=h.Value.EnumerateArray().Select(x=>new Event(G(x,"eventType"),G(x,"occurredAtUtc"),G(x,"summary"))).ToList();var inv=await Core.GetAsync($"api/v1/orders/{id}/finance/invoices",s.Value.Token,s.Value.Company,default);Invoices=inv.IsSuccess?inv.Value.ToString():"";}
private async Task Pay()=>await Act($"api/v1/orders/{OrderId}/finance/payments",new{paymentMethodCode=Method,amount=Amount,currencyCode=Currency,referenceNumber=string.IsNullOrWhiteSpace(Reference)?null:Reference,paidAtUtc=DateTimeOffset.UtcNow});private async Task Reverse(){if(PaymentId is Guid id)await Act($"api/v1/orders/{OrderId}/finance/payments/{id}/reversals",new{amount=Amount,reason=Reason,referenceNumber=string.IsNullOrWhiteSpace(Reference)?null:Reference});}private async Task Decide()=>await Act($"api/v1/orders/{OrderId}/finance/decision",new{targetStatus=Decision,reason=string.IsNullOrWhiteSpace(Reason)?null:Reason,version=FinanceVersion});private Task InvoiceProforma()=>Act($"api/v1/orders/{OrderId}/finance/invoices/Proforma",new{});private Task InvoiceFinal()=>Act($"api/v1/orders/{OrderId}/finance/invoices/Invoice",new{});
private async Task Act(string path,object body){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,path,body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private sealed record Payment(Guid Id,string Type,decimal Amount,string Currency,string Reference);private sealed record Event(string Type,string At,string Summary);
}
