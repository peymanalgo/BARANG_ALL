@page "/manage/{Entity}"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<CrudStrings> C
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@Title · BARANG</PageTitle>
<nav class="breadcrumbs"><a href="/">BARANG</a><span>/</span><span>@Title</span></nav>
<div class="crud-header"><div><span class="eyebrow">BARANG ERP</span><h1>@Title</h1><p>@Subtitle</p></div><button type="button" class="btn btn-primary" @onclick="New"><BarangIcon Name="plus" /> @AddLabel</button></div>
<section class="crud-card">
 <div class="crud-toolbar"><label class="search-box"><BarangIcon Name="search" /><input @bind="Search" @bind:event="oninput" placeholder="@C["SearchHint"]" /></label><button type="button" class="btn btn-secondary" @onclick="Load"><BarangIcon Name="reset" /> @C["Reset"]</button></div>
 @if(Loading){<BarangLoadingState Text="@C["Loading"]" />}
 else if(Rows.Count==0){<CrudEmptyState/>}
 else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th><BarangSortHeader Label="@C["Code"]" Active="@(SortColumn=="code")" Descending="@(!SortAscending)" Clicked='()=>SortBy("code")' /></th><th><BarangSortHeader Label="@C["Name"]" Active="@(SortColumn=="name")" Descending="@(!SortAscending)" Clicked='()=>SortBy("name")' /></th>@if(IsProduct){<th>@C["Type"]</th><th>@C["Unit"]</th>}<th><BarangSortHeader Label="@C["Status"]" Active="@(SortColumn=="status")" Descending="@(!SortAscending)" Clicked='()=>SortBy("status")' /></th><th class="actions-column">@C["Actions"]</th></tr></thead><tbody>
 @foreach(var row in Paged){<tr><td><span class="code-pill">@row.Code</span></td><td><strong>@row.Name</strong></td>@if(IsProduct){<td>@Friendly(row.Kind)</td><td>@Friendly(row.Uom)</td>}<td><StatusBadge Active="@row.Active"/></td><td><BarangActionMenu><BarangIconButton Icon="eye" Label="@C["View"]" Semantic="info" Clicked="()=>Open(row,false)" /><BarangIconButton Icon="edit" Label="@C["Edit"]" Semantic="edit" Clicked="()=>Open(row,true)" /><BarangIconButton Icon="power" Label="@(row.Active?C["Deactivate"]:C["Activate"])" Semantic="@(row.Active?"warning":"success")" Disabled="@Busy" Clicked="()=>Toggle(row)" /></BarangActionMenu></td></tr>}
 </tbody></table></div><div class="grid-pagination"><button type="button" class="btn btn-secondary btn-small" disabled="@(Page==1)" @onclick="()=>Page--">@C["Previous"]</button><span>@C["PageOf",Page,PageCount]</span><button type="button" class="btn btn-secondary btn-small" disabled="@(Page==PageCount)" @onclick="()=>Page++">@C["Next"]</button></div>}
</section>
@if(EditorOpen){<div class="dialog-backdrop" @onclick="Close"><section class="crud-dialog" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation><header><div><span class="eyebrow">@Title</span><h2>@(Id is null?AddLabel:C[Editable?"Edit":"View"])</h2></div><button type="button" class="dialog-close" title="@C["Close"]" aria-label="@C["Close"]" @onclick="Close"><BarangIcon Name="close" /></button></header><div class="form-grid">
 <label><span>@C["Code"]</span><input @bind="Code" disabled="@(Id is not null||!Editable)" /></label><label><span>@C["Name"]</span><input @bind="Name" disabled="@(!Editable)" /></label>
 @if(IsProduct){<label><span>@C["ProductType"]</span><ReferenceSelect TypeCode="product.type" UseCode="true" @bind-Value="Kind" Disabled="@(!Editable)" /></label><label><span>@C["Uom"]</span><ReferenceSelect TypeCode="unit.of.measure" UseCode="true" @bind-Value="Uom" Disabled="@(!Editable)" /></label><label class="span-2"><span>@C["Description"]</span><textarea @bind="Description" disabled="@(!Editable)"></textarea></label>}
 </div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@C[Message]</div>}<footer><button type="button" class="btn btn-secondary" disabled="@Busy" @onclick="Close">@C["Cancel"]</button>@if(Editable){<button type="button" class="btn btn-primary" disabled="@Busy" @onclick="Save">@(Busy?C["Saving"]:C["Save"])</button>}</footer>
 @if(IsProduct&&Id is not null){<div class="detail-section"><div class="section-heading"><h3>@C["Variants"]</h3>@if(Editable){<button type="button" class="btn btn-secondary btn-small" @onclick="NewVariant"><BarangIcon Name="plus" /> @C["AddVariant"]</button>}</div>@if(Variants.Count==0){<CrudEmptyState/>}else{<div class="data-grid-wrap"><table class="data-grid compact"><thead><tr><th>@C["Sku"]</th><th>@C["Name"]</th><th>@C["Barcode"]</th><th>@C["Size"]</th><th>@C["Color"]</th><th>@C["Status"]</th><th></th></tr></thead><tbody>@foreach(var variant in Variants){<tr><td><span class="code-pill">@variant.Sku</span></td><td>@variant.Name</td><td>@variant.Barcode</td><td>@Friendly(variant.Size)</td><td>@Friendly(variant.Color)</td><td><StatusBadge Active="@variant.Active"/></td><td><BarangActionMenu><BarangIconButton Icon="edit" Label="@C["Edit"]" Semantic="edit" Clicked="()=>EditVariant(variant)" /><BarangIconButton Icon="power" Label="@(variant.Active?C["Deactivate"]:C["Activate"])" Semantic="@(variant.Active?"warning":"success")" Clicked="()=>ToggleVariant(variant)" /></BarangActionMenu></td></tr>}</tbody></table></div>}
 @if(VariantEditor){<div class="nested-editor form-grid"><label><span>@C["Sku"]</span><input @bind="VariantSku" disabled="@(VariantId is not null)" /></label><label><span>@C["Name"]</span><input @bind="VariantName" /></label><label><span>@C["Barcode"]</span><input @bind="VariantBarcode" /></label><label><span>@C["Size"]</span><ReferenceSelect TypeCode="product.size" UseCode="true" @bind-Value="VariantSize" /></label><label><span>@C["Color"]</span><ReferenceSelect TypeCode="product.color" UseCode="true" @bind-Value="VariantColor" /></label><div class="form-actions"><button type="button" class="btn btn-secondary" @onclick="()=>VariantEditor=false">@C["Cancel"]</button><button type="button" class="btn btn-primary" @onclick="SaveVariant">@C["Save"]</button></div></div>}</div>}
 </section></div>}
@code{
 [Parameter]public string Entity{get;set;}="companies";private Guid?Id,VariantId;private long Version,VariantVersion;private int Page=1;private const int PageSize=10;private bool Active=true,Success,Loading,EditorOpen,Editable=true,VariantEditor,Busy,SortAscending=true;private string SortColumn="code",Code="",Name="",Kind="",Uom="",Description="",Search="",VariantSku="",VariantName="",VariantBarcode="",VariantSize="",VariantColor="";private string?Message;private List<Row>Rows=[];private List<VariantRow>Variants=[];
 private bool IsProduct=>Entity.Equals("products",StringComparison.OrdinalIgnoreCase);private bool IsBranch=>Entity.Equals("branches",StringComparison.OrdinalIgnoreCase);private string Title=>IsProduct?C["Products"]:IsBranch?C["Branches"]:C["Companies"];private string Subtitle=>IsProduct?C["Description"]:C["Details"];private string AddLabel=>IsProduct?C["AddProduct"]:IsBranch?C["AddBranch"]:C["AddCompany"];private IEnumerable<Row>Filtered=>ApplySort(string.IsNullOrWhiteSpace(Search)?Rows:Rows.Where(x=>(x.Code+" "+x.Name+" "+x.Kind).Contains(Search,StringComparison.CurrentCultureIgnoreCase)));private IEnumerable<Row>Paged=>Filtered.Skip((Page-1)*PageSize).Take(PageSize);private int PageCount=>Math.Max(1,(int)Math.Ceiling(Filtered.Count()/(double)PageSize));private void SortBy(string column){if(SortColumn==column)SortAscending=!SortAscending;else{SortColumn=column;SortAscending=true;}Page=1;}private IEnumerable<Row>ApplySort(IEnumerable<Row>rows){Func<Row,object>key=SortColumn switch{"name"=>x=>x.Name,"status"=>x=>x.Active,_=>x=>x.Code};return SortAscending?rows.OrderBy(key):rows.OrderByDescending(key);}
 protected override async Task OnParametersSetAsync()=>await Load();private string Base()=>IsProduct?"api/v1/products":IsBranch?"api/v1/organization/branches":"api/v1/organization/companies";
 private async Task Load(){Loading=true;Rows=[];var s=await Session();if(s is null){Loading=false;return;}var path=Base()+(IsProduct?"?pageSize=100":"");var r=await Core.GetAsync(path,s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Show(r);Loading=false;return;}var root=r.Value.ValueKind==System.Text.Json.JsonValueKind.Object&&r.Value.TryGetProperty("items",out var items)?items:r.Value;foreach(var x in root.EnumerateArray())Rows.Add(new(x.GetProperty("id").GetGuid(),G(x,IsProduct?"productCode":"code"),G(x,IsProduct?"name":"displayName"),G(x,"productTypeCode"),G(x,"unitOfMeasureCode"),G(x,"description"),B(x,"isActive",true),N(x,"version")));Loading=false;}
 private void New(){Id=null;Version=0;Code=Name=Kind=Uom=Description="";Active=true;Editable=EditorOpen=true;Variants=[];Message=null;}private void Open(Row x,bool edit){Id=x.Id;Version=x.Version;Code=x.Code;Name=x.Name;Kind=x.Kind;Uom=x.Uom;Description=x.Description;Active=x.Active;Editable=edit;EditorOpen=true;Message=null;if(IsProduct)_=LoadVariants();}private void Close(){EditorOpen=false;VariantEditor=false;}
 private async Task Save(){if(Busy)return;if(string.IsNullOrWhiteSpace(Code)||string.IsNullOrWhiteSpace(Name)){Success=false;Message="ValidationError";return;}Busy=true;try{var s=await Session();if(s is null)return;object body=IsProduct?new{productCode=Code,name=Name,description=Description,productTypeCode=Kind,unitOfMeasureCode=Uom,version=Version}:Id is null?new{code=Code,displayName=Name}:new{name=Name,version=Version};var r=await Core.SendAsync(Id is null?HttpMethod.Post:HttpMethod.Put,Base()+(Id is Guid id?$"/{id}":""),body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){Close();await Load();}}finally{Busy=false;}}
 private async Task Toggle(Row row){if(Busy)return;Busy=true;try{var s=await Session();if(s is null)return;var r=await Core.SendAsync(IsProduct?HttpMethod.Post:HttpMethod.Put,$"{Base()}/{row.Id}/activation",new{isActive=!row.Active,version=row.Version},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}finally{Busy=false;}}
 private async Task LoadVariants(){Variants=[];if(Id is not Guid id)return;var s=await Session();if(s is null)return;var r=await Core.GetAsync($"api/v1/products/{id}/variants",s.Value.Token,s.Value.Company,default);if(r.IsSuccess)foreach(var x in r.Value.EnumerateArray())Variants.Add(new(x.GetProperty("id").GetGuid(),G(x,"sku"),G(x,"displayName"),G(x,"barcode"),G(x,"sizeCode"),G(x,"colorCode"),B(x,"isActive",true),N(x,"version")));}
 private void NewVariant(){VariantId=null;VariantVersion=0;VariantSku=VariantName=VariantBarcode=VariantSize=VariantColor="";VariantEditor=true;}private void EditVariant(VariantRow x){VariantId=x.Id;VariantVersion=x.Version;VariantSku=x.Sku;VariantName=x.Name;VariantBarcode=x.Barcode;VariantSize=x.Size;VariantColor=x.Color;VariantEditor=true;}
 private async Task SaveVariant(){if(Id is not Guid product)return;var s=await Session();if(s is null)return;var body=new{sku=VariantSku,displayName=VariantName,barcode=VariantBarcode,sizeCode=VariantSize,colorCode=VariantColor,version=VariantVersion};var path=VariantId is Guid variant?$"api/v1/product-variants/{variant}":$"api/v1/products/{product}/variants";var r=await Core.SendAsync(VariantId is null?HttpMethod.Post:HttpMethod.Put,path,body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){VariantEditor=false;await LoadVariants();}}
 private async Task ToggleVariant(VariantRow x){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/product-variants/{x.Id}/activation",new{isActive=!x.Active,version=x.Version},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await LoadVariants();}
 private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.ProblemCode=="organization.company.last_active_required"?"LastActiveCompanyRequired":r.Failure switch{ApiFailure.Forbidden=>"Forbidden",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"ValidationError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string Friendly(string v)=>string.IsNullOrWhiteSpace(v)?"—":System.Text.RegularExpressions.Regex.Replace(v.Replace('_',' '),"([a-z])([A-Z])","$1 $2");private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private static bool B(System.Text.Json.JsonElement x,string n,bool d=false)=>x.TryGetProperty(n,out var p)?p.GetBoolean():d;private static long N(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.GetInt64():0;private sealed record Row(Guid Id,string Code,string Name,string Kind,string Uom,string Description,bool Active,long Version);private sealed record VariantRow(Guid Id,string Sku,string Name,string Barcode,string Size,string Color,bool Active,long Version);
}
