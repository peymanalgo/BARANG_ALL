    }

    private async Task PrepareAccess()
    {
        if (Catalog.Count == 0)
        {
            SessionInfo? session = await Session(); if (session is null) return; AccessLoading = true; ApiResult<System.Text.Json.JsonElement> result = await Core.GetAsync("api/v1/security/permissions", session.Token, session.Company, Lifetime.Token); AccessLoading = false; if (!result.IsSuccess) { AccessError = true; return; } Catalog = result.Value.EnumerateArray().Select(ParsePermission).ToList(); ExpandedModules = Catalog.Select(x => x.Module).ToHashSet(StringComparer.Ordinal);
        }
        await Task.WhenAll(SearchAccessRoles(""), SearchAccessUsers(""));
    }
    private async Task SearchAccessRoles(string query) { SessionInfo? session = await Session(); if (session is null) return; ApiResult<System.Text.Json.JsonElement> result = await Core.GetAsync($"api/v1/security/roles/search?search={Uri.EscapeDataString(query)}&pageSize=50", session.Token, session.Company, Lifetime.Token); if (result.IsSuccess) AccessRoleOptions = result.Value.GetProperty("items").EnumerateArray().Select(ParseRole).Select(x => new SearchableSelectOption(x.Id.ToString(), $"{x.Title} · {x.Code}")).ToList(); }
    private async Task SearchAccessUsers(string query) { SessionInfo? session = await Session(); if (session is null) return; ApiResult<System.Text.Json.JsonElement> result = await Core.GetAsync($"api/v1/security/users/search?search={Uri.EscapeDataString(query)}&pageSize=50", session.Token, session.Company, Lifetime.Token); if (result.IsSuccess) AccessUserOptions = result.Value.GetProperty("items").EnumerateArray().Select(ParseUserRow).Select(x => new SearchableSelectOption(x.Id.ToString(), $"{x.PersonName} · {x.Username}")).ToList(); }
    private async Task SelectAccessRole(string id) { if (PermissionDirty) ResetPermissions(); AccessRoleId = id; AccessUserId = ""; if (Guid.TryParse(id, out Guid target)) await LoadPermissionTarget("role", target); }
    private async Task SelectAccessUser(string id) { if (PermissionDirty) ResetPermissions(); AccessUserId = id; AccessRoleId = ""; if (Guid.TryParse(id, out Guid target)) await LoadPermissionTarget("user", target); }
    private async Task LoadPermissionTarget(string kind, Guid id)
    {
        AccessLoading = true; AccessError = false; SessionInfo? session = await Session(); if (session is null) return; ApiResult<System.Text.Json.JsonElement> result = await Core.GetAsync($"api/v1/security/{(kind == "role" ? "roles" : "users")}/{id}/permission-target", session.Token, session.Company, Lifetime.Token); AccessLoading = false; if (!result.IsSuccess) { AccessError = true; return; }
        System.Text.Json.JsonElement root = result.Value; Dictionary<Guid, PermissionAssignment> assignments = root.GetProperty("permissions").EnumerateArray().ToDictionary(x => x.GetProperty("permissionId").GetGuid(), x => new PermissionAssignment(Bool(x, "direct"), Bool(x, "inherited"), Bool(x, "effective")));
        List<PermissionItem> values = Catalog.Select(x => x with { Direct = assignments.TryGetValue(x.Id, out PermissionAssignment? a) && a.Direct, Inherited = assignments.TryGetValue(x.Id, out a) && a.Inherited, Effective = assignments.TryGetValue(x.Id, out a) && a.Effective }).ToList();
        Target = new(kind, id, Text(root, "targetName"), Long(root, "version"), values); OriginalDirect = values.Where(x => x.Direct).Select(x => x.Id).ToHashSet();
    }
    private void SetPermission(PermissionItem permission, bool value) { if (Target is null) return; permission.Direct = value; permission.Effective = value || permission.Inherited; }
    private void SetModule(PermissionModule module, bool value) { foreach (PermissionItem permission in module.Permissions) SetPermission(permission, value); }
    private void ResetPermissions() { if (Target is null) return; foreach (PermissionItem p in Target.Permissions) { p.Direct = OriginalDirect.Contains(p.Id); p.Effective = p.Direct || p.Inherited; } }
    private async Task SavePermissions()
    {
        PermissionTarget? target = Target;
        if (target is null) return;

        SessionInfo? session = await Session();
        if (session is null) return;

        SavingPermissions = true;
        Guid[] ids = target.Permissions.Where(x => x.Direct).Select(x => x.Id).ToArray();
        ApiResult<System.Text.Json.JsonElement> result = await Core.SendAsync(
            HttpMethod.Put,
            $"api/v1/security/{(target.Kind == "role" ? "roles" : "users")}/{target.Id}/permissions",
            new { version = target.Version, permissionIds = ids },
            session.Token,
            session.Company,
            Lifetime.Token);
        SavingPermissions = false;
        ShowResult(result);

        // The administrator can change or clear the target while the request is in flight.
        // Refresh only the target that was actually saved; otherwise leave the new selection alone.
        if (result.IsSuccess && Target is { } current && current.Kind == target.Kind && current.Id == target.Id)
            await LoadPermissionTarget(target.Kind, target.Id);
    }
    private void ClearTarget() { if (PermissionDirty) ResetPermissions(); Target = null; AccessRoleId = AccessUserId = ""; }
    private void ExpandAll() => ExpandedModules = VisibleModules.Select(x => x.Code).ToHashSet(StringComparer.Ordinal);
    private void CollapseAll() => ExpandedModules.Clear();
    private void ToggleModule(string module) { if (!ExpandedModules.Add(module)) ExpandedModules.Remove(module); }
    private IReadOnlyList<PermissionModule> VisibleModules => (Target?.Permissions ?? Catalog).GroupBy(x => x.Module).Select(g => new PermissionModule(g.Key, g.ToList())).Where(m => PermissionSearch.Length == 0 || Segment(m.Code).Contains(PermissionSearch, StringComparison.CurrentCultureIgnoreCase) || m.Permissions.Any(IsMatch)).OrderBy(x => Segment(x.Code)).ToArray();
    private bool IsMatch(PermissionFeature feature) => PermissionSearch.Length > 0 && (FeatureLabel(feature.Path).Contains(PermissionSearch, StringComparison.CurrentCultureIgnoreCase) || feature.Permissions.Any(IsMatch));
    private bool IsMatch(PermissionItem permission) => PermissionSearch.Length > 0 && (permission.Code.Contains(PermissionSearch, StringComparison.OrdinalIgnoreCase) || FeatureLabel(permission.FeaturePath).Contains(PermissionSearch, StringComparison.CurrentCultureIgnoreCase) || ActionLabel(permission.Action).Contains(PermissionSearch, StringComparison.CurrentCultureIgnoreCase));

    private RenderFragment Pager(int Page, int TotalPages, bool IsRole = false) => builder =>
    {
        if (TotalPages <= 1) return; int sequence = 0; builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "uam-pager");
        builder.OpenElement(sequence++, "button"); builder.AddAttribute(sequence++, "type", "button"); builder.AddAttribute(sequence++, "class", "btn btn-secondary btn-small"); builder.AddAttribute(sequence++, "disabled", Page <= 1); builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, async () => { if (IsRole) { RolePage--; await LoadRoles(); } else { UserPage--; await LoadUsers(); } })); builder.AddContent(sequence++, U["Previous"]); builder.CloseElement();
        builder.OpenElement(sequence++, "span"); builder.AddContent(sequence++, U["PageOf", Page, TotalPages]); builder.CloseElement();
        builder.OpenElement(sequence++, "button"); builder.AddAttribute(sequence++, "type", "button"); builder.AddAttribute(sequence++, "class", "btn btn-secondary btn-small"); builder.AddAttribute(sequence++, "disabled", Page >= TotalPages); builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, async () => { if (IsRole) { RolePage++; await LoadRoles(); } else { UserPage++; await LoadUsers(); } })); builder.AddContent(sequence++, U["Next"]); builder.CloseElement(); builder.CloseElement();
    };
    private RenderFragment PersonCard(PersonInfo Person) => builder =>
    {
        int s = 0; builder.OpenElement(s++, "section"); builder.AddAttribute(s++, "class", "uam-person-card"); builder.OpenElement(s++, "div"); builder.AddMarkupContent(s++, "<span class=\"person-avatar\" aria-hidden=\"true\">●</span>"); builder.OpenElement(s++, "span"); builder.OpenElement(s++, "strong"); builder.AddContent(s++, Person.FullName); builder.CloseElement(); builder.OpenElement(s++, "small"); builder.AddContent(s++, $"{U["PersonnelCode"]}: {Person.PersonnelCode}"); builder.CloseElement(); builder.CloseElement(); builder.CloseElement();
        foreach ((string label, string value) in new[] { (U["Mobile"].Value, Person.Mobile), (U["Email"].Value, Person.Email), (U["Organization"].Value, Person.Organization), (U["AccountStatus"].Value, Person.Active ? U["Active"].Value : U["Inactive"].Value) }) { builder.OpenElement(s++, "dl"); builder.OpenElement(s++, "dt"); builder.AddContent(s++, label); builder.CloseElement(); builder.OpenElement(s++, "dd"); builder.AddContent(s++, string.IsNullOrWhiteSpace(value) ? "—" : value); builder.CloseElement(); builder.CloseElement(); }
        builder.OpenElement(s++, "a"); builder.AddAttribute(s++, "class", "btn btn-secondary btn-small"); builder.AddAttribute(s++, "href", $"/master/persons?personId={Person.Id}"); builder.AddContent(s++, U["ViewPerson"]); builder.CloseElement(); builder.CloseElement();
    };

    private void CloseDialogs() { ShowAddUser = ShowUserDetail = ShowRoleDialog = ShowSubstitutionDialog = ShowSubstitutionView = EditingUser = false; SelectedPerson = null; SelectedUser = null; EditingRole = null; ViewedSubstitution = null; }
    private void ShowNotice(string key, bool success) { Notice = key; NoticeSuccess = success; }
    private void ShowResult(ApiResult<System.Text.Json.JsonElement> result, string success = "Saved") => ShowNotice(result.IsSuccess ? success : result.Failure switch { ApiFailure.Forbidden or ApiFailure.Unauthorized => "Forbidden", ApiFailure.Conflict => "Conflict", _ => "ValidationError" }, result.IsSuccess);
    private async Task<SessionInfo?> Session() { var user = (await AuthState.GetAuthenticationStateAsync()).User; return Guid.TryParse(user.FindFirst(AuthClaimTypes.CompanyId)?.Value, out Guid company) && user.FindFirst(AuthClaimTypes.AccessToken)?.Value is string token ? new(token, company) : null; }
    private string Segment(string value) { var localized = U[$"Segment_{value}"]; return localized.ResourceNotFound ? value.Replace('.', ' ') : localized.Value; }
    private string ActionLabel(string value) { var localized = U[$"Action_{value}"]; return localized.ResourceNotFound ? value.Replace('.', ' ') : localized.Value; }
    private string FeatureLabel(string path) => string.Join(" / ", path.Split('.').Select(Segment));
    private string StateLabel(string state) => state switch { "Active" => U["Enabled"], "Inactive" => U["Disabled"], "Locked" => U["Locked"], _ => state };
    private static string StateClass(string state) => state.ToLowerInvariant();
    private string FormatDate(DateTimeOffset? date) => date is null ? "—" : Dates.Format(date.Value, System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
    private static string Text(System.Text.Json.JsonElement x, string name) => x.TryGetProperty(name, out var p) && p.ValueKind != System.Text.Json.JsonValueKind.Null ? p.ToString() : "";
    private static bool Bool(System.Text.Json.JsonElement x, string name) => x.TryGetProperty(name, out var p) && p.ValueKind is System.Text.Json.JsonValueKind.True or System.Text.Json.JsonValueKind.False && p.GetBoolean();
    private static long Long(System.Text.Json.JsonElement x, string name) => x.TryGetProperty(name, out var p) && p.TryGetInt64(out long n) ? n : 0;
    private static DateTimeOffset? Date(System.Text.Json.JsonElement x, string name) => x.TryGetProperty(name, out var p) && p.ValueKind != System.Text.Json.JsonValueKind.Null && p.TryGetDateTimeOffset(out DateTimeOffset value) ? value : null;
    private static UserRow ParseUserRow(System.Text.Json.JsonElement x) { var a = x.GetProperty("account"); var p = x.GetProperty("person"); return new(a.GetProperty("id").GetGuid(), Text(a, "username"), Text(p, "fullName"), Text(p, "personnelCode"), Text(p, "mobile"), OrganizationOf(p), Text(a, "accountState"), Date(a, "lastLoginAtUtc"), x.GetProperty("assignedRoleTitles").EnumerateArray().Select(y => y.ToString()).ToList(), Long(a, "version")); }
    private static RoleRow ParseRole(System.Text.Json.JsonElement x) => new(x.GetProperty("id").GetGuid(), Text(x, "code"), Text(x, "displayTitle"), Text(x, "description"), Text(x, "scope"), Bool(x, "isSystem"), Bool(x, "isActive"), Long(x, "userCount"), Long(x, "version"));
    private static PersonCandidate ParsePersonCandidate(System.Text.Json.JsonElement x) => new(ParsePerson(x.GetProperty("person")), Bool(x, "hasUserAccount"));
    private static PersonInfo ParsePerson(System.Text.Json.JsonElement p) => new(p.GetProperty("id").GetGuid(), Text(p, "personnelCode"), Text(p, "fullName"), Text(p, "mobile"), Text(p, "email"), Bool(p, "isActive"), OrganizationOf(p));
    private static UserDetail ParseUserDetail(System.Text.Json.JsonElement x) { var a = x.GetProperty("account"); return new(new UserAccount(a.GetProperty("id").GetGuid(), Text(a, "username"), Text(a, "accountState"), Date(a, "lastLoginAtUtc"), Long(a, "version")), ParsePerson(x.GetProperty("person")), x.GetProperty("roles").EnumerateArray().Select(r => new UserRole(r.GetProperty("roleId").GetGuid(), Text(r, "roleTitle"), Text(r, "roleCode"), Text(r, "scope") == "System")).ToList()); }
    private static PermissionItem ParsePermission(System.Text.Json.JsonElement x) => new(x.GetProperty("id").GetGuid(), Text(x, "code"), Text(x, "module"), Text(x, "featurePath"), Text(x, "action"), Text(x, "capability"));
    private static string OrganizationOf(System.Text.Json.JsonElement p) => string.Join(" · ", new[] { Text(p, "positionTitle"), Text(p, "unitName"), Text(p, "branchName") }.Where(s => s.Length > 0));
    public void Dispose() { Lifetime.Cancel(); Lifetime.Dispose(); }

    private sealed record SessionInfo(string Token, Guid Company);
    private sealed record UserRow(Guid Id, string Username, string PersonName, string PersonnelCode, string Mobile, string Organization, string State, DateTimeOffset? LastLogin, IReadOnlyList<string> Roles, long Version);
    private sealed record RoleRow(Guid Id, string Code, string Title, string Description, string Scope, bool System, bool Active, long UserCount, long Version);
    private sealed record SubstitutionRow(Guid Id, Guid PrincipalUserId, string PrincipalName, Guid SubstituteUserId, string SubstituteName, DateTimeOffset EffectiveFromUtc, DateTimeOffset EffectiveToUtc, bool IsActive, string? Reason, long Version, string? CreatedByName, DateTimeOffset? RevokedAtUtc);
    private sealed record PersonInfo(Guid Id, string PersonnelCode, string FullName, string Mobile, string Email, bool Active, string Organization);
    private sealed record PersonCandidate(PersonInfo Person, bool HasAccount);
    private sealed record UserAccount(Guid Id, string Username, string State, DateTimeOffset? LastLogin, long Version);
    private sealed record UserRole(Guid RoleId, string Title, string Code, bool System);
    private sealed record UserDetail(UserAccount Account, PersonInfo Person, IReadOnlyList<UserRole> Roles);
    private sealed record PermissionAssignment(bool Direct, bool Inherited, bool Effective);
    private sealed record PermissionTarget(string Kind, Guid Id, string Name, long Version, List<PermissionItem> Permissions);
    private sealed record PermissionItem(Guid Id, string Code, string Module, string FeaturePath, string Action, string Capability) { public bool Direct { get; set; } public bool Inherited { get; set; } public bool Effective { get; set; } }
    private sealed record PermissionFeature(string Path, List<PermissionItem> Permissions);
    private sealed record PermissionModule(string Code, List<PermissionItem> Permissions)
    {
        public IReadOnlyList<PermissionFeature> Features => Permissions.Where(x => x.Capability != "Special").GroupBy(x => x.FeaturePath).Select(g => new PermissionFeature(g.Key, g.ToList())).OrderBy(x => x.Path).ToArray();
        public IReadOnlyList<PermissionItem> Special => Permissions.Where(x => x.Capability == "Special").OrderBy(x => x.Code).ToArray();
    }
}
