        await LoadUsers();
    }
    private async Task SelectTab(string tab) { ActiveTab = tab; Notice = null; if (tab == "users") await LoadUsers(); else if (tab == "roles") await LoadRoles(); else if (tab == "substitutions") await LoadSubstitutions(); else await PrepareAccess(); }

    private async Task LoadSubstitutions()
