        DateTime local = date.Value.ToDateTime(parsed, DateTimeKind.Unspecified); return new DateTimeOffset(local, TimeZoneInfo.Local.GetUtcOffset(local)).ToUniversalTime();
    }
    private async Task CreateSubstitution()
    {
        SubstitutionError = null; if (!Guid.TryParse(SubstitutionPrincipalId, out Guid principal) || !Guid.TryParse(SubstitutionSubstituteId, out Guid substitute) || LocalUtc(SubstitutionFromDate, SubstitutionFromTime) is not { } from || LocalUtc(SubstitutionToDate, SubstitutionToTime) is not { } to) { SubstitutionError = U["ValidationError"]; return; }
        SessionInfo? session = await Session(); if (session is null) return; SavingSubstitution = true;
        ApiResult<System.Text.Json.JsonElement> result = await Core.SendAsync(HttpMethod.Post, "api/v1/workflows/definition/runtime/substitutions", new { principalUserId = principal, substituteUserId = substitute, effectiveFromUtc = from, effectiveToUtc = to, reason = string.IsNullOrWhiteSpace(SubstitutionReason) ? null : SubstitutionReason.Trim() }, session.Token, session.Company, Lifetime.Token);
