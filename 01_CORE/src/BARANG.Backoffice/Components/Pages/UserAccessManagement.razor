        string path = $"api/v1/security/roles/search?search={Uri.EscapeDataString(RoleSearch)}&sortBy={RoleSort}&descending={RoleDescending.ToString().ToLowerInvariant()}&pageNumber={RolePage}&pageSize={PageSize}";
        ApiResult<System.Text.Json.JsonElement> result = await Core.GetAsync(path, session.Token, session.Company, Lifetime.Token); RolesLoading = false; if (!result.IsSuccess) { RolesError = true; return; }
        System.Text.Json.JsonElement root = result.Value; long total = Long(root, "totalCount"); RoleTotalPages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize)); Roles = root.GetProperty("items").EnumerateArray().Select(ParseRole).ToList();
    }
    private async Task ChangeRoleSearch(ChangeEventArgs e) { RoleSearch = e.Value?.ToString() ?? ""; RolePage = 1; await LoadRoles(); }
    private async Task SortRoles(string sort) { if (RoleSort == sort) RoleDescending = !RoleDescending; else { RoleSort = sort; RoleDescending = false; } await LoadRoles(); }

    private void OpenAddUser() { CloseDialogs(); ShowAddUser = true; }
    private async Task SearchPersons(string query)
    {
        if (SelectedPerson is not null) return;
        PersonCandidates = []; if (query.Trim().Length < 2) return; SessionInfo? session = await Session(); if (session is null) return;
        ApiResult<System.Text.Json.JsonElement> result = await Core.GetAsync($"api/v1/security/users/person-candidates?search={Uri.EscapeDataString(query)}&take=30", session.Token, session.Company, Lifetime.Token);
