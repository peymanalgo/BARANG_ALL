@page "/admin/user-access"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthPolicies.UserAccessManagement)]
@implements IDisposable
@inject IStringLocalizer<UserAccessStrings> U
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates

<PageTitle>@U["Title"] · BARANG</PageTitle>

<header class="uam-heading">
    <div><h1>@U["Title"]</h1><p>@U["Subtitle"]</p></div>
</header>

<nav class="uam-tabs" role="tablist" aria-label="@U["Title"]">
    <button type="button" role="tab" aria-selected="@(ActiveTab == "users")" class="@(ActiveTab == "users" ? "active" : null)" @onclick='() => SelectTab("users")'><BarangIcon Name="users" />@U["Users"]</button>
    <button type="button" role="tab" aria-selected="@(ActiveTab == "roles")" class="@(ActiveTab == "roles" ? "active" : null)" @onclick='() => SelectTab("roles")'><BarangIcon Name="shield" />@U["Roles"]</button>
    <button type="button" role="tab" aria-selected="@(ActiveTab == "substitutions")" class="@(ActiveTab == "substitutions" ? "active" : null)" @onclick='() => SelectTab("substitutions")'><BarangIcon Name="calendar" />@U["Substitutions"]</button>
    <button type="button" role="tab" aria-selected="@(ActiveTab == "access")" class="@(ActiveTab == "access" ? "active" : null)" @onclick='() => SelectTab("access")'><BarangIcon Name="key" />@U["Access"]</button>
</nav>

@if (Notice is not null)
{
    <div class="@(NoticeSuccess ? "inline-success" : "inline-error")" role="status">@U[Notice]</div>
}

@if (ActiveTab == "users")
{
    <section class="crud-card uam-panel" role="tabpanel">
        <div class="uam-toolbar">
            <label class="search-box uam-search"><BarangIcon Name="search" /><input value="@UserSearch" @onchange="ChangeUserSearch" placeholder="@U["SearchUsers"]" /></label>
            <select class="uam-select" value="@UserState" @onchange="ChangeUserState" aria-label="@U["AccountStatus"]"><option value="">@U["AllStatuses"]</option><option value="Active">@U["Enabled"]</option><option value="Inactive">@U["Disabled"]</option><option value="Locked">@U["Locked"]</option></select>
            <button type="button" class="btn btn-secondary" @onclick="LoadUsers"><BarangIcon Name="refresh" />@U["Refresh"]</button>
            <button type="button" class="btn btn-primary uam-primary-action" @onclick="OpenAddUser"><BarangIcon Name="plus" /> @L["Add"]</button>
        </div>
        @if (UsersLoading) { <div class="uam-state"><span class="uam-spinner"></span>@U["Loading"]</div> }
        else if (UsersError) { <div class="uam-state error">@U["LoadError"] <button type="button" class="btn btn-secondary btn-small" @onclick="LoadUsers">@U["Refresh"]</button></div> }
        else if (Users.Count == 0) { <div class="uam-state"><BarangIcon Name="users" />@U["NoUsers"]</div> }
        else
        {
            <div class="data-grid-wrap uam-users-grid-wrap"><table class="data-grid uam-grid uam-users-grid"><thead><tr>
                <th class="uam-col-person"><BarangSortHeader Label="@U["PersonFullName"]" Active="@(UserSort=="person")" Descending="@UserDescending" Clicked='() => SortUsers("person")' /></th>
                <th class="uam-col-username"><BarangSortHeader Label="@U["Username"]" Active="@(UserSort=="username")" Descending="@UserDescending" Clicked='() => SortUsers("username")' /></th>
                <th class="uam-col-code">@U["PersonnelCode"]</th><th class="uam-col-roles">@U["AssignedRoles"]</th><th class="uam-col-status">@U["AccountStatus"]</th><th class="uam-col-login">@U["LastLogin"]</th><th class="uam-col-actions">@U["Actions"]</th>
            </tr></thead><tbody>
            @foreach (UserRow row in Users)
            {
                <tr><td class="uam-col-person"><strong>@row.PersonName</strong><small class="uam-cell-note" title="@row.Organization">@row.Organization</small></td><td class="uam-col-username" dir="ltr"><span class="code-pill uam-username" title="@row.Username">@row.Username</span></td><td class="uam-col-code" dir="ltr">@row.PersonnelCode</td><td class="uam-col-roles"><span class="uam-role-summary" title="@string.Join("، ",row.Roles)">@(row.Roles.Count == 0 ? "—" : string.Join("، ", row.Roles))</span></td><td class="uam-col-status"><span class="status-badge @StateClass(row.State)">@StateLabel(row.State)</span></td><td class="uam-col-login">@FormatDate(row.LastLogin)</td><td class="uam-col-actions"><BarangActionMenu><BarangIconButton Icon="eye" Label="@U["View"]" Clicked="() => OpenUser(row.Id, false)" />@if(CanUserAccountEdit){<BarangIconButton Icon="edit" Label="@U["Edit"]" Clicked="() => OpenUser(row.Id, true)" />}</BarangActionMenu></td></tr>
            }
            </tbody></table></div>
        }
        @Pager(UserPage, UserTotalPages)
    </section>
}
else if (ActiveTab == "roles")
{
    <section class="crud-card uam-panel" role="tabpanel">
        <div class="uam-toolbar">
            <label class="search-box uam-search"><BarangIcon Name="search" /><input value="@RoleSearch" @onchange="ChangeRoleSearch" placeholder="@U["SearchRoles"]" /></label>
            <button type="button" class="btn btn-secondary" @onclick="LoadRoles"><BarangIcon Name="refresh" />@U["Refresh"]</button>
            <button type="button" class="btn btn-primary uam-primary-action" @onclick="OpenAddRole"><BarangIcon Name="plus" /> @L["Add"]</button>
        </div>
        @if (RolesLoading) { <div class="uam-state"><span class="uam-spinner"></span>@U["Loading"]</div> }
        else if (RolesError) { <div class="uam-state error">@U["LoadError"] <button type="button" class="btn btn-secondary btn-small" @onclick="LoadRoles">@U["Refresh"]</button></div> }
        else if (Roles.Count == 0) { <div class="uam-state"><BarangIcon Name="shield" />@U["NoRoles"]</div> }
        else
        {
            <div class="data-grid-wrap"><table class="data-grid uam-grid"><thead><tr><th><BarangSortHeader Label="@U["RoleName"]" Active="@(RoleSort=="title")" Descending="@RoleDescending" Clicked='() => SortRoles("title")' /></th><th><BarangSortHeader Label="@U["Code"]" Active="@(RoleSort=="code")" Descending="@RoleDescending" Clicked='() => SortRoles("code")' /></th><th>@U["Scope"]</th><th>@U["UserCount"]</th><th>@U["AccountStatus"]</th><th>@U["Actions"]</th></tr></thead><tbody>
            @foreach (RoleRow role in Roles)
            {
                <tr><td><strong>@role.Title</strong><small class="uam-cell-note">@role.Description</small></td><td dir="ltr"><span class="code-pill">@role.Code</span></td><td><span class="uam-scope">@(role.Scope == "System" ? U["SystemScope"] : U["CompanyScope"])</span></td><td>@role.UserCount</td><td><span class="status-badge @(role.Active ? "active" : "inactive")">@(role.Active ? U["Active"] : U["Inactive"])</span></td><td><BarangIconButton Icon="edit" Label="@U["Edit"]" Clicked="() => OpenRole(role)" /></td></tr>
            }
            </tbody></table></div>
        }
        @Pager(RolePage, RoleTotalPages, true)
    </section>
}
else if (ActiveTab == "substitutions")
{
    <section class="crud-card uam-panel" role="tabpanel">
        <div class="uam-toolbar">
            <label class="search-box uam-search"><BarangIcon Name="search" /><span class="sr-only">@U["SearchSubstitutions"]</span><input value="@SubstitutionSearch" @onchange="ChangeSubstitutionSearch" placeholder="@U["SearchSubstitutions"]" /></label>
            <button type="button" class="btn btn-secondary" @onclick="LoadSubstitutions"><BarangIcon Name="refresh" />@U["Refresh"]</button>
            @if (CanManageSubstitutions) { <button type="button" class="btn btn-primary uam-primary-action" @onclick="OpenAddSubstitution"><BarangIcon Name="plus" /> @L["Add"]</button> }
        </div>
        @if (SubstitutionsLoading) { <div class="uam-state"><span class="uam-spinner"></span>@U["Loading"]</div> }
        else if (SubstitutionsError) { <div class="uam-state error">@U["LoadError"] <button type="button" class="btn btn-secondary btn-small" @onclick="LoadSubstitutions">@U["Refresh"]</button></div> }
        else if (Substitutions.Count == 0) { <div class="uam-state"><BarangIcon Name="calendar" />@U["NoSubstitutions"]</div> }
        else
        {
            <div class="data-grid-wrap"><table class="data-grid uam-grid"><thead><tr><th>@U["Principal"]</th><th>@U["Substitute"]</th><th>@U["EffectiveFrom"]</th><th>@U["EffectiveTo"]</th><th>@U["Status"]</th><th>@U["Reason"]</th><th>@U["CreatedBy"]</th><th>@U["Actions"]</th></tr></thead><tbody>
            @foreach (SubstitutionRow row in Substitutions)
            {
                <tr><td><strong>@row.PrincipalName</strong></td><td><strong>@row.SubstituteName</strong></td><td>@FormatDate(row.EffectiveFromUtc)</td><td>@FormatDate(row.EffectiveToUtc)</td><td><span class="status-badge @SubstitutionStatusClass(row)">@SubstitutionStatus(row)</span></td><td><span class="uam-cell-note" title="@row.Reason">@(string.IsNullOrWhiteSpace(row.Reason) ? "—" : row.Reason)</span></td><td>@(string.IsNullOrWhiteSpace(row.CreatedByName) ? "—" : row.CreatedByName)</td><td><BarangActionMenu><BarangIconButton Icon="eye" Label="@U["View"]" Clicked="() => ViewSubstitution(row)" />@if (CanManageSubstitutions && row.IsActive) { <BarangIconButton Icon="close" Label="@U["RevokeSubstitution"]" Clicked="() => AskRevokeSubstitution(row)" /> }</BarangActionMenu></td></tr>
            }
            </tbody></table></div>
        }
    </section>
}
else
{
    <section class="uam-access" role="tabpanel">
        <div class="crud-card uam-target-panel">
            <div class="uam-target-selectors">
                <label><span>@U["RoleSelector"]</span><SearchableSelect Options="AccessRoleOptions" Value="@AccessRoleId" ValueChanged="SelectAccessRole" SearchChanged="SearchAccessRoles" Disabled="@(AccessUserId.Length > 0)" Placeholder="@U["SearchRoles"]" /></label>
                <span class="uam-or">—</span>
                <label><span>@U["UserSelector"]</span><SearchableSelect Options="AccessUserOptions" Value="@AccessUserId" ValueChanged="SelectAccessUser" SearchChanged="SearchAccessUsers" Disabled="@(AccessRoleId.Length > 0)" Placeholder="@U["SearchUsers"]" /></label>
                @if (AccessRoleId.Length > 0 || AccessUserId.Length > 0) { <button type="button" class="btn btn-secondary" @onclick="ClearTarget">@U["ClearSelection"]</button> }
            </div>
            @if (Target is null) { <div class="uam-target-empty"><BarangIcon Name="key" />@U["SelectOneTarget"]</div> }
            else { <div class="uam-target-summary"><span><small>@U["SelectedTarget"]</small><strong>@Target.Name</strong></span>@if (Target.Kind == "user") { <span class="uam-legend"><i class="direct"></i>@U["Direct"] <i class="inherited"></i>@U["ViaRole"] <i class="effective"></i>@U["Effective"]</span> }</div> }
        </div>

        @if (AccessLoading) { <div class="crud-card uam-state"><span class="uam-spinner"></span>@U["Loading"]</div> }
        else if (AccessError) { <div class="crud-card uam-state error">@U["LoadError"]</div> }
        else if (Target is not null)
        {
            <div class="uam-savebar @(PermissionDirty ? "dirty" : null)"><span>@(PermissionDirty ? U["UnsavedChanges"] : U["SelectedTarget"] + ": " + Target.Name)</span><div><button type="button" class="btn btn-secondary" disabled="@(!PermissionDirty)" @onclick="ResetPermissions">@U["Cancel"]</button><button type="button" class="btn btn-primary" disabled="@(!PermissionDirty || SavingPermissions)" @onclick="SavePermissions">@U["Save"]</button></div></div>
            @if (Target.Kind == "user") { <div class="uam-inherited-note"><BarangIcon Name="info" />@U["InheritedNotice"]</div> }
            <section class="crud-card uam-permission-card">
                <div class="uam-toolbar permission-toolbar"><label class="search-box uam-search"><BarangIcon Name="search" /><input @bind="PermissionSearch" @bind:event="oninput" placeholder="@U["SearchPermissions"]" /></label><button type="button" class="btn btn-secondary btn-small" @onclick="ExpandAll">@U["ExpandAll"]</button><button type="button" class="btn btn-secondary btn-small" @onclick="CollapseAll">@U["CollapseAll"]</button></div>
                @if (VisibleModules.Count == 0) { <div class="uam-state">@U["NoPermissions"]</div> }
                else
                {
                    <div class="permission-matrix" role="treegrid">
                        <div class="permission-head"><span>@U["Feature"]</span>@foreach (string capability in CrudCapabilities) { <span>@U[capability]</span> }</div>
                        @foreach (PermissionModule module in VisibleModules)
                        {
                            <section class="permission-module" @key="module.Code">
                                <header><button type="button" class="permission-expander" aria-expanded="@ExpandedModules.Contains(module.Code)" @onclick="() => ToggleModule(module.Code)"><BarangIcon Name="chevron-down" /> <strong>@Segment(module.Code)</strong><small>@module.Permissions.Count</small></button><span class="module-bulk"><BarangIconButton Icon="check" Label="@U["SelectSubtree"]" Semantic="success" Clicked="() => SetModule(module, true)" /><BarangIconButton Icon="close" Label="@U["ClearSubtree"]" Semantic="neutral" Clicked="() => SetModule(module, false)" /></span></header>
                                @if (ExpandedModules.Contains(module.Code))
                                {
                                    @foreach (PermissionFeature feature in module.Features)
                                    {
                                        <div class="permission-row @(IsMatch(feature) ? "match" : null)" role="row">
                                            <span class="permission-name"><strong>@FeatureLabel(feature.Path)</strong><small dir="ltr">@feature.Path</small></span>
                                            @foreach (string capability in CrudCapabilities)
                                            {
                                                PermissionItem? permission = feature.Permissions.FirstOrDefault(x => x.Capability == capability);
                                                <span class="permission-cell">
                                                @if (permission is null) { <input type="checkbox" disabled title="@U["NotApplicable"]" aria-label="@U["NotApplicable"]" /> }
                                                else { <input type="checkbox" checked="@permission.Direct" @onchange="e => SetPermission(permission, e.Value is true)" aria-label="@($"{FeatureLabel(feature.Path)} {U[capability]}")" /> @if (Target.Kind == "user") { <i class="permission-via @(permission.Inherited ? "on" : null)" title="@U["ViaRole"]"></i><i class="permission-effective @(permission.Effective ? "on" : null)" title="@U["Effective"]"></i> } }
                                                </span>
                                            }
                                        </div>
                                    }
                                    @if (module.Special.Count > 0)
                                    {
                                        <details class="special-permissions" open="@(PermissionSearch.Length > 0)"><summary>@U["SpecialPermissions"] (@module.Special.Count)</summary>
                                        @foreach (PermissionItem permission in module.Special)
                                        {
                                            <label class="special-permission @(IsMatch(permission) ? "match" : null)"><input type="checkbox" checked="@permission.Direct" @onchange="e => SetPermission(permission, e.Value is true)" /><span><strong>@FeatureLabel(permission.FeaturePath) · @ActionLabel(permission.Action)</strong><small dir="ltr">@permission.Code</small></span>@if (Target.Kind == "user") { <em class="@(permission.Inherited ? "inherited" : null)">@U["ViaRole"]</em><em class="@(permission.Effective ? "effective" : null)">@U["Effective"]</em> }</label>
                                        }
                                        </details>
                                    }
                                }
                            </section>
                        }
                    </div>
                }
            </section>
        }
    </section>
}

@if (ShowAddUser)
{
    <div class="dialog-backdrop" @onclick="CloseDialogs"><section class="crud-dialog uam-dialog wide" role="dialog" aria-modal="true" aria-label="@U["AddUser"]" @onclick:stopPropagation>
        <header><h2>@U["AddUser"]</h2><BarangIconButton Icon="close" Label="@U["Close"]" Clicked="CloseDialogs" /></header>
        <div class="uam-dialog-body"><label class="uam-field"><span>@U["Person"]</span>@if (SelectedPerson is null) { <SearchableSelect Options="PersonOptions" Value="@SelectedPersonId" ValueChanged="SelectPerson" SearchChanged="SearchPersons" Placeholder="@U["SearchPersons"]" /> } else { <div class="uam-selected-person"><span>@SelectedPerson.FullName · @SelectedPerson.PersonnelCode</span><button type="button" class="btn btn-secondary btn-small" @onclick="ChangePerson">@U["ClearSelection"]</button></div> }</label><p class="field-help">@U["SelectEligiblePerson"]</p>
        @if (SelectedPerson is not null)
        {
            @PersonCard(SelectedPerson)
            <section class="uam-account-panel"><h3>@U["UserAccountInformation"]</h3><div class="form-grid"><label><span>@U["Username"]</span><input dir="ltr" autocomplete="username" @bind="NewUsername" /></label><label><span>@U["NewPassword"]</span><input type="password" dir="ltr" autocomplete="new-password" @bind="NewPassword" /></label><label><span>@U["ConfirmPassword"]</span><input type="password" dir="ltr" autocomplete="new-password" @bind="ConfirmPassword" /></label><label class="uam-check"><input type="checkbox" @bind="NewEnabled" /><span>@U["AccountEnabled"]</span></label><label><span>@U["AssignedRoles"]</span><SearchableSelect Options="RoleAssignmentOptions" @bind-Value="NewRoleId" SearchChanged="SearchAssignmentRoles" Placeholder="@U["SearchRoles"]" /></label></div><p class="field-help">@U["PasswordPolicy"]</p></section>
        }
        </div><footer><button type="button" class="btn btn-secondary" @onclick="CloseDialogs">@U["Close"]</button><button type="button" class="btn btn-primary" disabled="@(SelectedPerson is null || SavingDialog)" @onclick="CreateUser"><BarangIcon Name="plus" /> @L["Add"]</button></footer>
    </section></div>
}

@if (ShowUserDetail && SelectedUser is not null)
{
    <div class="dialog-backdrop" @onclick="CloseDialogs"><section class="crud-dialog uam-dialog wide" role="dialog" aria-modal="true" aria-label="@U["Users"]" @onclick:stopPropagation>
        <header><h2>@(EditingUser?U["EditUserAccount"]:SelectedUser.Person.FullName)</h2><BarangIconButton Icon="close" Label="@U["Close"]" Clicked="CloseDialogs" /></header><div class="uam-dialog-body">
        @PersonCard(SelectedUser.Person)
        <section class="uam-account-panel"><h3>@U["UserAccountInformation"]</h3><div class="form-grid"><label><span>@U["Username"]</span><input dir="ltr" @bind="EditUsername" disabled="@(!EditingUser||!CanEditUser)" /></label>@if(EditingUser&&CanManageUserStatus){<label class="uam-check"><input type="checkbox" @bind="EditEnabled" /><span>@U["AccountEnabled"]</span></label>}else{<label><span>@U["AccountStatus"]</span><input value="@StateLabel(SelectedUser.Account.State)" disabled /></label>}<label><span>@U["LastLogin"]</span><input value="@FormatDate(SelectedUser.Account.LastLogin)" disabled /></label></div>@if(EditingUser){<div class="uam-inline-actions"><button type="button" class="btn btn-secondary" disabled="@SavingDialog" @onclick="CancelUserEdit">@U["Cancel"]</button><button type="button" class="btn btn-primary" disabled="@SavingDialog" @onclick="SaveUserAccount">@U["Save"]</button></div>}else if(CanUserAccountEdit){<div class="uam-inline-actions"><button type="button" class="btn btn-primary" @onclick="BeginUserEdit"><BarangIcon Name="edit" />@U["Edit"]</button>@if(SelectedUser.Account.State=="Locked"&&CanManageUserStatus){<button type="button" class="btn btn-secondary" @onclick="UnlockSelectedUser">@U["Unlock"]</button>}</div>}</section>
        @if(!EditingUser&&CanResetUserPassword){<section class="uam-account-panel"><h3>@U["ResetPassword"]</h3><div class="form-grid"><label><span>@U["NewPassword"]</span><input type="password" autocomplete="new-password" @bind="ResetPasswordValue" /></label><label><span>@U["ConfirmPassword"]</span><input type="password" autocomplete="new-password" @bind="ResetPasswordConfirm" /></label></div><button type="button" class="btn btn-secondary" @onclick="ResetSelectedPassword">@U["ResetPassword"]</button></section>}
        @if(!EditingUser){<section class="uam-account-panel"><h3>@U["AssignedRoles"]</h3><div class="uam-role-assignment"><SearchableSelect Options="RoleAssignmentOptions" @bind-Value="DetailRoleId" SearchChanged="SearchAssignmentRoles" Placeholder="@U["SearchRoles"]" /><button type="button" class="btn btn-primary" @onclick="AssignDetailRole">@U["AssignRole"]</button></div><div class="uam-chip-list">@foreach (UserRole role in SelectedUser.Roles) { <span class="uam-chip">@role.Title @if (!role.System) { <BarangIconButton Icon="unlink" Label="@U["Revoke"]" Clicked="() => RevokeDetailRole(role)" /> }</span> }</div></section>}
        </div>@if(!EditingUser){<footer><button type="button" class="btn btn-secondary" @onclick="CloseDialogs">@U["Close"]</button></footer>}
    </section></div>
}

@if (ShowRoleDialog)
{
    <div class="dialog-backdrop" @onclick="CloseDialogs"><section class="crud-dialog uam-dialog" role="dialog" aria-modal="true" aria-label="@U["Roles"]" @onclick:stopPropagation><header><h2>@(EditingRole is null ? U["AddRole"] : U["RoleName"])</h2><BarangIconButton Icon="close" Label="@U["Close"]" Clicked="CloseDialogs" /></header><div class="uam-dialog-body"><div class="form-grid"><label><span>@U["Code"]</span><input dir="ltr" disabled="@(EditingRole is not null)" @bind="RoleCode" /></label><label><span>@U["RoleName"]</span><input disabled="@(EditingRole?.System == true)" @bind="RoleTitle" /></label><label class="form-span"><span>@U["Description"]</span><textarea disabled="@(EditingRole?.System == true)" @bind="RoleDescription"></textarea></label></div>@if (EditingRole?.System == true) { <div class="uam-inherited-note">@U["ProtectedRole"]</div> }</div><footer><button type="button" class="btn btn-secondary" @onclick="CloseDialogs">@U["Close"]</button>@if (EditingRole?.System != true) { <button type="button" class="btn btn-primary" @onclick="SaveRole">@U["Save"]</button>@if (EditingRole is not null) { <button type="button" class="btn btn-secondary" @onclick="ToggleRole">@(EditingRole.Active ? U["Disable"] : U["Enable"])</button><button type="button" class="btn btn-danger" @onclick="() => ConfirmRoleDelete = true">@U["DeleteRole"]</button> } }</footer></section></div>
}

<BarangConfirmDialog Open="ConfirmRoleDelete" Title="@U["DeleteRole"]" Description="@U["ConfirmDeleteRole"]" CancelText="@U["Close"]" ConfirmText="@U["Confirm"]" Cancel="() => ConfirmRoleDelete = false" Confirm="DeleteRole" />

@if (ShowSubstitutionDialog)
{
    <div class="dialog-backdrop" @onclick="CloseDialogs"><section class="crud-dialog uam-dialog wide" role="dialog" aria-modal="true" aria-label="@U["AddSubstitution"]" @onclick:stopPropagation><header><h2>@U["AddSubstitution"]</h2><BarangIconButton Icon="close" Label="@U["Close"]" Clicked="CloseDialogs" /></header><div class="uam-dialog-body"><div class="form-grid">
        <label><span>@U["Principal"]</span><SearchableSelect Options="PrincipalOptions" Value="@SubstitutionPrincipalId" ValueChanged="SelectSubstitutionPrincipal" SearchChanged="SearchSubstitutionPrincipals" Placeholder="@U["SearchUsers"]" /></label>
        <label><span>@U["Substitute"]</span><SearchableSelect Options="SubstituteOptions" Value="@SubstitutionSubstituteId" ValueChanged="SelectSubstitutionSubstitute" SearchChanged="SearchSubstitutionSubstitutes" Placeholder="@U["SearchEligibleUsers"]" /></label>
        <label><span>@U["EffectiveFrom"]</span><LocaleDateInput Name="substitution-from" Value="@SubstitutionFromDate" ValueChanged="@(x => SubstitutionFromDate = x)" /></label>
        <label><span>@U["Time"]</span><input type="time" value="@SubstitutionFromTime" @oninput='e => SubstitutionFromTime = e.Value?.ToString() ?? "09:00"' /></label>
        <label><span>@U["EffectiveTo"]</span><LocaleDateInput Name="substitution-to" Value="@SubstitutionToDate" ValueChanged="@(x => SubstitutionToDate = x)" /></label>
        <label><span>@U["Time"]</span><input type="time" value="@SubstitutionToTime" @oninput='e => SubstitutionToTime = e.Value?.ToString() ?? "17:00"' /></label>
        <label class="form-span"><span>@U["Reason"]</span><textarea maxlength="500" @bind="SubstitutionReason"></textarea></label>
        </div>@if (SubstitutionError is not null) { <div class="field-validation" role="alert">@SubstitutionError</div> }</div><footer><button type="button" class="btn btn-secondary" @onclick="CloseDialogs">@U["Close"]</button><button type="button" class="btn btn-primary" disabled="@SavingSubstitution" @onclick="CreateSubstitution">@U["Save"]</button></footer></section></div>
}

@if (ShowSubstitutionView && ViewedSubstitution is not null)
{
    <div class="dialog-backdrop" @onclick="CloseDialogs"><section class="crud-dialog uam-dialog" role="dialog" aria-modal="true" aria-label="@U["View"]" @onclick:stopPropagation><header><h2>@U["View"]</h2><BarangIconButton Icon="close" Label="@U["Close"]" Clicked="CloseDialogs" /></header><div class="uam-dialog-body"><dl class="uam-detail-list"><dt>@U["Principal"]</dt><dd>@ViewedSubstitution.PrincipalName</dd><dt>@U["Substitute"]</dt><dd>@ViewedSubstitution.SubstituteName</dd><dt>@U["EffectiveFrom"]</dt><dd>@FormatDate(ViewedSubstitution.EffectiveFromUtc)</dd><dt>@U["EffectiveTo"]</dt><dd>@FormatDate(ViewedSubstitution.EffectiveToUtc)</dd><dt>@U["Status"]</dt><dd><span class="status-badge @SubstitutionStatusClass(ViewedSubstitution)">@SubstitutionStatus(ViewedSubstitution)</span></dd><dt>@U["Reason"]</dt><dd>@(string.IsNullOrWhiteSpace(ViewedSubstitution.Reason) ? "—" : ViewedSubstitution.Reason)</dd><dt>@U["CreatedBy"]</dt><dd>@(string.IsNullOrWhiteSpace(ViewedSubstitution.CreatedByName) ? "—" : ViewedSubstitution.CreatedByName)</dd></dl></div><footer><button type="button" class="btn btn-secondary" @onclick="CloseDialogs">@U["Close"]</button></footer></section></div>
}

<BarangConfirmDialog Open="ConfirmSubstitutionRevoke" Title="@U["RevokeSubstitution"]" Description="@U["ConfirmRevokeSubstitution"]" CancelText="@U["Close"]" ConfirmText="@U["Confirm"]" Cancel="() => ConfirmSubstitutionRevoke = false" Confirm="RevokeSubstitution" />

@code {
