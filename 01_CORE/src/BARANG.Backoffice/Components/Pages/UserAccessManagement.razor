    }
    private string SubstitutionStatus(SubstitutionRow row) => row.RevokedAtUtc is not null || !row.IsActive ? U["Revoked"] : DateTimeOffset.UtcNow < row.EffectiveFromUtc ? U["Scheduled"] : DateTimeOffset.UtcNow >= row.EffectiveToUtc ? U["Expired"] : U["Active"];
    private string SubstitutionStatusClass(SubstitutionRow row) => row.RevokedAtUtc is not null || !row.IsActive ? "inactive" : DateTimeOffset.UtcNow < row.EffectiveFromUtc ? "pending" : DateTimeOffset.UtcNow >= row.EffectiveToUtc ? "expired" : "active";
    private SubstitutionRow ParseSubstitution(System.Text.Json.JsonElement x) => new(Guid.Parse(Text(x, "id")), Guid.Parse(Text(x, "principalUserId")), Text(x, "principalName"), Guid.Parse(Text(x, "substituteUserId")), Text(x, "substituteName"), x.GetProperty("effectiveFromUtc").GetDateTimeOffset(), x.GetProperty("effectiveToUtc").GetDateTimeOffset(), Bool(x, "isActive"), Text(x, "reason"), Long(x, "version"), Text(x, "createdByName"), x.TryGetProperty("revokedAtUtc", out var revoked) && revoked.ValueKind != System.Text.Json.JsonValueKind.Null ? revoked.GetDateTimeOffset() : null);

    private async Task LoadUsers()
    {
        UsersLoading = true; UsersError = false; Notice = null;
        SessionInfo? session = await Session(); if (session is null) { UsersLoading = false; UsersError = true; return; }
        string state = UserState.Length == 0 ? "" : $"&accountState={Uri.EscapeDataString(UserState)}";
        string path = $"api/v1/security/users/search?search={Uri.EscapeDataString(UserSearch)}{state}&sortBy={UserSort}&descending={UserDescending.ToString().ToLowerInvariant()}&pageNumber={UserPage}&pageSize={PageSize}";
        ApiResult<System.Text.Json.JsonElement> result = await Core.GetAsync(path, session.Token, session.Company, Lifetime.Token);
        UsersLoading = false; if (!result.IsSuccess) { UsersError = true; return; }
