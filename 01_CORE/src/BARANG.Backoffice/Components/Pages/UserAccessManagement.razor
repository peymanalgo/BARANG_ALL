    private IReadOnlyList<SearchableSelectOption> PersonOptions => PersonCandidates.Where(x => !x.HasAccount).Select(x => new SearchableSelectOption(x.Person.Id.ToString(), $"{x.Person.FullName} · {x.Person.PersonnelCode} · {x.Person.Mobile}")).ToArray();
    private Task SelectPerson(string id) { SelectedPersonId = id; SelectedPerson = PersonCandidates.FirstOrDefault(x => x.Person.Id.ToString() == id)?.Person; NewUsername = ""; return Task.CompletedTask; }
    private void ChangePerson() { SelectedPerson = null; SelectedPersonId = ""; PersonCandidates = []; NewUsername = NewPassword = ConfirmPassword = ""; }
    private async Task CreateUser()
    {
        if (SelectedPerson is null || NewPassword != ConfirmPassword) { ShowNotice(NewPassword != ConfirmPassword ? "PasswordMismatch" : "ValidationError", false); return; }
        SessionInfo? session = await Session(); if (session is null) return; SavingDialog = true;
        Guid[] roleIds = Guid.TryParse(NewRoleId, out Guid role) ? [role] : [];
        ApiResult<System.Text.Json.JsonElement> result = await Core.SendAsync(HttpMethod.Post, "api/v1/security/users/linked", new { personId = SelectedPerson.Id, username = NewUsername, password = NewPassword, enabled = NewEnabled, roleIds }, session.Token, session.Company, Lifetime.Token);
        SavingDialog = false; ShowResult(result, "Created"); if (result.IsSuccess) { CloseDialogs(); await LoadUsers(); }
    }

    private async Task OpenUser(Guid id, bool edit = false)
    {
        SessionInfo? session = await Session(); if (session is null) return; ApiResult<System.Text.Json.JsonElement> result = await Core.GetAsync($"api/v1/security/users/{id}", session.Token, session.Company, Lifetime.Token); if (!result.IsSuccess) { ShowResult(result); return; }
        SelectedUser = ParseUserDetail(result.Value); EditUsername = SelectedUser.Account.Username; EditEnabled=SelectedUser.Account.State=="Active"; EditingUser=edit&&CanUserAccountEdit; ResetPasswordValue = ResetPasswordConfirm = DetailRoleId = ""; await SearchAssignmentRoles(""); ShowUserDetail = true;
    }
    private void BeginUserEdit(){if(SelectedUser is null||!CanUserAccountEdit)return;EditUsername=SelectedUser.Account.Username;EditEnabled=SelectedUser.Account.State=="Active";EditingUser=true;}
    private void CancelUserEdit(){if(SelectedUser is null)return;EditUsername=SelectedUser.Account.Username;EditEnabled=SelectedUser.Account.State=="Active";EditingUser=false;}
    private async Task SaveUserAccount()
    {
        if(SelectedUser is null||!CanUserAccountEdit||string.IsNullOrWhiteSpace(EditUsername))return;
        SessionInfo? session=await Session();if(session is null)return;
        SavingDialog=true;Guid id=SelectedUser.Account.Id;long version=SelectedUser.Account.Version;
        if(CanEditUser&&!string.Equals(EditUsername.Trim(),SelectedUser.Account.Username,StringComparison.OrdinalIgnoreCase))
        {
            ApiResult<System.Text.Json.JsonElement> renamed=await Core.SendAsync(HttpMethod.Put,$"api/v1/security/users/{id}/account",new{username=EditUsername,version},session.Token,session.Company,Lifetime.Token);
            if(!renamed.IsSuccess){SavingDialog=false;ShowResult(renamed);return;}
            version=Long(renamed.Value,"version");
        }
        bool currentlyEnabled=SelectedUser.Account.State=="Active";
        if(CanManageUserStatus&&EditEnabled!=currentlyEnabled)
        {
            ApiResult<System.Text.Json.JsonElement> status=await Core.SendAsync(HttpMethod.Put,$"api/v1/security/users/{id}/activation",new{isActive=EditEnabled,version},session.Token,session.Company,Lifetime.Token);
            if(!status.IsSuccess){SavingDialog=false;ShowResult(status);return;}
        }
        SavingDialog=false;ShowNotice("Saved",true);await OpenUser(id,false);await LoadUsers();
    }
    private async Task UnlockSelectedUser() { if (SelectedUser is null) return; await UserAction(HttpMethod.Put, $"api/v1/security/users/{SelectedUser.Account.Id}/unlock", new { version = SelectedUser.Account.Version }); }
    private async Task ResetSelectedPassword()
    {
        if (SelectedUser is null || ResetPasswordValue != ResetPasswordConfirm) { ShowNotice("PasswordMismatch", false); return; }
        await UserAction(HttpMethod.Put, $"api/v1/security/users/{SelectedUser.Account.Id}/password", new { password = ResetPasswordValue }); ResetPasswordValue = ResetPasswordConfirm = "";
    }
    private async Task UserAction(HttpMethod method, string path, object body)
    {
        SessionInfo? session = await Session(); if (session is null || SelectedUser is null) return; ApiResult<System.Text.Json.JsonElement> result = await Core.SendAsync(method, path, body, session.Token, session.Company, Lifetime.Token); ShowResult(result); if (result.IsSuccess) { await OpenUser(SelectedUser.Account.Id, false); await LoadUsers(); }
    }
    private async Task SearchAssignmentRoles(string query)
    {
        SessionInfo? session = await Session(); if (session is null) return; ApiResult<System.Text.Json.JsonElement> result = await Core.GetAsync($"api/v1/security/roles/search?search={Uri.EscapeDataString(query)}&isActive=true&pageSize=50", session.Token, session.Company, Lifetime.Token);
        if (result.IsSuccess) RoleAssignmentOptions = result.Value.GetProperty("items").EnumerateArray().Select(ParseRole).Where(x => !x.System).Select(x => new SearchableSelectOption(x.Id.ToString(), $"{x.Title} · {x.Code}")).ToList();
    }
    private async Task AssignDetailRole()
    {
        if (SelectedUser is null || !Guid.TryParse(DetailRoleId, out Guid role)) return; SessionInfo? session = await Session(); if (session is null) return; ApiResult<System.Text.Json.JsonElement> result = await Core.SendAsync(HttpMethod.Post, $"api/v1/security/users/{SelectedUser.Account.Id}/roles", new { roleId = role, companyId = session.Company }, session.Token, session.Company, Lifetime.Token); ShowResult(result); if (result.IsSuccess) await OpenUser(SelectedUser.Account.Id);
    }
    private async Task RevokeDetailRole(UserRole role)
    {
        if (SelectedUser is null) return; SessionInfo? session = await Session(); if (session is null) return; ApiResult<System.Text.Json.JsonElement> result = await Core.SendAsync(HttpMethod.Delete, $"api/v1/security/users/{SelectedUser.Account.Id}/roles/{role.RoleId}/companies/{session.Company}", null, session.Token, session.Company, Lifetime.Token); ShowResult(result); if (result.IsSuccess) await OpenUser(SelectedUser.Account.Id);
    }

    private void OpenAddRole() { CloseDialogs(); EditingRole = null; RoleCode = RoleTitle = RoleDescription = ""; ShowRoleDialog = true; }
    private void OpenRole(RoleRow role) { CloseDialogs(); EditingRole = role; RoleCode = role.Code; RoleTitle = role.Title; RoleDescription = role.Description; ShowRoleDialog = true; }
    private async Task SaveRole()
    {
        SessionInfo? session = await Session(); if (session is null) return; string path = EditingRole is null ? "api/v1/security/roles" : $"api/v1/security/roles/{EditingRole.Id}"; object body = EditingRole is null ? new { code = RoleCode, displayTitle = RoleTitle, description = RoleDescription } : new { displayTitle = RoleTitle, description = RoleDescription, version = EditingRole.Version }; ApiResult<System.Text.Json.JsonElement> result = await Core.SendAsync(EditingRole is null ? HttpMethod.Post : HttpMethod.Put, path, body, session.Token, session.Company, Lifetime.Token); ShowResult(result, EditingRole is null ? "Created" : "Saved"); if (result.IsSuccess) { CloseDialogs(); await LoadRoles(); }
    }
    private async Task ToggleRole()
    {
        if (EditingRole is null) return; SessionInfo? session = await Session(); if (session is null) return; ApiResult<System.Text.Json.JsonElement> result = await Core.SendAsync(HttpMethod.Put, $"api/v1/security/roles/{EditingRole.Id}/activation", new { isActive = !EditingRole.Active, version = EditingRole.Version }, session.Token, session.Company, Lifetime.Token); ShowResult(result); if (result.IsSuccess) { CloseDialogs(); await LoadRoles(); }
    }
