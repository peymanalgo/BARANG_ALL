        SubstitutionsLoading = false; if (!result.IsSuccess) { SubstitutionsError = true; return; }
        IEnumerable<System.Text.Json.JsonElement> items = result.Value.ValueKind == System.Text.Json.JsonValueKind.Array ? result.Value.EnumerateArray() : result.Value.TryGetProperty("items", out var wrapped) ? wrapped.EnumerateArray() : [];
        Substitutions = items.Select(ParseSubstitution).ToList();
