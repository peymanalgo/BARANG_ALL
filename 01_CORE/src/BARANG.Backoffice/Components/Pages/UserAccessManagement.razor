    private async Task ChangeUserSearch(ChangeEventArgs e) { UserSearch = e.Value?.ToString() ?? ""; UserPage = 1; await LoadUsers(); }
    private async Task ChangeUserState(ChangeEventArgs e) { UserState = e.Value?.ToString() ?? ""; UserPage = 1; await LoadUsers(); }
    private async Task SortUsers(string sort) { if (UserSort == sort) UserDescending = !UserDescending; else { UserSort = sort; UserDescending = false; } await LoadUsers(); }

