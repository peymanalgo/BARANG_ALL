@page "/orders/new"
@page "/orders/{OrderId:guid}/edit"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<BusinessStrings> B
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject IStringLocalizer<ReferenceStrings> R
@inject IStringLocalizer<CartablePriorityStrings> P
@inject ILocaleDateService Dates
<PageTitle>@L["OrderWizard"] · BARANG</PageTitle>
<nav class="breadcrumbs"><a href="/workspace/orders">@L["Module_orders"]</a><span>/</span><span>@L["OrderWizard"]</span></nav>
<header class="page-heading"><div><h1>@L["OrderWizard"]</h1></div></header>
<WizardProgress Steps="@WizardSteps" CurrentStep="@CurrentStep" />
<section class="panel order-priority-panel"><label><span>@P["Priority"]</span><select name="order-priority" @bind="Priority"><option value="Normal">@P["Normal"]</option><option value="Important">@P["Important"]</option><option value="Urgent">@P["Urgent"]</option></select></label></section>
<style>.management-grid,.management-grid~section.panel,.order-services,.order-price-breakdown{display:none!important}section.panel:has(+.order-items-step),section.panel:has(+.order-print-step),section.panel:has(+.order-services-step),section.panel:has(+.order-shipping-step),section.panel:has(+.order-pricing-step),section.panel:has(+.order-review-step){display:none!important}.order-print-step{display:none!important}</style>
@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")" role="status">@L[Message]</div>}
@if (ValidationErrors.Count > 0 && CurrentStep != 3){<div class="wizard-error-backdrop" role="presentation"><section class="wizard-error-popup" role="alert" aria-live="assertive" aria-labelledby="wizard-error-title"><h2 id="wizard-error-title">@L["WizardValidationTitle"]</h2><ul>@foreach(var error in ValidationErrors){<li>@error</li>}</ul><button type="button" class="primary-link" @onclick="DismissValidation">@L["Close"]</button></section></div>}
@if (OrderId is null || CurrentStep == 1){
<section class="panel"><h2>@L["Wizard_Header"]</h2><p class="form-help">@L["OrderStep1Description"]</p><div class="form-grid"><label><span>@L["Branch"] *</span><SearchableSelect Name="order-branch" Options="BranchOptions" @bind-Value="BranchId" Placeholder="@L["Choose"]" /></label><label><span>@L["Customer"] *</span><SearchableSelect Name="order-customer" Options="CustomerOptions" Value="@CustomerId" ValueChanged="CustomerChanged" SearchChanged="SearchCustomers" Placeholder="@L["Choose"]" /></label><label><span>@L["OrderSource"] *</span><select @bind="Source" disabled="@(OrderId is not null)"><option value="Internal">@L["SourceInternal"]</option><option value="Web">@L["SourceWeb"]</option><option value="Mobile">@L["SourceMobile"]</option><option value="Partner">@L["SourcePartner"]</option></select></label><label><span>@L["ExternalReference"]</span><input @bind="ExternalReference" maxlength="150" /></label><label><span>@L["OrderDate"] *</span><LocaleDateInput Name="order-date" @bind-Value="OrderDate" /></label><label><span>@L["RequestedDelivery"]</span><LocaleDateInput Name="requested-delivery" @bind-Value="DeliveryDate" /></label><label class="span-2"><span>@L["Notes"]</span><textarea @bind="Notes" maxlength="2000"></textarea></label></div><div class="form-actions"><a class="secondary-action" href="/workspace/orders">@L["Cancel"]</a><button type="button" class="primary-link" @onclick="NextStep" disabled="@Saving">@L["Next"]</button></div></section>
}
@if(OrderId is Guid && CurrentStep==2)
{
    <section class="panel order-items-step">
        <h2>@L["Wizard_Items"]</h2>
        <p class="form-help">@L["OrderStep2Description"]</p>
        <div class="form-grid">
            <label><span>@L["Product"] *</span><SearchableSelect Name="order-item-product" Options="ProductOptions" Value="@ProductId" ValueChanged="SetProduct" SearchChanged="SearchProducts" Placeholder="@L["Choose"]" Disabled="@ItemViewMode" /></label>
            <label><span>@L["Variant"] *</span><SearchableSelect Name="order-item-sku" Options="VariantOptions" Value="@VariantId" ValueChanged="SetVariant" SearchChanged="SearchVariants" Disabled="@(ItemViewMode || string.IsNullOrWhiteSpace(ProductId))" Placeholder="@L["Choose"]" /></label>
            <label><span>@L["Quantity"] *</span><input name="order-item-quantity" type="number" min="0.01" step="0.01" @bind="Quantity" disabled="@ItemViewMode" /></label>
            <label><span>@L["Notes"]</span><input @bind="ItemNotes" maxlength="1000" disabled="@ItemViewMode" /></label>
        </div>
        @if(!string.IsNullOrWhiteSpace(ProductCharacteristics)){<div class="readonly-context" aria-live="polite">@ProductCharacteristics</div>}
        @if (ItemViewMode)
        {
            <div class="readonly-context" role="status">@L["Details"]</div>
            <div class="form-actions"><button type="button" class="secondary-action" @onclick="NewItem">@L["Close"]</button></div>
        }
        else
        {
            <div class="form-actions">
                <button type="button" class="secondary-action" @onclick="NewItem">@L["Cancel"]</button>
                <button type="button" class="primary-link" @onclick="SaveItem" disabled="@Saving">@(Saving ? L["Saving"] : (ItemId is null ? L["AddItem"] : L["Save"]))</button>
            </div>
        }
        <div class="data-grid-wrap">
            <table class="data-grid">
                <thead><tr><th>@L["Product"]</th><th>@L["Variant"]</th><th>@L["Quantity"]</th><th>@L["Unit"]</th><th class="actions-column">@L["Actions"]</th></tr></thead>
                <tbody>
                    @foreach(var row in Items)
                    {
                        <tr @key="row.Id">
                            <td>@ProductLabel(row)</td>
                            <td dir="ltr">@SkuLabel(row)</td>
                            <td>@row.Quantity</td>
                            <td>@ProductUnit(row.Product)</td>
                            <td class="row-actions">
                                <BarangIconButton Icon="eye" Semantic="info" Label="@L["View"]" Clicked="@(()=>ViewItem(row))" />
                                <BarangIconButton Icon="edit" Semantic="edit" Label="@L["Edit"]" Clicked="@(()=>EditItem(row))" />
                                <BarangIconButton Icon="trash" Semantic="danger" Label="@L["RemoveItem"]" Clicked="@(()=>RequestDeleteItem(row))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if(Items.Count==0){<div class="empty-state">@L["OrderItemsEmpty"]</div>}
        <div class="form-actions"><button type="button" class="secondary-action" @onclick="BackToHeader">@BackLabel</button><button type="button" class="primary-link" @onclick="NextFromItems">@L["Next"]</button></div>
    </section>
}
@if (DeleteDialogOpen && PendingDeleteItem is not null)
{
    <BarangConfirmDialog Open="true" Title="@L["RemoveItem"]" Description="@L["RemoveItem"]" CancelText="@L["Cancel"]" ConfirmText="@L["RemoveItem"]" BusyText="@L["Saving"]" Busy="@DeletingItem" Cancel="CancelDeleteItem" Confirm="ConfirmDeleteItem">
        <div><strong>@ProductLabel(PendingDeleteItem)</strong><br /><span dir="ltr">@SkuLabel(PendingDeleteItem)</span><br />@L["Quantity"]: @PendingDeleteItem.Quantity</div>
    </BarangConfirmDialog>
}
@if(OrderId is Guid && CurrentStep==3){<OrderPrintStep OrderId="@OrderId" NextRequested="@(()=>CurrentStep=4)" BackRequested="@(()=>CurrentStep=2)" />}
@if(OrderId is Guid && CurrentStep==4){<OrderStep4Panel OrderId="@OrderId" NextRequested="@(()=>CurrentStep=5)" BackRequested="@(()=>CurrentStep=3)" />}
@if(OrderId is Guid && CurrentStep==5){<OrderStep5Panel OrderId="@OrderId" NextRequested="@(()=>CurrentStep=6)" BackRequested="@(()=>CurrentStep=4)" />}
@if(OrderId is Guid && CurrentStep==6){<OrderStep6Panel OrderId="@OrderId" NextRequested="@(()=>CurrentStep=7)" BackRequested="@(()=>CurrentStep=5)" />}
@if(OrderId is Guid && CurrentStep==7){<OrderStep7Panel OrderId="@OrderId" BackRequested="@(()=>CurrentStep=6)" />}
@if(PreviewOpen && UploadedPreviewDataUrl is not null){<div class="dialog-backdrop" @onclick="CloseArtworkPreview"><section class="crud-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation><header><h2>@L["ArtworkPreview"]</h2><BarangIconButton Icon="close" Label="@L["Close"]" Clicked="CloseArtworkPreview" /></header><div class="artwork-preview-panel"><img src="@UploadedPreviewDataUrl" alt="@L["ArtworkPreview"]" /></div></section></div>}
@if(DesignPreviewOpen && SelectedDesignPreviewDataUrl is not null){<div class="dialog-backdrop" @onclick="CloseDesignPreview"><section class="crud-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation><header><h2>@L["ArtworkPreview"]</h2><BarangIconButton Icon="close" Label="@L["Close"]" Clicked="CloseDesignPreview" /></header><div class="artwork-preview-panel"><img src="@SelectedDesignPreviewDataUrl" alt="@L["ArtworkPreview"]" /></div></section></div>}
@code{
