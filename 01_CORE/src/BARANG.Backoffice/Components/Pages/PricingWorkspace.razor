    protected override async Task OnInitializedAsync()=>await Load();
    private async Task SelectWorkspace(string item){if(WorkspaceItem==item)return;ClearTransient();WorkspaceItem=item;Type=item switch{"Print"=>"Print","Packaging"=>"Packaging","Shipping"=>"Shipping","Design"=>"Design","AdditionalService"=>"AdditionalService",_=>""};Page=1;if(item is "Discounts" or "Taxes"){StateHasChanged();return;}await Load();}
    private void ClearTransient(){Message=null;Success=false;}
    private async Task Load(bool resetPage=false){if(resetPage)Page=1;LoadCancellation?.Cancel();LoadCancellation?.Dispose();CancellationTokenSource source=new();LoadCancellation=source;int generation=++LoadGeneration;Loading=true;StateHasChanged();try{var s=await Session();if(s is null)return;string query=$"api/v1/pricing/tariffs/?includeInactive={IncludeInactive.ToString().ToLowerInvariant()}";var r=await Core.GetAsync(query,s.Value.Token,s.Value.Company,source.Token);if(generation!=LoadGeneration)return;if(r.IsSuccess){JsonElement root=r.Value;Rows=root.ValueKind==JsonValueKind.Array?root.EnumerateArray().Select(Parse).Where(x=>x.Type is not TariffType.RawProduct).ToList():[];TotalRows=Rows.Count;}else Show(r);}catch(OperationCanceledException){}finally{if(generation==LoadGeneration){Loading=false;await InvokeAsync(StateHasChanged);}}}
