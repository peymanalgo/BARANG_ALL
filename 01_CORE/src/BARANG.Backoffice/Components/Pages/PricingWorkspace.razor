@page "/workspace/pricing"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ILocaleDateService Dates

<PageTitle>@Text("قیمت‌گذاری", "التسعير", "Pricing")</PageTitle>
<header class="crud-header"><div><h1>@Text("قیمت‌گذاری", "التسعير", "Pricing")</h1><p>@Text("مدیریت متمرکز قیمت‌های فروش", "إدارة موحدة لأسعار البيع", "Unified sales price management")</p></div></header>
<div class="reference-workspace pricing-reference-workspace" data-domain="pricing">
    <details class="reference-navigation" open>
        <summary>@Text("انواع قیمت‌گذاری", "أنواع التسعير", "Pricing types")</summary>
        <nav aria-label="@Text("انواع قیمت‌گذاری", "أنواع التسعير", "Pricing types")">
            <a href="#" class="@(WorkspaceItem=="Print"?"active":null)" aria-current="@(WorkspaceItem=="Print"?"page":null)" @onclick:preventDefault="true" @onclick="@(()=>SelectWorkspace("Print"))">@Text("قیمت چاپ", "سعر الطباعة", "Print Pricing")</a>
            <a href="#" class="@(WorkspaceItem=="Packaging"?"active":null)" aria-current="@(WorkspaceItem=="Packaging"?"page":null)" @onclick:preventDefault="true" @onclick="@(()=>SelectWorkspace("Packaging"))">@Text("قیمت بسته‌بندی", "سعر التغليف", "Packaging Pricing")</a>
            <a href="#" class="@(WorkspaceItem=="Shipping"?"active":null)" aria-current="@(WorkspaceItem=="Shipping"?"page":null)" @onclick:preventDefault="true" @onclick="@(()=>SelectWorkspace("Shipping"))">@Text("قیمت ارسال", "سعر الشحن", "Shipping Pricing")</a>
            <a href="#" class="@(WorkspaceItem=="Design"?"active":null)" aria-current="@(WorkspaceItem=="Design"?"page":null)" @onclick:preventDefault="true" @onclick="@(()=>SelectWorkspace("Design"))">@Text("قیمت طراحی", "سعر التصميم", "Design Pricing")</a>
            <a href="#" class="@(WorkspaceItem=="AdditionalService"?"active":null)" aria-current="@(WorkspaceItem=="AdditionalService"?"page":null)" @onclick:preventDefault="true" @onclick="@(()=>SelectWorkspace("AdditionalService"))">@Text("خدمات اضافه", "الخدمات الإضافية", "Additional Services")</a>
            <a href="#" class="@(WorkspaceItem=="Discounts"?"active":null)" aria-current="@(WorkspaceItem=="Discounts"?"page":null)" @onclick:preventDefault="true" @onclick='()=>{WorkspaceItem="Discounts";StateHasChanged();}'>@Text("تخفیف‌ها", "الخصومات", "Discounts")</a>
            <a href="#" class="@(WorkspaceItem=="Taxes"?"active":null)" aria-current="@(WorkspaceItem=="Taxes"?"page":null)" @onclick:preventDefault="true" @onclick='()=>{WorkspaceItem="Taxes";StateHasChanged();}'>@Text("مالیات", "الضرائب", "Taxes")</a>
        </nav>
    </details>
    <section class="reference-content" data-pricing-type="@WorkspaceItem">
@if (WorkspaceItem == "Discounts") { <DiscountRulesPanel /> }
else if (WorkspaceItem == "Taxes") { <TaxRulesPanel /> }
else {
<section class="crud-card" data-pricing-grid="@WorkspaceItem.ToLowerInvariant()">
    <header class="section-header"><div><h2>@WorkspaceHeading</h2><p class="reference-scope-note">@WorkspaceSubtitle</p></div><button type="button" class="btn btn-primary btn-small" @onclick="New"><BarangIcon Name="plus" /> @Text("افزودن", "إضافة", "Add")</button></header>
    @if (Message is not null) { <div class="@(Success ? "inline-success" : "inline-error")" role="status">@Message</div> }
    <div class="crud-toolbar"><label class="search-box"><input value="@Search" @oninput="SearchChanged" placeholder="@Text("جست‌وجو", "بحث", "Search")" aria-label="@Text("جست‌وجو", "بحث", "Search")" /></label><button type="button" class="btn btn-secondary" disabled="@Loading" @onclick="ResetGrid"><BarangIcon Name="refresh" /> @Text("بازنشانی", "إعادة ضبط", "Reset")</button></div>
    @if (Loading) { <BarangLoadingState Text="@Text("در حال بارگذاری…", "جار التحميل…", "Loading…")" /> }
    else if (!FilteredRows.Any()) { <CrudEmptyState /> }
    else { <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th><BarangSortHeader Label="@Text("کد", "الرمز", "Code")" Active="@(Sort=="Code")" Descending="Descending" Clicked="@(()=>ChangeSort("Code"))" /></th><th><BarangSortHeader Label="@Text("نام", "الاسم", "Name")" Active="@(Sort=="Name")" Descending="Descending" Clicked="@(()=>ChangeSort("Name"))" /></th><th>@ContextHeader</th><th>@BasisHeader</th><th><BarangSortHeader Label="@Text("مبلغ", "المبلغ", "Price")" Active="@(Sort=="Amount")" Descending="Descending" Clicked="@(()=>ChangeSort("Amount"))" /></th><th>@Text("ارز", "العملة", "Currency")</th><th>@Text("نسخه", "الإصدار", "Version")</th><th><BarangSortHeader Label="@Text("تاریخ شروع", "تاريخ البدء", "Start date")" Active="@(Sort=="From")" Descending="Descending" Clicked="@(()=>ChangeSort("From"))" /></th><th>@Text("وضعیت", "الحالة", "Status")</th><th>@Text("عملیات", "الإجراءات", "Actions")</th></tr></thead><tbody>@foreach(var row in PagedRows){<tr><td dir="ltr">@row.Code</td><td>@row.Name</td><td>@BusinessContext(row)</td><td>@BusinessBasis(row)</td><td>@row.Amount.ToString("N2", CultureInfo.CurrentCulture)</td><td>@row.Currency</td><td>@row.VersionNo</td><td>@DateText(row.From)</td><td><StatusBadge Active="row.Active" /></td><td ><BarangActionMenu><BarangIconButton Icon="eye" Semantic="info" Label="@Text("مشاهده", "عرض", "View")" Clicked="@(()=>Open(row,false))" /><BarangIconButton Icon="edit" Semantic="edit" Label="@Text("ویرایش", "تحرير", "Edit")" Clicked="@(()=>Open(row,true))" Disabled="@(!row.Active && row.VersionNo > 1)" /><BarangIconButton Icon="copy" Semantic="success" Label="@Text("نسخه جدید", "إصدار جديد", "New version")" Clicked="@(()=>NewVersion(row))" /><BarangIconButton Icon="history" Semantic="info" Label="@Text("تاریخچه", "السجل", "History")" Clicked="@(()=>ShowHistory(row))" /><BarangIconButton Icon="power" Semantic="warning" Label="@(row.Active ? Text("غیرفعال‌سازی", "تعطيل", "Deactivate") : Text("فعال‌سازی", "تفعيل", "Activate"))" Clicked="@(()=>Toggle(row))" /><BarangIconButton Icon="trash" Semantic="danger" Label="@Text("حذف", "حذف", "Delete")" Clicked="@(()=>Delete(row))" /></BarangActionMenu></td></tr>}</tbody></table></div><BarangPagination Page="Page" HasNext="@(TotalRows>Page*PageSize)" Disabled="Loading" PageLabel="" PreviousText="@Text("قبلی", "السابق", "Previous")" NextText="@Text("بعدی", "التالي", "Next")" Previous="@(()=>{_ = Previous();})" Next="@(()=>{_ = Next();})" /> }
    </section>
}
    </section>
</div>

<BarangModal Open="@HistoryDialog" Title="@Text("تاریخچه قیمت", "سجل السعر", "Price history")" Size="large" CloseRequested="@(()=>HistoryDialog=false)">
    <div class="record-list">@if(HistoryRows.Count==0){<p>@Text("رویدادی ثبت نشده است.","لا توجد أحداث مسجلة.","No history recorded.")</p>}else foreach(var h in HistoryRows){<div class="record-row"><strong>@HistoryText(h.Action)</strong><small>@HistoryDate(h.At)</small></div>}</div>
    <div class="form-actions"><button class="secondary-action" type="button" @onclick="@(()=>HistoryDialog=false)">@Text("بستن", "إغلاق", "Close")</button></div>
</BarangModal>
<BarangModal Open="@VersionDialog" Title="@Text("نسخه‌های قیمت", "إصدارات السعر", "Price versions")" Size="large" CloseRequested="@(()=>VersionDialog=false)">
    <div class="record-list">@foreach(var v in VersionRows){<div class="record-row"><strong>@Text($"نسخه {v.VersionNo} — {v.Code}", $"الإصدار {v.VersionNo} — {v.Code}", $"Version {v.VersionNo} — {v.Code}")</strong><small>@DateText(v.From) — @DateText(v.To) · @v.Amount @v.Currency</small></div>}</div>
    <div class="form-actions"><button class="secondary-action" type="button" @onclick="@(()=>VersionDialog=false)">@Text("بستن", "إغلاق", "Close")</button></div>
</BarangModal>
<BarangModal Open="@Dialog" Title="@DialogTitle" Size="large" CloseRequested="Close">
    <div class="form-grid">
        <label><span>@Text("کد قیمت", "رمز السعر", "Price code")</span><input @bind="Code" disabled="@(Editing is not null)" /></label>
        <label><span>@Text("نام", "الاسم", "Name")</span><input @bind="Name" disabled="@ReadOnly" /></label>
        @if(FormType==TariffType.Print){<label><span>@Text("سطح/موقعیت چاپ", "سطح/موضع الطباعة", "Print surface/position")</span><SearchableSelect Options="@PrintPositionOptions" @bind-Value="PrintPosition" Disabled="@ReadOnly" Placeholder="@Text("انتخاب موقعیت", "اختر الموضع", "Select position")" /></label><label><span>@Text("روش چاپ", "طريقة الطباعة", "Print method")</span><SearchableSelect Options="@PrintMethodOptions" @bind-Value="PrintMethod" Disabled="@ReadOnly" Placeholder="@Text("اختیاری؛ روش چاپ", "اختياري؛ طريقة الطباعة", "Optional; print method")" /></label>}
        @if(FormType==TariffType.AdditionalService){<label><span>@Text("محدوده دریافت", "نطاق التحصيل", "Charge scope")</span><select @bind="FormServiceScope" disabled="@ReadOnly"><option value="Item">@Text("سطح قلم سفارش", "على مستوى بند الطلب", "Order item")</option><option value="Order">@Text("سطح سفارش", "على مستوى الطلب", "Order")</option></select></label><label><span>@Text("مبنای دریافت", "أساس التحصيل", "Charge basis")</span><select @bind="FormServiceBasis" disabled="@ReadOnly"><option value="Fixed">@Text("مبلغ ثابت", "مبلغ ثابت", "Fixed")</option><option value="PerItem">@Text("به ازای قلم", "لكل بند", "Per item")</option><option value="PerQuantity">@Text("به ازای تعداد", "لكل كمية", "Per quantity")</option></select></label>}
        @if(FormType==TariffType.Packaging){<label><span>@Text("نوع بسته‌بندی", "نوع التغليف", "Packaging type")</span><SearchableSelect Options="@PackagingOptions" @bind-Value="FormPackagingType" Disabled="@ReadOnly" /></label><label><span>@Text("مبنای دریافت", "أساس التحصيل", "Charge basis")</span><select @bind="FormLogisticsBasis" disabled="@ReadOnly"><option value="Fixed">@Text("ثابت برای سفارش", "ثابت للطلب", "Fixed per order")</option><option value="PerPackage">@Text("به ازای بسته", "لكل طرد", "Per package")</option></select></label>}
        @if(FormType==TariffType.Shipping){<label><span>@Text("روش ارسال", "طريقة الشحن", "Shipping method")</span><SearchableSelect Options="@ShippingOptions" @bind-Value="FormShippingMethod" Disabled="@ReadOnly" /></label><label><span>@Text("مبنای دریافت", "أساس التحصيل", "Charge basis")</span><select @bind="FormLogisticsBasis" disabled="@ReadOnly"><option value="Fixed">@Text("ثابت برای محموله", "ثابت للشحنة", "Fixed per shipment")</option><option value="PerPackage">@Text("به ازای بسته", "لكل طرد", "Per package")</option><option value="PerWeight">@Text("به ازای کیلوگرم", "لكل كيلوغرام", "Per kilogram")</option></select></label>}
        <label><span>@Text("مبلغ", "المبلغ", "Amount")</span><input type="number" min="0" step="0.01" @bind="Amount" disabled="@ReadOnly" /></label>
        <label><span>@Text("ارز", "العملة", "Currency")</span><input maxlength="3" @bind="Currency" disabled="@ReadOnly" /></label>
        <label><span>@Text("تاریخ شروع", "تاريخ البدء", "Start date")</span><LocaleDateInput Value="From" ValueChanged="@(x=>From=x??From)" Disabled="@ReadOnly" /></label>
        <label><span>@Text("تاریخ پایان", "تاريخ الانتهاء", "End date")</span><LocaleDateInput Value="To" ValueChanged="@(x=>To=x)" Disabled="@ReadOnly" /></label>
        <label class="span-2"><span>@Text("شرح", "الوصف", "Description")</span><textarea @bind="Description" disabled="@ReadOnly"></textarea></label>
    </div>
    @if (Editing is not null) { <p class="muted">@Text($"نسخه فعلی: {Editing.VersionNo} — شناسه منطقی حفظ می‌شود.", $"الإصدار الحالي: {Editing.VersionNo} — يتم الحفاظ على الهوية المنطقية.", $"Current version: {Editing.VersionNo} — logical identity is preserved.")</p> }
    <div class="form-actions"><button class="secondary-action" type="button" @onclick="Close">@Text("انصراف", "إلغاء", "Cancel")</button>@if(!ReadOnly){<button class="primary-link" type="button" @onclick="Save">@Text("ذخیره", "حفظ", "Save")</button>}</div>
</BarangModal>

@code {
    private List<Row> Rows = []; private List<HistoryRow> HistoryRows=[]; private List<Row> VersionRows=[]; private List<Option> Products=[]; private List<Option> Variants=[]; private bool Loading, IncludeInactive, Dialog, HistoryDialog, VersionDialog, Success, ReadOnly, CreatingVersion; private string? Message; private string Search="", Type="Print", Sort="Code"; private const int PageSize=20; private int Page=1,TotalRows; private bool Descending; private string WorkspaceItem="Print"; private Row? Editing; private string Code="",Name="",Currency="IRR",Description="",ProductId="",VariantId="",PrintPosition="",PrintMethod="",FormServiceScope="Item",FormServiceBasis="Fixed",FormPackagingType="box",FormShippingMethod="standard",FormLogisticsBasis="Fixed"; private decimal Amount; private DateOnly From=DateOnly.FromDateTime(DateTime.Today); private DateOnly? To; private TariffType FormType; private CancellationTokenSource? LoadCancellation,SearchCancellation; private int LoadGeneration;
    private IReadOnlyList<SearchableSelectOption> ProductOptions=>Products.Select(x=>new SearchableSelectOption(x.Id,x.Name)).ToArray(); private IReadOnlyList<SearchableSelectOption> VariantOptions=>Variants.Select(x=>new SearchableSelectOption(x.Id,x.Name)).ToArray();
    private IReadOnlyList<SearchableSelectOption> PrintPositionOptions=>new[]{new SearchableSelectOption("FRONT",Text("جلو","أمام","Front")),new SearchableSelectOption("BACK",Text("پشت","خلف","Back")),new SearchableSelectOption("SLEEVE",Text("آستین","كم","Sleeve")),new SearchableSelectOption("OTHER",Text("سایر","أخرى","Other"))};
    private IReadOnlyList<SearchableSelectOption> PrintMethodOptions=>new[]{new SearchableSelectOption("SCREEN",Text("اسکرین","الشاشة","Screen")),new SearchableSelectOption("STANDARD",Text("استاندارد","قياسي","Standard")),new SearchableSelectOption("DTG",Text("دی‌تی‌جی","DTG","DTG")),new SearchableSelectOption("HEAT_TRANSFER",Text("انتقال حرارتی","النقل الحراري","Heat transfer")),new SearchableSelectOption("EMBROIDERY",Text("گلدوزی","تطريز","Embroidery"))};
    private IReadOnlyList<SearchableSelectOption> PackagingOptions=>new[]{new SearchableSelectOption("box",Text("جعبه استاندارد","صندوق قياسي","Standard box")),new SearchableSelectOption("standard",Text("بسته‌بندی استاندارد","تغليف قياسي","Standard packaging"))}; private IReadOnlyList<SearchableSelectOption> ShippingOptions=>new[]{new SearchableSelectOption("standard",Text("ارسال استاندارد","الشحن القياسي","Standard shipping")),new SearchableSelectOption("express",Text("ارسال فوری","الشحن السريع","Express shipping"))};
    private string DialogTitle => Editing is null ? Text("ایجاد قیمت", "إنشاء سعر", "Create price") : Text("ویرایش قیمت", "تحرير السعر", "Edit price");
    private string WorkspaceHeading => WorkspaceItem switch { "Print"=>Text("قیمت‌های چاپ","أسعار الطباعة","Print Prices"), "Packaging"=>Text("قیمت‌های بسته‌بندی","أسعار التغليف","Packaging Prices"), "Shipping"=>Text("قیمت‌های ارسال","أسعار الشحن","Shipping Prices"), "Design"=>Text("قیمت‌های طراحی","أسعار التصميم","Design Prices"), "AdditionalService"=>Text("قیمت خدمات اضافه","أسعار الخدمات الإضافية","Additional Service Prices"), _=>Text("قیمت‌های عملیاتی","الأسعار التشغيلية","Operational Prices") };
    private string WorkspaceSubtitle => WorkspaceItem switch { "Print"=>Text("قیمت هر عملیات چاپ مستقل و قابل ردیابی است.","كل عملية طباعة مستقلة وقابلة للتتبع.","Each print operation is priced independently and traceably."), "Packaging"=>Text("قیمت بسته‌بندی در سطح سفارش/بسته محاسبه می‌شود.","يحسب التغليف على مستوى الطلب/الطرد.","Packaging is resolved at order/package scope."), "Shipping"=>Text("قیمت فروش ارسال از هزینه شرکت حمل مستقل است.","سعر بيع الشحن مستقل عن تكلفة الناقل.","Customer shipping sales price is separate from carrier cost."), "Design"=>Text("هزینه طراحی فقط برای سناریوهای قابل‌شارژ اعمال می‌شود.","تطبق رسوم التصميم على السيناريوهات القابلة للشحن فقط.","Design charges apply only to chargeable design scenarios."), "AdditionalService"=>Text("خدمات اضافه با محدوده قلم یا سفارش مدیریت می‌شوند.","تدار الخدمات الإضافية على مستوى البند أو الطلب.","Additional services are managed at item or order scope."), _=>Text("هر قیمت با تاریخ شروع و سابقه مستقل مدیریت می‌شود.","يدار كل سعر بتاريخ بدء وسجل مستقل.","Every price has its own start date and history.") };
    private string ContextHeader => WorkspaceItem switch { "Print"=>Text("روش/سطح چاپ","الطريقة/السطح","Method / surface"), "Packaging"=>Text("نوع بسته‌بندی","نوع التغليف","Packaging type"), "Shipping"=>Text("روش ارسال","طريقة الشحن","Shipping method"), "Design"=>Text("زمینه طراحی","سياق التصميم","Design context"), "AdditionalService"=>Text("خدمت","الخدمة","Service"), _=>Text("زمینه","السياق","Context") };
    private string BusinessContext(Row row) => WorkspaceItem switch { "Print"=>Text($"{row.Method ?? "—"} / {row.Position ?? "—"}",$"{row.Method ?? "—"} / {row.Position ?? "—"}",$"{row.Method ?? "—"} / {row.Position ?? "—"}"), "Packaging"=>row.PackagingType ?? "—", "Shipping"=>row.ShippingMethod ?? "—", "AdditionalService"=>row.Code, "Design"=>row.Name, _=>row.Code };
