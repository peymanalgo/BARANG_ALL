@page "/workspace/management"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>@T("داشبورد مدیریت","Management dashboard","لوحة الإدارة") · BARANG</PageTitle>
<main class="page-shell management-dashboard" aria-labelledby="dashboard-heading">
    <header class="dashboard-hero"><div><div class="dashboard-kicker"><span class="dashboard-ink-dot" aria-hidden="true"></span>@T("دید عملیاتی BARANG","BARANG operational view","عرض BARANG التشغيلي")</div><h1 id="dashboard-heading">@T("داشبورد مدیریت","Management dashboard","لوحة الإدارة")</h1><p>@T("اکنون چه می‌گذرد، چه چیزی متوقف است و قدم بعدی کجاست؟","See what is happening now, what is blocked, and where to act next.","اعرف ما يحدث الآن وما المتعطل وأين يمكنك التصرف تالياً.")</p></div><div class="dashboard-motif" aria-hidden="true"><span>✦</span><i></i><i></i><i></i></div></header>
    <section class="dashboard-toolbar panel"><div class="dashboard-scope"><span>@T("شرکت جاری","Current company","الشركة الحالية")</span><strong>@CompanyCaption</strong></div><label><span>@T("از تاریخ","From","من")</span><LocaleDateInput Name="dashboard-from" Value="@From" ValueChanged="FromChanged" /></label><label><span>@T("تا تاریخ","To","إلى")</span><LocaleDateInput Name="dashboard-to" Value="@To" ValueChanged="ToChanged" /></label><button type="button" class="btn btn-secondary dashboard-refresh" disabled="@Loading" @onclick="Load"><BarangIcon Name="refresh" />@T("به‌روزرسانی","Refresh","تحديث")</button>@if(Model is not null){<span class="dashboard-updated" title="@Exact(Model.GeneratedAt)">@T("آخرین به‌روزرسانی","Last successful update","آخر تحديث") @Relative(Model.GeneratedAt)</span>}</section>
    @if(Loading){<section class="dashboard-state panel"><span class="dashboard-spinner" aria-hidden="true"></span><p>@T("در حال آماده‌سازی نمای مدیریتی…","Preparing the management view…","جار إعداد العرض الإداري…")</p></section>}
    else if(Error is not null){<section class="dashboard-state dashboard-error panel" role="alert"><span class="dashboard-state-symbol">!</span><h2>@T("داشبورد بارگذاری نشد","Dashboard could not be loaded","تعذر تحميل لوحة الإدارة")</h2><p>@Error</p><button class="btn btn-primary" type="button" @onclick="Load">@T("تلاش دوباره","Retry","إعادة المحاولة")</button></section>}
    else if(Model is not null){
        <section class="dashboard-primary"><section class="metric-card metric-purple"><div class="metric-card-top"><span class="metric-icon"><BarangIcon Name="clipboard" /></span><span class="metric-label">@T("سفارش‌های باز","Open orders","الطلبات المفتوحة")</span></div><strong class="metric-value">@Nullable(Model.OpenOrders)</strong><p>@T("غیرنهایی؛ لغوشده و تحویل‌شده مستثنا هستند","Non-terminal; cancelled and delivered excluded","غير نهائية؛ مستبعدة الملغاة والمسلمة")</p><a class="metric-link" href="/workspace/orders">@T("مشاهده سفارش‌ها ←","View orders →","عرض الطلبات ←")</a></section>
        <section class="metric-card metric-amber"><div class="metric-card-top"><span class="metric-icon"><BarangIcon Name="clock" /></span><span class="metric-label">@T("وظایف معوق","Overdue tasks","المهام المتأخرة")</span></div><strong class="metric-value">@Nullable(Model.OverdueTasks)</strong><p>@T("مهلت واقعی وظیفه گذشته است","Configured deadline has passed","تجاوز الموعد المحدد")</p><a class="metric-link" href="/workspace/cartable">@T("باز کردن کارتابل ←","Open cartable →","فتح صندوق المهام ←")</a></section>
        <section class="metric-card metric-coral"><div class="metric-card-top"><span class="metric-icon"><BarangIcon Name="warning" /></span><span class="metric-label">@T("سفارش‌های دارای کمبود","Orders blocked by shortages","الطلبات المتوقفة بسبب النقص")</span></div><strong class="metric-value">@Nullable(Model.OpenShortages)</strong><p>@T("کمبود فعال از منبع موجودی","Active unresolved shortage records","سجلات النقص غير المحلولة")</p><a class="metric-link" href="/workspace/inventory/purchasing">@T("بررسی خرید ←","Review purchasing →","مراجعة المشتريات ←")</a></section>
        @if(Model.FinanceVisible){<section class="metric-card metric-turquoise"><div class="metric-card-top"><span class="metric-icon"><BarangIcon Name="receipt" /></span><span class="metric-label">@T("دریافتنی‌های معوق","Outstanding receivables","الذمم المستحقة")</span></div><div class="receivable-values">@if(Model.Receivables.Count==0){<strong>—</strong>}else{foreach(var r in Model.Receivables){<strong>@Money(r.Amount) <small>@r.Currency</small></strong>}}</div><p>@T("فاکتور صادرشده منهای پرداخت و برگشت ثبت‌شده","Posted invoices less payments and reversals","الفواتير الصادرة مطروحاً منها المدفوعات والمرتجعات")</p><a class="metric-link" href="/workspace/finance">@T("مشاهده مالی ←","Open finance →","فتح المالية ←")</a></section>}
        </section>
        <section class="dashboard-grid"><section class="panel dashboard-panel"><div class="panel-heading"><div><span class="section-kicker">@T("گردش کار فعلی","Current workflow","سير العمل الحالي")</span><h2>@T("مراحل در انتظار اقدام","Stages awaiting action","المراحل التي تنتظر إجراءً")</h2></div><a href="/workspace/cartable">@T("کارتابل","Cartable","صندوق المهام")</a></div>@if(Model.Stages.Count==0){<div class="dashboard-empty">@T("در حال حاضر وظیفه بازی وجود ندارد","No open workflow tasks right now","لا توجد مهام مفتوحة حالياً")</div>}else{<div class="stage-list">@foreach(var s in Model.Stages){<a class="stage-row" href="/workspace/cartable?stage=@Uri.EscapeDataString(s.Name)"><span>@StageLabel(s.Name)</span><strong>@s.Count</strong><span class="stage-bar"><i style="width:@StageWidth(s.Count)%"></i></span></a>}</div>}</section>
        <section class="panel dashboard-panel"><div class="panel-heading"><div><span class="section-kicker">@T("نیازمند توجه","Needs attention","يحتاج إلى انتباه")</span><h2>@T("قدم بعدی را پیدا کنید","Find the next action","اعثر على الإجراء التالي")</h2></div><span class="attention-count">@Model.Attention.Count</span></div>@if(Model.Attention.Count==0){<div class="dashboard-empty">@T("مورد معوقی برای نمایش نیست","Nothing is overdue or blocked","لا توجد عناصر متأخرة أو متوقفة")</div>}else{<div class="attention-list">@foreach(var a in Model.Attention){<button type="button" class="attention-row" @onclick="()=>OpenAttention(a)"><span class="attention-icon @a.Priority"><BarangIcon Name="@(a.Kind=="shortage"?"warning":"clock")" /></span><span class="attention-copy"><strong>@(a.Kind=="shortage"?T("کمبود موجودی باز","Open inventory shortage","نقص مخزون مفتوح"):T("وظیفه معوق","Overdue task","مهمة متأخرة"))</strong><small>@a.Reference · @Relative(a.OccurredAt)</small></span><span class="attention-arrow">←</span></button>}}</div>}</section></section>
        <section class="dashboard-grid"><section class="panel dashboard-panel dashboard-trends"><div class="panel-heading"><div><span class="section-kicker">@T("فعالیت واقعی","Recorded activity","النشاط المسجل")</span><h2>@T("روند ثبت سفارش و تحویل","Submitted orders and deliveries","الطلبات المسجلة والتسليمات")</h2><p>@T("ابتدا شامل و انتها غیرشامل؛ نبود فعالیت با نبود داده فرق دارد.","Start inclusive and end exclusive; no activity is not missing data.","البداية شاملة والنهاية غير شاملة؛ لا نشاط لا يعني غياب البيانات.")</p></div></div><div class="trend-grid"><div class="trend-block"><h3>@T("ثبت سفارش","Submitted orders","الطلبات المسجلة")</h3>@Trend(Model.Submitted,"purple")</div><div class="trend-block"><h3>@T("تحویل ثبت‌شده","Delivered activity","التسليمات المسجلة")</h3>@Trend(Model.Delivered,"turquoise")</div></div></section><section class="panel dashboard-panel"><div class="panel-heading"><div><span class="section-kicker">@T("نمای فشرده عملیات","Operational overview","نظرة تشغيلية مختصرة")</span><h2>@T("وضعیت ماژول‌ها","Module status","حالة الوحدات")</h2></div></div><div class="module-list">@Module("تولید","Production","الإنتاج",Model.Production,"/workspace/production") @Module("کنترل کیفیت","Quality","الجودة",Model.Quality,"/workspace/quality") @Module("خرید","Purchasing","المشتريات",Model.Purchasing,"/workspace/inventory/purchasing") @Module("لجستیک","Logistics","اللوجستيات",Model.Logistics,"/workspace/logistics")</div></section></section>
        <nav class="dashboard-quick-links"><a href="/workspace/orders"><BarangIcon Name="clipboard" />@T("سفارش‌ها","Orders","الطلبات")</a><a href="/workspace/cartable"><BarangIcon Name="workflow" />@T("کارتابل","Cartable","صندوق المهام")</a><a href="/workspace/notifications"><BarangIcon Name="bell" />@T("اعلان‌ها","Notifications","الإشعارات")</a></nav>
    }
</main>

@code {
    private bool Loading=true; private string? Error; private DashboardModel? Model; private DateOnly From=DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-30)); private DateOnly To=DateOnly.FromDateTime(DateTime.UtcNow); private string CompanyCaption="—";
    protected override async Task OnInitializedAsync(){var state=await AuthState.GetAuthenticationStateAsync();var id=state.User.FindFirst(AuthClaimTypes.CompanyId)?.Value;CompanyCaption=id is not null&&id.Length>8?id[..8]+"…":id??T("شرکت جاری","Current company","الشركة الحالية");await Load();}
    private async Task Load(){Loading=true;Error=null;try{var s=await Session();if(s is null){Error=T("نشست معتبر نیست.","The session is not valid.","الجلسة غير صالحة.");return;}var q=$"api/v1/management/dashboard?fromUtc={From:yyyy-MM-dd}T00:00:00Z&toUtc={To.AddDays(1):yyyy-MM-dd}T00:00:00Z";var r=await Core.GetAsync(q,s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Error=r.ProblemDescription??T("داده مدیریتی در دسترس نیست.","Management data is unavailable.","بيانات الإدارة غير متاحة.");return;}Model=DashboardModel.Parse(r.Value);}catch(Exception ex){Error=ex.Message;}finally{Loading=false;}}
    private async Task FromChanged(DateOnly? v){if(v is not null)From=v.Value;await Load();} private async Task ToChanged(DateOnly? v){if(v is not null)To=v.Value;await Load();}
    private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
    private void OpenAttention(Attention a){if(a.Kind=="task")Navigation.NavigateTo("/workspace/cartable");else if(a.OrderId is Guid id)Navigation.NavigateTo($"/workspace/orders/{id}/360");else Navigation.NavigateTo(a.Route);}
    private string T(string fa,string en,string ar)=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"en"=>en,"ar"=>ar,_=>fa}; private string Nullable(int? x)=>x?.ToString(CultureInfo.CurrentCulture)??T("دسترسی ندارید","Not available","غير متاح"); private static string Money(decimal x)=>x.ToString("N0",CultureInfo.CurrentCulture); private string Exact(DateTimeOffset d)=>d.ToLocalTime().ToString("yyyy/MM/dd HH:mm",CultureInfo.CurrentCulture); private string Relative(DateTimeOffset d){var a=DateTimeOffset.UtcNow-d;if(a.TotalMinutes<1)return T("همین حالا","Just now","الآن");if(a.TotalHours<1)return T($"{(int)a.TotalMinutes} دقیقه پیش",$"{(int)a.TotalMinutes}m ago",$"منذ {(int)a.TotalMinutes} د");return T($"{(int)a.TotalHours} ساعت پیش",$"{(int)a.TotalHours}h ago",$"منذ {(int)a.TotalHours} س");} private string StageLabel(string x)=>x switch{"InventoryReservation"=>T("رزرو موجودی","Inventory reservation","حجز المخزون"),"FinancialApproval"=>T("تأیید مالی","Financial approval","الموافقة المالية"),"ProductionPlanning"=>T("برنامه‌ریزی تولید","Production planning","تخطيط الإنتاج"),"QualityControl"=>T("کنترل کیفیت","Quality control","مراقبة الجودة"),"Packaging"=>T("بسته‌بندی","Packaging","التغليف"),"Shipping"=>T("ارسال","Shipping","الشحن"),"Delivery"=>T("تحویل","Delivery","التسليم"),_=>x}; private string StageWidth(int n)=>Math.Min(100,Math.Max(8,n*12)).ToString(CultureInfo.InvariantCulture);
    private RenderFragment Trend(List<TrendPoint> points,string tone)=>b=>{var i=0;b.OpenElement(i++,"div");b.AddAttribute(i++,"class",$"trend-bars trend-{tone}");if(points.Count==0){b.AddMarkupContent(i++, $"<span class=\"trend-empty\">{T("فعالیتی در این بازه ثبت نشده است","No activity in this range","لا نشاط في هذه الفترة")}</span>");}else{var max=Math.Max(1,points.Max(x=>x.Count));foreach(var p in points.TakeLast(14)){b.OpenElement(i++,"span");b.AddAttribute(i++,"class","trend-bar");b.AddAttribute(i++,"title",$"{p.Day:yyyy-MM-dd}: {p.Count}");b.AddAttribute(i++,"style",$"height:{Math.Max(8,p.Count*100/max)}%");b.AddContent(i++,p.Count);b.CloseElement();}}b.CloseElement();};
    private RenderFragment Module(string fa,string en,string ar,int? value,string route)=>b=>{var i=0;b.OpenElement(i++,"a");b.AddAttribute(i++,"class","module-row");b.AddAttribute(i++,"href",route);b.AddMarkupContent(i++,$"<span>{T(fa,en,ar)}</span><strong>{Nullable(value)}</strong><span aria-hidden=\"true\">←</span>");b.CloseElement();};
    private sealed record Attention(string Kind,Guid RecordId,Guid?OrderId,string Reference,DateTimeOffset OccurredAt,string Priority,string Route); private sealed record Stage(string Name,int Count); private sealed record Receivable(string Currency,decimal Amount); private sealed record TrendPoint(DateTime Day,int Count);
    private sealed class DashboardModel{public DateTimeOffset GeneratedAt;public int? OpenOrders,OverdueTasks,OpenShortages,Production,Quality,Purchasing,Logistics;public bool FinanceVisible;public List<Receivable> Receivables=[];public List<Stage> Stages=[];public List<Attention> Attention=[];public List<TrendPoint> Submitted=[],Delivered=[];public static DashboardModel Parse(JsonElement x){var m=new DashboardModel{GeneratedAt=x.GetProperty("generatedAtUtc").GetDateTimeOffset()};var p=x.GetProperty("primary");m.OpenOrders=Num(p,"openOrders");m.OverdueTasks=Num(p,"overdueTasks");m.OpenShortages=Num(p,"openShortageItems");m.FinanceVisible=x.GetProperty("scope").GetProperty("permissions").GetProperty("financeRead").GetBoolean();if(p.TryGetProperty("receivables",out var rr))foreach(var a in rr.EnumerateArray())m.Receivables.Add(new(a.GetProperty("currency").GetString()??"",a.GetProperty("amount").GetDecimal()));foreach(var a in x.GetProperty("workflowStages").EnumerateArray())m.Stages.Add(new(a.GetProperty("stage").GetString()??"",a.GetProperty("count").GetInt32()));foreach(var a in x.GetProperty("attention").EnumerateArray())m.Attention.Add(new(a.GetProperty("kind").GetString()??"",a.GetProperty("recordId").GetGuid(),a.TryGetProperty("orderId",out var oi)&&oi.ValueKind!=JsonValueKind.Null?oi.GetGuid():null,a.GetProperty("reference").GetString()??"",a.GetProperty("occurredAtUtc").GetDateTimeOffset(),a.GetProperty("priority").GetString()??"attention",a.GetProperty("route").GetString()??"/workspace/cartable"));var t=x.GetProperty("trends");Read(t,"submitted",m.Submitted);Read(t,"delivered",m.Delivered);var mod=x.GetProperty("modules");m.Production=Num(mod,"production");m.Quality=Num(mod,"quality");m.Purchasing=Num(mod,"purchasing");m.Logistics=Num(mod,"logistics");return m;}private static int? Num(JsonElement p,string n)=>p.TryGetProperty(n,out var v)&&v.ValueKind!=JsonValueKind.Null?v.GetInt32():null;private static void Read(JsonElement p,string n,List<TrendPoint>d){foreach(var a in p.GetProperty(n).EnumerateArray())d.Add(new(a.GetProperty("day").GetDateTime(),a.GetProperty("count").GetInt32()));}}
}
