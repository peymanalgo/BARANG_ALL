@page "/business-profile/{Kind}/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<BusinessStrings> B
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates
@inject NavigationManager Navigation
<PageTitle>@B["Title"]</PageTitle><nav class="breadcrumbs"><a href="/">@L["Home"]</a><span>/</span><span>@B["Title"]</span></nav><div class="page-heading"><h1>@B["Title"]</h1></div>
@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}
<section class="panel"><div class="form-grid">
@if(Kind=="customer"){<label><span>@B["BirthDate"]</span><LocaleDateInput @bind-Value="BirthDate" /></label><label><span>@B["EconomicCode"]</span><input @bind="EconomicCode" /></label><label><span>@B["CreditLimit"]</span><input type="number" step="0.01" min="0" @bind="CreditLimit" /></label><label><span>@B["PaymentTerms"]</span><input type="number" min="0" max="3650" @bind="PaymentTerms" /></label><label class="span-2"><span>@B["BusinessDetails"]</span><textarea @bind="Details"></textarea></label>}
else if(Kind=="product") {<label><span>@B["Variant"]</span><SearchableSelect Options="@SelectOptions(Variants)" @bind-Value="VariantId" Placeholder="@L["Choose"]" /></label><CodeField Label="@B["Brand"]" @bind-Value="Brand" TypeCode="product.brand"/><CodeField Label="@B["Material"]" @bind-Value="Material" TypeCode="product.material"/><CodeField Label="@B["Gender"]" @bind-Value="Gender" TypeCode="product.gender"/><CodeField Label="@B["Fit"]" @bind-Value="Fit" TypeCode="product.fit"/><CodeField Label="@B["Style"]" @bind-Value="Style" TypeCode="product.style"/><label class="span-2"><span>@B["Attributes"]</span><textarea @bind="Details"></textarea></label>}
else if(Kind=="order") {<CodeField Label="@B["ShippingMethod"]" @bind-Value="Shipping" TypeCode="shipping.method"/><CodeField Label="@B["PackagingType"]" @bind-Value="Packaging" TypeCode="packaging.type"/><CodeField Label="@B["OrderType"]" @bind-Value="OrderType" TypeCode="order.type"/><label><span>@B["IncludeInvoice"]</span><input type="checkbox" @bind="IncludeInvoice" /></label><label class="span-2"><span>@B["Notes"]</span><textarea @bind="Details"></textarea></label>}
else if(Kind=="print") {<CodeField Label="@B["Direction"]" @bind-Value="Direction" TypeCode="print.direction"/><CodeField Label="@B["PrintSize"]" @bind-Value="PrintSize" TypeCode="print.size"/><label><span>@B["PrintCount"]</span><input type="number" min="1" @bind="PrintCount" /></label><label><span>@B["Printer"]</span><SearchableSelect Options="@SelectOptions(Equipment)" @bind-Value="Printer" Placeholder="@L["Choose"]" /></label><label><span>@B["HeatPress"]</span><SearchableSelect Options="@SelectOptions(Equipment)" @bind-Value="HeatPress" Placeholder="@L["Choose"]" /></label><label class="span-2"><span>@B["Specifications"]</span><textarea @bind="Details"></textarea></label>}
</div><div class="form-actions"><button type="button" @onclick="Load">@B["Reload"]</button><button type="button" class="primary-link" @onclick="Save">@B["Save"]</button></div></section>
@code{[Parameter]public string Kind{get;set;}="";[Parameter]public Guid Id{get;set;}private DateOnly?BirthDate;private string EconomicCode="",Details="",VariantId="",Brand="",Material="",Gender="",Fit="",Style="",Shipping="",Packaging="",OrderType="",Direction="",PrintSize="",Printer="",HeatPress="";private decimal CreditLimit;private int PaymentTerms,PrintCount=1;private bool IncludeInvoice,Success;private long Version;private string?Message;private List<Option>Variants=[],Equipment=[],Brands=[],Materials=[],Genders=[],Fits=[],Styles=[],ShippingMethods=[],PackagingTypes=[],OrderTypes=[],Directions=[],PrintSizes=[];
protected override async Task OnParametersSetAsync(){if(Kind=="customer"){Navigation.NavigateTo($"/manage/customers/{Id}/details",true);return;}await LoadReferences();await Load();}
