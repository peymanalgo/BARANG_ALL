private async Task Save(){var s=await Session();if(s is null)return;object body;if(Kind=="customer")body=new{dateOfBirth=BirthDate?.ToString("yyyy-MM-dd"),economicCode=Null(EconomicCode),creditLimit=CreditLimit,paymentTermsDays=PaymentTerms,businessDetails=Null(Details),version=Version};else if(Kind=="product")body=new{productVariantId=GuidOrNull(VariantId),brandCode=Null(Brand),materialCode=Null(Material),genderCode=Null(Gender),fitCode=Null(Fit),styleCode=Null(Style),technicalAttributes=Null(Details),version=Version};else if(Kind=="order")body=new{shippingMethodCode=Null(Shipping),packagingTypeCode=Null(Packaging),includeInvoiceInPackage=IncludeInvoice,orderTypeCode=Null(OrderType),notes=Null(Details),version=Version};else body=new{directionCode=Null(Direction),printSizeCode=Null(PrintSize),printCount=PrintCount,printerEquipmentId=GuidOrNull(Printer),heatPressEquipmentId=GuidOrNull(HeatPress),specifications=Null(Details),version=Version};var r=await Core.SendAsync(HttpMethod.Put,Path().Split('?')[0],body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}
private async Task LoadReferences(){var s=await Session();if(s is null)return;if(Kind=="product")Variants=await Options($"api/v1/products/{Id}/variants/options?limit=100",s.Value);if(Kind=="print")Equipment=await Options("api/v1/equipment/options?limit=100",s.Value);}
private async Task<List<Option>>Lookup(string code,(string Token,Guid Company)s)=>await Options($"api/v1/lookups/{code}/options?culture={System.Globalization.CultureInfo.CurrentUICulture.Name}&activeOnly=true",s);private async Task<List<Option>>Options(string p,(string Token,Guid Company)s){var r=await Core.GetAsync(p,s.Token,s.Company,default);if(!r.IsSuccess)return[];var x=r.Value;if(x.ValueKind==System.Text.Json.JsonValueKind.Object&&x.TryGetProperty("items",out var a))x=a;var z=new List<Option>();if(x.ValueKind==System.Text.Json.JsonValueKind.Array)foreach(var v in x.EnumerateArray())z.Add(new(v.TryGetProperty("id",out var id)?id.ToString():G(v,"code"),v.TryGetProperty("displayName",out var d)?d.ToString():G(v,"code")));return z;}private static IReadOnlyList<SearchableSelectOption>SelectOptions(IEnumerable<Option>items)=>items.Select(x=>new SearchableSelectOption(x.Id,x.Name)).ToArray();
private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private DateOnly?ParseDate(string value)=>Dates.TryParseCanonical(value,out var date)?date:null;private static string?Null(string x)=>string.IsNullOrWhiteSpace(x)?null:x;private static Guid?GuidOrNull(string x)=>Guid.TryParse(x,out var id)?id:null;private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private static long N(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.TryGetInt64(out var v)?v:0;private static int I(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.TryGetInt32(out var v)?v:0;private static decimal D(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.TryGetDecimal(out var v)?v:0;private static bool Bool(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind==System.Text.Json.JsonValueKind.True;private sealed record Option(string Id,string Name);}
