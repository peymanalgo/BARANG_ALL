@page "/workspace/notifications"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@inject IStringLocalizer<NavigationStrings> N
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<EffectiveStatusStrings> E
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject ILocaleDateService Dates

<PageTitle>@T("مرکز اعلان‌ها","Notification Center","مركز الإشعارات") · BARANG</PageTitle>
<main class="page-shell notification-center" aria-labelledby="notifications-heading">
    <header class="notification-hero">
        <div class="notification-hero-copy">
            <div class="notification-hero-kicker"><span class="notification-ink-dot" aria-hidden="true"></span>@T("رویدادهای مهم BARANG","BARANG business updates","تحديثات BARANG التشغيلية")</div>
            <h1 id="notifications-heading">@T("مرکز اعلان‌ها","Notification Center","مركز الإشعارات")</h1>
            <p>@T("اینجا می‌بینید چه اتفاقی افتاده و قدم بعدی چیست.","See what happened and what needs your attention next.","اعرف ما حدث وما الذي يحتاج إلى إجراء تالياً.")</p>
        </div>
        <div class="notification-hero-art" aria-hidden="true"><span class="notification-shirt">✦</span><i></i><i></i><i></i></div>
    </header>

    <section class="notification-summary @(CanSeeDraftPanel?"has-draft":"")" aria-label="@T("فیلترهای اعلان","Notification filters","مرشحات الإشعارات")">
        <button type="button" class="notification-summary-card @(Filter=="all"?"is-active":"")" @onclick='()=>SwitchFilter("all")'><span class="summary-icon summary-purple">◌</span><span><small>@T("همه","All","الكل")</small><strong>@TotalCount</strong></span></button>
        <button type="button" class="notification-summary-card @(Filter=="unread"?"is-active":"")" @onclick='()=>SwitchFilter("unread")'><span class="summary-icon summary-coral">●</span><span><small>@T("خوانده‌نشده","Unread","غير المقروء")</small><strong>@UnreadCount</strong></span></button>
        <button type="button" class="notification-summary-card @(Filter=="action"?"is-active":"")" @onclick='()=>SwitchFilter("action")'><span class="summary-icon summary-amber">!</span><span><small>@T("نیازمند اقدام","Needs action","يتطلب إجراءً")</small><strong>@ActionCount</strong></span></button>
        @if(CanSeeDraftPanel){<button type="button" class="notification-summary-card draft-orders-toggle @(Filter=="drafts"?"is-active":"")" @onclick='()=>SwitchFilter("drafts")' data-draft-orders-panel><span class="summary-icon summary-teal">✎</span><span><small>@T("سفارش های پیشنویس","Draft orders","مسودات الطلبات")</small><strong>@DraftCount</strong></span></button>}
    </section>

    @if(Filter=="drafts"){
        <div class="notification-list-head"><div><h2>@T("سفارش های پیشنویس","Draft orders","مسودات الطلبات")</h2><span>@T($"{DraftTotal} سفارش در مرحله پیشنویس",$"{DraftTotal} orders in draft stage",$"{DraftTotal} طلباً في مرحلة المسودة")</span></div><div class="notification-list-actions"><button type="button" class="btn btn-secondary" @onclick='()=>SwitchFilter("all")'>@T("بازگشت به اعلان‌ها","Back to notifications","العودة إلى الإشعارات")</button></div></div>
        <section class="crud-card draft-orders-card" data-draft-orders-grid aria-label="@T("سفارش های پیشنویس","Draft orders","مسودات الطلبات")">
            <div class="crud-toolbar"><label class="crud-search"><BarangIcon Name="search" /><span class="visually-hidden">@L["Search"]</span><input value="@DraftSearch" @oninput="DraftSearchChanged" placeholder="@L["SearchPlaceholder"]" aria-label="@L["Search"]" /></label><button type="button" class="btn btn-secondary" @onclick="ResetDraftGrid"><BarangIcon Name="reset" /> @L["Reset"]</button></div>
            @if(DraftLoading){<BarangLoadingState Text="@L["Loading"]" />}
            else if(!string.IsNullOrWhiteSpace(DraftError)){<section class="notification-state notification-error panel" role="alert"><span class="state-symbol">!</span><h2>@T("بارگذاری سفارش‌های پیشنویس انجام نشد","Draft orders could not be loaded","تعذر تحميل مسودات الطلبات")</h2><p>@DraftError</p><button type="button" class="btn btn-primary" @onclick="LoadDrafts">@T("تلاش دوباره","Retry","إعادة المحاولة")</button></section>}
            else if(DraftRows.Count==0){<CrudEmptyState Title="@T("سفارش پیشنویسی وجود ندارد","No draft orders","لا توجد طلبات في المسودة")" Description="@T("سفارش‌های جدید پیش از ثبت نهایی، به‌صورت پیشنویس اینجا نمایش داده می‌شوند.","New orders appear here as drafts before they are submitted.","تظهر الطلبات الجديدة هنا كمسودات قبل إرسالها.")" />}
            else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@L["OrderNumber"]</th><th>@L["OrderDate"]</th><th>@L["Customer"]</th><th>@L["OrderSource"]</th><th>@L["Status"]</th><th class="actions-column">@L["Actions"]</th></tr></thead><tbody>@foreach(var row in DraftRows){<tr><td dir="ltr"><span class="code-pill">@(row.Number.Length==0?"—":row.Number)</span></td><td>@DateLabel(row.Date)</td><td>@row.Customer</td><td>@SourceLabel(row.Source)</td><td><span class="status-pill">@StatusLabel(row)</span></td><td><BarangActionMenu><BarangIconButton Icon="eye" Semantic="info" Label="@L["Order360"]" Clicked="@(()=>Navigation.NavigateTo($"/orders/{row.Id}/360"))" /><BarangIconButton Icon="edit" Semantic="edit" Label="@L["Edit"]" Clicked="@(()=>Navigation.NavigateTo($"/orders/{row.Id}/edit"))" /><BarangIconButton Icon="send" Semantic="success" Label="@L["Action_Submit"]" Clicked="@(()=>SubmitDraft(row))" /><BarangIconButton Icon="close" Semantic="warning" Label="@L["Action_Cancel"]" Clicked="@(()=>CancelDraft(row))" /></BarangActionMenu></td></tr>}</tbody></table></div><BarangPagination Page="@DraftPage" HasNext="@(DraftPage*DraftPageSize<DraftTotal)" Disabled="@DraftLoading" PageLabel="@L["Page"]" PreviousText="@L["Previous"]" NextText="@L["Next"]" Previous="@PreviousDraftPage" Next="@NextDraftPage" />}
        </section>
    }
    else {
    <section class="notification-toolbar panel" aria-label="@T("جست‌وجو و فیلتر","Search and filters","البحث والمرشحات")">
        <div class="notification-search"><label for="notification-search">@T("جست‌وجو","Search","بحث")</label><div class="notification-search-row"><input id="notification-search" @bind="Search" @bind:event="oninput" @onkeydown="SearchKeyDown" placeholder="@T("عنوان یا شماره مرجع…","Title or source reference…","العنوان أو رقم المصدر…")" /><button type="button" class="btn btn-primary" @onclick="SearchNow">@T("جست‌وجو","Search","بحث")</button></div></div>
        <label><span>@T("ماژول","Module","الوحدة")</span><select value="@Category" @onchange="CategoryChanged"><option value="">@T("انتخاب ماژول","Select module","اختر الوحدة")</option><option value="order">@T("سفارش","Orders","الطلبات")</option><option value="inventory">@T("انبار","Inventory","المخزون")</option><option value="purchasing">@T("خرید","Purchasing","المشتريات")</option><option value="finance">@T("مالی","Finance","المالية")</option><option value="quality">@T("کنترل کیفیت","Quality","الجودة")</option><option value="logistics">@T("لجستیک","Logistics","اللوجستيات")</option><option value="workflow">@T("گردش کار","Workflow","سير العمل")</option><option value="sla">SLA</option></select></label>
        <label><span>@T("اولویت","Priority","الأولوية")</span><select value="@Priority" @onchange="PriorityChanged"><option value="">@T("همه اولویت‌ها","All priorities","كل الأولويات")</option><option value="urgent">@T("فوری","Urgent","عاجل")</option><option value="attention">@T("نیازمند توجه","Attention","يحتاج الانتباه")</option><option value="info">@T("اطلاعاتی","Informational","معلوماتي")</option></select></label>
        <label><span>@T("از تاریخ","From date","من تاريخ")</span><LocaleDateInput Name="notification-from" Value="@FromDate" ValueChanged="FromDateChanged" /></label>
        <label><span>@T("تا تاریخ","To date","إلى تاريخ")</span><LocaleDateInput Name="notification-to" Value="@ToDate" ValueChanged="ToDateChanged" /></label>
        <button type="button" class="btn btn-secondary notification-clear" @onclick="ClearFilters">@T("پاک کردن فیلترها","Clear filters","مسح المرشحات")</button>
    </section>

    <div class="notification-list-head"><div><h2>@ListTitle</h2><span>@T($"{TotalCount} اعلان",$"{TotalCount} notifications",$"{TotalCount} إشعار")</span></div><div class="notification-list-actions">@if (ConfirmAll) { <button type="button" class="btn btn-secondary" @onclick="()=>ConfirmAll=false">@T("انصراف","Cancel","إلغاء")</button><button type="button" class="btn btn-primary" disabled="@Busy" @onclick="MarkAllRead">@T("تأیید خوانده‌شدن همه","Confirm mark all read","تأكيد تعليم الكل كمقروء")</button> } else { <button type="button" class="btn btn-secondary" disabled="@(Loading || UnreadCount==0 || Busy)" @onclick="()=>ConfirmAll=true">@T("همه را خوانده‌شده کن","Mark all read","تحديد الكل كمقروء")</button> }</div></div>

    @if (Loading) { <section class="notification-state panel"><span class="notification-spinner" aria-hidden="true"></span><p>@T("در حال بارگذاری اعلان‌ها…","Loading notifications…","جار تحميل الإشعارات…")</p></section> }
    else if (!string.IsNullOrWhiteSpace(Error)) { <section class="notification-state notification-error panel" role="alert"><span class="state-symbol">!</span><h2>@T("بارگذاری اعلان‌ها انجام نشد","Notifications could not be loaded","تعذر تحميل الإشعارات")</h2><p>@Error</p><button type="button" class="btn btn-primary" @onclick="Load">@T("تلاش دوباره","Retry","إعادة المحاولة")</button></section> }
    else if (Rows.Count==0) { <section class="notification-state notification-empty panel"><div class="empty-motif" aria-hidden="true"><span>✦</span><i></i><i></i></div><h2>@(HasFilters?T("نتیجه‌ای پیدا نشد","No matching notifications","لا توجد إشعارات مطابقة"):T("همه‌چیز آرام است","You’re all caught up","لا توجد إشعارات جديدة"))</h2><p>@(HasFilters?T("فیلترها را تغییر دهید یا پاک کنید.","Try changing or clearing your filters.","جرّب تغيير المرشحات أو مسحها."):T("اعلان‌های جدید و اقدام‌های لازم اینجا نمایش داده می‌شوند.","New updates and required actions will appear here.","ستظهر التحديثات والإجراءات المطلوبة هنا."))</p>@if(HasFilters){<button type="button" class="btn btn-secondary" @onclick="ClearFilters">@T("پاک کردن فیلترها","Clear filters","مسح المرشحات")</button>}</section> }
    else {
        <section class="notification-list" aria-live="polite">@foreach(Row row in Rows){<article class="notification-card @(row.ReadAt is null?"is-unread":"") priority-@row.Priority"><div class="notification-card-marker" aria-hidden="true"><BarangIcon Name="@Icon(row.Category)" /></div><div class="notification-card-body"><div class="notification-card-top"><span class="notification-category">@CategoryLabel(row.Category)</span><span class="notification-priority">@PriorityLabel(row.Priority)</span><time datetime="@Iso(row.CreatedAtUtc)" title="@ExactTime(row.CreatedAtUtc)">@Relative(row.CreatedAtUtc)</time></div><h3>@Title(row)</h3><p class="notification-description">@Description(row)</p><div class="notification-card-meta">@if(row.SourceReference is not null){<span><BarangIcon Name="link" /> @row.SourceReference</span>}<span class="notification-state-label">@(row.ReadAt is null?T("خوانده‌نشده","Unread","غير مقروء"):T("خوانده‌شده","Read","مقروء"))</span><span class="notification-action-state">@(row.IsActionable?(row.ActionState=="completed"?T("اقدام انجام شده","Resolved","تم الحل"):T("نیازمند اقدام","Needs action","يتطلب إجراءً")):T("اطلاعاتی","Informational","معلوماتي"))</span></div><div class="notification-card-actions">@if(row.SourceRoute is not null && row.IsActionable){<button type="button" class="btn btn-primary btn-small" @onclick="()=>Open(row)">@ActionLabel(row)</button>} else if(row.SourceRoute is not null){<button type="button" class="btn btn-secondary btn-small" @onclick="()=>Open(row)">@T("مشاهده منبع","View source","عرض المصدر")</button>}@if(row.ReadAt is null){<button type="button" class="btn btn-link btn-small" disabled="@Busy" @onclick="()=>MarkRead(row)">@T("خواندم","Mark read","تحديد كمقروء")</button>}</div></div></article>}</section>
        @if(HasPages){<nav class="notification-pagination" aria-label="@T("صفحه‌بندی اعلان‌ها","Notification pagination","ترقيم صفحات الإشعارات")"><button class="btn btn-secondary" type="button" disabled="@(Page<=1||Loading)" @onclick="Previous">@T("قبلی","Previous","السابق")</button><span>@T($"صفحه {Page} از {PageCount}",$"Page {Page} of {PageCount}",$"الصفحة {Page} من {PageCount}")</span><button class="btn btn-secondary" type="button" disabled="@(Page>=PageCount||Loading)" @onclick="Next">@T("بعدی","Next","التالي")</button></nav>}
    }
    }
</main>

@code {
    private bool Loading=true, Busy, ConfirmAll; private string? Error; private List<Row> Rows=[]; private string Filter="all", Search="", Category="", Priority=""; private DateOnly? FromDate, ToDate; private int Page=1, PageSize=12; private long TotalCount, UnreadCount, ActionCount;
    private bool CanSeeDraftPanel; private long DraftCount; private bool DraftLoading; private string? DraftError; private string DraftSearch=""; private int DraftPage=1; private const int DraftPageSize=20; private long DraftTotal; private List<DraftRow> DraftRows=[]; private CancellationTokenSource? DraftSearchCancellation; private int DraftLoadGeneration;
    private bool HasFilters=>Filter!="all"||!string.IsNullOrWhiteSpace(Search)||!string.IsNullOrWhiteSpace(Category)||!string.IsNullOrWhiteSpace(Priority)||FromDate is not null||ToDate is not null;
    private int PageCount=>Math.Max(1,(int)Math.Ceiling(TotalCount/(double)PageSize)); private bool HasPages=>PageCount>1; private string ListTitle=>Filter switch{"unread"=>T("خوانده‌نشده","Unread","غير المقروء"),"action"=>T("نیازمند اقدام","Needs action","يتطلب إجراءً"),_=>T("آخرین اعلان‌ها","Latest notifications","أحدث الإشعارات")};
    protected override async Task OnInitializedAsync(){var u=(await AuthState.GetAuthenticationStateAsync()).User;CanSeeDraftPanel=u.IsInRole("system.administrator")||u.HasClaim(AuthClaimTypes.Permission,"notification.draftorder.read");await Load();}
    private async Task Load(){Loading=true;Error=null;try{var s=await Session();if(s is null){Error=T("نشست منقضی شده است.","Session expired.","انتهت الجلسة.");return;}if(CanSeeDraftPanel)await RefreshDraftCount(s.Value);var main=await Fetch(s.Value,Page,PageSize,Filter=="unread"?true:null,Filter=="action"?true:null);if(!main.IsSuccess){Error=main.ProblemDescription??T("بارگذاری اعلان‌ها انجام نشد.","Could not load notifications.","تعذر تحميل الإشعارات.");Rows=[];return;}Rows=ParseRows(main.Value);TotalCount=GetLong(main.Value,"total");UnreadCount=GetLong(main.Value,"unreadTotal");var unread=await Fetch(s.Value,1,1,true,null);if(unread.IsSuccess)UnreadCount=GetLong(unread.Value,"total");var actions=await Fetch(s.Value,1,1,null,true);if(actions.IsSuccess)ActionCount=GetLong(actions.Value,"total");}catch(Exception ex){Rows=[];Error=ex.Message;}finally{Loading=false;}}
    private async Task RefreshDraftCount((string Token,Guid Company) s){try{var r=await Core.GetAsync(DraftQuery(1,1),s.Token,s.Company,default);if(r.IsSuccess)DraftCount=r.Value.TryGetProperty("totalCount",out var t)?t.GetInt64():0;}catch{}}
    private string DraftQuery(int page,int size)=>$"api/v1/notifications/draft-orders?page={page}&pageSize={size}"+(string.IsNullOrWhiteSpace(DraftSearch)?"":$"&search={Uri.EscapeDataString(DraftSearch.Trim())}");
    private async Task LoadDrafts(){int g=++DraftLoadGeneration;DraftLoading=true;DraftError=null;var s=await Session();if(s is null){DraftLoading=false;DraftError=T("نشست منقضی شده است.","Session expired.","انتهت الجلسة.");return;}var r=await Core.GetAsync(DraftQuery(DraftPage,DraftPageSize),s.Value.Token,s.Value.Company,default);if(g!=DraftLoadGeneration)return;if(r.IsSuccess){DraftTotal=r.Value.TryGetProperty("totalCount",out var t)?t.GetInt64():0;DraftCount=DraftTotal;DraftRows=r.Value.TryGetProperty("items",out var a)&&a.ValueKind==JsonValueKind.Array?a.EnumerateArray().Select(ParseDraftRow).ToList():[];}else{DraftRows=[];DraftError=r.ProblemDescription??T("بارگذاری سفارش‌های پیشنویس انجام نشد.","Could not load draft orders.","تعذر تحميل مسودات الطلبات.");}DraftLoading=false;}
    private async Task DraftSearchChanged(ChangeEventArgs a){DraftSearch=a.Value?.ToString()??"";DraftSearchCancellation?.Cancel();DraftSearchCancellation?.Dispose();DraftSearchCancellation=new();try{await Task.Delay(300,DraftSearchCancellation.Token);DraftPage=1;await LoadDrafts();}catch(OperationCanceledException){}}
    private async Task ResetDraftGrid(){DraftSearch="";DraftPage=1;await LoadDrafts();}
    private async Task PreviousDraftPage(){if(DraftPage>1){DraftPage--;await LoadDrafts();}}
    private async Task NextDraftPage(){if(DraftPage*DraftPageSize<DraftTotal){DraftPage++;await LoadDrafts();}}
    private async Task SubmitDraft(DraftRow row){var s=await Session();if(s is null)return;if((await Core.SendAsync(HttpMethod.Post,$"api/v1/orders/{row.Id}/submit",new{version=row.Version},s.Value.Token,s.Value.Company,default)).IsSuccess)await LoadDrafts();}
    private async Task CancelDraft(DraftRow row){var s=await Session();if(s is null)return;if((await Core.SendAsync(HttpMethod.Post,$"api/v1/orders/{row.Id}/cancel",new{reasonCode="BACKOFFICE",reasonText=(string?)null,version=row.Version},s.Value.Token,s.Value.Company,default)).IsSuccess)await LoadDrafts();}
    private async Task<ApiResult<JsonElement>> Fetch((string Token,Guid Company) s,int page,int size,bool? unread,bool? actionable){string q=$"api/v1/notifications/mine?page={page}&pageSize={size}";if(unread is not null)q+=$"&unread={unread.Value.ToString().ToLowerInvariant()}";if(actionable is not null)q+=$"&actionable={actionable.Value.ToString().ToLowerInvariant()}";if(!string.IsNullOrWhiteSpace(Search))q+=$"&search={Uri.EscapeDataString(Search.Trim())}";if(!string.IsNullOrWhiteSpace(Category))q+=$"&category={Uri.EscapeDataString(Category)}";if(!string.IsNullOrWhiteSpace(Priority))q+=$"&priority={Uri.EscapeDataString(Priority)}";if(FromDate is DateOnly fromDate)q+=$"&fromUtc={Uri.EscapeDataString(fromDate.ToString("yyyy-MM-dd",CultureInfo.InvariantCulture)+"T00:00:00Z")}";if(ToDate is DateOnly toDate)q+=$"&toUtc={Uri.EscapeDataString(toDate.AddDays(1).ToString("yyyy-MM-dd",CultureInfo.InvariantCulture)+"T00:00:00Z")}";return await Core.GetAsync(q,s.Token,s.Company,default);}
    private async Task SwitchFilter(string value){Filter=value;Page=1;if(value=="drafts"){await LoadDrafts();return;}await Load();} private async Task SearchNow(){Page=1;await Load();} private async Task SearchKeyDown(KeyboardEventArgs e){if(e.Key=="Enter")await SearchNow();} private async Task CategoryChanged(ChangeEventArgs e){Category=e.Value?.ToString()??"";Page=1;await Load();} private async Task PriorityChanged(ChangeEventArgs e){Priority=e.Value?.ToString()??"";Page=1;await Load();} private async Task FromDateChanged(DateOnly? value){FromDate=value;Page=1;await Load();} private async Task ToDateChanged(DateOnly? value){ToDate=value;Page=1;await Load();} private async Task ClearFilters(){Filter="all";Search=Category=Priority="";FromDate=ToDate=null;Page=1;await Load();} private async Task Previous(){if(Page>1){Page--;await Load();}} private async Task Next(){if(Page<PageCount){Page++;await Load();}}
    private async Task MarkRead(Row row){Busy=true;try{var s=await Session();if(s is null)return;var result=await Core.SendAsync(HttpMethod.Post,$"api/v1/notifications/{row.Id}/read",new{version=row.Version},s.Value.Token,s.Value.Company,default);if(result.IsSuccess)await Load();}finally{Busy=false;}} private async Task MarkAllRead(){Busy=true;ConfirmAll=false;try{var s=await Session();if(s is not null&& (await Core.SendAsync(HttpMethod.Post,"api/v1/notifications/read-all",null,s.Value.Token,s.Value.Company,default)).IsSuccess)await Load();}finally{Busy=false;}}
    private async Task Open(Row row){if(row.ReadAt is null)await MarkRead(row);if(row.SourceRoute is not null)Navigation.NavigateTo(row.SourceRoute);}
    private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out Guid c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
    private string T(string fa,string en,string ar)=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"en"=>en,"ar"=>ar,_=>fa}; private static long GetLong(JsonElement v,string name)=>v.TryGetProperty(name,out var x)&&x.TryGetInt64(out var n)?n:0; private static List<Row> ParseRows(JsonElement v)=>v.TryGetProperty("items",out var a)&&a.ValueKind==JsonValueKind.Array?a.EnumerateArray().Select(x=>new Row(x.GetProperty("id").GetGuid(),Text(x,"templateCode")??"notification",Text(x,"payload")??"{}",x.GetProperty("createdAtUtc").GetDateTimeOffset(),x.TryGetProperty("readAtUtc",out var read)&&read.ValueKind!=JsonValueKind.Null?read.GetDateTimeOffset():null,x.GetProperty("version").GetInt64(),Text(x,"category")??"system",Text(x,"priority")??"info",x.TryGetProperty("isActionable",out var act)&&act.GetBoolean(),Text(x,"sourceReference"),Text(x,"sourceRoute"),Text(x,"summary")??"notification",Text(x,"actionLabelCode"),Text(x,"actionState")??"pending")).ToList():[]; private static string? Text(JsonElement x,string p)=>x.TryGetProperty(p,out var v)&&v.ValueKind!=JsonValueKind.Null?v.ToString():null;
    private string Title(Row r)=>r.Summary switch{"inventory.shortage"=>T("کمبود موجودی","Inventory shortage","نقص في المخزون"),"approval.required"=>T("تأیید مورد نیاز است","Approval required","الموافقة مطلوبة"),"shipment.update"=>T("به‌روزرسانی ارسال","Shipment update","تحديث الشحنة"),"delivery.update"=>T("به‌روزرسانی تحویل","Delivery update","تحديث التسليم"),"task.assigned"=>T("وظیفه جدید به شما واگذار شد","New task assigned","تم تعيين مهمة جديدة لك"),_=>Label(r.TemplateCode)};
