@page "/master/suppliers/{SupplierId:guid}/products"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<CrudStrings> T
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["LinkProduct"] · BARANG</PageTitle><nav class="breadcrumbs"><a href="/master/suppliers">@L["Master_suppliers"]</a><span>/</span><span>@L["LinkProduct"]</span></nav><header class="crud-header"><div><h1>@L["LinkProduct"]</h1><p>@L["AuthoritativeCoreData"]</p></div><button type="button" class="btn btn-primary" @onclick="New"><BarangIcon Name="plus" />@T["Add"]</button></header>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@T[Message]</div>}<section class="crud-card"><div class="crud-toolbar"><label class="search-box"><BarangIcon Name="search" /><input @bind="Search" @bind:event="oninput" placeholder="@T["SearchHint"]"/></label><button type="button" class="btn btn-secondary" @onclick="Load"><BarangIcon Name="refresh" />@T["Refresh"]</button></div>@if(!Filtered.Any()){<CrudEmptyState/>}else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@L["Product"]</th><th>@L["Variant"]</th><th>@L["SupplierItemCode"]</th><th>@T["Status"]</th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(var x in Filtered){<tr><td>@x.Product</td><td>@(x.Variant.Length==0?"—":x.Variant)</td><td><span class="code-pill">@x.Code</span></td><td><StatusBadge Active="x.Active"/></td><td><BarangActionMenu><BarangIconButton Icon="eye" Label="@T["View"]" Semantic="info" Clicked="()=>Open(x,false)" /><BarangIconButton Icon="edit" Label="@T["Edit"]" Semantic="edit" Clicked="()=>Open(x,true)" /><BarangIconButton Icon="power" Label="@(x.Active?T["Deactivate"]:T["Activate"])" Semantic="@(x.Active?"warning":"success")" Clicked="()=>Toggle(x)" /></BarangActionMenu></td></tr>}</tbody></table></div>}</section>
@if(Dialog){<div class="dialog-backdrop" @onclick="Close"><section class="crud-dialog" role="dialog" aria-modal="true" aria-label="@L["LinkProduct"]" @onclick:stopPropagation><header><h2>@L["LinkProduct"]</h2><button type="button" class="dialog-close" title="@T["Close"]" aria-label="@T["Close"]" @onclick="Close"><BarangIcon Name="close" /></button></header><div class="form-grid"><label><span>@L["Product"]</span><SearchableSelect Options="ProductOptions" Value="ProductId" ValueChanged="SetProduct" Disabled="@(!Editable||Id is not null)" Placeholder="@L["Choose"]" /></label><label><span>@L["Variant"]</span><SearchableSelect Options="VariantOptions" @bind-Value="VariantId" Disabled="@(!Editable||Id is not null)" Placeholder="@L["Choose"]" /></label><label><span>@L["SupplierItemCode"]</span><input @bind="ItemCode" disabled="@(!Editable)"/></label></div><footer><button type="button" class="btn btn-secondary" @onclick="Close">@T["Cancel"]</button>@if(Editable){<button type="button" class="btn btn-primary" @onclick="Save">@T["Save"]</button>}</footer></section></div>}
@code{
 [Parameter]public Guid SupplierId{get;set;}private Guid?Id;private long Version;private bool Success,Dialog,Editable;private string Search="",ProductId="",VariantId="",ItemCode="";private string?Message;private List<Row>Rows=[];private List<Option>Products=[],Variants=[];private IReadOnlyList<SearchableSelectOption>ProductOptions=>ToOptions(Products);private IReadOnlyList<SearchableSelectOption>VariantOptions=>ToOptions(Variants);private IEnumerable<Row>Filtered=>Rows.Where(x=>Search.Length==0||(x.Product+x.Variant+x.Code).Contains(Search,StringComparison.CurrentCultureIgnoreCase));protected override async Task OnParametersSetAsync(){await LoadProducts();await Load();}private void New(){Id=null;Version=0;ProductId=VariantId=ItemCode="";Variants=[];Editable=Dialog=true;}private async Task Open(Row x,bool edit){Id=x.Id;Version=x.Version;ProductId=x.ProductId;VariantId=x.VariantId;ItemCode=x.Code;await LoadVariants();Editable=edit;Dialog=true;}private void Close()=>Dialog=false;private async Task SetProduct(string value){ProductId=value;VariantId="";await LoadVariants();}private static IReadOnlyList<SearchableSelectOption>ToOptions(IEnumerable<Option>items)=>items.Select(x=>new SearchableSelectOption(x.Id.ToString(),x.Name)).ToArray();
 private async Task LoadProducts(){var s=await Session();if(s is null)return;var r=await Core.GetAsync("api/v1/products?pageSize=100",s.Value.Token,s.Value.Company,default);if(r.IsSuccess)Products=r.Value.GetProperty("items").EnumerateArray().Select(x=>new Option(x.GetProperty("id").GetGuid(),G(x,"name"))).ToList();}private async Task LoadVariants(){Variants=[];var s=await Session();if(s is null||!Guid.TryParse(ProductId,out var p))return;var r=await Core.GetAsync($"api/v1/products/{p}/variants",s.Value.Token,s.Value.Company,default);if(r.IsSuccess)Variants=r.Value.EnumerateArray().Select(x=>new Option(x.GetProperty("id").GetGuid(),G(x,"displayName"))).ToList();}
 private async Task Load(){Rows=[];var s=await Session();if(s is null)return;var r=await Core.GetAsync($"api/v1/suppliers/{SupplierId}/products",s.Value.Token,s.Value.Company,default);if(r.IsSuccess)Rows=r.Value.EnumerateArray().Select(x=>new Row(x.GetProperty("id").GetGuid(),G(x,"supplierItemCode"),G(x,"productName"),G(x,"variantDisplayName"),G(x,"productId"),G(x,"productVariantId"),B(x,"isActive"),N(x,"version"))).ToList();else Show(r);}private async Task Save(){var s=await Session();if(s is null||!Guid.TryParse(ProductId,out var p))return;Guid?variant=Guid.TryParse(VariantId,out var v)?v:null;var r=await Core.SendAsync(Id is null?HttpMethod.Post:HttpMethod.Put,$"api/v1/suppliers/{SupplierId}/products"+(Id is Guid id?$"/{id}":""),new{productId=p,productVariantId=variant,supplierItemCode=ItemCode,isPreferred=false,version=Version},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){Dialog=false;await Load();}}private async Task Toggle(Row x){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/suppliers/{SupplierId}/products/{x.Id}/activation",new{isActive=!x.Active,version=x.Version},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Forbidden=>"Forbidden",ApiFailure.Conflict=>"ConcurrencyConflict",_=>"ValidationError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private static bool B(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.GetBoolean();private static long N(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.GetInt64():0;private sealed record Option(Guid Id,string Name);private sealed record Row(Guid Id,string Code,string Product,string Variant,string ProductId,string VariantId,bool Active,long Version);
}
