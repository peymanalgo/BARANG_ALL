@using System.Globalization
@using System.Text.Json
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject ILocaleDateService Dates

<section class="crud-card tax-rules-panel" data-pricing-grid="taxes">
    <header class="section-header"><h2>@T("قواعد مالیات", "قواعد الضريبة", "Tax rules")</h2><button class="btn btn-primary btn-small" type="button" @onclick="New"><BarangIcon Name="plus" /> @T("افزودن", "إضافة", "Add")</button></header>
    <div class="crud-toolbar"><label class="search-box"><input value="@Search" @oninput="SearchChanged" placeholder="@T("جست‌وجو", "بحث", "Search")" aria-label="@T("جست‌وجو", "بحث", "Search")" /></label><button class="btn btn-secondary" type="button" @onclick="ResetGrid"><BarangIcon Name="reset" /> @T("بازنشانی", "إعادة ضبط", "Reset")</button></div>
    <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("کد","الرمز","Code")</th><th>@T("نام","الاسم","Name")</th><th>@T("نرخ","المعدل","Rate")</th><th>@T("مولفه","المكوّن","Component")</th><th>@T("دوره","الفترة","Effective period")</th><th>@T("وضعیت","الحالة","Status")</th><th>@T("عملیات","الإجراءات","Actions")</th></tr></thead><tbody>@if(Loading){<tr><td colspan="7">@T("در حال بارگذاری…","جار التحميل…","Loading…")</td></tr>}else if(Rows.Count==0){<tr><td colspan="7">@T("قاعده‌ای یافت نشد.","لم يتم العثور على قواعد.","No tax rules found.")</td></tr>}else foreach(var x in Rows){<tr><td>@x.Code</td><td>@x.Name</td><td>@x.Rate.ToString("N2")%</td><td>@ComponentText(x.Component)</td><td>@DateText(x.From) – @DateText(x.To)</td><td><span class="status-pill @(x.Active?"status-active":"status-inactive")">@(x.Active?T("فعال","نشط","Active"):T("غیرفعال","غير نشط","Inactive"))</span></td><td ><BarangActionMenu><BarangIconButton Icon="eye" Semantic="info" Label="@T("مشاهده","عرض","View")" Clicked="@(()=>Open(x,false))" /><BarangIconButton Icon="edit" Label="@T("ویرایش","تحرير","Edit")" Clicked="@(()=>Open(x,true))" /><BarangIconButton Icon="history" Semantic="info" Label="@T("سابقه","السجل","History")" Clicked="@(()=>HistoryFor(x))" /><BarangIconButton Icon="power" Semantic="warning" Label="@(x.Active?T("غیرفعال‌سازی","تعطيل","Deactivate"):T("فعال‌سازی","تفعيل","Activate"))" Clicked="@(()=>Toggle(x))" /><BarangIconButton Icon="trash" Label="@T("حذف","حذف","Delete")" Clicked="@(()=>Delete(x))" /></BarangActionMenu></td></tr>}</tbody></table></div>
    @if(Message is not null){<div class="@(Success?"inline-success":"inline-error")" role="status">@Message</div>}
</section>

<BarangModal Open="@Dialog" Title="@(Editing is null?T("ایجاد قاعده مالیات","إنشاء قاعدة ضريبية","Create tax rule"):T("ویرایش قاعده مالیات","تحرير قاعدة الضريبة","Edit tax rule"))" Size="large" CloseRequested="Close">
    <div class="form-grid"><label><span>@T("کد","الرمز","Code")</span><input @bind="Code" disabled="@(Editing is not null)" /></label><label><span>@T("نام","الاسم","Name")</span><input @bind="Name" disabled="@ReadOnly" /></label><label><span>@T("نرخ درصدی","النسبة","Rate percent")</span><input type="number" min="0" max="100" step="0.01" @bind="Rate" disabled="@ReadOnly" /></label><label><span>@T("ارز","العملة","Currency")</span><input maxlength="3" @bind="Currency" disabled="@ReadOnly" /></label><label><span>@T("مولفه مشمول","المكوّن الخاضع","Taxable component")</span><select @bind="Component" disabled="@ReadOnly"><option value="">@T("همه مولفه‌ها","كل المكونات","All components")</option><option value="RawProduct">@T("محصول خام","المنتج الخام","Raw product")</option><option value="Print">@T("چاپ","الطباعة","Print")</option><option value="AdditionalService">@T("خدمت اضافی","خدمة إضافية","Additional service")</option><option value="Packaging">@T("بسته‌بندی","التغليف","Packaging")</option><option value="Shipping">@T("ارسال","الشحن","Shipping")</option></select></label><label><span>@T("کد خدمت","رمز الخدمة","Service code")</span><input @bind="ServiceCode" disabled="@ReadOnly" /></label><label><span>@T("کد وضعیت معافیت مشتری","رمز إعفاء العميل","Customer exemption status")</span><input @bind="CustomerTaxStatusCode" disabled="@ReadOnly" /></label><label class="inline-check"><input type="checkbox" @bind="IsExempt" disabled="@ReadOnly" /> @T("معاف","معفى","Exempt")</label><label><span>@T("از تاریخ","من تاريخ","Valid from")</span><LocaleDateInput Value="From" ValueChanged="@(x=>From=x??From)" Disabled="@ReadOnly" /></label><label><span>@T("تا تاریخ","إلى تاريخ","Valid to")</span><LocaleDateInput Value="To" ValueChanged="@(x=>To=x)" Disabled="@ReadOnly" /></label><label class="span-2"><span>@T("شرح","الوصف","Description")</span><textarea @bind="Description" disabled="@ReadOnly"></textarea></label></div><div class="form-actions"><button class="secondary-action" type="button" @onclick="Close">@T("انصراف","إلغاء","Cancel")</button>@if(!ReadOnly){<button class="primary-link" type="button" @onclick="Save">@T("ذخیره","حفظ","Save")</button>}</div>
</BarangModal>

<BarangModal Open="@HistoryDialog" Title="@T("سابقه مالیات","سجل الضريبة","Tax history")" Size="large" CloseRequested="@(()=>HistoryDialog=false)">@if(History is null || History.Value.ValueKind!=JsonValueKind.Array || !History.Value.EnumerateArray().Any()){<div class="empty-state">@T("سابقه‌ای ثبت نشده است.","لا يوجد سجل.","No history recorded.")</div>}else{<div class="record-list">@foreach(var item in History.Value.EnumerateArray()){<div class="record-row"><strong>@item.GetProperty("action").GetString()</strong><small>@item.GetProperty("occurredAtUtc").GetDateTimeOffset().ToLocalTime().ToString("g")</small></div>}</div>}<div class="form-actions"><button class="secondary-action" type="button" @onclick="@(()=>HistoryDialog=false)">@T("بستن","إغلاق","Close")</button></div></BarangModal>

@code {
    private List<Row> Rows=[]; private bool Loading,Dialog,HistoryDialog,ReadOnly,Success; private string? Message; private Row? Editing; private JsonElement? History; private string Search="", Code="",Name="",Description="",Currency="IRR",Component="",ServiceCode="",CustomerTaxStatusCode=""; private decimal Rate; private bool IsExempt; private DateOnly From=DateOnly.FromDateTime(DateTime.Today); private DateOnly? To;
    protected override async Task OnInitializedAsync()=>await Load();
    private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
    private async Task Load(){Loading=true;var s=await Session();if(s is not null){var query="api/v1/pricing/tax-rules?includeInactive=false"+(string.IsNullOrWhiteSpace(Search)?"":"&search="+Uri.EscapeDataString(Search));var r=await Core.GetAsync(query,s.Value.Token,s.Value.Company,default);if(r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array)Rows=r.Value.EnumerateArray().Select(Parse).ToList();}Loading=false;}
    private Task ResetGrid(){Search="";return Load();}
    private async Task SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";await Load();}
    private void New(){Editing=null;ReadOnly=false;Code=Name=Description=ServiceCode=CustomerTaxStatusCode="";Currency="IRR";Component="";Rate=0;IsExempt=false;From=DateOnly.FromDateTime(DateTime.Today);To=null;Dialog=true;}
    private void Open(Row x,bool edit){Editing=x;ReadOnly=!edit;Code=x.Code;Name=x.Name;Description=x.Description??"";Currency=x.Currency;Component=x.Component??"";ServiceCode=x.ServiceCode??"";CustomerTaxStatusCode=x.CustomerTaxStatusCode??"";Rate=x.Rate;IsExempt=x.Exempt;From=x.From;To=x.To;Dialog=true;}
    private async Task Save(){var s=await Session();if(s is null)return;object body=new{code=Code,ratePercent=Rate,isExempt=IsExempt,validFrom=From,validTo=To,name=Name,description=Description,componentType=string.IsNullOrWhiteSpace(Component)?(int?)null:ComponentValue(Component),productId=(Guid?)null,productVariantId=(Guid?)null,serviceCode=string.IsNullOrWhiteSpace(ServiceCode)?null:ServiceCode,customerTaxStatusCode=string.IsNullOrWhiteSpace(CustomerTaxStatusCode)?null:CustomerTaxStatusCode,currencyCode=Currency,version=Editing?.Version??0};ApiResult<JsonElement> r=Editing is null?await Core.SendAsync(HttpMethod.Post,"api/v1/pricing/tax-rules",body,s.Value.Token,s.Value.Company,default):await Core.SendAsync(HttpMethod.Put,$"api/v1/pricing/tax-rules/{Editing.Id}",new{command=body,isActive=Editing.Active},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){Dialog=false;await Load();}}
    private async Task Toggle(Row x){if(!await JS.InvokeAsync<bool>("confirm",x.Active?T("قاعده غیرفعال شود؟","تعطيل القاعدة؟","Deactivate this tax rule?"):T("قاعده فعال شود؟","تفعيل القاعدة؟","Activate this tax rule?")))return;var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Put,$"api/v1/pricing/tax-rules/{x.Id}",new{command=new{code=x.Code,ratePercent=x.Rate,isExempt=x.Exempt,validFrom=x.From,validTo=x.To,name=x.Name,description=x.Description,componentType=x.Component is null?(int?)null:ComponentValue(x.Component),currencyCode=x.Currency,version=x.Version},isActive=!x.Active},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}
    private async Task Delete(Row x){if(!await JS.InvokeAsync<bool>("confirm",T("این قاعده حذف شود؟","حذف هذه القاعدة؟","Delete this tax rule?")))return;var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Delete,$"api/v1/pricing/tax-rules/{x.Id}?version={x.Version}",null,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}
    private async Task HistoryFor(Row x){var s=await Session();if(s is null)return;var r=await Core.GetAsync($"api/v1/pricing/tax-rules/{x.Id}/history",s.Value.Token,s.Value.Company,default);History=r.IsSuccess?r.Value:null;HistoryDialog=true;}
    private void Close()=>Dialog=false;private void Show(ApiResult<JsonElement> r){Success=r.IsSuccess;Message=r.IsSuccess?T("عملیات با موفقیت انجام شد.","تمت العملية بنجاح.","Operation completed."):T("عملیات انجام نشد؛ جزئیات را بررسی کنید.","تعذر تنفيذ العملية؛ راجع التفاصيل.","Operation failed; review the details.");}private Row Parse(JsonElement x)=>new(x.GetProperty("id").GetGuid(),x.GetProperty("code").ToString(),x.GetProperty("name").ToString(),x.TryGetProperty("description",out var d)&&d.ValueKind!=JsonValueKind.Null?d.ToString():null,x.GetProperty("ratePercent").GetDecimal(),x.GetProperty("isExempt").GetBoolean(),x.TryGetProperty("componentType",out var c)&&c.ValueKind!=JsonValueKind.Null?ComponentName(c.ToString()):null,x.GetProperty("currencyCode").ToString(),Canonical(x.GetProperty("validFrom").GetString()!),x.TryGetProperty("validTo",out var to)&&to.ValueKind!=JsonValueKind.Null?Canonical(to.GetString()!):null,x.GetProperty("isActive").GetBoolean(),x.GetProperty("version").GetInt64(),x.TryGetProperty("serviceCode",out var s)&&s.ValueKind!=JsonValueKind.Null?s.ToString():null,x.TryGetProperty("customerTaxStatusCode",out var q)&&q.ValueKind!=JsonValueKind.Null?q.ToString():null);private static string ComponentName(string x)=>x switch{"0"=>"RawProduct","1"=>"Print","2"=>"AdditionalService","3"=>"Packaging","4"=>"Shipping",_=>x};private static int ComponentValue(string x)=>x switch{"RawProduct"=>0,"Print"=>1,"AdditionalService"=>2,"Packaging"=>3,"Shipping"=>4,_=>0};private string ComponentText(string? x)=>x switch{"RawProduct"=>T("محصول خام","المنتج الخام","Raw product"),"Print"=>T("چاپ","الطباعة","Print"),"AdditionalService"=>T("خدمت اضافی","خدمة إضافية","Additional service"),"Packaging"=>T("بسته‌بندی","التغليف","Packaging"),"Shipping"=>T("ارسال","الشحن","Shipping"),_=>T("همه","الكل","All")};private string T(string fa,string ar,string en)=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"en"=>en,"ar"=>ar,_=>fa};private DateOnly Canonical(string value)=>Dates.TryParseCanonical(value,out var date)?date:default;private string DateText(DateOnly? value)=>value is null?"—":Dates.Format(value.Value,CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);private sealed record Row(Guid Id,string Code,string Name,string? Description,decimal Rate,bool Exempt,string? Component,string Currency,DateOnly From,DateOnly? To,bool Active,long Version,string? ServiceCode,string? CustomerTaxStatusCode);
}
