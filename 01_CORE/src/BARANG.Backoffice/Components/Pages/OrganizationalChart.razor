        {
            return ApiResult<JsonElement>.Failed(ApiFailure.Validation, "client.required");
        }

        object request = new
        {
            CompanyModel.Code,
            CompanyModel.DisplayName,
            CompanyModel.LegalName,
            NationalId = Empty(CompanyModel.NationalId),
            RegistrationNumber = Empty(CompanyModel.RegistrationNumber),
            EconomicCode = Empty(CompanyModel.EconomicCode),
            TaxId = Empty(CompanyModel.TaxId),
            Phone = Empty(CompanyModel.Phone),
            Mobile = Empty(CompanyModel.Mobile),
            Email = Empty(CompanyModel.Email),
