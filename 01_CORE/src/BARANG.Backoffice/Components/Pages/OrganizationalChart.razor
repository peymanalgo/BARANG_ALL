@page "/master/organization-chart"
@using System.Text.Json
@attribute [Authorize(Policy = AuthPolicies.CompanySelected)]
@inject IStringLocalizer<OrganizationStrings> O
@inject IStringLocalizer<CrudStrings> T
@inject IStringLocalizer<NavigationStrings> N
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject NavigationManager Navigator

<PageTitle>@O["Chart"] · BARANG</PageTitle>
<div class="organizational-chart-page" data-chart-company-id="@CurrentCompanyId" data-company-directory="@ShowCompanyDirectory.ToString().ToLowerInvariant()">
<nav class="breadcrumbs" aria-label="breadcrumb">
    <span>@N["Nav_MasterData"]</span>
    <span aria-hidden="true">/</span>
    <strong>@N["Nav_OrganizationalChart"]</strong>
</nav>
<header class="crud-header">
    <div>
        <h1>@O["Chart"]</h1>
        <p>@O["EmptyChart"]</p>
    </div>
    <div class="chart-toolbar">
        @if (CanManageCompanies)
        {
            <button type="button" class="btn btn-primary" data-chart-action="company-create" @onclick="AddCompany">@O["AddCompany"]</button>
            <button type="button" class="btn btn-secondary" data-chart-action="company-directory" aria-pressed="@ShowCompanyDirectory.ToString().ToLowerInvariant()" @onclick="ToggleCompanyDirectory">@(ShowCompanyDirectory?O["CurrentCompanyChart"]:O["ManageCompanies"])</button>
        }
        <button type="button" class="btn btn-secondary" @onclick="LoadChart">@T["Refresh"]</button>
        <span data-chart-action="print"><BarangButton Icon="print" Text="@O["PrintChart"]" Clicked="OpenPrintDialog" Disabled="@Loading" /></span>
    </div>
</header>

<BarangToolbar AriaLabel="@O["SearchChart"]">
    <label class="search-box search-with-icon chart-search">
        <BarangIcon Name="search" />
        <input type="search" name="chart-search" aria-label="@O["SearchChart"]" placeholder="@O["SearchChart"]" value="@SearchText" @oninput="SearchChart" disabled="@Loading" />
    </label>
</BarangToolbar>

@if (!string.IsNullOrWhiteSpace(PageMessage))
{
    <div class="@(PageActionSucceeded ? "inline-success" : "inline-error")" role="status">@PageMessage</div>
}

@if (Loading)
{
    <div class="crud-loading">@T["Loading"]</div>
}
else if (LoadError)
{
    <div class="inline-error">@O["OperationFailed"]</div>
}
else
{
    <OrganizationalChartTree
        @key="_chartRevision"
        Companies="_chart.Companies"
        Branches="_chart.Branches"
        Units="_chart.Units"
        Assignments="_chart.Assignments"
        Positions="_chart.Positions"
        SearchQuery="@AppliedSearch"
        Expanded="Expanded"
        HighlightPersonId="null"
        CurrentCompanyId="CurrentCompanyId"
        ManageableCompanyIds="AccessibleCompanyIds"
        Editable="true"
        CanManageCompanies="CanManageCompanies"
        CanManageBranches="CanManageBranches"
        CanManageUnits="CanManageUnits"
        ActionRequested="HandleChartAction" />
}

@if (ActiveDialog is not null && FocusedAssignmentAction is null)
{
    <div class="dialog-backdrop chart-dialog-backdrop" @onclick="CloseDialog" @onkeydown="HandleDialogKey">
        <section class="crud-dialog org-dialog" role="dialog" aria-modal="true" aria-label="@DialogTitle" data-chart-dialog-kind="@DialogKindValue" data-chart-dialog-mode="@DialogMode.ToString()" @onclick:stopPropagation>
            <header>
                <h2>@DialogTitle</h2>
                <button type="button" class="dialog-close" title="@T["Close"]" aria-label="@T["Close"]" @onclick="CloseDialog"><BarangIcon Name="close" /></button>
            </header>

            <div class="dialog-body org-dialog-body">
                @if (ActiveDialog == OrganizationChartDialogKind.Company)
                {
                    <CompanyForm Mode="DialogMode" Model="CompanyModel" />
                }
                else if (ActiveDialog == OrganizationChartDialogKind.Branch)
                {
                    <BranchForm Mode="DialogMode" Model="BranchModel" CompanyName="@GetCompanyName(BranchModel.CompanyId)" />
                }
                else if (ActiveDialog == OrganizationChartDialogKind.Unit)
                {
                    <UnitForm Mode="DialogMode" Model="UnitModel" ParentOptions="UnitParentOptions" CompanyName="@GetUnitCompanyName(UnitModel.BranchId)" BranchName="@GetBranchName(UnitModel.BranchId)" />
                }
                else if (ActiveDialog == OrganizationChartDialogKind.Assignment)
                {
                    <OrganizationalAssignmentEditor
                        Model="AssignmentModel"
                        Mode="DialogMode"
                        SelectedPerson="@SelectedPerson"
                        PersonOptions="PersonOptions"
                        UnitOptions="AssignmentUnitOptions"
                        ManagerOptions="AssignmentManagerOptions"
                        LockManager="LockAssignmentManager"
                        PersonChanged="SelectPerson"
                        SearchPeople="SearchPeople"
                        UnitChanged="SelectUnit"
                        ManagerChanged="SelectManager" />
                }
                else if (ActiveDialog == OrganizationChartDialogKind.Position)
                {
                    <PositionForm Model="PositionModel" Mode="DialogMode" UnitName="@GetUnitName(PositionModel.UnitId)" ReportsToOptions="PositionOptions" ReportsToChanged="SelectReportsTo" />
                }

                @if (!string.IsNullOrWhiteSpace(OperationMessage))
                {
                    <div class="@(LastSaveSucceeded ? "inline-success" : "inline-error")" role="status">@OperationMessage</div>
                }
            </div>

            <footer>
                <button type="button" class="btn btn-secondary" @onclick="CloseDialog" disabled="@Busy">@T["Cancel"]</button>
                @if (DialogMode == FormMode.View && CanEditActiveDialog)
                {
                    <button type="button" class="btn btn-primary" @onclick="SwitchEditMode" disabled="@Busy">@O["Edit"]</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary" @onclick="Save" disabled="@Busy">@(Busy ? T["Saving"] : T["Save"])</button>
                }
            </footer>
        </section>
    </div>
}

<BarangModal Open="@(FocusedAssignmentAction is not null)" Title="@FocusedAssignmentTitle" Size="large" ReserveSelectorSpace="true" Busy="Busy"
             ShowCloseButton="false" CloseRequested="CloseDialog" BackdropClass="chart-dialog-backdrop"
             aria-label="@FocusedAssignmentTitle" data-chart-dialog-kind="assignment" data-chart-dialog-mode="Edit"
             data-chart-workflow="@FocusedWorkflow">
    <ChildContent>
        @if (FocusedAssignment is not null)
        {
            <div class="structure-form" data-chart-form="@FocusedWorkflow">
                <div class="person-summary" data-selected-person-id="@FocusedAssignment.PersonId">
                    <div><span>@O["Person"]</span><strong>@FocusedAssignment.PersonName</strong></div>
                    <div><span>@O["Position"]</span><strong>@FocusedAssignment.PositionTitle</strong></div>
                </div>
                @if (FocusedAssignmentAction == OrganizationChartActionType.ChangeManager)
                {
                    <label><span>@O["Manager"]</span>
                        <SearchableSelect Name="assignment-manager" Options="FocusedManagerOptions" Value="@FocusedValue" ValueChanged="SelectFocusedValue" Disabled="Busy" Placeholder="@T["SearchOptions"]" />
                    </label>
                }
                else
                {
                    <label><span>@O["Unit"] *</span>
                        <SearchableSelect Name="assignment-unit" Options="FocusedUnitOptions" Value="@FocusedValue" ValueChanged="SelectFocusedValue" Disabled="Busy" Placeholder="@T["SearchOptions"]" />
                    </label>
                }
                @if (!string.IsNullOrWhiteSpace(OperationMessage))
                {
                    <div class="inline-error" role="alert">@OperationMessage</div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <BarangButton Text="@T["Cancel"]" Clicked="CloseDialog" Disabled="Busy" />
        <BarangButton Variant="primary" Text="@T["Save"]" BusyText="@T["Saving"]" Busy="Busy" Clicked="SaveFocusedAssignment" />
    </Footer>
</BarangModal>

<BarangModal Open="PrintDialogOpen" Title="@O["PrintChart"]" Size="large" ReserveSelectorSpace="true" Busy="PrintLoading" ShowCloseButton="false"
             CloseRequested="ClosePrintDialog" data-chart-workflow="print-company">
    <ChildContent>
        <label><span>@O["SelectPrintCompany"] *</span>
            <SearchableSelect Name="chart-print-company" Options="PrintCompanyOptions" Value="@PrintCompanyValue" ValueChanged="SelectPrintCompany" Disabled="PrintLoading" Placeholder="@T["SearchOptions"]" />
        </label>
        @if (!string.IsNullOrWhiteSpace(PrintError))
        {
            <div class="inline-error" role="alert">@PrintError</div>
        }
    </ChildContent>
    <Footer>
        <BarangButton Text="@T["Cancel"]" Clicked="ClosePrintDialog" Disabled="PrintLoading" />
        <BarangButton Icon="print" Variant="primary" Text="@O["Print"]" Clicked="OpenPrintPreview" Disabled="@(PrintLoading || string.IsNullOrEmpty(PrintCompanyValue))" />
    </Footer>
</BarangModal>

@if (PendingDelete is not null)
{
    <div class="dialog-backdrop chart-dialog-backdrop" @onclick="CloseDeleteConfirmation" @onkeydown="HandleDeleteDialogKey">
        <section class="crud-dialog chart-delete-dialog" role="alertdialog" aria-modal="true" aria-label="@O["DeleteConfirmTitle"]" data-chart-delete-confirm="@PendingDelete.NodeType.ToString().ToLowerInvariant()" @onclick:stopPropagation>
            <header>
                <h2>@O["DeleteConfirmTitle"]</h2>
                <button type="button" class="dialog-close" title="@T["Close"]" aria-label="@T["Close"]" @onclick="CloseDeleteConfirmation"><BarangIcon Name="close" /></button>
            </header>
            <div class="dialog-body org-dialog-body">
                <p>@O["DeleteConfirmMessage", DeleteEntityName(PendingDelete.NodeType), PendingDelete.Name]</p>
                @if (!string.IsNullOrWhiteSpace(DeleteMessage))
                {
                    <div class="inline-error" role="alert">@DeleteMessage</div>
                }
            </div>
            <footer>
                <button type="button" class="btn btn-secondary" @onclick="CloseDeleteConfirmation" disabled="@DeleteBusy">@T["Cancel"]</button>
                <button type="button" class="btn btn-danger" data-chart-confirm-delete @onclick="ConfirmDelete" disabled="@DeleteBusy">@(DeleteBusy ? T["Saving"] : O["Delete"])</button>
            </footer>
        </section>
    </div>
}
</div>

@code
{
    private OrganizationChartData _chart = OrganizationChartData.Empty;
    private long _chartRevision;
    private HashSet<Guid> Expanded = [];
    private bool Loading;
    private bool LoadError;
    private bool Busy;
    private bool LastSaveSucceeded;
    private bool PageActionSucceeded;
    private string? OperationMessage;
    private string? PageMessage;
    private Guid CurrentCompanyId;
    private Guid? AdministrationCompanyId;
    private CurrentUserView? AdministrationIdentity;
    private bool ShowCompanyDirectory;
    private HashSet<Guid> AccessibleCompanyIds = [];
    private bool CanManageCompanies;
    private bool CanManageBranches;
    private bool CanManageUnits;

    private OrganizationChartDialogKind? ActiveDialog;
    private FormMode DialogMode = FormMode.View;
    private string SelectedPerson = "";
    private CompanyFormModel CompanyModel = new();
    private BranchFormModel BranchModel = new();
    private UnitFormModel UnitModel = new();
    private AssignmentFormModel AssignmentModel = new();
    private PositionFormModel PositionModel = new();
    private List<PersonSearchRow> PersonRows = [];
    private OrganizationChartAction? LastAction;
    private bool LockAssignmentManager;
    private ChartDeleteTarget? PendingDelete;
    private bool DeleteBusy;
    private string? DeleteMessage;

    private IReadOnlyList<SearchableSelectOption> PersonOptions =>
        PersonRows.Select(person => new SearchableSelectOption(person.Id.ToString(), $"{person.Name} · {person.PersonnelCode} · {person.Phone}"))
            .ToArray();

    private IReadOnlyList<SearchableSelectOption> AssignmentUnitOptions =>
        _chart.Units
            .OrderBy(unit => unit.Code)
            .Select(unit => new SearchableSelectOption(unit.Id.ToString(), $"{unit.DisplayName} ({unit.Code})"))
            .ToArray();

    private IReadOnlyList<SearchableSelectOption> AssignmentManagerOptions =>
        GetPossibleManagers()
            .Select(manager => new SearchableSelectOption(
                manager.Id.ToString(),
                $"{manager.PersonName} · {manager.PositionTitle} · {GetUnitName(manager.UnitId)}"))
            .ToArray();

    private IReadOnlyList<SearchableSelectOption> PositionOptions =>
        (_chart.Positions ?? []).Where(position => position.Id != PositionModel.Id && position.Active)
            .OrderBy(position => position.Title)
            .Select(position => new SearchableSelectOption(position.Id.ToString(), $"{position.Title} · {position.Code}"))
            .ToArray();

    private IReadOnlyList<SearchableSelectOption> UnitParentOptions =>
        _chart.Units
            .Where(x => x.BranchId == UnitModel.BranchId && x.Id != UnitModel.Id)
            .OrderBy(x => x.Code)
            .Select(unit => new SearchableSelectOption(unit.Id.ToString(), $"{unit.DisplayName} ({unit.Code})"))
            .ToArray();

    private string DialogKindValue =>
        ActiveDialog switch
        {
            OrganizationChartDialogKind.Company => "company",
            OrganizationChartDialogKind.Branch => "branch",
            OrganizationChartDialogKind.Unit => "unit",
            OrganizationChartDialogKind.Assignment => "assignment",
            _ => "unknown"
        };

    private string DialogTitle
    {
        get
        {
            string entity = ActiveDialog switch
            {
                OrganizationChartDialogKind.Company => O["Company"],
                OrganizationChartDialogKind.Branch => O["Branch"],
                OrganizationChartDialogKind.Unit => O["Unit"],
                OrganizationChartDialogKind.Assignment => O["Assignment"],
                _ => O["Chart"]
            };
            string action = DialogMode switch
            {
                FormMode.Create => T["Add"],
                FormMode.Edit => T["Edit"],
                _ => T["View"]
            };
            return $"{action} · {entity}";
        }
    }

    protected override async Task OnInitializedAsync() => await LoadChart();

    private async Task LoadChart()
    {
        Loading = true;
        LoadError = false;
        StateHasChanged();

        (string Token, Guid Company)? session = await CurrentSession();
        if (session is null)
        {
            LoadError = true;
            Loading = false;
            return;
        }

        ApiResult<JsonElement> chart = await Core.GetAsync("api/v1/organization/chart", session.Value.Token, session.Value.Company, default);
        CurrentCompanyId = session.Value.Company;
        if (chart.IsSuccess)
        {
            _chart = OrganizationChartJson.ParseChart(chart.Value);
            var available = await Core.GetMyCompaniesAsync(session.Value.Token, default);
            AccessibleCompanyIds = available.IsSuccess ? available.Value!.Select(x => x.CompanyId).ToHashSet() : [];
            if(ShowCompanyDirectory && CanManageCompanies)
            {
                var directory = await Core.GetAsync("api/v1/organization/companies", session.Value.Token, session.Value.Company, default);
                if(!directory.IsSuccess){LoadError=true;Loading=false;return;}
                var directoryChart = OrganizationChartJson.ParseChart(JsonSerializer.SerializeToElement(new { companies = directory.Value }));
                _chart = _chart with { Companies = directoryChart.Companies };
            }
            _chartRevision++;
            RefreshExpandedState();
        }
        else
        {
            LoadError = true;
        }

        Loading = false;
    }

    private async Task HandleChartAction(OrganizationChartAction action)
    {
        LastAction = action;
        if(action.ActionType==OrganizationChartActionType.AddBranch && action.NodeId!=CurrentCompanyId && !await SelectAdministrationCompany(action.NodeId))return;
        if (!CanExecute(action))
        {
            return;
        }

        switch (action.ActionType)
        {
            case OrganizationChartActionType.ToggleNode:
                ToggleNode(action.NodeId);
                return;
            case OrganizationChartActionType.AddCompany:
                OpenCompanyCreate();
                return;
            case OrganizationChartActionType.ViewCompany:
                OpenCompanyView(FindCompany(action.NodeId));
                return;
            case OrganizationChartActionType.EditCompany:
                OpenCompanyEdit(FindCompany(action.NodeId));
                return;
            case OrganizationChartActionType.ActivateCompany:
            case OrganizationChartActionType.DeactivateCompany:
                await ToggleCompanyStatus(FindCompany(action.NodeId));
                return;
            case OrganizationChartActionType.DeleteCompany:
                OpenDeleteConfirmation(FindCompany(action.NodeId), action.ParentId);
                return;
            case OrganizationChartActionType.AddBranch:
                OpenBranchCreate(action.NodeId);
                return;
            case OrganizationChartActionType.ViewBranch:
                OpenBranchView(FindBranch(action.NodeId));
                return;
            case OrganizationChartActionType.EditBranch:
                OpenBranchEdit(FindBranch(action.NodeId));
                return;
            case OrganizationChartActionType.ActivateBranch:
            case OrganizationChartActionType.DeactivateBranch:
                await ToggleBranchStatus(FindBranch(action.NodeId));
                return;
            case OrganizationChartActionType.DeleteBranch:
                OpenDeleteConfirmation(FindBranch(action.NodeId), action.ParentId);
                return;
            case OrganizationChartActionType.AddUnit:
                OpenUnitCreate(action.NodeType, action.NodeId, action.ParentId);
                return;
            case OrganizationChartActionType.ViewUnit:
                OpenUnitView(FindUnit(action.NodeId));
                return;
            case OrganizationChartActionType.EditUnit:
                OpenUnitEdit(FindUnit(action.NodeId));
                return;
            case OrganizationChartActionType.ActivateUnit:
            case OrganizationChartActionType.DeactivateUnit:
                await ToggleUnitStatus(FindUnit(action.NodeId));
                return;
            case OrganizationChartActionType.DeleteUnit:
                OpenDeleteConfirmation(FindUnit(action.NodeId), action.ParentId);
                return;
            case OrganizationChartActionType.AddPosition:
                OpenPositionCreate(action.NodeId);
                return;
            case OrganizationChartActionType.ViewPosition:
                OpenPositionView(FindPosition(action.NodeId));
                return;
            case OrganizationChartActionType.EditPosition:
                OpenPositionEdit(FindPosition(action.NodeId));
                return;
            case OrganizationChartActionType.ActivatePosition:
            case OrganizationChartActionType.DeactivatePosition:
                await TogglePositionStatus(FindPosition(action.NodeId));
                return;
            case OrganizationChartActionType.DeletePosition:
                OpenDeleteConfirmation(FindPosition(action.NodeId), action.ParentId);
                return;
            case OrganizationChartActionType.ViewAssignment:
                await OpenAssignmentView(FindAssignment(action.NodeId));
                return;
            case OrganizationChartActionType.AddPerson:
                OpenAssignmentCreate(action.NodeType, action.NodeId);
                return;
            case OrganizationChartActionType.EditAssignment:
                await OpenAssignmentEdit(FindAssignment(action.NodeId));
                return;
            case OrganizationChartActionType.ChangeManager:
            case OrganizationChartActionType.MoveUnit:
                OpenFocusedAssignment(FindAssignment(action.NodeId), action.ActionType);
                return;
            case OrganizationChartActionType.AddSubordinate:
                OpenAssignmentSubordinate(FindAssignment(action.NodeId));
                return;
            case OrganizationChartActionType.ActivateAssignment:
            case OrganizationChartActionType.DeactivateAssignment:
                await ToggleAssignmentStatus(FindAssignment(action.NodeId));
                return;
            case OrganizationChartActionType.DeleteAssignment:
                OpenDeleteConfirmation(FindAssignment(action.NodeId), action.ParentId);
                return;
            case OrganizationChartActionType.ViewPerson:
                await ViewPerson(action.NodeId);
                return;
        }
    }

    private void OpenCompanyCreate()
    {
        CompanyModel = new();
        ActiveDialog = OrganizationChartDialogKind.Company;
        DialogMode = FormMode.Create;
        OperationMessage = null;
        LastSaveSucceeded = false;
    }

    private void OpenCompanyView(CompanyRow? row)
    {
        if (row is null) return;
        CompanyModel = row.ToFormModel();
        ActiveDialog = OrganizationChartDialogKind.Company;
        DialogMode = FormMode.View;
        OperationMessage = null;
        LastSaveSucceeded = false;
    }

    private void OpenCompanyEdit(CompanyRow? row)
    {
        if (row is null) return;
        CompanyModel = row.ToFormModel();
        ActiveDialog = OrganizationChartDialogKind.Company;
        DialogMode = FormMode.Edit;
        OperationMessage = null;
        LastSaveSucceeded = false;
    }

    private void OpenBranchCreate(Guid companyId)
    {
        BranchModel = new() { CompanyId = companyId };
        ActiveDialog = OrganizationChartDialogKind.Branch;
        DialogMode = FormMode.Create;
        OperationMessage = null;
        LastSaveSucceeded = false;
        Expanded.Add(companyId);
    }

    private void OpenBranchView(BranchRow? row)
    {
        if (row is null) return;
        BranchModel = row.ToFormModel();
        ActiveDialog = OrganizationChartDialogKind.Branch;
        DialogMode = FormMode.View;
        OperationMessage = null;
        LastSaveSucceeded = false;
    }

    private void OpenBranchEdit(BranchRow? row)
    {
        if (row is null) return;
        BranchModel = row.ToFormModel();
        ActiveDialog = OrganizationChartDialogKind.Branch;
        DialogMode = FormMode.Edit;
        OperationMessage = null;
        LastSaveSucceeded = false;
        Expanded.Add(row.CompanyId);
    }

    private void OpenUnitCreate(OrganizationChartNodeType sourceType, Guid nodeId, Guid? parentId)
    {
        if (sourceType == OrganizationChartNodeType.Branch)
        {
            OpenUnitWithDefaults(nodeId, null);
            return;
        }

        if (sourceType == OrganizationChartNodeType.Unit)
        {
            Guid branchId = parentId ?? _chart.Units.FirstOrDefault(x => x.Id == nodeId)?.BranchId ?? Guid.Empty;
            if (branchId == Guid.Empty)
            {
                return;
            }

            UnitModel = new() { BranchId = branchId, ParentId = nodeId };
            OpenUnitWithDefaults(branchId, nodeId);
        }
    }

    private void OpenUnitWithDefaults(Guid nodeId, Guid? parentId)
    {
        UnitModel = new()
        {
            BranchId = nodeId,
            ParentId = parentId
        };

        ActiveDialog = OrganizationChartDialogKind.Unit;
        DialogMode = FormMode.Create;
        OperationMessage = null;
        LastSaveSucceeded = false;
        Expanded.Add(nodeId);
    }

    private void OpenAssignmentCreate(OrganizationChartNodeType sourceType, Guid nodeId)
    {
        if (sourceType != OrganizationChartNodeType.Unit)
        {
            return;
        }

        AssignmentModel = new() { UnitId = nodeId };
        LockAssignmentManager = false;
        SelectedPerson = "";
        PersonRows = [];
        ActiveDialog = OrganizationChartDialogKind.Assignment;
        DialogMode = FormMode.Create;
        OperationMessage = null;
        LastSaveSucceeded = false;
        Expanded.Add(nodeId);
    }

    private void OpenUnitView(UnitRow? row)
    {
        if (row is null) return;
        UnitModel = row.ToFormModel();
        ActiveDialog = OrganizationChartDialogKind.Unit;
        DialogMode = FormMode.View;
        OperationMessage = null;
        LastSaveSucceeded = false;
    }

    private void OpenUnitEdit(UnitRow? row)
    {
        if (row is null) return;
        UnitModel = row.ToFormModel();
        ActiveDialog = OrganizationChartDialogKind.Unit;
        DialogMode = FormMode.Edit;
        OperationMessage = null;
        LastSaveSucceeded = false;
        if (row.BranchId is Guid branchId)
        {
            Expanded.Add(branchId);
        }
    }

    private void OpenPositionCreate(Guid unitId)
    {
        PositionModel = new() { UnitId = unitId };
        ActiveDialog = OrganizationChartDialogKind.Position;
        DialogMode = FormMode.Create;
        OperationMessage = null;
        LastSaveSucceeded = false;
        Expanded.Add(unitId);
    }

    private void OpenPositionView(PositionRow? row)
    {
        if (row is null) return;
        PositionModel = ToPositionModel(row);
        ActiveDialog = OrganizationChartDialogKind.Position;
        DialogMode = FormMode.View;
        OperationMessage = null;
        LastSaveSucceeded = false;
    }

    private void OpenPositionEdit(PositionRow? row)
    {
        if (row is null) return;
        PositionModel = ToPositionModel(row);
        ActiveDialog = OrganizationChartDialogKind.Position;
        DialogMode = FormMode.Edit;
        OperationMessage = null;
        LastSaveSucceeded = false;
    }

    private Task SelectReportsTo(string value)
    {
        PositionModel.ReportsToPositionId = Guid.TryParse(value, out Guid id) ? id : null;
        return Task.CompletedTask;
    }

    private static PositionFormModel ToPositionModel(PositionRow row) => new()
    {
        Id = row.Id,
        UnitId = row.UnitId,
        ReportsToPositionId = row.ReportsToPositionId,
        Code = row.Code,
        Title = row.Title,
        Version = row.Version,
        Active = row.Active
    };

    private async Task OpenAssignmentView(AssignmentRow? row)
    {
        if (row is null) return;
        AssignmentModel = row.ToFormModel();
        LockAssignmentManager = false;
        SelectedPerson = row.PersonId.ToString();
        PersonRows = [new PersonSearchRow(row.PersonId, "", row.PersonName, "")];
        ActiveDialog = OrganizationChartDialogKind.Assignment;
        DialogMode = FormMode.View;
        OperationMessage = null;
        LastSaveSucceeded = false;
        await LoadAssignmentPersonSummary(row.PersonId);
    }

    private async Task OpenAssignmentEdit(AssignmentRow? row)
    {
        if (row is null) return;
        AssignmentModel = row.ToFormModel();
        LockAssignmentManager = false;
        SelectedPerson = row.PersonId.ToString();
        PersonRows = [new PersonSearchRow(row.PersonId, "", row.PersonName, "")];
        ActiveDialog = OrganizationChartDialogKind.Assignment;
        DialogMode = FormMode.Edit;
        OperationMessage = null;
        LastSaveSucceeded = false;
        Expanded.Add(row.UnitId);
        await LoadAssignmentPersonSummary(row.PersonId);
    }

    private void OpenAssignmentSubordinate(AssignmentRow? row)
    {
        if (row is null) return;
        AssignmentModel = new()
        {
            UnitId = row.UnitId,
            ManagerId = row.Id
        };
        LockAssignmentManager = true;
        SelectedPerson = "";
        PersonRows = [];
        ActiveDialog = OrganizationChartDialogKind.Assignment;
        DialogMode = FormMode.Create;
        OperationMessage = null;
        LastSaveSucceeded = false;
        Expanded.Add(row.UnitId);
    }

    private async Task ToggleAssignmentStatus(AssignmentRow? row)
    {
        if (row is null) return;
        (string Token, Guid Company)? session = await CurrentSession();
        if (session is null) return;

        ApiResult<JsonElement> response = await Core.SendAsync(
            HttpMethod.Put,
            $"api/v1/organization/chart/assignments/{row.Id}/activation",
            new { isActive = !row.Active, version = row.Version },
            session.Value.Token,
            session.Value.Company,
            default);

        if (!response.IsSuccess)
        {
            PageActionSucceeded = false;
            PageMessage = ProblemMessage(response);
            return;
        }

        PageActionSucceeded = true;
        PageMessage = O["SaveSuccess"];
        await LoadChart();
    }

