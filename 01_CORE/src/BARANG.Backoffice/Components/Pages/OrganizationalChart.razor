    private async Task PersistExpandedAndReload()
    {
        if (ActiveDialog == OrganizationChartDialogKind.Company)
        {
            if (CompanyModel.Id is not null)
            {
                Expanded.Add(CompanyModel.Id.Value);
            }
        }
        else if (ActiveDialog == OrganizationChartDialogKind.Branch)
        {
            if (BranchModel.CompanyId != Guid.Empty)
            {
                Expanded.Add(BranchModel.CompanyId);
            }
            if (DialogMode == FormMode.Create)
            {
                Expanded.Add(BranchModel.CompanyId);
            }
        }
        else if (ActiveDialog == OrganizationChartDialogKind.Unit)
        {
            Expanded.Add(UnitModel.BranchId);
            if (UnitModel.ParentId is Guid parentId)
            {
                Expanded.Add(parentId);
            }
        }
        else if (ActiveDialog == OrganizationChartDialogKind.Assignment)
        {
            Expanded.Add(AssignmentModel.UnitId);
        }

        await LoadChart();
        Busy = false;
        CloseDialog();
    }

    private void RefreshExpandedState()
    {
        HashSet<Guid> valid = [];
        foreach (Guid id in Expanded)
        {
            if (_chart.Companies.Any(x => x.Id == id) || _chart.Branches.Any(x => x.Id == id) || _chart.Units.Any(x => x.Id == id))
            {
                valid.Add(id);
            }
        }

        Expanded = valid;
    }

    private async Task<(string Token, Guid Company)?> CurrentSession()
    {
        System.Security.Claims.ClaimsPrincipal user = (await AuthState.GetAuthenticationStateAsync()).User;
        bool isSystemAdministrator = AdministrationIdentity?.IsSystemAdministrator ?? user.HasClaim(AuthClaimTypes.SystemAdministrator, "true");
        bool HasPermission(string code) => AdministrationIdentity?.EffectivePermissionCodes.Contains(code) ?? user.HasClaim(AuthClaimTypes.Permission, code);
        CanManageCompanies = isSystemAdministrator || HasPermission("organization.company.manage");
        CanManageBranches = isSystemAdministrator || HasPermission("organization.branch.manage");
        CanManageUnits = isSystemAdministrator || HasPermission("organization.unit.manage");
        if (!Guid.TryParse(user.FindFirst(AuthClaimTypes.CompanyId)?.Value, out Guid company))
        {
            return null;
        }

        return user.FindFirst(AuthClaimTypes.AccessToken)?.Value is string token
            ? (token, AdministrationCompanyId ?? company)
            : null;
    }

    private bool CanEditActiveDialog => ActiveDialog switch
    {
        OrganizationChartDialogKind.Company => CanManageCompanies,
        OrganizationChartDialogKind.Branch => CanManageBranches,
        OrganizationChartDialogKind.Unit or OrganizationChartDialogKind.Assignment => CanManageUnits,
        _ => false
    };

    private bool CanExecute(OrganizationChartAction action) => action.ActionType switch
    {
        OrganizationChartActionType.ToggleNode or OrganizationChartActionType.ViewPerson => true,
        OrganizationChartActionType.AddCompany or OrganizationChartActionType.ViewCompany or OrganizationChartActionType.EditCompany or
            OrganizationChartActionType.ActivateCompany or OrganizationChartActionType.DeactivateCompany or OrganizationChartActionType.DeleteCompany => CanManageCompanies,
        OrganizationChartActionType.AddBranch => CanManageBranches && AccessibleCompanyIds.Contains(action.NodeId),
        OrganizationChartActionType.ViewBranch or OrganizationChartActionType.EditBranch or
            OrganizationChartActionType.ActivateBranch or OrganizationChartActionType.DeactivateBranch or OrganizationChartActionType.DeleteBranch => CanManageBranches,
        _ => CanManageUnits
    };

    private string ProblemMessage(ApiResult<JsonElement> result)
    {
        return result.ProblemCode switch
        {
            "client.required" => O["RequiredFields"],
            "organization.assignment.duplicate" => O["DuplicateAssignment"],
            "organization.assignment.reporting_cycle" => O["ReportingCycle"],
            "organization.resource.not_found" => O["InvalidScope"],
            "organization.active_dependents" => O["ValidationError"],
            "organization.code.duplicate" => O["DuplicateCode"],
            "organization.display_order.invalid" => O["DisplayOrderInvalid"],
            "organization.concurrency_conflict" => O["ValidationError"],
            "organization.company.last_active_required" => O["LastActiveCompanyRequired"],
            "organization.delete.has_children" => O["DeleteBlockedChildren"],
            "organization.delete.protected_dependency" => O["DeleteProtectedDependency"],
            null => O["OperationFailed"],
            _ => O["OperationFailed"]
        };
    }

