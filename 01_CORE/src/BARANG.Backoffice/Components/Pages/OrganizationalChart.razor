    private async Task Save()
    {
        if (Busy) return;

        Busy = true;
        LastSaveSucceeded = false;
        OperationMessage = null;
        try
        {
            (string Token, Guid Company)? session = await CurrentSession();
            if (session is null)
            {
                OperationMessage = O["OperationFailed"];
                return;
            }

            ApiResult<JsonElement> response = ActiveDialog switch
            {
                OrganizationChartDialogKind.Company => await SaveCompany(session.Value),
                OrganizationChartDialogKind.Branch => await SaveBranch(session.Value),
                OrganizationChartDialogKind.Unit => await SaveUnit(session.Value),
                OrganizationChartDialogKind.Assignment => await SaveAssignment(session.Value),
                OrganizationChartDialogKind.Position => await SavePosition(session.Value),
                _ => ApiResult<JsonElement>.Failed(ApiFailure.Unexpected)
            };

            if (response.IsSuccess)
            {
                LastSaveSucceeded = true;
                OperationMessage = O["SaveSuccess"];
                await PersistExpandedAndReload();
            }
            else
            {
                OperationMessage = ProblemMessage(response);
            }
        }
        finally
        {
            Busy = false;
            StateHasChanged();
        }
    }

