    private IEnumerable<AssignmentRow> GetPossibleManagers()
    {
        if (AssignmentModel.UnitId == Guid.Empty) return [];

        return _chart.Assignments.Where(x =>
            x.Active &&
            x.Id != AssignmentModel.Id &&
            x.PersonId != AssignmentModel.PersonId);
    }

