    private async Task ConfirmDelete()
    {
        if (PendingDelete is null || DeleteBusy) return;

        DeleteBusy = true;
        DeleteMessage = null;
        try
        {
            (string Token, Guid Company)? session = await CurrentSession();
            if (session is null)
            {
                DeleteMessage = O["OperationFailed"];
                return;
            }

            string route = PendingDelete.NodeType switch
            {
                OrganizationChartNodeType.Company => $"api/v1/organization/companies/{PendingDelete.Id}?version={PendingDelete.Version}",
                OrganizationChartNodeType.Branch => $"api/v1/organization/branches/{PendingDelete.Id}?version={PendingDelete.Version}",
                OrganizationChartNodeType.Unit => $"api/v1/organization/organizational-units/{PendingDelete.Id}?version={PendingDelete.Version}",
                OrganizationChartNodeType.Position => $"api/v1/organization/positions/{PendingDelete.Id}?version={PendingDelete.Version}",
                OrganizationChartNodeType.Assignment => $"api/v1/organization/chart/assignments/{PendingDelete.Id}?version={PendingDelete.Version}",
                _ => ""
            };
            if (string.IsNullOrWhiteSpace(route))
            {
                DeleteMessage = O["OperationFailed"];
                return;
            }

            ApiResult<JsonElement> response = await Core.SendAsync(
                HttpMethod.Delete,
                route,
                null,
                session.Value.Token,
                session.Value.Company,
                default);

            if (!response.IsSuccess)
            {
                DeleteMessage = ProblemMessage(response);
                return;
            }

            OrganizationChartNodeType deletedType = PendingDelete.NodeType;
            bool archived = response.Value.ValueKind == JsonValueKind.Object && response.Value.TryGetProperty("archived", out JsonElement archivedValue) && archivedValue.GetBoolean();
            Guid? parentId = PendingDelete.ParentId;
            PendingDelete = null;
            if (parentId is Guid parent)
            {
                Expanded.Add(parent);
            }

            PageActionSucceeded = true;
            PageMessage = deletedType == OrganizationChartNodeType.Position && archived ? O["PositionArchived"] : O["DeleteSuccess"];
            await LoadChart();
        }
        finally
        {
            DeleteBusy = false;
            StateHasChanged();
        }
    }

