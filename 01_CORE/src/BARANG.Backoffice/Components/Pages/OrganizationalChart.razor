    private async Task<bool> SelectAdministrationCompany(Guid companyId)
    {
        var session = await CurrentSession();
        if(session is null)return false;
        var result = await Core.GetMeAsync(session.Value.Token, companyId, default);
        if(!result.IsSuccess || result.Value is null || (!result.Value.IsSystemAdministrator && !result.Value.EffectivePermissionCodes.Contains("organization.branch.manage")))
        {
            PageActionSucceeded = false;
            PageMessage = O["CompanyAdministrationDenied"];
            return false;
        }
        AdministrationCompanyId = companyId;
        AdministrationIdentity = result.Value;
        Expanded.Clear();
        await LoadChart();
        return !LoadError;
    }

