    private async Task SearchPeople(string query)
    {
        if (string.IsNullOrWhiteSpace(query) || query.Trim().Length < 2)
        {
            PersonRows = [];
            return;
        }

        (string Token, Guid Company)? session = await CurrentSession();
        if (session is null) return;

        ApiResult<JsonElement> result = await Core.GetAsync(
            $"api/v1/organization/persons?search={Uri.EscapeDataString(query)}&take=30",
            session.Value.Token,
            session.Value.Company,
            default);

        if (!result.IsSuccess) return;

        PersonRows = result.Value.EnumerateArray().Select(OrganizationChartJson.ParsePersonSearchRow).ToList();
    }

    private async Task LoadAssignmentPersonSummary(Guid personId)
    {
        (string Token, Guid Company)? session = await CurrentSession();
        if (session is null) return;

        ApiResult<JsonElement> result = await Core.GetAsync(
            $"api/v1/organization/persons/{personId}",
            session.Value.Token,
            session.Value.Company,
            default);
        if (!result.IsSuccess) return;

        PersonSearchRow person = OrganizationChartJson.ParsePersonSearchRow(result.Value);
        PersonRows = [person];
        SelectedPerson = person.Id.ToString();
        AssignmentModel.PersonDisplayName = person.Name;
        AssignmentModel.PersonPersonnelCode = person.PersonnelCode;
        AssignmentModel.PersonMobile = person.Phone;
    }

    private Task SelectPerson(string personId)
    {
        SelectedPerson = personId;
        if (Guid.TryParse(personId, out Guid person))
        {
            AssignmentModel.PersonId = person;
            PersonSearchRow? selected = PersonRows.FirstOrDefault(x => x.Id == person);
            AssignmentModel.PersonDisplayName = selected?.Name ?? "";
            AssignmentModel.PersonPersonnelCode = selected?.PersonnelCode ?? "";
            AssignmentModel.PersonMobile = selected?.Phone ?? "";
        }
        else
        {
            AssignmentModel.PersonId = Guid.Empty;
            AssignmentModel.PersonDisplayName = "";
            AssignmentModel.PersonPersonnelCode = "";
            AssignmentModel.PersonMobile = "";
        }

        return Task.CompletedTask;
    }

