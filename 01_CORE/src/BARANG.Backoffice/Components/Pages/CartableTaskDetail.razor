@page "/cartable/task/{TaskId:guid}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Localization
@using BARANG.Core.Application.Workflow
@inject IStringLocalizer<CartableStrings> C
@inject IStringLocalizer<CartableDecisionStrings> D
@inject IStringLocalizer<CartableFollowUpStrings> F
@inject IStringLocalizer<CartableDelegationStrings> G
@inject IStringLocalizer<EffectiveStatusStrings> E
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@C["TaskWorkspace"]</PageTitle>
<link rel="stylesheet" href="/cartable.css" />
<link rel="stylesheet" href="/order360.css" />
<link rel="stylesheet" href="/order360-embedded.css" />
@if (Loading) { <BarangLoadingState Text='@C["Loading"]' /> }
@* Decision attachments are rendered under their owning history occurrence by Order 360; NoAttachments remains the localized empty-state contract. *@
else if (Row is null) { <div class="inline-error">@C["LoadFailed"]</div> }
else
{
    <main class="cartable-detail-page">
        <header class="cartable-detail-header"><BarangButton Variant="secondary" Icon="arrow-left" Text='@C["Back"]' Clicked="Back" /><div><span class="eyebrow" dir="ltr">@(Row.OrderNumber ?? "—")</span><h1>@Row.Customer</h1><p>@Localized(Row.Stage) · @Row.Position</p></div><span class="cartable-state-pill">@CurrentStatus</span></header>
        @if (!Historical)
        {
            <section class="cartable-panel cartable-actions-panel"><div class="cartable-panel-heading"><h2>@C["Actions"]</h2><small>@Localized(Row.Instructions)</small></div><BarangButton Variant="primary" Icon="user-plus" Text='@C["Claim"]' Busy="@Busy" Clicked="Claim" /></section>
            @if (IsInventoryStage)
            {
                <section class="cartable-panel"><div class="cartable-panel-heading"><h2>@InventoryLabel("رزرو موجودی", "حجز المخزون", "Inventory reservation")</h2><small>@InventoryLabel("انبار مجاز شرکت را انتخاب کنید؛ کمبود باعث باز ماندن task می‌شود.", "اختر مستودع الشركة؛ سيبقى task مفتوحاً عند النقص.", "Select an eligible company warehouse; shortages keep the task open.")</small></div><label for="reservation-warehouse">@InventoryLabel("انبار", "المستودع", "Warehouse")</label><select id="reservation-warehouse" @bind="SelectedWarehouse"><option value="">—</option>@foreach (var warehouse in Warehouses) { <option value="@warehouse.Id">@warehouse.Name</option> }</select></section>
                @if (ShortageRows.Count > 0) { <section class="cartable-panel inline-error"><h3>@InventoryLabel("کمبودهای این سفارش", "نواقص هذا الطلب", "Order shortages")</h3>@foreach (var shortage in ShortageRows) { <div>@shortage.OrderItemId · @InventoryLabel("لازم", "المطلوب", "Required"): @shortage.RequiredQuantity · @InventoryLabel("موجود", "المتاح", "Available"): @shortage.AvailableQuantity · @InventoryLabel("کسری", "النقص", "Missing"): @shortage.ShortageQuantity · @shortage.UomCode</div> }</section> }
            }
        }
        <section class="cartable-panel cartable-360-panel"><OrderDetails OrderId="@Row.OrderId" TaskId="@Row.Id" Embedded="true" /></section>
    </main>
}
@if (ConfirmOutcome is not null) { <div class="dialog-backdrop"><section class="dialog-card"><h2>@C["ConfirmTitle"]</h2><p>@C["ConfirmContext"]</p><strong>@Row?.OrderNumber · @Localized(Row!.Stage) · @Outcome(ConfirmOutcome)</strong><div class="form-actions"><BarangButton Variant="primary" Text='@C["Confirm"]' Busy="@Busy" Clicked="Complete" /><BarangButton Variant="secondary" Text='@C["Cancel"]' Clicked='@(() => ConfirmOutcome=null)' /></div></section></div> }
@if (OperationalPopupOpen && Row is not null)
{
    <CartableDecisionPopup Visible="true" OrderNumber="@(Row.OrderNumber ?? "—")" Stage="@Localized(Row.Stage)" Note="@Note" NoteChanged="@(value => Note = value)" Outcomes="@Row.Outcomes" Busy="@Busy" Decision="PopupDecision" Cancel="CloseOperationalPopup" />
}
@if (ReleaseConfirm) { <div class="dialog-backdrop"><section class="dialog-card"><h2>@F["ReleaseTask"]</h2><p>@F["ReleasePrompt"]</p><div class="form-actions"><BarangButton Variant="primary" Text='@F["ReleaseTask"]' Busy="@Busy" Clicked="Release" /><BarangButton Variant="secondary" Text='@C["Cancel"]' Clicked='@(() => ReleaseConfirm=false)' /></div></section></div> }
@if (ForwardOpen) { <div class="dialog-backdrop"><section class="dialog-card" role="dialog" aria-modal="true" aria-labelledby="forward-title"><h2 id="forward-title">@G["Forward"]</h2><p>@G["ForwardPrompt"]</p><label for="forward-search">@G["TargetSearch"]</label><div class="form-actions"><input id="forward-search" @bind="ForwardSearch" @bind:event="oninput" /><BarangButton Variant="secondary" Icon="search" Text='@C["Search"]' Clicked="LoadForwardTargets" /></div>@if (ForwardTargets.Count == 0) { <p class="muted">@G["NoTargets"]</p> } else { <label for="forward-target">@G["ForwardTo"]</label><select id="forward-target" @bind="ForwardTargetUserId"><option value="">—</option>@foreach (var target in ForwardTargets) { <option value="@target.Id">@target.Name · @target.Position</option> }</select>}<label for="forward-reason">@G["ForwardReason"]</label><textarea id="forward-reason" @bind="ForwardReason"></textarea><div class="form-actions"><BarangButton Variant="primary" Text='@G["Forward"]' Busy="@Busy" Clicked="Forward" /><BarangButton Variant="secondary" Text='@C["Cancel"]' Clicked='@(() => ForwardOpen=false)' /></div></section></div> }
@if (Message is not null) { <div class="inline-error">@Message</div> }

@code {
    [Parameter] public Guid TaskId { get; set; }
    [SupplyParameterFromQuery] public string? Mode { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    private bool Loading = true, Busy, ReleaseConfirm, ForwardOpen, OperationalPopupOpen, _disposed; private string Note = ""; private string? Message, ConfirmOutcome, FollowUpError, AttachmentMessage; private TaskRow? Row; private JsonElement Order; private List<MessageRow> Messages = []; private List<PendingAttachment> Attachments = []; private DateOnly? FollowUpDate; private string FollowUpTime = "09:00"; private string ForwardSearch = "", ForwardTargetUserId = "", ForwardReason = ""; private List<(Guid Id, string Name, string Position)> ForwardTargets = []; private List<(Guid Id, string Name)> Warehouses = []; private List<ShortageRow> ShortageRows = []; private string SelectedWarehouse = ""; private CancellationTokenSource? _loadCts;
    private CartableWorkflowContextView? Context;
    private bool ContextRequested;
    private bool Historical => string.Equals(Mode, "referrals", StringComparison.OrdinalIgnoreCase);
    private bool IsInventoryStage => Row is not null && (Row.Stage.Fa.Contains("رزرو") || Row.Stage.Ar.Contains("حجز") || Row.Stage.En.Contains("reservation", StringComparison.OrdinalIgnoreCase));
    private string InventoryLabel(string fa,string ar,string en) => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "en"=>en,"ar"=>ar,_=>fa };
    private string CurrentStatus { get { var workflow = Order.ValueKind == JsonValueKind.Object && Order.TryGetProperty("workflowStatus", out var w) ? w : default; string code = Text(workflow, "code", ""); if (code == "AuditRejected") return E["AuditRejected"].Value; if (code == "WorkflowCompleted") return E["WorkflowCompleted"].Value; if (code != "InWorkflow") return E["Registered"].Value; string[] titles = Array(workflow, "activeStages").Select(LocalizedStage).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.Ordinal).ToArray(); return titles.Length == 0 ? C["InWorkflow"].Value : CartableStatus(string.Join(" / ", titles)); } }
    private string CartableStatus(string title) => $"{E["InCartable"].Value} {title}";
    private string Localized(WorkflowLocalizedText x) => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "en" => x.En, "ar" => x.Ar, _ => x.Fa };
    private string Ui(string key) => (CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, key) switch { ("en", "PreviousContext") => "Previous", ("ar", "PreviousContext") => "السابق", ("en", "CurrentContext") => "Current", ("ar", "CurrentContext") => "الحالي", ("en", "PossibleNextContext") => "Possible next", ("ar", "PossibleNextContext") => "المسارات التالية المحتملة", ("en", "DependsOnDecision") => "Depends on decision", ("ar", "DependsOnDecision") => "حسب نتيجة القرار", ("en", "NoNext") => "No next destination", ("ar", "NoNext") => "لا توجد وجهة تالية", ("en", "Terminal") => "Workflow completed", ("ar", "Terminal") => "اكتمل سير العمل", ("en", "Close") => "Close", ("ar", "Close") => "إغلاق", ("fa", "PreviousContext") => "قبلی", ("fa", "CurrentContext") => "فعلی", ("fa", "PossibleNextContext") => "گام‌های ممکن بعدی", ("fa", "DependsOnDecision") => "بر اساس نتیجه تصمیم", ("fa", "NoNext") => "مقصد بعدی مشخصی ندارد", ("fa", "Terminal") => "پایان گردش کار", _ => key };
    private string LocalizedStage(JsonElement e) { if (e.ValueKind != JsonValueKind.Object || !e.TryGetProperty("stageTitle", out var t) || t.ValueKind != JsonValueKind.Object) return ""; string lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; return t.TryGetProperty(lang, out var v) ? v.ToString() : Text(t, "en", ""); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (!Historical && Row is not null && !ContextRequested && !_disposed) { ContextRequested = true; try { var s = await Session(); if (s is not null) { var r = await Core.GetAsync($"api/v1/workflows/definition/runtime/tasks/{Row.Id}/context", s.Value.Token, s.Value.Company, _loadCts?.Token ?? default); if (r.IsSuccess) Context = r.Value.Deserialize<CartableWorkflowContextView>(); } } catch (OperationCanceledException) { } catch (JsonException) { Message = C["LoadFailed"].Value; } catch (InvalidOperationException) { Message = C["LoadFailed"].Value; } finally { if (!_disposed) await InvokeAsync(StateHasChanged); } } }
    protected override async Task OnParametersSetAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        Loading = true;
        Message = null;
        try
        {
            var s = await Session();
            if (s is null) return;
            string path = Historical ? "api/v1/workflows/definition/runtime/tasks/referrals" : "api/v1/workflows/definition/runtime/tasks/eligible";
            var r = await Core.GetAsync($"{path}?taskId={TaskId}&page=1&pageSize=1", s.Value.Token, s.Value.Company, _loadCts?.Token ?? default);
            if (!r.IsSuccess) { Message = C["LoadFailed"].Value; return; }
            if (r.Value.TryGetProperty("items", out var a)) Row = a.EnumerateArray().Select(Parse).FirstOrDefault(x => x.Id == TaskId);
            if (Row is null) return;
            if (IsInventoryStage) { var warehouses = await Core.GetAsync("api/v1/inventory/warehouses", s.Value.Token, s.Value.Company, _loadCts?.Token ?? default); if (warehouses.IsSuccess && warehouses.Value.ValueKind == JsonValueKind.Array) Warehouses = warehouses.Value.EnumerateArray().Where(x => x.TryGetProperty("isActive", out var active) ? active.GetBoolean() : true).Select(x => (Id: x.GetProperty("id").GetGuid(), Name: x.TryGetProperty("name", out var name) ? name.GetString() ?? "—" : "—")).ToList(); }
            SetFollowUpInputs(Row.FollowUpAtUtc);
            var o = await Core.GetAsync($"api/v1/orders/{Row.OrderId}/360", s.Value.Token, s.Value.Company, _loadCts?.Token ?? default);
            if (!o.IsSuccess) { Message = C["LoadFailed"].Value; return; }
            Order = o.Value;
            var m = await Core.GetAsync($"api/v1/orders/{Row.OrderId}/messages", s.Value.Token, s.Value.Company, _loadCts?.Token ?? default);
            if (m.IsSuccess && m.Value.ValueKind == JsonValueKind.Array) Messages = m.Value.EnumerateArray().Select(ParseMessage).ToList();
            if (!Historical) await Core.SendAsync(HttpMethod.Post, $"api/v1/workflows/definition/runtime/tasks/{Row.Id}/personal-state", new { isStarred = (bool?)null, seen = true }, s.Value.Token, s.Value.Company, default);
        }
        catch (OperationCanceledException) { Message = C["LoadFailed"].Value; }
        catch (JsonException) { Message = C["LoadFailed"].Value; }
        catch (InvalidOperationException) { Message = C["LoadFailed"].Value; }
        finally { if (!_disposed) Loading = false; }
    }
    public ValueTask DisposeAsync() { _disposed = true; _loadCts?.Cancel(); _loadCts?.Dispose(); return ValueTask.CompletedTask; }
    private void Back() => Navigation.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/cartable" : ReturnUrl);
    private Task Claim() { if (Row is not null && !Historical && !Busy) OperationalPopupOpen = true; return Task.CompletedTask; }
    private void CloseOperationalPopup() { if (!Busy) OperationalPopupOpen = false; }
    private async Task PopupDecision(string outcome)
    {
        if (Row is null || Busy) return;
        OperationalPopupOpen = false;
        if (Row.ClaimedBy is null)
        {
            Busy = true;
            var s = await Session();
            if (s is null) { Busy = false; return; }
            var claim = await Core.SendAsync(HttpMethod.Post, $"api/v1/workflows/definition/runtime/tasks/{Row.Id}/claim", new { version = Row.Version }, s.Value.Token, s.Value.Company, default);
            Busy = false;
            if (!claim.IsSuccess) { Message = C["ClaimConflict"].Value; await OnParametersSetAsync(); return; }
            await OnParametersSetAsync();
        }
        if (Row is not null) { ConfirmOutcome = outcome; await Complete(); }
    }
    private void AskRelease() => ReleaseConfirm = true;
    private async Task OpenForward() { ForwardOpen = true; ForwardSearch = ""; ForwardReason = ""; ForwardTargetUserId = ""; await LoadForwardTargets(); }
    private async Task LoadForwardTargets() { var s = await Session(); if (s is null || Row is null) return; var r = await Core.GetAsync($"api/v1/workflows/definition/runtime/tasks/{Row.Id}/forward-targets?search={Uri.EscapeDataString(ForwardSearch)}", s.Value.Token, s.Value.Company, default); if (r.IsSuccess && r.Value.ValueKind == JsonValueKind.Array) ForwardTargets = r.Value.EnumerateArray().Select(x => (x.GetProperty("userId").GetGuid(), x.GetProperty("personName").GetString() ?? "—", x.GetProperty("positionTitle").GetString() ?? "—")).ToList(); }
    private async Task Forward() { if (Row is null || !Guid.TryParse(ForwardTargetUserId, out Guid target) || string.IsNullOrWhiteSpace(ForwardReason) || Busy) return; Busy = true; var s = await Session(); if (s is not null) { var r = await Core.SendAsync(HttpMethod.Post, $"api/v1/workflows/definition/runtime/tasks/{Row.Id}/forward", new { targetUserId = target, reason = ForwardReason, version = Row.Version }, s.Value.Token, s.Value.Company, default); if (r.IsSuccess) { ForwardOpen = false; await DiscardPending(s.Value.Token, s.Value.Company); await OnParametersSetAsync(); } else Message = G["ForwardFailed"].Value; } Busy = false; }
    private async Task Release() { if (Row is null || Busy || Row.ClaimedBy is null) return; Busy = true; var s = await Session(); if (s is not null) { var r = await Core.SendAsync(HttpMethod.Post, $"api/v1/workflows/definition/runtime/tasks/{Row.Id}/release", new { version = Row.Version }, s.Value.Token, s.Value.Company, default); if (r.IsSuccess) { await DiscardPending(s.Value.Token, s.Value.Company); ReleaseConfirm = false; await OnParametersSetAsync(); } else Message = F["ReleaseFailed"].Value; } Busy = false; }
    private void SetFollowUpInputs(DateTimeOffset? value) { if (value is DateTimeOffset at) { DateTime local = at.ToLocalTime().DateTime; FollowUpDate = DateOnly.FromDateTime(local); FollowUpTime = local.ToString("HH:mm", CultureInfo.InvariantCulture); } else { FollowUpDate = null; FollowUpTime = "09:00"; } FollowUpError = null; }
    private Task FollowUpDateChanged(DateOnly? value) { FollowUpDate = value; return Task.CompletedTask; }
    private DateTimeOffset? FollowUpUtc() { if (FollowUpDate is not DateOnly date || !TimeSpan.TryParseExact(FollowUpTime, "hh\\:mm", CultureInfo.InvariantCulture, out TimeSpan time)) return null; DateTime local = date.ToDateTime(TimeOnly.FromTimeSpan(time), DateTimeKind.Unspecified); TimeSpan offset = TimeZoneInfo.Local.GetUtcOffset(local); return new DateTimeOffset(local, offset).ToUniversalTime(); }
    private string FollowUpText(DateTimeOffset value) => Dates.Format(value, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
    private async Task SaveFollowUp() { if (Row is null || Busy) return; DateTimeOffset? followUp = FollowUpUtc(); if (followUp is null || followUp <= DateTimeOffset.UtcNow) { FollowUpError = F["FutureRequired"].Value; return; } await SendFollowUp(new { followUpAtUtc = followUp }); }
    private async Task ClearFollowUp() => await SendFollowUp(new { clearFollowUp = true });
    private async Task SendFollowUp(object command) { if (Row is null) return; Busy = true; FollowUpError = null; var s = await Session(); if (s is not null) { var r = await Core.SendAsync(HttpMethod.Post, $"api/v1/workflows/definition/runtime/tasks/{Row.Id}/personal-state", command, s.Value.Token, s.Value.Company, default); if (r.IsSuccess) { DateTimeOffset? value = r.Value.TryGetProperty("followUpAtUtc", out var p) && p.ValueKind != JsonValueKind.Null ? p.GetDateTimeOffset() : null; Row = Row with { FollowUpAtUtc = value }; SetFollowUpInputs(value); } else FollowUpError = F["SaveFailed"].Value; } Busy = false; }
    private void Ask(string outcome) { if (Row is not null && !Historical) { ConfirmOutcome = outcome; OperationalPopupOpen = true; } }
    private async Task Complete() { if (Row is null || ConfirmOutcome is null || Busy) return; if (IsInventoryStage && !Guid.TryParse(SelectedWarehouse, out _)) { Message = InventoryLabel("انتخاب انبار الزامی است.", "اختيار المستودع مطلوب.", "Warehouse selection is required."); return; } Busy = true; ShortageRows = []; var s = await Session(); if (s is not null) { object payload = IsInventoryStage ? new { outcome = ConfirmOutcome, note = Note.Trim(), warehouseId = SelectedWarehouse, idempotencyKey = $"workflow-task:{Row.Id:N}" } : new { outcome = ConfirmOutcome, note = Note.Trim() }; var r = await Core.SendAsync(HttpMethod.Post, $"api/v1/workflows/definition/runtime/tasks/{Row.Id}/complete", new { resultJson = JsonSerializer.Serialize(payload), attachments = Attachments.Select(x => new { fileId = x.FileId, fileVersionId = x.FileVersionId }).ToArray(), version = Row.Version }, s.Value.Token, s.Value.Company, default); if (r.IsSuccess) Back(); else { if (r.ProblemCode == "inventory.reservation.shortage" && !string.IsNullOrWhiteSpace(r.ProblemDescription)) try { ShortageRows = JsonSerializer.Deserialize<List<ShortageRow>>(r.ProblemDescription, new JsonSerializerOptions(JsonSerializerDefaults.Web)) ?? []; } catch (JsonException) { } Message = r.ProblemCode switch { "inventory.reservation.shortage" => InventoryLabel("کمبود موجودی؛ task تکمیل نشد.", "نقص المخزون؛ لم يكتمل task.", "Shortage; task remains open."), "workflow.decision_attachment.too_many" => D["FileTooLarge"].Value, "workflow.decision_attachment.invalid_file" => D["UploadFailed"].Value, _ => C["StateChanged"].Value }; } } Busy = false; }
    private async Task SelectAttachments(InputFileChangeEventArgs args) { AttachmentMessage = null; var session = await Session(); if (session is null) return; int available = DecisionAttachmentPolicy.MaximumCount - Attachments.Count; if (available <= 0) { AttachmentMessage = D["FileTooLarge"].Value; return; } foreach (IBrowserFile file in args.GetMultipleFiles(available)) { try { await using Stream stream = file.OpenReadStream(25 * 1024 * 1024); var uploaded = await Core.UploadAsync("api/v1/files/upload", file.Name, file.ContentType, stream, file.Size, session.Value.Token, session.Value.Company, default); if (!uploaded.IsSuccess) { AttachmentMessage = uploaded.Failure == ApiFailure.Validation ? D["FileTypeNotAllowed"].Value : D["UploadFailed"].Value; continue; } JsonElement value = uploaded.Value; Attachments.Add(new PendingAttachment(value.GetProperty("fileId").GetGuid(), value.GetProperty("fileVersionId").GetGuid(), value.GetProperty("originalFileName").GetString() ?? file.Name, value.GetProperty("mediaType").GetString() ?? file.ContentType, value.GetProperty("sizeBytes").GetInt64())); } catch (Exception) { AttachmentMessage = D["UploadFailed"].Value; } } }
    private async Task RemoveAttachment(PendingAttachment attachment) { var session = await Session(); if (session is not null) await Core.SendAsync(HttpMethod.Delete, $"api/v1/files/{attachment.FileId}/versions/{attachment.FileVersionId}/discard", null, session.Value.Token, session.Value.Company, default); Attachments.Remove(attachment); }
    private async Task DiscardPending(string token, Guid company) { foreach (PendingAttachment attachment in Attachments) await Core.SendAsync(HttpMethod.Delete, $"api/v1/files/{attachment.FileId}/versions/{attachment.FileVersionId}/discard", null, token, company, default); Attachments.Clear(); }
    private async Task OpenAttachment(DecisionAttachmentView attachment) { var session = await Session(); if (session is null) return; var result = await Core.DownloadAsync($"api/v1/workflows/definition/runtime/decision-attachments/{attachment.Id}/download", session.Value.Token, session.Value.Company, default); if (result.IsSuccess) await JS.InvokeVoidAsync("open", $"data:{result.Value.ContentType};base64,{Convert.ToBase64String(result.Value.Content)}", "_blank"); }
    private string Outcome(string x) => x.Equals("Reject", StringComparison.OrdinalIgnoreCase) ? C["Reject"].Value : x.Equals("AuditReject", StringComparison.OrdinalIgnoreCase) ? C["AuditReject"].Value : C["Approve"].Value;
    private string Variant(string x) => x.Equals("Reject", StringComparison.OrdinalIgnoreCase) ? "danger" : "primary"; private string Icon(string x) => x.Equals("Reject", StringComparison.OrdinalIgnoreCase) ? "close" : "check";
    private string Localized(LocalizedText x) => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "en" => x.En, "ar" => x.Ar, _ => x.Fa }; private string DateTime(DateTimeOffset x) => Dates.Format(x, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
    private TaskRow Parse(JsonElement x) => new(x.GetProperty("id").GetGuid(), x.GetProperty("orderId").GetGuid(), GetString(x, "orderNumber"), GetString(x, "customerName") ?? "—", GetText(x, "stage"), GetText(x, "instructions"), GetString(x, "positionTitle") ?? "—", x.TryGetProperty("workflowVersion", out var w) ? w.GetInt32() : 0, x.GetProperty("version").GetInt64(), x.TryGetProperty("claimedByUserId", out var c) && c.ValueKind != JsonValueKind.Null ? c.GetGuid() : null, Strings(x, "availableOutcomes"), Dates.TryParseCanonical(GetString(x, "orderDate") ?? "", out var d) ? d : null, NullableDateTime(x, "followUpAtUtc"));
    private static MessageRow ParseMessage(JsonElement x) => new(x.GetProperty("id").GetGuid(), GetString(x, "username"), GetString(x, "positionTitle"), GetString(x, "text") ?? "", x.GetProperty("createdAtUtc").GetDateTimeOffset(), x.TryGetProperty("attachments", out var a) && a.ValueKind == JsonValueKind.Array ? a.EnumerateArray().Select(ParseAttachment).ToArray() : [], GetString(x, "onBehalfOfName"));
    private static DecisionAttachmentView ParseAttachment(JsonElement x) => new(x.GetProperty("id").GetGuid(), x.GetProperty("runtimeTaskId").GetGuid(), x.GetProperty("fileId").GetGuid(), x.GetProperty("fileVersionId").GetGuid(), GetString(x, "fileName") ?? "", GetString(x, "mediaType") ?? "application/octet-stream", x.GetProperty("sizeBytes").GetInt64(), x.GetProperty("createdAtUtc").GetDateTimeOffset());
    private static DateTimeOffset? NullableDateTime(JsonElement x, string n) => x.TryGetProperty(n, out var v) && v.ValueKind != JsonValueKind.Null ? v.GetDateTimeOffset() : null; private static LocalizedText GetText(JsonElement x, string n) => x.TryGetProperty(n, out var v) ? new(Text(v, "fa"), Text(v, "en"), Text(v, "ar")) : new("", "", ""); private static string? GetString(JsonElement x, string n) => x.TryGetProperty(n, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null; private static string Text(JsonElement x, string n, string f = "") => x.ValueKind == JsonValueKind.Object && x.TryGetProperty(n, out var v) && v.ValueKind != JsonValueKind.Null ? v.ToString() : f; private static IReadOnlyList<string> Strings(JsonElement x, string n) => x.TryGetProperty(n, out var v) && v.ValueKind == JsonValueKind.Array ? v.EnumerateArray().Select(a => a.ToString()).ToArray() : []; private static JsonElement[] Array(JsonElement x, string n) => x.ValueKind == JsonValueKind.Object && x.TryGetProperty(n, out var a) && a.ValueKind == JsonValueKind.Array ? a.EnumerateArray().ToArray() : [];
    private async Task<(string Token, Guid Company)?> Session() { var u = (await AuthState.GetAuthenticationStateAsync()).User; return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value, out var c) && u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t ? (t, c) : null; }
    private sealed record LocalizedText(string Fa, string En, string Ar); private sealed record PendingAttachment(Guid FileId, Guid FileVersionId, string FileName, string MediaType, long SizeBytes); private sealed record ShortageRow(Guid OrderItemId,Guid ProductVariantId,string UomCode,decimal RequiredQuantity,decimal AvailableQuantity,decimal ShortageQuantity); private sealed record TaskRow(Guid Id, Guid OrderId, string? OrderNumber, string Customer, LocalizedText Stage, LocalizedText Instructions, string Position, int WorkflowVersion, long Version, Guid? ClaimedBy, IReadOnlyList<string> Outcomes, DateOnly? OrderDate, DateTimeOffset? FollowUpAtUtc); private sealed record MessageRow(Guid Id, string? AuthorName, string? Position, string Text, DateTimeOffset Created, IReadOnlyList<DecisionAttachmentView> Attachments, string? OnBehalfOfName);
}
