@page "/master/design-categories"
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Rendering
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<DesignBankStrings> D
@inject IStringLocalizer<AppStrings> L

@code {
    [Parameter] public bool Embedded { get; set; }
}

<PageTitle>@D["Categories"]</PageTitle>
<section class="page-shell design-category-admin @(Embedded ? "embedded-design-category-admin" : "")">
    <header class="page-header"><div><h1>@D["Categories"]</h1><p>@D["DesignBank"]</p></div><button type="button" class="btn btn-primary" aria-label="@L["Add"]" title="@D["AddRoot"]" @onclick="(() => New(null))">@D["AddRoot"]</button></header>
    <div class="crud-toolbar"><label class="search-box"><span class="visually-hidden">@D["SearchCategories"]</span><input type="search" value="@Search" @oninput="SearchChanged" placeholder="@D["SearchCategories"]" aria-label="@D["SearchCategories"]" /></label>@if (!string.IsNullOrWhiteSpace(Search)) { <button type="button" class="btn btn-secondary" @onclick="ClearSearch">@D["ClearSearch"]</button> }</div>
    @if (!string.IsNullOrWhiteSpace(Message)) { <div class="inline-@(Success ? "success" : "error")" role="@(Success ? "status" : "alert")">@Message</div> }
    @if (Busy) { <p role="status">@L["Loading"]</p> } else if (VisibleRoots.Count == 0) { <p class="empty-state" role="status">@(string.IsNullOrWhiteSpace(Search) ? L["NoResults"] : D["NoMatchingCategories"])</p> } else { <div class="design-category-tree" role="tree" aria-label="@D["Categories"]">@foreach (var root in VisibleRoots) { @NodeView(root, 0) }</div> }
</section>

<BarangModal Open="@EditorOpen" Title="@(EditorMode == "view" ? D["ViewCategory"] : EditingId is null ? D["AddCategory"] : D["EditCategory"])" Size="large" CloseLabel="@L["Cancel"]" CloseRequested="CloseEditor">
    <ChildContent><fieldset disabled="@(EditorMode == "view")"><div class="form-grid">
        <label><span>@D["Code"] *</span><input name="category-code" @bind="Code" /></label><label><span>@D["PersianCaption"] *</span><input name="category-fa" dir="rtl" @bind="Fa" /></label><label><span>@D["ArabicCaption"] *</span><input name="category-ar" dir="rtl" @bind="Ar" /></label><label><span>@D["EnglishCaption"] *</span><input name="category-en" dir="ltr" @bind="En" /></label><label><span>@D["Description"]</span><textarea name="category-description" @bind="Description"></textarea></label><label><span>@D["SortOrder"]</span><input name="category-sort-order" type="number" @bind="SortOrder" /></label><label class="check-field"><input name="category-active" type="checkbox" @bind="Active" /><span>@D["Active"]</span></label><label><span>@D["ParentCategory"]</span><DesignCategoryPicker Value="@ParentCode" ValueChanged="ParentCodeChanged" SelectedId="@ParentId" SelectedIdChanged="ParentIdChanged" Disabled="@(EditorMode == "view")" /></label>
    </div></fieldset>@if (EditorMode == "view" && EditingId is Guid selected && Items.FirstOrDefault(x => x.Id == selected) is Node current) { <dl class="details-grid"><dt>@D["CategoryPath"]</dt><dd>@current.Path</dd><dt>@D["Status"]</dt><dd>@(current.Active ? D["Active"] : D["Inactive"])</dd></dl> }@if (!string.IsNullOrWhiteSpace(EditorError)) { <div class="inline-error" role="alert">@EditorError</div> }</ChildContent>
    <Footer><button type="button" class="btn btn-secondary" @onclick="CloseEditor">@L["Cancel"]</button>@if (EditorMode != "view") { <button type="button" class="btn btn-primary" disabled="@Saving" @onclick="Save">@(Saving ? L["Saving"] : L["Save"])</button>}</Footer>
</BarangModal>

<BarangModal Open="@MoveOpen" Title="@D["MoveCategory"]" Size="large" CloseLabel="@L["Cancel"]" CloseRequested="CloseMove"><ChildContent><p>@D["MoveCategoryHint"]</p><label><span>@D["DestinationParent"]</span><DesignCategoryPicker Value="@MoveParentCode" ValueChanged="MoveParentCodeChanged" SelectedId="@MoveParentId" SelectedIdChanged="MoveParentIdChanged" /><button type="button" class="btn btn-secondary" @onclick="ClearMoveParent">@L["NotSpecified"]</button></label>@if (!string.IsNullOrWhiteSpace(MoveError)) { <div class="inline-error" role="alert">@MoveError</div> }</ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="CloseMove">@L["Cancel"]</button><button type="button" class="btn btn-primary" disabled="@Saving" @onclick="Move">@(Saving ? L["Saving"] : D["Move"])</button></Footer></BarangModal>
<BarangModal Open="@ViewOpen" Title="@D["ViewCategory"]" Size="medium" CloseLabel="@L["Close"]" CloseRequested="CloseView"><ChildContent>@if (Viewed is not null) { <dl class="details-grid"><dt>@D["Code"]</dt><dd>@Viewed.Code</dd><dt>@D["CategoryPath"]</dt><dd>@Viewed.Path</dd><dt>@D["Description"]</dt><dd>@Viewed.Description</dd><dt>@D["SortOrder"]</dt><dd>@Viewed.SortOrder</dd><dt>@D["Status"]</dt><dd>@(Viewed.Active ? D["Active"] : D["Inactive"])</dd></dl> }</ChildContent></BarangModal>
<BarangConfirmDialog Open="@ConfirmOpen" Title="@ConfirmTitle" Description="@ConfirmDescription" CancelText="@L["Cancel"]" ConfirmText="@L["Confirm"]" Busy="@Saving" Cancel="CancelConfirmation" Confirm="ConfirmAction" />

@code {
    private List<Node> Items = []; private HashSet<Guid> Expanded = []; private bool Loaded; private bool Busy, EditorOpen, MoveOpen, ViewOpen, ConfirmOpen, Saving, Success; private string Search = "", Code = "", Fa = "", Ar = "", En = "", Description = "", ParentCode = ""; private string MoveParentCode = "", EditorMode = "edit", EditorError = "", MoveError = "", Message = ""; private Guid? EditingId, ParentId, MoveParentId; private Node? MoveTarget, Viewed; private string ConfirmTitle = "", ConfirmDescription = ""; private Func<Task>? ConfirmedAction; private string Token = ""; private Guid Company; private int SortOrder; private bool Active = true;
    private IReadOnlyList<Node> VisibleRoots => Items.Where(x => x.ParentId is null && (string.IsNullOrWhiteSpace(Search) || HasMatchInBranch(x))).ToArray();
    protected override async Task OnInitializedAsync(){var user=(await AuthState.GetAuthenticationStateAsync()).User;Token=user.FindFirst(AuthClaimTypes.AccessToken)?.Value??"";Guid.TryParse(user.FindFirst(AuthClaimTypes.CompanyId)?.Value,out Company);await Load();}
    private async Task Load(){Busy=true;var preserved=Expanded.Concat(Items.Where(x=>x.Expanded).Select(x=>x.Id)).ToHashSet();var result=await Core.GetAsync("api/v1/lookups/types/artwork.category/values?activeOnly=false",Token,Company,default);if(result.IsSuccess){Items=result.Value.EnumerateArray().Select(x=>new Node(x)).ToList();foreach(var node in Items)node.Path=BuildPath(node);var valid=Items.Select(x=>x.Id).ToHashSet();Expanded=Loaded?preserved.Where(valid.Contains).ToHashSet():Items.Where(x=>Items.Any(child=>child.ParentId==x.Id)).Select(x=>x.Id).ToHashSet();if(!string.IsNullOrWhiteSpace(Search))foreach(var node in Items.Where(HasMatch))ExpandAncestors(node);foreach(var node in Items)node.Expanded=Expanded.Contains(node.Id);Loaded=true;Message="";}else{Items=[];Message=ErrorText(result.ProblemCode,result.Failure);Success=false;}Busy=false;}
    private bool HasMatchInBranch(Node root)=>Items.Any(x=>HasMatch(x)&&IsInBranch(x,root.Id)); private bool HasMatch(Node n)=>n.Code.Contains(Search.Trim(),StringComparison.CurrentCultureIgnoreCase)||n.Caption.Contains(Search.Trim(),StringComparison.CurrentCultureIgnoreCase);
    private bool IsInBranch(Node node,Guid rootId){Guid? current=node.Id;var seen=new HashSet<Guid>();while(current is Guid id&&seen.Add(id)){if(id==rootId)return true;current=Items.FirstOrDefault(x=>x.Id==id)?.ParentId;}return false;}
    private void ExpandAncestors(Node node){Guid? current=node.ParentId;var seen=new HashSet<Guid>();while(current is Guid id&&seen.Add(id)){Expanded.Add(id);current=Items.FirstOrDefault(x=>x.Id==id)?.ParentId;}}
    private RenderFragment NodeView(Node node,int level)=>builder=>{int seq=0;var children=Items.Where(x=>x.ParentId==node.Id&&(string.IsNullOrWhiteSpace(Search)||HasMatchInBranch(x))).ToArray();builder.OpenElement(seq++,"div");builder.AddAttribute(seq++,"class","design-tree-node");builder.AddAttribute(seq++,"role","treeitem");builder.AddAttribute(seq++,"data-category-id",node.Id);builder.OpenElement(seq++,"div");builder.AddAttribute(seq++,"class",$"design-tree-row {(HasMatch(node)&&!string.IsNullOrWhiteSpace(Search)?"tree-search-match":"")}");builder.AddAttribute(seq++,"style",$"padding-inline-start:{level*1.25+0.5}rem");if(children.Length>0)AddAction(builder,ref seq,node.Expanded?"chevron-down":"chevron-right",node.Expanded?D["Collapse"]:D["Expand"],()=>Toggle(node.Id),"tree-toggle",node.Expanded?"chevron-down":"chevron-right");else{builder.OpenElement(seq++,"span");builder.AddAttribute(seq++,"class","tree-spacer");builder.CloseElement();}builder.OpenElement(seq++,"span");builder.AddAttribute(seq++,"class","tree-node-caption");builder.AddContent(seq++,$"{node.Caption} ({D["Code"]}: {node.Code})");builder.CloseElement();builder.OpenElement(seq++,"span");builder.AddAttribute(seq++,"class","row-actions");AddAction(builder,ref seq,"folder-plus",TreeLabel("add-child"),()=>New(node.Id),"tree-action", "folder-plus", "success");AddAction(builder,ref seq,"eye",TreeLabel("view"),()=>OpenView(node),"tree-action", "eye", "info");AddAction(builder,ref seq,"edit",TreeLabel("edit"),()=>Edit(node),"tree-action", "edit", "edit");AddAction(builder,ref seq,"move",D["Move"],()=>OpenMove(node),"tree-action", "move", "info");AddAction(builder,ref seq,"power",TreeLabel(node.Active?"deactivate":"activate"),()=>AskToggle(node),"tree-action", "power", node.Active?"warning":"success");AddAction(builder,ref seq,"trash",TreeLabel("delete"),()=>AskDelete(node),"tree-action danger", "trash", "danger");builder.CloseElement();builder.CloseElement();if(node.Expanded)foreach(var child in children)builder.AddContent(seq++,NodeView(child,level+1));builder.CloseElement();};
    private void AddAction(RenderTreeBuilder b,ref int seq,string icon,string label,Func<Task> action,string css,string? aria=null,string? semantic=null){b.OpenComponent<BarangIconButton>(seq++);b.AddAttribute(seq++,"Icon",icon);b.AddAttribute(seq++,"Label",label);b.AddAttribute(seq++,"Semantic",semantic);b.AddAttribute(seq++,"Class",css);b.AddAttribute(seq++,"StopPropagation",true);b.AddAttribute(seq++,"Clicked",EventCallback.Factory.Create<MouseEventArgs>(this,action));b.CloseComponent();}
    private static string TreeLabel(string action)=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "en" => action switch { "view"=>"View", "edit"=>"Edit", "add-child"=>"Add subcategory", "activate"=>"Activate", "deactivate"=>"Deactivate", "delete"=>"Delete", _=>action }, "ar" => action switch { "view"=>"عرض", "edit"=>"تحرير", "add-child"=>"إضافة فئة فرعية", "activate"=>"تفعيل", "deactivate"=>"تعطيل", "delete"=>"حذف", _=>action }, _ => action switch { "view"=>"مشاهده", "edit"=>"ویرایش", "add-child"=>"افزودن زیردسته", "activate"=>"فعال‌سازی", "deactivate"=>"غیرفعال‌سازی", "delete"=>"حذف", _=>action } };
    private Task Toggle(Guid id){if(!Expanded.Add(id))Expanded.Remove(id);var node=Items.FirstOrDefault(x=>x.Id==id);if(node is not null)node.Expanded=Expanded.Contains(id);return Task.CompletedTask;} private void SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";foreach(var node in Items.Where(HasMatch))ExpandAncestors(node);foreach(var node in Items)node.Expanded=Expanded.Contains(node.Id);} private void ClearSearch()=>Search="";
    private Task New(Guid? parent){EditingId=null;EditorMode="edit";Code=Fa=Ar=En=Description="";SortOrder=0;Active=true;ParentId=parent;ParentCode=parent is Guid id?Items.FirstOrDefault(x=>x.Id==id)?.Code??"":"";EditorError="";EditorOpen=true;return Task.CompletedTask;} private Task Edit(Node n){EditingId=n.Id;EditorMode="edit";Code=n.Code;Fa=n.Fa;Ar=n.Ar;En=n.En;Description=n.Description;SortOrder=n.SortOrder;Active=n.Active;ParentId=n.ParentId;ParentCode=n.ParentId is Guid id?Items.FirstOrDefault(x=>x.Id==id)?.Code??"":"";EditorError="";EditorOpen=true;return Task.CompletedTask;} private Task OpenView(Node n){Viewed=n;ViewOpen=true;return Task.CompletedTask;} private Task OpenMove(Node n){MoveTarget=n;MoveParentId=n.ParentId;MoveParentCode=n.ParentId is Guid id?Items.FirstOrDefault(x=>x.Id==id)?.Code??"":"";MoveError="";MoveOpen=true;return Task.CompletedTask;}
    private void CloseEditor()=>EditorOpen=false;private void CloseMove()=>MoveOpen=false;private void CloseView()=>ViewOpen=false;private void ParentIdChanged(Guid? id){ParentId=id;ParentCode=id is Guid value?Items.FirstOrDefault(x=>x.Id==value)?.Code??"":"";}private void ParentCodeChanged(string value)=>ParentCode=value;private void MoveParentIdChanged(Guid? id){MoveParentId=id;MoveParentCode=id is Guid value?Items.FirstOrDefault(x=>x.Id==value)?.Code??"":"";}private void MoveParentCodeChanged(string value)=>MoveParentCode=value;private void ClearMoveParent(){MoveParentId=null;MoveParentCode="";}
    private async Task Save(){if(string.IsNullOrWhiteSpace(Code)||string.IsNullOrWhiteSpace(Fa)||string.IsNullOrWhiteSpace(Ar)||string.IsNullOrWhiteSpace(En)){EditorError=D["RequiredFields"];return;}Saving=true;var translations=new Dictionary<string,string>{{"fa",Fa},{"ar",Ar},{"en",En}};var descriptions=new Dictionary<string,string>{{"fa",Description},{"ar",Description},{"en",Description}};object body=EditingId is null?new{code=Code,displayOrder=SortOrder,parentId=ParentId,translations,descriptions}:new{displayOrder=SortOrder,isActive=Active,parentId=ParentId,translations,descriptions,version=Items.First(x=>x.Id==EditingId).Version};var result=await Core.SendAsync(EditingId is null?HttpMethod.Post:HttpMethod.Put,EditingId is Guid id?$"api/v1/lookups/values/{id}/editor":"api/v1/lookups/types/artwork.category/values",body,Token,Company,default);Saving=false;if(result.IsSuccess){if(ParentId is Guid parent)Expanded.Add(parent);if(EditingId is Guid edited)Expanded.Add(edited);EditorOpen=false;Message=L["OperationSucceeded"];Success=true;await Load();}else{EditorError=ErrorText(result.ProblemCode,result.Failure);Success=false;}}
    private async Task Move(){if(MoveTarget is null)return;Saving=true;var result=await Core.SendAsync(HttpMethod.Put,$"api/v1/lookups/values/{MoveTarget.Id}/editor",new{displayOrder=MoveTarget.SortOrder,isActive=MoveTarget.Active,parentId=MoveParentId,translations=new Dictionary<string,string>{{"fa",MoveTarget.Fa},{"ar",MoveTarget.Ar},{"en",MoveTarget.En}},version=MoveTarget.Version},Token,Company,default);Saving=false;if(result.IsSuccess){if(MoveParentId is Guid parent)Expanded.Add(parent);MoveOpen=false;Message=D["MoveSucceeded"];Success=true;await Load();}else{MoveError=ErrorText(result.ProblemCode,result.Failure);Success=false;}}
    private Task AskToggle(Node n){ConfirmTitle=n.Active?D["Deactivate"]:D["Activate"];ConfirmDescription=n.Active?D["ConfirmDeactivate"]:D["ConfirmActivate"];ConfirmedAction=()=>ToggleActive(n);ConfirmOpen=true;return Task.CompletedTask;}private Task AskDelete(Node n){ConfirmTitle=D["Delete"];ConfirmDescription=D["ConfirmDeleteCategory"];ConfirmedAction=()=>Delete(n);ConfirmOpen=true;return Task.CompletedTask;}private async Task ConfirmAction(){ConfirmOpen=false;if(ConfirmedAction is not null)await ConfirmedAction();ConfirmedAction=null;}private void CancelConfirmation(){ConfirmOpen=false;ConfirmedAction=null;}
    private async Task ToggleActive(Node n){Saving=true;var result=await Core.SendAsync(HttpMethod.Post,$"api/v1/lookups/values/{n.Id}/activation",new{isActive=!n.Active,version=n.Version},Token,Company,default);Saving=false;if(result.IsSuccess){Message=n.Active?D["DeactivateSucceeded"]:D["ActivateSucceeded"];Success=true;await Load();}else{Message=ErrorText(result.ProblemCode,result.Failure);Success=false;}}
    private async Task Delete(Node n){Saving=true;var result=await Core.SendAsync(HttpMethod.Delete,$"api/v1/lookups/values/{n.Id}?version={n.Version}",null,Token,Company,default);Saving=false;if(result.IsSuccess){Message=D["DeleteSucceeded"];Success=true;Expanded.Remove(n.Id);await Load();}else{Message=ErrorText(result.ProblemCode,result.Failure);Success=false;}}
    private string ErrorText(string? code,ApiFailure failure)=>code switch{"artwork.category.has_children"=>D["CategoryHasChildren"],"lookup.value_referenced"=>D["CategoryReferenced"],"artwork.category.cycle"=>D["CategoryCycle"],"artwork.category.invalid_parent"=>D["InvalidParent"],_=>failure==ApiFailure.Conflict?L["ConcurrencyConflict"]:L["ValidationError"]};
    private string BuildPath(Node node){var parts=new List<string>();Guid? current=node.Id;var seen=new HashSet<Guid>();while(current is Guid id&&seen.Add(id)){var item=Items.FirstOrDefault(x=>x.Id==id);if(item is null)break;parts.Add(item.Caption);current=item.ParentId;}parts.Reverse();return string.Join(" > ",parts);}
    private sealed class Node{public Guid Id;public Guid? ParentId;public string Code="",Fa="",Ar="",En="",Caption="",Description="",Path="";public int SortOrder;public bool Active,Expanded;public long Version;public Node(JsonElement x){Id=x.GetProperty("id").GetGuid();ParentId=x.TryGetProperty("parentId",out var p)&&p.ValueKind!=JsonValueKind.Null?p.GetGuid():null;Code=Text(x,"code");SortOrder=x.TryGetProperty("displayOrder",out var order)?order.GetInt32():0;Active=x.GetProperty("isActive").GetBoolean();Version=x.GetProperty("version").GetInt64();if(x.TryGetProperty("translations",out var ts))foreach(var t in ts.EnumerateArray()){var c=Text(t,"culture");var v=Text(t,"displayName");if(c=="fa")Fa=v;if(c=="ar")Ar=v;if(c=="en")En=v;}Description=x.TryGetProperty("translations",out ts)?ts.EnumerateArray().Select(t=>Text(t,"description")).FirstOrDefault(x=>!string.IsNullOrWhiteSpace(x))??"":"";Caption=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"ar"=>Ar,"en"=>En,_=>Fa};Expanded=ParentId is null;}private static string Text(JsonElement x,string name)=>x.TryGetProperty(name,out var p)&&p.ValueKind!=JsonValueKind.Null?p.ToString():"";}
}
