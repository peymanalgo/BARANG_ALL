@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject ILocaleDateService Dates

<PageTitle>@T("نمونه‌های گردش کار","Workflow instances","مثيلات سير العمل") · BARANG</PageTitle>
<main class="page-shell bpms-page" aria-labelledby="bpms-inst-heading">
  <header><h1 id="bpms-inst-heading">@T("نمونه‌های فرایند","Process instances","مثيلات العملية")</h1>
    <p>@T("همه نمونه‌های موتور گردش کار با گام جاری و زمان چرخه","All workflow engine instances with current step and cycle time","جميع مثيلات المحرك مع الخطوة الحالية وزمن الدورة")</p></header>
  <section class="panel bpms-toolbar bpms-noprint">
    <label>@T("وضعیت","Status","الحالة")
      <select class="bpms-filter" value="@Status" @onchange="StatusChanged">
        <option value="">@T("همه","All","الكل")</option>
        <option value="Running">@T("در حال اجرا","Running","قيد التنفيذ")</option>
        <option value="Completed">@T("تکمیل‌شده","Completed","مكتملة")</option>
        <option value="Suspended">@T("معلق","Suspended","معلّقة")</option>
        <option value="Cancelled">@T("لغوشده","Cancelled","ملغاة")</option>
      </select>
    </label>
    <button type="button" class="btn btn-secondary" @onclick="Load"><BarangIcon Name="refresh" />@T("به‌روزرسانی","Refresh","تحديث")</button>
    <span class="bpms-pager">
      <button type="button" class="btn btn-secondary" disabled="@(Page <= 1)" @onclick="() => Go(Page - 1)">‹</button>
      <span>@T("صفحه","Page","صفحة") @Page @T("از","of","من") @Math.Max(1, (int)((Total + PageSize - 1) / PageSize)) (@Total)</span>
      <button type="button" class="btn btn-secondary" disabled="@(Page * PageSize >= Total)" @onclick="() => Go(Page + 1)">›</button>
    </span>
  </section>
  @if (Loading) { <section class="panel"><span class="dashboard-spinner" aria-hidden="true"></span><p>@T("در حال بارگذاری…","Loading…","جار التحميل…")</p></section> }
  else if (Error is not null) { <section class="panel inline-error" role="alert">@Error</section> }
  else if (Rows.Count == 0) { <section class="panel"><p class="bpms-empty">@T("نمونه‌ای یافت نشد","No instances found","لم يُعثر على مثيلات")</p></section> }
  else
  {
    <section class="panel">
      <table class="bpms-table"><thead><tr><th>@T("سفارش","Order","الطلب")</th><th>@T("مشتری","Customer","العميل")</th><th>@T("وضعیت","Status","الحالة")</th><th>@T("گام جاری","Current step(s)","الخطوة الحالية")</th><th>@T("شروع","Started","البدء")</th><th>@T("پایان","Completed","الاكتمال")</th><th>@T("چرخه (ساعت)","Cycle (h)","الدورة (س)")</th><th></th></tr></thead>
      <tbody>@foreach (Row r in Rows)
      {
        <tr>
          <td>@(r.OrderNumber ?? r.Id.ToString()[..8])</td>
          <td>@r.Customer</td>
          <td><span class="bpms-badge @r.Status.ToLowerInvariant()">@StatusFa(r.Status)</span></td>
          <td>@r.CurrentNodes</td>
          <td>@Date(r.StartedAtUtc)</td>
          <td>@(r.CompletedAtUtc is { } d ? Date(d) : "—")</td>
          <td>@r.CycleHours</td>
          <td><a href="/workspace/workflow/instances/@r.Id">@T("خط زمانی","Timeline","الخط الزمني") →</a></td>
        </tr>
      }</tbody></table>
    </section>
  }
</main>

@code {
  private bool Loading = true; private string? Error; private List<Row> Rows = []; private string Status = ""; private int Page = 1; private long Total; private const int PageSize = 20;
  protected override async Task OnInitializedAsync() => await Load();
  private async Task Load()
  {
    Loading = true; Error = null;
    try
    {
      var s = await Session(); if (s is null) { Error = T("نشست معتبر نیست.","Session is not valid.","الجلسة غير صالحة."); return; }
      var r = await Core.GetAsync($"api/v1/workflows/instances?status={Status}&page={Page}&pageSize={PageSize}", s.Value.Token, s.Value.Company, default);
      if (!r.IsSuccess) { Error = r.ProblemDescription ?? T("فهرست نمونه‌ها در دسترس نیست.","Instances unavailable.","المثيلات غير متاحة."); return; }
      Rows = r.Value.GetProperty("items").EnumerateArray().Select(Row.Parse).ToList();
      Total = r.Value.GetProperty("total").GetInt64();
    }
    catch (Exception ex) { Error = ex.Message; }
    finally { Loading = false; }
  }
  private async Task StatusChanged(ChangeEventArgs e) { Status = e.Value?.ToString() ?? ""; Page = 1; await Load(); }
  private async Task Go(int page) { Page = Math.Max(1, page); await Load(); }
  private string StatusFa(string s) => s switch { "Running" => T("در حال اجرا","Running","قيد التنفيذ"), "Completed" => T("تکمیل‌شده","Completed","مكتملة"), "Suspended" => T("معلق","Suspended","معلّقة"), "Cancelled" => T("لغوشده","Cancelled","ملغاة"), "Failed" => T("ناموفق","Failed","فاشلة"), _ => s };
  private string Date(DateTimeOffset v) => Dates.Format(v, Culture);
  private string Culture => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
  private string T(string fa, string en, string ar) => Culture switch { "en" => en, "es" => EsGlossary.Tr(en), "ar" => ar, _ => fa };
  private async Task<(string Token, Guid Company)?> Session() { var u = (await AuthState.GetAuthenticationStateAsync()).User; return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value, out var c) && u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t ? (t, c) : null; }
  private sealed record Row(Guid Id, string Status, DateTimeOffset StartedAtUtc, DateTimeOffset? CompletedAtUtc, string? OrderNumber, string Customer, string CurrentNodes, decimal CycleHours)
  {
    public static Row Parse(JsonElement x) => new(x.GetProperty("id").GetGuid(), x.GetProperty("status").GetString() ?? "", x.GetProperty("startedAtUtc").GetDateTimeOffset(),
      x.TryGetProperty("completedAtUtc", out JsonElement c) && c.ValueKind != JsonValueKind.Null ? c.GetDateTimeOffset() : null,
      x.TryGetProperty("orderNumber", out JsonElement o) && o.ValueKind == JsonValueKind.String ? o.GetString() : null,
      x.GetProperty("customer").GetString() ?? "", x.GetProperty("currentNodes").GetString() ?? "",
      x.TryGetProperty("cycleHours", out JsonElement h) && h.ValueKind == JsonValueKind.Number ? h.GetDecimal() : 0m);
  }
}
