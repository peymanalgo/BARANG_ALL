    private string UnsavedTitle=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "en"=>"Unsaved changes", "ar"=>"تغييرات غير محفوظة", _=>"تغییرات ذخیره‌نشده" };
    private string UnsavedDescription=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "en"=>"Your changes have not been saved. Do you want to discard them?", "ar"=>"لم يتم حفظ تغييراتك. هل تريد تجاهلها؟", _=>"تغییرات ذخیره نشده‌اند. آیا می‌خواهید آن‌ها را دور بیندازید؟" };
    private string KeepEditingText=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "en"=>"Keep editing", "ar"=>"متابعة التحرير", _=>"ادامه ویرایش" };
    private string DiscardChangesText=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "en"=>"Discard changes", "ar"=>"تجاهل التغييرات", _=>"دور انداختن تغییرات" };
    private string RequiredField(string field)=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "en"=>field switch { "code"=>"Enter a design code.", "title"=>"Enter a design title.", _=>"Select a design category." }, "ar"=>field switch { "code"=>"أدخل رمز التصميم.", "title"=>"أدخل عنوان التصميم.", _=>"اختر فئة التصميم." }, _=>field switch { "code"=>"کد طرح را وارد کنید.", "title"=>"عنوان طرح را وارد کنید.", _=>"دسته‌بندی طرح را انتخاب کنید." } };
    private string DuplicateCodeMessage=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "en"=>"A design with this code already exists. Enter a different code.", "ar"=>"يوجد تصميم بهذا الرمز بالفعل. أدخل رمزاً آخر.", _=>"طراحی با این کد از قبل وجود دارد؛ کد دیگری وارد کنید." };
    private string ConcurrencyMessage=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "en"=>"This record was changed by someone else. Close the dialog, reopen it and try again.", "ar"=>"تم تغيير هذا السجل بواسطة مستخدم آخر. أغلق النافذة وأعد فتحها ثم حاول مجدداً.", _=>"این رکورد توسط کاربر دیگری تغییر کرده است؛ پنجره را ببندید و دوباره باز کنید." };
    private bool HasUnsavedChanges=>!Viewing&&Dialog&&!string.Equals(Fingerprint(),InitialFingerprint,StringComparison.Ordinal);
    private string Fingerprint()=>string.Join("|",Code,Title,Description,Category,CategoryId,SubcategoryId,TypeId,StyleId,ThemeId,AudienceId,LicenseId,UsageId,Lifecycle,string.Join(",",TagIds.Order(StringComparer.OrdinalIgnoreCase)));
    private void Close(){if(HasUnsavedChanges){CloseConfirmOpen=true;return;}Dialog=false;EditorError="";}
    private void KeepEditing()=>CloseConfirmOpen=false;
    private void DiscardAndClose(){CloseConfirmOpen=false;Dialog=false;EditorError="";}
    private string CategoryText(JsonElement x)=>CategoryCaptions.TryGetValue(Text(x,"categoryCode"),out var value)?value:Text(x,"categoryCode"); private string LifecycleText(string value,string archived)=>archived=="True"?D["Inactive"]:value switch{"Draft"=>D["Draft"],"Active"=>D["Active"],"Archived"=>D["Archived"],_=>value}; private string HistoryText(string value)=>value switch{"artwork.created"=>D["Created"],"artwork.updated"=>D["Updated"],"artwork.archived"=>D["Deactivated"],"artwork.restored"=>D["Activated"],"file.uploaded"=>D["FileUploaded"],"artwork.version.created"=>D["FileUploaded"],_=>value}; private static string Text(JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=JsonValueKind.Null?p.ToString():"";
