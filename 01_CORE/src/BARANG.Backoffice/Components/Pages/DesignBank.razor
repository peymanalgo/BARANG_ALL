@page "/manage/design-bank"
@page "/manage/artwork"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@using System.Globalization
@using System.Text.Json
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<NavigationStrings> N
@inject IStringLocalizer<DesignBankStrings> D
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject LocaleDateService Dates
@inject IJSRuntime JS

<PageTitle>@N["Nav_ArtworkBank"]</PageTitle>
<nav class="breadcrumbs"><span>@L["Module_master-data"]</span><span>/</span><span>@N["Nav_ArtworkBank"]</span></nav>
<header class="crud-header"><div><h1>@N["Nav_ArtworkBank"]</h1><p>@L["AuthoritativeCoreData"]</p></div><div class="row-actions"><button type="button" class="btn btn-secondary" @onclick="OpenConceptSearch"><BarangIcon Name="search" /> @D["ConceptSearch"]</button><button type="button" class="btn btn-primary" @onclick="New">@L["Action_Create"]</button></div></header>
<section class="crud-card">
  <div class="crud-toolbar"><label class="search-box"><span class="sr-only">@L["Search"]</span><input value="@Search" @oninput="SearchChanged" placeholder="@L["SearchPlaceholder"]" /></label><button type="button" class="btn btn-secondary" @onclick="Load"><BarangIcon Name="reset" /> @L["Reset"]</button></div>
  @if (Busy) { <BarangLoadingState Text="@L["Loading"]" /> }
  else if (Rows.Count == 0) { <section class="empty-state"><h2>@L["NoRecords"]</h2><p>@L["NoRecordsDescription"]</p></section> }
  else {
    <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@D["Code"]</th><th>@D["Title"]</th><th>@D["Classification"]</th><th>@D["Status"]</th><th>@D["Actions"]</th><th class="thumbnail-column">@D["Thumbnail"]</th></tr></thead><tbody>
      @foreach (JsonElement row in Rows)
      {
        Guid id = row.GetProperty("id").GetGuid();
        <tr><td dir="ltr">@Text(row,"code")</td><td>@Text(row,"title")</td><td>@CategoryText(row)</td><td>@LifecycleText(Text(row,"lifecycleStatus"),Text(row,"isArchived"))</td><td><BarangActionMenu><BarangIconButton Icon="eye" Label="@L["View"]" Semantic="info" Clicked="@(()=>Open(row,true))" /><BarangIconButton Icon="edit" Label="@L["Action_Edit"]" Semantic="edit" Clicked="@(()=>Open(row,false))" /><BarangIconButton Icon="power" Label="@(Text(row,"isArchived")=="True"?L["Activate"]:L["Deactivate"])" Semantic="warning" Clicked="@(()=>Toggle(row))" /></BarangActionMenu></td><td class="thumbnail-column"><DesignThumbnail @key="(ThumbGeneration, id)" DesignId="@id" Token="@Token" CompanyId="@Company" Clicked="@(()=>OpenViewer(id))" /></td></tr>
      }
    </tbody></table></div>
    <div class="form-actions"><button type="button" class="secondary-action" disabled="@(Page<=1)" @onclick="Previous">@L["Previous"]</button><span>@Page / @Math.Max(1,TotalPages) · @Total @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"ar"=>"سجل","en"=>"records",_=>"رکورد"})</span><button type="button" class="secondary-action" disabled="@(Page>=TotalPages)" @onclick="Next">@L["Next"]</button></div>
  }
</section>

<BarangModal Open="@Dialog" Title="@(Viewing?L["View"]:(EditingId is null?L["Action_Create"]:L["Action_Edit"]))" Description="@N["Nav_ArtworkBank"]" Size="extra-large" CssClass="design-editor-modal" ShowCloseButton="false" CloseRequested="Close">
  <ChildContent><div class="design-editor-single-page">
    <section class="form-section"><h3>@D["General"]</h3><div class="form-grid"><label><span>@D["Code"] *</span><input dir="ltr" @bind="Code" disabled="@(EditingId is not null||Viewing)" /></label><label><span>@D["Title"] *</span><input @bind="Title" disabled="@Viewing" /></label><label class="span-2"><span>@D["Description"]</span><textarea @bind="Description" disabled="@Viewing"></textarea></label></div></section>
    <section class="form-section"><h3>@D["Classification"]</h3><div class="form-grid"><label><span>@D["Category"] *</span><DesignCategoryPicker @bind-Value="Category" @bind-SelectedId="CategoryId" Disabled="@Viewing" Placeholder="@SelectPlaceholder" /></label><label><span>@RefLabel("subcategory")</span><ReferenceSelect Name="artwork-subcategory" TypeCode="artwork.subcategory" @bind-Value="SubcategoryIdText" IncludeInactive="true" Disabled="@Viewing" Placeholder="@SelectPlaceholder" /></label><label><span>@RefLabel("type")</span><ReferenceSelect Name="artwork-type" TypeCode="artwork.type" @bind-Value="TypeIdText" IncludeInactive="true" Disabled="@Viewing" Placeholder="@SelectPlaceholder" /></label><label><span>@RefLabel("style")</span><ReferenceSelect Name="artwork-style" TypeCode="artwork.style" @bind-Value="StyleIdText" IncludeInactive="true" Disabled="@Viewing" Placeholder="@SelectPlaceholder" /></label><label><span>@RefLabel("theme")</span><ReferenceSelect Name="artwork-theme" TypeCode="artwork.theme" @bind-Value="ThemeIdText" IncludeInactive="true" Disabled="@Viewing" Placeholder="@SelectPlaceholder" /></label><label><span>@RefLabel("audience")</span><ReferenceSelect Name="artwork-audience" TypeCode="artwork.audience" @bind-Value="AudienceIdText" IncludeInactive="true" Disabled="@Viewing" Placeholder="@SelectPlaceholder" /></label><label><span>@RefLabel("license")</span><ReferenceSelect Name="artwork-license" TypeCode="artwork.license" @bind-Value="LicenseIdText" IncludeInactive="true" Disabled="@Viewing" Placeholder="@SelectPlaceholder" /></label><label><span>@RefLabel("usage")</span><ReferenceSelect Name="artwork-usage" TypeCode="artwork.usage" @bind-Value="UsageIdText" IncludeInactive="true" Disabled="@Viewing" Placeholder="@SelectPlaceholder" /></label><label><span>@D["Status"]</span><select @bind="Lifecycle" disabled="@Viewing"><option value="Draft">@D["Draft"]</option><option value="Active">@D["Active"]</option><option value="Archived">@D["Archived"]</option></select></label><label><span>@TagLabel()</span><ReferenceMultiSelect TypeCode="artwork.tag" Values="@TagIds" ValuesChanged="SetTags" Disabled="@Viewing" Placeholder="@TagLabel()" /></label></div></section>
    <section class="form-section"><h3>@D["Files"]</h3>@if(Viewing){<p class="field-help">@UploadMessage</p>}else{<label><span>@D["Upload"]</span><InputFile OnChange="Upload" /></label>@if(EditingId is null){<p class="field-help">@CreateUploadHint</p>}<p class="field-help">@UploadMessage</p>}</section>
    <section class="form-section"><h3>@D["History"]</h3>@if(HistoryBusy){<BarangLoadingState Text="@L["Loading"]" />}else if(History.Count==0){<p class="field-help">@L["NoRecords"]</p>}else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@D["Event"]</th><th>@D["OccurredAt"]</th><th>@D["Actor"]</th><th>@D["Details"]</th></tr></thead><tbody>@foreach(JsonElement item in History){<tr><td>@HistoryText(Text(item,"action"))</td><td>@Dates.Format(item.GetProperty("occurredAtUtc").GetDateTimeOffset(),CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)</td><td>@Text(item,"actorUsername")</td><td>@D["DesignRecord"]</td></tr>}</tbody></table></div>}</section>
    @if (!string.IsNullOrWhiteSpace(EditorError)) { <div class="inline-error design-editor-error" role="alert" aria-live="assertive">@EditorError</div> }
  </div></ChildContent>
  <Footer><button type="button" class="btn btn-secondary" @onclick="Close">@L["Cancel"]</button>@if(!Viewing){<button type="button" class="btn btn-primary" disabled="@Saving" @onclick="Save">@(Saving?L["Saving"]:L["Save"])</button>}</Footer>
</BarangModal>
<BarangConfirmDialog Open="@CloseConfirmOpen" Title="@UnsavedTitle" Description="@UnsavedDescription" CancelText="@KeepEditingText" ConfirmText="@DiscardChangesText" Cancel="KeepEditing" Confirm="DiscardAndClose" />

<BarangModal Open="@ViewerOpen" Title="@D["Viewer"]" Size="extra-large" CssClass="design-viewer-modal" ShowCloseButton="false" CloseRequested="CloseViewer">
 <ChildContent><section class="design-viewer" role="document">@if(ViewerBusy){<BarangLoadingState Text="@L["Loading"]" />}else if(ViewerNotDisplayable){<p class="inline-error" role="alert">@D["NotDisplayable"]</p>}else if(ViewerSource is null){<p class="inline-error" role="alert">@D["ViewerFailed"]</p>}else{<img src="@ViewerSource" class="design-viewer-image" alt="@D["FullPreview"]" />}</section></ChildContent>
 <Footer><button type="button" class="btn btn-secondary" @onclick="CloseViewer">@L["Cancel"]</button></Footer>
</BarangModal>

<BarangModal Open="@ConceptOpen" Title="@D["ConceptSearch"]" Size="extra-large" CssClass="concept-search-modal" ShowCloseButton="false" CloseRequested="CloseConceptSearch">
 <ChildContent>
  <section class="concept-search-panel" role="search">
   <div class="concept-search-row"><input type="search" class="concept-query" value="@ConceptQuery" @oninput="ConceptQueryChanged" @onkeydown="ConceptKeyDown" placeholder="@D["ConceptQueryPlaceholder"]" aria-label="@D["ConceptSearch"]" /><button type="button" class="btn btn-primary" disabled="@ConceptBusy" @onclick="RunConceptSearch"><BarangIcon Name="search" /> @D["SearchGo"]</button></div>
   @if(ConceptBusy){<BarangLoadingState Text="@L["Loading"]" />}
   else if(!string.IsNullOrWhiteSpace(ConceptError)){<p class="inline-error" role="alert">@ConceptError</p>}
   else if(!ConceptRan){<p class="field-help">@D["ConceptSearchHint"]</p>}
   else if(ConceptMatches.Count==0){<p class="field-help">@D["NoMatches"]</p>}
   else{
    <div class="concept-results">
     @foreach(var m in ConceptMatches){
      <article class="concept-card" data-artwork-id="@m.Id">
       <div class="concept-thumb"><DesignThumbnail DesignId="@m.Id" Token="@Token" CompanyId="@Company" Clicked="@(()=>OpenViewer(m.Id))" /></div>
       <div class="concept-info"><strong class="concept-title">@m.Title</strong><div class="concept-code-row"><span class="concept-meta" dir="ltr">@m.Code</span><button type="button" class="copy-code-button" title="@D["CopyCode"]" aria-label="@D["CopyCode"]" @onclick="()=>CopyCode(m.Code)"><BarangIcon Name="copy" /></button>@if(CopiedCode==m.Code){<span class="copy-feedback" role="status">@D["CodeCopied"]</span>}</div><span class="concept-meta">@m.CategoryName</span>@if(m.Formats.Count>0){<span class="concept-formats">@string.Join(" · ",m.Formats)</span>}</div>
       <div class="match-bar @BandClass(m.Score)" role="img" aria-label="@MatchLabel(m.Score)"><div class="match-fill" style="width:@(Math.Clamp(m.Score,0,100))%"></div></div>
       <span class="match-score @BandClass(m.Score)">@MatchLabel(m.Score)</span>
      </article>
     }
    </div>
   }
  </section>
 </ChildContent>
 <Footer><button type="button" class="btn btn-secondary" @onclick="CloseConceptSearch">@L["Cancel"]</button></Footer>
</BarangModal>

@code {
    private string[] OriginalTagIds=[];
    private readonly List<JsonElement> Rows=[]; private readonly List<JsonElement> History=[]; private readonly Dictionary<string,string> CategoryCaptions=new(StringComparer.OrdinalIgnoreCase);
    private int Page=1,PageSize=20,ThumbGeneration; private long Total; private bool Busy,Dialog,Viewing,HistoryBusy,ViewerOpen,ViewerBusy,Saving,CloseConfirmOpen; private string Search="",Code="",Title="",Description="",Category="",Lifecycle="Draft",UploadMessage="",EditorError="",InitialFingerprint=""; private Guid? EditingId,ViewerId,CategoryId,SubcategoryId,TypeId,StyleId,ThemeId,AudienceId,LicenseId,UsageId; private string[] TagIds=[]; private string? ViewerSource; private long Version; private string? Token; private Guid Company; private string SubcategoryIdText { get=>SubcategoryId?.ToString()??""; set=>SubcategoryId=Guid.TryParse(value,out var x)?x:null; } private string TypeIdText { get=>TypeId?.ToString()??""; set=>TypeId=Guid.TryParse(value,out var x)?x:null; } private string StyleIdText { get=>StyleId?.ToString()??""; set=>StyleId=Guid.TryParse(value,out var x)?x:null; } private string ThemeIdText { get=>ThemeId?.ToString()??""; set=>ThemeId=Guid.TryParse(value,out var x)?x:null; } private string AudienceIdText { get=>AudienceId?.ToString()??""; set=>AudienceId=Guid.TryParse(value,out var x)?x:null; } private string LicenseIdText { get=>LicenseId?.ToString()??""; set=>LicenseId=Guid.TryParse(value,out var x)?x:null; } private string UsageIdText { get=>UsageId?.ToString()??""; set=>UsageId=Guid.TryParse(value,out var x)?x:null; } private long TotalPages=>Total==0?0:(long)Math.Ceiling(Total/(double)PageSize);
    protected override async Task OnInitializedAsync(){var u=(await AuthState.GetAuthenticationStateAsync()).User;Token=u.FindFirst(AuthClaimTypes.AccessToken)?.Value;Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out Company);await Load();}
 private async Task Load(){if(Token is null)return;Busy=true;try{var r=await Core.GetAsync($"api/v1/artworks?search={Uri.EscapeDataString(Search)}&pageNumber={Page}&pageSize={PageSize}",Token,Company,default);Rows.Clear();if(r.IsSuccess){if(r.Value.TryGetProperty("items",out var items))Rows.AddRange(items.EnumerateArray());else if(r.Value.ValueKind==JsonValueKind.Array)Rows.AddRange(r.Value.EnumerateArray());Total=r.Value.TryGetProperty("total",out var total)&&total.ValueKind==JsonValueKind.Number?total.GetInt64():Rows.Count;}else Total=0;var options=await Core.GetAsync($"api/v1/lookups/artwork.category/options?culture={CultureInfo.CurrentUICulture.TwoLetterISOLanguageName}&activeOnly=false",Token,Company,default);CategoryCaptions.Clear();if(options.IsSuccess)foreach(var option in options.Value.EnumerateArray())CategoryCaptions[option.GetProperty("code").GetString()??""]=option.GetProperty("displayName").GetString()??"";ThumbGeneration++;}finally{Busy=false;await InvokeAsync(StateHasChanged);}}
    private async Task SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";Page=1;await Load();} private Task Previous(){if(Page>1){Page--;return Load();}return Task.CompletedTask;} private Task Next(){if(Page<TotalPages){Page++;return Load();}return Task.CompletedTask;}
    private void New(){EditingId=null;Version=0;CategoryId=SubcategoryId=TypeId=StyleId=ThemeId=AudienceId=LicenseId=UsageId=null;TagIds=[];OriginalTagIds=[];Code=Title=Description=Category="";Lifecycle="Draft";Viewing=false;UploadMessage=EditorError="";PendingFile=null;History.Clear();Dialog=true;InitialFingerprint=Fingerprint();}
    private async Task Open(JsonElement row,bool view){EditingId=row.GetProperty("id").GetGuid();Version=row.TryGetProperty("version",out var v)?v.GetInt64():0;CategoryId=GuidValue(row,"categoryId");SubcategoryId=GuidValue(row,"subcategoryId");TypeId=GuidValue(row,"typeId");StyleId=GuidValue(row,"styleId");ThemeId=GuidValue(row,"themeId");AudienceId=GuidValue(row,"audienceId");LicenseId=GuidValue(row,"licenseId");UsageId=GuidValue(row,"usageId");Code=Text(row,"code");Title=Text(row,"title");Description=Text(row,"description");Category=Text(row,"categoryCode");Lifecycle=Text(row,"lifecycleStatus");TagIds=[];OriginalTagIds=[];Viewing=view;UploadMessage=EditorError="";Dialog=true;await LoadHistory();var tags=await Core.GetAsync($"api/v1/artworks/{EditingId}/tags",Token!,Company,default);if(tags.IsSuccess){TagIds=tags.Value.EnumerateArray().Select(x=>x.GetProperty("tagId").GetGuid().ToString()).ToArray();OriginalTagIds=TagIds.ToArray();}InitialFingerprint=Fingerprint();await InvokeAsync(StateHasChanged);}
    private async Task LoadHistory(){if(Token is null||EditingId is null)return;HistoryBusy=true;History.Clear();var r=await Core.GetAsync($"api/v1/artworks/{EditingId}/history?pageNumber=1&pageSize=100",Token,Company,default);if(r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array)History.AddRange(r.Value.EnumerateArray());HistoryBusy=false;await InvokeAsync(StateHasChanged);}
    private async Task Save(){if(Saving||Viewing)return;EditorError="";if(Token is null){EditorError=L["SessionExpired"];return;}if(string.IsNullOrWhiteSpace(Code)){EditorError=RequiredField("code");return;}if(string.IsNullOrWhiteSpace(Title)){EditorError=RequiredField("title");return;}if(CategoryId is null&&string.IsNullOrWhiteSpace(Category)){EditorError=RequiredField("category");return;}Saving=true;await InvokeAsync(StateHasChanged);try{var r=await Core.SendAsync(EditingId is null?HttpMethod.Post:HttpMethod.Put,$"api/v1/artworks{(EditingId is null?"":$"/{EditingId}")}",new{code=Code,title=Title,description=Description,categoryCode=Category,categoryId=CategoryId,subcategoryId=SubcategoryId,typeId=TypeId,styleId=StyleId,themeId=ThemeId,audienceId=AudienceId,licenseId=LicenseId,usageId=UsageId,designerUserId=(Guid?)null,lifecycleStatus=Lifecycle,version=Version},Token,Company,default);if(r.IsSuccess){if(EditingId is null)EditingId=r.Value.GetProperty("id").GetGuid();Version=r.Value.GetProperty("version").GetInt64();foreach(string tag in OriginalTagIds.Except(TagIds,StringComparer.OrdinalIgnoreCase).Where(x=>Guid.TryParse(x,out _)))await Core.SendAsync(HttpMethod.Delete,$"api/v1/artworks/{EditingId}/tags/{tag}",null,Token,Company,default);foreach(string tag in TagIds.Except(OriginalTagIds,StringComparer.OrdinalIgnoreCase).Where(x=>Guid.TryParse(x,out _)))await Core.SendAsync(HttpMethod.Post,$"api/v1/artworks/{EditingId}/tags/{tag}",null,Token,Company,default);if(!await AttachPendingFile()){EditorError=D["UploadFailed"];return;}await LoadHistory();InitialFingerprint=Fingerprint();UploadMessage=L["OperationSucceeded"];Dialog=false;await Load();}else{EditorError=r.ProblemCode switch{"artwork.duplicate_code" or "core.database.unique_conflict"=>DuplicateCodeMessage,"artwork.concurrency_conflict" or "core.database.concurrency_conflict"=>ConcurrencyMessage,_=>L["GenericError"]};}}catch(Exception ex){EditorError=L["GenericError"];Console.Error.WriteLine(ex);}finally{Saving=false;await InvokeAsync(StateHasChanged);}}
    private void SetTags(string[] values)=>TagIds=values;
    private static Guid? GuidValue(JsonElement row,string name)=>row.TryGetProperty(name,out var p)&&p.ValueKind==JsonValueKind.String&&Guid.TryParse(p.GetString(),out var id)?id:null; private string RefLabel(string key)=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "en"=>key switch {"subcategory"=>"Design subgroup","type"=>"Design type","style"=>"Design style","theme"=>"Design subject","audience"=>"Design audience","license"=>"License type",_=>"Usage type"}, "ar"=>key switch {"subcategory"=>"الفئة الفرعية للتصميم","type"=>"نوع التصميم","style"=>"نمط التصميم","theme"=>"موضوع التصميم","audience"=>"جمهور التصميم","license"=>"نوع الترخيص",_=>"نوع الاستخدام"}, _=>key switch {"subcategory"=>"زیرگروه طرح","type"=>"نوع طرح","style"=>"سبک طرح","theme"=>"موضوع طرح","audience"=>"مخاطب طرح","license"=>"نوع مجوز",_=>"نوع کاربرد"} }; private string TagLabel()=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"ar"=>"وسوم التصميم","en"=>"Design tags",_=>"برچسب‌های طرح"};
    private async Task Toggle(JsonElement row){if(Token is null)return;var id=row.GetProperty("id").GetGuid();long version=row.GetProperty("version").GetInt64();bool archived=Text(row,"isArchived")!="True";await Core.SendAsync(HttpMethod.Post,$"api/v1/artworks/{id}/archive",new{archived,version},Token,Company,default);await Load();}
    private async Task Upload(InputFileChangeEventArgs args){PendingFile=args.File;if(EditingId is null){UploadMessage=args.File is null?"":args.File.Name;return;}await AttachPendingFile();}
    private async Task<bool> AttachPendingFile(){if(PendingFile is null||EditingId is null||Token is null)return true;UploadMessage=D["UploadPending"];try{await using var stream=PendingFile.OpenReadStream(long.MaxValue);var uploaded=await Core.UploadAsync("api/v1/files/upload",PendingFile.Name,PendingFile.ContentType,stream,PendingFile.Size,Token,Company,default);if(!uploaded.IsSuccess){UploadMessage=D["UploadFailed"];return false;}var file=uploaded.Value;var created=await Core.SendAsync(HttpMethod.Post,$"api/v1/artworks/{EditingId}/versions",new{fileVersionId=file.GetProperty("fileVersionId").GetGuid(),notes=(string?)null},Token,Company,default);UploadMessage=created.IsSuccess?D["UploadComplete"]:D["UploadFailed"];if(!created.IsSuccess)return false;PendingFile=null;await Load();await LoadHistory();return true;}catch(Exception){UploadMessage=D["UploadFailed"];return false;}}
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? PendingFile;
    private string CreateUploadHint=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"en"=>"The selected file is attached automatically when you save.","ar"=>"يُرفق الملف المحدد تلقائياً عند الحفظ.",_=>"فایل انتخاب‌شده هم‌زمان با ذخیره به طرح پیوست می‌شود."};
    private bool ViewerNotDisplayable;
    private async Task OpenViewer(Guid id){if(Token is null)return;ViewerId=id;ViewerSource=null;ViewerNotDisplayable=false;ViewerBusy=true;ViewerOpen=true;await InvokeAsync(StateHasChanged);var result=await Core.GetAsync($"api/v1/artworks/{id}/original-url",Token,Company,default);if(result.IsSuccess){string? url=result.Value.GetProperty("url").GetString();string media=result.Value.TryGetProperty("mediaType",out var m)?m.GetString()??"":"";if(string.IsNullOrWhiteSpace(url)||!media.StartsWith("image/",StringComparison.OrdinalIgnoreCase))ViewerNotDisplayable=true;else ViewerSource=url;}else ViewerNotDisplayable=true;ViewerBusy=false;await InvokeAsync(StateHasChanged);}
    private bool ConceptOpen,ConceptBusy,ConceptRan; private string ConceptQuery="",ConceptError=""; private readonly List<ArtworkConceptMatch> ConceptMatches=[];
    private void OpenConceptSearch(){ConceptOpen=true;ConceptRan=false;ConceptMatches.Clear();ConceptError="";ConceptQuery="";}
    private void CloseConceptSearch(){ConceptOpen=false;ConceptMatches.Clear();ConceptError="";}
    private Task ConceptQueryChanged(ChangeEventArgs e){ConceptQuery=e.Value?.ToString()??"";return Task.CompletedTask;}
    private async Task ConceptKeyDown(KeyboardEventArgs e){if(e.Key=="Enter")await RunConceptSearch();}
    private async Task RunConceptSearch(){if(Token is null||ConceptBusy)return;ConceptBusy=true;ConceptError="";await InvokeAsync(StateHasChanged);try{var r=await Core.GetAsync($"api/v1/artworks/concept-search?q={Uri.EscapeDataString(ConceptQuery.Trim())}&limit=36",Token,Company,default);if(r.IsSuccess){ConceptMatches.Clear();if(r.Value.ValueKind==JsonValueKind.Array)foreach(var x in r.Value.EnumerateArray())ConceptMatches.Add(new ArtworkConceptMatch(x.GetProperty("id").GetGuid(),Text(x,"code"),Text(x,"title"),Text(x,"categoryName"),Text(x,"lifecycleStatus"),Text(x,"isArchived")=="True",x.TryGetProperty("formats",out var f)&&f.ValueKind==JsonValueKind.Array?f.EnumerateArray().Select(v=>v.GetString()??"").Where(v=>v.Length>0).ToList():[],x.TryGetProperty("score",out var sc)&&sc.TryGetInt32(out var n)?n:0));ConceptRan=true;}else ConceptError=D["ConceptSearchFailed"];}catch{ConceptError=D["ConceptSearchFailed"];}finally{ConceptBusy=false;await InvokeAsync(StateHasChanged);}}
    private string BandClass(int score)=>score<=30?"band-red":score<=70?"band-yellow":"band-green";
    private string MatchLabel(int score)=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"en"=>$"{score}% match","ar"=>$"{score}% تطابق",_=>$"مطابقت {score}٪"};
    private void CloseViewer(){ViewerOpen=false;ViewerSource=null;ViewerId=null;ViewerNotDisplayable=false;} private string? CopiedCode;
    private async Task CopyCode(string code){try{await JS.InvokeVoidAsync("navigator.clipboard.writeText",code);CopiedCode=code;await InvokeAsync(StateHasChanged);_=ExpireCopyFeedback(code);}catch(JSException){CopiedCode=null;await InvokeAsync(StateHasChanged);}}
