@page "/workspace/{ModuleCode}"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@if(ModuleCode=="foundation"){<nav class="action-grid"><a class="action-card" href="/admin/settings">@L["Admin_settings"]</a><a class="action-card" href="/admin/units">@L["Admin_units"]</a><a class="action-card" href="/admin/warehouses">@L["Admin_warehouses"]</a><a class="action-card" href="/admin/security/users">@L["Admin_users"]</a><a class="action-card" href="/admin/security/roles">@L["Admin_roles"]</a></nav>}
@if(ModuleCode=="master-data"){<nav class="action-grid"><a class="action-card" href="/master/lookups">@L["Lookups"]</a><a class="action-card" href="/manage/product">@L["Action_Product"]</a><a class="action-card" href="/master/suppliers">@L["Action_Supplier"]</a><a class="action-card" href="/master/equipment">@L["Action_Equipment"]</a></nav>}
@if(ModuleCode=="customers"){<nav class="action-grid"><a class="action-card" href="/manage/customers">@L["Module_customers"]</a></nav>}
@if(ModuleCode=="artwork-files"){<nav class="action-grid"><a class="action-card" href="/manage/artwork">@L["Action_Artwork"]</a><a class="action-card" href="/manage/artwork-files">@L["Module_artwork-files"]</a></nav>}
<PageTitle>@Title · BARANG</PageTitle><nav class="breadcrumbs"><a href="/">@L["Home"]</a><span>/</span><span>@Title</span></nav><div class="page-heading"><div><span class="eyebrow">@L["OperationalWorkspace"]</span><h1>@Title</h1><p>@L[$"Description_{ModuleCode}"]</p></div>@if(ModuleCode=="orders"){<a class="primary-link" href="/orders/new"><BarangIcon Name="plus" />@L["NewOrder"]</a>}</div><section class="toolbar"><label><span>@L["Search"]</span><input @bind="Search" placeholder="@L["SearchPlaceholder"]" /></label><button type="button" class="secondary-action" @onclick="LoadAsync"><BarangIcon Name="refresh" />@L["Refresh"]</button></section><section class="panel data-panel"><div class="panel-heading"><div><h2>@L["CurrentRecords"]</h2><p>@L["AuthoritativeCoreData"]</p></div></div>@if(Loading){<BarangLoadingState Text="@L["Loading"]" />}else if(Failure is not null){<BarangErrorState Title="@L[Failure]"><Actions><button type="button" class="secondary-action" @onclick="LoadAsync">@L["TryAgain"]</button></Actions></BarangErrorState>}else if(Rows.Count==0){<CrudEmptyState Title="@L["NoRecords"]" Description="@L["NoRecordsDescription"]" />}else{<div class="table-wrap"><table><thead><tr>@foreach(var c in Columns){<th>@Humanize(c)</th>}</tr></thead><tbody>@foreach(var row in FilteredRows){<tr>@foreach(var c in Columns){<td>@Cell(row,c)</td>}</tr>}</tbody></table></div>}</section><section class="action-grid">@foreach(string action in Actions){<article class="action-card"><BarangIcon Name="plus" /><div><strong>@L[$"Action_{action}"]</strong><p>@L["ActionUsesCore"]</p></div></article>}</section>
@code{[Parameter]public string ModuleCode{get;set;}="";private BackofficeModule?Module;private bool Loading=true;private string?Failure,Search;private List<Dictionary<string,string>>Rows=[];private IReadOnlyList<string>Columns=[];private string Title=>L[$"Module_{ModuleCode}"];private IEnumerable<Dictionary<string,string>>FilteredRows=>string.IsNullOrWhiteSpace(Search)?Rows:Rows.Where(x=>x.Values.Any(v=>v.Contains(Search,StringComparison.CurrentCultureIgnoreCase)));private string[]Actions=>ModuleCode switch{"foundation"=>["Create","Edit","Lifecycle"],"master-data"=>["Product","Variant","Supplier","Equipment"],"customers"=>["Create","Contact","Address"],"artwork-files"=>["Artwork","Upload","Version"],"orders"=>["Draft","Submit","Cancel"],"finance"=>["Payment","Approval","Invoice"],"inventory"=>["Reserve","Transfer","Adjust"],"purchasing"=>["Request","PurchaseOrder","Receipt"],"production"=>["Plan","Assign","Execute"],"quality"=>["Inspect","Defect","Reproduction"],"logistics"=>["Package","Shipment","Delivery"],"workflow"=>["Claim","Release","Complete"],_=>["Filter","Export"]};protected override async Task OnParametersSetAsync(){Module=ModuleCatalog.All.SingleOrDefault(x=>x.Code==ModuleCode);await LoadAsync();}private async Task LoadAsync(){if(Module is null){Failure="NotFound";Loading=false;return;}Loading=true;Failure=null;Rows=[];var u=(await AuthState.GetAuthenticationStateAsync()).User;if(!ModuleCatalog.IsVisible(Module,u)){Failure="Unauthorized";Loading=false;return;}if(!Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out Guid company)||u.FindFirst(AuthClaimTypes.AccessToken)?.Value is not string token){Failure="SessionExpired";Loading=false;return;}var r=await Core.GetAsync(Module.ReadPath,token,company,CancellationToken.None);if(!r.IsSuccess){Failure=r.Failure switch{ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Unavailable=>"ApiUnavailable",_=>"GenericError"};Loading=false;return;}Extract(r.Value,Rows);Columns=Rows.SelectMany(x=>x.Keys).Distinct().Where(x=>!x.Contains("id",StringComparison.OrdinalIgnoreCase)&&!x.Equals("version",StringComparison.OrdinalIgnoreCase)).Take(7).ToArray();Loading=false;}private static void Extract(System.Text.Json.JsonElement?value,List<Dictionary<string,string>>rows){if(value is null)return;var root=value.Value;if(root.ValueKind==System.Text.Json.JsonValueKind.Object&&root.TryGetProperty("items",out var items))root=items;if(root.ValueKind==System.Text.Json.JsonValueKind.Array){foreach(var item in root.EnumerateArray())if(item.ValueKind==System.Text.Json.JsonValueKind.Object)rows.Add(item.EnumerateObject().Where(p=>p.Value.ValueKind is not(System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array)).ToDictionary(p=>p.Name,p=>p.Value.ToString()));}else if(root.ValueKind==System.Text.Json.JsonValueKind.Object)rows.Add(root.EnumerateObject().Where(p=>p.Value.ValueKind is not(System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array)).ToDictionary(p=>p.Name,p=>p.Value.ToString()));}private static string Cell(Dictionary<string,string>r,string c)=>r.TryGetValue(c,out string?v)?v:"—";private static string Humanize(string v)=>System.Text.RegularExpressions.Regex.Replace(v,"([a-z])([A-Z])","$1 $2");}
