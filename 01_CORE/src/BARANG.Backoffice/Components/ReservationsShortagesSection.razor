@using System.Globalization
@using System.Text.Json
@using Microsoft.JSInterop
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<section class="crud-card reservation-shortage-section" data-reservation-shortage-grid data-section="@Mode">
    <header class="section-header">
        <div><h2>@(Mode == "reservations" ? T("رزرو موجودی", "حجوزات المخزون", "Inventory Reservations") : T("کمبود موجودی", "نواقص المخزون", "Stock Shortages"))</h2><p>@(Mode == "reservations" ? T("تعهدهای واقعی موجودی و چرخه مصرف آن‌ها", "التزامات المخزون ودورة استهلاكها", "Authoritative stock commitments and their consumption lifecycle") : T("کمبودهای محاسبه‌شده بر اساس تقاضا و موجودی قابل دسترس", "النواقص المحسوبة حسب الطلب والمخزون المتاح", "Derived shortages based on demand and available stock"))</p></div>
    </header>

    <div class="crud-toolbar">
        <label class="crud-search"><span>@T("جستجو", "بحث", "Search")</span><input value="@Search" @oninput="SearchChanged" placeholder="@T("جستجوی انبار، محصول یا SKU", "بحث عن المستودع أو المنتج أو SKU", "Search warehouse, product or SKU")" /></label>
        @if (Mode == "reservations")
        {
            <label class="compact-filter"><span>@T("وضعیت", "الحالة", "Status")</span><select value="@Status" @onchange="StatusChanged"><option value="">@T("همه وضعیت‌ها", "كل الحالات", "All statuses")</option><option value="Active">@T("فعال", "نشط", "Active")</option><option value="PartiallyReleased">@T("بخشی آزادشده", "محرر جزئيا", "Partially released")</option><option value="Released">@T("آزادشده", "محرر", "Released")</option><option value="Consumed">@T("مصرف‌شده", "مستهلك", "Consumed")</option><option value="Expired">@T("منقضی‌شده", "منتهي", "Expired")</option></select></label>
        }
        else
        {
            <label class="compact-filter"><span>@T("انبار", "المستودع", "Warehouse")</span><SearchableSelect Options="@WarehouseOptions" @bind-Value="WarehouseId" Placeholder="@T("همه انبارها", "كل المستودعات", "All warehouses")" /></label>
        }
        <button type="button" class="btn btn-secondary" disabled="@Loading" @onclick="Reset"><BarangIcon Name="reset" /> @T("بازنشانی", "إعادة ضبط", "Reset")</button>
    </div>

    @if (Message is not null) { <div class="@(Success ? "inline-success" : "inline-error")" role="status">@Message</div> }
    @if (Error is not null) { <div class="inline-error" role="alert">@Error</div> }
    @if (Loading) { <BarangLoadingState Text="@T("در حال بارگذاری…", "جار التحميل…", "Loading…")" /> }
    else if (Mode == "reservations")
    {
        if (Reservations.Count == 0) { <CrudEmptyState Title="@T("رزروی یافت نشد", "لم يتم العثور على حجوزات", "No reservations found")" /> }
        else
        {
            <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("مرجع", "المرجع", "Reference")</th><th>@T("انبار", "المستودع", "Warehouse")</th><th>@T("محصول", "المنتج", "Product")</th><th>SKU</th><th><BarangSortHeader Label="@T("مقدار باقی‌مانده", "الكمية المتبقية", "Remaining")" Active="@(Sort == "quantity")" Descending="Descending" Clicked='()=>ChangeSort("quantity")' /></th><th><BarangSortHeader Label="@T("وضعیت", "الحالة", "Status")" Active="@(Sort == "status")" Descending="Descending" Clicked='()=>ChangeSort("status")' /></th><th>@T("عملیات", "الإجراءات", "Actions")</th></tr></thead><tbody>@foreach (var row in Reservations) { <tr><td dir="ltr">@Reference(row.Id)</td><td><strong>@row.WarehouseName</strong><small class="muted">@row.WarehouseCode</small></td><td><strong>@row.ProductName</strong><small class="muted">@row.ProductCode</small></td><td dir="ltr">@row.Sku</td><td dir="ltr">@row.RemainingQuantity.ToString("N2", CultureInfo.CurrentCulture)</td><td><span class="status-badge">@StatusLabel(row.Status)</span></td><td><div class="row-actions"><BarangIconButton Icon="eye" Semantic="info" Label="@T("مشاهده", "عرض", "View")" Clicked="@(()=>OpenReservation(row))" />@if (row.Status is ReservationStatus.Active or ReservationStatus.PartiallyReleased && row.RemainingQuantity > 0) { <BarangIconButton Icon="unlock" Semantic="warning" Label="@T("آزادسازی", "تحرير", "Release")" Clicked="@(()=>AskRelease(row))" /><BarangIconButton Icon="check" Semantic="success" Label="@T("مصرف", "استهلاک", "Consume")" Clicked="@(()=>AskConsume(row))" /> }</div></td></tr> }</tbody></table></div>
        }
    }
    else
    {
        if (Shortages.Count == 0) { <CrudEmptyState Title="@T("کمبودی یافت نشد", "لم يتم العثور على نواقص", "No shortages found")" /> }
        else
        {
            <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("انبار", "المستودع", "Warehouse")</th><th>@T("محصول", "المنتج", "Product")</th><th>SKU</th><th>@T("مورد نیاز", "المطلوب", "Required")</th><th><BarangSortHeader Label="@T("قابل دسترس", "المتاح", "Available")" Active="@(Sort == "available")" Descending="Descending" Clicked='()=>ChangeSort("available")' /></th><th><BarangSortHeader Label="@T("مقدار کمبود", "كمية النقص", "Shortage")" Active="@(Sort == "shortage")" Descending="Descending" Clicked='()=>ChangeSort("shortage")' /></th><th>@T("عملیات", "الإجراءات", "Actions")</th></tr></thead><tbody>@foreach (var row in Shortages) { <tr><td><strong>@row.WarehouseName</strong><small class="muted">@row.WarehouseCode</small></td><td><strong>@row.ProductName</strong><small class="muted">@row.ProductCode</small></td><td dir="ltr">@row.Sku</td><td dir="ltr">@row.RequiredQuantity.ToString("N2", CultureInfo.CurrentCulture)</td><td dir="ltr">@row.AvailableQuantity.ToString("N2", CultureInfo.CurrentCulture)</td><td dir="ltr"><strong>@row.ShortageQuantity.ToString("N2", CultureInfo.CurrentCulture)</strong></td><td><div class="row-actions"><BarangIconButton Icon="eye" Semantic="info" Label="@T("مشاهده", "عرض", "View")" Clicked="@(()=>OpenShortage(row))" /></div></td></tr> }</tbody></table></div>
        }
    }
    @if (TotalCount > 0) { <BarangPagination Page="@Page" HasNext="@(Page * PageSize < TotalCount)" Disabled="@Loading" PageLabel="" PreviousText="@T("قبلی", "السابق", "Previous")" NextText="@T("بعدی", "التالي", "Next")" Previous="Previous" Next="Next" /> }
</section>

<BarangModal Open="@Dialog" Title="@DialogTitle" Size="large" CloseRequested="Close">
    <ChildContent>
        @if (SelectedReservation is not null) { <dl class="detail-list"><dt>@T("مرجع", "المرجع", "Reference")</dt><dd dir="ltr">@Reference(SelectedReservation.Id)</dd><dt>@T("انبار", "المستودع", "Warehouse")</dt><dd>@SelectedReservation.WarehouseName (@SelectedReservation.WarehouseCode)</dd><dt>@T("محصول", "المنتج", "Product")</dt><dd>@SelectedReservation.ProductName (@SelectedReservation.ProductCode)</dd><dt>SKU</dt><dd dir="ltr">@SelectedReservation.Sku</dd><dt>@T("درخواستی", "المطلوب", "Requested")</dt><dd dir="ltr">@SelectedReservation.RequestedQuantity.ToString("N2", CultureInfo.CurrentCulture)</dd><dt>@T("رزروشده", "المحجوز", "Reserved")</dt><dd dir="ltr">@SelectedReservation.ReservedQuantity.ToString("N2", CultureInfo.CurrentCulture)</dd><dt>@T("باقی‌مانده", "المتبقي", "Remaining")</dt><dd dir="ltr">@SelectedReservation.RemainingQuantity.ToString("N2", CultureInfo.CurrentCulture)</dd><dt>@T("وضعیت", "الحالة", "Status")</dt><dd>@StatusLabel(SelectedReservation.Status)</dd></dl> }
        @if (SelectedShortage is not null) { <dl class="detail-list"><dt>@T("انبار", "المستودع", "Warehouse")</dt><dd>@SelectedShortage.WarehouseName (@SelectedShortage.WarehouseCode)</dd><dt>@T("محصول", "المنتج", "Product")</dt><dd>@SelectedShortage.ProductName (@SelectedShortage.ProductCode)</dd><dt>SKU</dt><dd dir="ltr">@SelectedShortage.Sku</dd><dt>@T("مورد نیاز", "المطلوب", "Required")</dt><dd dir="ltr">@SelectedShortage.RequiredQuantity.ToString("N2", CultureInfo.CurrentCulture)</dd><dt>@T("قابل دسترس", "المتاح", "Available")</dt><dd dir="ltr">@SelectedShortage.AvailableQuantity.ToString("N2", CultureInfo.CurrentCulture)</dd><dt>@T("مقدار کمبود", "كمية النقص", "Shortage")</dt><dd dir="ltr">@SelectedShortage.ShortageQuantity.ToString("N2", CultureInfo.CurrentCulture)</dd></dl> }
    </ChildContent>
    <Footer><button type="button" class="btn btn-secondary" @onclick="Close">@T("بستن", "إغلاق", "Close")</button></Footer>
</BarangModal>

<BarangConfirmDialog Open="@ConfirmOpen" Title="@ConfirmTitle" Description="@ConfirmDescription" CancelText="@T("انصراف", "إلغاء", "Cancel")" ConfirmText="@T("تأیید", "تأكيد", "Confirm")" Busy="@Busy" Cancel="CancelConfirmation" Confirm="ConfirmAction" />

@code {
    [Parameter] public string? InitialMode { get; set; }
    private enum ReservationStatus { Active, PartiallyReleased, Released, Consumed, Expired }
    private sealed record ReservationRow(Guid Id, Guid OrderItemId, Guid WarehouseId, string WarehouseCode, string WarehouseName, Guid ProductVariantId, string ProductCode, string ProductName, string Sku, decimal RequestedQuantity, decimal ReservedQuantity, decimal RemainingQuantity, ReservationStatus Status, DateTimeOffset? ExpiresAtUtc, DateTimeOffset CreatedAtUtc, long Version);
    private sealed record ShortageRow(Guid Id, Guid OrderItemId, Guid WarehouseId, string WarehouseCode, string WarehouseName, Guid ProductVariantId, string ProductCode, string ProductName, string Sku, decimal RequiredQuantity, decimal AvailableQuantity, decimal ShortageQuantity, DateTimeOffset CreatedAtUtc, long Version);
    private string Mode = "reservations", Search = "", Status = "", WarehouseId = "", Sort = "quantity", ConfirmTitle = "", ConfirmDescription = ""; private string? Message; private bool Descending, Loading, Success, Dialog, ConfirmOpen, Busy; private string? Error; private int Page = 1, TotalCount; private const int PageSize = 20; private List<ReservationRow> Reservations = []; private List<ShortageRow> Shortages = []; private List<SearchableSelectOption> WarehouseOptions = []; private ReservationRow? SelectedReservation; private ShortageRow? SelectedShortage; private Func<Task>? ConfirmedAction; private CancellationTokenSource? SearchCancellation;
    private string Lang => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    private string T(string fa, string ar, string en) => Lang switch { "en" => en, "ar" => ar, _ => fa };
    private string DialogTitle => SelectedReservation is not null ? T("جزئیات رزرو", "تفاصيل الحجز", "Reservation details") : T("جزئیات کمبود", "تفاصيل النقص", "Shortage details");
    protected override async Task OnInitializedAsync() { Mode = InitialMode == "shortages" ? "shortages" : "reservations"; await LoadWarehouses(); await Load(); }
    protected override async Task OnParametersSetAsync()
    {
        var requested = InitialMode == "shortages" ? "shortages" : "reservations";
        if (requested == Mode) return;
        Mode = requested; Search = Status = WarehouseId = ""; Sort = Mode == "reservations" ? "quantity" : "shortage"; Descending = false; Page = 1; Message = null; Error = null; Dialog = false;
        await Load();
    }
    private async Task<(string Token, Guid Company)?> Session() { var u = await AuthState.GetAuthenticationStateAsync(); return Guid.TryParse(u.User.FindFirst(AuthClaimTypes.CompanyId)?.Value, out var company) && u.User.FindFirst(AuthClaimTypes.AccessToken)?.Value is string token ? (token, company) : null; }
    private async Task LoadWarehouses() { var s = await Session(); if (s is null) return; var r = await Core.GetAsync("api/v1/organization/warehouses?pageNumber=1&pageSize=100&sort=code", s.Value.Token, s.Value.Company, default); if (r.IsSuccess && r.Value.TryGetProperty("items", out var items)) WarehouseOptions = [new("", T("همه انبارها", "كل المستودعات", "All warehouses")), .. items.EnumerateArray().Select(x => new SearchableSelectOption(x.GetProperty("id").ToString(), $"{x.GetProperty("code")} - {x.GetProperty("name")}"))]; }
    private async Task Load() { Loading = true; Error = null; var s = await Session(); if (s is null) { Loading = false; return; } var statusQuery = string.IsNullOrWhiteSpace(Status) ? "" : "&status=" + Uri.EscapeDataString(Status); var warehouseQuery = Guid.TryParse(WarehouseId, out _) ? "&warehouseId=" + Uri.EscapeDataString(WarehouseId) : ""; var path = Mode == "reservations" ? $"api/v1/inventory/reservations?search={Uri.EscapeDataString(Search)}{statusQuery}&sort={Sort}&descending={Descending.ToString().ToLowerInvariant()}&pageNumber={Page}&pageSize={PageSize}" : $"api/v1/inventory/shortages/grid?search={Uri.EscapeDataString(Search)}&sort={Sort}&descending={Descending.ToString().ToLowerInvariant()}&pageNumber={Page}&pageSize={PageSize}{warehouseQuery}"; var r = await Core.GetAsync(path, s.Value.Token, s.Value.Company, default); Reservations = []; Shortages = []; TotalCount = 0; if (r.IsSuccess && r.Value.TryGetProperty("items", out var items)) { TotalCount = r.Value.TryGetProperty("totalCount", out var total) ? total.GetInt32() : 0; if (Mode == "reservations") Reservations = items.EnumerateArray().Select(ParseReservation).ToList(); else Shortages = items.EnumerateArray().Select(ParseShortage).ToList(); } else if (!r.IsSuccess) Error = T("دریافت اطلاعات انجام نشد.", "تعذر تحميل البيانات.", "Data could not be loaded."); Loading = false; }
    private static ReservationRow ParseReservation(JsonElement x) => new(x.GetProperty("id").GetGuid(), x.GetProperty("orderItemId").GetGuid(), x.GetProperty("warehouseId").GetGuid(), x.GetProperty("warehouseCode").ToString(), x.GetProperty("warehouseName").ToString(), x.GetProperty("productVariantId").GetGuid(), x.GetProperty("productCode").ToString(), x.GetProperty("productName").ToString(), x.GetProperty("sku").ToString(), x.GetProperty("requestedQuantity").GetDecimal(), x.GetProperty("reservedQuantity").GetDecimal(), x.GetProperty("remainingQuantity").GetDecimal(), Enum.Parse<ReservationStatus>(x.GetProperty("status").ToString()), x.GetProperty("expiresAtUtc").ValueKind == JsonValueKind.Null ? null : x.GetProperty("expiresAtUtc").GetDateTimeOffset(), x.GetProperty("createdAtUtc").GetDateTimeOffset(), x.GetProperty("version").GetInt64());
    private static ShortageRow ParseShortage(JsonElement x) => new(x.GetProperty("id").GetGuid(), x.GetProperty("orderItemId").GetGuid(), x.GetProperty("warehouseId").GetGuid(), x.GetProperty("warehouseCode").ToString(), x.GetProperty("warehouseName").ToString(), x.GetProperty("productVariantId").GetGuid(), x.GetProperty("productCode").ToString(), x.GetProperty("productName").ToString(), x.GetProperty("sku").ToString(), x.GetProperty("requiredQuantity").GetDecimal(), x.GetProperty("availableQuantity").GetDecimal(), x.GetProperty("shortageQuantity").GetDecimal(), x.GetProperty("createdAtUtc").GetDateTimeOffset(), x.GetProperty("version").GetInt64());
    private async Task SearchChanged(ChangeEventArgs e) { Search = e.Value?.ToString() ?? ""; Page = 1; SearchCancellation?.Cancel(); SearchCancellation?.Dispose(); SearchCancellation = new(); try { await Task.Delay(250, SearchCancellation.Token); await Load(); } catch (OperationCanceledException) { } }
    private Task StatusChanged(ChangeEventArgs e) { Status = e.Value?.ToString() ?? ""; Page = 1; return Load(); }
    private Task Reset() { Search = Status = WarehouseId = ""; Sort = Mode == "reservations" ? "quantity" : "shortage"; Descending = false; Page = 1; Message = ""; return Load(); }
    private Task ChangeSort(string sort) { if (Sort == sort) Descending = !Descending; else { Sort = sort; Descending = false; } Page = 1; return Load(); }
    private Task Previous() { if (Page > 1) { Page--; return Load(); } return Task.CompletedTask; }
    private Task Next() { if (Page * PageSize < TotalCount) { Page++; return Load(); } return Task.CompletedTask; }
    private void OpenReservation(ReservationRow row) { SelectedReservation = row; SelectedShortage = null; Dialog = true; }
    private void OpenShortage(ShortageRow row) { SelectedShortage = row; SelectedReservation = null; Dialog = true; }
    private void Close() => Dialog = false;
    private void AskRelease(ReservationRow row) { ConfirmTitle = T("آزادسازی رزرو", "تحرير الحجز", "Release reservation"); ConfirmDescription = T("مقدار باقی‌مانده آزاد شود؟", "هل تريد تحرير الكمية المتبقية؟", "Release the remaining reserved quantity?"); ConfirmedAction = () => Act(row, "release"); ConfirmOpen = true; }
    private void AskConsume(ReservationRow row) { ConfirmTitle = T("مصرف رزرو", "استهلاك الحجز", "Consume reservation"); ConfirmDescription = T("مقدار باقی‌مانده مصرف شود؟", "هل تريد استهلاك الكمية المتبقية؟", "Consume the remaining reserved quantity?"); ConfirmedAction = () => Act(row, "consume"); ConfirmOpen = true; }
    private async Task ConfirmAction() { ConfirmOpen = false; Busy = true; if (ConfirmedAction is not null) await ConfirmedAction(); ConfirmedAction = null; Busy = false; }
    private void CancelConfirmation() { ConfirmOpen = false; ConfirmedAction = null; }
    private async Task Act(ReservationRow row, string action) { var s = await Session(); if (s is null) return; ApiResult<JsonElement> r; if (action == "release") r = await Core.SendAsync(HttpMethod.Post, $"api/v1/inventory/reservations/{row.Id}/release", new { quantity = row.RemainingQuantity, version = row.Version }, s.Value.Token, s.Value.Company, default); else r = await Core.SendAsync(HttpMethod.Post, $"api/v1/inventory/reservations/{row.Id}/issue", new { quantity = row.RemainingQuantity, version = row.Version, reference = $"RES-{row.Id:N}" }, s.Value.Token, s.Value.Company, default); Success = r.IsSuccess; Message = r.IsSuccess ? T("عملیات رزرو انجام شد.", "تم تنفيذ عملية الحجز.", "Reservation operation completed.") : T("عملیات رزرو انجام نشد.", "تعذر تنفيذ عملية الحجز.", "Reservation operation failed."); if (r.IsSuccess) await Load(); }
    private string Reference(Guid id) => $"RES-{id.ToString("N")[..8].ToUpperInvariant()}";
    private string StatusLabel(ReservationStatus status) => status switch { ReservationStatus.Active => T("فعال", "نشط", "Active"), ReservationStatus.PartiallyReleased => T("بخشی آزادشده", "محرر جزئيا", "Partially released"), ReservationStatus.Released => T("آزادشده", "محرر", "Released"), ReservationStatus.Consumed => T("مصرف‌شده", "مستهلك", "Consumed"), _ => T("منقضی‌شده", "منتهي", "Expired") };
}
