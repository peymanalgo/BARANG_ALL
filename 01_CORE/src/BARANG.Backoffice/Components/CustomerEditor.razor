@using System.Globalization
@using System.Text.Json
@inject IStringLocalizer<CustomerStrings> C
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates

@if(Loading){<BarangLoadingState Text="@C["Loading"]" />}
else
{
 @if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@C[Message]</div>}
 <BarangTabs AriaLabel="@C["CustomerName"]" Class="customer-tabs">
  <button type="button" role="tab" aria-selected="@(Tab=="general")" class="@(Tab=="general"?"active":null)" @onclick='@(() => Tab = "general")'>@C["General"]</button>
  @if(Id is not null){<button type="button" role="tab" aria-selected="@(Tab=="addresses")" class="@(Tab=="addresses"?"active":null)" @onclick='@(() => Tab = "addresses")'>@C["Addresses"]</button>@if(Type=="LegalEntity"){<button type="button" role="tab" aria-selected="@(Tab=="contacts")" class="@(Tab=="contacts"?"active":null)" @onclick='@(() => Tab = "contacts")'>@C["Contacts"]</button>}@if(CanFinancialRead){<button type="button" role="tab" aria-selected="@(Tab=="financial")" class="@(Tab=="financial"?"active":null)" @onclick='@(() => Tab = "financial")'>@C["FinancialCommercial"]</button><button type="button" role="tab" aria-selected="@(Tab=="banks")" class="@(Tab=="banks"?"active":null)" @onclick='@(() => Tab = "banks")'>@C["BankAccounts"]</button>}}
 </BarangTabs>
 @if(Tab=="general"){@GeneralPanel}
 else if(Tab=="addresses"){<CustomerChildWorkspace CustomerId="Id!.Value" Kind="addresses" ReadOnly="@(!CanModify)" />}
 else if(Tab=="contacts"&&Type=="LegalEntity"){<CustomerChildWorkspace CustomerId="Id!.Value" Kind="contacts" ReadOnly="@(!CanModify)" />}
 else if(Tab=="financial"){@FinancialPanel}
 else if(Tab=="banks"){<CustomerChildWorkspace CustomerId="Id!.Value" Kind="bank-accounts" ReadOnly="@(!CanModifyFinancial)" />}
 <footer class="form-actions customer-editor-actions" data-customer-editor-actions="@Tab">
  <button type="button" class="btn btn-secondary" disabled="@Busy" @onclick="() => Closed.InvokeAsync()">@C["Cancel"]</button>
  @if(Tab=="general"&&CanModify){<button type="button" class="btn btn-primary" disabled="@Busy" @onclick="SaveGeneral">@C["Save"]</button>}
  else if(Tab=="financial"&&CanModifyFinancial){<button type="button" class="btn btn-primary" disabled="@Busy" @onclick="SaveFinancial">@C["Save"]</button>}
 </footer>
}

@code{
 [Parameter]public Guid?CustomerId{get;set;}[Parameter]public bool ReadOnly{get;set;}[Parameter]public EventCallback Closed{get;set;}[Parameter]public EventCallback Saved{get;set;}
 private Guid?Id;private string Tab="general",Type="Individual",Code="",DisplayName="",FirstName="",LastName="",NationalId="",FatherName="",Gender="",BirthCertificate="",PlaceOfIssue="",Occupation="",LegalName="",TradeName="",Registration="",Economic="",LegalEntityType="",BusinessActivity="",Website="",ManagingDirector="",Mobile="",Phone="",Email="",CustomerGroup="",PriceGroup="",SalesRepresentative="",Notes="",Status="Active";private DateOnly?BirthDate,EstablishmentDate;private long Version,ProfileVersion;private bool Loading,Busy,Success,CanCreate,CanEdit,CanStatus,CanFinancialRead,CanFinancialEdit;private bool CanModify=>!ReadOnly&&(Id is null?CanCreate:CanEdit);private bool CanModifyFinancial=>!ReadOnly&&CanFinancialEdit;private string?Message;private SessionInfo?Current;
 private List<SearchableSelectOption>SalesPeople=[];
 private decimal CreditLimit,UsedCredit,AvailableCredit,AccountBalance,Discount;private string PaymentTerm="",PaymentCondition="",PaymentMethod="",FinancialStatus="Normal",TaxStatus="",Currency="IRR";private long FinancialVersion;

 protected override async Task OnParametersSetAsync(){if(Id==CustomerId&&Current is not null)return;Id=CustomerId;await Initialize();}
 private async Task Initialize(){Loading=true;Current=await Session();if(Current is null){Loading=false;return;}var u=(await AuthState.GetAuthenticationStateAsync()).User;bool sys=u.HasClaim(AuthClaimTypes.SystemAdministrator,"true");CanCreate=sys||u.HasClaim(AuthClaimTypes.Permission,"customer.create");CanEdit=sys||u.HasClaim(AuthClaimTypes.Permission,"customer.edit");CanStatus=sys||u.HasClaim(AuthClaimTypes.Permission,"customer.status.manage");CanFinancialRead=sys||u.HasClaim(AuthClaimTypes.Permission,"customer.financial.read");CanFinancialEdit=sys||u.HasClaim(AuthClaimTypes.Permission,"customer.financial.manage");await LoadLookups();if(Id is Guid id)await LoadCustomer(id);Loading=false;}

 private RenderFragment GeneralPanel=>@<section class="customer-editor-panel"><fieldset class="customer-readonly-fieldset" disabled="@(!CanModify)"><div class="form-section"><h3>@C["CommonInformation"]</h3><div class="form-grid customer-form-grid"><label><span>@C["CustomerNumber"] *</span><input @bind="Code" disabled="@(Id is not null)" /></label><label><span>@C["CustomerType"] *</span><select @bind="Type" disabled="@(Id is not null)"><option value="Individual">@C["Individual"]</option><option value="LegalEntity">@C["LegalEntity"]</option></select>@if(Id is not null){<small>@C["TypeLocked"]</small>}</label><label><span>@C["CustomerName"]</span><input @bind="DisplayName" /></label><label><span>@C["Status"]</span><select name="customer-status" @bind="Status" disabled="@(Id is null||!CanStatus)"><option value="Active">@C["Active"]</option><option value="Inactive">@C["Inactive"]</option><option value="Blocked">@C["Blocked"]</option></select></label><label><span>@C["Mobile"] @(Type=="Individual"?"*":"")</span><input dir="ltr" @bind="Mobile" /></label><label><span>@C["Phone"]</span><input dir="ltr" @bind="Phone" /></label><label><span>@C["Email"]</span><input dir="ltr" type="email" @bind="Email" /></label><label><span>@C["EconomicCode"]</span><input dir="ltr" @bind="Economic" /></label><label><span>@C["CustomerGroup"]</span><ReferenceSelect TypeCode="customer.group" Name="customer.group" @bind-Value="CustomerGroup" Placeholder="@C["CustomerGroup"]" /></label><label><span>@C["PriceGroup"]</span><ReferenceSelect TypeCode="price.group" Name="price.group" @bind-Value="PriceGroup" Placeholder="@C["PriceGroup"]" /></label><label><span>@C["SalesRepresentative"]</span><SearchableSelect Options="SalesPeople" @bind-Value="SalesRepresentative" SearchChanged="SearchSalesPeople" Placeholder="@C["SalesRepresentative"]" /></label></div></div>
 @if(Type=="Individual"){<div class="form-section"><h3>@C["Individual"]</h3><div class="form-grid customer-form-grid"><label><span>@C["FirstName"] *</span><input @bind="FirstName" /></label><label><span>@C["LastName"] *</span><input @bind="LastName" /></label><label><span>@C["NationalId"]</span><input dir="ltr" @bind="NationalId" /></label><label><span>@C["FatherName"]</span><input @bind="FatherName" /></label><label><span>@C["BirthDate"]</span><LocaleDateInput @bind-Value="BirthDate" /></label><label><span>@C["Gender"]</span><select @bind="Gender"><option value="">@C["NotSpecified"]</option><option value="male">@C["Male"]</option><option value="female">@C["Female"]</option></select></label><label><span>@C["BirthCertificateNumber"]</span><input @bind="BirthCertificate" /></label><label><span>@C["PlaceOfIssue"]</span><input @bind="PlaceOfIssue" /></label><label><span>@C["Occupation"]</span><input @bind="Occupation" /></label></div></div>}
 else{<div class="form-section"><h3>@C["LegalEntity"]</h3><div class="form-grid customer-form-grid"><label><span>@C["LegalName"] *</span><input @bind="LegalName" /></label><label><span>@C["TradeName"]</span><input @bind="TradeName" /></label><label><span>@C["NationalId"]</span><input dir="ltr" @bind="NationalId" /></label><label><span>@C["RegistrationNumber"]</span><input dir="ltr" @bind="Registration" /></label><label><span>@C["EstablishmentDate"]</span><LocaleDateInput @bind-Value="EstablishmentDate" /></label><label><span>@C["LegalEntityType"]</span><ReferenceSelect TypeCode="legal.entity.type" Name="legal.entity.type" @bind-Value="LegalEntityType" Placeholder="@C["LegalEntityType"]" /></label><label class="span-2"><span>@C["BusinessActivity"]</span><input @bind="BusinessActivity" /></label><label><span>@C["Website"]</span><input dir="ltr" type="url" @bind="Website" /></label><label><span>@C["ManagingDirector"]</span><input @bind="ManagingDirector" /></label></div></div>}
 <div class="form-section"><div class="form-grid"><label class="customer-notes span-2"><span>@C["Notes"]</span><textarea name="customer-notes" rows="4" maxlength="2000" @bind="Notes"></textarea></label></div></div></fieldset></section>;

 private RenderFragment FinancialPanel=>@<section class="customer-editor-panel"><p class="read-only-note">@C["CalculatedPending"]</p><div class="financial-summary"><div><span>@C["UsedCredit"]</span><strong>@UsedCredit.ToString("N2")</strong></div><div><span>@C["AvailableCredit"]</span><strong>@AvailableCredit.ToString("N2")</strong></div><div><span>@C["AccountBalance"]</span><strong>@AccountBalance.ToString("N2")</strong></div></div><div class="form-grid customer-form-grid"><label><span>@C["CreditLimit"]</span><input type="number" min="0" step="0.01" @bind="CreditLimit" disabled="@(!CanModifyFinancial)" /></label><label><span>@C["DefaultDiscount"]</span><input type="number" min="0" max="100" step="0.01" @bind="Discount" disabled="@(!CanModifyFinancial)" /></label><label><span>@C["PaymentTerm"]</span><ReferenceSelect TypeCode="payment.term" Name="payment.term" @bind-Value="PaymentTerm" Disabled="@(!CanModifyFinancial)" /></label><label><span>@C["PaymentCondition"]</span><ReferenceSelect TypeCode="payment.condition" Name="payment.condition" @bind-Value="PaymentCondition" Disabled="@(!CanModifyFinancial)" /></label><label><span>@C["PaymentMethod"]</span><ReferenceSelect TypeCode="payment.method" Name="payment.method" @bind-Value="PaymentMethod" Disabled="@(!CanModifyFinancial)" /></label><label><span>@C["FinancialStatus"]</span><select @bind="FinancialStatus" disabled="@(!CanModifyFinancial)"><option value="Normal">@C["Normal"]</option><option value="Debtor">@C["Debtor"]</option><option value="Blocked">@C["Blocked"]</option></select></label><label><span>@C["TaxStatus"]</span><ReferenceSelect TypeCode="tax.status" Name="tax.status" @bind-Value="TaxStatus" Disabled="@(!CanModifyFinancial)" /></label><label><span>@C["Currency"]</span><input maxlength="3" dir="ltr" @bind="Currency" disabled="@(!CanModifyFinancial)" /></label></div></section>;

 private async Task LoadCustomer(Guid id){if(Current is null)return;ApiResult<JsonElement> r=await Core.GetAsync($"api/v1/customers/{id}",Current.Token,Current.Company,default);if(!r.IsSuccess){Show(r);return;}JsonElement x=r.Value;Code=Text(x,"customerCode");Type=Text(x,"customerType");DisplayName=Text(x,"displayName");Status=Text(x,"status");Mobile=Text(x,"primaryMobile");Phone=Text(x,"primaryPhone");Email=Text(x,"primaryEmail");Economic=Text(x,"economicCode");CustomerGroup=Text(x,"customerGroupId");PriceGroup=Text(x,"priceGroupId");SalesRepresentative=Text(x,"salesRepresentativePersonId");Notes=Text(x,"notes");Version=x.GetProperty("version").GetInt64();if(Type=="Individual"&&x.TryGetProperty("individualProfile",out JsonElement p)&&p.ValueKind==JsonValueKind.Object){FirstName=Text(p,"firstName");LastName=Text(p,"lastName");NationalId=Text(p,"nationalId");FatherName=Text(p,"fatherName");BirthDate=Date(p,"birthDate");Gender=Text(p,"genderCode");BirthCertificate=Text(p,"birthCertificateNumber");PlaceOfIssue=Text(p,"placeOfIssue");Occupation=Text(p,"occupation");ProfileVersion=p.GetProperty("version").GetInt64();}else if(x.TryGetProperty("legalProfile",out p)&&p.ValueKind==JsonValueKind.Object){LegalName=Text(p,"legalName");TradeName=Text(p,"tradeName");NationalId=Text(p,"nationalId");Registration=Text(p,"registrationNumber");EstablishmentDate=Date(p,"establishmentDate");LegalEntityType=Text(p,"legalEntityTypeId");BusinessActivity=Text(p,"businessActivity");Website=Text(p,"website");ManagingDirector=Text(p,"managingDirector");ProfileVersion=p.GetProperty("version").GetInt64();}if(CanFinancialRead)await LoadFinancial();}
 private async Task SaveGeneral(){if(Current is null)return;Busy=true;object body=new{customerCode=Code,customerType=Type,displayName=DisplayName,firstName=Type=="Individual"?FirstName:null,lastName=Type=="Individual"?LastName:null,legalName=Type=="LegalEntity"?LegalName:null,tradeName=Type=="LegalEntity"?TradeName:null,nationalId=NationalId,registrationNumber=Type=="LegalEntity"?Registration:null,economicCode=Economic,primaryMobile=Mobile,primaryPhone=Phone,primaryEmail=Email,fatherName=Type=="Individual"?FatherName:null,birthDate=Type=="Individual"?BirthDate:null,genderCode=Type=="Individual"?Gender:null,birthCertificateNumber=Type=="Individual"?BirthCertificate:null,placeOfIssue=Type=="Individual"?PlaceOfIssue:null,occupation=Type=="Individual"?Occupation:null,establishmentDate=Type=="LegalEntity"?EstablishmentDate:null,legalEntityTypeId=Type=="LegalEntity"?ReferenceId(LegalEntityType):null,businessActivity=Type=="LegalEntity"?BusinessActivity:null,website=Type=="LegalEntity"?Website:null,managingDirector=Type=="LegalEntity"?ManagingDirector:null,customerGroupId=ReferenceId(CustomerGroup),priceGroupId=ReferenceId(PriceGroup),salesRepresentativePersonId=Guid.TryParse(SalesRepresentative,out Guid sales)?sales:(Guid?)null,notes=Notes,status=Id is not null&&CanStatus?Status:null,version=Version,profileVersion=ProfileVersion};ApiResult<JsonElement> r=await Core.SendAsync(Id is null?HttpMethod.Post:HttpMethod.Put,"api/v1/customers"+(Id is Guid id?$"/{id}":""),body,Current.Token,Current.Company,default);Busy=false;Show(r);if(r.IsSuccess){Id=r.Value.GetProperty("id").GetGuid();Message=CustomerId is null?"Created":"Saved";await Saved.InvokeAsync();}}

 private async Task LoadFinancial(){if(Current is null||Id is not Guid id)return;var r=await Core.GetAsync($"api/v1/customers/{id}/financial",Current.Token,Current.Company,default);if(!r.IsSuccess)return;var x=r.Value;CreditLimit=Decimal(x,"creditLimit");UsedCredit=Decimal(x,"usedCredit");AvailableCredit=Decimal(x,"availableCredit");AccountBalance=Decimal(x,"accountBalance");PaymentTerm=Text(x,"paymentTermId");PaymentCondition=Text(x,"paymentConditionId");PaymentMethod=Text(x,"preferredPaymentMethodId");Discount=Decimal(x,"defaultDiscountPercent");FinancialStatus=Text(x,"financialStatus");TaxStatus=Text(x,"taxStatusId");Currency=Text(x,"defaultCurrencyCode");FinancialVersion=x.GetProperty("version").GetInt64();}
 private async Task SaveFinancial(){if(Current is null||Id is not Guid id)return;var body=new{creditLimit=CreditLimit,paymentTermId=ReferenceId(PaymentTerm),paymentConditionId=ReferenceId(PaymentCondition),preferredPaymentMethodId=ReferenceId(PaymentMethod),defaultDiscountPercent=Discount,financialStatus=FinancialStatus,taxStatusId=ReferenceId(TaxStatus),defaultCurrencyCode=Currency,version=FinancialVersion};var r=await Core.SendAsync(HttpMethod.Put,$"api/v1/customers/{id}/financial",body,Current.Token,Current.Company,default);Show(r);if(r.IsSuccess)await Saved.InvokeAsync();}
 private async Task LoadLookups()=>await SearchSalesPeople("");
 private async Task SearchSalesPeople(string query){if(Current is null)return;var r=await Core.GetAsync($"api/v1/customers/sales-representatives?search={Uri.EscapeDataString(query)}&limit=30",Current.Token,Current.Company,default);if(r.IsSuccess)SalesPeople=r.Value.EnumerateArray().Select(x=>new SearchableSelectOption(Text(x,"personId"),Text(x,"displayName")+" · "+Text(x,"personnelCode"))).ToList();}
 private static Guid? ReferenceId(string value)=>Guid.TryParse(value,out Guid id)?id:null;
 private void Show(ApiResult<JsonElement> r){Success=r.IsSuccess;Message=r.IsSuccess?"Saved":r.Failure switch{ApiFailure.Forbidden=>"Forbidden",ApiFailure.Conflict=>"Conflict",_=>"ValidationError"};}
 private async Task<SessionInfo?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out Guid c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string token?new(token,c):null;}private static string Text(JsonElement x,string n)=>x.TryGetProperty(n,out JsonElement p)&&p.ValueKind!=JsonValueKind.Null?p.ToString():"";private static bool Bool(JsonElement x,string n)=>x.TryGetProperty(n,out JsonElement p)&&p.ValueKind==JsonValueKind.True;private static decimal Decimal(JsonElement x,string n)=>x.TryGetProperty(n,out JsonElement p)&&p.TryGetDecimal(out decimal d)?d:0;private DateOnly?Date(JsonElement x,string n)=>x.TryGetProperty(n,out JsonElement p)&&p.ValueKind==JsonValueKind.String&&Dates.TryParseCanonical(p.GetString() ?? "",out DateOnly d)?d:null;
 private sealed record SessionInfo(string Token,Guid Company);
}
