@using System.Globalization
@using System.Text.Json
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject LocaleDateService Dates
@rendermode InteractiveServer

<section class="crud-card purchase-history-section" data-purchase-history-grid>
    <header class="section-header"><div><h2>@T("تاریخچه خرید","سجل المشتريات","Purchase History")</h2><p>@T("نمایش خواندنی و قابل ردیابی خریدهای واقعی","عرض للشراء الفعلي للقراءة والتتبع","Read-only trace of actual procurement activity")</p></div></header>
    <div class="crud-toolbar">
        <label class="crud-search"><span>@T("جستجو","بحث","Search")</span><input value="@Search" @oninput="SearchChanged" placeholder="@T("شماره سفارش، تأمین‌کننده، کالا یا انبار","رقم الأمر أو المورد أو المنتج أو المستودع","PO, supplier, product or warehouse")" /></label>
        <button type="button" class="btn btn-secondary" @onclick="Reset">@T("بازنشانی","إعادة ضبط","Reset")</button>
        <label class="compact-filter"><span>@T("تأمین‌کننده","المورد","Supplier")</span><SearchableSelect Name="purchase-history-supplier" Options="@Suppliers" Value="@Supplier" ValueChanged="@(v=>{Supplier=v;_ = Reload();})" Placeholder="@T("همه","الكل","All")" /></label>
        <label class="compact-filter"><span>@T("انبار","المستودع","Warehouse")</span><SearchableSelect Name="purchase-history-warehouse" Options="@Warehouses" Value="@Warehouse" ValueChanged="@(v=>{Warehouse=v;_ = Reload();})" Placeholder="@T("همه","الكل","All")" /></label>
        <label class="compact-filter"><span>@T("محصول","المنتج","Product")</span><SearchableSelect Name="purchase-history-product" Options="@Products" Value="@Product" ValueChanged="ProductChanged" Placeholder="@T("همه","الكل","All")" /></label>
        <label class="compact-filter"><span>SKU</span><SearchableSelect Name="purchase-history-sku" Options="@Variants" Value="@Variant" ValueChanged="@(v=>{Variant=v;_ = Reload();})" Placeholder="@T("همه","الكل","All")" /></label>
        <label class="compact-filter"><span>@T("وضعیت سفارش","حالة الأمر","PO status")</span><select value="@Status" @onchange="StatusChanged"><option value="">@T("همه","الكل","All")</option><option value="Draft">@T("پیش‌نویس","مسودة","Draft")</option><option value="Submitted">@T("ارسال‌شده","مرسل","Submitted")</option><option value="PartiallyReceived">@T("دریافت جزئی","مستلم جزئياً","Partially received")</option><option value="Received">@T("دریافت کامل","مستلم بالكامل","Received")</option><option value="Closed">@T("بسته‌شده","مغلق","Closed")</option><option value="Cancelled">@T("لغوشده","ملغى","Cancelled")</option></select></label>
        <label class="compact-filter"><span>@T("از تاریخ خرید","من تاريخ الشراء","Purchase from")</span><LocaleDateInput Name="purchase-history-from" Value="From" ValueChanged="@(v=>{From=v;_ = Reload();})" /></label>
        <label class="compact-filter"><span>@T("تا تاریخ خرید","إلى تاريخ الشراء","Purchase to")</span><LocaleDateInput Name="purchase-history-to" Value="To" ValueChanged="@(v=>{To=v;_ = Reload();})" /></label>
    </div>
    @if (Message is not null) { <div class="inline-error" role="alert">@Message</div> }
    @if (Loading) { <div class="crud-loading">@T("در حال بارگذاری","جار التحميل","Loading")</div> }
    else if (Rows.Count == 0) { <div class="crud-empty">@T("سابقه خریدی یافت نشد.","لم يتم العثور على سجل شراء.","No purchase history found.")</div> }
    else
    {
        <div class="data-grid-wrap"><table class="data-grid"><thead><tr>
            <th><BarangSortHeader Label="@T("شماره سفارش خرید","رقم أمر الشراء","Purchase order")" Active="@(Sort=="order")" Descending="Descending" Clicked='()=>SortBy("order")' /></th><th>@T("درخواست خرید","طلب الشراء","Purchase request")</th><th><BarangSortHeader Label="@T("تأمین‌کننده","المورد","Supplier")" Active="@(Sort=="supplier")" Descending="Descending" Clicked='()=>SortBy("supplier")' /></th><th>@T("محصول / SKU","المنتج / SKU","Product / SKU")</th><th>@T("انبار","المستودع","Warehouse")</th><th>@T("تاریخ سفارش","تاريخ الطلب","Order date")</th><th><BarangSortHeader Label="@T("سفارش‌شده","المطلوب","Ordered")" Active="@(Sort=="ordered")" Descending="Descending" Clicked='()=>SortBy("ordered")' /></th><th><BarangSortHeader Label="@T("دریافت‌شده","المستلم","Received")" Active="@(Sort=="received")" Descending="Descending" Clicked='()=>SortBy("received")' /></th><th>@T("باقی‌مانده","المتبقي","Remaining")</th><th>@T("قیمت خرید","سعر الشراء","Purchase cost")</th><th>@T("آخرین دریافت","آخر استلام","Last receipt")</th><th>@T("وضعیت","الحالة","Status")</th><th>@T("عملیات","الإجراءات","Actions")</th>
        </tr></thead><tbody>@foreach (var row in Rows)
        { <tr><td dir="ltr">@S(row,"purchaseOrderNumber")</td><td dir="ltr">@(S(row,"purchaseRequestNumber") is { Length: > 0 } request ? request : "—")</td><td>@S(row,"supplierName")<small class="muted">@S(row,"supplierCode")</small></td><td>@S(row,"productName")<small class="muted">@S(row,"productCode") · @S(row,"sku")</small></td><td>@S(row,"warehouseName")<small class="muted">@S(row,"warehouseCode")</small></td><td>@Date(row,"createdDate")</td><td dir="ltr">@N(row,"orderedQuantity") @S(row,"purchaseUnit")</td><td dir="ltr">@N(row,"receivedQuantity")</td><td dir="ltr">@N(row,"remainingQuantity")</td><td dir="ltr">@N(row,"unitPurchaseCost") @S(row,"currencyCode")</td><td>@Date(row,"lastReceiptDate")</td><td><span class="status-pill">@StatusText(S(row,"purchaseOrderStatus"))</span></td><td ><BarangActionMenu><BarangIconButton Icon="eye" Semantic="info" Label="@T("مشاهده","عرض","View")" Clicked="@(()=>Open(row))" /></BarangActionMenu></td></tr> }</tbody></table></div>
        <BarangPagination Page="@Page" HasNext="@(Rows.Count == PageSize)" Disabled="@Loading" PageLabel="" PreviousText="@T("قبلی","السابق","Previous")" NextText="@T("بعدی","التالي","Next")" Previous="Previous" Next="Next" />
    }
</section>
<BarangModal Open="@DetailOpen" Title="@T("جزئیات تاریخچه خرید","تفاصيل سجل المشتريات","Purchase history details")" Size="large" CloseRequested="@(()=>DetailOpen=false)"><ChildContent>
    @if (Detail.ValueKind != JsonValueKind.Undefined) { <dl class="detail-grid"><dt>@T("سفارش خرید","أمر الشراء","Purchase order")</dt><dd>@S(Detail,"purchaseOrderNumber")</dd><dt>@T("تأمین‌کننده","المورد","Supplier")</dt><dd>@S(Detail,"supplierName")</dd><dt>@T("محصول / SKU","المنتج / SKU","Product / SKU")</dt><dd>@S(Detail,"productName") · @S(Detail,"sku")</dd><dt>@T("انبار","المستودع","Warehouse")</dt><dd>@S(Detail,"warehouseName")</dd><dt>@T("مقدار سفارش","كمية الطلب","Ordered quantity")</dt><dd>@N(Detail,"orderedQuantity") @S(Detail,"purchaseUnit")</dd><dt>@T("مقدار دریافت","الكمية المستلمة","Received quantity")</dt><dd>@N(Detail,"receivedQuantity")</dd><dt>@T("قیمت تاریخی خرید","سعر الشراء التاريخي","Historical purchase cost")</dt><dd>@N(Detail,"unitPurchaseCost") @S(Detail,"currencyCode")</dd></dl><h3>@T("رسیدهای مرتبط","الإيصالات المرتبطة","Related receipts")</h3>@if(ReceiptRows.Count==0){<p>@T("رسید ثبت‌شده‌ای وجود ندارد.","لا توجد إيصالات مسجلة.","No posted receipts.")</p>}else{<table class="data-grid"><thead><tr><th>@T("شماره رسید","رقم الإيصال","Receipt")</th><th>@T("تاریخ","التاريخ","Date")</th><th>@T("مقدار","الكمية","Quantity")</th><th>@T("وضعیت","الحالة","Status")</th></tr></thead><tbody>@foreach(var receipt in ReceiptRows){<tr><td>@S(receipt,"receiptNumber")</td><td>@Date(receipt,"receiptDateUtc")</td><td dir="ltr">@N(receipt,"quantity")</td><td>@S(receipt,"status")</td></tr>}</tbody></table>} }
</ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="(()=>DetailOpen=false)">@T("بستن","إغلاق","Close")</button></Footer></BarangModal>

@code {
    private const int PageSize = 20; private string Search="", Supplier="", Warehouse="", Product="", Variant="", Status="", Sort="date"; private bool Descending=true, Loading, DetailOpen; private int Page=1; private DateOnly? From,To; private string? Message; private List<JsonElement> Rows=[]; private JsonElement Detail; private List<JsonElement> ReceiptRows=[]; private List<SearchableSelectOption> Suppliers=[],Warehouses=[],Products=[],Variants=[]; private CancellationTokenSource? SearchCancel; private string Lang=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    private string T(string fa,string ar,string en)=>Lang switch {"ar"=>ar,"en"=>en,_=>fa}; private string S(JsonElement x,string key)=>x.TryGetProperty(key,out var v)&&v.ValueKind!=JsonValueKind.Null?v.ToString():""; private string N(JsonElement x,string key)=>x.TryGetProperty(key,out var v)&&v.TryGetDecimal(out var n)?n.ToString("N2",CultureInfo.CurrentCulture):"0"; private string Date(JsonElement x,string key)=>DateTimeOffset.TryParse(S(x,key),out var d)?Dates.Format(DateOnly.FromDateTime(d.LocalDateTime),Lang):"—";
    private string StatusText(string s)=>s switch {"0" or "Draft"=>T("پیش‌نویس","مسودة","Draft"),"1" or "Submitted"=>T("ارسال‌شده","مرسل","Submitted"),"2" or "PartiallyReceived"=>T("دریافت جزئی","مستلم جزئياً","Partially received"),"3" or "Received"=>T("دریافت کامل","مستلم بالكامل","Received"),"4" or "Closed"=>T("بسته‌شده","مغلق","Closed"),"5" or "Cancelled"=>T("لغوشده","ملغى","Cancelled"),_=>s};
    protected override async Task OnInitializedAsync(){await LoadOptions();await Load();}
    private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string token?(token,c):null;}
    private async Task LoadOptions(){var s=await Session();if(s is null)return;var a=await Core.GetAsync("api/v1/suppliers/options?limit=100",s.Value.Token,s.Value.Company,default);if(a.IsSuccess)Suppliers=a.Value.EnumerateArray().Select(x=>new SearchableSelectOption(S(x,"id"),$"{S(x,"name")} - {S(x,"code")}" )).ToList();var w=await Core.GetAsync("api/v1/organization/warehouses?pageNumber=1&pageSize=100",s.Value.Token,s.Value.Company,default);if(w.IsSuccess){var items=w.Value.TryGetProperty("items",out var i)?i:w.Value;Warehouses=items.EnumerateArray().Select(x=>new SearchableSelectOption(S(x,"id"),$"{S(x,"code")} - {S(x,"name")}")).ToList();}var p=await Core.GetAsync("api/v1/products?pageSize=100&activeOnly=true",s.Value.Token,s.Value.Company,default);if(p.IsSuccess){var items=p.Value.TryGetProperty("items",out var i)?i:p.Value;Products=items.EnumerateArray().Select(x=>new SearchableSelectOption(S(x,"id"),$"{S(x,"productCode")} - {S(x,"name")}")).ToList();}}
    private async Task ProductChanged(string value){Product=value;Variant="";Variants=[];var s=await Session();if(s is not null&&Guid.TryParse(value,out var id)){var r=await Core.GetAsync($"api/v1/products/{id}/variants/options?limit=100",s.Value.Token,s.Value.Company,default);if(r.IsSuccess)Variants=r.Value.EnumerateArray().Select(x=>new SearchableSelectOption(S(x,"id"),S(x,"sku"))).ToList();}await Reload();}
    private async Task Load(){var s=await Session();if(s is null)return;Loading=true;Message=null;var url=$"api/v1/purchasing/history?search={Uri.EscapeDataString(Search)}&pageNumber={Page}&pageSize={PageSize}&descending={Descending}&sort={Sort}";if(Guid.TryParse(Supplier,out var supplier))url+=$"&supplierId={supplier}";if(Guid.TryParse(Warehouse,out var warehouse))url+=$"&warehouseId={warehouse}";if(Guid.TryParse(Product,out var product))url+=$"&productId={product}";if(Guid.TryParse(Variant,out var variant))url+=$"&productVariantId={variant}";if(!string.IsNullOrWhiteSpace(Status))url+=$"&status={Status}";if(From is not null)url+=$"&from={From:yyyy-MM-dd}";if(To is not null)url+=$"&to={To:yyyy-MM-dd}";var r=await Core.GetAsync(url,s.Value.Token,s.Value.Company,default);Rows=[];if(r.IsSuccess&&r.Value.TryGetProperty("items",out var items))Rows=items.EnumerateArray().ToList();else if(!r.IsSuccess)Message=T("دریافت تاریخچه خرید انجام نشد.","تعذر تحميل سجل المشتريات.","Purchase history could not be loaded.");Loading=false;}
    private async Task SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";Page=1;SearchCancel?.Cancel();SearchCancel=new();try{await Task.Delay(250,SearchCancel.Token);await Load();}catch(OperationCanceledException){}}
    private Task Reload(){Page=1;return Load();} private Task Reset(){Search=Supplier=Warehouse=Product=Variant=Status="";Variants=[];From=To=null;Sort="date";Descending=true;Page=1;return Load();} private Task StatusChanged(ChangeEventArgs e){Status=e.Value?.ToString()??"";return Reload();} private Task SortBy(string sort){if(Sort==sort)Descending=!Descending;else{Sort=sort;Descending=false;}return Reload();} private Task Previous(){if(Page>1){Page--;return Load();}return Task.CompletedTask;} private Task Next(){if(Rows.Count==PageSize){Page++;return Load();}return Task.CompletedTask;}
    private async Task Open(JsonElement row){var s=await Session();if(s is null)return;var id=S(row,"id");var r=await Core.GetAsync($"api/v1/purchasing/history/{id}",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Message=T("جزئیات تاریخچه در دسترس نیست.","تفاصيل السجل غير متاحة.","History details are unavailable.");return;}Detail=r.Value.GetProperty("item");ReceiptRows=r.Value.TryGetProperty("receipts",out var receipts)?receipts.EnumerateArray().ToList():[];DetailOpen=true;}
}
