<button type="button"
        class="barang-sort-header @(Active ? "active" : null)"
        title="@Label"
        aria-label="@Label"
        aria-pressed="@Active.ToString().ToLowerInvariant()"
        @onclick="Clicked">
    <span>@Label</span>
    <BarangIcon Name="@(Active ? Descending ? "arrow-down" : "arrow-up" : "sort")" Class="barang-sort-indicator" />
</button>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Descending { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> Clicked { get; set; }
}
