<div class="state-box error-state barang-error-state" role="alert"><BarangIcon Name="circle" /><strong>@Title</strong>@if (!string.IsNullOrWhiteSpace(Description)) { <p>@Description</p> }@if (Actions is not null) { @Actions }</div>
@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
