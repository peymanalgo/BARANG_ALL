@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates
@inject IStringLocalizer<SupplierStrings> S
@inject IStringLocalizer<CrudStrings> C
@inject IJSRuntime JS

<section class="customer-editor-panel customer-child-grid" data-supplier-lifecycle="@Kind">
    <div class="child-header"><h3>@S[TitleKey]</h3>@if(CanEdit&&Kind!="quality"){<button type="button" class="btn btn-primary btn-small" @onclick="async()=>await New()" disabled="@Busy"><BarangIcon Name="plus" /> @C["Add"]</button>}</div>
    @if(Message is not null){<p class="@(Success?"inline-success":"inline-error")" role="@(Success?"status":"alert")">@S[Message]</p>}
    @if(Kind=="quality"){
        <section class="form-section"><div class="form-grid"><label><span>@S["ApprovalStatus"]</span><select value="@Approval" disabled="@(!CanEdit||Busy)" @onchange="ApprovalChanged"><option>Pending</option><option>Approved</option><option>NotApproved</option><option>Blocked</option></select></label><label><span>@S["QcLevel"]</span><SearchableSelect Name="qcLevel" Options="@QcOptions" Value="@QcLevel" ValueChanged="SetQcLevel" Placeholder="@S["QcLevel"]" Disabled="@(!CanEdit||Busy)" /></label><label><span>@S["HoldReason"]</span><input value="@HoldReason" @oninput="e=>HoldReason=e.Value?.ToString()??string.Empty" disabled="@(!CanEdit||Busy)" /></label><label><span>@S["QualityScore"]</span><input value="@QualityScore" disabled /></label></div><label><span>@S["Notes"]</span><textarea value="@HoldNotes" @oninput="e=>HoldNotes=e.Value?.ToString()??string.Empty" disabled="@(!CanEdit||Busy)"></textarea></label><div class="row-actions"><button type="button" class="btn btn-primary" @onclick="SaveProfile" disabled="@(!CanEdit||Busy)">@S["Save"]</button><button type="button" class="btn btn-secondary" @onclick="ToggleHold" disabled="@(!CanEdit||Busy)">@S[Held?"Release":"Hold"]</button></div></section>
    }
    else if(Loading){<BarangLoadingState Text="@S["Loading"]" />}
    else if(Rows.Count==0){<CrudEmptyState Title="@S["NoRows"]" Description="" />}
    else if(Kind=="evaluation"){
        <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@S["EvaluationDate"]</th><th>@S["EvaluationPeriod"]</th><th>@S["OverallScore"]</th><th>@S["EvaluationResult"]</th><th>@S["Notes"]</th><th>@S["Actions"]</th></tr></thead><tbody>@foreach(var x in Rows){var e=x.GetProperty("evaluation");<tr><td>@Date(e,"evaluationDate")</td><td>@Date(e,"periodStart") - @Date(e,"periodEnd")</td><td>@Text(e,"overallScore")</td><td>@Text(e,"resultStatus")</td><td>@Text(e,"notes")</td><td><BarangActionMenu><BarangIconButton Icon="eye" Label="@S["View"]" Semantic="info" Clicked="()=>ShowEvaluation(x)" />@if(CanEdit){<BarangIconButton Icon="edit" Label="@S["Edit"]" Semantic="edit" Clicked="()=>ShowEvaluation(x,false)" />}</BarangActionMenu></td></tr>}</tbody></table></div>
    } else if(Kind=="quality-incidents"){
        <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@S["IncidentType"]</th><th>@S["IncidentDate"]</th><th>@S["Quantity"]</th><th>@S["Status"]</th><th>@S["Actions"]</th></tr></thead><tbody>@foreach(var x in Rows){<tr><td>@Text(x,"incidentType")</td><td>@Date(x,"incidentDate")</td><td>@Text(x,"quantity")</td><td>@Text(x,"status")</td><td><BarangActionMenu><BarangIconButton Icon="eye" Label="@S["View"]" Semantic="info" Clicked="()=>Show(x,true)" />@if(CanEdit&&Text(x,"status")!="Resolved"){<BarangIconButton Icon="edit" Label="@S["Edit"]" Semantic="edit" Clicked="()=>Show(x,false)" /><BarangIconButton Icon="check" Label="@S["Resolve"]" Semantic="success" Clicked="()=>Resolve(x)" />}</BarangActionMenu></td></tr>}</tbody></table></div>
    } else if(Kind=="contracts"){
        <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@S["ContractNumber"]</th><th>@S["StartDate"]</th><th>@S["EndDate"]</th><th>@S["Status"]</th><th>@S["Expiry"]</th><th>@S["Actions"]</th></tr></thead><tbody>@foreach(var x in Rows){var c=x.GetProperty("contract");<tr><td>@Text(c,"contractNumber")</td><td>@Date(c,"startDate")</td><td>@Date(c,"endDate")</td><td>@Text(c,"status")</td><td>@S[x.GetProperty("isExpired").GetBoolean()?"Expired":x.GetProperty("isExpiringSoon").GetBoolean()?"ExpiringSoon":"Active"]</td><td><BarangActionMenu><BarangIconButton Icon="eye" Label="@S["View"]" Semantic="info" Clicked="()=>Show(c,true)" />@if(!string.IsNullOrWhiteSpace(Text(c,"fileId"))){<BarangIconButton Icon="download" Label="@S["Download"]" Semantic="info" Clicked="()=>DownloadFile(c)" />}@if(CanEdit){<BarangIconButton Icon="edit" Label="@S["Edit"]" Semantic="edit" Clicked="()=>Show(c,false)" /><BarangIconButton Icon="trash" Label="@S["Delete"]" Semantic="danger" Clicked="()=>Delete(c)" />}</BarangActionMenu></td></tr>}</tbody></table></div>
    } else {
        <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@S["DocumentType"]</th><th>@S["DocumentNumber"]</th><th>@S["IssueDate"]</th><th>@S["ExpiryDate"]</th><th>@S["Expiry"]</th><th>@S["Actions"]</th></tr></thead><tbody>@foreach(var x in Rows){var d=x.GetProperty("document");<tr><td>@S["ConfiguredReference"]</td><td>@Text(d,"documentNumber")</td><td>@Date(d,"issueDate")</td><td>@Date(d,"expiryDate")</td><td>@S[x.GetProperty("isExpired").GetBoolean()?"Expired":x.GetProperty("isExpiringSoon").GetBoolean()?"ExpiringSoon":"Active"]</td><td><BarangActionMenu><BarangIconButton Icon="eye" Label="@S["View"]" Semantic="info" Clicked="()=>Show(d,true)" />@if(!string.IsNullOrWhiteSpace(Text(d,"fileId"))){<BarangIconButton Icon="download" Label="@S["Download"]" Semantic="info" Clicked="()=>DownloadFile(d)" />}@if(CanEdit){<BarangIconButton Icon="edit" Label="@S["Edit"]" Semantic="edit" Clicked="()=>Show(d,false)" /><BarangIconButton Icon="trash" Label="@S["Delete"]" Semantic="danger" Clicked="()=>DeleteDocument(d)" />}</BarangActionMenu></td></tr>}</tbody></table></div>
    }
</section>
<BarangModal Open="@Dialog" Title="@S[EditorTitle]" Size="xl" ReserveSelectorSpace="true" ShowCloseButton="false" Busy="@Busy" CloseRequested="Close">
<ChildContent><fieldset disabled="@DialogReadOnly">
@if(Kind=="evaluation"){
 <div class="form-grid"><label><span>@S["EvaluationDate"]</span><LocaleDateInput Name="evaluationDate" Value="@Canonical("evaluationDate")" ValueChanged='v=>SetDate("evaluationDate",v)' Disabled="@Busy" /></label><label><span>@S["OverallScore"]</span><input value="@CalculatedScore" readonly /></label></div><div class="form-section"><h4>@S["EvaluationCriteria"]</h4>@if(Criteria.Count==0){<p class="field-help">@S["NoCriteria"]</p>}@foreach(var criterion in Criteria){<div class="form-grid"><label><span>@criterion.Name</span><input type="number" min="0" max="100" value="@criterion.Score" @oninput='e=>criterion.Score=e.Value?.ToString()??string.Empty' disabled="@Busy" /></label><label><span>@S["Notes"]</span><input value="@criterion.Comment" @oninput='e=>criterion.Comment=e.Value?.ToString()??string.Empty' disabled="@Busy" /></label></div>}</div><label><span>@S["Notes"]</span><textarea value="@Data["notes"]" @oninput='e=>Set("notes",e.Value)'></textarea></label>
} else if(Kind=="quality-incidents"){
 <div class="form-grid"><label><span>@S["IncidentType"]</span><input value="@Data["incidentType"]" @oninput='e=>Set("incidentType",e.Value)' /></label><label><span>@S["IncidentDate"]</span><LocaleDateInput Name="incidentDate" Value="@Canonical("incidentDate")" ValueChanged='v=>SetDate("incidentDate",v)' Disabled="@Busy" /></label><label><span>@S["Quantity"]</span><input type="number" value="@Data["quantity"]" @oninput='e=>Set("quantity",e.Value)' /></label></div><label><span>@S["Notes"]</span><textarea value="@Data["description"]" @oninput='e=>Set("description",e.Value)'></textarea></label>
} else if(Kind=="contracts"){
 <div class="form-grid"><label><span>@S["ContractNumber"]</span><input value="@Data["contractNumber"]" @oninput='e=>Set("contractNumber",e.Value)' /></label><label><span>@S["ContractType"]</span><SearchableSelect Name="contractType" Options="@ContractOptions" Value="@Data["contractTypeId"]" ValueChanged='v=>Set("contractTypeId",v)' Placeholder="@S["ContractType"]" /></label><label><span>@S["StartDate"]</span><LocaleDateInput Name="startDate" Value="@Canonical("startDate")" ValueChanged='v=>SetDate("startDate",v)' /></label><label><span>@S["EndDate"]</span><LocaleDateInput Name="endDate" Value="@Canonical("endDate")" ValueChanged='v=>SetDate("endDate",v)' /></label><label><span>@S["Status"]</span><input value="@Data["status"]" @oninput='e=>Set("status",e.Value)' /></label><label><span>@S["CurrencyCode"]</span><input maxlength="3" value="@Data["currencyCode"]" @oninput='e=>Set("currencyCode",e.Value)' /></label></div><label><span>@S["Notes"]</span><textarea value="@Data["description"]" @oninput='e=>Set("description",e.Value)'></textarea></label><label><span>@S["Attachment"]</span><InputFile OnChange="SelectFile" accept="application/pdf,image/*,.doc,.docx" /></label>
} else {
 <div class="form-grid"><label><span>@S["DocumentType"]</span><SearchableSelect Name="documentType" Options="@DocumentOptions" Value="@Data["documentTypeId"]" ValueChanged='v=>Set("documentTypeId",v)' Placeholder="@S["DocumentType"]" /></label><label><span>@S["DocumentNumber"]</span><input value="@Data["documentNumber"]" @oninput='e=>Set("documentNumber",e.Value)' /></label><label><span>@S["IssueDate"]</span><LocaleDateInput Name="issueDate" Value="@Canonical("issueDate")" ValueChanged='v=>SetDate("issueDate",v)' /></label><label><span>@S["ExpiryDate"]</span><LocaleDateInput Name="expiryDate" Value="@Canonical("expiryDate")" ValueChanged='v=>SetDate("expiryDate",v)' /></label></div><label><span>@S["Notes"]</span><textarea value="@Data["description"]" @oninput='e=>Set("description",e.Value)'></textarea></label><label><span>@S["Attachment"]</span><InputFile OnChange="SelectFile" accept="application/pdf,image/*,.doc,.docx" /></label>
}
</fieldset></ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="Close">@S["Cancel"]</button><button type="button" class="btn btn-primary" @onclick="Save" disabled="@Busy">@S["Save"]</button></Footer></BarangModal>

@code {
 [Parameter] public Guid SupplierId { get; set; }
 [Parameter] public string Kind { get; set; } = "evaluation";
 [Parameter] public bool ReadOnly { get; set; }
 private bool Loading=true,Busy,Dialog,DialogReadOnly,Success,Held; private string? Token,Message,Approval="Pending",HoldReason="",HoldNotes="",QcLevel="",QualityScore=""; private long Version; private Guid? EditingId; private List<JsonElement> Rows=[]; private Dictionary<string,string> Data=[]; private List<SearchableSelectOption> QcOptions=[],ContractOptions=[],DocumentOptions=[],CriterionOptions=[]; private List<CriterionEditor> Criteria=[]; private IBrowserFile? SelectedFile;
 private bool CanEdit; private Guid CurrentCompany; private string EffectiveKind=>Kind=="quality"?"quality-incidents":Kind; private string TitleKey=>Kind switch{"evaluation"=>"Evaluation","quality" or "quality-incidents"=>"Quality","contracts"=>"Contracts",_=>"Documents"}; private string EditorTitle=>Kind switch{"evaluation"=>"AddEvaluation", "quality" or "quality-incidents"=>"AddIncident", "contracts"=>"Contract", _=>"Document"};
 protected override async Task OnParametersSetAsync(){Busy=false;var u=(await AuthState.GetAuthenticationStateAsync()).User;Token=u.FindFirst(AuthClaimTypes.AccessToken)?.Value;CanEdit=Token is not null&&u.HasClaim(AuthClaimTypes.Permission,"supplier.manage");Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out CurrentCompany);if(Token is null||CurrentCompany==Guid.Empty)return;await LoadRefs();await Load();}
 private async Task LoadRefs(){var company=Company();foreach(var pair in new[]{("supplier.qc.level",(Action<List<SearchableSelectOption>>)(x=>QcOptions=x)),("supplier.contract.type",x=>ContractOptions=x),("supplier.document.type",x=>DocumentOptions=x),("supplier.evaluation.criterion",x=>CriterionOptions=x)}){var r=await Core.GetAsync($"api/v1/lookups/{pair.Item1}/options?culture={CultureInfo.CurrentUICulture.TwoLetterISOLanguageName}&activeOnly=false",Token!,company,default);if(r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array)pair.Item2(r.Value.EnumerateArray().Select(x=>new SearchableSelectOption(Text(x,"id"),Text(x,"displayName"))).ToList());}}
 private async Task Load(){Loading=true;var r=await Core.GetAsync($"api/v1/suppliers/{SupplierId}/lifecycle/{(Kind switch { "quality" or "quality-incidents" => "quality-incidents", "evaluation" => "evaluations", "contracts" => "contracts", "documents" => "documents", _ => Kind })}",Token!,Company(),default);if(r.IsSuccess){if(Kind=="quality"){Rows=r.Value.EnumerateArray().ToList();var p=await Core.GetAsync($"api/v1/suppliers/{SupplierId}/lifecycle/profile",Token!,Company(),default);if(p.IsSuccess){var x=p.Value;Approval=Text(x,"approvalStatus");QcLevel=Text(x,"qcLevelId");QualityScore=Text(x,"qualityScore");Held=Text(x,"holdReason").Length>0;Version=x.GetProperty("version").GetInt64();}}else Rows=r.Value.EnumerateArray().ToList();}else{Rows=[];Message="LoadError";}Loading=false;}
 private Guid Company()=>CurrentCompany;
 private async Task New(){EditingId=null;DialogReadOnly=false;if(Kind=="evaluation"&&CriterionOptions.Count==0)await LoadRefs();Data=Kind switch{"evaluation"=>new(){{"evaluationDate",Dates.Canonical(DateOnly.FromDateTime(DateTime.UtcNow))},{"resultStatus","Pending"},{"overallScore",""},{"notes",""}},"quality" or "quality-incidents"=>new(){{"incidentType","Reject"},{"incidentDate",Dates.Canonical(DateOnly.FromDateTime(DateTime.UtcNow))},{"quantity",""},{"description",""}},"contracts"=>new(){{"contractNumber",""},{"contractTypeId",""},{"startDate",Dates.Canonical(DateOnly.FromDateTime(DateTime.UtcNow))},{"endDate",""},{"status","Draft"},{"currencyCode","IRR"},{"description",""}},_=>new(){{"documentTypeId",""},{"documentNumber",""},{"issueDate",""},{"expiryDate",""},{"description",""}}};Criteria=CriterionOptions.Select(x=>new CriterionEditor(x.Value,x.Label)).ToList();SelectedFile=null;Message=null;Dialog=true;}
 private string CalculatedScore=>Criteria.Count==0?string.Empty:Criteria.Where(x=>decimal.TryParse(x.Score,NumberStyles.Number,CultureInfo.InvariantCulture,out _)).Select(x=>decimal.Parse(x.Score,CultureInfo.InvariantCulture)).DefaultIfEmpty().Average().ToString("0.##",CultureInfo.InvariantCulture); private void Set(string key,object? value)=>Data[key]=value?.ToString()??string.Empty; private void Close(){if(!Busy)Dialog=false;} private async Task SetQcLevel(string value){QcLevel=value;} private void SelectFile(InputFileChangeEventArgs e)=>SelectedFile=e.File;
 private DateOnly? Canonical(string key)=>Dates.TryParseCanonical(Data.GetValueOrDefault(key,""),out var value)?value:null;
 private void SetDate(string key,DateOnly? value)=>Data[key]=value is DateOnly date ? Dates.Canonical(date) : null??string.Empty;
 private async Task SaveProfile(){if(Token is null)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/suppliers/{SupplierId}/lifecycle/approval",new{status=Approval,qcLevelId=Guid.TryParse(QcLevel,out var qc)?qc:(Guid?)null,version=Version},Token,Company(),default);if(r.IsSuccess){Version=r.Value.GetProperty("version").GetInt64();Message="Saved";Success=true;}else Message="ValidationError";}
 private async Task ApprovalChanged(ChangeEventArgs e){Approval=e.Value?.ToString()??"Pending";var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/suppliers/{SupplierId}/lifecycle/approval",new{status=Approval,version=Version},Token!,Company(),default);if(r.IsSuccess){Version=r.Value.GetProperty("version").GetInt64();Success=true;Message="Saved";}else Message="ValidationError";}
 private async Task ToggleHold(){var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/suppliers/{SupplierId}/lifecycle/hold",new{held=!Held,reason=HoldReason,notes=HoldNotes,version=Version},Token!,Company(),default);if(r.IsSuccess){Held=!Held;Version=r.Value.GetProperty("version").GetInt64();Message="Saved";}else Message="ValidationError";}
 private async Task Save(){if(Token is null||DialogReadOnly)return;bool editing=EditingId is Guid;HttpMethod method=Kind=="contracts"&&editing||Kind=="evaluation"&&editing||Kind=="quality-incidents"&&editing||Kind=="documents"&&editing?HttpMethod.Put:HttpMethod.Post;string segment=Kind switch { "quality" or "quality-incidents" => "quality-incidents", "evaluation" => "evaluations", "contracts" => "contracts", "documents" => "documents", _ => Kind };string path=$"api/v1/suppliers/{SupplierId}/lifecycle/{segment}"+(editing?$"/{EditingId}":"");object body=Kind switch{"evaluation"=>new{evaluationDate=Canonical("evaluationDate")!.Value,notes=Data["notes"],criteria=Criteria.Where(x=>Guid.TryParse(x.Id,out _)&&decimal.TryParse(x.Score,NumberStyles.Number,CultureInfo.InvariantCulture,out _)).Select(x=>new{criterionId=Guid.Parse(x.Id),score=decimal.Parse(x.Score,CultureInfo.InvariantCulture),comment=x.Comment}).ToArray(),version=Version},"quality" or "quality-incidents"=>new{incidentType=Data["incidentType"],incidentDate=Canonical("incidentDate")!.Value,quantity=decimal.TryParse(Data["quantity"],out var q)?q:(decimal?)null,description=Data["description"],version=Version},"contracts"=>new{contractNumber=Data["contractNumber"],contractTypeId=Guid.Parse(Data["contractTypeId"]),startDate=Canonical("startDate")!.Value,endDate=Canonical("endDate"),description=Data["description"],currencyCode=Data["currencyCode"],status=Data["status"],version=Version},_=>new{documentTypeId=Guid.Parse(Data["documentTypeId"]),documentNumber=Data["documentNumber"],issueDate=Canonical("issueDate"),expiryDate=Canonical("expiryDate"),description=Data["description"],version=Version}};var r=await Core.SendAsync(method,path,body,Token,Company(),default);if(r.IsSuccess){JsonElement entity=r.Value.TryGetProperty("evaluation",out var evaluation)?evaluation:r.Value.TryGetProperty("contract",out var contract)?contract:r.Value.TryGetProperty("document",out var document)?document:r.Value;Guid id=Guid.Parse(Text(entity,"id"));long version=entity.TryGetProperty("version",out var v)?v.GetInt64():1;if(SelectedFile is not null&&(Kind=="contracts"||Kind=="documents")){await using Stream stream=SelectedFile.OpenReadStream(25*1024*1024);var upload=await Core.UploadAsync("api/v1/files/upload",SelectedFile.Name,SelectedFile.ContentType,stream,SelectedFile.Size,Token,Company(),default);if(upload.IsSuccess){Guid fileId=upload.Value.GetProperty("fileId").GetGuid();Guid fileVersion=upload.Value.GetProperty("fileVersionId").GetGuid();string filePath=Kind=="contracts"?$"api/v1/suppliers/{SupplierId}/lifecycle/contracts/{id}/file":$"api/v1/suppliers/{SupplierId}/lifecycle/documents/{id}/file";await Core.SendAsync(HttpMethod.Post,filePath,new{fileId,fileVersionId=fileVersion,version},Token,Company(),default);}}Dialog=false;Message="Saved";Success=true;await Load();}else Message="ValidationError";}
 private async Task Resolve(JsonElement x){var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/suppliers/{SupplierId}/lifecycle/quality-incidents/{Text(x,"id")}/resolve",new{resolvedDate=DateOnly.FromDateTime(DateTime.UtcNow),version=x.GetProperty("version").GetInt64()},Token!,Company(),default);if(r.IsSuccess)await Load();}
 private async Task Delete(JsonElement x){var r=await Core.SendAsync(HttpMethod.Delete,$"api/v1/suppliers/{SupplierId}/lifecycle/contracts/{Text(x,"id")}?version={x.GetProperty("version").GetInt64()}",null,Token!,Company(),default);if(r.IsSuccess)await Load();}
 private async Task DeleteDocument(JsonElement x){var r=await Core.SendAsync(HttpMethod.Delete,$"api/v1/suppliers/{SupplierId}/lifecycle/documents/{Text(x,"id")}?version={x.GetProperty("version").GetInt64()}",null,Token!,Company(),default);if(r.IsSuccess)await Load();}
 private void Show(JsonElement x,bool readOnly){EditingId=Guid.TryParse(Text(x,"id"),out var id)?id:null;DialogReadOnly=readOnly;Version=x.TryGetProperty("version",out var v)?v.GetInt64():0;Data=x.EnumerateObject().ToDictionary(p=>p.Name,p=>p.Value.ToString());Dialog=true;} private void ShowEvaluation(JsonElement x,bool readOnly=true){var e=x.GetProperty("evaluation");EditingId=Guid.TryParse(Text(e,"id"),out var id)?id:null;DialogReadOnly=readOnly;Version=e.TryGetProperty("version",out var v)?v.GetInt64():0;Data=e.EnumerateObject().ToDictionary(p=>p.Name,p=>p.Value.ToString());Criteria=x.TryGetProperty("criteria",out var c)&&c.ValueKind==JsonValueKind.Array?c.EnumerateArray().Select(v=>new CriterionEditor(Text(v,"criterionId"),CriterionOptions.FirstOrDefault(o=>o.Value==Text(v,"criterionId"))?.Label??Text(v,"criterionId")){Score=Text(v,"score"),Comment=Text(v,"comment")}).ToList():[];Dialog=true;}
 private async Task DownloadFile(JsonElement x){if(Token is null||!Guid.TryParse(Text(x,"fileId"),out var file)||!Guid.TryParse(Text(x,"fileVersionId"),out var version))return;var r=await Core.DownloadAsync($"api/v1/files/{file}/versions/{version}/download",Token,Company(),default);if(r.IsSuccess)await JS.InvokeVoidAsync("open",$"data:{r.Value.ContentType};base64,{Convert.ToBase64String(r.Value.Content)}","_blank");}
 private static string Text(JsonElement x,string key)=>x.TryGetProperty(key,out var v)?v.ValueKind==JsonValueKind.Null?string.Empty:v.ToString():string.Empty; private string Date(JsonElement x,string key)=>Dates.TryParseCanonical(Text(x,key),out var d)?Dates.Format(d,CultureInfo.CurrentUICulture.TwoLetterISOLanguageName):"";
 private sealed class CriterionEditor(string id,string name){public string Id{get;}=id;public string Name{get;}=name;public string Score{get;set;}="";public string Comment{get;set;}="";}
}
