@using System.Globalization
@using System.Text.Json
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<section class="crud-card warehouse-section" data-warehouse-grid>
    <header class="section-header"><div><h2>@T("انبارها","المستودعات","Warehouses")</h2><p>@T("مدیریت انبارهای شرکت","إدارة مستودعات الشركة","Company warehouse administration")</p></div><button type="button" class="btn btn-primary" @onclick="New"><BarangIcon Name="plus" /> @T("افزودن","إضافة","Add")</button></header>
    <div class="crud-toolbar"><label class="crud-search"><span>@T("جستجو","بحث","Search")</span><input value="@Search" @oninput="SearchChanged" placeholder="@T("جستجوی انبار","بحث في المستودعات","Search warehouses")" /></label><button type="button" class="btn btn-secondary" disabled="@Loading" @onclick="Reset"><BarangIcon Name="reset" /> @T("بازنشانی","إعادة ضبط","Reset")</button></div>
    @if (Message is not null) { <div class="@(Success ? "inline-success" : "inline-error")" role="@(Success ? "status" : "alert")">@Message</div> }
    @if (Loading) { <BarangLoadingState Text="@T("در حال بارگذاری…","جار التحميل…","Loading…")" /> }
    else if (Rows.Count == 0) { <CrudEmptyState Title="@T("انباری یافت نشد","لم يتم العثور على مستودعات","No warehouses found")" /> }
    else {
        <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th><BarangSortHeader Label="@T("کد","الرمز","Code")" Active="@(Sort == "code")" Descending="Descending" Clicked='()=>ChangeSort("code")' /></th><th><BarangSortHeader Label="@T("نام","الاسم","Name")" Active="@(Sort == "name")" Descending="Descending" Clicked='()=>ChangeSort("name")' /></th><th><BarangSortHeader Label="@T("نوع","النوع","Classification")" Active="@(Sort == "type")" Descending="Descending" Clicked='()=>ChangeSort("type")' /></th><th><BarangSortHeader Label="@T("وضعیت","الحالة","Status")" Active="@(Sort == "status")" Descending="Descending" Clicked='()=>ChangeSort("status")' /></th><th>@T("عملیات","الإجراءات","Actions")</th></tr></thead><tbody>
        @foreach (var row in Rows) { <tr><td dir="ltr">@row.Code</td><td>@row.Name</td><td>@TypeLabel(row.Type)</td><td><StatusBadge Active="@row.IsActive" /></td><td><BarangActionMenu><BarangIconButton Icon="eye" Semantic="info" Label="@T("مشاهده","عرض","View")" Clicked="@(() => Open(row, true))" /><BarangIconButton Icon="edit" Semantic="edit" Label="@T("ویرایش","تحرير","Edit")" Clicked="@(() => Open(row, false))" /><BarangIconButton Icon="power" Semantic="warning" Label="@(row.IsActive ? T("غیرفعال‌سازی","تعطيل","Deactivate") : T("فعال‌سازی","تفعيل","Activate"))" Clicked="@(() => Toggle(row))" /><BarangIconButton Icon="trash" Semantic="danger" Label="@T("حذف","حذف","Delete")" Clicked="@(() => Delete(row))" /></BarangActionMenu></td></tr> }
        </tbody></table></div>
        <BarangPagination Page="@Page" HasNext="@(Page * PageSize < TotalCount)" Disabled="@Loading" PageLabel="" PreviousText="@T("قبلی","السابق","Previous")" NextText="@T("بعدی","التالي","Next")" Previous="Previous" Next="Next" />
    }
</section>

<BarangModal Open="@Dialog" Title="@(ReadOnly ? T("مشاهده انبار","عرض المستودع","View warehouse") : Editing is null ? T("افزودن انبار","إضافة مستودع","Add warehouse") : T("ویرایش انبار","تحرير المستودع","Edit warehouse"))" Size="large" CloseRequested="Close">
    <ChildContent><div class="form-grid"><label><span>@T("کد انبار","رمز المستودع","Warehouse code")</span><input @bind="Code" disabled="@(ReadOnly || Editing is not null)" /></label><label><span>@T("نام انبار","اسم المستودع","Warehouse name")</span><input @bind="Name" disabled="@ReadOnly" /></label><label><span>@T("نوع انبار","نوع المستودع","Classification")</span><select @bind="Type" disabled="@ReadOnly"><option value="RawMaterials">@TypeLabel(WarehouseType.RawMaterials)</option><option value="WorkInProcess">@TypeLabel(WarehouseType.WorkInProcess)</option><option value="FinishedGoods">@TypeLabel(WarehouseType.FinishedGoods)</option><option value="Shipping">@TypeLabel(WarehouseType.Shipping)</option><option value="Returns">@TypeLabel(WarehouseType.Returns)</option><option value="Scrap">@TypeLabel(WarehouseType.Scrap)</option></select></label><label><span>@T("شعبه","الفرع","Branch")</span><SearchableSelect Options="@BranchOptions" @bind-Value="BranchId" Disabled="@ReadOnly" Placeholder="@T("انتخاب شعبه","اختر الفرع","Choose branch")" /></label></div></ChildContent>
    <Footer><button type="button" class="btn btn-secondary" @onclick="Close">@T("انصراف","إلغاء","Cancel")</button>@if(!ReadOnly){<button type="button" class="btn btn-primary" @onclick="Save">@T("ذخیره","حفظ","Save")</button>}</Footer>
</BarangModal>

@code {
    private enum WarehouseType { RawMaterials, WorkInProcess, FinishedGoods, Shipping, Returns, Scrap }
    private sealed record Row(Guid Id,string Code,string Name,WarehouseType Type,bool IsActive,Guid? BranchId,long Version);
    private string Search="",Code="",Name="",BranchId="",Type="RawMaterials",Sort="code"; private bool Descending; private string? Message; private bool Loading,Dialog,ReadOnly,Success; private Row? Editing; private int Page=1,TotalCount; private const int PageSize=25; private List<Row> Rows=[]; private List<SearchableSelectOption> BranchOptions=[]; private CancellationTokenSource? SearchCancellation;
    protected override async Task OnInitializedAsync(){await LoadBranches();await Load();}
    private string Lang=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    private string T(string fa,string ar,string en)=>Lang switch{"en"=>en,"ar"=>ar,_=>fa};
    private string TypeLabel(WarehouseType type)=>type switch{WarehouseType.RawMaterials=>T("مواد اولیه","مواد خام","Raw materials"),WarehouseType.WorkInProcess=>T("در حال ساخت","قيد التصنيع","Work in process"),WarehouseType.FinishedGoods=>T("محصول نهایی","المنتجات النهائية","Finished goods"),WarehouseType.Shipping=>T("ارسال","الشحن","Shipping"),WarehouseType.Returns=>T("مرجوعی","المرتجعات","Returns"),_=>T("ضایعات","الخردة","Scrap")};
    private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
    private async Task LoadBranches(){var s=await Session();if(s is null)return;var r=await Core.GetAsync("api/v1/organization/branches",s.Value.Token,s.Value.Company,default);if(r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array)BranchOptions=[new("",T("بدون شعبه","بدون فرع","No branch")),..r.Value.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("id").GetGuid().ToString(),x.TryGetProperty("displayName",out var n)?n.ToString():x.TryGetProperty("code",out var c)?c.ToString():""))];}
    private async Task Load(){Loading=true;var s=await Session();if(s is null){Loading=false;return;}var r=await Core.GetAsync($"api/v1/organization/warehouses?search={Uri.EscapeDataString(Search)}&pageNumber={Page}&pageSize={PageSize}&sort={Sort}&descending={Descending.ToString().ToLowerInvariant()}",s.Value.Token,s.Value.Company,default);Rows=[];TotalCount=0;if(r.IsSuccess){var root=r.Value;if(root.ValueKind==JsonValueKind.Object&&root.TryGetProperty("items",out var items)){TotalCount=root.TryGetProperty("totalCount",out var total)?total.GetInt32():0;Rows=items.EnumerateArray().Select(Parse).ToList();}else if(root.ValueKind==JsonValueKind.Array){Rows=root.EnumerateArray().Select(Parse).ToList();TotalCount=Rows.Count;}}Loading=false;}
    private static Row Parse(JsonElement x)=>new(x.GetProperty("id").GetGuid(),x.GetProperty("code").ToString(),x.GetProperty("name").ToString(),Enum.TryParse<WarehouseType>(x.GetProperty("type").ToString(),true,out var t)?t:WarehouseType.RawMaterials,x.GetProperty("isActive").GetBoolean(),x.TryGetProperty("branchId",out var b)&&b.ValueKind!=JsonValueKind.Null?b.GetGuid():null,x.GetProperty("version").GetInt64());
    private async Task SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";Page=1;SearchCancellation?.Cancel();SearchCancellation?.Dispose();SearchCancellation=new();try{await Task.Delay(250,SearchCancellation.Token);await Load();}catch(OperationCanceledException){}}
    private Task Reset(){Search="";Page=1;Sort="code";Descending=false;Message=null;return Load();} private Task ChangeSort(string column){if(Sort==column)Descending=!Descending;else{Sort=column;Descending=false;}Page=1;return Load();} private Task Previous(){if(Page>1){Page--;return Load();}return Task.CompletedTask;} private Task Next(){if(Page*PageSize<TotalCount){Page++;return Load();}return Task.CompletedTask;}
    private void New(){Editing=null;ReadOnly=false;Code=Name=BranchId="";Type="RawMaterials";Message=null;Dialog=true;}
    private void Open(Row row,bool view){Editing=row;ReadOnly=view;Code=row.Code;Name=row.Name;BranchId=row.BranchId?.ToString()??"";Type=row.Type.ToString();Message=null;Dialog=true;}
    private void Close()=>Dialog=false;
    private Guid? BranchValue()=>Guid.TryParse(BranchId,out var branch)?branch:null;
    private async Task Save(){var s=await Session();if(s is null)return;if(string.IsNullOrWhiteSpace(Code)||string.IsNullOrWhiteSpace(Name)){Success=false;Message=T("کد و نام انبار الزامی است.","رمز واسم المستودع مطلوبان.","Warehouse code and name are required.");return;}if(!Enum.TryParse<WarehouseType>(Type,true,out var parsed)){Success=false;Message=T("نوع انبار نامعتبر است.","نوع المستودع غير صالح.","Invalid warehouse classification.");return;}object body=Editing is null?new{code=Code,name=Name,type=parsed,branchId=BranchValue()}:new{name=Name,type=parsed,branchId=BranchValue(),version=Editing.Version};var r=await Core.SendAsync(Editing is null?HttpMethod.Post:HttpMethod.Put,Editing is null?"api/v1/organization/warehouses":$"api/v1/organization/warehouses/{Editing.Id}",body,s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("انبار ذخیره شد.","تم حفظ المستودع.","Warehouse saved."):T("ذخیره انبار انجام نشد.","تعذر حفظ المستودع.","Warehouse could not be saved.");if(r.IsSuccess){Dialog=false;await Load();}}
    private async Task Toggle(Row row){if(!await JS.InvokeAsync<bool>("confirm",row.IsActive?T("انبار غیرفعال شود؟","تعطيل المستودع؟","Deactivate this warehouse?"):T("انبار فعال شود؟","تفعيل المستودع؟","Activate this warehouse?")))return;var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Put,$"api/v1/organization/warehouses/{row.Id}/activation",new{isActive=!row.IsActive,version=row.Version},s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("وضعیت انبار تغییر کرد.","تم تغيير حالة المستودع.","Warehouse status changed."):T("تغییر وضعیت انبار ممکن نیست.","تعذر تغيير حالة المستودع.","Warehouse status could not be changed.");if(r.IsSuccess)await Load();}
    private async Task Delete(Row row){if(!await JS.InvokeAsync<bool>("confirm",T("این انبار حذف شود؟","حذف هذا المستودع؟","Delete this warehouse?")))return;var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Delete,$"api/v1/organization/warehouses/{row.Id}?version={row.Version}",null,s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("انبار حذف شد.","تم حذف المستودع.","Warehouse deleted."):DeleteError(r);if(r.IsSuccess)await Load();}
    private string DeleteError(ApiResult<JsonElement> result)=>result.ProblemCode switch{"organization.delete.protected_dependency"=>T("انبار به دلیل سوابق وابسته قابل حذف نیست؛ آن را غیرفعال کنید.","لا يمكن حذف المستودع لوجود سجلات مرتبطة؛ عطّله بدلاً من ذلك.","This warehouse has protected records and cannot be deleted; deactivate it instead."),"organization.concurrency_conflict"=>T("اطلاعات انبار تغییر کرده است؛ دوباره بارگذاری کنید.","تغيرت بيانات المستودع؛ أعد التحميل وحاول مرة أخرى.","The warehouse changed; reload and try again."),"organization.resource.not_found"=>T("انبار یافت نشد.","لم يتم العثور على المستودع.","Warehouse was not found."),_=>T("حذف انبار انجام نشد.","تعذر حذف المستودع.","Warehouse could not be deleted.")};
}
