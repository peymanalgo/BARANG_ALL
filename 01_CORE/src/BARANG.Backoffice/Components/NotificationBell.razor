@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<div class="notification-bell" @onkeydown="KeyDown">
    <button type="button" class="notification-bell-trigger" aria-label="@T("اعلان‌ها","Notifications","الإشعارات")" aria-expanded="@IsOpen" @onclick="Toggle">
        <BarangIcon Name="bell" />@if(Unread>0){<span class="notification-bell-badge" aria-label="@T($"{Unread} اعلان خوانده‌نشده",$"{Unread} unread notifications",$"{Unread} إشعار غير مقروء")">@(Unread>99?"99+":Unread)</span>}
    </button>
    @if(IsOpen){<button type="button" class="notification-bell-backdrop" aria-label="@T("بستن اعلان‌ها","Close notifications","إغلاق الإشعارات")" @onclick="Close"></button><section class="notification-bell-popover" role="dialog" aria-label="@T("اعلان‌های اخیر","Recent notifications","الإشعارات الأخيرة")" @onclick:stopPropagation><header><div><strong>@T("اعلان‌های اخیر","Recent notifications","الإشعارات الأخيرة")</strong><small>@T($"{Unread} خوانده‌نشده",$"{Unread} unread",$"{Unread} غير مقروء")</small></div><button type="button" class="notification-bell-close" aria-label="@T("بستن","Close","إغلاق")" @onclick="Close">×</button></header>@if(Loading){<p class="notification-bell-message">@T("در حال بارگذاری…","Loading…","جار التحميل…")</p>}else if(Rows.Count==0){<p class="notification-bell-message">@T("اعلان جدیدی نیست.","No new notifications.","لا توجد إشعارات جديدة.")</p>}else{<div class="notification-bell-list">@foreach(Row row in Rows){<button type="button" class="notification-bell-item @(row.ReadAt is null?"is-unread":"")" @onclick="()=>OpenRow(row)"><span class="notification-bell-item-icon"><BarangIcon Name="bell" /></span><span><strong>@Title(row.TemplateCode)</strong><small>@Relative(row.CreatedAt)</small></span></button>}</div>}<footer><a href="/workspace/notifications" @onclick="Close">@T("مشاهده همه اعلان‌ها","View all notifications","عرض كل الإشعارات")</a></footer></section>}
</div>

@code {
    private bool IsOpen, Loading; private long Unread; private List<Row> Rows=[]; private CancellationTokenSource? Stop;
    protected override async Task OnInitializedAsync(){await Refresh();Stop=new();_ = RefreshLoop(Stop.Token);}
    private async Task RefreshLoop(CancellationToken ct){using PeriodicTimer timer=new(TimeSpan.FromSeconds(45));try{while(await timer.WaitForNextTickAsync(ct)){await Refresh();await InvokeAsync(StateHasChanged);}}catch(OperationCanceledException){}}
    private async Task Refresh(){var s=await Session();if(s is null)return;Loading=true;var r=await Core.GetAsync("api/v1/notifications/mine?unread=true&page=1&pageSize=5",s.Value.Token,s.Value.Company,default);if(r.IsSuccess){Unread=Long(r.Value,"total");Rows=Parse(r.Value);}Loading=false;}
    private async Task Toggle(){IsOpen=!IsOpen;if(IsOpen)await Refresh();}private void Close()=>IsOpen=false;private async Task OpenRow(Row row){if(row.ReadAt is null){var s=await Session();if(s is not null)await Core.SendAsync(HttpMethod.Post,$"api/v1/notifications/{row.Id}/read",new{version=row.Version},s.Value.Token,s.Value.Company,default);}if(row.Route is not null)Navigation.NavigateTo(row.Route);Close();}
    private async Task KeyDown(KeyboardEventArgs e){if(e.Key=="Escape")Close();}
    private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
    private static long Long(JsonElement x,string n)=>x.TryGetProperty(n,out var v)&&v.TryGetInt64(out var l)?l:0;private static List<Row> Parse(JsonElement x)=>x.TryGetProperty("items",out var a)&&a.ValueKind==JsonValueKind.Array?a.EnumerateArray().Select(v=>new Row(v.GetProperty("id").GetGuid(),v.GetProperty("templateCode").GetString()??"notification",v.TryGetProperty("readAtUtc",out var r)&&r.ValueKind!=JsonValueKind.Null?r.GetDateTimeOffset():null,v.GetProperty("createdAtUtc").GetDateTimeOffset(),v.TryGetProperty("sourceRoute",out var route)&&route.ValueKind!=JsonValueKind.Null?route.GetString():null,v.GetProperty("version").GetInt64())).ToList():[];
    private string Title(string code)=>code switch{"order.submitted"=>T("ثبت سفارش","Order submitted","تم تسجيل الطلب"),"shipment.dispatched"=>T("ارسال مرسوله","Shipment dispatched","تم شحن الشحنة"),_=>code};private string Relative(DateTimeOffset d){var a=DateTimeOffset.UtcNow-d;return a.TotalMinutes<1?T("همین حالا","Just now","الآن"):a.TotalHours<1?T($"{(int)a.TotalMinutes} دقیقه پیش",$"{(int)a.TotalMinutes}m ago",$"منذ {(int)a.TotalMinutes} د"):T($"{(int)a.TotalHours} ساعت پیش",$"{(int)a.TotalHours}h ago",$"منذ {(int)a.TotalHours} س");}private string T(string fa,string en,string ar)=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"en"=>en,"ar"=>ar,_=>fa};public async ValueTask DisposeAsync(){if(Stop is not null){Stop.Cancel();Stop.Dispose();}await Task.CompletedTask;}private sealed record Row(Guid Id,string TemplateCode,DateTimeOffset?ReadAt,DateTimeOffset CreatedAt,string?Route,long Version);
}
