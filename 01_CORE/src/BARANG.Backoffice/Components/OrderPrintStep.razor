    private string ApiError(ApiResult<JsonElement> result, string fallback)
    {
        if (result.Failure is ApiFailure.Unauthorized or ApiFailure.Forbidden)
            return L["Unauthorized"].Value;
        if (result.Failure == ApiFailure.Conflict)
            return L["ConcurrencyConflict"].Value;
        if (result.Failure == ApiFailure.Unavailable)
            return L["ApiUnavailable"].Value;

        string? code = result.ProblemCode?.Trim().ToLowerInvariant();
        string reason = code switch
        {
            "order.invalid_print_method" => V["InvalidPrintMethod"].Value,
            "order.print_location_required" => V["MissingLocation"].Value,
            "order.invalid_print_location" => V["InvalidLocation"].Value,
            "order.print_method_required" => V["MissingMethod"].Value,
            "order.print_width_required" => V["MissingWidth"].Value,
            "order.print_width_invalid" => V["InvalidWidth"].Value,
            "order.print_height_required" => V["MissingHeight"].Value,
            "order.print_height_invalid" => V["InvalidHeight"].Value,
            "order.print_source_required" => V["MissingArtwork"].Value,
            "order.print_sources_exclusive" => V["BothArtworkSources"].Value,
            "order.invalid_artwork_version" => V["InvalidArtworkSource"].Value,
            "order.invalid_file_version" => V["InvalidFileSource"].Value,
            "order.print_item_not_owned" => V["PrintItemNotOwned"].Value,
            "order.print_operation_duplicate" => V["DuplicateOperation"].Value,
            "order.invalid_data" => V["InvalidOperationData"].Value,
            _ when !string.IsNullOrWhiteSpace(result.ProblemDescription) => result.ProblemDescription!.Trim(),
            _ => fallback
        };

        return result.Failure == ApiFailure.Validation
            ? V["SaveFailedWithReason", reason].Value
            : reason;
    }
