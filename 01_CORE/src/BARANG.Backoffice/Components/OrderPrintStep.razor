    private string DisplayProduct(string value) => ValueOrDash(value);
    private string DisplaySku(string value, string productCode = "")
    {
        if (string.IsNullOrWhiteSpace(productCode) && SkuCaptions.TryGetValue(value.Trim(), out string? mappedCode))
            return mappedCode;
        if (string.IsNullOrWhiteSpace(value) || value == "—" || Guid.TryParse(value, out _))
            return string.IsNullOrWhiteSpace(productCode) || productCode == "—" ? T["ItemSku"].Value : productCode;
        if (value.All(char.IsDigit) && !string.IsNullOrWhiteSpace(productCode))
            return productCode;
        return value;
    }

    private string DisplayColor(string value)
    {
        if (ColorCaptions.TryGetValue(value.Trim(), out string? caption))
            return caption;
        string normalized = value.Trim().ToLowerInvariant();
        string key = normalized switch
        {
            "white" or "سفید" => "ColorWhite",
            "red" or "قرمز" => "ColorRed",
            "black" or "مشکی" => "ColorBlack",
            "blue" or "آبی" => "ColorBlue",
            "green" or "سبز" => "ColorGreen",
            "yellow" or "زرد" => "ColorYellow",
            "purple" or "violet" or "بنفش" => "ColorPurple",
            _ => ""
        };
        return string.IsNullOrWhiteSpace(key) ? ValueOrDash(value) : T[key].Value;
    }

