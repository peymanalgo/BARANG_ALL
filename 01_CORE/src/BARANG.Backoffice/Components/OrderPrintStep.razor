    private async Task LoadColorCaptions((string Token,Guid Company) session)
    {
        ColorCaptions.Clear();
        const string path="api/v1/lookups/types/product.color/values?activeOnly=true";
        var result=await Core.GetAsync(path,session.Token,session.Company,default);
        if(!result.IsSuccess)
        {
            Logger.LogWarning("Color lookup failed: {Failure} {ProblemCode}",result.Failure,result.ProblemCode);
            return;
        }
        JsonElement rows=result.Value.ValueKind==JsonValueKind.Array?result.Value:result.Value.ValueKind==JsonValueKind.Object&&result.Value.TryGetProperty("items",out var items)?items:default;
        if(rows.ValueKind!=JsonValueKind.Array)return;
        foreach(JsonElement row in rows.EnumerateArray())
        {
            if(row.TryGetProperty("isActive",out var active)&&active.ValueKind==JsonValueKind.False)continue;
            string code=Text(row,"code");
            string caption=Caption(row);
            if(!string.IsNullOrWhiteSpace(code)&&!IsInternalCode(caption))ColorCaptions[code]=caption;
        }
        Logger.LogInformation("Loaded {Count} active product color captions",ColorCaptions.Count);
    }
