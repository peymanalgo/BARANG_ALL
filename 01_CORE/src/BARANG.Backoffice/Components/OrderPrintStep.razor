    private async Task UploadFile(InputFileChangeEventArgs e)
    {
        if (e.File is null)
        {
            return;
        }

        var session = await Session();
        if (session is null)
        {
            UploadError = L["SessionExpired"].Value;
            return;
        }

        UploadBusy = true;
        UploadError = "";
        try
        {
            string? localPreview = null;
            if (IsSupportedRasterMedia(e.File.ContentType, e.File.Name))
            {
                await using Stream localStream = e.File.OpenReadStream(25 * 1024 * 1024);
                using MemoryStream previewBuffer = new();
                await localStream.CopyToAsync(previewBuffer);
                localPreview = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(previewBuffer.ToArray())}";
            }

            await using Stream stream = e.File.OpenReadStream(25 * 1024 * 1024);
            var result = await Core.UploadAsync("api/v1/files/upload", e.File.Name, e.File.ContentType, stream, e.File.Size, session.Value.Token, session.Value.Company, default);
            if (!result.IsSuccess)
            {
                UploadError = A["UploadFailed"].Value;
                return;
            }

            Guid file = result.Value.GetProperty("fileId").GetGuid();
            Guid version = result.Value.GetProperty("fileVersionId").GetGuid();
            Draft.FileId = file;
            Draft.FileVersionId = version;
            Draft.UploadedFileName = Text(result.Value, "originalFileName", e.File.Name);
            Draft.DesignId = null;
            Draft.DesignTitle = Draft.DesignCode = "";
            Draft.ArtworkVersionId = null;

            ApiResult<FileDownload> thumbnail = await Core.DownloadAsync($"api/v1/files/{file}/versions/{version}/thumbnail", session.Value.Token, session.Value.Company, default);
            Draft.UploadPreview = thumbnail.IsSuccess
                ? $"data:{thumbnail.Value.ContentType};base64,{Convert.ToBase64String(thumbnail.Value.Content)}"
                : localPreview;
            if (!thumbnail.IsSuccess && Draft.UploadPreview is null)
            {
                UploadError = A["PreviewUnavailable"].Value;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Upload or preview failed for Order {OrderId}, Item {OrderItemId}", OrderId, SelectedItemId);
            UploadError = A["UploadFailed"].Value;
        }
        finally
        {
            UploadBusy = false;
        }
    }
