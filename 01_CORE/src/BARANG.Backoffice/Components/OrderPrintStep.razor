@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@using BARANG.Backoffice.Localization
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<BusinessStrings> B
@inject IStringLocalizer<OrderPrintStepStrings> T
@inject IStringLocalizer<OrderPrintArtworkStrings> A
@inject IStringLocalizer<OrderPrintValidationStrings> V
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILogger<OrderPrintStep> Logger

<section class="panel order-print-step-redesign" aria-labelledby="order-print-step-title"><h2 id="order-print-step-title">@L["Wizard_Print"]</h2><p class="form-help">@T["Intro"]</p>@if(Errors.Count>0){<div class="validation-summary order-print-validation-summary" role="alert" aria-live="assertive"><strong>@V["PrintOperationValidationTitle"]</strong><ul>@foreach(string e in Errors){<li>@e</li>}</ul></div>}@if(Items.Count==0){<div class="empty-state">@L["OrderItemsEmpty"]</div>}else{<div class="print-item-grid" role="listbox" aria-label='@T["PrintItem"]'>@foreach(PrintItem item in Items){bool selected=SelectedItemId==item.Id;bool configured=ItemIsComplete(item.Id);<article @key="item.Id" class="print-item-card @(selected?"is-selected":null) @(configured?"is-configured":"is-incomplete")" role="option" tabindex="0" aria-selected="@selected" aria-label="@ItemAriaLabel(item)" @onclick="()=>SelectItem(item.Id)" @onkeydown="(e)=>SelectItemOnKeyDown(e,item.Id)"><div class="print-item-card-content"><div class="print-item-shirt" aria-hidden="true"><svg viewBox="0 0 160 180" width="50" height="60" focusable="false" aria-hidden="true"><path fill="@ColorValue(DisplayColor(item.Color),item.ColorHex)" d="M43 24 66 10h28l23 14 25 18-13 28-14-9v87c0 8-6 14-14 14H59c-8 0-14-6-14-14V61l-14 9-13-28 25-18Z"/><path d="M66 10c1 14 7 22 14 22s13-8 14-22" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="4" stroke-linecap="round"/></svg></div><div class="print-item-info"><div class="print-item-field print-item-product"><span class="print-item-label">@T["ItemProduct"]</span><strong>@DisplayProduct(item.ProductName)</strong></div><div class="print-item-field print-item-sku"><span class="print-item-label">@T["ItemSku"]</span><strong dir="ltr">@DisplaySku(item.Sku,item.ProductCode)</strong></div><div class="print-item-field print-item-color"><span class="print-item-label">@T["ItemColor"]</span><span class="print-item-color-value"><i class="print-item-color-dot" style="background:@ColorValue(DisplayColor(item.Color),item.ColorHex)" aria-hidden="true"></i>@DisplayColor(item.Color)</span></div><div class="print-item-field print-item-size"><span class="print-item-label">@T["ItemSize"]</span><span>@ValueOrDash(item.Size)</span></div><div class="print-item-field print-item-quantity"><span class="print-item-label">@L["Quantity"]</span><span dir="ltr">@ValueOrDash(item.Quantity)</span></div></div></div><span class="print-item-status @(configured?"is-configured":"is-incomplete")"><span class="print-item-status-icon" aria-hidden="true">@(configured?"✓":"!")</span>@(configured?T["ConfiguredStatus"]:T["IncompleteStatus"])</span>@if(selected){<span class="print-item-check" aria-label="@T["Selected"]">✓</span>}</article>}</div>}
@if (CurrentItem is not null)
{
    <section class="order-print-editor">
        <h3>@L["PrintOperations"] — @CurrentItem.ProductName</h3>
        <div class="form-grid order-print-form-grid">
            <label>
                <span>@L["PrintLocation"] *</span>
                <select @bind="Draft.Position">
                    <option value="FRONT">@L["PrintFront"]</option>
                    <option value="BACK">@L["PrintBack"]</option>
                    <option value="SLEEVE">@L["PrintSleeve"]</option>
                    <option value="OTHER">@L["PrintOther"]</option>
                </select>
            </label>
            <label>
                <span>@L["Method"] *</span>
                <select name="print-method-step2" @bind="Draft.Method" disabled="@PrintMethodsLoading">
                    <option value="">@L["Choose"]</option>
                    @foreach (PrintMethodOption method in PrintMethods)
                    {
                        <option value="@method.Code">@method.Label</option>
                    }
                </select>
                @if (PrintMethodsLoading)
                {
                    <small role="status">@L["Loading"]</small>
                }
                else if (!string.IsNullOrWhiteSpace(PrintMethodsError))
                {
                    <small class="inline-error" role="alert">@PrintMethodsError</small>
                }
                else if (PrintMethods.Count == 0)
                {
                    <small class="inline-error" role="alert">@A["NoResults"]</small>
                }
            </label>
            <label>
                <span>@L["Width"] *</span>
                <div class="order-print-measurement"><input type="number" min="0.01" step="0.01" @bind="Draft.Width" /><span>@T["Centimeters"]</span></div>
            </label>
            <label>
                <span>@L["Height"] *</span>
                <div class="order-print-measurement"><input type="number" min="0.01" step="0.01" @bind="Draft.Height" /><span>@T["Centimeters"]</span></div>
            </label>
        </div>
        <div class="order-print-artwork-row">
            <section class="order-print-design-panel">
                <h4>@A["DesignBank"]</h4>
                @if (Draft.DesignId is Guid)
                {
                    <div class="order-print-source-card">
                        <DesignThumbnail DesignId="@Draft.DesignId.Value" Token="@Token" CompanyId="@Company" />
                        <span><strong>@ValueOrDash(Draft.DesignTitle)</strong><small dir="ltr">@ValueOrDash(Draft.DesignCode)</small></span>
                    </div>
                    <div class="order-print-source-actions">
                        <button type="button" class="order-print-source-button" @onclick="OpenDesignBank">@A["Change"]</button>
                        <button type="button" class="link-button danger" @onclick="RemoveDesign">@A["Remove"]</button>
                    </div>
                }
                else
                {
                    <div class="order-print-artwork-empty">
                        <span class="order-print-artwork-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 5h16v14H4zM7 15l3-3 2 2 2-3 3 4M8 9h.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        <p>@A["DesignBank"]</p><small>@A["DesignBankHelper"]</small>
                        <button type="button" class="order-print-source-button" @onclick="OpenDesignBank">@A["SelectFromDesignBank"]</button>
                    </div>
                }
            </section>
            <section class="order-print-design-panel">
                <h4>@A["Upload"]</h4>
                @if (Draft.FileVersionId is Guid)
                {
                    <div class="order-print-upload-preview">
                        @if (!string.IsNullOrWhiteSpace(Draft.UploadPreview))
                        {
                            <img src="@Draft.UploadPreview" alt="@ValueOrDash(Draft.UploadedFileName)" />
                        }
                        else
                        {
                            <span class="order-print-artwork-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 16V4m0 0L8 8m4-4 4 4M5 14v5h14v-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        }
                        <span><strong>@ValueOrDash(Draft.UploadedFileName)</strong><small>@A["UploadedFile"]</small></span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(UploadError))
                    {
                        <small class="inline-error" role="alert">@UploadError</small>
                    }
                    <div class="order-print-source-actions">
                        <label class="order-print-source-button">@A["Change"]<InputFile OnChange="UploadFile" accept="image/*" /></label>
                        <button type="button" class="link-button danger" @onclick="RemoveUpload">@A["Remove"]</button>
                    </div>
                }
                else
                {
                    <div class="order-print-artwork-empty">
                        <span class="order-print-artwork-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 16V4m0 0L8 8m4-4 4 4M5 14v5h14v-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        <p>@A["Upload"]</p><small>@A["UploadHelper"]</small>
                        <label class="order-print-source-button" aria-disabled="@UploadBusy">@(UploadBusy ? L["Loading"] : A["ChooseFile"])<InputFile OnChange="UploadFile" accept="image/*" /></label>
                        @if (UploadBusy)
                        {
                            <small role="status">@L["Loading"]</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(UploadError))
                        {
                            <small class="inline-error" role="alert">@UploadError</small>
                        }
                    </div>
                }
            </section>
        </div>
        <label class="order-print-note">
            <span>@T["PrintNotes"]</span>
            <textarea @bind="Draft.Note" placeholder="@T["PrintNotePlaceholder"]"></textarea>
        </label>
        <div class="order-print-actions">
            <button type="button" class="order-print-purple-secondary" @onclick="CancelEdit">@A["Cancel"]</button>
            <button type="button" class="order-print-purple-primary" data-testid="print-add-button" @onclick="OnAddClicked" @onclick:preventDefault="true" disabled="@Saving">@(Saving ? L["Saving"] : T["Add"])</button>
        </div>
    </section>
    <section class="order-print-grid-section">
        <h3>@L["PrintOperations"]</h3>
        <div class="data-grid-wrap">
            <table class="data-grid">
                <thead><tr><th>@T["PrintItem"]</th><th>@T["ItemSku"]</th><th>@L["PrintLocation"]</th><th>@L["Method"]</th><th>@L["Width"]</th><th>@L["Height"]</th><th>@T["Source"]</th><th>@T["PrintNotes"]</th></tr></thead>
                <tbody>
                    @foreach (PrintOperation operation in Items.SelectMany(item => Operations.Where(x => x.IsActive && x.ItemId == item.Id)))
                    {
                        PrintItem? operationItem = Items.FirstOrDefault(x => x.Id == operation.ItemId);
                        if (operationItem is null)
                        {
                            continue;
                        }
                        <tr @key="operation.Id">
                            <td>@operationItem.ProductName</td><td dir="ltr">@DisplaySku(operationItem.Sku, operationItem.ProductCode)</td><td>@PositionLabel(operation.Position)</td><td dir="ltr">@MethodLabel(operation.Method)</td><td dir="ltr">@Number(operation.Width)</td><td dir="ltr">@Number(operation.Height)</td><td>@SourceLabel(operation)</td><td>@ValueOrDash(operation.Note)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
<div class="form-actions"><button type="button" class="secondary-action" @onclick="BackRequested">@T["Back"]</button><button type="button" class="primary-link" @onclick="Continue">@L["Next"]</button></div></section>

@if (DesignBankOpen)
{
    <div class="order-print-modal-backdrop" @onclick="CloseDesignBank">
        <section class="order-print-design-modal" role="dialog" aria-modal="true" aria-labelledby="order-print-design-modal-title" @onclick:stopPropagation="true">
            <header class="order-print-design-modal-header">
                <h3 id="order-print-design-modal-title">@A["DesignBank"]</h3>
                <button type="button" class="order-print-design-modal-close" aria-label='@A["Cancel"]' @onclick="CloseDesignBank">×</button>
            </header>
            <div class="order-print-design-filters">
                <label><span>@A["Search"]</span><input value="@DesignSearch" @oninput="OnDesignSearch" /></label>
                <label><span>@A["Category"]</span><select value="@SelectedCategory" @onchange="OnCategoryChanged"><option value="">@A["Category"]</option>@foreach (CategoryOption x in Categories.Where(x => x.ParentId is null)){<option value="@x.Code">@x.Caption</option>}</select></label>
                <label><span>@A["Subcategory"]</span><select value="@SelectedSubcategory" @onchange="OnSubcategoryChanged"><option value="">@A["Subcategory"]</option>@foreach (CategoryOption x in Categories.Where(x => x.ParentCode == SelectedCategory)){<option value="@x.Code">@x.Caption</option>}</select></label>
            </div>
            <div class="order-print-design-gallery" role="listbox" aria-label="@A["DesignBank"]">
            @if (DesignBusy)
            {
                <p class="empty-state" role="status">@A["Loading"]</p>
            }
            else if (!string.IsNullOrWhiteSpace(DesignError))
            {
                <div class="inline-error" role="alert">@DesignError <button type="button" class="link-button" @onclick="LoadDesigns">@A["Retry"]</button></div>
            }
            else if (Designs.Count == 0)
            {
                <p class="empty-state">@A["NoResults"]</p>
            }
            else
            {
                    @foreach (DesignOption d in Designs)
                    {
                        bool sel = TemporaryDesignId == d.Id;
                        <button type="button" class="order-print-design-card @(sel ? "is-selected" : null)" role="option" aria-selected="@sel" @onclick="() => SelectDesign(d)">
                            <DesignThumbnail DesignId="@d.Id" Token="@Token" CompanyId="@Company" />
                            <strong>@d.Title</strong>
                            <small dir="ltr">@d.Code</small>
                            <small>@d.CategoryCaption</small>
                            @if (sel)
                            {
                                <span class="order-print-design-check" aria-hidden="true">✓</span>
                            }
                        </button>
                    }
            }
            </div>
            <footer class="order-print-design-modal-footer">
                <button type="button" class="order-print-purple-secondary" @onclick="CloseDesignBank">@A["Cancel"]</button>
                <button type="button" class="order-print-purple-primary" disabled="@(TemporaryDesignId is null)" @onclick="ConfirmDesign">@A["Confirm"]</button>
            </footer>
        </section>
    </div>
}
@code {
    private string SaveStage = "idle";
    private Guid SaveCorrelationId;
    [Parameter] public Guid? OrderId { get; set; } [Parameter] public EventCallback NextRequested { get; set; } [Parameter] public EventCallback BackRequested { get; set; }
    private readonly List<PrintItem> Items=[]; private readonly List<PrintOperation> Operations=[]; private readonly Dictionary<Guid,PrintDraft> Drafts=[]; private readonly List<string> Errors=[]; private readonly List<DesignOption> Designs=[]; private readonly List<CategoryOption> Categories=[]; private readonly List<PrintMethodOption> PrintMethods=[]; private readonly Dictionary<string,string> ColorCaptions=new(StringComparer.OrdinalIgnoreCase); private readonly Dictionary<string,string> SkuCaptions=new(StringComparer.OrdinalIgnoreCase); private Guid? SelectedItemId,LoadedOrderId,TemporaryDesignId; private PrintDraft Draft=new(); private bool DesignBankOpen,DesignBusy,UploadBusy,Saving,PrintMethodsLoading; private string DesignSearch="",SelectedCategory="",SelectedSubcategory="",DesignError="",UploadError="",PrintMethodsError=""; private string Token=""; private Guid Company; private PrintItem? CurrentItem=>SelectedItemId is Guid id?Items.FirstOrDefault(x=>x.Id==id):null;
    protected override async Task OnParametersSetAsync(){if(OrderId is Guid id&&LoadedOrderId!=id){LoadedOrderId=id;await Load();}}
    private async Task Load(){var s=await Session();if(s is null||OrderId is not Guid order)return;Token=s.Value.Token;Company=s.Value.Company;await LoadPrintMethods(s.Value);await LoadColorCaptions(s.Value);var r=await Core.GetAsync($"api/v1/orders/{order}",Token,Company,default);if(!r.IsSuccess){Errors.Clear();Errors.Add(ApiError(r,L["GenericError"].Value));return;}Items.Clear();Operations.Clear();Drafts.Clear();if(r.Value.TryGetProperty("items",out var items)&&items.ValueKind==JsonValueKind.Array)foreach(var item in items.EnumerateArray()){Guid id=item.GetProperty("id").GetGuid();var snap=item.TryGetProperty("snapshot",out var ss)&&ss.ValueKind==JsonValueKind.Object?ss:default;string productCode=ItemText(item,snap,"productCode");string sku=ItemText(item,snap,"variantSku");if(sku.All(char.IsDigit)&&productCode!="—")SkuCaptions[sku]=productCode;Items.Add(new(id,productCode,ItemText(item,snap,"productName"),sku,ItemText(item,snap,"colorCode","color"),ItemText(item,snap,"sizeCode","size"),Text(item,"quantity","—"),ItemText(item,snap,"colorHex")));if(item.TryGetProperty("printOperations",out var prints)&&prints.ValueKind==JsonValueKind.Array)foreach(var p in prints.EnumerateArray())Operations.Add(new(p.GetProperty("id").GetGuid(),id,NumberInt(p,"sequence"),Text(p,"printPositionCode","FRONT"),Text(p,"printMethodCode"),Decimal(p,"width"),Decimal(p,"height"),Text(p,"notes"),NumberLong(p,"version"),GuidValue(p,"artworkVersionId"),GuidValue(p,"fileVersionId"),Bool(p,"isActive",true)));}if(SelectedItemId is null||Items.All(x=>x.Id!=SelectedItemId))SelectedItemId=Items.FirstOrDefault()?.Id;LoadDraftFromPersisted();await HydratePersistedSource(s.Value);}
    private async Task LoadPrintMethods((string Token,Guid Company) session)
    {
        PrintMethods.Clear();
        PrintMethodsLoading=true;
        PrintMethodsError="";
        const string path="api/v1/lookups/types/print.method/values?activeOnly=true";
        try
        {
            Logger.LogInformation("Loading active print methods from {Path} for company {Company}",path,session.Company);
            var result=await Core.GetAsync(path,session.Token,session.Company,default);
            if(!result.IsSuccess)
            {
                PrintMethodsError=ApiError(result,L["GenericError"].Value);
                Logger.LogWarning("Print method lookup failed: {Failure} {ProblemCode}",result.Failure,result.ProblemCode);
                return;
            }

            JsonElement rows=result.Value.ValueKind==JsonValueKind.Array
                ? result.Value
                : result.Value.ValueKind==JsonValueKind.Object&&result.Value.TryGetProperty("items",out var items)
                    ? items
                    : default;
            if(rows.ValueKind!=JsonValueKind.Array)
            {
                PrintMethodsError=L["GenericError"].Value;
                Logger.LogWarning("Print method lookup returned an unsupported response shape: {ValueKind}",result.Value.ValueKind);
                return;
            }

            foreach(JsonElement row in rows.EnumerateArray())
            {
                if(row.TryGetProperty("isActive",out var active)&&active.ValueKind==JsonValueKind.False)continue;
                string code=Text(row,"code");
                if(string.IsNullOrWhiteSpace(code))continue;
                PrintMethods.Add(new(code,Caption(row)));
            }
            Logger.LogInformation("Loaded {Count} active print methods: {Codes}",PrintMethods.Count,string.Join(",",PrintMethods.Select(x=>x.Code)));
        }
        catch(Exception ex)
        {
            PrintMethodsError=L["GenericError"].Value;
            Logger.LogError(ex,"Print method lookup could not be loaded from {Path}",path);
        }
        finally
        {
            PrintMethodsLoading=false;
        }
    }
    private async Task SelectItem(Guid id){SaveDraftInMemory();bool hadDraft=Drafts.ContainsKey(id);SelectedItemId=id;LoadDraftFromPersisted();Errors.Clear();if(!hadDraft){var session=await Session();if(session is not null)await HydratePersistedSource(session.Value);}} private async Task SelectItemOnKeyDown(KeyboardEventArgs e,Guid id){if(e.Key is "Enter" or " " or "Spacebar")await SelectItem(id);} private void LoadDraftFromPersisted(){if(SelectedItemId is not Guid id){Draft=new();return;}if(Drafts.TryGetValue(id,out var d)){Draft=d;return;}var saved=Operations.FirstOrDefault(x=>x.ItemId==id);Draft=saved is null?new PrintDraft{Sequence=Operations.Where(x=>x.ItemId==id).Select(x=>x.Sequence).DefaultIfEmpty().Max()+1}:new PrintDraft(saved);}private void SaveDraftInMemory(){if(SelectedItemId is Guid id)Drafts[id]=Draft;} private void CancelEdit(){Drafts.Remove(SelectedItemId??Guid.Empty);LoadDraftFromPersisted();Errors.Clear();}
    private async Task HydratePersistedSource((string Token,Guid Company) s){if(SelectedItemId is not Guid item)return;PrintOperation? op=Operations.FirstOrDefault(x=>x.ItemId==item);if(op is null)return;if(op.ArtworkVersionId is Guid artworkVersion){var vr=await Core.GetAsync($"api/v1/artworks/versions/{artworkVersion}",s.Token,s.Company,default);if(vr.IsSuccess){Draft.ArtworkVersionId=artworkVersion;Guid artworkId=vr.Value.GetProperty("artworkId").GetGuid();var ar=await Core.GetAsync($"api/v1/artworks/{artworkId}",s.Token,s.Company,default);if(ar.IsSuccess){Draft.DesignId=artworkId;Draft.DesignTitle=Text(ar.Value,"title");Draft.DesignCode=Text(ar.Value,"code");}}}else if(op.FileVersionId is Guid fileVersion){Draft.FileVersionId=fileVersion;var fr=await Core.GetAsync($"api/v1/files/versions/{fileVersion}",s.Token,s.Company,default);if(fr.IsSuccess){Guid? fileId=GuidValue(fr.Value,"fileId");Draft.FileId=fileId;Draft.UploadedFileName=Text(fr.Value,"originalFileName");if(fileId is Guid f){var preview=await Core.DownloadAsync($"api/v1/files/{f}/versions/{fileVersion}/thumbnail",s.Token,s.Company,default);Draft.UploadPreview=preview.IsSuccess?$"data:{preview.Value.ContentType};base64,{Convert.ToBase64String(preview.Value.Content)}":null;}}}}
    private async Task OnAddClicked()
    {
        if (Saving)
        {
            Logger.LogDebug("Ignored duplicate Print Add click for order {OrderId}, item {OrderItemId}", OrderId, SelectedItemId);
            return;
        }

        SaveCorrelationId = Guid.NewGuid();
        SaveStage = "client-validation";
        Logger.LogInformation("Print Add clicked for order {OrderId}, item {OrderItemId}, correlation {CorrelationId}", OrderId, SelectedItemId, SaveCorrelationId);
        Errors.Clear();
        Saving = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            await SaveOperationCore();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Print Add failed at stage {SaveStage} for order {OrderId}, item {OrderItemId}, correlation {CorrelationId}", SaveStage, OrderId, SelectedItemId, SaveCorrelationId);
            Errors.Add(V["SaveFailedWithReference", SaveCorrelationId.ToString("N")].Value);
        }
        finally
        {
            Saving = false;
            SaveStage = "idle";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveOperationCore()
    {
        Logger.LogInformation("Print Add validation started for order {OrderId}, item {OrderItemId}", OrderId, SelectedItemId);

        if (SelectedItemId is not Guid item)
        {
            Errors.Add(T["MissingItem"].Value);
            return;
        }

        if (string.IsNullOrWhiteSpace(Draft.Position))
            Errors.Add(T["MissingLocation"].Value);

        if (string.IsNullOrWhiteSpace(Draft.Method))
            Errors.Add(V["MissingMethod"].Value);

        if (Draft.Width is null)
            Errors.Add(T["MissingWidth"].Value);
        else if (Draft.Width <= 0)
            Errors.Add(T["InvalidWidth"].Value);

        if (Draft.Height is null)
            Errors.Add(T["MissingHeight"].Value);
        else if (Draft.Height <= 0)
            Errors.Add(T["InvalidHeight"].Value);

        if (Draft.ArtworkVersionId is null && Draft.FileVersionId is null)
            Errors.Add(V["MissingArtwork"].Value);
        else if (Draft.ArtworkVersionId is not null && Draft.FileVersionId is not null)
            Errors.Add(V["BothArtworkSources"].Value);

        if (Errors.Count > 0)
            return;

        SaveStage = "session";
        var session = await Session();
        if (session is null)
        {
            Errors.Add(L["SessionExpired"].Value);
            return;
        }

        if (OrderId is not Guid order)
        {
            Errors.Add(T["MissingItem"].Value);
            return;
        }

        var body = new
        {
            sequence = Draft.Sequence,
            printPositionCode = Draft.Position,
            printMethodCode = Null(Draft.Method),
            width = Draft.Width,
            height = Draft.Height,
            artworkVersionId = Draft.ArtworkVersionId,
            fileVersionId = Draft.FileVersionId,
            notes = Null(Draft.Note),
            version = Draft.Version
        };
        string path = $"api/v1/orders/{order}/items/{item}/print-operations" + (Draft.OperationId is Guid op ? $"/{op}" : "");
        HttpMethod method = Draft.OperationId is null ? HttpMethod.Post : HttpMethod.Put;
        SaveStage = "http-request";
        Logger.LogInformation("Print Add API request started: {Method} {Path} for item {OrderItemId}; method={PrintMethod}; position={PrintPosition}; width={Width}; height={Height}; artwork={ArtworkVersionId}; file={FileVersionId}", method, path, item, Draft.Method, Draft.Position, Draft.Width, Draft.Height, Draft.ArtworkVersionId, Draft.FileVersionId);
        var result = await Core.SendAsync(method, path, body, session.Value.Token, session.Value.Company, default);
        Logger.LogInformation("Print Add API response received: success={Success}; status={StatusCode}; failure={Failure}; problemCode={ProblemCode}; problemDescription={ProblemDescription}", result.IsSuccess, result.StatusCode, result.Failure, result.ProblemCode, result.ProblemDescription);

        if (!result.IsSuccess)
        {
            Errors.Add(ApiError(result, V["SaveFailed"].Value));
            return;
        }

        if (Draft.FileId is Guid file)
        {
            SaveStage = "source-link";
            if (result.Value.ValueKind != JsonValueKind.Object ||
                !result.Value.TryGetProperty("id", out var operationId) ||
                operationId.ValueKind != JsonValueKind.String)
            {
                Errors.Add(V["SourceLinkFailed"].Value);
                return;
            }

            string linkPath = $"api/v1/orders/{order}/items/{item}/print-operations/{operationId.GetGuid()}/files/{file}/links";
            Logger.LogInformation("Print Add source-link request started: POST {Path}", linkPath);
            var link = await Core.SendAsync(
                HttpMethod.Post,
                linkPath,
                new { fileVersionId = Draft.FileVersionId, purpose = "Source" },
                session.Value.Token,
                session.Value.Company,
                default);
