@using System.Text.Json
@using BARANG.Backoffice.Localization
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<OrderStep7Strings> S
@inject IStringLocalizer<CartablePriorityStrings> P
@inject IStringLocalizer<OrderReviewPrintStrings> R
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject NavigationManager Navigation
@inject ILocaleDateService Dates

<section class="panel order-review-step" aria-labelledby="order-step7-title">
    <h2 id="order-step7-title">@S["Review"]</h2><p class="form-help">@S["Description"]</p>
    @if (Errors.Count > 0) { <div class="validation-summary" role="alert" aria-live="assertive"><strong>@L["ValidationError"]</strong><ul>@foreach (string error in Errors) { <li>@error</li> }</ul></div> }
    @if (SuccessMessage is not null) { <div class="inline-success" role="status">@SuccessMessage</div> }
    @if (Loading) { <div class="loading-state" role="status">@S["Loading"]</div> }
    else {
        <section class="form-section"><h3>@S["Header"]</h3><dl class="review-list"><dt>@L["Customer"]</dt><dd>@Text("customerDisplayName", Text("customerId", S["NoData"]))</dd><dt>@S["OrderNumber"]</dt><dd>@(string.IsNullOrWhiteSpace(Text("orderNumber")) ? S["DraftNumber"] : Text("orderNumber"))</dd><dt>@L["OrderDate"]</dt><dd>@DisplayDate(Text("orderDate"))</dd><dt>@L["Status"]</dt><dd>@Text("status", S["NoData"])</dd></dl></section>
        <section class="form-section"><h3>@S["Items"]</h3>@if (!Items.Any()) { <div class="empty-state">@S["NoItems"]</div> } else { <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@L["OrderItem"]</th><th>@L["Quantity"]</th><th>@L["Unit"]</th><th>@L["PrintOperations"]</th></tr></thead><tbody>@foreach (JsonElement item in Items) { <tr><td>@ItemText(item)</td><td dir="ltr">@Text(item,"quantity")</td><td>@Text(item,"snapshot","uomCode",S["NoData"])</td><td>@PrintCount(item)</td></tr>}</tbody></table></div> }</section>
        <section class="form-section"><h3>@R["PrintConfiguration"]</h3>@if (Prints.Count == 0) { <div class="empty-state">@S["NoData"]</div> } else { @foreach (JsonElement item in Items) { IEnumerable<JsonElement> itemPrints = PrintOperations(item); <article class="review-print-item"><h4>@ItemText(item)</h4>@foreach (JsonElement print in itemPrints) { <dl class="review-list"><dt>@R["Location"]</dt><dd>@PositionText(Text(print,"printPositionCode"))</dd><dt>@R["Method"]</dt><dd dir="ltr">@Text(print,"printMethodCode",R["None"])</dd><dt>@R["Width"]</dt><dd dir="ltr">@Text(print,"width","—")</dd><dt>@R["Height"]</dt><dd dir="ltr">@Text(print,"height","—")</dd><dt>@R["ArtworkSource"]</dt><dd>@SourceText(print)</dd><dt>@R["Note"]</dt><dd>@Text(print,"notes",R["None"])</dd></dl> } </article> } }</section>
        <section class="form-section"><h3>@L["AdditionalServices"]</h3>@if (Services.Count == 0) { <div class="empty-state">@S["NoData"]</div> } else { <ul class="review-list">@foreach (JsonElement service in Services) { <li>@Text(service,"serviceCode",S["NoData"]) · @Text(service,"quantity","0")</li> }</ul> }</section>
        <section class="form-section"><h3>@L["Action_Package"]</h3><dl class="review-list"><dt>@L["Action_Package"]</dt><dd>@Text("businessProfile","packagingTypeCode",S["NoData"])</dd><dt>@P["Priority"]</dt><dd>@PriorityText(Text("priority"))</dd></dl></section>
        <section class="form-section"><h3>@S["Delivery"]</h3><dl class="review-list"><dt>@L["Name"]</dt><dd>@Text("shippingAddress","recipientName",S["NoData"])</dd><dt>@L["Address"]</dt><dd>@Text("shippingAddress","addressLine1",S["NoData"])</dd><dt>@L["City"]</dt><dd>@Text("shippingAddress","city",S["NoData"])</dd><dt>@L["Wizard_Shipping"]</dt><dd>@Text("businessProfile","shippingMethodCode",S["NoData"])</dd></dl></section>
        <section class="form-section"><h3>@S["Pricing"]</h3><p>@(HasPricing ? $"{Text(Pricing,"finalTotal","0")} {Text(Pricing,"currencyCode","")}" : S["NoData"])</p></section>
        @if (Confirming) { <div class="confirmation-panel" role="alert"><p>@S["Confirm"]</p><button type="button" class="secondary-action" @onclick="(()=>Confirming=false)" disabled="@Busy">@L["Cancel"]</button><button type="button" class="primary-link" @onclick="Finalize" disabled="@Busy">@S["ConfirmYes"]</button></div> }
    }
    <div class="form-actions"><button type="button" class="secondary-action" @onclick="Back" disabled="@Busy">@S["Back"]</button><button type="button" class="secondary-action" @onclick="Validate" disabled="@(Busy || Loading)">@S["Validate"]</button><button type="button" class="primary-link" @onclick="(()=>Confirming=true)" disabled="@(Busy || Loading || Items.Count==0)">@S["Finalize"]</button></div>
</section>

@code {
    [Parameter] public Guid? OrderId { get; set; }
    [Parameter] public EventCallback BackRequested { get; set; }
    private bool Loading = true, Busy, Confirming, HasPricing;
    private string? SuccessMessage;
    private List<string> Errors = [];
    private JsonElement Order;
    private List<JsonElement> Items = [];
    private JsonElement Pricing;
    private List<JsonElement> Prints = [];
    private List<JsonElement> Services = [];
    protected override async Task OnParametersSetAsync() { if (OrderId is not Guid id) return; Loading = true; Errors=[]; HasPricing=false; var s=await Session(); if(s is null){Errors=[L["SessionExpired"]];Loading=false;return;} var r=await Core.GetAsync($"api/v1/orders/{id}",s.Value.Token,s.Value.Company,default); if(!r.IsSuccess){Errors=[S["FinalizeFailed"]];Loading=false;return;} Order=r.Value; if(Order.TryGetProperty("items",out var a)&&a.ValueKind==JsonValueKind.Array){Items=a.EnumerateArray().ToList();Prints=Items.SelectMany(x=>x.TryGetProperty("printOperations",out var p)&&p.ValueKind==JsonValueKind.Array?p.EnumerateArray():[]).ToList();} if(Order.TryGetProperty("services",out var sv)&&sv.ValueKind==JsonValueKind.Array)Services=sv.EnumerateArray().ToList(); var p=await Core.GetAsync($"api/v1/orders/{id}/pricing",s.Value.Token,s.Value.Company,default); if(p.IsSuccess){Pricing=p.Value;HasPricing=true;}else if(p.ProblemCode is not null){Errors=[PricingError(p.ProblemCode,p.ProblemDescription)];} Loading=false; }
    private async Task Validate(){if(OrderId is not Guid id)return;var s=await Session();if(s is null)return;Busy=true;Errors=[];var r=await Core.GetAsync($"api/v1/orders/{id}/validation",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Errors=[S["FinalizeFailed"]];}else if(r.Value.ValueKind==JsonValueKind.Array){foreach(var issue in r.Value.EnumerateArray()){var code=Text(issue,"code","");Errors.Add(code switch{"order.item_required"=>S["ItemsRequired"],"order.invalid_product"=>S["ProductIssue"],"order.invalid_shipping_address"=>S["ShippingIssue"],"order.invalid_quantity"=>QuantityIssue(),_=>S["GenericIssue"]});}if(Errors.Count==0)SuccessMessage=S["ValidationPassed"];}Busy=false;}
    private string QuantityIssue()=>System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"ar"=>"يجب أن تكون الكمية أكبر من صفر.","en"=>"Quantity must be greater than zero.",_=>"تعداد باید بیشتر از صفر باشد."};
    private static IEnumerable<JsonElement> PrintOperations(JsonElement item)=>item.TryGetProperty("printOperations",out JsonElement p)&&p.ValueKind==JsonValueKind.Array?p.EnumerateArray():Array.Empty<JsonElement>();
    private string PositionText(string value)=>value switch{"FRONT"=>R["Front"],"BACK"=>R["Back"],"SLEEVE"=>R["Sleeve"],"OTHER"=>R["Other"],_=>R["None"]};
    private string SourceText(JsonElement print)=>print.TryGetProperty("artworkVersionId",out JsonElement artwork)&&artwork.ValueKind==JsonValueKind.String&&!string.IsNullOrWhiteSpace(artwork.GetString())?R["DesignBank"]:print.TryGetProperty("fileVersionId",out JsonElement file)&&file.ValueKind==JsonValueKind.String&&!string.IsNullOrWhiteSpace(file.GetString())?R["UploadedFile"]:R["None"];
    private async Task Finalize(){if(OrderId is not Guid id)return;var s=await Session();if(s is null)return;Busy=true;Errors=[];var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/orders/{id}/submit",new{version=Long(Order,"version")},s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){
        // A transport failure can arrive after the atomic transaction committed. Re-read the authoritative order before showing failure.
        var reread=await Core.GetAsync($"api/v1/orders/{id}",s.Value.Token,s.Value.Company,default);
        if(reread.IsSuccess && string.Equals(Text(reread.Value,"status",""),"Submitted",StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(Text(reread.Value,"orderNumber",""))){
            SuccessMessage=$"{S["Finalized"]} {S["OrderNumber"]}: {Text(reread.Value,"orderNumber","")}";Busy=false;Confirming=false;await Task.Delay(300);Navigation.NavigateTo($"/orders/{id}/360");return;
        }
        Errors=[Map(r.ProblemCode,r.ProblemDescription)];Busy=false;Confirming=false;return;}
    SuccessMessage=$"{S["Finalized"]} {S["OrderNumber"]}: {Text(r.Value,"orderNumber","")}";Busy=false;Confirming=false;await Task.Delay(300);Navigation.NavigateTo($"/orders/{id}/360");}
    private string Map(string? code,string? context=null)=>code switch{"order.incomplete"=>S["FinalizeFailed"],"pricing.order.concurrency"=>S["PricingStale"],"order.invalid_shipping_address"=>S["ShippingIssue"],"pricing.tariff.missing"=>PricingError(code,context),"pricing.currency_mismatch"=>PricingError(code,context),"pricing.product_price.missing"=>PricingError(code,context),"pricing.print_tariff.missing"=>PricingError(code,context),"pricing.service_tariff.missing"=>PricingError(code,context),"pricing.packaging_tariff.missing"=>PricingError(code,context),"pricing.shipping_tariff.missing"=>PricingError(code,context),_=>S["FinalizeFailed"]};
    private string PricingError(string code,string? context=null){if(code=="pricing.product_price.missing"){Dictionary<string,string> values=(context??string.Empty).Split('|',StringSplitOptions.RemoveEmptyEntries).Select(x=>x.Split(':',2)).Where(x=>x.Length==2).ToDictionary(x=>x[0],x=>x[1],StringComparer.OrdinalIgnoreCase);string product=values.GetValueOrDefault("product",S["NoData"]);string sku=values.GetValueOrDefault("sku","");string label=string.IsNullOrWhiteSpace(sku)?$"«{product}»":$"«{product} / {sku}»";return System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"ar"=>$"لا يوجد سعر بيع نشط لـ{label}.","en"=>$"No active sales price exists for {label}.", _=>$"برای {label} قیمت فروش فعال تعریف نشده است."};}return System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch{"ar"=>code=="pricing.currency_mismatch"?"تستخدم مكونات الطلب عملات مختلفة.":"لم يتم العثور على إعداد تسعير نشط للمكوّن المتأثر.","en"=>code=="pricing.currency_mismatch"?"Order components use different currencies.":"No active pricing configuration was found for the affected component.",_=>code=="pricing.currency_mismatch"?"ارز مؤلفه‌های سفارش یکسان نیست.":"برای مؤلفه مربوط به سفارش تنظیمات قیمت‌گذاری فعال یافت نشد."};}
    private string PriorityText(string value)=>value switch{"Important"=>P["Important"],"Urgent"=>P["Urgent"],_=>P["Normal"]};
    private Task Back()=>BackRequested.InvokeAsync();
    private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
    private string Text(string name,string fallback="")=>Text(Order,name,fallback); private string Text(string parent,string name,string fallback)=>Text(Order,parent,name,fallback); private static string Text(JsonElement x,string name,string fallback="")=>x.ValueKind==JsonValueKind.Object&&x.TryGetProperty(name,out var p)&&p.ValueKind!=JsonValueKind.Null?p.ToString():fallback; private static string Text(JsonElement x,string parent,string name,string fallback)=>x.TryGetProperty(parent,out var p)?Text(p,name,fallback):fallback; private string DisplayDate(string value)=>Dates.TryParseCanonical(value,out var date)?Dates.Format(date,System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName):S["NoData"]; private static long Long(JsonElement x,string n)=>long.TryParse(Text(x,n,"0"),out var v)?v:0; private static string ItemText(JsonElement x)=>x.TryGetProperty("snapshot",out var s)?$"{Text(s,"productName",Text(x,"productId","—"))} · {Text(s,"variantSku",Text(x,"productVariantId","—"))}":Text(x,"productId","—"); private static string PrintCount(JsonElement x)=>x.TryGetProperty("printOperations",out var p)&&p.ValueKind==JsonValueKind.Array?p.GetArrayLength().ToString():"0";
}
