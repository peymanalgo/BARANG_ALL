@using System.Globalization
@using System.Text.Json
@inject IStringLocalizer<CrudStrings> T
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<CustomerStrings> C
@inject IStringLocalizer<ReferenceStrings> R
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILogger<ReferenceValueGrid> Logger

<section class="crud-card" data-reference-type="@TypeCode">
    <header class="section-header"><h2>@Caption</h2>@if(CanManage){<button type="button" class="btn btn-primary btn-small" @onclick="Create"><BarangIcon Name="plus" /> @T["Add"]</button>}</header>
    <p class="reference-scope-note">@R[Global?"GlobalScope":"CompanyScope"]</p>
    @if(Message is not null&&!Dialog&&!DeleteDialog){<div class="@(Success?"inline-success":"inline-error")" role="status">@Message</div>}
    <div class="crud-toolbar">
        <label class="search-box"><input value="@Search" @oninput="SearchChanged" placeholder="@T["SearchHint"]" aria-label="@T["SearchHint"]" /></label>
        <button type="button" class="btn btn-secondary" disabled="@Loading" @onclick="ResetGrid"><BarangIcon Name="reset" /> @T["Reset"]</button>
    </div>
    @if(Loading){<BarangLoadingState Text="@T["Loading"]" />}
    else if(!Rows.Any()){<CrudEmptyState />}
    else
    {
        <div class="data-grid-wrap"><table class="data-grid">
            <thead><tr>@foreach(string column in new[]{"Code","Name","Status"}){<th><BarangSortHeader Label="@T[column]" Active="@(Sort==column)" Descending="Descending" Clicked="()=>ChangeSort(column)" /></th>}<th>@L["DisplayOrder"]</th><th>@T["Actions"]</th></tr></thead>
            <tbody>@foreach(var row in PagedRows){<tr @key="row.Id" data-id="@row.Id">
                <td dir="ltr">@row.Code</td><td>@row.Caption(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)</td><td><StatusBadge Active="row.Active" /></td><td>@row.Order</td>
                <td><BarangActionMenu @key="row.Id.ToString()+row.Active.ToString()+row.Version.ToString()"><BarangIconButton Icon="eye" Label="@T["View"]" Semantic="info" Clicked="()=>Open(row,true)" />
                    @if(CanManage&&!row.System){<BarangIconButton Icon="edit" Label="@T["Edit"]" Semantic="edit" Clicked="()=>Open(row,false)" /><BarangIconButton Icon="power" Label="@(row.Active?T["Deactivate"]:T["Activate"])" Semantic="@(row.Active?"warning":"success")" Clicked="()=>Activate(row)" /><BarangIconButton Icon="trash" Label="@T["Delete"]" Semantic="danger" Clicked="()=>AskDelete(row)" />}
                </BarangActionMenu></td></tr>}</tbody>
        </table></div>
        <BarangPagination Page="Page" HasNext="@(Filtered.Count>Page*PageSize)" Disabled="Loading" PageLabel="" PreviousText="@C["Previous"]" NextText="@C["Next"]" Previous="Previous" Next="Next" />
    }
</section>
<BarangModal Open="Dialog" Title="@(ReadOnly?T["View"]:EditingId is null?T["Add"]:T["Edit"])" Size="large" Busy="Busy" CloseLabel="@T["Close"]" CloseRequested="Close">
    <ChildContent>
        @if(Message is not null&&!Success){<div class="inline-error" role="alert">@Message</div>}
        <section class="reference-editor"><fieldset disabled="@(ReadOnly||Busy)"><div class="form-grid">
            <label><span>@T["Code"] *</span><input name="reference-code" dir="ltr" @bind="Code" disabled="@(EditingId is not null)" /></label>
            <label><span>@L["DisplayOrder"]</span><input type="number" name="reference-order" @bind="Order" /></label>
            @foreach(string culture in Cultures){<label><span>@T["Name"] (@culture) *</span><input name="@($"reference-name-{culture}")" dir="@(culture=="en"?"ltr":"rtl")" value="@Names[culture]" @onchange="e=>Names[culture]=e.Value?.ToString()??string.Empty" /></label>
                <label><span>@R["Description"] (@culture)</span><textarea name="@($"reference-description-{culture}")" dir="@(culture=="en"?"ltr":"rtl")" value="@Descriptions[culture]" @onchange="e=>Descriptions[culture]=e.Value?.ToString()??string.Empty"></textarea></label>}
            @if(IsDefect){<label><span>@R["DefectCategory"] *</span><ReferenceSelect TypeCode="defect.category" UseCode="true" Name="reference-category" @bind-Value="CategoryCode" Disabled="@(ReadOnly||Busy)" /></label><label><span>@R["Severity"]</span><select name="reference-severity" @bind="Severity">@foreach(string severity in new[]{"Minor","Major","Critical"}){<option value="@severity">@R[severity]</option>}</select></label><label class="check-field"><input name="reference-blocking" type="checkbox" @bind="Blocking" /><span>@R["Blocking"]</span></label>}
            <label class="check-field"><input type="checkbox" @bind="Active" disabled="@(EditingId is null)" /><span>@T["Active"]</span></label>
        </div></fieldset></section>
    </ChildContent>
    <Footer><button type="button" class="btn btn-secondary" disabled="@Busy" @onclick="Close">@T["Cancel"]</button>@if(!ReadOnly){<button type="button" class="btn btn-primary" disabled="@Busy" @onclick="Save">@T["Save"]</button>}</Footer>
</BarangModal>
<BarangModal Open="DeleteDialog" Title="@T["Delete"]" Busy="Busy" CloseLabel="@T["Close"]" CloseRequested="CloseDelete">
    <ChildContent><p>@R["ConfirmDelete"]</p>@if(Message is not null&&!Success){<div class="inline-error" role="alert">@Message</div>}</ChildContent>
    <Footer><button type="button" class="btn btn-secondary" disabled="@Busy" @onclick="CloseDelete">@T["Cancel"]</button><button type="button" class="btn btn-danger" disabled="@Busy" @onclick="Delete">@T["Delete"]</button></Footer>
</BarangModal>
@code {
    [Parameter,EditorRequired] public string TypeCode { get; set; }="";
    [Parameter,EditorRequired] public string Caption { get; set; }="";
    [Parameter] public bool Global { get; set; }
    [Parameter] public bool CanManage { get; set; }
    private bool IsAdapter=>TypeCode is "artwork.tag" or "defect.type";
    private bool IsDefect=>TypeCode=="defect.type";
    private string ValuesPath=>IsAdapter?$"api/v1/reference-entities/{TypeCode}/values":$"api/v1/lookups/types/{TypeCode}/values";
    private string ValuePath(Guid? id)=>IsAdapter?$"{ValuesPath}/{id}":$"api/v1/lookups/values/{id}";
    private string CategoryCode="",Severity="Minor";
    private bool Blocking;
    private const int PageSize=20;
    private static readonly string[] Cultures=["fa","ar","en"];
    private List<Row> Rows=[];
    private string Search="",Sort="Code",Code="";
    private bool Descending,Loading,Busy,Dialog,DeleteDialog,ReadOnly,Success,Active=true;
    private int Page=1,Order;
    private Guid? EditingId;
    private long Version;
    private string? Message,Token;
    private Guid Company;
    private Dictionary<string,string> Names=Cultures.ToDictionary(x=>x,_=>"");
    private Dictionary<string,string> Descriptions=Cultures.ToDictionary(x=>x,_=>"");
    private List<Row> Filtered {
        get {
            var filtered=Rows.Where(x=>(x.Code+" "+string.Join(" ",x.Names.Values)).Contains(Search.Trim(),StringComparison.CurrentCultureIgnoreCase));
            Func<Row,string> key=Sort switch{"Name"=>x=>x.Caption(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName),"Status"=>x=>x.Active.ToString(),_=>x=>x.Code};
            return (Descending?filtered.OrderByDescending(key):filtered.OrderBy(key)).ThenBy(x=>x.Id).ToList();
        }
    }
    private IEnumerable<Row> PagedRows=>Filtered.Skip((Page-1)*PageSize).Take(PageSize);
    protected override async Task OnInitializedAsync(){var user=(await AuthState.GetAuthenticationStateAsync()).User;Token=user.FindFirst(AuthClaimTypes.AccessToken)?.Value;Guid.TryParse(user.FindFirst(AuthClaimTypes.CompanyId)?.Value,out Company);await Reload();}
    private async Task Reload(){
        if(Token is null)return;Loading=true;
        try
        {
            var result=await Core.GetAsync(ValuesPath,Token,Company,default);
            if(result.IsSuccess)
            {
                Rows=result.Value.EnumerateArray().Select(Parse).ToList();
                Message=null;
            }
            else if(result.ProblemCode=="lookup.type_not_found")Rows=[];
            else Show(result);
        }
        catch(Exception ex)
        {
            Logger.LogError(ex,"Reference values response could not be loaded or parsed for {TypeCode}",TypeCode);
            Rows=[];
            Success=false;
            Message=R["ReferenceLoadFailed"];
        }
        Page=Math.Clamp(Page,1,Math.Max(1,(Filtered.Count+PageSize-1)/PageSize));Loading=false;
    }
    private Task ResetGrid(){Search="";Sort="Code";Descending=false;Page=1;Message=null;return Reload();}
    private void SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";Page=1;}
    private void ChangeSort(string column){Descending=Sort==column&&!Descending;Sort=column;Page=1;}
    private void Previous(){if(Page>1)Page--;} private void Next(){if(Page*PageSize<Filtered.Count)Page++;}
    private void Create(){EditingId=null;Version=0;CategoryCode="";Severity="Minor";Blocking=false;Code="";Order=0;Active=true;Names=Cultures.ToDictionary(x=>x,_=>"");Descriptions=Cultures.ToDictionary(x=>x,_=>"");ReadOnly=false;Message=null;Dialog=true;}
    private void Open(Row row,bool readOnly){EditingId=row.Id;Version=row.Version;CategoryCode=row.Category;Severity=row.Severity;Blocking=row.Blocking;Code=row.Code;Order=row.Order;Active=row.Active;Names=Cultures.ToDictionary(x=>x,x=>row.Names.GetValueOrDefault(x,""));Descriptions=Cultures.ToDictionary(x=>x,x=>row.Descriptions.GetValueOrDefault(x,""));ReadOnly=readOnly;Message=null;Dialog=true;}
    private void Close(){if(!Busy)Dialog=false;} private void CloseDelete(){if(!Busy)DeleteDialog=false;}
    private void AskDelete(Row row){EditingId=row.Id;Version=row.Version;Message=null;DeleteDialog=true;}
    private async Task Save(){
        if(Busy||Token is null||!CanManage||ReadOnly)return;
        if(Cultures.Any(x=>string.IsNullOrWhiteSpace(Names[x]))){Message=R["NamesRequired"];Success=false;return;}
        Busy=true;
        object body=new {code=Code,displayOrder=Order,isActive=Active,translations=Names,descriptions=Descriptions,version=Version,categoryCode=CategoryCode,severity=Severity,isBlocking=Blocking};
        var result=await Core.SendAsync(EditingId is null?HttpMethod.Post:HttpMethod.Put,EditingId is null?ValuesPath:$"{ValuePath(EditingId)}/editor",body,Token,Company,default);
        Show(result);Busy=false;if(result.IsSuccess){Dialog=false;await Reload();}
    }
    private async Task Activate(Row row){if(Busy||Token is null||!CanManage)return;Busy=true;var result=await Core.SendAsync(HttpMethod.Post,$"{ValuePath(row.Id)}/activation",new{isActive=!row.Active,version=row.Version},Token,Company,default);Show(result);Busy=false;if(result.IsSuccess)await Reload();}
    private async Task Delete(){if(Busy||Token is null||!CanManage||EditingId is null)return;Busy=true;var result=await Core.SendAsync(HttpMethod.Delete,$"{ValuePath(EditingId)}?version={Version}",null,Token,Company,default);Show(result);Busy=false;if(result.IsSuccess){DeleteDialog=false;await Reload();}}
    private void Show(ApiResult<JsonElement> result){Success=result.IsSuccess;Message=result.IsSuccess?T["OperationSucceeded"]:result.ProblemCode switch{"lookup.value_referenced" or "organization.delete.protected_dependency"=>R["Referenced"],"lookup.system_record_protected"=>R["Protected"],_=>result.Failure switch{ApiFailure.Forbidden=>T["Forbidden"],ApiFailure.Conflict=>T["ConcurrencyConflict"],_=>T["ValidationError"]}};}
    private static Row Parse(JsonElement x){var translations=x.GetProperty("translations").EnumerateArray().ToArray();return new(x.GetProperty("id").GetGuid(),x.GetProperty("code").GetString()!,x.GetProperty("displayOrder").GetInt32(),x.GetProperty("isActive").GetBoolean(),x.GetProperty("isSystem").GetBoolean(),x.GetProperty("version").GetInt64(),translations.ToDictionary(t=>t.GetProperty("culture").GetString()!,t=>t.GetProperty("displayName").GetString()!),translations.ToDictionary(t=>t.GetProperty("culture").GetString()!,t=>t.TryGetProperty("description",out var d)&&d.ValueKind==JsonValueKind.String?d.GetString()!:""),x.TryGetProperty("categoryCode",out var category)?category.GetString()??"":"",x.TryGetProperty("severity",out var severity)?severity.GetString()??"Minor":"Minor",x.TryGetProperty("isBlocking",out var blocking)&&blocking.GetBoolean());}
    private sealed record Row(Guid Id,string Code,int Order,bool Active,bool System,long Version,Dictionary<string,string> Names,Dictionary<string,string> Descriptions,string Category,string Severity,bool Blocking){public string Caption(string culture)=>Names.GetValueOrDefault(culture,Names.GetValueOrDefault("fa",Code));}
}
