@using System.Globalization
@using System.Text.Json
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<section class="crud-card warehouse-transfer-section" data-transfer-grid>
    <header class="section-header"><div><h2>@T("انتقال بین انبارها", "التحويل بين المستودعات", "Warehouse Transfers")</h2><p>@T("انتقال دو مرحله‌ای و قابل ردیابی موجودی", "تحويل المخزون على مرحلتين مع تتبع كامل", "Two-step, traceable stock transfers")</p></div><button type="button" class="btn btn-primary" @onclick="New"><BarangIcon Name="plus" /> @T("افزودن انتقال", "إضافة تحويل", "Add transfer")</button></header>
    <div class="crud-toolbar"><label class="crud-search"><span>@T("جستجو", "بحث", "Search")</span><input value="@Search" @oninput="SearchChanged" placeholder="@T("جستجوی مرجع، انبار یا SKU", "بحث عن المرجع أو المستودع أو SKU", "Search reference, warehouse or SKU")" /></label><label class="compact-filter"><span>@T("وضعیت", "الحالة", "Status")</span><select value="@Status" @onchange="StatusChanged"><option value="">@T("همه", "الكل", "All")</option><option value="InTransit">@T("در حال انتقال", "قيد التحويل", "In transit")</option><option value="Completed">@T("تکمیل‌شده", "مكتمل", "Completed")</option><option value="Cancelled">@T("لغوشده", "ملغى", "Cancelled")</option></select></label><button type="button" class="btn btn-secondary" disabled="@Loading" @onclick="Reset"><BarangIcon Name="reset" /> @T("بازنشانی", "إعادة ضبط", "Reset")</button></div>
    @if (Message is not null) { <div class="@(Success ? "inline-success" : "inline-error")" role="@(Success ? "status" : "alert")">@Message</div> }
    @if (Loading) { <BarangLoadingState Text="@T("در حال بارگذاری…", "جار التحميل…", "Loading…")" /> }
    else if (Rows.Count == 0) { <CrudEmptyState Title="@T("انتقالی یافت نشد", "لم يتم العثور على تحويلات", "No transfers found")" /> }
    else { <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th><BarangSortHeader Label="@T("مرجع", "المرجع", "Reference")" Active="@(Sort == "reference")" Descending="Descending" Clicked='()=>ChangeSort("reference")' /></th><th><BarangSortHeader Label="@T("مبدأ", "المصدر", "Source")" Active="@(Sort == "source")" Descending="Descending" Clicked='()=>ChangeSort("source")' /></th><th><BarangSortHeader Label="@T("مقصد", "الوجهة", "Destination")" Active="@(Sort == "destination")" Descending="Descending" Clicked='()=>ChangeSort("destination")' /></th><th>@T("محصول / SKU", "منتج / SKU", "Product / SKU")</th><th>@T("مقدار", "الكمية", "Quantity")</th><th><BarangSortHeader Label="@T("وضعیت", "الحالة", "Status")" Active="@(Sort == "status")" Descending="Descending" Clicked='()=>ChangeSort("status")' /></th><th>@T("عملیات", "الإجراءات", "Actions")</th></tr></thead><tbody>@foreach (var row in Rows) { <tr><td dir="ltr">@row.Reference</td><td><strong>@row.SourceName</strong><small class="muted">@row.SourceCode</small></td><td><strong>@row.DestinationName</strong><small class="muted">@row.DestinationCode</small></td><td><strong>@row.ProductName</strong><small class="muted">@row.Sku</small></td><td dir="ltr">@row.Quantity.ToString("N2", CultureInfo.CurrentCulture) @row.UomCode</td><td><span class="status-badge">@StatusLabel(row.Status)</span></td><td><BarangActionMenu><BarangIconButton Icon="eye" Semantic="info" Label="@T("مشاهده", "عرض", "View")" Clicked="@(()=>Open(row))" />@if(IsInTransit(row.Status)){<BarangIconButton Icon="check" Semantic="success" Label="@T("تکمیل", "إكمال", "Complete")" Clicked="@(()=>Ask(row,"complete"))" /><BarangIconButton Icon="close" Semantic="danger" Label="@T("لغو", "إلغاء", "Cancel")" Clicked="@(()=>Ask(row,"cancel"))" />}</BarangActionMenu></td></tr> }</tbody></table></div><BarangPagination Page="@Page" HasNext="@(Page * PageSize < TotalCount)" Disabled="@Loading" PageLabel="" PreviousText="@T("قبلی", "السابق", "Previous")" NextText="@T("بعدی", "التالي", "Next")" Previous="Previous" Next="Next" /> }
</section>

<BarangModal Open="@Dialog" Title="@(ReadOnly ? T("جزئیات انتقال", "تفاصيل التحويل", "Transfer details") : T("افزودن انتقال", "إضافة تحويل", "Add transfer"))" Size="large" CloseRequested="Close">
    <ChildContent>
        @if (ReadOnly)
        {
            <dl class="detail-list"><dt>@T("مرجع", "المرجع", "Reference")</dt><dd dir="ltr">@Reference</dd><dt>@T("مبدأ", "المصدر", "Source")</dt><dd>@Source</dd><dt>@T("مقصد", "الوجهة", "Destination")</dt><dd>@Destination</dd><dt>@T("محصول", "المنتج", "Product")</dt><dd>@Product</dd><dt>SKU</dt><dd dir="ltr">@Variant</dd><dt>@T("مقدار", "الكمية", "Quantity")</dt><dd dir="ltr">@Quantity.ToString("N2", CultureInfo.CurrentCulture) @Uom</dd><dt>@T("وضعیت", "الحالة", "Status")</dt><dd>@StatusLabel(ViewStatus)</dd></dl>
        }
        else
        {
            <div class="form-grid"><label><span>@T("انبار مبدأ", "المستودع المصدر", "Source warehouse")</span><SearchableSelect Options="@WarehouseOptions" Value="@Source" ValueChanged="SetSource" Placeholder="@T("انتخاب انبار", "اختر المستودع", "Choose warehouse")" /></label><label><span>@T("انبار مقصد", "المستودع الوجهة", "Destination warehouse")</span><SearchableSelect Options="@WarehouseOptions" Value="@Destination" ValueChanged="SetDestination" Placeholder="@T("انتخاب انبار", "اختر المستودع", "Choose warehouse")" /></label><label><span>@T("محصول", "المنتج", "Product")</span><SearchableSelect Options="@ProductOptions" Value="@Product" ValueChanged="SetProduct" Placeholder="@T("انتخاب محصول", "اختر المنتج", "Choose product")" /></label><label><span>@T("SKU", "SKU", "SKU")</span><SearchableSelect Options="@VariantOptions" Value="@Variant" ValueChanged="SetVariant" Placeholder="@T("انتخاب SKU", "اختر SKU", "Choose SKU")" /></label><label><span>@T("مقدار", "الكمية", "Quantity")</span><input type="number" min="0.01" step="0.01" @bind="Quantity" /></label><label><span>@T("مرجع", "المرجع", "Reference")</span><input @bind="Reference" dir="ltr" /></label><label><span>@T("دلیل", "السبب", "Reason")</span><input @bind="Reason" /></label></div>
            @if (SourceAvailability is not null) { <div class="detail-list"><dt>@T("موجودی مبدأ", "مخزون المصدر", "Source availability")</dt><dd dir="ltr">@SourceAvailability.Value.ToString("N2", CultureInfo.CurrentCulture)</dd></div> }
        }
        @if (Error is not null) { <div class="inline-error" role="alert">@Error</div> }
    </ChildContent>
    <Footer><button type="button" class="btn btn-secondary" @onclick="Close">@T("انصراف", "إلغاء", "Cancel")</button>@if(!ReadOnly){<button type="button" class="btn btn-primary" @onclick="Start" disabled="@Busy">@T("شروع انتقال", "بدء التحويل", "Start transfer")</button>}</Footer>
</BarangModal>
<BarangConfirmDialog Open="@ConfirmOpen" Title="@ConfirmTitle" Description="@ConfirmDescription" CancelText="@T("انصراف", "إلغاء", "Cancel")" ConfirmText="@T("تأیید", "تأكيد", "Confirm")" Busy="@Busy" Cancel="CancelConfirm" Confirm="ConfirmAction" />

@code {
    private sealed record Row(Guid Id,string Reference,string SourceCode,string SourceName,string DestinationCode,string DestinationName,string ProductCode,string ProductName,string Sku,decimal Quantity,string UomCode,string Status,long Version);
    private string Search="",Status="",Sort="created",Source="",Destination="",Product="",Variant="",Reference="TR-"+Guid.NewGuid().ToString("N")[..10].ToUpperInvariant(),Reason="",Uom="",ViewStatus=""; private decimal Quantity=1; private int Page=1,TotalCount; private const int PageSize=20; private bool Loading,Dialog,ReadOnly,Success,Busy,ConfirmOpen; private string? Message,Error,ConfirmTitle,ConfirmDescription; private string ConfirmActionName=""; private decimal? SourceAvailability; private List<Row> Rows=[]; private List<SearchableSelectOption> WarehouseOptions=[],ProductOptions=[],VariantOptions=[]; private CancellationTokenSource? SearchCancellation;
    private string Lang=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; private bool Descending; private string T(string fa,string ar,string en)=>Lang switch{"en"=>en,"ar"=>ar,_=>fa};
    private string StatusLabel(string value)=>value switch{"InTransit" or "0"=>T("در حال انتقال","قيد التحويل","In transit"),"Completed" or "1"=>T("تکمیل‌شده","مكتمل","Completed"),"Cancelled" or "2"=>T("لغوشده","ملغى","Cancelled"),_=>value};
    private static bool IsInTransit(string value)=>value is "InTransit" or "0";
    protected override async Task OnInitializedAsync(){await LoadSelectors();await Load();}
    private async Task<(string Token,Guid Company)?>Session(){var u=await AuthState.GetAuthenticationStateAsync();return Guid.TryParse(u.User.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.User.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
    private async Task LoadSelectors(){var s=await Session();if(s is null)return;var w=await Core.GetAsync("api/v1/organization/warehouses?pageNumber=1&pageSize=100&sort=code",s.Value.Token,s.Value.Company,default);if(w.IsSuccess&&w.Value.TryGetProperty("items",out var wi))WarehouseOptions=wi.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("id").ToString(),$"{x.GetProperty("code")} - {x.GetProperty("name")}")).ToList();var p=await Core.GetAsync("api/v1/products?search=&pageSize=100&activeOnly=true",s.Value.Token,s.Value.Company,default);if(p.IsSuccess&&p.Value.TryGetProperty("items",out var pi))ProductOptions=pi.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("id").ToString(),$"{x.GetProperty("productCode")} - {x.GetProperty("name")}")).ToList();}
    private async Task Load(){Loading=true;Error=null;var s=await Session();if(s is null){Loading=false;return;}var status=string.IsNullOrWhiteSpace(Status)?"":"&status="+Status;var r=await Core.GetAsync($"api/v1/inventory/transfers?search={Uri.EscapeDataString(Search)}{status}&sort={Sort}&descending={Descending.ToString().ToLowerInvariant()}&pageNumber={Page}&pageSize={PageSize}",s.Value.Token,s.Value.Company,default);Rows=[];TotalCount=0;if(r.IsSuccess&&r.Value.TryGetProperty("items",out var items)){TotalCount=r.Value.TryGetProperty("totalCount",out var total)?total.GetInt32():0;Rows=items.EnumerateArray().Select(Parse).ToList();}else if(!r.IsSuccess)Error=T("دریافت انتقال‌ها انجام نشد.","تعذر تحميل التحويلات.","Transfers could not be loaded.");Loading=false;}
    private static Row Parse(JsonElement x)=>new(x.GetProperty("id").GetGuid(),x.GetProperty("reference").ToString(),x.GetProperty("sourceWarehouseCode").ToString(),x.GetProperty("sourceWarehouseName").ToString(),x.GetProperty("destinationWarehouseCode").ToString(),x.GetProperty("destinationWarehouseName").ToString(),x.GetProperty("productCode").ToString(),x.GetProperty("productName").ToString(),x.GetProperty("sku").ToString(),x.GetProperty("quantity").GetDecimal(),x.GetProperty("uomCode").ToString(),x.GetProperty("status").ValueKind==JsonValueKind.Number?x.GetProperty("status").GetInt32().ToString(CultureInfo.InvariantCulture):x.GetProperty("status").ToString(),x.GetProperty("version").GetInt64());
    private async Task SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";Page=1;SearchCancellation?.Cancel();SearchCancellation?.Dispose();SearchCancellation=new();try{await Task.Delay(250,SearchCancellation.Token);await Load();}catch(OperationCanceledException){}}
    private Task StatusChanged(ChangeEventArgs e){Status=e.Value?.ToString()??"";Page=1;return Load();} private Task Reset(){Search=Status="";Sort="created";Descending=false;Page=1;Message=null;Error=null;return Load();} private Task ChangeSort(string sort){if(Sort==sort)Descending=!Descending;else{Sort=sort;Descending=false;}Page=1;return Load();} private Task Previous(){if(Page>1){Page--;return Load();}return Task.CompletedTask;} private Task Next(){if(Page*PageSize<TotalCount){Page++;return Load();}return Task.CompletedTask;}
    private void New(){ReadOnly=false;Dialog=true;Message=Error=null;Source=Destination=Product=Variant="";VariantOptions=[];Quantity=1;Reference="TR-"+Guid.NewGuid().ToString("N")[..10].ToUpperInvariant();Reason="";SourceAvailability=null;}
    private void Open(Row row){ReadOnly=true;Dialog=true;Error=null;Reference=row.Reference;Source=$"{row.SourceCode} - {row.SourceName}";Destination=$"{row.DestinationCode} - {row.DestinationName}";Product=$"{row.ProductCode} - {row.ProductName}";Variant=row.Sku;Quantity=row.Quantity;Uom=row.UomCode;ViewStatus=row.Status;}
    private void Close()=>Dialog=false;
    private async Task SetSource(string value){Source=value;await LoadAvailability();} private async Task SetDestination(string value){Destination=value;await Task.CompletedTask;} private async Task SetProduct(string value){Product=value;Variant="";var s=await Session();if(s is null||!Guid.TryParse(Product,out var id)){VariantOptions=[];return;}var r=await Core.GetAsync($"api/v1/products/{id}/variants/options?limit=100",s.Value.Token,s.Value.Company,default);VariantOptions=r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array?r.Value.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("id").ToString(),x.TryGetProperty("sku",out var sku)?sku.ToString():x.ToString())).ToList():[];}
    private async Task SetVariant(string value){Variant=value;await LoadAvailability();} private async Task LoadAvailability(){SourceAvailability=null;var s=await Session();if(s is null||!Guid.TryParse(Source,out var w)||!Guid.TryParse(Variant,out var v))return;var r=await Core.GetAsync($"api/v1/inventory/balances?warehouseId={w}&variantId={v}&pageNumber=1&pageSize=1",s.Value.Token,s.Value.Company,default);if(r.IsSuccess&&r.Value.TryGetProperty("items",out var items)&&items.GetArrayLength()>0)SourceAvailability=items[0].GetProperty("available").GetDecimal();}
    private void OpenConfirm(string action){ConfirmActionName=action;ConfirmTitle=action=="complete"?T("تکمیل انتقال","إكمال التحويل","Complete transfer"):T("لغو انتقال","إلغاء التحويل","Cancel transfer");ConfirmDescription=action=="complete"?T("موجودی به انبار مقصد وارد شود؟","هل تريد إدخال المخزون إلى المستودع الوجهة؟","Post stock into the destination warehouse?"):T("انتقال در حال انجام لغو شود؟ موجودی مبدأ خودکار برنمی‌گردد.","هل تريد إلغاء التحويل؟ لن يُعاد مخزون المصدر تلقائيا.","Cancel this in-transit transfer? Source stock is not restored automatically.");ConfirmOpen=true;}
    private void Ask(Row row,string action){Reference=row.Reference;SelectedId=row.Id;SelectedVersion=row.Version;OpenConfirm(action);} private Guid SelectedId; private long SelectedVersion;
    private Task ConfirmAction()=>ConfirmActionName=="complete"?Complete():CancelTransfer(); private void CancelConfirm(){ConfirmOpen=false;}
    private async Task Start(){if(!Guid.TryParse(Source,out var source)||!Guid.TryParse(Destination,out var destination)||!Guid.TryParse(Variant,out var variant)||Quantity<=0){Error=T("مبدأ، مقصد، SKU و مقدار معتبر الزامی است.","المصدر والوجهة وSKU والكمية مطلوبة.","Source, destination, SKU and a positive quantity are required.");return;}if(source==destination){Error=T("انبار مبدأ و مقصد باید متفاوت باشند.","يجب أن يختلف المصدر عن الوجهة.","Source and destination must differ.");return;}if(!await JS.InvokeAsync<bool>("confirm",T("انتقال شروع شود؟", "بدء التحويل؟", "Start transfer?")))return;Busy=true;var s=await Session();if(s is null){Busy=false;return;}var r=await Core.SendAsync(HttpMethod.Post,"api/v1/inventory/transfers",new{sourceWarehouseId=source,destinationWarehouseId=destination,productVariantId=variant,quantity=Quantity,reference=Reference},s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("انتقال شروع شد.","بدأ التحويل.","Transfer started."):T("شروع انتقال انجام نشد.","تعذر بدء التحويل.","Transfer could not be started.");if(!r.IsSuccess)Error=Message;else{Dialog=false;await Load();}Busy=false;}
    private async Task Complete(){ConfirmOpen=false;Busy=true;var s=await Session();if(s is null){Busy=false;return;}var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/inventory/transfers/{SelectedId}/complete",new{version=SelectedVersion},s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("انتقال تکمیل شد.","اكتمل التحويل.","Transfer completed."):T("تکمیل انتقال انجام نشد.","تعذر إكمال التحويل.","Transfer could not be completed.");if(r.IsSuccess)await Load();Busy=false;}
    private async Task CancelTransfer(){ConfirmOpen=false;Busy=true;var s=await Session();if(s is null){Busy=false;return;}var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/inventory/transfers/{SelectedId}/cancel",new{version=SelectedVersion,reason=Reason},s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("انتقال لغو شد.","تم إلغاء التحويل.","Transfer cancelled."):T("لغو انتقال انجام نشد.","تعذر إلغاء التحويل.","Transfer could not be cancelled.");if(r.IsSuccess)await Load();Busy=false;}
}
