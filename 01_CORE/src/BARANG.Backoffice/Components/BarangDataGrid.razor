<section class="crud-card barang-data-grid @Class">
    @if (Toolbar is not null) { <div class="crud-toolbar">@Toolbar</div> }
    @if (Loading) { <div class="crud-loading" role="status"><span class="spinner"></span>@LoadingText</div> }
    else if (Empty) { <CrudEmptyState Title="@EmptyTitle" Description="@EmptyDescription" /> }
    else
    {
        <div class="data-grid-wrap"><table class="data-grid"><thead>@Header</thead><tbody>@Rows</tbody></table></div>
    }
    @if (Footer is not null) { <footer class="barang-grid-footer">@Footer</footer> }
</section>
@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Empty { get; set; }
    [Parameter] public string? LoadingText { get; set; }
    [Parameter] public string? EmptyTitle { get; set; }
    [Parameter] public string? EmptyDescription { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Toolbar { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Rows { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
}
