@implements IDisposable
@inject IStringLocalizer<CrudStrings> T

<div @key="OptionKey" class="searchable-select" @onfocusin="CancelBlurFromFocus" @onfocusout="HandleBlur">
    <input name="@Name"
           value="@DisplayText"
           data-selected-value="@Value"
           disabled="@Disabled"
           placeholder="@Placeholder"
           autocomplete="off"
           role="combobox"
           aria-expanded="@Open"
           aria-controls="@ListId"
           aria-label="@AriaLabel"
           aria-autocomplete="list"
           @onfocus="OpenList"
           @oninput="Filter"
           @onchange="Filter"
           @onkeydown="HandleKey" />
    @if (Open && !Disabled)
    {
        <div class="searchable-select-list" id="@ListId" role="listbox">
            @if (!Filtered.Any())
            {
                <div class="searchable-select-empty">@T["NoOptions"]</div>
            }
            else
            {
                @foreach (var item in Filtered.Select((option, index) => (option, index)))
                {
                    <button @key="item.option.Value"
                            type="button"
                            role="option"
                            aria-selected="@(item.option.Value == Value)"
                            class="@(item.index == Highlighted ? "highlighted" : null)"
                            @onmousedown:preventDefault
                            @onclick="() => Select(item.option)">@item.option.Label</button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<SearchableSelectOption> Options { get; set; } = [];
    [Parameter] public string? Name { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public EventCallback<string> SearchChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string Query = "";
    private string OptionKey => $"{Value}:{Options.Count}:{Options.FirstOrDefault()?.Value}";
    private CancellationTokenSource? SearchDelay;
    private CancellationTokenSource? BlurDelay;
    private bool Open;
    private int Highlighted;
    private readonly string ListId = $"select-{Guid.NewGuid():N}";
    private string DisplayText => Open ? Query : Options.FirstOrDefault(option => option.Value == Value)?.Label ?? "";
    private IReadOnlyList<SearchableSelectOption> Filtered => string.IsNullOrWhiteSpace(Query)
        ? Options
        : Options.Where(option => option.Label.Contains(Query.Trim(), StringComparison.CurrentCultureIgnoreCase)).ToArray();

    private void OpenList()
    {
        CancelBlur();
        Query = Options.FirstOrDefault(option => option.Value == Value)?.Label ?? "";
        Highlighted = 0;
        Open = true;
    }

    private async Task Filter(ChangeEventArgs args)
    {
        CancelBlur();
        Query = args.Value?.ToString() ?? "";
        Highlighted = 0;
        Open = true;
        if (!SearchChanged.HasDelegate) return;

        SearchDelay?.Cancel();
        SearchDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, SearchDelay.Token);
            await SearchChanged.InvokeAsync(Query);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task Select(SearchableSelectOption option)
    {
        CancelBlur();
        Value = option.Value;
        Query = option.Label;
        await ValueChanged.InvokeAsync(Value);
        await InvokeAsync(StateHasChanged);
        Open = false;
    }

    private void HandleBlur(FocusEventArgs args)
    {
        CancelBlur();
        BlurDelay = new CancellationTokenSource();
        _ = CloseAfterBlur(BlurDelay.Token);
    }

    private void CancelBlurFromFocus(FocusEventArgs _) => CancelBlur();

    private async Task CloseAfterBlur(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(150, cancellationToken);
            Open = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelBlur()
    {
        BlurDelay?.Cancel();
        BlurDelay?.Dispose();
        BlurDelay = null;
    }

    private async Task HandleKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CancelBlur();
            Open = false;
            return;
        }

        if (!Open) Open = true;
        if (args.Key == "ArrowDown") Highlighted = Math.Min(Highlighted + 1, Math.Max(0, Filtered.Count - 1));
        else if (args.Key == "ArrowUp") Highlighted = Math.Max(0, Highlighted - 1);
        else if (args.Key == "Enter" && Filtered.Count > 0) await Select(Filtered[Highlighted]);
    }

    public void Dispose()
    {
        SearchDelay?.Cancel();
        SearchDelay?.Dispose();
        CancelBlur();
    }
}
