@if (Breadcrumb is not null) { @Breadcrumb }
<header class="barang-page-header @Class">
    <div>
        @if (!string.IsNullOrWhiteSpace(Eyebrow)) { <span class="eyebrow">@Eyebrow</span> }
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description)) { <p>@Description</p> }
    </div>
    @if (Actions is not null) { <div class="barang-page-actions">@Actions</div> }
</header>
@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Breadcrumb { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
