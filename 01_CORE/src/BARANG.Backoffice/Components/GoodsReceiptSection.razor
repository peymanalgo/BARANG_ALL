@using System.Globalization
@using System.Text.Json
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject LocaleDateService Dates
@rendermode InteractiveServer

<section class="crud-card goods-receipt-section" data-goods-receipt-grid>
    <header class="section-header"><div><h2>@T("رسید کالا","إيصالات الاستلام","Goods Receipts")</h2><p>@T("ثبت فیزیکی کالا بر اساس سفارش خرید","تسجيل الاستلام الفعلي بناءً على أمر الشراء","Record physical receipt against a purchase order")</p></div><button class="btn btn-primary" type="button" @onclick="New">@T("افزودن رسید کالا","إضافة إيصال استلام","Add goods receipt")</button></header>
    <div class="crud-toolbar"><label class="crud-search"><span>@T("جستجو","بحث","Search")</span><input value="@Search" @oninput="SearchChanged" placeholder="@T("شماره رسید یا سفارش","رقم الإيصال أو الأمر","Receipt or PO number")" /></label><button class="btn btn-secondary" type="button" @onclick="Reset">@T("بازنشانی","إعادة ضبط","Reset")</button></div>
    @if (Message is not null) { <div class="@(Success ? "inline-success" : "inline-error")" role="status">@Message</div> }
    @if (Loading) { <div class="crud-loading">@T("در حال بارگذاری","جار التحميل","Loading")</div> }
    else if (Rows.Count == 0) { <div class="crud-empty">@T("رسیدی وجود ندارد.","لا توجد إيصالات.","No goods receipts found.")</div> }
    else { <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("شماره رسید","رقم الإيصال","Receipt")</th><th>@T("سفارش خرید","أمر الشراء","Purchase order")</th><th>@T("مقدار","الكمية","Quantity")</th><th>@T("تاریخ","التاريخ","Date")</th><th>@T("وضعیت","الحالة","Status")</th><th>@T("عملیات","الإجراءات","Actions")</th></tr></thead><tbody>@foreach (var row in Rows) { <tr><td>@row.Number</td><td>@row.PoNumber</td><td>@row.Quantity</td><td>@Dates.Format(row.Date.Date, Lang)</td><td>@Status(row.Status)</td><td ><BarangActionMenu><BarangIconButton Icon="eye" Semantic="info" Label='@T("مشاهده","عرض","View")' Clicked="@(() => Open(row, true))" />@if (row.Status == "Draft") { <BarangIconButton Icon="edit" Semantic="edit" Label='@T("ویرایش","تحرير","Edit")' Clicked="@(() => Open(row, false))" /><BarangIconButton Icon="check" Semantic="success" Label='@T("ثبت نهایی","ترحيل","Post")' Clicked="@(() => Post(row))" /><BarangIconButton Icon="trash" Semantic="danger" Label='@T("حذف","حذف","Delete")' Clicked="@(() => Delete(row))" />}</BarangActionMenu></td></tr> }</tbody></table></div><BarangPagination Page="@Page" HasNext="@(Rows.Count == PageSize)" Disabled="@Loading" PageLabel="" PreviousText="@T("قبلی","السابق","Previous")" NextText="@T("بعدی","التالي","Next")" Previous="Prev" Next="Next" /> }
</section>

<BarangModal Open="@Dialog" Title="@(ReadOnly ? T("مشاهده رسید کالا","عرض إيصال الاستلام","View goods receipt") : T("افزودن رسید کالا","إضافة إيصال استلام","Add goods receipt"))" Size="large" CloseRequested="Close">
    <ChildContent>
        @if (FormError is not null) { <div class="inline-error" role="alert" aria-live="assertive">@FormError</div> }
        <section class="editor-section"><h3>@T("اطلاعات عمومی","المعلومات العامة","General")</h3><div class="form-grid"><label><span>@T("سفارش خرید","أمر الشراء","Purchase order")</span><SearchableSelect Name="goods-receipt-po" Options="@PurchaseOrders" Value="@PurchaseOrderId" ValueChanged="PoChanged" Disabled="@(ReadOnly || Editing is not null)" /></label><label><span>@T("تاریخ رسید","تاريخ الاستلام","Receipt date")</span><LocaleDateInput Name="goods-receipt-date" Value="@ReceiptDate" ValueChanged="@(v => ReceiptDate = v ?? ReceiptDate)" Disabled="@ReadOnly" /></label><label><span>@T("شماره حواله تأمین‌کننده","رقم إشعار المورد","Supplier delivery note")</span><input @bind="Reference" disabled="@ReadOnly" /></label><label class="span-2"><span>@T("یادداشت","ملاحظات","Notes")</span><textarea @bind="Notes" disabled="@ReadOnly"></textarea></label></div></section>
        @if (PoInfo is not null) { <section class="editor-section"><h3>@T("اطلاعات سفارش","بيانات الأمر","Purchase order data")</h3><p>@T("تأمین‌کننده و انبار از سفارش خرید بارگذاری شده‌اند.","تم تحميل المورد والمستودع من أمر الشراء.","Supplier and warehouse are loaded from the purchase order.")</p><dl><dt>@T("تأمین‌کننده","المورد","Supplier")</dt><dd>@PoInfo.Supplier</dd><dt>@T("انبار","المستودع","Warehouse")</dt><dd>@PoInfo.Warehouse</dd></dl></section> }
        <section class="editor-section"><h3>@T("ردیف‌های رسید","بنود الإيصال","Receipt lines")</h3><table class="data-grid"><thead><tr><th>@T("شناسه ردیف سفارش","بند الأمر","PO line")</th><th>@T("سفارش‌شده","المطلوب","Ordered")</th><th>@T("قبلاً دریافت‌شده","المستلم سابقاً","Previously received")</th><th>@T("باقی‌مانده","المتبقي","Remaining")</th><th>@T("مقدار فعلی","الكمية الحالية","Current quantity")</th></tr></thead><tbody>@foreach (var line in Lines) { <tr><td>@line.Label</td><td>@line.Ordered</td><td>@line.Received</td><td>@(line.Ordered - line.Received)</td><td><input type="number" min="0" step="0.01" @bind="line.Quantity" @bind:event="oninput" disabled="@ReadOnly" /></td></tr> }</tbody></table></section>
    </ChildContent>
    <Footer><button class="btn btn-secondary" type="button" @onclick="Close">@T("انصراف","إلغاء","Cancel")</button>@if (!ReadOnly) { <button class="btn btn-primary" type="button" @onclick="PostNew">@T("ثبت رسید","ترحيل الإيصال","Post receipt")</button> }</Footer>
</BarangModal>

@code {
    private sealed class Row { public Guid Id; public string Number="",PoNumber="",Status=""; public decimal Quantity; public DateTimeOffset Date; public long Version; }
    private sealed class Line { public Guid Id; public string Label=""; public decimal Ordered,Received,Quantity; }
    private sealed record PurchaseOrderInfo(string Supplier,string Warehouse);
    private string Search="", PurchaseOrderId="", Reference="", Notes=""; private DateOnly ReceiptDate=DateOnly.FromDateTime(DateTime.Today); private int Page=1; private const int PageSize=20; private bool Loading,Dialog,ReadOnly,Success; private string? Message,FormError; private Guid? Editing; private long Version; private List<Row> Rows=[]; private List<Line> Lines=[]; private List<SearchableSelectOption> PurchaseOrders=[]; private PurchaseOrderInfo? PoInfo; private CancellationTokenSource? SearchCancel; private string Lang=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    private string T(string fa,string ar,string en)=>Lang switch {"ar"=>ar,"en"=>en,_=>fa}; private string Status(string x)=>x switch {"Draft"=>T("پیش‌نویس","مسودة","Draft"),"Posted"=>T("ثبت‌شده","مرحّل","Posted"),_=>x}; private static string P(JsonElement x,string n)=>x.TryGetProperty(n,out var v)?v.ToString():"";
    protected override async Task OnInitializedAsync(){await LoadOrders();await Load();}
    private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
    private static JsonElement Items(JsonElement root)=>root.ValueKind==JsonValueKind.Object&&root.TryGetProperty("items",out var i)?i:root;
    private async Task LoadOrders(){var s=await Session();if(s is null)return;var r=await Core.GetAsync("api/v1/purchasing/orders?pageNumber=1&pageSize=100",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess)return;JsonElement a=Items(r.Value);if(a.ValueKind!=JsonValueKind.Array)return;PurchaseOrders=a.EnumerateArray().Where(x=>{var st=State(x);return st is "Sent" or "Submitted" or "PartiallyReceived";}).Select(x=>new SearchableSelectOption(P(x,"id"),P(x,"purchaseOrderNumber"))).ToList();}
    private async Task Load(){var s=await Session();if(s is null)return;Loading=true;var r=await Core.GetAsync("api/v1/purchasing/orders?pageNumber=1&pageSize=100",s.Value.Token,s.Value.Company,default);Rows=[];if(r.IsSuccess){var a=Items(r.Value);if(a.ValueKind==JsonValueKind.Array)foreach(var x in a.EnumerateArray()){var state=State(x);if(state is not ("Sent" or "PartiallyReceived" or "Received")||(!string.IsNullOrWhiteSpace(Search)&&!P(x,"purchaseOrderNumber").Contains(Search,StringComparison.OrdinalIgnoreCase)))continue;decimal received=x.TryGetProperty("items",out var lines)&&lines.ValueKind==JsonValueKind.Array?lines.EnumerateArray().Sum(q=>q.TryGetProperty("receivedQuantity",out var v)?v.GetDecimal():0):0;Rows.Add(new(){Id=Guid.Parse(P(x,"id")),Number=$"RECEIPT/{P(x,"purchaseOrderNumber")}",PoNumber=P(x,"purchaseOrderNumber"),Quantity=received,Date=DateTimeOffset.TryParse(P(x,"createdAtUtc"),out var d)?d:DateTimeOffset.UtcNow,Status=state,Version=x.TryGetProperty("version",out var ver)?ver.GetInt64():0});}}else Message=T("دریافت سفارش‌های خرید انجام نشد.","تعذر تحميل أوامر الشراء.","Purchase orders could not be loaded.");Loading=false;}
    private static string State(JsonElement x){var s=P(x,"status");return int.TryParse(s,out var n)?n switch{0=>"Draft",1=>"Submitted",2=>"Approved",3=>"Rejected",4=>"Sent",5=>"PartiallyReceived",6=>"Received",7=>"Closed",8=>"Cancelled",_=>s}:s;}
    private async Task PoChanged(string value){PurchaseOrderId=value;Lines=[];PoInfo=null;FormError=null;if(Guid.TryParse(value,out _))await LoadPo();}
    private async Task LoadPo(){var s=await Session();if(s is null||!Guid.TryParse(PurchaseOrderId,out var id))return;var r=await Core.GetAsync("api/v1/purchasing/orders?pageNumber=1&pageSize=100",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){FormError=T("سفارش خرید برای دریافت معتبر نیست.","أمر الشراء غير صالح للاستلام.","Purchase order is not eligible for receipt.");return;}JsonElement orders=Items(r.Value);JsonElement x=orders.ValueKind==JsonValueKind.Array?orders.EnumerateArray().FirstOrDefault(o=>Guid.TryParse(P(o,"id"),out var value)&&value==id):default;if(x.ValueKind!=JsonValueKind.Object){FormError=T("سفارش خرید برای دریافت معتبر نیست.","أمر الشراء غير صالح للاستلام.","Purchase order is not eligible for receipt.");return;}PoInfo=new(P(x,"supplierId"),P(x,"warehouseId"));Lines=[];if(x.TryGetProperty("items",out var items)&&items.ValueKind==JsonValueKind.Array)foreach(var i in items.EnumerateArray())Lines.Add(new(){Id=Guid.Parse(P(i,"id")),Label=P(i,"productVariantId"),Ordered=decimal.Parse(P(i,"orderedQuantity"),CultureInfo.InvariantCulture),Received=decimal.Parse(P(i,"receivedQuantity"),CultureInfo.InvariantCulture)});}
    private void New(){Editing=null;ReadOnly=false;Dialog=true;FormError=null;Message=null;PurchaseOrderId=Reference=Notes="";Lines=[];PoInfo=null;ReceiptDate=DateOnly.FromDateTime(DateTime.Today);}
    private async Task Open(Row row,bool view){Editing=row.Id;ReadOnly=view;Dialog=true;FormError=null;var s=await Session();if(s is null)return;var r=await Core.GetAsync("api/v1/purchasing/orders?pageNumber=1&pageSize=100",s.Value.Token,s.Value.Company,default);JsonElement orders=Items(r.Value);if(!r.IsSuccess||orders.ValueKind!=JsonValueKind.Array||!orders.EnumerateArray().Any(x=>P(x,"id")==row.Id.ToString())){FormError=T("سفارش یافت نشد.","لم يتم العثور على الأمر.","Purchase order was not found.");return;}PurchaseOrderId=row.Id.ToString();Reference=row.PoNumber;ReceiptDate=DateOnly.FromDateTime(DateTime.Today);Version=row.Version;await LoadPo();if(Lines.Count>0)foreach(var line in Lines)line.Quantity=line.Received;}
    private async Task SaveDraft(){FormError=null;if(!Guid.TryParse(PurchaseOrderId,out var po)||Lines.Count==0){FormError=T("سفارش خرید و حداقل یک ردیف الزامی است.","أمر الشراء وبند واحد على الأقل مطلوبان.","Purchase order and at least one line are required.");return;}var valid=Lines.Where(x=>x.Quantity>0).Select(x=>new{purchaseOrderItemId=x.Id,quantity=x.Quantity}).ToArray();if(valid.Length==0){FormError=T("مقدار رسید باید بیشتر از صفر باشد.","يجب أن تكون كمية الاستلام أكبر من صفر.","Receipt quantity must be greater than zero.");return;}var s=await Session();if(s is null)return;var body=new{purchaseOrderId=po,receiptDateUtc=ReceiptDate.ToDateTime(TimeOnly.MinValue,DateTimeKind.Utc),supplierDeliveryNote=Reference,notes=Notes,lines=valid};var r=Editing is null?await Core.SendAsync(HttpMethod.Post,"api/v1/purchasing/receipts",body,s.Value.Token,s.Value.Company,default):await Core.SendAsync(HttpMethod.Put,$"api/v1/purchasing/receipts/{Editing}",new{receiptDateUtc=body.receiptDateUtc,supplierDeliveryNote=Reference,notes=Notes,version=Version,lines=valid},s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){FormError=Error(r.ProblemCode);return;}if(Editing is null&&r.Value.TryGetProperty("id",out var id))Editing=id.GetGuid();Message=T("پیش‌نویس رسید ذخیره شد.","تم حفظ مسودة الإيصال.","Receipt draft saved.");Success=true;await Load();}
    private async Task Post(Row row){if(!await JS.InvokeAsync<bool>("confirm",T("موجودی و کاردکس به‌روزرسانی می‌شوند. ادامه می‌دهید؟","سيتم تحديث المخزون والكاردكس. هل تريد المتابعة؟","Inventory and Kardex will be updated. Continue?")))return;await PostId(row.Id,0);}
    private Task PostCurrent()=>Task.CompletedTask;
    private async Task PostNew(){FormError=null;if(!Guid.TryParse(PurchaseOrderId,out var po)||Lines.Count==0){FormError=T("سفارش خرید و ردیف رسید الزامی است.","أمر الشراء وبند الإيصال مطلوبان.","Purchase order and receipt line are required.");return;}var valid=Lines.Where(x=>x.Quantity>0).ToArray();if(valid.Length!=1){FormError=T("در هر ثبت رسید فقط یک ردیف با مقدار مثبت مجاز است.","يسمح بسطر واحد موجب في كل تسجيل استلام.","Each receipt submission must contain exactly one positive line.");return;}var s=await Session();if(s is null)return;string reference=string.IsNullOrWhiteSpace(Reference)?$"UI-RECEIPT-{Guid.NewGuid():N}":Reference;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/purchasing/orders/{po}/receipts",new{purchaseOrderItemId=valid[0].Id,quantity=valid[0].Quantity,reference},s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){FormError=Error(r.ProblemCode);return;}Message=T("رسید ثبت شد و موجودی به‌روزرسانی شد.","تم ترحيل الإيصال وتحديث المخزون.","Receipt posted and inventory updated.");Success=true;Dialog=false;await LoadOrders();await Load();}
    private async Task PostId(Guid id,long version){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/purchasing/receipts/{id}/post?version={version}",new{},s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){FormError=Error(r.ProblemCode);return;}Message=T("رسید ثبت شد و موجودی به‌روزرسانی شد.","تم ترحيل الإيصال وتحديث المخزون.","Receipt posted and inventory updated.");Success=true;Dialog=false;await Load();}
    private async Task Delete(Row row){if(!await JS.InvokeAsync<bool>("confirm",T("پیش‌نویس حذف شود؟","حذف المسودة؟","Delete this draft?")))return;var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Delete,$"api/v1/purchasing/receipts/{row.Id}?version={row.Version}",null,s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("پیش‌نویس حذف شد.","تم حذف المسودة.","Draft deleted."):Error(r.ProblemCode);await Load();}
    private string Error(string? code)=>code switch {"purchasing.over_receipt"=>T("مقدار رسید از مقدار باقیمانده بیشتر است.","كمية الاستلام تتجاوز الكمية المتبقية.","Receipt quantity exceeds the remaining quantity."),"inventory.invalid_transition"=>T("این سفارش خرید برای دریافت معتبر نیست.","أمر الشراء غير صالح للاستلام.","Purchase order is not eligible for receipt."),_=>T("اطلاعات رسید معتبر نیست.","بيانات الإيصال غير صالحة.","Receipt data is invalid.")};
    private void Close(){Dialog=false;FormError=null;} private async Task SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";Page=1;SearchCancel?.Cancel();SearchCancel=new();try{await Task.Delay(250,SearchCancel.Token);await Load();}catch(OperationCanceledException){}} private async Task Reset(){Search="";Page=1;Message=null;await Load();} private async Task Prev(){if(Page>1){Page--;await Load();}} private async Task Next(){if(Rows.Count==PageSize){Page++;await Load();}}
}
