@using System.Globalization
@using System.Text.Json
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject LocaleDateService Dates
@rendermode InteractiveServer
<section class="crud-card purchase-order-section" data-purchase-order-grid><header class="section-header"><h2>@T("سفارش‌های خرید","أوامر الشراء","Purchase Orders")</h2><button type="button" class="btn btn-primary" @onclick="New">@T("افزودن سفارش خرید","إضافة أمر شراء","Add purchase order")</button></header><div class="crud-toolbar"><label class="crud-search"><span>@T("جستجو","بحث","Search")</span><input value="@Search" @oninput="SearchInput" placeholder='@T("شماره سفارش","رقم الأمر","PO number")' /></label><button type="button" class="btn btn-secondary" @onclick="Reset">@T("بازنشانی","إعادة ضبط","Reset")</button></div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")" role="status">@Message</div>}@if(Loading){<div class="crud-loading">@T("در حال بارگذاری","جار التحميل","Loading")</div>}else if(Rows.Count==0){<div class="crud-empty">@T("سفارشی وجود ندارد.","لا توجد أوامر شراء.","No purchase orders found.")</div>}else{<div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("شماره","الرقم","Number")</th><th>@T("تأمین‌کننده","المورد","Supplier")</th><th>@T("تاریخ سفارش","تاريخ الأمر","Order date")</th><th>@T("تحویل","التسليم","Expected")</th><th>@T("انبار","المستودع","Warehouse")</th><th>@T("جمع","الإجمالي","Total")</th><th>@T("وضعیت","الحالة","Status")</th><th>@T("عملیات","الإجراءات","Actions")</th></tr></thead><tbody>@foreach(var r in Rows){<tr><td>@r.Number</td><td>@Label(Suppliers,r.Supplier)</td><td>@DateOnlyText(DateOnly.FromDateTime(r.Created.Date))</td><td>@DateOnlyText(r.Expected)</td><td>@Label(Warehouses,r.Warehouse)</td><td dir="ltr">@r.Total.ToString("N2") @r.Currency</td><td>@Status(r.State)</td><td><div class="row-actions"><BarangIconButton Icon="eye" Semantic="info" Label='@T("مشاهده","عرض","View")' Clicked="@(()=>BeginOpen(r,false))" />@if(r.State=="Draft"){<BarangIconButton Icon="edit" Semantic="edit" Label='@T("ویرایش","تحرير","Edit")' Clicked="@(()=>BeginOpen(r,true))" /><BarangIconButton Icon="arrow-up" Semantic="info" Label='@T("ارسال","إرسال","Submit")' Clicked="@(()=>Submit(r))" /><BarangIconButton Icon="trash" Semantic="danger" Label='@T("حذف","حذف","Delete")' Clicked="@(()=>Delete(r))" />}@if(r.State is "Submitted" or "PartiallyReceived" or "Received"){<BarangIconButton Icon="check" Semantic="success" Label='@T("بستن","إغلاق","Close")' Clicked="@(()=>CloseOrder(r,false))" /><BarangIconButton Icon="close" Semantic="danger" Label='@T("لغو","إلغاء","Cancel")' Clicked="@(()=>CloseOrder(r,true))" />}<BarangIconButton Icon="history" Semantic="info" Label='@T("تاریخچه","السجل","History")' Clicked="@(()=>History(r))" /></div></td></tr>}</tbody></table></div><BarangPagination Page="@Page" HasNext="@(Rows.Count==20)" Disabled="@Loading" PageLabel="" PreviousText="@T("قبلی","السابق","Previous")" NextText="@T("بعدی","التالي","Next")" Previous="Prev" Next="Next" />}</section>
<BarangModal Open="@Dialog" Title="@(ReadOnly?T("مشاهده سفارش خرید","عرض أمر الشراء","View purchase order"):Editing is null?T("افزودن سفارش خرید","إضافة أمر شراء","Add purchase order"):T("ویرایش سفارش خرید","تحرير أمر الشراء","Edit purchase order"))" Size="large" CloseRequested="Close"><ChildContent>@if(FormError is not null){<div class="inline-error po-validation-summary" role="alert" aria-live="assertive">@FormError</div>}<section class="editor-section"><h3>@T("اطلاعات عمومی","المعلومات العامة","General")</h3><div class="form-grid"><label><span>@T("تأمین‌کننده","المورد","Supplier")</span><SearchableSelect Name="supplier" Options="@Suppliers" Value="@Supplier" ValueChanged="v=>Supplier=v" Disabled="@ReadOnly" /></label><label><span>@T("انبار مقصد","المستودع الوجهة","Destination warehouse")</span><SearchableSelect Name="warehouse" Options="@Warehouses" Value="@Warehouse" ValueChanged="v=>Warehouse=v" Disabled="@ReadOnly" /></label><label><span>@T("تاریخ سفارش","تاريخ الأمر","Order date")</span><LocaleDateInput Name="order-date" Value="@OrderDate" Disabled="true" /></label><label><span>@T("تحویل مورد انتظار","التسليم المتوقع","Expected delivery")</span><LocaleDateInput Name="expected-date" @bind-Value="Expected" Disabled="@ReadOnly" /></label><label><span>@T("ارز","العملة","Currency")</span><input @bind="Currency" readonly="@ReadOnly" /></label></div></section><section class="editor-section"><h3>@T("ردیف‌ها","البنود","Lines")</h3>@if(!ReadOnly){<div class="form-grid"><label><span>@T("محصول","المنتج","Product")</span><SearchableSelect Name="product" Options="@Products" Value="@Product" ValueChanged="ProductChanged" /></label><label><span>SKU</span><SearchableSelect Name="sku" Options="@Variants" Value="@Variant" ValueChanged="VariantChanged" /></label><label><span>@T("مقدار","الكمية","Quantity")</span><input type="number" min="0.01" step="0.01" @bind="Qty" /></label><label><span>@T("هزینه خرید","تكلفة الشراء","Purchase cost")</span><input type="number" min="0" step="0.01" @bind="Cost" /></label><button type="button" class="btn btn-secondary" @onclick="SaveLine">@(LineEdit is null?T("افزودن ردیف","إضافة بند","Add line"):T("ذخیره ردیف","حفظ البند","Save line"))</button></div>}<table class="data-grid"><thead><tr><th>SKU</th><th>@T("مقدار","الكمية","Quantity")</th><th>@T("هزینه","التكلفة","Cost")</th><th>@T("دریافت‌شده","المستلم","Received")</th><th>@T("باقی‌مانده","المتبقي","Remaining")</th>@if(!ReadOnly){<th>@T("عملیات","الإجراءات","Actions")</th>}</tr></thead><tbody>@foreach(var l in Lines.Select((x,i)=>(x,i))){<tr><td>@l.x.Sku</td><td>@l.x.Qty</td><td>@l.x.Cost.ToString("N2")</td><td>@l.x.Received</td><td>@(l.x.Qty-l.x.Received)</td>@if(!ReadOnly){<td><button type="button" class="icon-button" aria-label="Edit line" @onclick="(()=>EditLine(l.i))">✎</button><button type="button" class="icon-button danger" aria-label="Remove line" @onclick="(()=>RemoveLine(l.i))">⌫</button></td>}</tr>}</tbody></table>@if(SourcingMessage is not null){<div class="inline-hint">@SourcingMessage</div>}</section><section class="editor-section"><h3>@T("تجاری و جمع","التجارية والإجماليات","Commercial and totals")</h3><dl><dt>@T("جمع کل","الإجمالي","Subtotal")</dt><dd>@Lines.Sum(x=>x.Qty*x.Cost).ToString("N2") @Currency</dd><dt>@T("دریافت‌شده","المستلم","Received")</dt><dd>@Lines.Sum(x=>x.Received)</dd><dt>@T("باقی‌مانده","المتبقي","Remaining")</dt><dd>@Lines.Sum(x=>x.Qty-x.Received)</dd></dl></section></ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="Close">@T("انصراف","إلغاء","Cancel")</button>@if(!ReadOnly){<button type="button" class="btn btn-primary" @onclick="Save">@T("ذخیره پیش‌نویس","حفظ المسودة","Save draft")</button>}</Footer></BarangModal>
<BarangModal Open="@HistoryDialog" Title="@T("تاریخچه سفارش خرید","سجل أمر الشراء","Purchase order history")" Size="medium" CloseRequested="(()=>HistoryDialog=false)"><ChildContent><table class="data-grid"><thead><tr><th>Event</th><th>Time</th><th>Details</th></tr></thead><tbody>@foreach(var h in Histories){<tr><td>@h.EventType</td><td>@Dates.Format(h.Time,CultureCode)</td><td>@h.Summary</td></tr>}</tbody></table></ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="(()=>HistoryDialog=false)">@T("بستن","إغلاق","Close")</button></Footer></BarangModal>
@code { [CascadingParameter(Name="BarangCulture")] private string? BarangCulture {get;set;} private sealed record Row(Guid Id,string Number,Guid Supplier,Guid Warehouse,string Currency,string State,long Version,DateOnly? Expected,DateTimeOffset Created,decimal Total);private sealed record Line(string Product,string Variant,string Sku,decimal Qty,decimal Cost,decimal Received);private sealed record HistoryRow(string EventType,DateTimeOffset Time,string? Summary);private string Search="",Supplier="",Warehouse="",Product="",Variant="",Currency="IRR";private DateOnly? OrderDate,Expected;private decimal Qty=1,Cost;private Guid? Editing;private long Version;private int? LineEdit;private bool Loading,Dialog,ReadOnly,Success,HistoryDialog;private string? Message,FormError,SourcingMessage;private int Page=1;private List<Row> Rows=[];private List<Line> Lines=[];private List<HistoryRow> Histories=[];private List<SearchableSelectOption> Suppliers=[],Warehouses=[],Products=[],Variants=[];private CancellationTokenSource? SearchCancel;private string Lang=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;private string CultureCode=>Lang;private string T(string fa,string ar,string en)=>Lang switch{"ar"=>ar,"en"=>en,_=>fa};private string DateOnlyText(DateOnly? d)=>d is null?"—":Dates.Format(d.Value,CultureCode);private string Label(List<SearchableSelectOption> x,Guid id)=>x.FirstOrDefault(o=>o.Value==id.ToString())?.Label??id.ToString();private string Status(string s)=>s switch{"Draft"=>T("پیش‌نویس","مسودة","Draft"),"Submitted"=>T("ارسال‌شده","مرسل","Submitted"),"PartiallyReceived"=>T("دریافت جزئی","مستلم جزئياً","Partially received"),"Received"=>T("دریافت کامل","مستلم بالكامل","Received"),"Closed"=>T("بسته‌شده","مغلق","Closed"),"Cancelled"=>T("لغوشده","ملغى","Cancelled"),_=>s};private static string P(JsonElement x,string n)=>x.TryGetProperty(n,out var v)?v.ToString():"";private static string State(JsonElement x){if(!x.TryGetProperty("status",out var v))return "";if(v.ValueKind==JsonValueKind.Number)return v.GetInt32() switch{0=>"Draft",1=>"Submitted",2=>"PartiallyReceived",3=>"Received",4=>"Closed",5=>"Cancelled",_=>""};string text=v.ToString();return int.TryParse(text,out var n)?n switch{0=>"Draft",1=>"Submitted",2=>"PartiallyReceived",3=>"Received",4=>"Closed",5=>"Cancelled",_=>""}:text;}
 protected override async Task OnInitializedAsync(){OrderDate=DateOnly.FromDateTime(DateTime.Today);await Selectors();await Load();}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
 private async Task Selectors(){var s=await Session();if(s is null)return;var a=await Core.GetAsync("api/v1/suppliers/options?limit=100",s.Value.Token,s.Value.Company,default);if(a.IsSuccess)Suppliers=a.Value.EnumerateArray().Select(x=>new SearchableSelectOption(P(x,"id"),$"{P(x,"name")} - {P(x,"code")}")).ToList();var w=await Core.GetAsync("api/v1/organization/warehouses?pageNumber=1&pageSize=100",s.Value.Token,s.Value.Company,default);if(w.IsSuccess){var v=w.Value.TryGetProperty("items",out var i)?i:w.Value;Warehouses=v.EnumerateArray().Select(x=>new SearchableSelectOption(P(x,"id"),$"{P(x,"code")} - {P(x,"name")}")).ToList();}var p=await Core.GetAsync("api/v1/products?pageSize=100&activeOnly=true",s.Value.Token,s.Value.Company,default);if(p.IsSuccess){var v=p.Value.TryGetProperty("items",out var i)?i:p.Value;Products=v.EnumerateArray().Select(x=>new SearchableSelectOption(P(x,"id"),$"{P(x,"productCode")} - {P(x,"name")}")).ToList();}}
 private async Task Load(){var s=await Session();if(s is null)return;Loading=true;var r=await Core.GetAsync($"api/v1/purchasing/orders?search={Uri.EscapeDataString(Search)}&pageNumber={Page}&pageSize=20",s.Value.Token,s.Value.Company,default);Rows=[];if(r.IsSuccess){var a=r.Value.TryGetProperty("items",out var i)?i:r.Value;foreach(var x in a.EnumerateArray()){decimal total=x.TryGetProperty("items",out var it)?it.EnumerateArray().Sum(q=>q.GetProperty("orderedQuantity").GetDecimal()*q.GetProperty("unitPurchasePrice").GetDecimal()):0;Rows.Add(new(x.GetProperty("id").GetGuid(),P(x,"purchaseOrderNumber"),x.GetProperty("supplierId").GetGuid(),x.GetProperty("warehouseId").GetGuid(),P(x,"currencyCode"),State(x),x.GetProperty("version").GetInt64(),DateOnly.TryParseExact(P(x,"expectedDeliveryDate"),"yyyy-MM-dd",CultureInfo.InvariantCulture,DateTimeStyles.None,out var expectedDate)?expectedDate:null,DateTimeOffset.TryParse(P(x,"createdAtUtc"),out var dt)?dt:DateTimeOffset.UtcNow,total));}}else{Success=false;Message=Error(r.ProblemCode);}Loading=false;}
 private async Task ProductChanged(string v){Product=v;Variant="";Variants=[];var s=await Session();if(s is null||!Guid.TryParse(v,out var id))return;var r=await Core.GetAsync($"api/v1/products/{id}/variants/options?limit=100",s.Value.Token,s.Value.Company,default);if(r.IsSuccess)Variants=r.Value.EnumerateArray().Select(x=>new SearchableSelectOption(P(x,"id"),P(x,"sku"))).ToList();}private async Task VariantChanged(string v){Variant=v;var s=await Session();if(s is null||!Guid.TryParse(Supplier,out var sup)||!Guid.TryParse(Product,out var prod))return;var r=await Core.GetAsync($"api/v1/purchasing/sourcing-options?productId={prod}&productVariantId={v}&quantity={Qty}&currencyCode={Currency}",s.Value.Token,s.Value.Company,default);if(r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array&&r.Value.GetArrayLength()>0&&r.Value[0].TryGetProperty("prices",out var p)&&p.GetArrayLength()>0){Cost=p[0].GetProperty("netUnitCost").GetDecimal();SourcingMessage=T("هزینه از تأمین‌یابی بارگذاری شد.","تم تحميل التكلفة من التوريد.","Purchase cost loaded from sourcing.");}}
 private void New(){Editing=null;Version=0;ReadOnly=false;Dialog=true;Lines=[];Supplier=Warehouse=Product=Variant="";Currency="IRR";Expected=null;OrderDate=DateOnly.FromDateTime(DateTime.Today);FormError=Message=null;}private void BeginOpen(Row r,bool edit){Editing=r.Id;Version=r.Version;Supplier=r.Supplier.ToString();Warehouse=r.Warehouse.ToString();Expected=r.Expected;OrderDate=DateOnly.FromDateTime(r.Created.Date);Currency=r.Currency;ReadOnly=!edit;Dialog=true;FormError=null;_ = Open(r,edit);}
 private async Task Open(Row r,bool edit){Editing=r.Id;Version=r.Version;Supplier=r.Supplier.ToString();Warehouse=r.Warehouse.ToString();Expected=r.Expected;OrderDate=DateOnly.FromDateTime(r.Created.Date);Currency=r.Currency;ReadOnly=!edit;Dialog=true;FormError=null;var s=await Session();if(s is null)return;var a=await Core.GetAsync($"api/v1/purchasing/orders/{r.Id}",s.Value.Token,s.Value.Company,default);if(!a.IsSuccess){Message=Error(a.ProblemCode);return;}var x=a.Value;Version=x.GetProperty("version").GetInt64();Supplier=P(x,"supplierId");Warehouse=P(x,"warehouseId");Currency=P(x,"currencyCode");Expected=DateOnly.TryParseExact(P(x,"expectedDeliveryDate"),"yyyy-MM-dd",CultureInfo.InvariantCulture,DateTimeStyles.None,out var d)?d:r.Expected;OrderDate=DateTimeOffset.TryParse(P(x,"createdAtUtc"),out var dt)?DateOnly.FromDateTime(dt.DateTime):DateOnly.FromDateTime(r.Created.Date);Lines=[];if(x.TryGetProperty("items",out var it))foreach(var q in it.EnumerateArray()){var v=P(q,"productVariantId");Lines.Add(new("",v,v,q.GetProperty("orderedQuantity").GetDecimal(),q.GetProperty("unitPurchasePrice").GetDecimal(),q.GetProperty("receivedQuantity").GetDecimal()));}}private void EditLine(int i){var l=Lines[i];LineEdit=i;Product=l.Product;Variant=l.Variant;Qty=l.Qty;Cost=l.Cost;}private void RemoveLine(int i){Lines.RemoveAt(i);LineEdit=null;}private void SaveLine(){if(!Guid.TryParse(Variant,out _)||Qty<=0||Cost<0){FormError=T("SKU، مقدار و هزینه معتبر الزامی است.","SKU والكمية والتكلفة الصالحة مطلوبة.","A valid SKU, quantity and cost are required.");return;}var l=new Line(Product,Variant,Variants.FirstOrDefault(x=>x.Value==Variant)?.Label??Variant,Qty,Cost,LineEdit is int i?Lines[i].Received:0);if(LineEdit is int n)Lines[n]=l;else if(!Lines.Any(x=>x.Variant==Variant))Lines.Add(l);LineEdit=null;Product=Variant="";Qty=1;Cost=0;FormError=null;}
 private async Task Save(){if(!Guid.TryParse(Supplier,out var sup)){FormError=T("تأمین‌کننده برای ذخیره پیش‌نویس الزامی است.","المورد مطلوب لحفظ المسودة.","Supplier is required to save a draft.");return;}if(!Guid.TryParse(Warehouse,out var wh)){FormError=T("انبار مقصد برای ذخیره پیش‌نویس الزامی است.","المستودع الوجهة مطلوب لحفظ المسودة.","Destination warehouse is required to save a draft.");return;}if(string.IsNullOrWhiteSpace(Currency)||Currency.Trim().Length!=3){FormError=T("کد ارز باید سه حرف باشد.","يجب أن يتكون رمز العملة من ثلاثة أحرف.","Currency code must contain three letters.");return;}var s=await Session();if(s is null)return;var body=new{supplierId=sup,warehouseId=wh,currencyCode=Currency,expectedDeliveryDate=Expected,version=Version,items=Lines.Where(x=>Guid.TryParse(x.Variant,out _)).Select(x=>new{productVariantId=Guid.Parse(x.Variant),quantity=x.Qty,unitPurchasePrice=x.Cost}).ToArray()};var r=Editing is null?await Core.SendAsync(HttpMethod.Post,"api/v1/purchasing/orders",body,s.Value.Token,s.Value.Company,default):await Core.SendAsync(HttpMethod.Put,$"api/v1/purchasing/orders/{Editing}",body,s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("سفارش خرید ذخیره شد.","تم حفظ أمر الشراء.","Purchase order saved."):null;FormError=r.IsSuccess?null:Error(r.ProblemCode);if(r.IsSuccess){if(Editing is null&&r.Value.TryGetProperty("id",out var id))Editing=id.GetGuid();if(r.Value.TryGetProperty("version",out var v))Version=v.GetInt64();await Load();}}
 private async Task Submit(Row r){if(!await JS.InvokeAsync<bool>("confirm",T("ارسال سفارش؟","إرسال الأمر؟","Submit this order?")))return;await Lifecycle($"api/v1/purchasing/orders/{r.Id}/submit?version={r.Version}",new{},T("سفارش ارسال شد.","تم إرسال الأمر.","Purchase order submitted."));}private async Task CloseOrder(Row r,bool cancel){var reason=cancel?await JS.InvokeAsync<string?>("prompt",T("دلیل لغو:","سبب الإلغاء:","Cancellation reason:")):null;if(cancel&&string.IsNullOrWhiteSpace(reason))return;if(!await JS.InvokeAsync<bool>("confirm",cancel?T("لغو سفارش؟","إلغاء الأمر؟","Cancel this order?"):T("بستن سفارش؟","إغلاق الأمر؟","Close this order?")))return;await Lifecycle($"api/v1/purchasing/orders/{r.Id}/close",new{cancel,reason,version=r.Version},cancel?T("سفارش لغو شد.","تم إلغاء الأمر.","Purchase order cancelled."):T("سفارش بسته شد.","تم إغلاق الأمر.","Purchase order closed."));}
 private async Task Delete(Row r){if(!await JS.InvokeAsync<bool>("confirm",T("حذف پیش‌نویس؟","حذف المسودة؟","Delete this draft?")))return;var s=await Session();if(s is null)return;var a=await Core.SendAsync(HttpMethod.Delete,$"api/v1/purchasing/orders/{r.Id}?version={r.Version}",null,s.Value.Token,s.Value.Company,default);Success=a.IsSuccess;Message=a.IsSuccess?T("پیش‌نویس حذف شد.","تم حذف المسودة.","Draft deleted."):Error(a.ProblemCode);await Load();}private async Task Lifecycle(string path,object body,string ok){var s=await Session();if(s is null)return;var a=await Core.SendAsync(HttpMethod.Post,path,body,s.Value.Token,s.Value.Company,default);Success=a.IsSuccess;Message=a.IsSuccess?ok:Error(a.ProblemCode);await Load();}private async Task History(Row r){var s=await Session();if(s is null)return;var a=await Core.GetAsync($"api/v1/purchasing/orders/{r.Id}/history",s.Value.Token,s.Value.Company,default);Histories=[];if(a.IsSuccess)Histories=a.Value.EnumerateArray().Select(x=>new HistoryRow(P(x,"eventType"),DateTimeOffset.TryParse(P(x,"occurredAtUtc"),out var d)?d:DateTimeOffset.UtcNow,P(x,"summary"))).ToList();HistoryDialog=true;}
 private string SourcingError(){if(Lines.Count==1)return T($"ردیف ۱ ({Lines[0].Sku}): برای این کالا رابطه تأمین معتبر با تأمینکننده وجود ندارد.",$"البند 1 ({Lines[0].Sku}): لا توجد علاقة توريد صالحة بين المورد والمنتج.",$"Line 1 ({Lines[0].Sku}): no valid supplier sourcing relation exists for this product.");return T("برای یکی از ردیف‌های سفارش، رابطه تأمین معتبر با تأمینکننده وجود ندارد.","لا توجد علاقة توريد صالحة بين المورد والمنتج لأحد بنود الأمر.","No valid supplier sourcing relation exists for one of the order lines.");}private string Error(string? c)=>c switch{"purchasing.po.supplier_required"=>T("تأمین‌کننده انتخاب نشده است.","لم يتم اختيار المورد.","Select a supplier."),"purchasing.po.warehouse_required"=>T("انبار مقصد انتخاب نشده است.","لم يتم اختيار المستودع الوجهة.","Select a destination warehouse."),"purchasing.po.currency_invalid"=>T("کد ارز باید سه حرف باشد.","يجب أن يتكون رمز العملة من ثلاثة أحرف.","Currency code must contain three letters."),"purchasing.po.line_required"=>T("سفارش خرید باید حداقل یک ردیف داشته باشد.","يجب أن يحتوي أمر الشراء على بند واحد على الأقل.","Purchase order must contain at least one line."),"purchasing.po.line.variant_required"=>T("گونه/SKU ردیف انتخاب نشده است.","لم يتم اختيار SKU للبند.","Select an SKU for the line."),"purchasing.po.line.quantity_invalid"=>T("مقدار هر ردیف باید بیشتر از صفر باشد.","يجب أن تكون كمية كل بند أكبر من صفر.","Each line quantity must be greater than zero."),"purchasing.po.line.cost_invalid"=>T("هزینه خرید ردیف معتبر نیست.","تكلفة شراء البند غير صالحة.","Line purchase cost is invalid."),"purchasing.po.line.variant_not_found"=>T("گونه/SKU ردیف یافت نشد یا فعال نیست.","لم يتم العثور على SKU للبند أو أنه غير نشط.","The line SKU was not found or is inactive."),"purchasing.po.supplier_not_eligible"=>T("تأمین‌کننده برای این سفارش واجد شرایط نیست.","المورد غير مؤهل لهذا الأمر.","The supplier is not eligible for this order."),"purchasing.po.warehouse_not_eligible"=>T("انبار مقصد برای این سفارش واجد شرایط 