@if (!string.IsNullOrWhiteSpace(Href))
{
    <a class="@CssClass" href="@(Disabled ? null : Href)" title="@Label" aria-label="@Label" aria-disabled="@Disabled.ToString().ToLowerInvariant()" tabindex="@(Disabled ? -1 : null)" @attributes="AdditionalAttributes" @onclick="Clicked" @onclick:stopPropagation="StopPropagation" @onclick:preventDefault="Disabled">
        <BarangIcon Name="@Icon" />
    </a>
}
else
{
    <button type="button" class="@CssClass" title="@Label" aria-label="@Label" disabled="@Disabled" @attributes="AdditionalAttributes" @onclick="Clicked" @onclick:stopPropagation="StopPropagation">
        <BarangIcon Name="@Icon" />
    </button>
}
@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "more";
    [Parameter] public string? Semantic { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool StopPropagation { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> Clicked { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => $"barang-icon-button barang-action-{ResolvedSemantic} {Class}";
    private string ResolvedSemantic => Semantic ?? Icon switch
    {
        "eye" or "info" or "move" => "info",
        "edit" => "edit",
        "plus" or "user-plus" or "restore" => "success",
        "trash" or "unlink" => "danger",
        "power" => "warning",
        _ => "neutral"
    };
}
