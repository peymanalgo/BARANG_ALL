@using System.Globalization
@using System.Text.Json
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState
@rendermode InteractiveServer

<section class="crud-card purchase-request-section" data-purchase-request-grid>
    <header class="section-header"><div><h2>@T("درخواست خرید","طلبات الشراء","Purchase Requests")</h2><p>@T("درخواست داخلی تأمین کالا؛ بدون تغییر موجودی","طلب داخلي للتوريد دون تغيير المخزون","Internal demand request; no stock mutation")</p></div><button type="button" class="btn btn-primary" @onclick="OpenCreate">@T("افزودن درخواست","إضافة طلب","Add request")</button></header>
    <div class="crud-toolbar"><label class="crud-search"><span>@T("جستجو","بحث","Search")</span><input value="@Search" @oninput="SearchChanged" placeholder='@T("شماره، انبار یا دلیل","الرقم أو المستودع أو السبب","Request number, warehouse or reason")' /></label><label class="compact-filter"><span>@T("وضعیت","الحالة","Status")</span><select value="@Status" @onchange="StatusChanged"><option value="">@T("همه","الكل","All")</option><option value="Draft">@T("پیش‌نویس","مسودة","Draft")</option><option value="Submitted">@T("ارسال‌شده","مرسل","Submitted")</option><option value="Closed">@T("بسته‌شده","مغلق","Closed")</option><option value="Cancelled">@T("لغوشده","ملغى","Cancelled")</option></select></label><button type="button" class="btn btn-secondary" @onclick="Reset">@T("بازنشانی","إعادة ضبط","Reset")</button></div>
    @if (Message is not null) { <div class="@(Success ? "inline-success" : "inline-error")" role="status">@Message</div> }
    @if (Loading) { <div class="crud-loading">@T("در حال بارگذاری","جار التحميل","Loading")</div> }
    else if (Rows.Count == 0) { <div class="crud-empty">@T("درخواستی وجود ندارد.","لا توجد طلبات.","No purchase requests found.")</div> }
    else { <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th>@T("شماره درخواست","رقم الطلب","Request number")</th><th>@T("انبار مقصد","المستودع الوجهة","Destination warehouse")</th><th>@T("دلیل","السبب","Reason")</th><th>@T("تعداد ردیف","عدد البنود","Lines")</th><th>@T("وضعیت","الحالة","Status")</th><th>@T("تاریخ","التاريخ","Date")</th><th>@T("عملیات","الإجراءات","Actions")</th></tr></thead><tbody>@foreach (var row in Rows) { <tr><td>@row.Number</td><td>@row.Warehouse</td><td>@row.Reason</td><td>@row.Lines</td><td>@StatusText(row.Status)</td><td dir="ltr">@row.Date.ToString("d", CultureInfo.CurrentCulture)</td><td ><BarangActionMenu><BarangIconButton Icon="eye" Semantic="info" Label="@T("مشاهده","عرض","View")" Clicked="(()=>View(row))" />@if(row.Status=="Draft"){<BarangIconButton Icon="send" Semantic="info" Label="@T("ارسال","إرسال","Submit")" Clicked="(()=>Submit(row))" /><BarangIconButton Icon="trash" Semantic="danger" Label="@T("حذف","حذف","Delete")" Clicked="(()=>Delete(row))" />}</BarangActionMenu></td></tr> }</tbody></table></div><BarangPagination Page="@Page" HasNext="@(Rows.Count == PageSize)" Disabled="@Loading" PageLabel="" PreviousText="@T("قبلی","السابق","Previous")" NextText="@T("بعدی","التالي","Next")" Previous="Previous" Next="Next" /> }
</section>

<BarangModal Open="@Dialog" Title='@(ReadOnly ? T("مشاهده درخواست خرید","عرض طلب الشراء","View purchase request") : T("افزودن درخواست خرید","إضافة طلب شراء","Add purchase request"))' Size="large" CloseRequested="Close"><ChildContent><div class="form-grid"><label><span>@T("انبار مقصد","المستودع الوجهة","Destination warehouse")</span><SearchableSelect Options="@WarehouseOptions" Value="@Warehouse" ValueChanged="WarehouseChanged" Placeholder='@T("انتخاب انبار","اختر المستودع","Choose warehouse")' /></label><label><span>@T("دلیل/هدف","السبب/الغرض","Reason/Purpose")</span><input @bind="Reason" readonly="@ReadOnly" /></label><label><span>@T("مرجع کمبود","مرجع النقص","Shortage reference")</span><input @bind="SourceShortageId" readonly="@ReadOnly" /></label></div><h3>@T("ردیف‌های درخواست","بنود الطلب","Request lines")</h3>@if(!ReadOnly){<div class="form-grid"><label><span>@T("محصول","المنتج","Product")</span><SearchableSelect Options="@ProductOptions" Value="@Product" ValueChanged="ProductChanged" Placeholder='@T("انتخاب محصول","اختر المنتج","Choose product")' /></label><label><span>SKU</span><SearchableSelect Options="@VariantOptions" Value="@Variant" ValueChanged="VariantChanged" Placeholder='@T("انتخاب SKU","اختر SKU","Choose SKU")' /></label><label><span>@T("مقدار","الكمية","Quantity")</span><input type="number" min="0.01" step="0.01" @bind="Quantity" /></label><button type="button" class="btn btn-secondary" @onclick="AddLine">@T("افزودن ردیف","إضافة بند","Add line")</button></div>}<table class="data-grid"><thead><tr><th>SKU</th><th>@T("مقدار","الكمية","Quantity")</th><th>@T("عملیات","الإجراءات","Actions")</th></tr></thead><tbody>@foreach(var line in Lines){<tr><td>@line.Sku</td><td>@line.Quantity</td><td>@if(!ReadOnly){<BarangIconButton Icon="trash" Semantic="danger" Label="@T("حذف","حذف","Remove")" Clicked="(()=>Lines.Remove(line))" />}</td></tr>}</tbody></table>@if(FormError is not null){<div class="inline-error" role="alert">@FormError</div>}</ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="Close">@T("انصراف","إلغاء","Cancel")</button>@if(!ReadOnly){<button type="button" class="btn btn-primary" @onclick="Save">@T("ذخیره پیش‌نویس","حفظ المسودة","Save draft")</button>}</Footer></BarangModal>

@code {
    private bool VariantsPreloaded;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (VariantsPreloaded || ProductOptions.Count == 0) return;
        VariantsPreloaded = true;
        var s = await Session();
        if (s is null) return;
        var all = new List<SearchableSelectOption>();
        foreach (var product in ProductOptions.Take(100))
        {
            if (!Guid.TryParse(product.Value, out var productId)) continue;
            var result = await Core.GetAsync($"api/v1/products/{productId}/variants/options?limit=100", s.Value.Token, s.Value.Company, default);
            if (result.IsSuccess && result.Value.ValueKind == JsonValueKind.Array)
                all.AddRange(result.Value.EnumerateArray().Select(x => new SearchableSelectOption(x.GetProperty("id").ToString(), x.TryGetProperty("sku", out var sku) ? sku.ToString() : x.ToString())));
        }
        VariantOptions = all.GroupBy(x => x.Value).Select(x => x.First()).ToList();
        await InvokeAsync(StateHasChanged);
    }
    private sealed record Row(Guid Id,string Number,string Warehouse,string Reason,int Lines,string Status,DateTimeOffset Date,long Version);
    private sealed record Draft(string VariantId,string Sku,decimal Quantity);
    private string Search="",Status="",Warehouse="",Product="",Variant="",Reason="",SourceShortageId=""; private string? FormError; private decimal Quantity=1; private int Page=1; private const int PageSize=20; private bool Loading,Dialog,ReadOnly,Success; private string? Message; private CancellationTokenSource? CancelSearch; private List<Row> Rows=[]; private List<Draft> Lines=[]; private List<SearchableSelectOption> WarehouseOptions=[],ProductOptions=[],VariantOptions=[]; private string Lang=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    protected override async Task OnInitializedAsync(){await LoadSelectors();await Load();}
    private string T(string fa,string ar,string en)=>Lang switch{"ar"=>ar,"en"=>en,_=>fa}; private string StatusText(string s)=>s switch{"Draft"=>T("پیش‌نویس","مسودة","Draft"),"Submitted"=>T("ارسال‌شده","مرسل","Submitted"),"Closed"=>T("بسته‌شده","مغلق","Closed"),"Cancelled"=>T("لغوشده","ملغى","Cancelled"),_=>s};
    private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string token?(token,c):null;}
    private async Task Load(){var s=await Session();if(s is null)return;Loading=true;var statusQuery=string.IsNullOrWhiteSpace(Status)?"":"&status="+Uri.EscapeDataString(Status);var query=$"api/v1/purchasing/requests?search={Uri.EscapeDataString(Search)}{statusQuery}&pageNumber={Page}&pageSize={PageSize}";var r=await Core.GetAsync(query,s.Value.Token,s.Value.Company,default);Rows=[];if(r.IsSuccess){var root=r.Value.ValueKind==JsonValueKind.Object&&r.Value.TryGetProperty("items",out var items)?items:r.Value;if(root.ValueKind==JsonValueKind.Array)foreach(var x in root.EnumerateArray())Rows.Add(new(x.GetProperty("id").GetGuid(),x.GetProperty("requestNumber").ToString(),x.GetProperty("warehouseName").ToString(),x.GetProperty("reason").ToString(),x.GetProperty("lineCount").GetInt32(),x.GetProperty("status").ToString(),x.GetProperty("createdAtUtc").GetDateTimeOffset(),x.GetProperty("version").GetInt64()));}else{Success=false;Message=T("دریافت درخواست‌ها انجام نشد.","تعذر تحميل الطلبات.","Requests could not be loaded.");}Loading=false;}
    private async Task LoadSelectors(){var s=await Session();if(s is null)return;var w=await Core.GetAsync("api/v1/organization/warehouses?pageNumber=1&pageSize=100&sort=code",s.Value.Token,s.Value.Company,default);if(w.IsSuccess){var a=w.Value.ValueKind==JsonValueKind.Object&&w.Value.TryGetProperty("items",out var wi)?wi:w.Value;if(a.ValueKind==JsonValueKind.Array)WarehouseOptions=a.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("id").ToString(),$"{x.GetProperty("code")} - {x.GetProperty("name")}")).ToList();}var p=await Core.GetAsync("api/v1/products?pageSize=100&activeOnly=true",s.Value.Token,s.Value.Company,default);if(p.IsSuccess){var a=p.Value.ValueKind==JsonValueKind.Object&&p.Value.TryGetProperty("items",out var pi)?pi:p.Value;if(a.ValueKind==JsonValueKind.Array)ProductOptions=a.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("id").ToString(),$"{x.GetProperty("productCode")} - {x.GetProperty("name")}")).ToList();}}
    private async Task ProductChanged(string value){Product=value;Variant="";VariantOptions=[];var s=await Session();if(s is null||!Guid.TryParse(Product,out var id))return;var r=await Core.GetAsync($"api/v1/products/{id}/variants/options?limit=100",s.Value.Token,s.Value.Company,default);if(r.IsSuccess&&r.Value.ValueKind==JsonValueKind.Array)VariantOptions=r.Value.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("id").ToString(),x.TryGetProperty("sku",out var sku)?sku.ToString():x.ToString())).ToList();}
    private Task WarehouseChanged(string v){Warehouse=v;return Task.CompletedTask;} private Task VariantChanged(string v){Variant=v;return Task.CompletedTask;}
    private void OpenCreate(){ReadOnly=false;Dialog=true;FormError=null;Reason="";SourceShortageId="";Lines=[];Quantity=1;}
    private void AddLine(){var selected=Guid.TryParse(Variant,out _) ? Variant : VariantOptions.FirstOrDefault()?.Value ?? "";var amount=Quantity>0?Quantity:1;if(Guid.TryParse(selected,out _)&&!Lines.Any(x=>x.VariantId==selected)){Lines.Add(new(selected,VariantOptions.FirstOrDefault(x=>x.Value==selected)?.Label??selected,amount));Variant="";Quantity=1;}}
    private async Task Save(){if(!Guid.TryParse(Warehouse,out var warehouse)||Lines.Count==0||string.IsNullOrWhiteSpace(Reason)){FormError=T("انبار، دلیل و حداقل یک ردیف الزامی است.","المستودع والسبب وبند واحد مطلوبة.","Warehouse, reason and at least one line are required.");return;}var s=await Session();if(s is null)return;var body=new{warehouseId=warehouse,reason=Reason,sourceShortageId=Guid.TryParse(SourceShortageId,out var shortage)?shortage:(Guid?)null,items=Lines.Select(x=>new{productVariantId=Guid.Parse(x.VariantId),quantity=x.Quantity}).ToArray()};var r=await Core.SendAsync(HttpMethod.Post,"api/v1/purchasing/requests",body,s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("درخواست ذخیره شد.","تم حفظ الطلب.","Purchase request saved."):T("ذخیره درخواست انجام نشد.","تعذر حفظ الطلب.","Purchase request could not be saved.");if(r.IsSuccess){Dialog=false;await Load();}}
    private async Task View(Row row){var s=await Session();if(s is null)return;var r=await Core.GetAsync($"api/v1/purchasing/requests/{row.Id}",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess)return;var x=r.Value;Warehouse=x.GetProperty("warehouseId").ToString();Reason=x.GetProperty("reason").ToString();SourceShortageId=x.TryGetProperty("sourceShortageId",out var sh)&&sh.ValueKind!=JsonValueKind.Null?sh.ToString():"";Lines=[];if(x.TryGetProperty("items",out var items)&&items.ValueKind==JsonValueKind.Array)foreach(var i in items.EnumerateArray())Lines.Add(new(i.GetProperty("productVariantId").ToString(),i.GetProperty("productVariantId").ToString(),i.GetProperty("requestedQuantity").GetDecimal()));ReadOnly=true;Dialog=true;}
    private async Task Submit(Row row){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/purchasing/requests/{row.Id}/submit?version={row.Version}",null!,s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("درخواست ارسال شد.","تم إرسال الطلب.","Request submitted."):T("ارسال درخواست انجام نشد.","تعذر إرسال الطلب.","Request could not be submitted.");await Load();}
    private async Task Delete(Row row){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Delete,$"api/v1/purchasing/requests/{row.Id}?version={row.Version}",new {},s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?T("درخواست حذف شد.","تم حذف الطلب.","Request deleted."):T("حذف فقط برای پیش‌نویس مجاز است.","الحذف مسموح للمسودة فقط.","Only unused drafts can be deleted.");await Load();}
    private async Task SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";Page=1;CancelSearch?.Cancel();CancelSearch?.Dispose();CancelSearch=new();try{await Task.Delay(250,CancelSearch.Token);await Load();}catch(OperationCanceledException){}}
    private async Task StatusChanged(ChangeEventArgs e){Status=e.Value?.ToString()??"";Page=1;await Load();} private async Task Reset(){Search=Status="";Page=1;Message=null;await Load();} private async Task Previous(){if(Page>1){Page--;await Load();}} private async Task Next(){if(Rows.Count==PageSize){Page++;await Load();}} private void Close(){Dialog=false;}
}
