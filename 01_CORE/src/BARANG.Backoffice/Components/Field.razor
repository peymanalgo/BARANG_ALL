@if(K is not null){<div class="order360-readonly-field"><dt>@K</dt><dd>@V</dd></div>}else{<label><span>@Label</span><input name="@Name" type="@Type" value="@Value" disabled="@Disabled" @oninput="Changed" /></label>}
@code{[Parameter]public string Label{get;set;}="";[Parameter]public string? Name{get;set;}[Parameter]public string Value{get;set;}="";[Parameter]public EventCallback<string>ValueChanged{get;set;}[Parameter]public bool Disabled{get;set;}[Parameter]public string Type{get;set;}="text";[Parameter]public string? K{get;set;}[Parameter]public string? V{get;set;}private Task Changed(ChangeEventArgs e)=>ValueChanged.InvokeAsync(e.Value?.ToString()??"");}
