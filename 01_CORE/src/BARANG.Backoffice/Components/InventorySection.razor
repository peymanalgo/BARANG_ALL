@using System.Globalization
@using System.Text.Json
@using BARANG.Backoffice.Api
@using BARANG.Backoffice.Auth
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState

<section class="crud-card inventory-balance-section" data-inventory-grid>
    <header class="section-header"><div><h2>@T("موجودی","المخزون","Inventory")</h2><p>@T("موجودی واقعی کالا به تفکیک انبار و SKU","الرصيد الفعلي حسب المستودع وSKU","Authoritative stock by warehouse and SKU")</p></div></header>
    <div class="crud-toolbar"><label class="crud-search"><span>@T("جستجو","بحث","Search")</span><input value="@Search" @oninput="SearchChanged" placeholder="@T("جستجوی انبار، محصول یا SKU","بحث عن المستودع أو المنتج أو SKU","Search warehouse, product or SKU")" /></label><label class="compact-filter"><span>@T("انبار","المستودع","Warehouse")</span><SearchableSelect Options="@WarehouseOptions" @bind-Value="WarehouseId" Placeholder="@T("همه انبارها","كل المستودعات","All warehouses")" /></label><button type="button" class="btn btn-secondary" disabled="@Loading" @onclick="Reset"><BarangIcon Name="reset" /> @T("بازنشانی","إعادة ضبط","Reset")</button></div>
    @if (Error is not null) { <div class="inline-error" role="alert">@Error</div> }
    @if (Loading) { <BarangLoadingState Text="@T("در حال بارگذاری…","جار التحميل…","Loading…")" /> }
    else if (Rows.Count == 0) { <CrudEmptyState Title="@T("موجودی یافت نشد","لم يتم العثور على مخزون","No inventory found")" /> }
    else { <div class="data-grid-wrap"><table class="data-grid"><thead><tr><th><BarangSortHeader Label="@T("انبار","المستودع","Warehouse")" Active="@(Sort == "warehouse")" Descending="Descending" Clicked='()=>ChangeSort("warehouse")' /></th><th>@T("محصول","المنتج","Product")</th><th><BarangSortHeader Label="SKU" Active="@(Sort == "sku")" Descending="Descending" Clicked='()=>ChangeSort("sku")' /></th><th>@T("واحد","الوحدة","Unit")</th><th><BarangSortHeader Label="@T("موجودی","المخزون","On hand")" Active="@(Sort == "onhand")" Descending="Descending" Clicked='()=>ChangeSort("onhand")' /></th><th>@T("رزرو شده","محجوز","Reserved")</th><th><BarangSortHeader Label="@T("قابل دسترس","المتاح","Available")" Active="@(Sort == "available")" Descending="Descending" Clicked='()=>ChangeSort("available")' /></th><th>@T("عملیات","الإجراءات","Actions")</th></tr></thead><tbody>@foreach (var row in Rows) { <tr><td><strong>@row.WarehouseName</strong><small class="muted">@row.WarehouseCode</small></td><td><strong>@row.ProductName</strong><small class="muted">@row.ProductCode</small></td><td dir="ltr">@row.Sku</td><td dir="ltr">@row.Uom</td><td dir="ltr">@row.OnHand.ToString("N2", CultureInfo.CurrentCulture)</td><td dir="ltr">@row.Reserved.ToString("N2", CultureInfo.CurrentCulture)</td><td dir="ltr">@row.Available.ToString("N2", CultureInfo.CurrentCulture)</td><td><div class="row-actions"><BarangIconButton Icon="eye" Semantic="info" Label="@T("مشاهده","عرض","View")" Clicked="@(()=>Open(row))" /><BarangIconButton Icon="history" Semantic="info" Label="@T("کاردکس","حركة المخزون","Kardex")" Clicked="@(()=>OpenKardex(row))" /></div></td></tr> }</tbody></table></div><BarangPagination Page="@Page" HasNext="@(Page * PageSize < TotalCount)" Disabled="@Loading" PageLabel="" PreviousText="@T("قبلی","السابق","Previous")" NextText="@T("بعدی","التالي","Next")" Previous="Previous" Next="Next" /> }
</section>

<BarangModal Open="@Dialog" Title="@(KardexOpen ? T("کاردکس موجودی","حركة المخزون","Inventory Kardex") : T("جزئیات موجودی","تفاصيل المخزون","Inventory details"))" Size="large" CloseRequested="Close">
    <ChildContent><dl class="detail-list"><dt>@T("انبار","المستودع","Warehouse")</dt><dd>@Selected?.WarehouseName (@Selected?.WarehouseCode)</dd><dt>@T("محصول","المنتج","Product")</dt><dd>@Selected?.ProductName (@Selected?.ProductCode)</dd><dt>SKU</dt><dd dir="ltr">@Selected?.Sku</dd><dt>@T("واحد","الوحدة","Unit")</dt><dd dir="ltr">@Selected?.Uom</dd><dt>@T("موجودی","المخزون","On hand")</dt><dd dir="ltr">@Selected?.OnHand.ToString("N2", CultureInfo.CurrentCulture)</dd><dt>@T("رزرو شده","محجوز","Reserved")</dt><dd dir="ltr">@Selected?.Reserved.ToString("N2", CultureInfo.CurrentCulture)</dd><dt>@T("قابل دسترس","المتاح","Available")</dt><dd dir="ltr">@Selected?.Available.ToString("N2", CultureInfo.CurrentCulture)</dd></dl>@if(KardexOpen){<h3>@T("حرکت‌های ثبت‌شده","الحركات المسجلة","Recorded movements")</h3>@if(Kardex.Count==0){<CrudEmptyState Title="@T("حرکتی یافت نشد","لم يتم العثور على حركات","No movements found")" /> }else{<div class="data-grid-wrap"><table class="data-grid compact"><thead><tr><th>@T("نوع","النوع","Type")</th><th>@T("تغییر","التغيير","Change")</th><th>@T("مرجع","المرجع","Reference")</th><th>@T("زمان","الوقت","Time")</th></tr></thead><tbody>@foreach(var movement in Kardex){<tr><td>@MovementLabel(movement.Type)</td><td dir="ltr">@movement.Quantity.ToString("N2",CultureInfo.CurrentCulture)</td><td dir="ltr">@movement.Reference</td><td dir="ltr">@movement.Occurred.ToLocalTime().ToString("g",CultureInfo.CurrentCulture)</td></tr>}</tbody></table></div>}}</ChildContent>
    <Footer><button type="button" class="btn btn-secondary" @onclick="Close">@T("انصراف","إغلاق","Close")</button>@if(!KardexOpen){<button type="button" class="btn btn-primary" @onclick="(()=>OpenKardex(Selected!))">@T("مشاهده کاردکس","عرض الحركة","View Kardex")</button>}</Footer>
</BarangModal>

@code {
    private sealed record Row(Guid WarehouseId,string WarehouseCode,string WarehouseName,Guid ProductVariantId,string ProductCode,string ProductName,string Sku,string Uom,decimal OnHand,decimal Reserved,decimal Available,long Version);
    private sealed record Movement(string Type,decimal Quantity,string Reference,DateTimeOffset Occurred);
    private string Search="",WarehouseId="",Sort="warehouse"; private bool Descending,Loading,Dialog,KardexOpen; private string? Error; private Row? Selected; private int Page=1,TotalCount; private const int PageSize=25; private List<Row> Rows=[]; private List<SearchableSelectOption> WarehouseOptions=[]; private List<Movement> Kardex=[]; private CancellationTokenSource? SearchCancellation;
    private string Lang=>CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    private string T(string fa,string ar,string en)=>Lang switch{"en"=>en,"ar"=>ar,_=>fa};
    protected override async Task OnInitializedAsync(){await LoadWarehouses();await Load();}
    private async Task<(string Token,Guid Company)?> Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}
    private async Task LoadWarehouses(){var s=await Session();if(s is null)return;var r=await Core.GetAsync("api/v1/organization/warehouses?pageNumber=1&pageSize=100&sort=code",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess)return;JsonElement items=r.Value.ValueKind==JsonValueKind.Object&&r.Value.TryGetProperty("items",out var envelope)?envelope:r.Value;if(items.ValueKind==JsonValueKind.Array)WarehouseOptions=[new("",T("همه انبارها","كل المستودعات","All warehouses")),..items.EnumerateArray().Select(x=>new SearchableSelectOption(x.GetProperty("id").ToString(),$"{x.GetProperty("code")} - {x.GetProperty("name")}"))];}
    private async Task Load(){Loading=true;Error=null;var s=await Session();if(s is null){Loading=false;return;}var warehouseQuery=Guid.TryParse(WarehouseId,out _)?$"&warehouseId={Uri.EscapeDataString(WarehouseId)}":"";var path=$"api/v1/inventory/balances?search={Uri.EscapeDataString(Search)}{warehouseQuery}&sort={Sort}&descending={Descending.ToString().ToLowerInvariant()}&pageNumber={Page}&pageSize={PageSize}";var r=await Core.GetAsync(path,s.Value.Token,s.Value.Company,default);Rows=[];TotalCount=0;if(r.IsSuccess&&r.Value.TryGetProperty("items",out var items)){TotalCount=r.Value.TryGetProperty("totalCount",out var total)?total.GetInt32():0;Rows=items.EnumerateArray().Select(Parse).ToList();}else if(!r.IsSuccess)Error=T("دریافت موجودی انجام نشد.","تعذر تحميل المخزون.","Inventory could not be loaded.");Loading=false;}
    private static Row Parse(JsonElement x)=>new(x.GetProperty("warehouseId").GetGuid(),x.GetProperty("warehouseCode").ToString(),x.GetProperty("warehouseName").ToString(),x.GetProperty("productVariantId").GetGuid(),x.GetProperty("productCode").ToString(),x.GetProperty("productName").ToString(),x.GetProperty("sku").ToString(),x.GetProperty("uomCode").ToString(),x.GetProperty("onHand").GetDecimal(),x.GetProperty("reserved").GetDecimal(),x.GetProperty("available").GetDecimal(),x.GetProperty("version").GetInt64());
    private async Task SearchChanged(ChangeEventArgs e){Search=e.Value?.ToString()??"";Page=1;SearchCancellation?.Cancel();SearchCancellation?.Dispose();SearchCancellation=new();try{await Task.Delay(250,SearchCancellation.Token);await Load();}catch(OperationCanceledException){}}
    private Task Reset(){Search="";WarehouseId="";Sort="warehouse";Descending=false;Page=1;return Load();}
    private Task ChangeSort(string column){if(Sort==column)Descending=!Descending;else{Sort=column;Descending=false;}Page=1;return Load();}
    private Task Previous(){if(Page>1){Page--;return Load();}return Task.CompletedTask;}
    private Task Next(){if(Page*PageSize<TotalCount){Page++;return Load();}return Task.CompletedTask;}
    private void Open(Row row){Selected=row;KardexOpen=false;Kardex=[];Dialog=true;}
    private async Task OpenKardex(Row row){Selected=row;KardexOpen=true;Dialog=true;Kardex=[];var s=await Session();if(s is null)return;var r=await Core.GetAsync($"api/v1/inventory/transactions?warehouseId={row.WarehouseId}&variantId={row.ProductVariantId}&pageNumber=1&pageSize=100",s.Value.Token,s.Value.Company,default);if(r.IsSuccess&&r.Value.TryGetProperty("items",out var items))Kardex=items.EnumerateArray().Select(x=>new Movement(x.GetProperty("type").ToString(),x.GetProperty("quantityDelta").GetDecimal(),x.GetProperty("reference").ToString(),x.GetProperty("occurredAtUtc").GetDateTimeOffset())).ToList();}
    private void Close()=>Dialog=false;
    private string MovementLabel(string type)=>type switch{"Receipt"=>T("رسید خرید","استلام شراء","Purchase receipt"),"Issue"=>T("مصرف","صرف","Issue"),"TransferOut"=>T("انتقال خروجی","تحويل صادر","Transfer out"),"TransferIn"=>T("انتقال ورودی","تحويل وارد","Transfer in"),"Adjustment"=>T("اصلاح","تسوية","Adjustment"),_=>type};
}
