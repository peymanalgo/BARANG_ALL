@using Microsoft.AspNetCore.Localization
@inject IHttpContextAccessor HttpContextAccessor
@{
    string culture = HttpContextAccessor.HttpContext?.Features.Get<IRequestCultureFeature>()?.RequestCulture.UICulture.Name ?? "fa";
    LocaleDefinition locale = LocalePolicy.Resolve(culture);
}
<!DOCTYPE html>
<html lang="@locale.Code" dir="@locale.Direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>
<body>
    <CascadingAuthenticationState><Routes /></CascadingAuthenticationState>
    <ReconnectModal />
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
