@page "/workspace/workflow"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["Module_workflow"]</PageTitle><div class="page-heading"><h1>@L["Module_workflow"]</h1></div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<section class="toolbar"><label><span>@L["Status"]</span><select @bind="Status"><option value=""></option><option>Open</option><option>Claimed</option><option>Completed</option><option>Cancelled</option></select></label><button @onclick="Load">@L["Refresh"]</button></section><div class="management-grid"><section class="panel"><h2>@L["Action_Claim"]</h2><div class="record-list">@foreach(var x in Tasks){<button class="record-row" @onclick="()=>Pick(x)"><span><strong>@x.Stage · @x.Type</strong><small>@x.Due @(x.Overdue?"⚠":"")</small></span><span>@x.Status</span></button>}</div></section><section class="panel"><div class="form-grid single"><label><span>@L["Module_orders"]</span><input @bind="Order" /></label><label><span>@L["EntityId"]</span><input @bind="Workflow" /></label><label><span>@L["Permission"]</span><input @bind="TaskId" /></label><label><span>@L["Version"]</span><input type="number" @bind="Version" /></label><label><span>@L["Reason"]</span><input @bind="Reason" /></label></div><div class="form-actions"><button @onclick="Start">@L["Action_Create"]</button><button @onclick="Claim">@L["Action_Claim"]</button><button @onclick="Release">@L["Action_Release"]</button><button @onclick="Complete">@L["Action_Complete"]</button><button @onclick="Suspend">@L["Action_Cancel"]</button><button @onclick="Resume">@L["Action_Execute"]</button><button @onclick="Cancel">@L["Action_Cancel"]</button><button @onclick="Escalate">@L["Refresh"]</button></div></section></div><section class="panel"><h2>@L["Timeline"]</h2><pre>@History</pre></section>
@code{private string Status="",Order="",Workflow="",TaskId="",Reason="Backoffice workflow",History="";private long Version;private bool Success;private string?Message;private List<Row>Tasks=[];protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){Tasks=[];var a=await Get("api/v1/workflows/tasks/mine?page=1&pageSize=100"+(string.IsNullOrWhiteSpace(Status)?"":$"&status={Status}"));var b=await Get("api/v1/workflows/tasks/roles?page=1&pageSize=100"+(string.IsNullOrWhiteSpace(Status)?"":$"&status={Status}"));foreach(var r in new[]{a,b})if(r.IsSuccess)foreach(var x in r.Value.GetProperty("items").EnumerateArray()){var id=x.GetProperty("id").GetGuid();if(Tasks.All(v=>v.Id!=id))Tasks.Add(new(id,G(x,"workflowInstanceId"),G(x,"stage"),G(x,"taskTypeCode"),G(x,"status"),G(x,"dueAtUtc"),x.GetProperty("version").GetInt64(),DateTimeOffset.TryParse(G(x,"dueAtUtc"),out var d)&&d<DateTimeOffset.UtcNow));}}private void Pick(Row x){TaskId=x.Id.ToString();Workflow=x.Workflow;Version=x.Version;_ = LoadHistory();}private Task Start()=>Post($"api/v1/workflows/orders/{Order}",null);private Task Claim()=>Post($"api/v1/workflows/tasks/{TaskId}/claim",new{version=Version});private Task Release()=>Post($"api/v1/workflows/tasks/{TaskId}/release",new{version=Version});private Task Complete()=>Post($"api/v1/workflows/tasks/{TaskId}/complete",new{outcome=0,reason=Reason,version=Version});private Task Suspend()=>Post($"api/v1/workflows/{Workflow}/suspend",new{reason=Reason,version=Version});private Task Resume()=>Post($"api/v1/workflows/{Workflow}/resume",new{version=Version});private Task Cancel()=>Post($"api/v1/workflows/{Workflow}/cancel",new{reason=Reason,version=Version});private Task Escalate()=>Post("api/v1/workflows/escalations/process",null);private async Task LoadHistory(){var r=await Get($"api/v1/workflows/{Workflow}/history");History=r.IsSuccess?r.Value.ToString():"";}private Task<ApiResult<System.Text.Json.JsonElement>>Get(string p)=>Send(HttpMethod.Get,p,null);private async Task Post(string p,object?b){var r=await Send(HttpMethod.Post,p,b);Show(r);if(r.IsSuccess&&r.Value.ValueKind==System.Text.Json.JsonValueKind.Object){if(r.Value.TryGetProperty("workflowInstanceId",out var w))Workflow=w.ToString();else if(r.Value.TryGetProperty("id",out var id)&&p.Contains("orders"))Workflow=id.ToString();if(r.Value.TryGetProperty("id",out var t)&&p.Contains("tasks"))TaskId=t.ToString();Version=r.Value.TryGetProperty("version",out var v)?v.GetInt64():Version;await Load();await LoadHistory();}}private async Task<ApiResult<System.Text.Json.JsonElement>>Send(HttpMethod m,string p,object?b){var s=await Session();return s is null?ApiResult<System.Text.Json.JsonElement>.Failed(ApiFailure.Unauthorized):m==HttpMethod.Get?await Core.GetAsync(p,s.Value.Token,s.Value.Company,default):await Core.SendAsync(m,p,b,s.Value.Token,s.Value.Company,default);}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private sealed record Row(Guid Id,string Workflow,string Stage,string Type,string Status,string Due,long Version,bool Overdue);}
