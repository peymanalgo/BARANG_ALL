@page "/admin/security/{Kind}"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@if(Kind=="users"&&Id is Guid userId){<a class="secondary-action" href="@($"/admin/security/users/{userId}/access")">@L["GrantAccess"] · @L["AssignRole"]</a>}
@if(Kind=="roles"&&Id is Guid roleId){<a class="secondary-action" href="@($"/admin/security/roles/{roleId}/permissions")">@L["GrantPermission"]</a>}
<PageTitle>@L[$"Admin_{Kind}"]</PageTitle><nav class="breadcrumbs"><a href="/workspace/foundation">@L["Module_foundation"]</a><span>/</span><span>@L[$"Admin_{Kind}"]</span></nav>
<div class="page-heading"><div><h1>@L[$"Admin_{Kind}"]</h1><p>@L["AuthoritativeCoreData"]</p></div><button class="primary-link" @onclick="New">@L["CreateNew"]</button></div><div class="management-grid"><section class="panel"><div class="record-list">@foreach(var x in Rows){<button class="record-row" @onclick="()=>Pick(x)"><span><strong>@x.Code</strong><small>@x.Name</small></span><span>@(x.Active?L["Active"]:L["Inactive"])</span></button>}</div></section><section class="panel"><div class="form-grid single"><label><span>@L["Code"]</span><input @bind="Code" disabled="@(Id is not null)" /></label><label><span>@L["Name"]</span><input @bind="Name" /></label>@if(Kind=="users"){<label><span>@L["Email"]</span><input @bind="Email" /></label>@if(Id is null){<label><span>@L["Password"]</span><input type="password" @bind="Password" /></label>}}@if(Id is not null){<label><span>@L[Kind=="users"?"Company":"Permission"]</span><select @bind="RelationId"><option value="">@L["Choose"]</option>@foreach(var x in Relations){<option value="@x.Id">@x.Name</option>}</select></label>}</div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<div class="form-actions">@if(Id is not null){<button class="secondary-action" @onclick="Toggle">@(Active?L["Deactivate"]:L["Activate"])</button><button class="secondary-action" @onclick="Grant">@L[Kind=="users"?"GrantAccess":"GrantPermission"]</button>}<button class="primary-link" @onclick="Save">@L["Save"]</button></div></section></div>
@code{[Parameter]public string Kind{get;set;}="users";private Guid?Id;private long Version;private bool Active=true,Success;private string Code="",Name="",Email="",Password="",RelationId="";private string?Message;private List<Row>Rows=[];private List<Option>Relations=[];private string Base()=>Kind=="users"?"api/v1/security/users":"api/v1/security/roles";protected override async Task OnParametersSetAsync(){await Load();await LoadRelations();}private void New(){Id=null;Version=0;Active=true;Code=Name=Email=Password=RelationId="";}private void Pick(Row x){Id=x.Id;Version=x.Version;Active=x.Active;Code=x.Code;Name=x.Name;Email=x.Email;}private async Task Load(){Rows=[];var s=await Session();if(s is null)return;var r=await Core.GetAsync(Base(),s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Show(r);return;}foreach(var x in r.Value.EnumerateArray())Rows.Add(new(x.GetProperty("id").GetGuid(),G(x,Kind=="users"?"username":"code"),G(x,Kind=="users"?"displayName":"displayTitle"),G(x,"email"),B(x,"isActive",G(x,"accountState")!="Inactive"),N(x,"version")));}private async Task LoadRelations(){Relations=[];var s=await Session();if(s is null)return;var path=Kind=="users"?"api/v1/auth/me/companies":"api/v1/security/permissions";var r=await Core.GetAsync(path,s.Value.Token,s.Value.Company,default);if(!r.IsSuccess)return;foreach(var x in r.Value.EnumerateArray())Relations.Add(new(x.GetProperty(Kind=="users"?"companyId":"id").GetGuid(),G(x,Kind=="users"?"displayName":"code")));}private async Task Save(){var s=await Session();if(s is null)return;object body=Kind=="users"?(Id is null?new{username=Code,displayName=Name,email=Email,password=Password}:new{displayName=Name,email=Email,version=Version}):(Id is null?new{code=Code,displayTitle=Name}:new{displayTitle=Name,version=Version});var r=await Core.SendAsync(Id is null?HttpMethod.Post:HttpMethod.Put,Base()+(Id is Guid id?$"/{id}":""),body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private async Task Toggle(){var s=await Session();if(s is null||Id is not Guid id)return;var r=await Core.SendAsync(HttpMethod.Put,$"{Base()}/{id}/activation",new{isActive=!Active,version=Version},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private async Task Grant(){var s=await Session();if(s is null||Id is not Guid id||!Guid.TryParse(RelationId,out var relation))return;var path=Kind=="users"?$"{Base()}/{id}/companies":$"{Base()}/{id}/permissions/{relation}";object?body=Kind=="users"?new{companyId=relation}:null;var r=await Core.SendAsync(HttpMethod.Post,path,body,s.Value.Token,s.Value.Company,default);Show(r);}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private static bool B(System.Text.Json.JsonElement x,string n,bool d=false)=>x.TryGetProperty(n,out var p)&&p.ValueKind is System.Text.Json.JsonValueKind.True or System.Text.Json.JsonValueKind.False?p.GetBoolean():d;private static long N(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.GetInt64():0;private sealed record Row(Guid Id,string Code,string Name,string Email,bool Active,long Version);private sealed record Option(Guid Id,string Name);}
