rong><small>@x.Method</small></span></button>}</div></section></div><section class="panel"><h2>@L["Wizard_Shipping"]</h2><div class="form-grid"><label><span>@L["Name"]</span><input @bind="Recipient" /></label><label><span>@L["Country"]</span><input @bind="Country" /></label><label><span>@L["City"]</span><input @bind="City" /></label><label><span>@L["Action_Address"]</span><input @bind="Address" /></label></div><button class="secondary-action" @onclick="SaveShipping">@L["Save"]</button></section><section class="panel"><h2>@L["Wizard_Pricing"]</h2><div class="form-actions"><button class="secondary-action" @onclick="Validate">@L["Refresh"]</button><button class="secondary-action" @onclick="Reprice">@L["Wizard_Pricing"]</button><button class="primary-link" @onclick="Submit">@L["Action_Submit"]</button></div>@if(Issues.Count>0){<ul>@foreach(var x in Issues){<li>@x</li>}</ul>}@if(Pricing.Count>0){<dl>@foreach(var x in Pricing){<dt>@x.Key</dt><dd>@x.Value</dd>}</dl>}</section>}
