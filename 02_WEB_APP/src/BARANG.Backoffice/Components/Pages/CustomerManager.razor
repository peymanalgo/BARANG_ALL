@page "/manage/customers"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<BusinessStrings> B
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["Module_customers"] · BARANG</PageTitle>
<nav class="breadcrumbs"><a href="/workspace/customers">@L["Module_customers"]</a><span>/</span><span>@L["ManageRecords"]</span></nav>
<div class="page-heading"><div><h1>@L["Module_customers"]</h1><p>@L["AuthoritativeCoreData"]</p></div><button class="primary-link" @onclick="New">@L["CreateNew"]</button></div>
<div class="management-grid">
 <section class="panel"><label><span>@L["Search"]</span><input @bind="Search" /></label><div class="record-list">@foreach(var x in Filtered){<button class="record-row" @onclick="()=>Select(x)"><span><strong>@x.Code</strong><small>@x.Name · @x.NationalId</small></span><span>@(x.Active?L["Active"]:L["Inactive"])</span></button>}</div></section>
 <section class="panel"><div class="form-grid single"><label><span>@L["Code"]</span><input @bind="Code" disabled="@(Id is not null)" /></label><label><span>@L["CustomerType"]</span><select @bind="Type" disabled="@(Id is not null)"><option value="Person">@L["Person"]</option><option value="Organization">@L["Organization"]</option></select></label>@if(Type=="Person"){<label><span>@L["FirstName"]</span><input @bind="FirstName" /></label><label><span>@L["LastName"]</span><input @bind="LastName" /></label>}else{<label><span>@L["LegalName"]</span><input @bind="LegalName" /></label>}<label><span>@L["Name"]</span><input @bind="DisplayName" /></label><label><span>@B["NationalId"]</span><input @bind="NationalId" /></label>@if(Type=="Organization"){<label><span>@B["RegistrationNo"]</span><input @bind="RegistrationNo" /></label><label><span>@B["TaxId"]</span><input @bind="TaxId" /></label>}<label><span>@L["Mobile"]</span><input @bind="Mobile" /></label><label><span>@B["Phone"]</span><input @bind="Phone" /></label><label><span>@L["Email"]</span><input type="email" @bind="Email" /></label><label><span>@B["Notes"]</span><textarea @bind="Notes"></textarea></label></div>
 @if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<div class="form-actions">@if(Id is Guid id){<a class="secondary-action" href="@($"/manage/customers/{id}/details")">@L["CustomerDetails"]</a><a class="secondary-action" href="@($"/business-profile/customer/{id}")">@B["BusinessProfile"]</a><button class="secondary-action" @onclick="Toggle">@(Active?L["Deactivate"]:L["Activate"])</button>}<button class="primary-link" @onclick="Save">@L["Save"]</button></div></section>
</div>
@code{
 private Guid?Id;private long Version;private bool Active=true,Success;private string Type="Person",Code="",FirstName="",LastName="",LegalName="",DisplayName="",NationalId="",RegistrationNo="",TaxId="",Mobile="",Phone="",Email="",Notes="",Search="";private string?Message;private List<Row>Rows=[];private IEnumerable<Row>Filtered=>string.IsNullOrWhiteSpace(Search)?Rows:Rows.Where(x=>(x.Code+x.Name+x.NationalId).Contains(Search,StringComparison.CurrentCultureIgnoreCase));
 protected override async Task OnInitializedAsync()=>await Load();private void New(){Id=null;Version=0;Type="Person";Code=FirstName=LastName=LegalName=DisplayName=NationalId=RegistrationNo=TaxId=Mobile=Phone=Email=Notes="";Active=true;}private void Select(Row x){Id=x.Id;Version=x.Version;Active=x.Active;Code=x.Code;Type=x.Type;DisplayName=x.Name;FirstName=x.First;LastName=x.Last;LegalName=x.Legal;NationalId=x.NationalId;RegistrationNo=x.RegistrationNo;TaxId=x.TaxId;Mobile=x.Mobile;Phone=x.Phone;Email=x.Email;Notes=x.Notes;}
 private async Task Load(){Rows=[];var s=await Session();if(s is null)return;var r=await Core.GetAsync("api/v1/customers?pageSize=100",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Show(r);return;}foreach(var x in r.Value.GetProperty("items").EnumerateArray())Rows.Add(new(x.GetProperty("id").GetGuid(),G(x,"customerCode"),G(x,"customerType"),G(x,"displayName"),G(x,"firstName"),G(x,"lastName"),G(x,"legalName"),G(x,"nationalId"),G(x,"registrationNo"),G(x,"taxId"),G(x,"primaryMobile"),G(x,"primaryPhone"),G(x,"primaryEmail"),G(x,"notes"),x.GetProperty("isActive").GetBoolean(),x.GetProperty("version").GetInt64()));}
 private async Task Save(){var s=await Session();if(s is null)return;object body=Id is null?new{customerCode=Code,customerType=Type,displayName=DisplayName,firstName=Type=="Person"?FirstName:null,lastName=Type=="Person"?LastName:null,legalName=Type=="Organization"?LegalName:null,nationalId=NationalId,registrationNo=Type=="Organization"?RegistrationNo:null,taxId=Type=="Organization"?TaxId:null,primaryMobile=Mobile,primaryPhone=Phone,primaryEmail=Email,notes=Notes}:new{displayName=DisplayName,firstName=Type=="Person"?FirstName:null,lastName=Type=="Person"?LastName:null,legalName=Type=="Organization"?LegalName:null,nationalId=NationalId,registrationNo=Type=="Organization"?RegistrationNo:null,taxId=Type=="Organization"?TaxId:null,primaryMobile=Mobile,primaryPhone=Phone,primaryEmail=Email,notes=Notes,version=Version};var r=await Core.SendAsync(Id is null?HttpMethod.Post:HttpMethod.Put,"api/v1/customers"+(Id is Guid id?$"/{id}":""),body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}
 private async Task Toggle(){var s=await Session();if(s is null||Id is not Guid id)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/customers/{id}/activation",new{isActive=!Active,version=Version},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private sealed record Row(Guid Id,string Code,string Type,string Name,string First,string Last,string Legal,string NationalId,string RegistrationNo,string TaxId,string Mobile,string Phone,string Email,string Notes,bool Active,long Version);
}
