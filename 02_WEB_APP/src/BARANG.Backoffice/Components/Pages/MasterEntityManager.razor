@page "/master/{Kind}"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@if(Kind=="suppliers"&&Id is Guid supplierId){<a class="secondary-action" href="@($"/master/suppliers/{supplierId}/products")">@L["LinkProduct"] · @L["Action_Lifecycle"]</a>}
<PageTitle>@L[$"Master_{Kind}"]</PageTitle><nav class="breadcrumbs"><a href="/workspace/master-data">@L["Module_master-data"]</a><span>/</span><span>@L[$"Master_{Kind}"]</span></nav><div class="page-heading"><div><h1>@L[$"Master_{Kind}"]</h1><p>@L["AuthoritativeCoreData"]</p></div><button class="primary-link" @onclick="New">@L["CreateNew"]</button></div>
<div class="management-grid"><section class="panel"><div class="record-list">@foreach(var x in Rows){<button class="record-row" @onclick="()=>Pick(x)"><span><strong>@x.Code</strong><small>@x.Name</small></span><span>@(x.Active?L["Active"]:L["Inactive"])</span></button>}</div></section><section class="panel"><div class="form-grid single"><label><span>@L["Code"]</span><input @bind="Code" disabled="@(Id is not null)" /></label><label><span>@L["Name"]</span><input @bind="Name" /></label>@if(Kind=="equipment"){<label><span>@L["EquipmentType"]</span><input @bind="Type" /></label><label><span>@L["Status"]</span><input @bind="Status" /></label><label><span>@L["Branch"]</span><input @bind="BranchId" placeholder="GUID" /></label>}@if(Kind=="suppliers"&&Id is not null){<label><span>@L["Product"]</span><input @bind="ProductId" placeholder="GUID" /></label><label><span>@L["Variant"]</span><input @bind="VariantId" placeholder="GUID" /></label><label><span>@L["SupplierItemCode"]</span><input @bind="ItemCode" /></label>}</div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<div class="form-actions">@if(Id is not null){<button class="secondary-action" @onclick="Toggle">@(Active?L["Deactivate"]:L["Activate"])</button>@if(Kind=="suppliers"){<button class="secondary-action" @onclick="LinkProduct">@L["LinkProduct"]</button>}}<button class="primary-link" @onclick="Save">@L["Save"]</button></div>@if(Links.Count>0){<div class="record-list">@foreach(var x in Links){<button class="record-row" @onclick="()=>PickLink(x)"><span><strong>@x.Code</strong><small>@x.Product</small></span><span>@(x.Active?L["Active"]:L["Inactive"])</span></button>}</div>}</section></div>
@code{[Parameter]public string Kind{get;set;}="suppliers";private Guid?Id,LinkId;private long Version,LinkVersion;private bool Active=true,Success;private string Code="",Name="",Type="EQUIPMENT",Status="AVAILABLE",BranchId="",ProductId="",VariantId="",ItemCode="";private string?Message;private List<Row>Rows=[];private List<LinkRow>Links=[];private string Base()=>Kind=="equipment"?"api/v1/equipment":"api/v1/suppliers";protected override async Task OnParametersSetAsync()=>await Load();private void New(){Id=LinkId=null;Version=LinkVersion=0;Active=true;Code=Name=BranchId=ProductId=VariantId=ItemCode="";}private void Pick(Row x){Id=x.Id;Version=x.Version;Active=x.Active;Code=x.Code;Name=x.Name;Type=x.Type;Status=x.Status;BranchId=x.Branch;_ = LoadLinks();}private void PickLink(LinkRow x){LinkId=x.Id;LinkVersion=x.Version;ProductId=x.ProductId;VariantId=x.VariantId;ItemCode=x.Code;}private async Task Load(){Rows=[];var s=await Session();if(s is null)return;var r=await Core.GetAsync(Base()+"?pageSize=100",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Show(r);return;}var root=r.Value.TryGetProperty("items",out var a)?a:r.Value;foreach(var x in root.EnumerateArray())Rows.Add(new(x.GetProperty("id").GetGuid(),G(x,Kind=="equipment"?"equipmentCode":"supplierCode"),G(x,Kind=="equipment"?"name":"displayName"),B(x,"isActive",true),N(x,"version"),G(x,"equipmentTypeCode"),G(x,"operationalStatusCode"),G(x,"branchId")));}private async Task LoadLinks(){Links=[];if(Kind!="suppliers"||Id is not Guid id)return;var s=await Session();if(s is null)return;var r=await Core.GetAsync($"{Base()}/{id}/products",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess)return;foreach(var x in r.Value.EnumerateArray())Links.Add(new(x.GetProperty("id").GetGuid(),G(x,"supplierItemCode"),G(x,"productName"),G(x,"productId"),G(x,"productVariantId"),B(x,"isActive",true),N(x,"version")));}private async Task Save(){var s=await Session();if(s is null)return;Guid?branch=Guid.TryParse(BranchId,out var b)?b:null;object body=Kind=="equipment"?new{equipmentCode=Code,name=Name,equipmentTypeCode=Type,operationalStatusCode=Status,branchId=branch,version=Version}:new{supplierCode=Code,displayName=Name,version=Version};var r=await Core.SendAsync(Id is null?HttpMethod.Post:HttpMethod.Put,Base()+(Id is Guid id?$"/{id}":""),body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private async Task Toggle(){var s=await Session();if(s is null||Id is not Guid id)return;var r=await Core.SendAsync(HttpMethod.Post,$"{Base()}/{id}/activation",new{isActive=!Active,version=Version},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private async Task LinkProduct(){var s=await Session();if(s is null||Id is not Guid id||!Guid.TryParse(ProductId,out var product))return;Guid?variant=Guid.TryParse(VariantId,out var v)?v:null;var body=new{productId=product,productVariantId=variant,supplierItemCode=ItemCode,isPreferred=false,version=LinkVersion};var path=$"{Base()}/{id}/products"+(LinkId is Guid link?$"/{link}":"");var r=await Core.SendAsync(LinkId is null?HttpMethod.Post:HttpMethod.Put,path,body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await LoadLinks();}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private static bool B(System.Text.Json.JsonElement x,string n,bool d=false)=>x.TryGetProperty(n,out var p)?p.GetBoolean():d;private static long N(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.GetInt64():0;private sealed record Row(Guid Id,string Code,string Name,bool Active,long Version,string Type,string Status,string Branch);private sealed record LinkRow(Guid Id,string Code,string Product,string ProductId,string VariantId,bool Active,long Version);}
