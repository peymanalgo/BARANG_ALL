@page "/manage/{Entity}"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L[$"Entity_{Entity}"] · BARANG</PageTitle><nav class="breadcrumbs"><a href="/">@L["Home"]</a><span>/</span><span>@L[$"Entity_{Entity}"]</span></nav><div class="page-heading"><div><h1>@L[$"Entity_{Entity}"]</h1><p>@L["AuthoritativeCoreData"]</p></div><button class="primary-link" @onclick="New">@L["CreateNew"]</button></div><div class="management-grid"><section class="panel"><div class="toolbar"><label><span>@L["Search"]</span><input @bind="Search" /></label><button class="secondary-action" @onclick="Load">@L["Refresh"]</button></div><div class="record-list">@foreach(var row in Filtered){<button class="record-row" @onclick="()=>Select(row)"><span><strong>@row.Code</strong><small>@row.Name</small></span><span>@(row.Active?L["Active"]:L["Inactive"])</span></button>}</div></section><section class="panel"><div class="form-grid single"><label><span>@L["Code"]</span><input @bind="Code" disabled="@(Id is not null)" /></label><label><span>@L["Name"]</span><input @bind="Name" /></label><label><span>@L["Classification"]</span><input @bind="Kind" /></label><label><span>@L["UnitOfMeasure"]</span><input @bind="Uom" /></label></div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<div class="form-actions">@if(Id is not null){<button class="secondary-action" @onclick="Toggle">@(Active?L["Deactivate"]:L["Activate"])</button>}<button class="primary-link" @onclick="Save">@L["Save"]</button></div></section></div>
@code{[Parameter]public string Entity{get;set;}="";private Guid?Id;private long Version;private bool Active=true,Success;private string?Code,Name,Kind,Uom,Search,Message;private List<Row>Rows=[];private IEnumerable<Row>Filtered=>string.IsNullOrWhiteSpace(Search)?Rows:Rows.Where(x=>(x.Code+x.Name).Contains(Search,StringComparison.CurrentCultureIgnoreCase));protected override async Task OnParametersSetAsync()=>await Load();private void New(){Id=null;Version=0;Code=Name=Kind=Uom=null;Active=true;}private void Select(Row x){Id=x.Id;Version=x.Version;Code=x.Code;Name=x.Name;Kind=x.Kind;Uom=x.Uom;Active=x.Active;}private string Base()=>Entity switch{"branch"=>"api/v1/organization/branches","product"=>"api/v1/products","customer"=>"api/v1/customers",_=>"api/v1/artworks"};private async Task Load(){Rows=[];var s=await Session();if(s is null)return;var r=await Core.GetAsync(Base()+(Entity is"product"or"customer"?"?pageSize=100":Entity=="artwork"?"?includeArchived=true&limit=100":""),s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Message=Err(r.Failure);return;}var root=r.Value;if(root.ValueKind==System.Text.Json.JsonValueKind.Object&&root.TryGetProperty("items",out var items))root=items;if(root.ValueKind!=System.Text.Json.JsonValueKind.Array)return;foreach(var x in root.EnumerateArray()){string code=G(x,Entity=="product"?"productCode":Entity=="customer"?"customerCode":"code"),name=G(x,Entity=="artwork"?"title":Entity=="product"?"name":"displayName");Rows.Add(new(x.GetProperty("id").GetGuid(),code,name,Entity=="artwork"?!B(x,"isArchived"):B(x,"isActive",true),N(x,"version"),G(x,Entity=="product"?"productTypeCode":Entity=="customer"?"customerType":"categoryCode"),G(x,"unitOfMeasureCode")));}}private async Task Save(){var s=await Session();if(s is null)return;object body=Entity switch{"branch"=>Id is null?new{code=Code,displayName=Name}:new{name=Name,version=Version},"product"=>new{productCode=Code,name=Name,productTypeCode=Kind,unitOfMeasureCode=Uom,version=Version},"customer"=>Id is null?new{customerCode=Code,customerType=Kind,displayName=Name}:new{displayName=Name,version=Version},_=>new{code=Code,title=Name,categoryCode=Kind,lifecycleStatus="Draft",version=Version}};var r=await Core.SendAsync(Id is null?HttpMethod.Post:HttpMethod.Put,Base()+(Id is Guid id?$"/{id}":""),body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private async Task Toggle(){if(Id is not Guid id)return;var s=await Session();if(s is null)return;string path=Entity switch{"branch"=>$"{Base()}/{id}/activation","product"=>$"{Base()}/{id}/activation","customer"=>$"{Base()}/{id}/activation",_=>$"{Base()}/{id}/archive"};object body=Entity=="artwork"?new{archived=Active,version=Version}:new{isActive=!Active,version=Version};var r=await Core.SendAsync(HttpMethod.Post,path,body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":Err(r.Failure);}private static string Err(ApiFailure f)=>f switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.ToString():"";private static bool B(System.Text.Json.JsonElement x,string n,bool d=false)=>x.TryGetProperty(n,out var p)?p.GetBoolean():d;private static long N(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.GetInt64():0;private sealed record Row(Guid Id,string Code,string Name,bool Active,long Version,string Kind,string Uom);}
