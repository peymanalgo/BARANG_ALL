@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject IJSRuntime JS
<a class="secondary-action" href="/manage/artwork-files/history">@L["Action_Version"] · @L["CurrentRecords"]</a>
<a class="secondary-action" href="/manage/artwork-files/tags">@L["ArtworkTags"] · @L["Action_Lifecycle"]</a>
<PageTitle>@L["Module_artwork-files"]</PageTitle><nav class="breadcrumbs"><a href="/workspace/artwork-files">@L["Module_artwork-files"]</a><span>/</span><span>@L["ManageRecords"]</span></nav><div class="page-heading"><div><h1>@L["Module_artwork-files"]</h1><p>@L["AuthoritativeCoreData"]</p></div></div>
@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}
<div class="management-grid"><section class="panel"><h2>@L["ArtworkTags"]</h2><div class="form-grid single"><label><span>@L["Code"]</span><input @bind="TagCode" /></label><label><span>@L["Name"]</span><input @bind="TagName" /></label><label><span>@L["Version"]</span><input type="number" @bind="TagVersion" /></label></div><div class="form-actions"><button class="primary-link" @onclick="SaveTag">@L["Save"]</button></div><h2>@L["Action_Upload"]</h2><InputFile OnChange="Upload" accept="image/png,image/jpeg,application/pdf"/><div class="record-list">@if(FileId is not null){<div class="record-row"><span><strong>@FileName</strong><small>@MediaType · @SizeBytes · @Hash</small><small>@L["ProcessingStatus"]: @Processing</small></span></div>}</div></section>
<section class="panel"><h2>@L["Action_Version"]</h2><div class="form-grid single"><label><span>@L["Artwork"]</span><input @bind="ArtworkId" placeholder="GUID" /></label><label><span>@L["File"]</span><input @bind="FileIdText" placeholder="GUID" /></label><label><span>@L["FileVersion"]</span><input @bind="FileVersionId" placeholder="GUID" /></label><label><span>@L["Notes"]</span><input @bind="Notes" /></label></div><div class="form-actions"><button class="secondary-action" @onclick="CreateVersion">@L["CreateArtworkVersion"]</button><button class="secondary-action" @onclick="LoadFile">@L["Refresh"]</button><button class="secondary-action" @onclick="Download">@L["SecureDownload"]</button></div><h2>@L["FileLink"]</h2><div class="form-grid single"><label><span>@L["EntityType"]</span><select @bind="EntityType"><option>Artwork</option><option>Product</option><option>Customer</option><option>Order</option><option>OrderItem</option><option>OrderPrintOperation</option></select></label><label><span>@L["EntityId"]</span><input @bind="EntityId" placeholder="GUID" /></label><label><span>@L["Purpose"]</span><select @bind="Purpose"><option>Source</option><option>Reference</option><option>Attachment</option><option>Proof</option></select></label></div><div class="form-actions"><button class="primary-link" @onclick="Link">@L["CreateLink"]</button></div><h2>@L["AssignTag"]</h2><div class="form-grid single"><label><span>@L["Tag"]</span><input @bind="TagId" placeholder="GUID" /></label></div><button class="secondary-action" @onclick="AssignTag">@L["AssignTag"]</button></section></div>
@code{private const long Max=25*1024*1024;private string TagCode="",TagName="",ArtworkId="",FileIdText="",FileVersionId="",Notes="",EntityType="Artwork",EntityId="",Purpose="Source",TagId="",FileName="",MediaType="",Hash="",Processing="";private long TagVersion,SizeBytes;private Guid?FileId;private bool Success;private string?Message;private async Task Upload(InputFileChangeEventArgs e){var s=await Session();if(s is null)return;var f=e.File;await using var stream=f.OpenReadStream(Max);var r=await Core.UploadAsync("api/v1/files/upload",f.Name,f.ContentType,stream,f.Size,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){FileId=r.Value.GetProperty("fileId").GetGuid();FileIdText=FileId.ToString()!;FileVersionId=G(r.Value,"fileVersionId");FileName=G(r.Value,"originalFileName");MediaType=G(r.Value,"mediaType");Hash=G(r.Value,"sha256Hash");Processing=G(r.Value,"processingStatus");SizeBytes=r.Value.TryGetProperty("sizeBytes",out var z)?z.GetInt64():0;}}private async Task LoadFile(){var s=await Session();if(s is null||!Guid.TryParse(FileIdText,out var id))return;var r=await Core.GetAsync($"api/v1/files/{id}",s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){FileId=id;FileName=G(r.Value,"originalFileName");Processing=G(r.Value,"processingStatus");if(r.Value.TryGetProperty("versions",out var vs)&&vs.ValueKind==System.Text.Json.JsonValueKind.Array){var v=vs.EnumerateArray().LastOrDefault();FileVersionId=G(v,"id");MediaType=G(v,"mediaType");Hash=G(v,"sha256Hash");SizeBytes=v.TryGetProperty("sizeBytes",out var z)?z.GetInt64():0;}}}private async Task SaveTag(){var s=await Session();if(s is null)return;var r=await Core.SendAsync(TagVersion==0?HttpMethod.Post:HttpMethod.Put,"api/v1/artwork-tags"+(TagVersion>0&&Guid.TryParse(TagId,out var id)?$"/{id}":""),new{code=TagCode,displayName=TagName,isActive=true,version=TagVersion},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){TagId=G(r.Value,"id");TagVersion=r.Value.TryGetProperty("version",out var v)?v.GetInt64():0;}}private async Task AssignTag(){var s=await Session();if(s is null||!Guid.TryParse(ArtworkId,out var a)||!Guid.TryParse(TagId,out var t))return;Show(await Core.SendAsync(HttpMethod.Post,$"api/v1/artworks/{a}/tags/{t}",null,s.Value.Token,s.Value.Company,default));}private async Task CreateVersion(){var s=await Session();if(s is null||!Guid.TryParse(ArtworkId,out var a)||!Guid.TryParse(FileVersionId,out var v))return;Show(await Core.SendAsync(HttpMethod.Post,$"api/v1/artworks/{a}/versions",new{fileVersionId=v,notes=Notes},s.Value.Token,s.Value.Company,default));}private async Task Link(){var s=await Session();if(s is null||!Guid.TryParse(FileIdText,out var f)||!Guid.TryParse(EntityId,out var e))return;Guid?version=Guid.TryParse(FileVersionId,out var v)?v:null;Show(await Core.SendAsync(HttpMethod.Post,$"api/v1/files/{f}/links",new{fileVersionId=version,entityType=EntityType,entityId=e,purpose=Purpose},s.Value.Token,s.Value.Company,default));}private async Task Download(){var s=await Session();if(s is null||!Guid.TryParse(FileIdText,out var f)||!Guid.TryParse(FileVersionId,out var v))return;var r=await Core.DownloadAsync($"api/v1/files/{f}/versions/{v}/download",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Success=false;Message=r.Failure==ApiFailure.Forbidden?"Unauthorized":"GenericError";return;}await JS.InvokeVoidAsync("open",$"data:{r.Value.ContentType};base64,{Convert.ToBase64String(r.Value.Content)}","_blank");}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.ValueKind==System.Text.Json.JsonValueKind.Object&&x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";}
