@page "/manage/customers/{CustomerId:guid}/details"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["CustomerDetails"]</PageTitle>
<nav class="breadcrumbs"><a href="/manage/customers">@L["Module_customers"]</a><span>/</span><span>@L["CustomerDetails"]</span></nav>
@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}
<div class="management-grid">
 <section class="panel"><h2>@L["Action_Contact"]</h2><div class="record-list">@foreach(var x in Contacts){<button class="record-row" @onclick="()=>Pick(x)"><span><strong>@x.Name</strong><small>@x.Mobile · @x.Email</small></span><span>@(x.Active?L["Active"]:L["Inactive"])</span></button>}</div><div class="form-grid single"><label><span>@L["ContactType"]</span><input @bind="ContactType" /></label><label><span>@L["Name"]</span><input @bind="ContactName" /></label><label><span>@L["Mobile"]</span><input @bind="ContactMobile" /></label><label><span>@L["Email"]</span><input @bind="ContactEmail" /></label></div><div class="form-actions">@if(ContactId is not null){<button class="secondary-action" @onclick="ToggleContact">@(ContactActive?L["Deactivate"]:L["Activate"])</button>}<button class="secondary-action" @onclick="NewContact">@L["CreateNew"]</button><button class="primary-link" @onclick="SaveContact">@L["Save"]</button></div></section>
 <section class="panel"><h2>@L["Action_Address"]</h2><div class="record-list">@foreach(var x in Addresses){<button class="record-row" @onclick="()=>Pick(x)"><span><strong>@x.Title</strong><small>@x.City · @x.Line</small></span><span>@(x.Active?L["Active"]:L["Inactive"])</span></button>}</div><div class="form-grid single"><label><span>@L["AddressType"]</span><input @bind="AddressType" /></label><label><span>@L["Title"]</span><input @bind="AddressTitle" /></label><label><span>@L["CountryCode"]</span><input @bind="Country" /></label><label><span>@L["City"]</span><input @bind="City" /></label><label><span>@L["AddressLine"]</span><input @bind="Line" /></label></div><div class="form-actions">@if(AddressId is not null){<button class="secondary-action" @onclick="ToggleAddress">@(AddressActive?L["Deactivate"]:L["Activate"])</button>}<button class="secondary-action" @onclick="NewAddress">@L["CreateNew"]</button><button class="primary-link" @onclick="SaveAddress">@L["Save"]</button></div></section>
</div>
@code {
 [Parameter]public Guid CustomerId{get;set;} private List<ContactRow>Contacts=[];private List<AddressRow>Addresses=[];private Guid?ContactId,AddressId;private long ContactVersion,AddressVersion;private bool ContactActive=true,AddressActive=true,Success;private string ContactType="PRIMARY",ContactName="",ContactMobile="",ContactEmail="",AddressType="SHIPPING",AddressTitle="",Country="IR",City="",Line="";private string?Message;
 protected override async Task OnParametersSetAsync()=>await Load();
 private async Task Load(){var s=await Session();if(s is null)return;var c=await Core.GetAsync($"api/v1/customers/{CustomerId}/contacts",s.Value.Token,s.Value.Company,default);if(c.IsSuccess)Contacts=c.Value.EnumerateArray().Select(x=>new ContactRow(x.GetProperty("id").GetGuid(),G(x,"name"),G(x,"mobile"),G(x,"email"),x.GetProperty("isActive").GetBoolean(),x.GetProperty("version").GetInt64(),G(x,"contactTypeCode"))).ToList();else Show(c);var a=await Core.GetAsync($"api/v1/customers/{CustomerId}/addresses",s.Value.Token,s.Value.Company,default);if(a.IsSuccess)Addresses=a.Value.EnumerateArray().Select(x=>new AddressRow(x.GetProperty("id").GetGuid(),G(x,"title"),G(x,"city"),G(x,"addressLine1"),x.GetProperty("isActive").GetBoolean(),x.GetProperty("version").GetInt64(),G(x,"addressTypeCode"),G(x,"countryCode"))).ToList();else Show(a);}
 private void Pick(ContactRow x){ContactId=x.Id;ContactVersion=x.Version;ContactActive=x.Active;ContactType=x.Type;ContactName=x.Name;ContactMobile=x.Mobile;ContactEmail=x.Email;} private void NewContact(){ContactId=null;ContactVersion=0;ContactActive=true;ContactType="PRIMARY";ContactName=ContactMobile=ContactEmail="";}
 private void Pick(AddressRow x){AddressId=x.Id;AddressVersion=x.Version;AddressActive=x.Active;AddressType=x.Type;AddressTitle=x.Title;Country=x.Country;City=x.City;Line=x.Line;} private void NewAddress(){AddressId=null;AddressVersion=0;AddressActive=true;AddressType="SHIPPING";AddressTitle=City=Line="";Country="IR";}
 private async Task SaveContact(){var s=await Session();if(s is null)return;var body=new{contactTypeCode=ContactType,name=ContactName,mobile=ContactMobile,email=ContactEmail,isPrimary=false,displayOrder=0,version=ContactVersion};var r=await Core.SendAsync(ContactId is null?HttpMethod.Post:HttpMethod.Put,$"api/v1/customers/{CustomerId}/contacts"+(ContactId is Guid id?$"/{id}":""),body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){NewContact();await Load();}}
 private async Task ToggleContact(){var s=await Session();if(s is null||ContactId is not Guid id)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/customers/{CustomerId}/contacts/{id}/activation",new{isActive=!ContactActive,version=ContactVersion},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}
 private async Task SaveAddress(){var s=await Session();if(s is null)return;var body=new{addressTypeCode=AddressType,title=AddressTitle,countryCode=Country,city=City,addressLine1=Line,isPrimary=false,displayOrder=0,version=AddressVersion};var r=await Core.SendAsync(AddressId is null?HttpMethod.Post:HttpMethod.Put,$"api/v1/customers/{CustomerId}/addresses"+(AddressId is Guid id?$"/{id}":""),body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){NewAddress();await Load();}}
 private async Task ToggleAddress(){var s=await Session();if(s is null||AddressId is not Guid id)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/customers/{CustomerId}/addresses/{id}/activation",new{isActive=!AddressActive,version=AddressVersion},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}
 private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}
 private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";
 private sealed record ContactRow(Guid Id,string Name,string Mobile,string Email,bool Active,long Version,string Type);private sealed record AddressRow(Guid Id,string Title,string City,string Line,bool Active,long Version,string Type,string Country);
}
