@page "/admin/{Kind}"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L[$"Admin_{Kind}"]</PageTitle><nav class="breadcrumbs"><a href="/workspace/foundation">@L["Module_foundation"]</a><span>/</span><span>@L[$"Admin_{Kind}"]</span></nav><div class="page-heading"><div><h1>@L[$"Admin_{Kind}"]</h1><p>@L["AuthoritativeCoreData"]</p></div><button class="primary-link" @onclick="New">@L["CreateNew"]</button></div><div class="management-grid"><section class="panel"><div class="toolbar"><label><span>@L["Search"]</span><input @bind="Search" /></label><button class="secondary-action" @onclick="Load">@L["Refresh"]</button></div><div class="record-list">@foreach(var x in Filtered){<button class="record-row" @onclick="()=>Pick(x)"><span><strong>@x.Code</strong><small>@x.Name</small></span><span>@(x.Active?L["Active"]:L["Inactive"])</span></button>}</div></section><section class="panel"><div class="form-grid single"><label><span>@L["Code"]</span><input @bind="Code" disabled="@(Id is not null)" /></label><label><span>@L["Name"]</span><input @bind="Name" /></label>@if(Kind=="settings"){<label><span>@L["ValueType"]</span><select @bind="EnumValue"><option value="0">Text</option><option value="1">Boolean</option><option value="2">WholeNumber</option><option value="3">DecimalNumber</option></select></label>}@if(Kind=="units"||Kind=="warehouses"){<label><span>@L["Branch"]</span><select @bind="BranchId"><option value="">@L["Choose"]</option>@foreach(var b in Branches){<option value="@b.Id">@b.Name</option>}</select></label>}@if(Kind=="units"){<label><span>@L["Parent"]</span><select @bind="ParentId"><option value="">@L["Choose"]</option>@foreach(var u in UnitOptions){<option value="@u.Id">@u.Name</option>}</select></label>}@if(Kind=="warehouses"){<label><span>@L["Classification"]</span><select @bind="EnumValue"><option value="0">RawMaterials</option><option value="1">WorkInProcess</option><option value="2">FinishedGoods</option><option value="3">Shipping</option><option value="4">Returns</option><option value="5">Scrap</option></select></label>}</div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<div class="form-actions">@if(Id is not null){<button class="secondary-action" @onclick="Toggle">@(Active?L["Deactivate"]:L["Activate"])</button>}<button class="primary-link" @onclick="Save">@L["Save"]</button></div></section></div>
@code{[Parameter]public string Kind{get;set;}="settings";private Guid?Id;private long Version;private int EnumValue;private bool Active=true,Success;private string Code="",Name="",BranchId="",ParentId="",Search="";private string?Message;private List<Row>Rows=[];private List<Option>Branches=[],UnitOptions=[];private IEnumerable<Row>Filtered=>string.IsNullOrWhiteSpace(Search)?Rows:Rows.Where(x=>(x.Code+x.Name).Contains(Search,StringComparison.OrdinalIgnoreCase));private string Base()=>Kind switch{"settings"=>"api/v1/organization/settings","units"=>"api/v1/organization/organizational-units",_=>"api/v1/organization/warehouses"};protected override async Task OnParametersSetAsync(){await LoadOptions();await Load();}private void New(){Id=null;Version=EnumValue=0;Active=true;Code=Name=BranchId=ParentId="";}private void Pick(Row x){Id=x.Id;Version=x.Version;Active=x.Active;Code=x.Code;Name=x.Name;EnumValue=x.EnumValue;BranchId=x.BranchId;ParentId=x.ParentId;}private async Task LoadOptions(){var s=await Session();if(s is null)return;var b=await Core.GetAsync("api/v1/organization/branches",s.Value.Token,s.Value.Company,default);if(b.IsSuccess)Branches=b.Value.EnumerateArray().Where(x=>x.GetProperty("isActive").GetBoolean()).Select(x=>new Option(x.GetProperty("id").GetGuid(),x.GetProperty("displayName").ToString())).ToList();var u=await Core.GetAsync("api/v1/organization/organizational-units",s.Value.Token,s.Value.Company,default);if(u.IsSuccess)UnitOptions=u.Value.EnumerateArray().Where(x=>x.GetProperty("isActive").GetBoolean()).Select(x=>new Option(x.GetProperty("id").GetGuid(),x.GetProperty("displayName").ToString())).ToList();}private async Task Load(){Rows=[];var s=await Session();if(s is null)return;var r=await Core.GetAsync(Base(),s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Show(r);return;}foreach(var x in r.Value.EnumerateArray())Rows.Add(new(x.GetProperty("id").GetGuid(),G(x,Kind=="settings"?"key":"code"),G(x,Kind=="settings"?"value":Kind=="units"?"displayName":"name"),B(x,"isActive",true),N(x,"version"),I(x,Kind=="settings"?"valueType":"type"),G(x,"branchId"),G(x,"parentId")));}private async Task Save(){var s=await Session();if(s is null)return;Guid?branch=Guid.TryParse(BranchId,out var b)?b:null,parent=Guid.TryParse(ParentId,out var p)?p:null;object body=Kind switch{"settings"=>Id is null?new{key=Code,value=Name,valueType=EnumValue}:new{value=Name,valueType=EnumValue,version=Version},"units"=>Id is null?new{code=Code,displayName=Name,branchId=branch,parentId=parent}:new{displayName=Name,branchId=branch,parentId=parent,version=Version},_=>Id is null?new{code=Code,name=Name,type=EnumValue,branchId=branch}:new{name=Name,type=EnumValue,branchId=branch,version=Version}};var r=await Core.SendAsync(Id is null?HttpMethod.Post:HttpMethod.Put,Base()+(Id is Guid id?$"/{id}":""),body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private async Task Toggle(){var s=await Session();if(s is null||Id is not Guid id)return;string suffix=Kind=="settings"?"deactivation":"activation";object body=Kind=="settings"?new{version=Version}:new{isActive=!Active,version=Version};var r=await Core.SendAsync(HttpMethod.Put,$"{Base()}/{id}/{suffix}",body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private static bool B(System.Text.Json.JsonElement x,string n,bool d=false)=>x.TryGetProperty(n,out var p)?p.GetBoolean():d;private static long N(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.GetInt64():0;private static int I(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.TryGetInt32(out var v)?v:0;private sealed record Row(Guid Id,string Code,string Name,bool Active,long Version,int EnumValue,string BranchId,string ParentId);private sealed record Option(Guid Id,string Name);}
