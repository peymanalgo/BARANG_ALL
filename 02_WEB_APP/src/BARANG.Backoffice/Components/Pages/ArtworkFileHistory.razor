@page "/manage/artwork-files/history"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["Action_Version"]</PageTitle><nav class="breadcrumbs"><a href="/manage/artwork-files">@L["Module_artwork-files"]</a><span>/</span><span>@L["Action_Version"]</span></nav><div class="management-grid"><section class="panel"><h2>@L["Artwork"] · @L["Action_Version"]</h2><label><span>@L["Artwork"]</span><input @bind="ArtworkId" placeholder="GUID" /></label><button class="secondary-action" @onclick="LoadArtwork">@L["Refresh"]</button><div class="record-list">@foreach(var x in ArtworkVersions){<div class="record-row"><span><strong>v@x.Number</strong><small>@x.FileVersionId</small><small>@x.Notes · @x.Created</small></span></div>}</div></section><section class="panel"><h2>@L["File"] · @L["Action_Version"]</h2><label><span>@L["File"]</span><input @bind="FileId" placeholder="GUID" /></label><button class="secondary-action" @onclick="LoadFile">@L["Refresh"]</button><div class="record-list">@foreach(var x in FileVersions){<div class="record-row"><span><strong>v@x.Number · @x.Name</strong><small>@x.Media · @x.Size · @x.Hash</small><small>@L["ProcessingStatus"]: @x.Processing · @(x.Archived?L["Inactive"]:L["Active"])</small></span></div>}</div></section></div>
@code{private string ArtworkId="",FileId="";private List<ArtworkVersionRow>ArtworkVersions=[];private List<FileVersionRow>FileVersions=[];private async Task LoadArtwork(){ArtworkVersions=[];var s=await Session();if(s is null||!Guid.TryParse(ArtworkId,out var id))return;var r=await Core.GetAsync($"api/v1/artworks/{id}/versions",s.Value.Token,s.Value.Company,default);if(r.IsSuccess)ArtworkVersions=r.Value.EnumerateArray().Select(x=>new ArtworkVersionRow(x.GetProperty("versionNumber").GetInt32(),x.GetProperty("fileVersionId").GetGuid(),G(x,"notes"),G(x,"createdAtUtc"))).ToList();}private async Task LoadFile(){FileVersions=[];var s=await Session();if(s is null||!Guid.TryParse(FileId,out var id))return;var r=await Core.GetAsync($"api/v1/files/{id}",s.Value.Token,s.Value.Company,default);if(r.IsSuccess&&r.Value.TryGetProperty("versions",out var versions))FileVersions=versions.EnumerateArray().Select(x=>new FileVersionRow(x.GetProperty("versionNumber").GetInt32(),G(x,"originalFileName"),G(x,"mediaType"),x.GetProperty("sizeBytes").GetInt64(),G(x,"sha256Hash"),G(x,"processingStatus"),x.GetProperty("isArchived").GetBoolean())).ToList();}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private sealed record ArtworkVersionRow(int Number,Guid FileVersionId,string Notes,string Created);private sealed record FileVersionRow(int Number,string Name,string Media,long Size,string Hash,string Processing,bool Archived);}
