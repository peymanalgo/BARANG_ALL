@page "/manage/artwork-files/tags"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["ArtworkTags"]</PageTitle><nav class="breadcrumbs"><a href="/manage/artwork-files">@L["Module_artwork-files"]</a><span>/</span><span>@L["ArtworkTags"]</span></nav><section class="panel"><p>@L["TagApiLimitation"]</p><div class="form-grid single"><label><span>@L["EntityId"]</span><input @bind="TagId" placeholder="GUID" /></label><label><span>@L["Name"]</span><input @bind="Name" /></label><label><span>@L["Version"]</span><input type="number" @bind="Version" /></label><label><span>@L["Active"]</span><input type="checkbox" @bind="Active" /></label></div><button class="primary-link" @onclick="Save">@L["Save"]</button>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}</section>
@code{private string TagId="",Name="";private long Version;private bool Active=true,Success;private string?Message;private async Task Save(){var s=await Session();if(s is null||!Guid.TryParse(TagId,out var id))return;var r=await Core.SendAsync(HttpMethod.Put,$"api/v1/artwork-tags/{id}",new{displayName=Name,isActive=Active,version=Version},s.Value.Token,s.Value.Company,default);Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};if(r.IsSuccess&&r.Value.TryGetProperty("version",out var v))Version=v.GetInt64();}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}}
