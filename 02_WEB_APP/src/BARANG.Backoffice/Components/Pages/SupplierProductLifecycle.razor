@page "/master/suppliers/{SupplierId:guid}/products"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["LinkProduct"]</PageTitle><nav class="breadcrumbs"><a href="/master/suppliers">@L["Master_suppliers"]</a><span>/</span><span>@L["LinkProduct"]</span></nav><section class="panel"><div class="record-list">@foreach(var x in Rows){<div class="record-row"><span><strong>@x.Code</strong><small>@x.ProductId</small></span><button class="secondary-action" @onclick="()=>Toggle(x)">@(x.Active?L["Deactivate"]:L["Activate"])</button></div>}</div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}</section>
@code{[Parameter]public Guid SupplierId{get;set;}private List<Row>Rows=[];private bool Success;private string?Message;protected override async Task OnParametersSetAsync()=>await Load();private async Task Load(){var s=await Session();if(s is null)return;var r=await Core.GetAsync($"api/v1/suppliers/{SupplierId}/products",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Show(r);return;}Rows=r.Value.EnumerateArray().Select(x=>new Row(x.GetProperty("id").GetGuid(),G(x,"supplierItemCode"),G(x,"productId"),x.GetProperty("isActive").GetBoolean(),x.GetProperty("version").GetInt64())).ToList();}private async Task Toggle(Row x){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/suppliers/{SupplierId}/products/{x.Id}/activation",new{isActive=!x.Active,version=x.Version},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private sealed record Row(Guid Id,string Code,string ProductId,bool Active,long Version);}
