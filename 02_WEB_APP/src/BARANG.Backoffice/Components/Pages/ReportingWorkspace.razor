@page "/workspace/reports"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates
<PageTitle>@L["Module_reports"]</PageTitle><div class="page-heading"><h1>@L["Module_reports"]</h1></div>@if(Message is not null){<div class="inline-error">@L[Message]</div>}<section class="toolbar"><label><span>@L["OrderDate"]</span><input @bind="From" /></label><label><span>@L["RequestedDelivery"]</span><input @bind="To" /></label><label><span>@L["EntityId"]</span><input @bind="Entity" /></label><label><span>@L["Search"]</span><input @bind="Search" /></label><label><span>@L["PageSize"]</span><select @bind="PageSize"><option value="10">10</option><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></label><button @onclick="Refresh">@L["Refresh"]</button></section><nav class="toolbar" aria-label="@L["Pagination"]"><button disabled="@(Page==1)" @onclick="Previous">@L["Previous"]</button><span>@L["Page"] @Page</span><button @onclick="Next">@L["Next"]</button></nav><div class="management-grid"><section class="panel"><h2>@L["Module_orders"]</h2><pre>@Orders</pre></section><section class="panel"><h2>@L["Module_finance"]</h2><pre>@Finance</pre></section><section class="panel"><h2>@L["Module_inventory"]</h2><pre>@Inventory</pre></section><section class="panel"><h2>@L["Module_production"]</h2><pre>@Production</pre></section><section class="panel"><h2>@L["Module_quality"]</h2><pre>@Quality</pre></section><section class="panel"><h2>@L["Module_logistics"]</h2><pre>@Logistics</pre></section></div>
@code{private string From="",To="",Entity="",Search="",Orders="",Finance="",Inventory="",Production="",Quality="",Logistics="";private int Page=1,PageSize=25;private string?Message;protected override async Task OnInitializedAsync(){var culture=System.Globalization.CultureInfo.CurrentUICulture.Name;From=Dates.Format(DateOnly.FromDateTime(DateTime.Today.AddMonths(-1)),culture);To=Dates.Format(DateOnly.FromDateTime(DateTime.Today.AddDays(1)),culture);await Load();}private async Task Refresh(){Page=1;await Load();}private async Task Previous(){if(Page>1)Page--;await Load();}private async Task Next(){Page++;await Load();}private async Task Load(){if(!Dates.TryParse(From,System.Globalization.CultureInfo.CurrentUICulture.Name,out var from)||!Dates.TryParse(To,System.Globalization.CultureInfo.CurrentUICulture.Name,out var to)){Message="ValidationError";return;}Message=null;Orders=await Text($"api/v1/orders?page={Page}&pageSize={PageSize}&customerSearch={Uri.EscapeDataString(Search)}&orderDateFrom={from:yyyy-MM-dd}&orderDateTo={to:yyyy-MM-dd}");Inventory=await Text("api/v1/inventory/balances");Production=await Text($"api/v1/production/jobs?page={Page}&pageSize={PageSize}&plannedDate={from:yyyy-MM-dd}");Quality=await Text($"api/v1/quality/analytics?from={Uri.EscapeDataString(new DateTimeOffset(from.ToDateTime(TimeOnly.MinValue),TimeSpan.Zero).ToString("O"))}&to={Uri.EscapeDataString(new DateTimeOffset(to.ToDateTime(TimeOnly.MinValue),TimeSpan.Zero).ToString("O"))}&top={PageSize}");if(Guid.TryParse(Entity,out _)){Finance=await Text($"api/v1/orders/{Entity}/finance/balance");Logistics=await Text($"api/v1/logistics/shipments/{Entity}/history");}else{Finance=Logistics="";}}private async Task<string>Text(string path){var u=(await AuthState.GetAuthenticationStateAsync()).User;if(!Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)||u.FindFirst(AuthClaimTypes.AccessToken)?.Value is not string t)return"";var r=await Core.GetAsync(path,t,c,default);return r.IsSuccess?r.Value.ToString():"";}}
