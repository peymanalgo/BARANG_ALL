@page "/workspace/orders"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["Module_orders"]</PageTitle><div class="page-heading"><h1>@L["Module_orders"]</h1><a class="primary-link" href="/orders/new">@L["NewOrder"]</a></div>@if(Message is not null){<div class="inline-error">@L[Message]</div>}<section class="toolbar"><label><span>@L["Search"]</span><input @bind="Search" /></label><label><span>@L["Status"]</span><select @bind="Status"><option value=""></option><option>Draft</option><option>Submitted</option><option>Cancelled</option></select></label><button class="secondary-action" @onclick="Load">@L["Refresh"]</button></section><section class="panel"><div class="record-list">@foreach(var x in Orders){<a class="record-row" href="@($"/orders/{x.Id}")"><span><strong>@(x.Number??x.Id.ToString())</strong><small>@x.Customer · @x.Date</small></span><span>@x.Status</span></a>}</div><div class="form-actions"><button disabled="@(Page<=1)" @onclick="Prev">‹</button><span>@Page / @Math.Max(1,(Total+19)/20)</span><button disabled="@(Page*20>=Total)" @onclick="Next">›</button></div></section>
@code{private string Search="",Status="";private int Page=1;private long Total;private string?Message;private List<Row>Orders=[];protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){var s=await Session();if(s is null)return;var q=$"api/v1/orders?page={Page}&pageSize=20&customerSearch={Uri.EscapeDataString(Search)}&orderNumber={Uri.EscapeDataString(Search)}"+(string.IsNullOrWhiteSpace(Status)?"":$"&status={Status}");var r=await Core.GetAsync(q,s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Message=r.Failure==ApiFailure.Forbidden?"Unauthorized":"GenericError";return;}Total=r.Value.GetProperty("totalCount").GetInt64();Orders=r.Value.GetProperty("items").EnumerateArray().Select(x=>new Row(x.GetProperty("id").GetGuid(),G(x,"orderNumber"),G(x,"customerName"),G(x,"orderDate"),G(x,"status"))).ToList();}private async Task Prev(){Page--;await Load();}private async Task Next(){Page++;await Load();}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string?G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():null;private sealed record Row(Guid Id,string?Number,string?Customer,string?Date,string?Status);}
