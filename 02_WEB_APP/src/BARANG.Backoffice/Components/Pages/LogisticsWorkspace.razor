@page "/workspace/logistics"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
@inject ILocaleDateService Dates
<PageTitle>@L["Module_logistics"]</PageTitle><div class="page-heading"><h1>@L["Module_logistics"]</h1></div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<div class="management-grid"><section class="panel"><h2>@L["Action_Package"]</h2><div class="form-grid single"><label><span>@L["Module_orders"]</span><input @bind="Order" /></label><label><span>@L["EntityId"]</span><input @bind="Package" /></label><label><span>@L["Wizard_Items"]</span><input @bind="Item" /></label><label><span>@L["Quantity"]</span><input type="number" @bind="Quantity" /></label><label><span>@L["Version"]</span><input type="number" @bind="PackageVersion" /></label></div><div class="form-actions"><button @onclick="CreatePackage">@L["Action_Create"]</button><button @onclick="LoadPackage">@L["Refresh"]</button><button @onclick="AddItem">@L["Wizard_Items"]</button><button @onclick="CompletePackage">@L["Action_Complete"]</button></div><pre>@PackageData</pre></section><section class="panel"><h2>@L["Warehouse"]</h2><label><span>@L["Warehouse"]</span><input @bind="Warehouse" /></label><label><span>@L["EntityId"]</span><input @bind="Handoff" /></label><label><span>@L["Version"]</span><input type="number" @bind="HandoffVersion" /></label><div class="form-actions"><button @onclick="ReceiveHandoff">@L["Action_Receipt"]</button><button @onclick="ReleaseHandoff">@L["Action_Release"]</button></div></section></div><section class="panel"><h2>@L["Action_Shipment"]</h2><div class="form-grid"><label><span>@L["EntityId"]</span><input @bind="Shipment" /></label><label><span>@L["Code"]</span><input @bind="Carrier" /></label><label><span>@L["Method"]</span><input @bind="ShippingMethod" /></label><label><span>@L["RequestedDelivery"]</span><input @bind="ExpectedDate" /></label><label><span>@L["ExternalReference"]</span><input @bind="Tracking" /></label><label><span>@L["Version"]</span><input type="number" @bind="ShipmentVersion" /></label><label><span>@L["Reason"]</span><input @bind="Reason" /></label></div><div class="form-actions"><button @onclick="CreateShipment">@L["Action_Create"]</button><button @onclick="LoadShipment">@L["Refresh"]</button><button @onclick="RegisterTracking">@L["Save"]</button><button @onclick="Ship">@L["Action_Shipment"]</button><button @onclick="Transit">@L["Action_Transfer"]</button><button @onclick="Deliver">@L["Action_Delivery"]</button><button @onclick="Failed">@L["ValidationError"]</button><button @onclick="Returned">@L["Action_Release"]</button></div><pre>@ShipmentData</pre><pre>@History</pre></section>
@code{private string Order="",Package="",Item="",Warehouse="",Handoff="",Shipment="",Carrier="LOCAL",ShippingMethod="STANDARD",ExpectedDate="",Tracking="",Reason="Backoffice logistics",PackageData="",ShipmentData="",History="";private decimal Quantity=1;private long PackageVersion,HandoffVersion,ShipmentVersion;private bool Success;private string?Message;private Task CreatePackage()=>Post("api/v1/logistics/packages",new{orderId=Order,packageTypeCode="BOX",weightKg=1,lengthCm=10,widthCm=10,heightCm=10});private async Task LoadPackage(){var r=await Get($"api/v1/logistics/packages/{Package}");if(r.IsSuccess){PackageData=r.Value.ToString();PackageVersion=N(r.Value);}}private Task AddItem()=>Post($"api/v1/logistics/packages/{Package}/items",new{orderItemId=Item,quantity=Quantity});private Task CompletePackage()=>Post($"api/v1/logistics/packages/{Package}/complete",new{version=PackageVersion});private Task ReceiveHandoff()=>Post($"api/v1/logistics/packages/{Package}/handoff",new{warehouseId=Warehouse,packageVersion=PackageVersion});private Task ReleaseHandoff()=>Post($"api/v1/logistics/handoffs/{Handoff}/release",new{handoffVersion=HandoffVersion,packageVersion=PackageVersion});private Task CreateShipment()=>Post("api/v1/logistics/shipments",new{orderId=Order,packageIds=new[]{Package},carrierCode=Carrier,shippingMethodCode=ShippingMethod,expectedDeliveryDate=ApiDate(ExpectedDate)});private async Task LoadShipment(){var r=await Get($"api/v1/logistics/shipments/{Shipment}");if(r.IsSuccess){ShipmentData=r.Value.ToString();ShipmentVersion=N(r.Value);var h=await Get($"api/v1/logistics/shipments/{Shipment}/history");History=h.IsSuccess?h.Value.ToString():"";}}private Task RegisterTracking()=>Put($"api/v1/logistics/shipments/{Shipment}/tracking",new{trackingCode=Tracking,version=ShipmentVersion});private Task Ship()=>Post($"api/v1/logistics/shipments/{Shipment}/ship",new{version=ShipmentVersion});private Task Transit()=>Post($"api/v1/logistics/shipments/{Shipment}/in-transit",new{version=ShipmentVersion});private Task Deliver()=>Post($"api/v1/logistics/shipments/{Shipment}/deliver",new{version=ShipmentVersion});private Task Failed()=>Post($"api/v1/logistics/shipments/{Shipment}/failed-delivery",new{reasonCode="FAILED",reasonText=Reason,version=ShipmentVersion});private Task Returned()=>Post($"api/v1/logistics/shipments/{Shipment}/return",new{warehouseId=Warehouse,reasonCode="RETURNED",reasonText=Reason,version=ShipmentVersion});private string?ApiDate(string v)=>Dates.TryParse(v,System.Globalization.CultureInfo.CurrentUICulture.Name,out var d)?d.ToString("yyyy-MM-dd"):null;private Task<ApiResult<System.Text.Json.JsonElement>>Get(string p)=>Send(HttpMethod.Get,p,null);private Task Post(string p,object b)=>Mutate(HttpMethod.Post,p,b);private Task Put(string p,object b)=>Mutate(HttpMethod.Put,p,b);private async Task Mutate(HttpMethod m,string p,object b){var r=await Send(m,p,b);Show(r);if(r.IsSuccess&&r.Value.ValueKind==System.Text.Json.JsonValueKind.Object){var id=G(r.Value,"id");if(p.Contains("handoff")){Handoff=id;HandoffVersion=N(r.Value);}else if(p.Contains("shipment")){Shipment=id;ShipmentVersion=N(r.Value);ShipmentData=r.Value.ToString();}else{Package=id;PackageVersion=N(r.Value);PackageData=r.Value.ToString();}}}private async Task<ApiResult<System.Text.Json.JsonElement>>Send(HttpMethod m,string p,object?b){var s=await Session();return s is null?ApiResult<System.Text.Json.JsonElement>.Failed(ApiFailure.Unauthorized): m==HttpMethod.Get?await Core.GetAsync(p,s.Value.Token,s.Value.Company,default):await Core.SendAsync(m,p,b,s.Value.Token,s.Value.Company,default);}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.ToString():"";private static long N(System.Text.Json.JsonElement x)=>x.TryGetProperty("version",out var p)?p.GetInt64():0;}
