@page "/workspace/notifications"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["CurrentRecords"]</PageTitle><div class="page-heading"><h1>@L["CurrentRecords"]</h1></div>
@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}
<section class="toolbar"><label><span>@L["Status"]</span><select @bind="Unread"><option value="">@L["All"]</option><option value="true">@L["Active"]</option><option value="false">@L["Inactive"]</option></select></label><button @onclick="Load">@L["Refresh"]</button><button @onclick="MarkAll">@L["Action_Complete"]</button></section>
<section class="panel">@if(Loading){<div class="state-box">@L["Loading"]</div>}else if(Rows.Length==0){<div class="state-box">@L["NoRecords"]</div>}else{<div class="record-list">@foreach(var row in Rows){<article class="record-row"><span><strong>@Text(row,"templateCode")</strong><small>@Text(row,"createdAtUtc") · @Text(row,"status")</small><small>@Text(row,"payload")</small></span>@if(Text(row,"status")!="Read"){<button @onclick="()=>Mark(row)">@L["Action_Complete"]</button>}</article>}</div>}</section>
@code{private System.Text.Json.JsonElement[]Rows=[];private bool Loading=true,Success;private string Unread="";private string?Message;protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){Loading=true;var s=await Session();if(s is null)return;var q=string.IsNullOrEmpty(Unread)?"":$"&unread={Unread}";var r=await Core.GetAsync($"api/v1/notifications/mine?page=1&pageSize=100{q}",s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)Rows=Items(r.Value);Loading=false;}private async Task Mark(System.Text.Json.JsonElement row)=>await Act($"api/v1/notifications/{Text(row,"id")}/read",new{version=Number(row,"version")});private async Task MarkAll()=>await Act("api/v1/notifications/read-all",new{});private async Task Act(string p,object b){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,p,b,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?null:r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static System.Text.Json.JsonElement[]Items(System.Text.Json.JsonElement x){if(x.ValueKind==System.Text.Json.JsonValueKind.Array)return x.EnumerateArray().ToArray();foreach(var n in new[]{"items","data"})if(x.TryGetProperty(n,out var a)&&a.ValueKind==System.Text.Json.JsonValueKind.Array)return a.EnumerateArray().ToArray();return[];}private static string Text(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.ToString():"";private static long Number(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.TryGetInt64(out var v)?v:0;}
