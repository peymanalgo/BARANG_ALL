@page "/admin/security/users/{UserId:guid}/access"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["GrantAccess"]</PageTitle><nav class="breadcrumbs"><a href="/admin/security/users">@L["Admin_users"]</a><span>/</span><span>@L["GrantAccess"]</span></nav>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<div class="management-grid"><section class="panel"><h2>@L["Company"]</h2><label><span>@L["Company"]</span><select @bind="CompanyId"><option value="">@L["Choose"]</option>@foreach(var x in Companies){<option value="@x.Id">@x.Name</option>}</select></label><button class="primary-link" @onclick="GrantCompany">@L["GrantAccess"]</button><div class="record-list">@foreach(var x in CurrentCompanies){<div class="record-row"><span><strong>@CompanyName(x.CompanyId)</strong><small>@x.ValidFrom</small></span>@if(x.ValidTo is null){<button class="secondary-action" @onclick="()=>RevokeCompany(x)">@L["Revoke"]</button>}</div>}</div></section><section class="panel"><h2>@L["Admin_roles"]</h2><label><span>@L["Admin_roles"]</span><select @bind="RoleId"><option value="">@L["Choose"]</option>@foreach(var x in Roles){<option value="@x.Id">@x.Name</option>}</select></label><button class="primary-link" @onclick="AssignRole">@L["AssignRole"]</button><div class="record-list">@foreach(var x in CurrentRoles){<div class="record-row"><span><strong>@RoleName(x.RoleId)</strong><small>@CompanyName(x.CompanyId)</small></span>@if(x.ValidTo is null){<button class="secondary-action" @onclick="()=>RevokeRole(x)">@L["Revoke"]</button>}</div>}</div></section></div>
@code{[Parameter]public Guid UserId{get;set;}private string CompanyId="",RoleId="";private bool Success;private string?Message;private List<Option>Companies=[],Roles=[];private List<CompanyAccess>CurrentCompanies=[];private List<RoleAccess>CurrentRoles=[];protected override async Task OnParametersSetAsync()=>await Load();private async Task Load(){var s=await Session();if(s is null)return;var cs=await Core.GetAsync("api/v1/auth/me/companies",s.Value.Token,s.Value.Company,default);if(cs.IsSuccess)Companies=cs.Value.EnumerateArray().Select(x=>new Option(x.GetProperty("companyId").GetGuid(),x.GetProperty("displayName").ToString())).ToList();var rs=await Core.GetAsync("api/v1/security/roles",s.Value.Token,s.Value.Company,default);if(rs.IsSuccess)Roles=rs.Value.EnumerateArray().Select(x=>new Option(x.GetProperty("id").GetGuid(),x.GetProperty("displayTitle").ToString())).ToList();var current=await Core.GetAsync($"api/v1/security/users/{UserId}/companies",s.Value.Token,s.Value.Company,default);if(current.IsSuccess)CurrentCompanies=current.Value.EnumerateArray().Select(x=>new CompanyAccess(x.GetProperty("companyId").GetGuid(),x.GetProperty("validFromUtc").ToString(),NullableDate(x,"validToUtc"))).ToList();var roles=await Core.GetAsync($"api/v1/security/users/{UserId}/roles",s.Value.Token,s.Value.Company,default);if(roles.IsSuccess)CurrentRoles=roles.Value.EnumerateArray().Select(x=>new RoleAccess(x.GetProperty("roleId").GetGuid(),x.GetProperty("companyId").GetGuid(),NullableDate(x,"validToUtc"))).ToList();}private async Task GrantCompany(){var s=await Session();if(s is null||!Guid.TryParse(CompanyId,out var c))return;Show(await Core.SendAsync(HttpMethod.Post,$"api/v1/security/users/{UserId}/companies",new{companyId=c},s.Value.Token,s.Value.Company,default));if(Success)await Load();}private async Task RevokeCompany(CompanyAccess x){var s=await Session();if(s is null)return;Show(await Core.SendAsync(HttpMethod.Delete,$"api/v1/security/users/{UserId}/companies/{x.CompanyId}",null,s.Value.Token,s.Value.Company,default));if(Success)await Load();}private async Task AssignRole(){var s=await Session();if(s is null||!Guid.TryParse(CompanyId,out var c)||!Guid.TryParse(RoleId,out var r))return;Show(await Core.SendAsync(HttpMethod.Post,$"api/v1/security/users/{UserId}/roles",new{roleId=r,companyId=c},s.Value.Token,s.Value.Company,default));if(Success)await Load();}private async Task RevokeRole(RoleAccess x){var s=await Session();if(s is null)return;Show(await Core.SendAsync(HttpMethod.Delete,$"api/v1/security/users/{UserId}/roles/{x.RoleId}/companies/{x.CompanyId}",null,s.Value.Token,s.Value.Company,default));if(Success)await Load();}private string CompanyName(Guid id)=>Companies.FirstOrDefault(x=>x.Id==id)?.Name??id.ToString();private string RoleName(Guid id)=>Roles.FirstOrDefault(x=>x.Id==id)?.Name??id.ToString();private static string?NullableDate(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():null;private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private sealed record Option(Guid Id,string Name);private sealed record CompanyAccess(Guid CompanyId,string ValidFrom,string?ValidTo);private sealed record RoleAccess(Guid RoleId,Guid CompanyId,string?ValidTo);}
