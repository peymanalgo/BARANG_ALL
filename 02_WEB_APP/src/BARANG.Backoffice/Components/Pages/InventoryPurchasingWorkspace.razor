@page "/workspace/inventory"
@page "/workspace/purchasing"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["Module_inventory"]</PageTitle><div class="page-heading"><h1>@L["Module_inventory"] · @L["Module_purchasing"]</h1></div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}
<section class="toolbar"><label><span>@L["Warehouse"]</span><input @bind="Warehouse" /></label><label><span>@L["Action_Variant"]</span><input @bind="Variant" /></label><button @onclick="LoadStock">@L["Refresh"]</button></section><div class="management-grid"><section class="panel"><h2>@L["Module_inventory"]</h2><pre>@Balances</pre><pre>@Ledger</pre><div class="form-grid single"><label><span>@L["Quantity"]</span><input type="number" @bind="Quantity" /></label><label><span>@L["ExternalReference"]</span><input @bind="Reference" /></label><label><span>@L["Reason"]</span><input @bind="Reason" /></label><label><span>@L["EntityId"]</span><input @bind="Entity" /></label><label><span>@L["Version"]</span><input type="number" @bind="Version" /></label></div><div class="form-actions"><button @onclick="Receipt">@L["Action_Receipt"]</button><button @onclick="Issue">@L["Action_Release"]</button><button @onclick="AdjustUp">+ @L["Action_Adjust"]</button><button @onclick="AdjustDown">− @L["Action_Adjust"]</button><button @onclick="Reserve">@L["Action_Reserve"]</button><button @onclick="ReleaseReservation">@L["Action_Release"]</button><button @onclick="IssueReservation">@L["Action_Complete"]</button></div></section><section class="panel"><h2>@L["Action_Transfer"]</h2><label><span>@L["Warehouse"]</span><input @bind="Destination" /></label><button @onclick="Transfer">@L["Action_Transfer"]</button><button @onclick="CompleteTransfer">@L["Action_Complete"]</button></section></div>
<section class="panel"><h2>@L["Module_purchasing"]</h2><div class="form-grid"><label><span>@L["Action_Supplier"]</span><input @bind="Supplier" /></label><label><span>@L["Currency"]</span><input @bind="Currency" /></label><label><span>@L["Amount"]</span><input type="number" @bind="UnitPrice" /></label><label><span>@L["EntityId"]</span><input @bind="PurchaseId" /></label></div><div class="form-actions"><button @onclick="CreateRequest">@L["Action_Request"]</button><button @onclick="SubmitRequest">@L["Action_Submit"]</button><button @onclick="CreateOrder">@L["Action_PurchaseOrder"]</button><button @onclick="SubmitOrder">@L["Action_Submit"]</button><button @onclick="ReceiveOrder">@L["Action_Receipt"]</button><button @onclick="CloseOrder">@L["Action_Complete"]</button><button @onclick="CancelOrder">@L["Action_Cancel"]</button><button @onclick="LoadOrders">@L["Refresh"]</button></div><pre>@Orders</pre></section>
@code{private string Warehouse="",Variant="",Destination="",Entity="",Reference="B21",Reason="Backoffice",Supplier="",Currency="IRR",PurchaseId="",Balances="",Ledger="",Orders="";private decimal Quantity=1,UnitPrice;private long Version;private bool Success;private string?Message;protected override async Task OnInitializedAsync(){await LoadStock();await LoadOrders();}private async Task LoadStock(){var s=await Session();if(s is null)return;var q=$"?warehouseId={Warehouse}&variantId={Variant}";var b=await Core.GetAsync("api/v1/inventory/balances"+q,s.Value.Token,s.Value.Company,default);Balances=b.IsSuccess?b.Value.ToString():"";var l=await Core.GetAsync("api/v1/inventory/transactions"+q,s.Value.Token,s.Value.Company,default);Ledger=l.IsSuccess?l.Value.ToString():"";}private Task Receipt()=>Post("api/v1/inventory/receipts",Move());private Task Issue()=>Post("api/v1/inventory/issues/Issue",Move());private Task AdjustUp()=>Post("api/v1/inventory/adjustments/true",Move());private Task AdjustDown()=>Post("api/v1/inventory/adjustments/false",Move());private object Move()=>new{warehouseId=Warehouse,productVariantId=Variant,quantity=Quantity,reference=Reference,reasonCode=Reason};private Task Reserve()=>Post("api/v1/inventory/reservations",new{orderItemId=Entity,warehouseId=Warehouse,quantity=Quantity,expiresAtUtc=(DateTimeOffset?)null,idempotencyKey=Reference});private Task ReleaseReservation()=>Post($"api/v1/inventory/reservations/{Entity}/release",new{quantity=Quantity,version=Version});private Task IssueReservation()=>Post($"api/v1/inventory/reservations/{Entity}/issue",new{quantity=Quantity,version=Version,reference=Reference});private Task Transfer()=>Post("api/v1/inventory/transfers",new{sourceWarehouseId=Warehouse,destinationWarehouseId=Destination,productVariantId=Variant,quantity=Quantity,reference=Reference});private Task CompleteTransfer()=>Post($"api/v1/inventory/transfers/{Entity}/complete",new{version=Version});private Task CreateRequest()=>Post("api/v1/purchasing/requests",new{warehouseId=Warehouse,reason=Reason,sourceShortageId=(Guid?)null,items=new[]{new{productVariantId=Variant,quantity=Quantity}}});private Task SubmitRequest()=>Post($"api/v1/purchasing/requests/{PurchaseId}/submit?version={Version}",null);private Task CreateOrder()=>Post("api/v1/purchasing/orders",new{supplierId=Supplier,warehouseId=Warehouse,currencyCode=Currency,expectedDeliveryDate=(string?)null,items=new[]{new{productVariantId=Variant,quantity=Quantity,unitPurchasePrice=UnitPrice}}});private Task SubmitOrder()=>Post($"api/v1/purchasing/orders/{PurchaseId}/submit?version={Version}",null);private Task ReceiveOrder()=>Post($"api/v1/purchasing/orders/{PurchaseId}/receipts",new{purchaseOrderItemId=Entity,quantity=Quantity,reference=Reference});private Task CloseOrder()=>Post($"api/v1/purchasing/orders/{PurchaseId}/close",new{cancel=false,reason=Reason,version=Version});private Task CancelOrder()=>Post($"api/v1/purchasing/orders/{PurchaseId}/close",new{cancel=true,reason=Reason,version=Version});private async Task LoadOrders(){var s=await Session();if(s is null)return;var r=await Core.GetAsync("api/v1/purchasing/orders",s.Value.Token,s.Value.Company,default);Orders=r.IsSuccess?r.Value.ToString():"";}private async Task Post(string path,object?body){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,path,body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){if(r.Value.ValueKind==System.Text.Json.JsonValueKind.Object){Entity=G(r.Value,"id");PurchaseId=G(r.Value,"id");Version=r.Value.TryGetProperty("version",out var v)?v.GetInt64():Version;}await LoadStock();await LoadOrders();}}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.ToString():"";}
