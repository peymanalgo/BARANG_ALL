@page "/admin/security/roles/{RoleId:guid}/permissions"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["GrantPermission"]</PageTitle><nav class="breadcrumbs"><a href="/admin/security/roles">@L["Admin_roles"]</a><span>/</span><span>@L["Permission"]</span></nav>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<section class="panel"><label><span>@L["Permission"]</span><select @bind="PermissionId"><option value="">@L["Choose"]</option>@foreach(var x in Available){<option value="@x.Id">@x.Code</option>}</select></label><button class="primary-link" @onclick="Grant">@L["GrantPermission"]</button><div class="record-list">@foreach(var x in Assigned){<div class="record-row"><span><strong>@x.Code</strong><small>@x.Module</small></span><button class="secondary-action" @onclick="()=>Revoke(x)">@L["Revoke"]</button></div>}</div></section>
@code{[Parameter]public Guid RoleId{get;set;}private string PermissionId="";private bool Success;private string?Message;private List<Permission>Available=[],Assigned=[];protected override async Task OnParametersSetAsync()=>await Load();private async Task Load(){var s=await Session();if(s is null)return;var all=await Core.GetAsync("api/v1/security/permissions",s.Value.Token,s.Value.Company,default);var assigned=await Core.GetAsync($"api/v1/security/roles/{RoleId}/permissions",s.Value.Token,s.Value.Company,default);if(all.IsSuccess)Available=Parse(all.Value);if(assigned.IsSuccess)Assigned=Parse(assigned.Value);Available=Available.Where(x=>Assigned.All(a=>a.Id!=x.Id)).ToList();}private async Task Grant(){var s=await Session();if(s is null||!Guid.TryParse(PermissionId,out var p))return;Show(await Core.SendAsync(HttpMethod.Post,$"api/v1/security/roles/{RoleId}/permissions/{p}",null,s.Value.Token,s.Value.Company,default));if(Success)await Load();}private async Task Revoke(Permission x){var s=await Session();if(s is null)return;Show(await Core.SendAsync(HttpMethod.Delete,$"api/v1/security/roles/{RoleId}/permissions/{x.Id}",null,s.Value.Token,s.Value.Company,default));if(Success)await Load();}private static List<Permission>Parse(System.Text.Json.JsonElement root)=>root.EnumerateArray().Select(x=>new Permission(x.GetProperty("id").GetGuid(),x.GetProperty("code").ToString(),x.GetProperty("module").ToString())).ToList();private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private sealed record Permission(Guid Id,string Code,string Module);}
