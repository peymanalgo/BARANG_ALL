@page "/orders/{OrderId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["Module_orders"]</PageTitle><nav class="breadcrumbs"><a href="/workspace/orders">@L["Module_orders"]</a><span>/</span><span>@OrderId</span></nav>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<div class="page-heading"><div><h1>@Number</h1><p>@Status</p></div><div><a class="secondary-action" href="@($"/orders/{OrderId}/edit")">@L["Action_Edit"]</a><a class="primary-link" href="@($"/finance/{OrderId}")">@L["Module_finance"]</a></div></div><section class="panel"><dl>@foreach(var x in Header){<dt>@x.Key</dt><dd>@x.Value</dd>}</dl></section><div class="management-grid"><section class="panel"><h2>@L["Wizard_Items"]</h2><pre>@Items</pre></section><section class="panel"><h2>@L["Wizard_Pricing"]</h2><pre>@Pricing</pre></section><section class="panel"><h2>@L["Wizard_Shipping"]</h2><pre>@Shipping</pre></section><section class="panel"><h2>@L["Timeline"]</h2><div class="record-list">@foreach(var x in Timeline){<div class="record-row"><span><strong>@x.Type</strong><small>@x.At</small></span></div>}</div></section></div><section class="panel"><div class="form-grid"><label><span>@L["Reason"]</span><input @bind="Reason" /></label><label><span>@L["Version"]</span><input type="number" @bind="Version" /></label></div><div class="form-actions"><button @onclick="Submit">@L["Action_Submit"]</button><button @onclick="Cancel">@L["Action_Cancel"]</button><button @onclick="Change">@L["Action_Request"]</button></div></section>
@code{[Parameter]public Guid OrderId{get;set;}private string Number="",Status="",Items="",Pricing="",Shipping="",Reason="";private long Version;private bool Success;private string?Message;private Dictionary<string,string>Header=[];private List<Event>Timeline=[];protected override async Task OnParametersSetAsync()=>await Load();private async Task Load(){var s=await Session();if(s is null)return;var o=await Core.GetAsync($"api/v1/orders/{OrderId}",s.Value.Token,s.Value.Company,default);if(!o.IsSuccess){Show(o);return;}Number=G(o.Value,"orderNumber");Status=G(o.Value,"status");Version=o.Value.GetProperty("version").GetInt64();foreach(var k in new[]{"source","externalReference","orderDate","requestedDeliveryDate","submittedAtUtc"})Header[k]=G(o.Value,k);Items=o.Value.TryGetProperty("items",out var i)?i.ToString():"";Shipping=o.Value.TryGetProperty("shippingAddress",out var a)?a.ToString():"";var p=await Core.GetAsync($"api/v1/orders/{OrderId}/pricing",s.Value.Token,s.Value.Company,default);Pricing=p.IsSuccess?p.Value.ToString():"";var t=await Core.GetAsync($"api/v1/orders/{OrderId}/timeline",s.Value.Token,s.Value.Company,default);if(t.IsSuccess)Timeline=t.Value.EnumerateArray().Select(x=>new Event(G(x,"eventType"),G(x,"occurredAtUtc"))).ToList();}private async Task Submit()=>await Act($"api/v1/orders/{OrderId}/submit",new{version=Version});private async Task Cancel()=>await Act($"api/v1/orders/{OrderId}/cancel",new{reasonCode="BACKOFFICE",reasonText=Reason,version=Version});private async Task Change()=>await Act($"api/v1/orders/{OrderId}/change-requests",new{changeType="General",reason=Reason,requestedChangesJson="{}"});private async Task Act(string path,object body){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,path,body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private sealed record Event(string Type,string At);}
