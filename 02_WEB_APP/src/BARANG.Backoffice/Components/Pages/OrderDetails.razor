@page "/orders/{OrderId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["Module_orders"]</PageTitle>
<nav class="breadcrumbs"><a href="/workspace/orders">@L["Module_orders"]</a><span>/</span><span>@Number</span></nav>
@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}
<div class="page-heading"><div><span class="eyebrow">@L["Module_orders"]</span><h1>@Number</h1><p>@Status · @Stage</p></div><div class="form-actions"><a class="secondary-action" href="@($"/orders/{OrderId}/edit")">@L["Action_Edit"]</a><a class="secondary-action" href="@($"/business-profile/order/{OrderId}")">@L["Wizard_Header"]</a><a class="primary-link" href="@($"/finance/{OrderId}")">@L["Module_finance"]</a></div></div>
<nav class="order-tabs" aria-label="@L["Module_orders"]">@foreach(string name in Sections){<button class="@(Active==name?"active":"")" @onclick="()=>Active=name">@L[SectionLabel(name)]</button>}</nav>
@if(Loading){<section class="panel state-box"><span class="spinner"></span><p>@L["Loading"]</p></section>}
else if(Data.ValueKind==System.Text.Json.JsonValueKind.Object&&Data.TryGetProperty(Active,out var section)){<section class="panel order-360-section"><div class="panel-heading"><h2>@L[SectionLabel(Active)]</h2><button class="secondary-action" @onclick="Load">@L["Refresh"]</button></div><JsonDataView Value="section" /></section>}
<section class="panel"><h2>@L["ActionUsesCore"]</h2><div class="form-grid"><label><span>@L["Reason"]</span><input @bind="Reason" /></label><label><span>@L["Version"]</span><input type="number" @bind="Version" /></label></div><div class="form-actions"><button @onclick="Submit">@L["Action_Submit"]</button><button @onclick="Cancel">@L["Action_Cancel"]</button><button @onclick="Change">@L["Action_Request"]</button></div></section>
@code{
[Parameter]public Guid OrderId{get;set;}private static readonly string[]Sections=["summary","customer","customerBusinessProfile","businessProfile","items","itemTechnicalSnapshots","productTechnicalProfiles","printOperations","printTechnicalProfiles","shippingAddress","pricing","finance","inventory","production","quality","logistics","workflow","timeline","audit"];private System.Text.Json.JsonElement Data;private string Active="summary",Number="",Status="",Stage="",Reason="";private long Version;private bool Loading=true,Success;private string?Message;protected override async Task OnParametersSetAsync()=>await Load();private static string SectionLabel(string name)=>name switch{"summary"=>"Status","customer"=>"Customer","customerBusinessProfile"=>"Customer","businessProfile"=>"Wizard_Header","items"=>"Wizard_Items","itemTechnicalSnapshots"=>"Wizard_Items","productTechnicalProfiles"=>"Action_Product","printOperations"=>"Wizard_Print","printTechnicalProfiles"=>"Wizard_Print","shippingAddress"=>"Wizard_Shipping","pricing"=>"Wizard_Pricing","finance"=>"Module_finance","inventory"=>"Module_inventory","production"=>"Module_production","quality"=>"Module_quality","logistics"=>"Module_logistics","workflow"=>"Module_workflow","timeline"=>"Timeline",_=>"Module_reports"};private async Task Load(){Loading=true;var s=await Session();if(s is null){Loading=false;return;}var r=await Core.GetAsync($"api/v1/orders/{OrderId}/360",s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess){Data=r.Value;var x=Data.GetProperty("summary");Number=G(x,"orderNumber");if(string.IsNullOrWhiteSpace(Number))Number=OrderId.ToString();Status=G(x,"status");Version=N(x,"version");if(Data.TryGetProperty("workflow",out var w)&&w.TryGetProperty("instance",out var i)&&i.ValueKind==System.Text.Json.JsonValueKind.Object)Stage=G(i,"currentStage");}Loading=false;}private async Task Submit()=>await Act($"api/v1/orders/{OrderId}/submit",new{version=Version});private async Task Cancel()=>await Act($"api/v1/orders/{OrderId}/cancel",new{reasonCode="BACKOFFICE",reasonText=Reason,version=Version});private async Task Change()=>await Act($"api/v1/orders/{OrderId}/change-requests",new{changeType="General",reason=Reason,requestedChangesJson="{}"});private async Task Act(string p,object b){var s=await Session();if(s is null)return;var r=await Core.SendAsync(HttpMethod.Post,p,b,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await Load();}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?null:r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private static long N(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.TryGetInt64(out var v)?v:0;}
