@page "/master/lookups"
@rendermode InteractiveServer
@attribute [Authorize(Policy=AuthPolicies.CompanySelected)]
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
@inject ICoreApiClient Core
<PageTitle>@L["Lookups"]</PageTitle><nav class="breadcrumbs"><a href="/workspace/master-data">@L["Module_master-data"]</a><span>/</span><span>@L["Lookups"]</span></nav><div class="page-heading"><div><h1>@L["Lookups"]</h1><p>@L["AuthoritativeCoreData"]</p></div><button class="primary-link" @onclick="NewType">@L["CreateNew"]</button></div>
<div class="management-grid"><section class="panel"><div class="record-list">@foreach(var x in Types){<button class="record-row" @onclick="()=>PickType(x)"><span><strong>@x.Code</strong><small>@x.Name</small></span><span>@(x.Active?L["Active"]:L["Inactive"])</span></button>}</div><div class="form-grid single"><label><span>@L["Code"]</span><input @bind="TypeCode" disabled="@(TypeId is not null)" /></label><label><span>@L["Name"]</span><input @bind="TypeName" /></label></div><div class="form-actions">@if(TypeId is not null){<button class="secondary-action" @onclick="ToggleType">@(TypeActive?L["Deactivate"]:L["Activate"])</button>}<button class="primary-link" @onclick="SaveType">@L["Save"]</button></div></section><section class="panel"><div class="record-list">@foreach(var x in Values){<button class="record-row" @onclick="()=>PickValue(x)"><span><strong>@x.Code</strong><small>@x.Fa · @x.En · @x.Ar</small></span><span>@(x.Active?L["Active"]:L["Inactive"])</span></button>}</div><div class="form-grid single"><label><span>@L["Code"]</span><input @bind="ValueCode" disabled="@(ValueId is not null)" /></label><label><span>fa</span><input @bind="Fa" /></label><label><span>en</span><input @bind="En" /></label><label><span>ar</span><input @bind="Ar" /></label><label><span>@L["DisplayOrder"]</span><input type="number" @bind="Order" /></label></div>@if(Message is not null){<div class="@(Success?"inline-success":"inline-error")">@L[Message]</div>}<div class="form-actions">@if(ValueId is not null){<button class="secondary-action" @onclick="ToggleValue">@(ValueActive?L["Deactivate"]:L["Activate"])</button>}<button class="secondary-action" @onclick="NewValue">@L["CreateNew"]</button><button class="primary-link" @onclick="SaveValue">@L["Save"]</button></div></section></div>
@code{private Guid?TypeId,ValueId;private long TypeVersion,ValueVersion;private bool TypeActive=true,ValueActive=true,Success;private string TypeCode="",TypeName="",ValueCode="",Fa="",En="",Ar="";private int Order;private string?Message;private List<TypeRow>Types=[];private List<ValueRow>Values=[];protected override async Task OnInitializedAsync()=>await LoadTypes();private void NewType(){TypeId=null;TypeVersion=0;TypeActive=true;TypeCode=TypeName="";Values=[];}private void NewValue(){ValueId=null;ValueVersion=0;ValueActive=true;ValueCode=Fa=En=Ar="";Order=0;}private async Task PickType(TypeRow x){TypeId=x.Id;TypeVersion=x.Version;TypeActive=x.Active;TypeCode=x.Code;TypeName=x.Name;await LoadValues();}private void PickValue(ValueRow x){ValueId=x.Id;ValueVersion=x.Version;ValueActive=x.Active;ValueCode=x.Code;Fa=x.Fa;En=x.En;Ar=x.Ar;Order=x.Order;}private async Task LoadTypes(){Types=[];var s=await Session();if(s is null)return;var r=await Core.GetAsync("api/v1/lookups/types",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Show(r);return;}foreach(var x in r.Value.EnumerateArray())Types.Add(new(x.GetProperty("id").GetGuid(),G(x,"code"),G(x,"displayName"),B(x,"isActive"),N(x,"version")));}private async Task LoadValues(){Values=[];var s=await Session();if(s is null||string.IsNullOrWhiteSpace(TypeCode))return;var r=await Core.GetAsync($"api/v1/lookups/types/{TypeCode}/values",s.Value.Token,s.Value.Company,default);if(!r.IsSuccess){Show(r);return;}foreach(var x in r.Value.EnumerateArray()){var t=x.TryGetProperty("translations",out var ts)?ts:default;Values.Add(new(x.GetProperty("id").GetGuid(),G(x,"code"),T(t,"fa"),T(t,"en"),T(t,"ar"),B(x,"isActive"),N(x,"version"),I(x,"displayOrder")));}}private async Task SaveType(){var s=await Session();if(s is null)return;object body=TypeId is null?new{code=TypeCode,displayName=TypeName,allowCustomValues=false}:new{displayName=TypeName,allowCustomValues=false,version=TypeVersion};var r=await Core.SendAsync(TypeId is null?HttpMethod.Post:HttpMethod.Put,"api/v1/lookups/types"+(TypeId is Guid id?$"/{id}":""),body,s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await LoadTypes();}private async Task ToggleType(){var s=await Session();if(s is null||TypeId is not Guid id)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/lookups/types/{id}/activation",new{isActive=!TypeActive,version=TypeVersion},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await LoadTypes();}private async Task SaveValue(){var s=await Session();if(s is null||string.IsNullOrWhiteSpace(TypeCode))return;ApiResult<System.Text.Json.JsonElement>r;if(ValueId is null)r=await Core.SendAsync(HttpMethod.Post,$"api/v1/lookups/types/{TypeCode}/values",new{code=ValueCode,displayOrder=Order,translations=new Dictionary<string,string>{{"fa",Fa},{"en",En},{"ar",Ar}}},s.Value.Token,s.Value.Company,default);else{r=await Core.SendAsync(HttpMethod.Put,$"api/v1/lookups/values/{ValueId}",new{displayOrder=Order,version=ValueVersion},s.Value.Token,s.Value.Company,default);if(r.IsSuccess)foreach(var p in new[]{("fa",Fa),("en",En),("ar",Ar)}){var current=await Core.GetAsync($"api/v1/lookups/values/{ValueId}",s.Value.Token,s.Value.Company,default);long version=current.IsSuccess?N(current.Value,"version"):ValueVersion;r=await Core.SendAsync(HttpMethod.Put,$"api/v1/lookups/values/{ValueId}/translations/{p.Item1}",new{displayName=p.Item2,version},s.Value.Token,s.Value.Company,default);if(!r.IsSuccess)break;}}Show(r);if(r.IsSuccess)await LoadValues();}private async Task ToggleValue(){var s=await Session();if(s is null||ValueId is not Guid id)return;var r=await Core.SendAsync(HttpMethod.Post,$"api/v1/lookups/values/{id}/activation",new{isActive=!ValueActive,version=ValueVersion},s.Value.Token,s.Value.Company,default);Show(r);if(r.IsSuccess)await LoadValues();}private void Show(ApiResult<System.Text.Json.JsonElement>r){Success=r.IsSuccess;Message=r.IsSuccess?"OperationSucceeded":r.Failure switch{ApiFailure.Unauthorized=>"SessionExpired",ApiFailure.Forbidden=>"Unauthorized",ApiFailure.Conflict=>"ConcurrencyConflict",ApiFailure.Validation=>"ValidationError",_=>"GenericError"};}private async Task<(string Token,Guid Company)?>Session(){var u=(await AuthState.GetAuthenticationStateAsync()).User;return Guid.TryParse(u.FindFirst(AuthClaimTypes.CompanyId)?.Value,out var c)&&u.FindFirst(AuthClaimTypes.AccessToken)?.Value is string t?(t,c):null;}private static string G(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.ValueKind!=System.Text.Json.JsonValueKind.Null?p.ToString():"";private static bool B(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)&&p.GetBoolean();private static long N(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.GetInt64():0;private static int I(System.Text.Json.JsonElement x,string n)=>x.TryGetProperty(n,out var p)?p.GetInt32():0;private static string T(System.Text.Json.JsonElement x,string c){if(x.ValueKind==System.Text.Json.JsonValueKind.Array)foreach(var t in x.EnumerateArray())if(G(t,"culture")==c)return G(t,"displayName");return "";}private sealed record TypeRow(Guid Id,string Code,string Name,bool Active,long Version);private sealed record ValueRow(Guid Id,string Code,string Fa,string En,string Ar,bool Active,long Version,int Order);}
