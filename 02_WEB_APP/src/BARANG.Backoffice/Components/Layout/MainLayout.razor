@inherits LayoutComponentBase
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState

<div class="shell">
    <aside class="sidebar" aria-label="@L["Navigation"]">
        <a class="brand" href="/"><span class="brand-mark">B</span><span><strong>BARANG</strong><small>@L["Backoffice"]</small></span></a>
        <nav><a class="nav-item active" href="/"><span aria-hidden="true">⌂</span>@L["Home"]</a></nav>
        <p class="nav-note">@L["ModulesComingSoon"]</p>
    </aside>
    <div class="main-column">
        <header class="topbar">
            <div class="company-chip"><span aria-hidden="true">◇</span><span><small>@L["CurrentCompany"]</small><strong>@CompanyName</strong></span></div>
            <div class="top-actions"><LanguageSwitcher /><span class="user-name">@DisplayName</span>
                <form method="post" action="/auth/logout"><AntiforgeryToken /><button class="text-button" type="submit">@L["Logout"]</button></form>
            </div>
        </header>
        <main class="content">@Body</main>
    </div>
</div>
<div id="blazor-error-ui" data-nosnippet>@L["GenericError"] <a href="." class="reload">@L["Reload"]</a><span class="dismiss">🗙</span></div>

@code {
    private string DisplayName { get; set; } = "";
    private string CompanyName { get; set; } = "";
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        DisplayName = user.FindFirst(AuthClaimTypes.DisplayName)?.Value ?? user.Identity?.Name ?? "";
        CompanyName = user.FindFirst(AuthClaimTypes.CompanyName)?.Value ?? "";
    }
}
