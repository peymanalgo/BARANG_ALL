@inherits LayoutComponentBase
@inject IStringLocalizer<AppStrings> L
@inject AuthenticationStateProvider AuthState
<div class="shell"><aside class="sidebar" aria-label="@L["Navigation"]"><a class="brand" href="/"><span class="brand-mark">B</span><span><strong>BARANG</strong><small>@L["Backoffice"]</small></span></a><nav><a class="nav-item" href="/"><span>⌂</span><b>@L["Home"]</b></a>@foreach(var module in VisibleModules){<a class="nav-item" href="/workspace/@module.Code"><span>@module.Icon</span><b>@L[$"Module_{module.Code}"]</b></a>}</nav></aside><div class="main-column"><header class="topbar"><a class="company-chip" href="/company" title="@L["SwitchCompany"]"><span>◇</span><span><small>@L["CurrentCompany"]</small><strong>@CompanyName</strong></span></a><div class="top-actions"><LanguageSwitcher/><span class="user-name">@DisplayName</span><form method="post" action="/auth/logout"><AntiforgeryToken/><button class="text-button">@L["Logout"]</button></form></div></header><main class="content">@Body</main></div></div><div id="blazor-error-ui">@L["GenericError"] <a href="." class="reload">@L["Reload"]</a></div>
@code{private string DisplayName="",CompanyName="";private IReadOnlyList<BackofficeModule>VisibleModules=[];protected override async Task OnInitializedAsync(){var u=(await AuthState.GetAuthenticationStateAsync()).User;DisplayName=u.FindFirst(AuthClaimTypes.DisplayName)?.Value??u.Identity?.Name??"";CompanyName=u.FindFirst(AuthClaimTypes.CompanyName)?.Value??"";VisibleModules=ModuleCatalog.All.Where(x=>ModuleCatalog.IsVisible(x,u)).ToArray();}}
