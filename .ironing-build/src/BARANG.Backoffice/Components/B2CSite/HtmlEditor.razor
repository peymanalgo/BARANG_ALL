@* ویرایشگر HTML مشترک CMS — contenteditable + تولبار JS + آپلود تصویر از Blazor *@
@inject IJSRuntime JS
@inject ICoreApiClient Core
@inject AuthenticationStateProvider AuthState

<div class="site-editor-wrap">
    <div class="flex gap-4 items-center" style="margin-bottom:6px">
        @if (ShowImageUpload)
        {
            <label class="btn btn-sm" style="cursor:pointer">
                🖼 @Label("تصویر", "Image", "صورة")
                <InputFile OnChange="PickImage" hidden accept="image/*" />
            </label>
        }
        <span class="muted" style="font-size:.75rem">@Hint</span>
    </div>
    @* محتوا از سمت Blazor رندر نمی‌شود تا مالکیت DOM با JS باشد؛
       درج اولیه/به‌روزرسانی فقط با setHtml از OnAfterRenderAsync (پایداری circuit). *@
    <div id="@DomId" data-site-editor data-target="@HiddenId" dir="@Dir" contenteditable="true" spellcheck="false"></div>
    <input type="hidden" id="@HiddenId" @bind-value="Value" @bind-value:event="oninput" />
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? DomIdSuffix { get; set; }
    [Parameter] public bool ShowImageUpload { get; set; } = true;
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string Dir { get; set; } = "auto";
    private string DomId => $"site-ed-{DomIdSuffix ?? Guid.NewGuid().ToString("N")[..8]}";
    private string HiddenId => DomId + "-hidden";
    private string? _lastPushed; // آخرین HTMLای که به DOM فرستاده شده — برای جلوگیری از echo

    private string Label(string fa, string en, string ar)
    {
        string c = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        return c switch { "en" => en,"es"=>EsGlossary.Tr(en), "ar" => ar, _ => fa };
    }

    // بارگذاری تضمینی کتابخانه ویرایشگر و اسکن پس از هر رندر (تعویض تب) — idempotent.
    // محتوای pending بعد از آماده شدن کتابخانه flush می‌شود تا بار اول هم محتوا برسد.
    private const string BootScript = """
        (function(){
          var flush=function(){ var p=window.__siteEdPending||{}; Object.keys(p).forEach(function(k){ window.barangSiteEditor && window.barangSiteEditor.setHtml(k, p[k]); delete p[k]; }); };
          var scan=function(){ window.barangSiteEditor && window.barangSiteEditor.scan(document); flush(); };
          if(window.barangSiteEditor){ scan(); return; }
          if(window.__siteEdLoading){ window.__siteEdQueue=(window.__siteEdQueue||[]).concat([scan]); return; }
          window.__siteEdLoading=1; window.__siteEdQueue=[scan];
          var s=document.createElement('script'); s.src='/js/site-editor.js';
          s.onload=function(){ window.__siteEdLoading=0; (window.__siteEdQueue||[]).forEach(function(f){f();}); window.__siteEdQueue=[]; };
          document.head.appendChild(s);
        })();
        """;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        await JS.InvokeVoidAsync("eval", BootScript);
        string idLit = System.Text.Json.JsonSerializer.Serialize(DomId);
        string htmlLit = System.Text.Json.JsonSerializer.Serialize(Value ?? "");
        if (Value != _lastPushed)
        {
            // فقط وقتی Value از سمت Blazor عوض شده محتوا را به DOM می‌فرستیم (نه هنگام تایپ کاربر)
            await JS.InvokeVoidAsync("eval", $$"""
                (function(){ var id={{idLit}}, html={{htmlLit}};
                  window.__siteEdPending=window.__siteEdPending||{}; window.__siteEdPending[id]=html;
                  if(window.barangSiteEditor){ window.barangSiteEditor.setHtml(id, html); delete window.__siteEdPending[id]; }
                })();
                """);
            _lastPushed = Value;
        }
        else
        {
            // ترمیم پس از اتصال مجدد SignalR: Blazor صفحه را از نو می‌سازد و DIV خالی می‌شود؛
            // اگر DOM خالی بود ولی Value محتوا داشت، دوباره push می‌کنیم (تایپ کاربر هرگز کاملاً خالی نیست)
            await JS.InvokeVoidAsync("eval", $$"""
                (function(){ var el=document.getElementById({{idLit}});
                  if(el && !el.innerHTML.trim() && window.barangSiteEditor){ window.barangSiteEditor.setHtml({{idLit}}, {{htmlLit}}); }
                })();
                """);
        }
    }

    private async Task PickImage(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || file.Size == 0) return;
        var session = await Session();
        if (session is null) return;
        await using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        memory.Position = 0;
        var result = await Core.UploadAsync("api/v1/site/images", file.Name, file.ContentType, memory, file.Size, session.Value.Token, session.Value.Company, default);
        if (!result.IsSuccess) return;
        string? url = result.Value.TryGetProperty("url", out var u) ? u.GetString() : null;
        if (!string.IsNullOrWhiteSpace(url))
        {
            string idLit = System.Text.Json.JsonSerializer.Serialize(DomId);
            string urlLit = System.Text.Json.JsonSerializer.Serialize(url);
            await JS.InvokeVoidAsync("eval", $"window.barangSiteEditor ? window.barangSiteEditor.insertImage({idLit}, {urlLit}) : 0");
            await SyncFromDom();
        }
    }

    public async Task SyncFromDom()
    {
        // null ⇒ کتابخانه هنوز بارگذاری نشده؛ مقدار قبلی حفظ می‌شود (از دست رفتن محتوا ممنوع)
        string? html = await JS.InvokeAsync<string?>("eval", $"window.barangSiteEditor ? window.barangSiteEditor.getHtml('{DomId}') : null");
        if (html is null) return;
        Value = html;
        _lastPushed = html; // DOM همین را دارد؛ echo فرستاده نشود
        await ValueChanged.InvokeAsync(html);
    }

    private async Task<(string Token, Guid Company)?> Session()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        return Guid.TryParse(user.FindFirst(BARANG.Backoffice.Auth.AuthClaimTypes.CompanyId)?.Value, out var c) &&
               user.FindFirst(BARANG.Backoffice.Auth.AuthClaimTypes.AccessToken)?.Value is string t ? (t, c) : null;
    }
}
