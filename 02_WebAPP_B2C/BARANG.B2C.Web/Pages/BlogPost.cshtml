@page "/blog/{slug}"
@model BARANG.B2C.Web.Pages.BlogPostModel
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    ViewData["Title"] = Model.Title;
}
<section class="container section">
    @if (Model.NotFound)
    {
        <h1>@T("مطلب پیدا نشد", "Post not found", "لم يتم العثور على التدوينة")</h1>
        <p class="muted"><a href="/blog">← @T("بازگشت به وبلاگ", "Back to blog", "رجوع إلى المدونة")</a></p>
    }
    else
    {
        <nav class="breadcrumbs" aria-label="breadcrumb">
            <a href="/">@T("خانه", "Home", "الرئيسية")</a> / <a href="/blog">@T("وبلاگ", "Blog", "المدونة")</a> / <span>@Model.Title</span>
        </nav>
        <article class="blog-article">
            <h1>@Model.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Thumbnail))
            {
                <img class="blog-cover" src="@Model.Thumbnail" alt="@Model.Title" loading="lazy" />
            }
            <div class="blog-meta muted">@Model.Date</div>
            <div class="blog-body">@Html.Raw(Model.Body)</div>
        </article>
    }
</section>
