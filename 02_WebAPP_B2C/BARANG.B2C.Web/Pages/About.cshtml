@page
@model EmptyModel
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    ViewData["Title"] = T("درباره ما", "About us", "من نحن");
}
<section class="container section about-page">
    <h1>@T("درباره پیرنگ خان", "About Peyrang Khan", "عن پیرنگ خان")</h1>
    <p class="muted">@T("این متن یک متن آزمایشی است؛ نسخه نهایی به‌زودی جایگزین می‌شود.", "This is placeholder text; the final copy will replace it soon.", "هذا نص تجريبي؛ سيستبدل النص النهائي قريباً.")</p>
    <div class="about-body">
        <p>@T("پیرنگ خان از یک ایده ساده شروع شد: هر کسی بتواند طرحی که در ذهن دارد را روی تیشرتی که می‌پوشد ببیند. ما بزرگ‌ترین بانک طرح آماده چاپ را کنار هم جمع کردیم تا انتخاب راحت باشد، و ابزار پیش‌نمایش ساختیم تا قبل از سفارش، نتیجه را همان‌طور که می‌شود دید.", "Peyrang Khan started from a simple idea: everyone should be able to see the design in their head on the shirt they wear. We built one of the largest ready-to-print design banks and a live preview so you know exactly what you'll get before ordering.", "بدأت پیرنگ خان بفكرة بسيطة: أن يرى كل شخص تصميمه على القميص الذي يرتديه. جمعنا واحدة من أكبر بنوك التصاميم الجاهزة وأضفنا معاينة مباشرة قبل الطلب.")</p>
        <p>@T("چاپ ما روی تیشرت‌های پنبه‌ای اصل با روش‌های DTG، سیلک‌اسکرین و سابلیمیشن انجام می‌شود؛ بسته‌بندی شیک، ارسال سریع و ضمانت رضایت هم بخشی از قول ماست.", "We print on genuine cotton shirts with DTG, silkscreen and sublimation; chic packaging, fast delivery and a satisfaction guarantee are part of the promise.", "نطبع على التيشرتات القطنية بطرق DTG والشاشة الحريرية والتسامي؛ مع تغليف أنيق وتسليم سريع وضمان رضا.")</p>
        <p>@T("این پاراگراف هم متن تستی است تا جای محتوای واقعی را نگه دارد: داستان تیم، کارگاه چاپ، و چیزهایی که پیرنگ خان را متفاوت می‌کند.", "This paragraph is also placeholder content, holding the spot for the real story: the team, the print workshop and what makes Peyrang Khan different.", "هذه الفقرة أيضاً نص مؤقت لقصة الفريق وورشة الطباعة وما يميز پیرنگ خان.")</p>
    </div>
    <a class="btn btn-primary btn-lg" href="/catalog">@T("مشاهده طرح‌ها", "Browse designs", "استعرض التصاميم")</a>
</section>
