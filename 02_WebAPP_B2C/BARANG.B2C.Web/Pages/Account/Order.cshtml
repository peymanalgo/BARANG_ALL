@page "/account/orders/{id:guid}"
@model OrderModel
@using System.Globalization
@using System.Text.Json
@{
    Layout = "_AccountLayout";
    ViewData["PanelActive"] = "orders";
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar, string? es = null) => culture switch { "en" => en, "ar" => ar, "es" => es ?? en, _ => fa };
    string OrderLabel(string s) => s switch
    {
        "Draft" => T("پیش‌نویس", "Draft", "مسودة", "Borrador"),
        "Submitted" => T("ثبت‌شده — در حال پردازش", "Submitted — in progress", "مُرسل — قيد المعالجة", "Enviado — en curso"),
        "Cancelled" => T("لغوشده", "Cancelled", "ملغى", "Cancelado"),
        "Delivered" => T("تحویل‌شده", "Delivered", "تم التسليم", "Entregado"),
        _ => s
    };
    string ShipmentLabel(string s) => s switch
    {
        "Ready" => T("آماده ارسال", "Ready to ship", "جاهز للشحن", "Listo para enviar"),
        "Shipped" => T("ارسال‌شده", "Shipped", "مشحون", "Enviado"),
        "InTransit" => T("در حال حمل", "In transit", "في الطريق", "En tránsito"),
        "Delivered" => T("تحویل‌شده", "Delivered", "تم التسليم", "Entregado"),
        "FailedDelivery" => T("ارسال ناموفق", "Failed delivery", "فشل التسليم", "Entrega fallida"),
        "Returned" => T("برگشتی", "Returned", "مرتجع", "Devuelto"),
        _ => s
    };
    string EventLabel(string t) => t switch
    {
        "Submitted" => T("سفارش ثبت شد", "Order submitted", "تم إرسال الطلب", "Pedido enviado"),
        "Cancelled" => T("سفارش لغو شد", "Order cancelled", "تم إلغاء الطلب", "Pedido cancelado"),
        "StatusChanged" => T("به‌روزرسانی وضعیت", "Status updated", "تحديث الحالة", "Estado actualizado"),
        _ => t
    };
    string PositionLabel(string p) => p switch
    {
        "FRONT" => T("جلو", "Front", "الأمام", "Delantero"),
        "BACK" => T("پشت", "Back", "الخلف", "Trasero"),
        "SLEEVE" => T("آستین", "Sleeve", "الكم", "Manga"),
        "OTHER" => T("سایر", "Other", "أخرى", "Otro"),
        _ => p
    };
    string Num(decimal d) => d.ToString("0.##", CultureInfo.InvariantCulture);
    // ارقام بومی + جداکننده ٬ — قاعده یکدست نمایش مبالغ (ممیزی UI/UX)
    string Mon(decimal? d) => BARANG.B2C.Web.Services.Display.Money(d, culture);
    string Dig(int n) => BARANG.B2C.Web.Services.AppDate.Digits(n.ToString("N0"), culture);
    // نام انسانی رنگ از کد انگلیسی (RED → قرمز) — کد خام به مشتری نمایش داده نمی‌شود
    string ColorName(string? code) => (code ?? "").Trim().ToUpperInvariant() switch
    {
        "RED" => T("قرمز", "Red", "أحمر", "Rojo"),
        "BLUE" => T("آبی", "Blue", "أزرق", "Azul"),
        "BLACK" => T("مشکی", "Black", "أسود", "Negro"),
        "WHITE" => T("سفید", "White", "أبيض", "Blanco"),
        "GREEN" => T("سبز", "Green", "أخضر", "Verde"),
        "YELLOW" => T("زرد", "Yellow", "أصفر", "Amarillo"),
        "ORANGE" => T("نارنجی", "Orange", "برتقالي", "Naranja"),
        "GRAY" or "GREY" => T("خاکستری", "Gray", "رمادي", "Gris"),
        "PINK" => T("صورتی", "Pink", "وردي", "Rosa"),
        "PURPLE" => T("بنفش", "Purple", "بنفسجي", "Morado"),
        "CREAM" => T("شیری", "Cream", "كريمي", "Crema"),
        "" => "",
        _ => code!
    };
    // واحد اندازه‌گیری انگلیسی (PCS) → زبان مشتری
    string Uom(string? uom) => (uom ?? "").Trim().ToUpperInvariant() switch
    {
        "PCS" or "PC" or "EA" => T("عدد", "pcs", "عدد", "uds"),
        "" => T("عدد", "pcs", "عدد", "uds"),
        _ => uom!
    };
    // ردیف‌های ریز قیمت: نام فیلد انگلیسی → برچسب بومی + مبلغ فرمت‌شده
    string QuoteRowLabel(string prop) => prop.ToLowerInvariant() switch
    {
        "rawproducttotal" or "producttotal" => T("محصول", "Product", "المنتج", "Producto"),
        "printtotal" => T("چاپ", "Printing", "الطباعة", "Impresión"),
        "packagingtotal" => T("بسته‌بندی", "Packaging", "التغليف", "Embalaje"),
        "shippingtotal" => T("ارسال", "Shipping", "الشحن", "Envío"),
        "discounttotal" => T("تخفیف", "Discount", "الخصم", "Descuento"),
        "taxtotal" => T("مالیات", "Tax", "الضريبة", "Impuesto"),
        "subtotal" => T("جمع کل", "Subtotal", "المجموع", "Subtotal"),
        "finaltotal" => T("مبلغ نهایی", "Final total", "الإجمالي النهائي", "Total final"),
        _ => prop
    };
    (string Label, string Value)? TotalRow = null;
    List<(string Label, string Value)> QuoteRows = new();
    if (Model.Quote is JsonElement q && q.ValueKind == JsonValueKind.Object)
    {
        foreach (var prop in q.EnumerateObject())
        {
            if (prop.Value.ValueKind != JsonValueKind.Number) continue;
            if (!prop.Value.TryGetDecimal(out decimal amount)) continue;
            if (prop.Name.Equals("total", StringComparison.OrdinalIgnoreCase) || prop.Name.Equals("totalAmount", StringComparison.OrdinalIgnoreCase) || prop.Name.Equals("grandTotal", StringComparison.OrdinalIgnoreCase) || prop.Name.Equals("finalTotal", StringComparison.OrdinalIgnoreCase))
            {
                TotalRow = (T("مبلغ کل", "Total", "الإجمالي", "Total"), Mon(amount));
            }
            else if (amount != 0)
            {
                QuoteRows.Add((QuoteRowLabel(prop.Name), Mon(amount)));
            }
        }
    }
    bool Cancellable = Model.OrderStatus is "Draft" or "Submitted";
    // سفارش پرداخت‌شده: لغو با تأیید دومرحله‌ای + توضیح استرداد
    bool PaidOrder = (Model.WalletPayment is { } pw && pw.Paid > 0) || Model.Paid == "1";
}
@if (!Model.Found)
{
    <section class="container section"><p class="empty">@T("سفارش پیدا نشد.", "Order not found.", "لم يتم العثور على الطلب.", "Pedido no encontrado.")</p></section>
}
else
{
<section class="container section">
    <nav class="breadcrumbs no-print" aria-label="breadcrumb">
            <a href="/account">@T("حساب کاربری", "My account", "حسابي", "Mi cuenta")</a> ›
            <a href="/account/orders">@T("سفارش‌ها", "Orders", "الطلبات", "Pedidos")</a> ›
            <span dir="ltr">@(Model.OrderNumber ?? "—")</span>
        </nav>
        <header class="section-head tracking-head">
            <div>
                <h1>@T("سفارش", "Order", "الطلب", "Pedido") <span dir="ltr">@(Model.OrderNumber ?? "—")</span></h1>
                <p class="muted">@T("تاریخ سفارش", "Order date", "تاريخ الطلب", "Fecha del pedido"): @Model.DateText(Model.OrderDate) @if (Model.SubmittedAt is not null) { <span> · @T("ثبت: ", "Submitted: ", "أُرسل: ", "Enviado: ")@Model.DateText(Model.SubmittedAt)</span> }</p>
            </div>
            <div class="tracking-head-side">
                <span class="status-chip st-@Model.OrderStatus.ToLowerInvariant() status-lg">@OrderLabel(Model.OrderStatus)</span>
                @if (Model.OrderNumber is { Length: > 0 })
                {
                    <button type="button" class="btn btn-ghost btn-sm" data-copy="@Model.OrderNumber">@T("کپی شماره", "Copy number", "نسخ الرقم", "Copiar número")</button>
                }
            </div>
        </header>

    @* ── دو پنل مستقل کنار هم، زیر هدر صفحه: پیش‌نمایش روی تیشرت + طرح سفارش‌داده‌شده ── *@
    @if (Model.MockupEntries.Count > 0 || Model.DesignEntries.Count > 0)
    {
        <div class="order-panels">
            @* پیش‌نمایش روی تیشرت از کامپوزیت هر قلم: سرور ترکیب عکس تی‌شرت هم‌رنگ + طرح را برمی‌گرداند
               (اگر کامپوزیت ذخیره‌شدهٔ ویزارد معتبر باشد همان ارسال می‌شود) *@
            @if (Model.DesignEntries.Count > 0)
            {
                <div class="order-panel order-panel-mockup">
                    <h3>@T("پیش‌نمایش روی تیشرت", "Preview on t-shirt", "معاينة على التيشيرت", "Vista previa en camiseta")</h3>
                    @foreach (var g in Model.DesignEntries)
                    {
                        <div class="order-mockup-card">
                            <img src="@($"/account/orders/{Model.Id}/?handler=Composite&fileVersionId={g.FileVersionId}")" alt="@T("پیش‌نمایش طرح روی تیشرت", "Design preview on t-shirt", "معاينة التصميم على التيشيرت", "Vista previa del diseño en la camiseta")" />
                            <span class="order-mockup-pos">@T("چاپ", "Print", "طباعة", "Impresión") @DisplayValue(g.Position)</span>
                        </div>
                    }
                </div>
            }
            else if (Model.MockupEntries.Count > 0)
            {
                <div class="order-panel order-panel-mockup">
                    <h3>@T("پیش‌نمایش روی تیشرت", "Preview on t-shirt", "معاينة على التيشيرت", "Vista previa en camiseta")</h3>
                    @foreach (var m in Model.MockupEntries)
                    {
                        <div class="order-mockup-card">
                            <img src="@($"/account/orders/{Model.Id}/?handler=DesignFile&fileVersionId={m.FileVersionId}")" alt="@T("پیش‌نمایش طرح روی تیشرت", "Design preview on t-shirt", "معاينة التصميم على التيشيرت", "Vista previa del diseño en la camiseta")" />
                            <span class="order-mockup-pos">@T("چاپ", "Print", "طباعة", "Impresión") @DisplayValue(m.Position)</span>
                        </div>
                    }
                </div>
            }
            @if (Model.DesignEntries.Count > 0)
            {
                <div class="order-panel order-panel-design">
                    <h3>@T("طرح سفارش‌داده‌شده", "Ordered design", "التصميم المطلوب", "Diseño del pedido")</h3>
                    @foreach (var g in Model.DesignEntries)
                    {
                        string? printSize = null;
                        foreach (var item in Model.Items)
                        {
                            if (item.Id.Length > 0 && item.Id != g.OrderItemId) continue;
                            var op = item.PrintOperations.FirstOrDefault(o => string.Equals(o.Position, g.Position, StringComparison.OrdinalIgnoreCase)) ?? item.PrintOperations.FirstOrDefault();
                            if (op?.Width is decimal w && op.Height is decimal h) { printSize = $"{Num(w)} × {Num(h)} {T("سانتی‌متر", "cm", "سم", "cm")}"; break; }
                        }
                        <div class="order-design-card">
                            @* کلیک روی تصویر → پاپ‌آپ بزرگ مشاهده طرح واقعی *@
                            <button type="button" class="order-design-view" data-zoom="@($"/account/orders/{Model.Id}/?handler=DesignFile&fileVersionId={g.FileVersionId}")" aria-label="@T("مشاهده بزرگ طرح", "View design large", "عرض كبير للتصميم", "Ver diseño grande")">
                                <img src="@($"/account/orders/{Model.Id}/?handler=DesignFile&fileVersionId={g.FileVersionId}&kind=thumb")" alt="@g.FileName" loading="lazy" />
                                <span class="order-design-zoom-hint">⤢</span>
                            </button>
                            <div class="order-design-meta">
                                <span class="order-design-name">@g.FileName</span>
                                <span class="chip">@DisplayValue(g.Position)</span>
                                @if (printSize is not null)
                                {
                                    <span class="chip chip-size">@T("سایز چاپ", "Print size", "مقاس الطباعة", "Tamaño de impresión"): <b dir="ltr">@printSize</b></span>
                                }
                            </div>
                        </div>
                    }
                    @* دانلود طرح — دکمه تمام‌عرض در انتهای پنل *@
                    @foreach (var g in Model.DesignEntries)
                    {
                        <a class="btn btn-ghost order-design-download" href="@($"/account/orders/{Model.Id}/?handler=DesignFile&fileVersionId={g.FileVersionId}")" download="@g.FileName">⬇ @T("دانلود طرح", "Download design", "تنزيل التصميم", "Descargar diseño")</a>
                    }
                </div>
            }
        </div>
    }

        @if (Model.Paid == "1")
        {
            <div class="alert alert-ok" role="status">✓ @T("پرداخت از کیف پول با موفقیت انجام شد.", "Wallet payment completed successfully.", "تم الدفع من المحفظة بنجاح.", "Pago con billetera completado con éxito.")</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.PayError))
        {
            <div class="alert alert-error" role="alert">
                @(Model.PayError == "wallet.insufficient_balance"
                    ? T("موجودی کیف پول برای پرداخت این سفارش کافی نیست.", "Your wallet balance is not enough for this order.", "رصيد المحفظة غير كافٍ لهذا الطلب.", "El saldo de tu billetera no alcanza para este pedido.")
                    : T("پرداخت انجام نشد؛ دوباره تلاش کنید.", "Payment failed; try again.", "فشل الدفع؛ حاول مجدداً.", "El pago falló; inténtalo de nuevo."))
                <a href="/account/wallet">@T("شارژ کیف پول", "Top up wallet", "شحن المحفظة", "Recargar billetera")</a>
            </div>
        }

        @if (Model.WalletPayment is { } wp && Model.OrderStatus != "Cancelled" && Model.OrderStatus != "Draft")
        {
            <div class="card wallet-pay-card">
                <div class="wallet-pay-row">
                    <div>
                        <strong>@T("وضعیت پرداخت", "Payment status", "حالة الدفع", "Estado del pago")</strong>
                        @if (wp.FullyPaid)
                        {
                            <span class="topup-status st-paid">@T("پرداخت‌شده", "Paid", "مدفوع", "Pagado")</span>
                        }
                        else
                        {
                            <span class="topup-status st-pending">@T("پرداخت‌نشده", "Unpaid", "غير مدفوع", "No pagado")</span>
                        }
                    </div>
                    <div class="wallet-pay-amounts">
                        <span>@T("مبلغ کل", "Total", "الإجمالي", "Total"): <strong dir="ltr">@Mon(wp.Total)</strong></span>
                        <span>@T("پرداخت‌شده", "Paid", "المدفوع", "Pagado"): <strong dir="ltr">@Mon(wp.Paid)</strong></span>
                        @if (!wp.FullyPaid)
                        {
                            <span>@T("باقی‌مانده", "Remaining", "المتبقي", "Restante"): <strong dir="ltr">@Mon(wp.Remaining)</strong></span>
                        }
                    </div>
                    @if (!wp.FullyPaid && Model.OrderStatus == "Submitted")
                    {
                                                            <a class="btn btn-ghost" href="/account/orders/@Model.Id/invoice" target="_blank">@T("فاکتور", "Invoice", "فاتورة", "Factura")</a>
<form method="post" asp-page-handler="PayWallet" class="inline-form">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary" disabled="@(wp.WalletBalance < wp.Remaining)">
                                @T($"پرداخت {Mon(wp.Remaining)} تومانی از کیف پول", $"Pay {Mon(wp.Remaining)} Toman from wallet", $"دفع {Mon(wp.Remaining)} تومان من المحفظة", $"Pagar {Mon(wp.Remaining)} tomans desde el monedero")
                            </button>
                            @if (wp.WalletBalance < wp.Remaining)
                            {
                                <div class="charge-inline">
                                    <small class="muted">@T("موجودی کافی نیست؛ مبلغ کسری را شارژ کنید:", "Insufficient balance; top up the deficit:", "الرصيد غير كافٍ؛ اشحن العجز:", "Saldo insuficiente; cubre el faltante:")</small>
                                    <form method="post" asp-page="/Account/Wallet" asp-page-handler="Charge" class="inline-form" style="display:flex;gap:6px;margin-top:4px">
                                        <input type="hidden" name="amount" value="@(wp.Remaining - wp.WalletBalance)" />
                                        <input type="hidden" name="returnToken" value="1" />
                                        <button type="submit" class="btn btn-primary btn-sm">@T($"شارژ {Mon(wp.Remaining - wp.WalletBalance)} تومان", $"Top up {Mon(wp.Remaining - wp.WalletBalance)} Toman", $"شحن {Mon(wp.Remaining - wp.WalletBalance)} تومان", $"Recargar {Mon(wp.Remaining - wp.WalletBalance)} tomans")</button>
                                    </form>
                                </div>
                            }
                        </form>
                    }
                </div>
            </div>
        }

        @if (Model.OrderStatus == "Draft")
        {
            <div class="alert alert-ok" role="status" style="display:flex;justify-content:space-between;align-items:center">
                <span>@T("این سفارش پیش‌نویس است؛ هنوز ثبت نهایی نشده.", "This order is a draft; it is not submitted yet.", "هذا الطلب مسودة؛ لم يُرسل بعد.", "Este pedido es un borrador; aún no se ha enviado.")</span>
                <a class="btn btn-primary btn-sm" style="width:auto;display:inline-flex" href="/order/wizard">@T("افزودن طرح دیگر به این سفارش", "Add another design to this order", "أضف تصميماً آخر لهذا الطلب", "Añadir otro diseño a este pedido")</a>
            </div>
        }
        @if (Model.OrderStatus == "Cancelled")
        {
            <div class="alert alert-error cancelled-banner" role="alert">✕ @T("این سفارش لغو شده است.", "This order was cancelled.", "تم إلغاء هذا الطلب.", "Este pedido fue cancelado.")</div>
        }
        else
        {
            // استپر ۴مرحله‌ای — هم‌تراز با داشبورد (ثبت سفارش/در حال تولید/ارسال/تحویل)
            var stepLabels = new[] { T("ثبت سفارش", "Placed", "تسجيل", "Realizado"), T("در حال تولید", "In production", "في الإنتاج", "En producción"), T("ارسال", "Shipped", "الشحن", "Enviado"), T("تحویل", "Delivered", "التسليم", "Entregado") };
            int stage4 = Math.Min(Math.Max(Model.Stage, 1), 4);
            <div class="order-stepper" role="progressbar">
                @for (int i = 1; i <= 4; i++)
                {
                    var st = Model.Stage >= i ? "done" : stage4 + 1 == i ? "next" : "todo";
                    <span class="ostep @st"><b>@(Model.Stage > i ? "✓" : BARANG.B2C.Web.Services.AppDate.Digits(i.ToString(), culture))</b> @stepLabels[i - 1]</span>
                    @if (i < 4)
                    {
                        <span class="ostep-line @(Model.Stage >= i ? "done" : "")"></span>
                    }
                }
            </div>
            <p class="muted small eta-note">⏱ @T("زمان تحویل برآوردی: ۳ تا ۵ روز کاری پس از تأیید چاپ.", "Estimated delivery: 3–5 business days after print approval.", "التسليم المقدر: ٣-٥ أيام عمل بعد اعتماد الطباعة.", "Entrega estimada: 3-5 días hábiles tras aprobar la impresión.")</p>
        }

        @if (Model.Error is not null)
        {
            <div class="alert alert-error" role="alert">
                @(Model.Error switch
                {
                    "order.concurrency_conflict" or "core.database.concurrency_conflict" => T("سفارش هم‌زمان تغییر کرده؛ دوباره تلاش کنید.", "Order changed concurrently; try again.", "تم تغيير الطلب بالتزامن؛ حاول مجدداً.", "El pedido cambió simultáneamente; inténtalo de nuevo."),
                    "order.invalid_transition" or "order.not_draft" => T("این سفارش در وضعیت فعلی قابل لغو نیست.", "This order can no longer be cancelled.", "لا يمكن إلغاء هذا الطلب الآن.", "Este pedido ya no se puede cancelar."),
                    "order.cancellation_reason_required" => T("دلیل لغو الزامی است.", "Cancellation reason is required.", "سبب الإلغاء مطلوب.", "El motivo de cancelación es obligatorio."),
                    _ => T("عملیات انجام نشد؛ دوباره تلاش کنید.", "Operation failed; try again.", "فشلت العملية؛ حاول مجدداً.", "La operación falló; inténtalo de nuevo.")
                })
                <span class="muted small" dir="ltr"> @Model.Error</span>
            </div>
        }

        <div class="wizard-cols">
            <div style="display:flex;flex-direction:column;gap:1.1rem;min-width:0">
                <div class="card">
                    <h2>@T("اقلام سفارش", "Order items", "بنود الطلب", "Artículos del pedido")</h2>
                    @if (Model.Items.Count == 0)
                    {
                        <p class="muted">@T("آیتمی ثبت نشده.", "No items.", "لا بنود.", "No hay artículos.")</p>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <div class="order-item">
                            <div class="order-item-head">
                                <strong>@item.Product</strong>
                                <span class="chip">@Dig((int)item.Quantity) @Uom(item.Uom)</span>
                            </div>
                            @* سایز تکراری (XL · XL) و کد رنگ انگلیسی نمایش داده نمی‌شود — نام بومی رنگ *@
                            @{
                                string size = (item.Size ?? "").Trim();
                                string variant = (item.Variant ?? "").Trim();
                                string colorLabel = ColorName(item.Color);
                                var specs = new List<string>();
                                if (variant.Length > 0 && !string.Equals(variant, size, StringComparison.OrdinalIgnoreCase)) specs.Add(variant);
                                if (size.Length > 0) specs.Add(size);
                                if (colorLabel.Length > 0) specs.Add(colorLabel);
                            }
                            @if (specs.Count > 0)
                            {
                                <p class="muted small">@string.Join(" · ", specs)</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <p class="small item-notes">@BARANG.B2C.Web.Services.Display.FriendlyNotes(item.Notes, culture)</p>
                            }
                            @if (item.PrintOperations.Count > 0)
                            {
                                <div class="print-ops">
                                    @foreach (var op in item.PrintOperations)
                                    {
                                        <span class="print-op">
                                            <strong>@PositionLabel(op.Position)</strong>
                                            @(op.Width is decimal w && op.Height is decimal h ? $" · {Num(w)}×{Num(h)} cm" : "")
                                            @(string.IsNullOrWhiteSpace(op.Method) ? "" : $" · {op.Method}")
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (Model.ShippingAddress is not null)
                {
                    <div class="card">
                        <h2>@T("نشانی ارسال", "Shipping address", "عنوان الشحن", "Dirección de envío")</h2>
                        <p><strong>@(string.IsNullOrWhiteSpace(Model.ShippingAddress.RecipientName) ? "—" : Model.ShippingAddress.RecipientName)</strong> <span class="muted" dir="ltr">@Model.ShippingAddress.RecipientMobile</span></p>
                        <p class="muted small">@Model.ShippingAddress.Line @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress.PostalCode)) { <span dir="ltr"> · @Model.ShippingAddress.PostalCode</span> }</p>
                    </div>
                }

                @if (Model.Shipments.Count > 0)
                {
                    <div class="card">
                        <h2>@T("مرسولات", "Shipments", "الشحنات", "Envíos")</h2>
                        @foreach (var s in Model.Shipments)
                        {
                            <div class="shipment-mini">
                                <div class="address-head">
                                    <strong dir="ltr">@s.Number</strong>
                                    <span class="status-chip st-@s.Status.ToLowerInvariant()">@ShipmentLabel(s.Status)</span>
                                </div>
                                <p class="muted small">@T("حمل‌کننده", "Carrier", "الناقل", "Transportista"): <span dir="ltr">@s.Carrier</span> · @T("کد رهگیری", "Tracking", "رمز التتبع", "Seguimiento"): <strong dir="ltr">@(string.IsNullOrWhiteSpace(s.TrackingCode) ? "—" : s.TrackingCode)</strong>
                                    @if (!string.IsNullOrWhiteSpace(s.TrackingCode))
                                    {
                                        <button type="button" class="btn btn-ghost btn-sm" data-copy="@s.TrackingCode">@T("کپی", "Copy", "نسخ", "Copiar")</button>
                                    }
                                </p>
                                <p class="muted small">@T("ارسال", "Shipped", "الشحن", "Enviado"): @Model.DateText(s.ShippedAt) · @T("تحویل", "Delivered", "التسليم", "Entregado"): @Model.DateText(s.DeliveredAt)</p>
                            </div>
                        }
                    </div>
                }
            </div>

            <div style="display:flex;flex-direction:column;gap:1.1rem;min-width:0">
                <div class="card price-panel">
                    <h2>@T("خلاصه قیمت", "Price summary", "ملخص السعر", "Resumen de precios")</h2>
                    @if (QuoteRows.Count == 0 && TotalRow is null)
                    {
                        @* سفارش قیمت قطعی دارد (مثلاً پرداخت‌شده) ولی ریز تعرفه هنوز ثبت نشده: مبلغ واقعی نشان داده شود، نه وعده *@
                        @if (Model.WalletPayment is { } wpSum)
                        {
                            <div class="quote-total"><span>@T("مبلغ سفارش", "Order amount", "مبلغ الطلب", "Importe del pedido")</span><strong dir="ltr">@Mon(wpSum.Total)</strong></div>
                            <div class="quote-list-plain">
                                <span>@T("پرداخت‌شده", "Paid", "المدفوع", "Pagado"): @Mon(wpSum.Paid)</span>
                                @if (!wpSum.FullyPaid)
                                {
                                    <span>@T("باقی‌مانده", "Remaining", "المتبقي", "Restante"): @Mon(wpSum.Remaining)</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="muted small">@T("ریز قیمت پس از تأیید تولید محاسبه و همین‌جا نمایش داده می‌شود.", "The detailed price appears here once production tariffs are applied.", "يظهر تفصيل السعر بعد اعتماد التعريفات.", "El desglose aparece cuando se apliquen las tarifas de producción.")</p>
                        }
                    }
                    else
                    {
                        <ul class="quote-list">
                            @foreach (var (label, value) in QuoteRows)
                            {
                                <li><span>@label</span><strong dir="ltr">@value</strong></li>
                            }
                        </ul>
                        @if (TotalRow is var (tLabel, tValue))
                        {
                            <div class="quote-total"><span>@tLabel</span><strong dir="ltr">@tValue</strong></div>
                        }
                    }
                </div>

                @if (Cancellable)
                {
                    <div class="card cancel-card no-print">
                        <h2>@T("لغو سفارش", "Cancel order", "إلغاء الطلب", "Cancelar pedido")</h2>
                        @if (PaidOrder)
                        {
                            <p class="muted small">@T("این سفارش پرداخت شده است. لغو آن منجر به بازگشت کامل وجه به کیف پول شما در ۲ تا ۳ روز کاری می‌شود؛ پس از شروع چاپ امکان لغو نیست.", "This order is paid. Cancelling refunds the full amount to your wallet within 2–3 business days; cancellation is not possible once printing starts.", "هذا الطلب مدفوع. الإلغاء يعيد كامل المبلغ إلى محفظتك خلال ٢-٣ أيام عمل؛ لا يمكن الإلغاء بعد بدء الطباعة.", "Este pedido está pagado. Al cancelarlo se reembolsa el importe completo a tu billetera en 2-3 días hábiles; no se puede cancelar una vez iniciada la impresión.")</p>
                        }
                        <form method="post" asp-page-handler="Cancel" class="auth-form" data-confirm-cancel="@(PaidOrder ? "1" : "0")"
                              data-confirm-text="@T("این سفارش پرداخت‌شده لغو شود؟ وجه به کیف پول شما برمی‌گردد.", "Cancel this paid order? The amount refunds to your wallet.", "هل يُلغى هذا الطلب المدفوع؟ يُعاد المبلغ إلى محفظتك.", "¿Cancelar este pedido pagado? El importe se devuelve a tu billetera.")">
                            @if (Model.CancelReasons.Count > 0)
                            {
                                <label><span>@T("دلیل لغو", "Reason", "السبب", "Motivo")</span>
                                    <select asp-for="CancelReason">
                                        @foreach (var (code, name) in Model.CancelReasons)
                                        {
                                            <option value="@code">@name</option>
                                        }
                                    </select>
                                </label>
                            }
                            <label><span>@T("توضیح (اختیاری)", "Details (optional)", "تفاصيل", "Detalles (opcional)")</span>
                                <input type="text" asp-for="CancelText" />
                            </label>
                            <button type="submit" class="btn btn-danger">@T("لغو این سفارش", "Cancel this order", "إلغاء هذا الطلب", "Cancelar este pedido")</button>
                        </form>
                    </div>
                }

                @if (Model.Timeline.Count > 0)
                {
                    <div class="card">
                        <h2>@T("خط زمانی", "Timeline", "الخط الزمني", "Cronología")</h2>
                        <ol class="timeline">
                            @foreach (var e in Model.Timeline)
                            {
                                <li>
                                    <span class="timeline-dot" aria-hidden="true"></span>
                                    <div>
                                        <strong>@EventLabel(e.Type)</strong>
                                        <small class="muted">@Model.DateText(e.At)</small>
                                    </div>
                                </li>
                            }
                        </ol>
                    </div>
                }
            </div>
        </div>

        <div class="row-actions" style="margin-top:1.4rem">
            <button type="button" class="btn btn-ghost btn-sm no-print" onclick="window.print()">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 9V4h12v5M6 18v3h12v-3M4 9h16v9H4z"/></svg>
                @T("چاپ رسید", "Print receipt", "طباعة الإيصال", "Imprimir recibo")
            </button>
            <a class="btn btn-ghost btn-sm" href="/account/orders">@T("بازگشت به سفارش‌ها", "Back to orders", "العودة إلى الطلبات", "Volver a pedidos")</a>
        </div>
    </section>
    @* پاپ‌آپ بزرگ مشاهده طرح واقعی *@
    <div class="design-lightbox" id="design-lightbox" role="dialog" aria-modal="true" aria-label="@T("مشاهده طرح", "Design preview", "معاينة التصميم", "Vista previa del diseño")" hidden>
        <button type="button" class="design-lightbox-close" aria-label="@T("بستن", "Close", "إغلاق", "Cerrar")">×</button>
        <figure><img src="" alt="@T("طرح سفارش‌داده‌شده", "Ordered design", "التصميم المطلوب", "Diseño del pedido")" /></figure>
    </div>
    <script>
        // تأیید دومرحله‌ای لغو سفارش پرداخت‌شده
        document.querySelectorAll("form[data-confirm-cancel]").forEach(function (f) {
            f.addEventListener("submit", function (e) {
                if (f.getAttribute("data-confirm-cancel") === "1" && !window.confirm(f.getAttribute("data-confirm-text") || "")) e.preventDefault();
            });
        });
        // لایت‌باکس طرح: کلیک روی تصویر پنل → پنجره بزرگ با تصویر واقعی (بدون thumb)
        (function () {
            var box = document.getElementById("design-lightbox");
            if (!box) return;
            var img = box.querySelector("img");
            document.querySelectorAll(".order-design-view").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    img.src = btn.getAttribute("data-zoom") || "";
                    box.hidden = false;
                    document.body.style.overflow = "hidden";
                });
            });
            function close() { box.hidden = true; img.src = ""; document.body.style.overflow = ""; }
            box.addEventListener("click", function (e) { if (e.target === box || e.target.classList.contains("design-lightbox-close")) close(); });
            document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !box.hidden) close(); });
        })();
    </script>
}
@functions {
    private string DisplayValue(string? code) => (code ?? "").Trim().ToUpperInvariant() switch
    {
        "FRONT" => "جلو",
        "BACK" => "پشت",
        _ => code ?? "—"
    };
}
