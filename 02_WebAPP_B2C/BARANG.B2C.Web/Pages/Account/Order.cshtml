@page "/account/orders/{id:guid}"
@model OrderModel
@using System.Globalization
@using System.Text.Json
@{
    Layout = "_AccountLayout";
    ViewData["PanelActive"] = "orders";
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    string OrderLabel(string s) => s switch
    {
        "Draft" => T("پیش‌نویس", "Draft", "مسودة"),
        "Submitted" => T("ثبت‌شده — در حال پردازش", "Submitted — in progress", "مُرسل — قيد المعالجة"),
        "Cancelled" => T("لغوشده", "Cancelled", "ملغى"),
        "Delivered" => T("تحویل‌شده", "Delivered", "تم التسليم"),
        _ => s
    };
    string ShipmentLabel(string s) => s switch
    {
        "Ready" => T("آماده ارسال", "Ready to ship", "جاهز للشحن"),
        "Shipped" => T("ارسال‌شده", "Shipped", "مشحون"),
        "InTransit" => T("در حال حمل", "In transit", "في الطريق"),
        "Delivered" => T("تحویل‌شده", "Delivered", "تم التسليم"),
        "FailedDelivery" => T("ارسال ناموفق", "Failed delivery", "فشل التسليم"),
        "Returned" => T("برگشتی", "Returned", "مرتجع"),
        _ => s
    };
    string EventLabel(string t) => t switch
    {
        "Submitted" => T("سفارش ثبت شد", "Order submitted", "تم إرسال الطلب"),
        "Cancelled" => T("سفارش لغو شد", "Order cancelled", "تم إلغاء الطلب"),
        "StatusChanged" => T("به‌روزرسانی وضعیت", "Status updated", "تحديث الحالة"),
        _ => t
    };
    string PositionLabel(string p) => p switch
    {
        "FRONT" => T("جلو", "Front", "الأمام"),
        "BACK" => T("پشت", "Back", "الخلف"),
        "SLEEVE" => T("آستین", "Sleeve", "الكم"),
        "OTHER" => T("سایر", "Other", "أخرى"),
        _ => p
    };
    string Num(decimal d) => d.ToString("0.##", CultureInfo.InvariantCulture);
    (string Label, string Value)? TotalRow = null;
    List<(string Label, string Value)> QuoteRows = new();
    if (Model.Quote is JsonElement q && q.ValueKind == JsonValueKind.Object)
    {
        foreach (var prop in q.EnumerateObject())
        {
            string text = prop.Value.ValueKind switch
            {
                JsonValueKind.Number => prop.Value.GetRawText(),
                JsonValueKind.String => prop.Value.GetString() ?? "",
                _ => ""
            };
            if (text.Length == 0) continue;
            if (prop.Name.Equals("total", StringComparison.OrdinalIgnoreCase) || prop.Name.Equals("totalAmount", StringComparison.OrdinalIgnoreCase) || prop.Name.Equals("grandTotal", StringComparison.OrdinalIgnoreCase))
            {
                TotalRow = (T("مبلغ کل", "Total", "الإجمالي"), text);
            }
            else if (prop.Value.ValueKind == JsonValueKind.Number)
            {
                QuoteRows.Add((prop.Name, text));
            }
        }
    }
    bool Cancellable = Model.OrderStatus is "Draft" or "Submitted";
}
@if (!Model.Found)
{
    <section class="container section"><p class="empty">@T("سفارش پیدا نشد.", "Order not found.", "لم يتم العثور على الطلب.")</p></section>
}
else
{
    <section class="container section">
        <nav class="breadcrumbs no-print" aria-label="breadcrumb">
            <a href="/account">@T("حساب کاربری", "My account", "حسابي")</a> ›
            <a href="/account/orders">@T("سفارش‌ها", "Orders", "الطلبات")</a> ›
            <span dir="ltr">@(Model.OrderNumber ?? "—")</span>
        </nav>
        <header class="section-head tracking-head">
            <div>
                <h1>@T("سفارش", "Order", "الطلب") <span dir="ltr">@(Model.OrderNumber ?? "—")</span></h1>
                <p class="muted">@T("تاریخ سفارش", "Order date", "تاريخ الطلب"): @Model.DateText(Model.OrderDate) @if (Model.SubmittedAt is not null) { <span> · @T("ثبت: ", "Submitted: ", "أُرسل: ")@Model.DateText(Model.SubmittedAt)</span> }</p>
            </div>
            <span class="status-chip st-@Model.OrderStatus.ToLowerInvariant() status-lg">@OrderLabel(Model.OrderStatus)</span>
        </header>

        @if (Model.Paid == "1")
        {
            <div class="alert alert-ok" role="status">✓ @T("پرداخت از کیف پول با موفقیت انجام شد.", "Wallet payment completed successfully.", "تم الدفع من المحفظة بنجاح.")</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.PayError))
        {
            <div class="alert alert-error" role="alert">
                @(Model.PayError == "wallet.insufficient_balance"
                    ? T("موجودی کیف پول برای پرداخت این سفارش کافی نیست.", "Your wallet balance is not enough for this order.", "رصيد المحفظة غير كافٍ لهذا الطلب.")
                    : T("پرداخت انجام نشد؛ دوباره تلاش کنید.", "Payment failed; try again.", "فشل الدفع؛ حاول مجدداً."))
                <a href="/account/wallet">@T("شارژ کیف پول", "Top up wallet", "شحن المحفظة")</a>
            </div>
        }

        @if (Model.WalletPayment is { } wp && Model.OrderStatus != "Cancelled" && Model.OrderStatus != "Draft")
        {
            <div class="card wallet-pay-card">
                <div class="wallet-pay-row">
                    <div>
                        <strong>@T("وضعیت پرداخت", "Payment status", "حالة الدفع")</strong>
                        @if (wp.FullyPaid)
                        {
                            <span class="topup-status st-paid">@T("پرداخت‌شده", "Paid", "مدفوع")</span>
                        }
                        else
                        {
                            <span class="topup-status st-pending">@T("پرداخت‌نشده", "Unpaid", "غير مدفوع")</span>
                        }
                    </div>
                    <div class="wallet-pay-amounts">
                        <span>@T("مبلغ کل", "Total", "الإجمالي"): <strong dir="ltr">@wp.Total.ToString("N0", CultureInfo.GetCultureInfo(culture == "en" ? "en" : "fa"))</strong></span>
                        <span>@T("پرداخت‌شده", "Paid", "المدفوع"): <strong dir="ltr">@wp.Paid.ToString("N0", CultureInfo.GetCultureInfo(culture == "en" ? "en" : "fa"))</strong></span>
                        @if (!wp.FullyPaid)
                        {
                            <span>@T("باقی‌مانده", "Remaining", "المتبقي"): <strong dir="ltr">@wp.Remaining.ToString("N0", CultureInfo.GetCultureInfo(culture == "en" ? "en" : "fa"))</strong></span>
                        }
                    </div>
                    @if (!wp.FullyPaid && Model.OrderStatus == "Submitted")
                    {
                        <form method="post" asp-page-handler="PayWallet" class="inline-form">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary" disabled="@(wp.WalletBalance < wp.Remaining)">
                                @T($"پرداخت {wp.Remaining:N0} تومانی از کیف پول", $"Pay {wp.Remaining:N0} Toman from wallet", $"دفع {wp.Remaining:N0} تومان من المحفظة")
                            </button>
                            @if (wp.WalletBalance < wp.Remaining)
                            {
                                <small class="muted">@T("موجودی کافی نیست.", "Insufficient balance.", "الرصيد غير كافٍ.")</small>
                            }
                        </form>
                    }
                </div>
            </div>
        }

        @if (Model.OrderStatus == "Cancelled")
        {
            <div class="alert alert-error cancelled-banner" role="alert">✕ @T("این سفارش لغو شده است.", "This order was cancelled.", "تم إلغاء هذا الطلب.")</div>
        }
        else
        {
            <div class="order-stepper" role="progressbar">
                @{ var labels = new[] { T("ثبت سفارش", "Submitted", "إرسال الطلب"), T("ارسال", "Shipped", "الشحن"), T("تحویل", "Delivered", "التسليم") }; }
                @for (int i = 1; i <= 3; i++)
                {
                    var st = Model.Stage >= i ? "done" : Model.Stage + 1 == i ? "next" : "todo";
                    <span class="ostep @st"><b>@(Model.Stage > i ? "✓" : i)</b> @labels[i - 1]</span>
                    @if (i < 3)
                    {
                        <span class="ostep-line @(Model.Stage >= i ? "done" : "")"></span>
                    }
                }
            </div>
        }

        @if (Model.Error is not null)
        {
            <div class="alert alert-error" role="alert">
                @(Model.Error switch
                {
                    "order.concurrency_conflict" or "core.database.concurrency_conflict" => T("سفارش هم‌زمان تغییر کرده؛ دوباره تلاش کنید.", "Order changed concurrently; try again.", "تم تغيير الطلب بالتزامن؛ حاول مجدداً."),
                    "order.invalid_transition" or "order.not_draft" => T("این سفارش در وضعیت فعلی قابل لغو نیست.", "This order can no longer be cancelled.", "لا يمكن إلغاء هذا الطلب الآن."),
                    "order.cancellation_reason_required" => T("دلیل لغو الزامی است.", "Cancellation reason is required.", "سبب الإلغاء مطلوب."),
                    _ => T("عملیات انجام نشد؛ دوباره تلاش کنید.", "Operation failed; try again.", "فشلت العملية؛ حاول مجدداً.")
                })
                <span class="muted small" dir="ltr"> @Model.Error</span>
            </div>
        }

        <div class="wizard-cols">
            <div style="display:flex;flex-direction:column;gap:1.1rem;min-width:0">
                <div class="card">
                    <h2>@T("اقلام سفارش", "Order items", "بنود الطلب")</h2>
                    @if (Model.Items.Count == 0)
                    {
                        <p class="muted">@T("آیتمی ثبت نشده.", "No items.", "لا بنود.")</p>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <div class="order-item">
                            <div class="order-item-head">
                                <strong>@item.Product</strong>
                                <span class="chip">@Num(item.Quantity) @item.Uom</span>
                            </div>
                            <p class="muted small">
                                @(string.Join(" · ", new[] { item.Variant, item.Size, item.Color }.Where(s => !string.IsNullOrWhiteSpace(s))))
                            </p>
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <p class="small item-notes">@item.Notes</p>
                            }
                            @if (item.PrintOperations.Count > 0)
                            {
                                <div class="print-ops">
                                    @foreach (var op in item.PrintOperations)
                                    {
                                        <span class="print-op">
                                            <strong>@PositionLabel(op.Position)</strong>
                                            @(op.Width is decimal w && op.Height is decimal h ? $" · {Num(w)}×{Num(h)} cm" : "")
                                            @(string.IsNullOrWhiteSpace(op.Method) ? "" : $" · {op.Method}")
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (Model.ShippingAddress is not null)
                {
                    <div class="card">
                        <h2>@T("نشانی ارسال", "Shipping address", "عنوان الشحن")</h2>
                        <p><strong>@(string.IsNullOrWhiteSpace(Model.ShippingAddress.RecipientName) ? "—" : Model.ShippingAddress.RecipientName)</strong> <span class="muted" dir="ltr">@Model.ShippingAddress.RecipientMobile</span></p>
                        <p class="muted small">@Model.ShippingAddress.Line @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress.PostalCode)) { <span dir="ltr"> · @Model.ShippingAddress.PostalCode</span> }</p>
                    </div>
                }

                @if (Model.Shipments.Count > 0)
                {
                    <div class="card">
                        <h2>@T("مرسولات", "Shipments", "الشحنات")</h2>
                        @foreach (var s in Model.Shipments)
                        {
                            <div class="shipment-mini">
                                <div class="address-head">
                                    <strong dir="ltr">@s.Number</strong>
                                    <span class="status-chip st-@s.Status.ToLowerInvariant()">@ShipmentLabel(s.Status)</span>
                                </div>
                                <p class="muted small">@T("حمل‌کننده", "Carrier", "الناقل"): <span dir="ltr">@s.Carrier</span> · @T("کد رهگیری", "Tracking", "رمز التتبع"): <strong dir="ltr">@(string.IsNullOrWhiteSpace(s.TrackingCode) ? "—" : s.TrackingCode)</strong></p>
                                <p class="muted small">@T("ارسال", "Shipped", "الشحن"): @Model.DateText(s.ShippedAt) · @T("تحویل", "Delivered", "التسليم"): @Model.DateText(s.DeliveredAt)</p>
                            </div>
                        }
                    </div>
                }
            </div>

            <div style="display:flex;flex-direction:column;gap:1.1rem;min-width:0">
                <div class="card price-panel">
                    <h2>@T("خلاصه قیمت", "Price summary", "ملخص السعر")</h2>
                    @if (QuoteRows.Count == 0 && TotalRow is null)
                    {
                        <p class="muted small">@T("قیمت پس از تعریف تعرفه‌ها محاسبه می‌شود.", "Price appears once tariffs are set.", "يظهر السعر بعد تعيين التعريفات.")</p>
                    }
                    else
                    {
                        <ul class="quote-list">
                            @foreach (var (label, value) in QuoteRows)
                            {
                                <li><span>@label</span><strong dir="ltr">@value</strong></li>
                            }
                        </ul>
                        @if (TotalRow is var (tLabel, tValue))
                        {
                            <div class="quote-total"><span>@tLabel</span><strong dir="ltr">@tValue</strong></div>
                        }
                    }
                </div>

                @if (Cancellable)
                {
                    <div class="card cancel-card no-print">
                        <h2>@T("لغو سفارش", "Cancel order", "إلغاء الطلب")</h2>
                        <form method="post" asp-page-handler="Cancel" class="auth-form">
                            @if (Model.CancelReasons.Count > 0)
                            {
                                <label><span>@T("دلیل لغو", "Reason", "السبب")</span>
                                    <select asp-for="CancelReason">
                                        @foreach (var (code, name) in Model.CancelReasons)
                                        {
                                            <option value="@code">@name</option>
                                        }
                                    </select>
                                </label>
                            }
                            <label><span>@T("توضیح (اختیاری)", "Details (optional)", "تفاصيل")</span>
                                <input type="text" asp-for="CancelText" />
                            </label>
                            <button type="submit" class="btn btn-danger">@T("لغو این سفارش", "Cancel this order", "إلغاء هذا الطلب")</button>
                        </form>
                    </div>
                }

                @if (Model.Timeline.Count > 0)
                {
                    <div class="card">
                        <h2>@T("خط زمانی", "Timeline", "الخط الزمني")</h2>
                        <ol class="timeline">
                            @foreach (var e in Model.Timeline)
                            {
                                <li>
                                    <span class="timeline-dot" aria-hidden="true"></span>
                                    <div>
                                        <strong>@EventLabel(e.Type)</strong>
                                        <small class="muted">@Model.DateText(e.At)</small>
                                    </div>
                                </li>
                            }
                        </ol>
                    </div>
                }
            </div>
        </div>

        <div class="row-actions" style="margin-top:1.4rem">
            <button type="button" class="btn btn-ghost btn-sm no-print" onclick="window.print()">🖨 @T("چاپ رسید", "Print receipt", "طباعة الإيصال")</button>
            <a class="btn btn-ghost btn-sm" href="/account/orders">→ @T("بازگشت به سفارش‌ها", "Back to orders", "العودة إلى الطلبات")</a>
        </div>
    </section>
}
