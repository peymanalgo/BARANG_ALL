@page
@model OrdersModel
@using System.Globalization
@{
    Layout = "_AccountLayout";
    ViewData["PanelActive"] = "orders";
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar, string? es = null) => culture switch { "en" => en, "ar" => ar, "es" => es ?? en, _ => fa };
    string StatusLabel(string s) => s switch
    {
        "Draft" => T("پیش‌نویس", "Draft", "مسودة", "Borrador"),
        "Submitted" => T("ثبت‌شده", "Submitted", "مُرسل", "Enviado"),
        "Cancelled" => T("لغوشده", "Cancelled", "ملغى", "Cancelado"),
        "Delivered" => T("تحویل‌شده", "Delivered", "تم التسليم", "Entregado"),
        _ => s
    };
    string DateText(string? iso) => DateTimeOffset.TryParse(iso, out DateTimeOffset d) ? BARANG.B2C.Web.Services.AppDate.Format(d, culture) : "—";
    ViewData["Title"] = T("سفارش‌های من", "My orders", "طلباتي", "Mis pedidos");
}
<section class="container section">
    <nav class="breadcrumbs" aria-label="breadcrumb">
        <a href="/account">@T("حساب کاربری", "My account", "حسابي", "Mi cuenta")</a> ›
        <span>@T("سفارش‌ها", "Orders", "الطلبات", "Pedidos")</span>
    </nav>
    <header class="section-head">
        <h1>@T("سفارش‌های من", "My orders", "طلباتي", "Mis pedidos")</h1>
        <a class="btn btn-primary btn-sm" href="/order/wizard">@T("سفارش جدید", "New order", "طلب جديد", "Nuevo pedido")</a>
    </header>

    @if (!Model.HasProfile)
    {
        <p class="empty">@T("برای دیدن سفارش‌ها ابتدا از «حساب کاربری» پروفایل مشتری بسازید.", "Create your customer profile from the account hub first.", "أنشئ ملفك من مركز الحساب أولاً.", "Primero crea tu perfil de cliente desde el centro de la cuenta.")</p>
    }
    else if (Model.Orders.Count == 0)
    {
        <p class="empty">@T("هنوز سفارشی ثبت نکرده‌اید.", "You have no orders yet.", "لا توجد طلبات بعد.", "Aún no tienes pedidos.")</p>
    }
    else
    {
        <form method="get" class="orders-search" style="margin-bottom:12px;display:flex;gap:8px;">
            <input type="search" name="search" value="@Model.Search" placeholder="@T("جستجوی شماره سفارش…", "Search order number…", "جستجوی شماره سفارش…", "Buscar número de pedido…")" style="flex:1;max-width:340px;border:1px solid var(--panel-border);border-radius:10px;padding:9px 12px;font:inherit;background:#fff;color:var(--panel-ink)" />
            <button type="submit" class="btn btn-primary btn-sm">@T("جستجو", "Search", "بحث", "Buscar")</button>
        </form>
        @* فیلتر وضعیت — سمت کلاینت، بدون رفت‌وبرگشت *@
        <div class="order-filters" role="tablist">
            <button type="button" class="ofilter on" data-f="all">@T("همه", "All", "الكل", "Todas")</button>
            <button type="button" class="ofilter" data-f="Submitted">@T("در جریان", "In progress", "قيد التنفيذ", "En curso")</button>
            <button type="button" class="ofilter" data-f="Delivered">@T("تحویل‌شده", "Delivered", "تم التسليم", "Entregadas")</button>
            <button type="button" class="ofilter" data-f="Draft">@T("پیش‌نویس", "Draft", "مسودة", "Borrador")</button>
            <button type="button" class="ofilter" data-f="Cancelled">@T("لغوشده", "Cancelled", "ملغى", "Canceladas")</button>
        </div>
        <div class="order-list">
            @foreach (var o in Model.Orders)
            {
                <a class="card order-card" href="/account/orders/@o.Id" data-status="@o.Status">
                    <div class="order-main">
                        <strong class="order-number" dir="ltr">@o.Number</strong>
                        <span class="order-date muted">@DateText(o.CreatedAtUtc ?? o.OrderDate)</span>
                    </div>
                    @if (o.Status == "Draft")
                    {
                        @* پیش‌نویس بدون شماره قطعی — برچسب شفاف + راه ادامه سفارش *@
                        <span class="chip">@T("ادامه سفارش ←", "Resume order →", "متابعة الطلب ←", "Continuar pedido →")</span>
                    }
                    <span class="status-chip st-@o.Status.ToLowerInvariant()">@StatusLabel(o.Status)</span>
                    <span class="order-go" dir="ltr" aria-hidden="true">@(culture == "en" ? "›" : "‹")</span>
                </a>
            }
        </div>
        @* صفحه‌بندی فقط وقتی بیش از یک صفحه است *@
        @if (Model.Total > 8)
        {
            <nav class="pagination" aria-label="pagination">
                @if (Model.HasPrev)
                {
                    <a class="btn btn-ghost btn-sm" href="/account/orders?page=@(Model.Page - 1)">← @T("قبلی", "Previous", "السابق", "Anterior")</a>
                }
                <span class="page-info">@BARANG.B2C.Web.Services.AppDate.Digits(Model.Page.ToString(), culture) / @BARANG.B2C.Web.Services.AppDate.Digits(Math.Max(1, (int)Math.Ceiling(Model.Total / 8.0)).ToString(), culture)</span>
                @if (Model.HasNext)
                {
                    <a class="btn btn-ghost btn-sm" href="/account/orders?page=@(Model.Page + 1)">@T("بعدی", "Next", "التالي", "Siguiente") →</a>
                }
            </nav>
        }
    }
</section>
<script>
    // فیلتر وضعیت سفارش‌ها
    document.querySelectorAll(".ofilter").forEach(function (b) {
        b.addEventListener("click", function () {
            document.querySelectorAll(".ofilter").forEach(function (x) { x.classList.remove("on"); });
            b.classList.add("on");
            var f = b.getAttribute("data-f");
            document.querySelectorAll(".order-card").forEach(function (c) {
                c.style.display = (f === "all" || c.getAttribute("data-status") === f) ? "" : "none";
            });
        });
    });
</script>
