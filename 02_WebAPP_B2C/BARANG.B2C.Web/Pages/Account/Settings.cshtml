@page
@model SettingsModel
@using System.Globalization
@{
    Layout = "_AccountLayout";
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar, string? es = null) => culture switch { "en" => en, "ar" => ar, "es" => es ?? en, _ => fa };
    ViewData["PanelActive"] = "settings";
    ViewData["PanelTitle"] = T("تنظیمات", "Settings", "الإعدادات", "Ajustes");
    // سوییچر زبان — همان وعده متن صفحه («زبان فروشگاه را از همین‌جا مدیریت کن»)
    string CultureLink(string c) => "/language/set?culture=" + c + "&returnUrl=" + Uri.EscapeDataString("/account/settings");
    (string Code, string Name)[] langs = [("fa", "فارسی"), ("en", "English"), ("ar", "العربية"), ("es", "Español")];
}

<div class="panel-content">
    <header class="panel-page-head">
        <h1>@T("تنظیمات", "Settings", "الإعدادات", "Ajustes")</h1>
        <p class="muted">@T("حسابت، امنیت و زبان فروشگاه را از همین‌جا مدیریت کن.", "Manage your account, security and store language here.", "أدر حسابك وأمنك ولغة المتجر من هنا.", "Gestiona aquí tu cuenta, la seguridad y el idioma de la tienda.")</p>
    </header>

    <div class="settings-grid">
        <a class="dash-quick" href="/account/profile">
            <strong>@T("اطلاعات حساب", "Account info", "بيانات الحساب", "Datos de la cuenta")</strong>
            <span>@T("نام، موبایل و اطلاعات تماس.", "Name, mobile and contact info.", "الاسم والهاتف وبيانات الاتصال.", "Nombre, móvil y datos de contacto.")</span>
        </a>
        <a class="dash-quick" href="/account/addresses">
            <strong>@T("آدرس‌ها", "Addresses", "العناوين", "Direcciones")</strong>
            <span>@T("نشانی‌های ارسال و نشانی پیش‌فرض.", "Shipping addresses and the default one.", "عناوين الشحن والعنوان الافتراضي.", "Direcciones de envío y la predeterminada.")</span>
        </a>

        <div class="dash-card settings-password">
            <h2>@T("تغییر کلمه عبور", "Change password", "تغيير كلمة المرور", "Cambiar contraseña")</h2>
            @if (Model.Error == "empty" || Model.Error == "failed")
            {
                <div class="alert alert-error" role="alert">@T("تغییر کلمه عبور ناموفق بود؛ کلمه عبور فعلی و کلمه جدید (حداقل ۹ نویسه) را درست وارد کن.", "Password change failed; check the current password and the new one (min 9 chars).", "فشل تغيير كلمة المرور؛ تحقق من الحالية والجديدة (٩ أحرف على الأقل).", "Error al cambiar la contraseña; revisa la actual y la nueva (mín. 9 caracteres).")</div>
            }
            @if (Model.Error == "empty")
            {
                <div class="alert alert-error" role="alert">@T("هر دو کلمه عبور الزامی است.", "Both passwords are required.", "كلا كلمتي المرور مطلوبتان.", "Se requieren ambas contraseñas.")</div>
            }
            <form method="post" asp-page="/Account/ChangePassword" class="auth-form">
                <label>
                    <span>@T("کلمه عبور فعلی", "Current password", "كلمة المرور الحالية", "Contraseña actual")</span>
                    <input type="password" name="currentPassword" autocomplete="current-password" required />
                </label>
                <label>
                    <span>@T("کلمه عبور جدید", "New password", "كلمة المرور الجديدة", "Nueva contraseña")</span>
                    <input type="password" name="newPassword" autocomplete="new-password" minlength="9" required />
                </label>
                <button type="submit" class="btn btn-primary">@T("تغییر کلمه عبور", "Change password", "تغيير", "Cambiar contraseña")</button>
                <small class="muted">@T("پس از تغییر، همه نشست‌ها بسته می‌شوند و دوباره وارد می‌شوی.", "All sessions are revoked after the change and you sign in again.", "تُبطل جميع الجلسات بعد التغيير وتسجل الدخول مجدداً.", "Tras el cambio se revocan todas las sesiones y deberás iniciar sesión de nuevo.")</small>
            </form>
        </div>

        <div class="dash-card settings-language">
            <h2>@T("زبان فروشگاه", "Store language", "لغة المتجر", "Idioma de la tienda")</h2>
            <div class="settings-langs">
                @foreach (var (code, name) in langs)
                {
                    <a class="btn btn-sm @(code == culture ? "btn-primary" : "btn-ghost")" href="@CultureLink(code)" hreflang="@code">@name</a>
                }
            </div>
        </div>

        <form method="post" asp-page="/Account/Index" asp-page-handler="Logout" class="dash-card settings-logout">
            <h2>@T("خروج از حساب", "Sign out", "تسجيل الخروج", "Cerrar sesión")</h2>
            <button type="submit" class="btn btn-ghost danger">@T("خروج", "Sign out", "خروج", "Cerrar sesión")</button>
        </form>
    </div>
</div>
