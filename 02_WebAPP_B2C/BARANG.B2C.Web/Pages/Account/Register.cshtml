@page
@model RegisterModel
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    ViewData["Title"] = T("ثبت‌نام در پیرنگ خان", "Create your account", "إنشاء حساب");
}
<section class="container section auth-section">
    <div class="auth-card">
        <h1>@T("ثبت‌نام", "Sign up", "التسجيل")</h1>
        <p class="muted">@T("در دو قدم حساب بسازید: نامتان و ایمیل یا شماره موبایل، بعد کد تأیید.", "Two steps: your name and email or mobile, then the verification code.", "خطوتان: الاسم والبريد أو الهاتف، ثم رمز التحقق.")</p>
        @if (Model.Error is not null)
        {
            <div class="alert alert-error" role="alert">@Model.Error</div>
        }
        @if (!Model.CodeSent)
        {
            <form method="post" asp-page-handler="RequestCode" class="auth-form">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <label>
                    <span>@T("نام", "First name", "الاسم")</span>
                    <input type="text" asp-for="FirstName" autocomplete="given-name" required />
                </label>
                <label>
                    <span>@T("نام خانوادگی", "Last name", "اسم العائلة")</span>
                    <input type="text" asp-for="LastName" autocomplete="family-name" required />
                </label>
                <label>
                    <span>@T("ایمیل یا شماره تلفن", "Email or mobile number", "البريد الإلكتروني أو الهاتف")</span>
                    <input type="text" asp-for="Target" dir="ltr" autocomplete="email" placeholder="09121234567" required />
                </label>
                <button type="submit" class="btn btn-primary btn-lg btn-block">@T("دریافت کد تأیید", "Send verification code", "إرسال رمز التحقق")</button>
            </form>
            <p class="muted small">@T("قبلاً ثبت‌نام کرده‌اید؟", "Already have an account?", "لديك حساب بالفعل؟") <a href="/account/login">@T("وارد شوید", "Sign in", "سجّل الدخول")</a></p>
        }
        else
        {
            <div class="alert alert-ok" role="status">@T($"کد تأیید به {Model.MaskedTarget} ارسال شد.", $"A verification code was sent to {Model.MaskedTarget}.", $"تم إرسال رمز التحقق إلى {Model.MaskedTarget}.")</div>
            <form method="post" asp-page-handler="Verify" class="auth-form">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <input type="hidden" asp-for="FirstName" />
                <input type="hidden" asp-for="LastName" />
                <input type="hidden" asp-for="Target" />
                <label>
                    <span>@T("کد تأیید", "Verification code", "رمز التحقق")</span>
                    <input type="text" asp-for="Code" dir="ltr" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="1111" required />
                </label>
                <p class="muted small">@T("محیط آزمایشی: کد ثابت ۱۱۱۱ را وارد کنید.", "Development environment: enter the fixed code 1111.", "بيئة التطوير: أدخل الرمز الثابت 1111.")</p>
                <button type="submit" class="btn btn-primary btn-lg btn-block">@T("تأیید و ساخت حساب", "Verify and create account", "تحقق وأنشئ الحساب")</button>
            </form>
            @if (Model.AlreadyRegistered)
            {
                <p class="muted small"><a href="/account/login">@T("ورود با همین شماره/ایمیل", "Sign in with this email/mobile", "الدخول بنفس البريد/الهاتف")</a></p>
            }
        }
    </div>
</section>
