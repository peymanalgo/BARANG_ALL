@page
@model RegisterModel
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar, string? es = null) => culture switch { "en" => en, "ar" => ar, "es" => es ?? en, _ => fa };
    ViewData["Title"] = T("ثبت‌نام در پی‌رنگ", "Create your account", "إنشاء حساب", "Crea tu cuenta");
}
<section class="container section auth-section">
    <div class="auth-card">
        <h1>@T("ثبت‌نام", "Sign up", "التسجيل", "Registrarse")</h1>
        <p class="muted">@T("در دو قدم حساب بسازید: نامتان و ایمیل یا شماره موبایل، بعد کد تأیید.", "Two steps: your name and email or mobile, then the verification code.", "خطوتان: الاسم والبريد أو الهاتف، ثم رمز التحقق.", "Dos pasos: tu nombre y correo o móvil, y luego el código de verificación.")</p>
        @if (Model.Error is not null)
        {
            <div class="alert alert-error" role="alert">@Model.Error</div>
        }
        @if (!Model.CodeSent)
        {
            <form method="post" asp-page-handler="RequestCode" class="auth-form">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <label>
                    <span>@T("نام", "First name", "الاسم", "Nombre")</span>
                    <input type="text" asp-for="FirstName" autocomplete="given-name" required />
                </label>
                <label>
                    <span>@T("نام خانوادگی", "Last name", "اسم العائلة", "Apellido")</span>
                    <input type="text" asp-for="LastName" autocomplete="family-name" required />
                </label>
                <label>
                    <span>@T("ایمیل یا شماره تلفن", "Email or mobile number", "البريد الإلكتروني أو الهاتف", "Correo electrónico o número de móvil")</span>
                    <input type="text" asp-for="Target" dir="ltr" autocomplete="email" placeholder="09121234567" required />
                </label>
                <label>
                    <span>@T("کد دعوت (اختیاری)", "Invitation code (optional)", "رمز الدعوة (اختياري)", "Código de invitación (opcional)")</span>
                    <input type="text" name="InviteCode" dir="ltr" placeholder="ABC123" value="@(Model.InviteCode ?? "")" maxlength="20" />
                </label>
                <button type="submit" class="btn btn-primary btn-lg btn-block">@T("دریافت کد تأیید", "Send verification code", "إرسال رمز التحقق", "Enviar código de verificación")</button>
            </form>
            <p class="muted small">@T("قبلاً ثبت‌نام کرده‌اید؟", "Already have an account?", "لديك حساب بالفعل؟", "¿Ya tienes cuenta?") <a href="/account/login">@T("وارد شوید", "Sign in", "سجّل الدخول", "Iniciar sesión")</a></p>
        }
        else
        {
            <div class="alert alert-ok" role="status">@T($"کد تأیید به {Model.MaskedTarget} ارسال شد.", $"A verification code was sent to {Model.MaskedTarget}.", $"تم إرسال رمز التحقق إلى {Model.MaskedTarget}.", $"Se envió un código de verificación a {Model.MaskedTarget}.")</div>
            <form method="post" asp-page-handler="Verify" class="auth-form">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <input type="hidden" asp-for="FirstName" />
                <input type="hidden" asp-for="LastName" />
                <input type="hidden" asp-for="Target" />
                <label>
                    <span>@T("کد تأیید", "Verification code", "رمز التحقق", "Código de verificación")</span>
                    <input type="text" asp-for="Code" dir="ltr" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="1111" required />
                </label>
                <label>
                    <span>@T("رمز عبور", "Password", "كلمة المرور", "Contraseña")</span>
                    <input type="password" asp-for="Password" dir="ltr" autocomplete="new-password" required />
                </label>
                <label>
                    <span>@T("تکرار رمز عبور", "Confirm password", "تأكيد كلمة المرور", "Confirmar contraseña")</span>
                    <input type="password" asp-for="ConfirmPassword" dir="ltr" autocomplete="new-password" required />
                </label>
                <p class="muted small">@T("رمز عبور حداقل ۹ کاراکتر با حرف بزرگ، حرف کوچک و رقم — بعداً می‌توانید با همین رمز (بدون کد پیامکی) وارد شوید.", "Password: at least 9 characters with an uppercase letter, a lowercase letter and a digit — you can later sign in with it instead of the SMS code.", "كلمة المرور: 9 أحرف على الأقل مع حرف كبير وحرف صغير ورقم — يمكنك لاحقًا الدخول بها بدلاً من رمز SMS.", "Contraseña: al menos 9 caracteres con una mayúscula, una minúscula y un dígito; luego podrás iniciar sesión con ella en lugar del código SMS.")</p>
                <p class="muted small">@T("محیط آزمایشی: کد ثابت ۱۱۱۱ را وارد کنید.", "Development environment: enter the fixed code 1111.", "بيئة التطوير: أدخل الرمز الثابت 1111.", "Entorno de desarrollo: introduce el código fijo 1111.")</p>
                <button type="submit" class="btn btn-primary btn-lg btn-block">@T("تأیید و ساخت حساب", "Verify and create account", "تحقق وأنشئ الحساب", "Verificar y crear cuenta")</button>
            </form>
            @if (Model.AlreadyRegistered)
            {
                <p class="muted small"><a href="/account/login">@T("ورود با همین شماره/ایمیل", "Sign in with this email/mobile", "الدخول بنفس البريد/الهاتف", "Iniciar sesión con este correo/móvil")</a></p>
            }
        }
    </div>
</section>
