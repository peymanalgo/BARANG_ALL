@page
@model AddressesModel
@{
    Layout = "_AccountLayout";
    ViewData["PanelActive"] = "addresses";
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar, string? es = null) => culture switch { "en" => en, "ar" => ar, "es" => es ?? en, _ => fa };
    string TypeLabel(string code) => code switch
    {
        "home" => T("خانه", "Home", "المنزل", "Casa"),
        "work" => T("محل کار", "Work", "العمل", "Trabajo"),
        "other" => T("سایر", "Other", "أخرى", "Otro"),
        _ => code
    };
    ViewData["Title"] = T("نشانی‌های من", "My addresses", "عناويني", "Mis direcciones");
}
<section class="container section">
    <nav class="breadcrumbs" aria-label="breadcrumb">
        <a href="/account">@T("حساب کاربری", "My account", "حسابي", "Mi cuenta")</a> ›
        <span>@T("نشانی‌ها", "Addresses", "العناوين", "Direcciones")</span>
    </nav>
    <header class="section-head">
        <h1>@T("نشانی‌های من", "My addresses", "عناويني", "Mis direcciones")</h1>
    </header>

    @if (Model.Error is not null)
    {
        <div class="alert alert-error" role="alert">
            @(Model.Error switch
            {
                "noprofile" => T("ابتدا پروفایل مشتری بسازید.", "Create your customer profile first.", "أنشئ ملفك كعميل أولاً.", "Primero crea tu perfil de cliente."),
                "customer.not_found" or "files.not_found" => T("نشانی پیدا نشد؛ شاید قبلاً حذف شده باشد.", "Address not found; it may be removed.", "لم يتم العثور على العنوان.", "Dirección no encontrada; puede que se haya eliminado."),
                "customer.version_conflict" or "core.database.concurrency_conflict" => T("نشانی هم‌زمان تغییر کرده؛ صفحه را تازه کنید.", "Address changed concurrently; refresh the page.", "تم تغيير العنوان بالتزامن؛ حدّث الصفحة.", "La dirección cambió simultáneamente; recarga la página."),
                "customer.invalid_data" => T("اطلاعات نشانی کامل نیست.", "Address data is incomplete.", "بيانات العنوان غير كاملة.", "Los datos de la dirección están incompletos."),
                _ => T("عملیات انجام نشد؛ دوباره تلاش کنید.", "Operation failed; try again.", "فشلت العملية؛ حاول مجدداً.", "La operación falló; inténtalo de nuevo.")
            })
        </div>
    }

    @if (!Model.HasProfile)
    {
        <p class="empty">@T("برای مدیریت نشانی‌ها ابتدا از «حساب کاربری» پروفایل مشتری بسازید.", "Create your customer profile from the account hub first.", "أنشئ ملفك من مركز الحساب أولاً.", "Primero crea tu perfil de cliente desde el centro de la cuenta.")</p>
    }
    else
    {
        @if (Model.Addresses.Count == 0)
        {
            <p class="empty">@T("هنوز نشانی ثبت نکرده‌اید؛ اولین نشانی را اضافه کنید.", "No addresses yet; add your first one.", "لا عناوين بعد؛ أضف أول عنوان.", "Aún no hay direcciones; añade la primera.")</p>
        }
        else
        {
            <div class="address-grid">
                @foreach (var a in Model.Addresses)
                {
                    <div class="card address-card @(a.IsDefault ? "is-default" : null)">
                        <div class="address-head">
                            <h2>@a.Title</h2>
                            @if (a.IsDefault)
                            {
                                <span class="chip chip-default">@T("پیش‌فرض", "Default", "افتراضي", "Predeterminado")</span>
                            }
                            else
                            {
                                <span class="chip">@TypeLabel(a.TypeCode)</span>
                            }
                        </div>
                        <p class="address-line">@a.Line</p>
                        @if (!string.IsNullOrWhiteSpace(a.PostalCode))
                        {
                            <p class="muted small" dir="ltr">@a.PostalCode</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(a.RecipientName))
                        {
                            <p class="muted small">@T("گیرنده:", "Recipient:", "المستلم:", "Destinatario:") @a.RecipientName @(a.RecipientMobile is null ? "" : $" · {a.RecipientMobile}")</p>
                        }
                        <div class="address-actions">
                            @if (!a.IsDefault)
                            {
                                <form method="post" asp-page-handler="SetDefault">
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <input type="hidden" name="version" value="@a.Version" />
                                    <button type="submit" class="btn btn-ghost btn-sm">@T("پیش‌فرض کن", "Set default", "اجعله افتراضياً", "Establecer predeterminada")</button>
                                </form>
                            }
                            <details class="address-edit">
                                <summary class="btn btn-ghost btn-sm">@T("ویرایش", "Edit", "تحرير", "Editar")</summary>
                                <form method="post" asp-page-handler="Edit" class="auth-form edit-form">
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <input type="hidden" name="version" value="@a.Version" />
                                    <input type="hidden" name="addressTypeCode" value="@a.TypeCode" />
                                    <label><span>@T("عنوان", "Title", "العنوان", "Título")</span><input type="text" name="title" value="@a.Title" required /></label>
                                    <label><span>@T("نشانی", "Address line", "سطر العنوان", "Línea de dirección")</span><input type="text" name="addressLine1" value="@a.Line1" required /></label>
                                    <label><span>@T("تکمیلی", "Line 2", "سطر ٢", "Línea 2")</span><input type="text" name="addressLine2" value="@a.Line2" /></label>
                                    <label><span>@T("کد پستی", "Postal code", "الرمز البريدي", "Código postal")</span><input type="text" name="postalCode" value="@a.PostalCode" /></label>
                                    <label><span>@T("گیرنده", "Recipient", "المستلم", "Destinatario")</span><input type="text" name="recipientName" value="@a.RecipientName" /></label>
                                    <label><span>@T("موبایل گیرنده", "Recipient mobile", "هاتف المستلم", "Móvil del destinatario")</span><input type="text" name="recipientMobile" value="@a.RecipientMobile" dir="ltr" /></label>
                                    <button type="submit" class="btn btn-primary btn-sm">@T("ذخیره", "Save", "حفظ", "Guardar")</button>
                                </form>
                            </details>
                            <form method="post" asp-page-handler="Remove" data-confirm-remove="1" data-confirm-text="@($"«{a.Title}» {T("حذف شود؟", "will be removed. Continue?", "سيُحذف. متابعة؟", "¿Eliminar?")}")">
                                <input type="hidden" name="id" value="@a.Id" />
                                <input type="hidden" name="version" value="@a.Version" />
                                <button type="submit" class="btn btn-danger btn-sm">@T("حذف", "Remove", "إزالة", "Quitar")</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }

        <details class="card add-address" open="@((Model.Addresses.Count == 0).ToString().ToLower())">
            <summary><h2>@T("افزودن نشانی جدید", "Add a new address", "إضافة عنوان جديد", "Añadir una nueva dirección")</h2></summary>
            <form method="post" asp-page-handler="Add" class="address-form">
                <div class="form-cols">
                    <label><span>@T("نوع", "Type", "النوع", "Tipo")</span>
                        <select name="addressTypeCode">
                            <option value="home">@T("خانه", "Home", "المنزل", "Casa")</option>
                            <option value="work">@T("محل کار", "Work", "العمل", "Trabajo")</option>
                            <option value="other">@T("سایر", "Other", "أخرى", "Otro")</option>
                        </select>
                    </label>
                    <label><span>@T("عنوان نشانی (نام)", "Title", "عنوان العنوان", "Título")</span><input type="text" name="title" placeholder="@T("مثلاً: خانه، محل کار", "e.g. Home, Office", "مثال: المنزل", "p. ej. Casa, Oficina")" required /></label>
                    @* کشور همیشه ایران است — فیلد در فرم نیست و سمت سرور IR ثبت می‌شود *@
                    <label><span>@T("استان", "Province", "المحافظة", "Provincia")</span><input type="text" name="province" placeholder="@T("مثلاً: تهران", "e.g. Tehran", "مثال: طهران", "p. ej. Teherán")" /></label>
                    <label><span>@T("شهر / محله", "City / district", "المدينة / الحي", "Ciudad / distrito")</span><input type="text" name="district" /></label>
                    <label class="span2"><span>@T("نشانی کامل", "Address line 1", "سطر العنوان ١", "Línea de dirección 1")</span><input type="text" name="addressLine1" required /></label>
                    <label><span>@T("پلاک/تکمیلی", "Address line 2", "سطر العنوان ٢", "Línea de dirección 2")</span><input type="text" name="addressLine2" /></label>
                    <label><span>@T("کد پستی", "Postal code", "الرمز البريدي", "Código postal")</span><input type="text" name="postalCode" dir="ltr" /></label>
                    <label><span>@T("نام گیرنده", "Recipient name", "اسم المستلم", "Nombre del destinatario")</span><input type="text" name="recipientName" /></label>
                    <label><span>@T("موبایل گیرنده", "Recipient mobile", "هاتف المستلم", "Móvil del destinatario")</span><input type="text" name="recipientMobile" dir="ltr" /></label>
                    <label class="check"><input type="checkbox" name="isDefault" value="true" /> <span>@T("نشانی پیش‌فرض من باشد", "Make this my default address", "اجعله عنواني الافتراضي", "Hacer esta mi dirección predeterminada")</span></label>
                </div>
                <button type="submit" class="btn btn-primary">@T("افزودن نشانی", "Add address", "إضافة", "Añadir dirección")</button>
            </form>
        </details>
    }
</section>
<script>
    // تأیید حذف نشانی
    document.querySelectorAll("form[data-confirm-remove]").forEach(function (f) {
        f.addEventListener("submit", function (e) {
            if (!window.confirm(f.getAttribute("data-confirm-text") || "")) e.preventDefault();
        });
    });
</script>
