@page
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    ViewData["Title"] = T("خطا", "Error", "خطأ");
}
<section class="container section">
    <div class="auth-card">
        <h1>@T("خطایی رخ داد", "Something went wrong", "حدث خطأ")</h1>
        <p class="muted">@T("لطفاً دوباره تلاش کنید یا به صفحه اصلی برگردید.", "Please try again or return to the home page.", "حاول مجدداً أو عد إلى الصفحة الرئيسية.")</p>
        <a class="btn btn-primary" href="/">برنگ</a>
    </div>
</section>
