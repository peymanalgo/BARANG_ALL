@page "/blog"
@model BARANG.B2C.Web.Pages.BlogModel
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    ViewData["Title"] = T("وبلاگ", "Blog", "المدونة");
}
<section class="container section">
    <header class="catalog-head">
        <h1>@T("وبلاگ پی‌رنگ", "Peyrang blog", "مدونة بي‌رنگ")</h1>
        <p class="muted">@(Model.Total > 0 ? string.Format(T("{0} مطلب", "{0} posts", "{0} تدوينات"), Model.Total.ToString("N0")) : T("به‌زودی مطالب تازه 🌱", "Fresh posts coming soon 🌱", "تدوينات جديدة قريبًا 🌱"))</p>
    </header>
    @if (Model.Posts.Count == 0)
    {
        <p class="empty">@T("هنوز مطلبی منتشر نشده است.", "No posts published yet.", "لم تُنشر أي تدوينات بعد.")</p>
    }
    else
    {
        <div class="design-grid blog-grid">
            @foreach (var p in Model.Posts)
            {
                <a class="design-card blog-card" href="/blog/@p.Slug">
                    <span class="design-thumb blog-thumb">
                        @if (!string.IsNullOrWhiteSpace(p.Thumbnail))
                        {
                            <img src="@p.Thumbnail" alt="@p.Title" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <span class="blog-thumb-empty" aria-hidden="true">✍️</span>
                        }
                    </span>
                    <span class="design-meta">
                        <strong>@p.Title</strong>
                        <span class="muted" style="font-size:.8rem">@p.Excerpt</span>
                        <span class="muted" style="font-size:.75rem">@p.Date</span>
                    </span>
                </a>
            }
        </div>
        @if (Model.HasNext)
        {
            <nav class="pagination"><a class="btn btn-ghost btn-sm" href="/blog?page=@(Model.Page + 1)">@T("مطالب قدیمی‌تر", "Older posts", "تدوينات أقدم") →</a></nav>
        }
    }
</section>
