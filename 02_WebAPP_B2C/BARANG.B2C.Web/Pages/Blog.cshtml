@page "/blog"
@model BARANG.B2C.Web.Pages.BlogModel
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar, string? es = null) => culture switch { "en" => en, "ar" => ar, "es" => es ?? en, _ => fa };
    ViewData["Title"] = T("وبلاگ", "Blog", "المدونة", "Blog");
}
<section class="container section">
    <header class="catalog-head">
        <h1>@T("وبلاگ پی‌رنگ", "Peyrang blog", "مدونة بي‌رنگ", "Blog de Peyrang")</h1>
        <p class="muted">@(Model.Total > 0 ? string.Format(T("{0} مطلب", "{0} posts", "{0} تدوينات", "{0} publicaciones"), Model.Total.ToString("N0")) : T("به‌زودی مطالب تازه 🌱", "Fresh posts coming soon 🌱", "تدوينات جديدة قريبًا 🌱", "Nuevas publicaciones pronto 🌱"))</p>
    </header>
    @if (Model.Posts.Count == 0)
    {
        <p class="empty">@T("هنوز مطلبی منتشر نشده است.", "No posts published yet.", "لم تُنشر أي تدوينات بعد.", "Aún no hay publicaciones.")</p>
    }
    else
    {
        <div class="design-grid blog-grid">
            @foreach (var p in Model.Posts)
            {
                <a class="design-card blog-card" href="/blog/@p.Slug">
                    <span class="design-thumb blog-thumb">
                        @if (!string.IsNullOrWhiteSpace(p.Thumbnail))
                        {
                            <img src="@p.Thumbnail" alt="@p.Title" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <span class="blog-thumb-empty" aria-hidden="true">✍️</span>
                        }
                    </span>
                    <span class="design-meta">
                        <strong>@p.Title</strong>
                        <span class="muted blog-excerpt">@p.Excerpt</span>
                        <span class="blog-meta-row">
                            @if (!string.IsNullOrWhiteSpace(p.Date))
                            {
                                <span class="blog-meta-item"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M8 3v4M16 3v4M3 10h18"/></svg> @p.Date</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.Author))
                            {
                                <span class="blog-meta-item"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-3.6 4.5-5.5 8-5.5s6.5 1.9 8 5.5"/></svg> @p.Author</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.Category))
                            {
                                <span class="chip">@p.Category</span>
                            }
                        </span>
                    </span>
                </a>
            }
        </div>
        @if (Model.HasNext)
        {
            <nav class="pagination"><a class="btn btn-ghost btn-sm" href="/blog?page=@(Model.Page + 1)">@T("مطالب قدیمی‌تر", "Older posts", "تدوينات أقدم", "Publicaciones anteriores") →</a></nav>
        }
    }
</section>
