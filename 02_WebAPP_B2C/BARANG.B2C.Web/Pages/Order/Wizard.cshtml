<link rel="stylesheet" href="~/css/wizard.css" asp-append-version="true" />
<form method="post" id="wz-af" hidden aria-hidden="true"></form>
<section class="wizard-embed" id="wz" data-culture="@culture" data-auth="@(Model.IsAuthenticated ? "1" : "0")" data-entry-design="@(Model.EntryDesignId?.ToString() ?? "")">
<div class="wrap">
  <header class="shell">
    <div class="brand">👑 @T("پی‌رنگ خان", "Peyrang Khan", "پی‌رنگ خان") <small>@i18n["brandNote"]</small></div>
    <ol class="steps" id="w-steps"></ol>
  </header>

  <section class="phase" id="w-p1" hidden>
    <div id="w-entrynote" class="entrynote" hidden>@i18n["entryBanner"]</div>
    <div class="grid1">
      <aside class="tools">
        <div>
          <div class="lbl">@i18n["designSource"] — @i18n["sourceRule"]</div>
          <div class="modes">
            <button type="button" class="mode" data-mode="bank"><span class="ic">🗂️</span><b>@i18n["tabBank"]</b><small id="w-bankcount">@i18n["tabBankHint"]</small></button>
            <button type="button" class="mode" data-mode="upload"><span class="ic">🖼️</span><b>@i18n["tabUpload"]</b><small>@i18n["tabUploadHint"]</small></button>
            <button type="button" class="mode" data-mode="text"><span class="ic">✍️</span><b>@i18n["tabText"]</b><small>@i18n["tabTextHint"]</small></button>
          </div>
        </div>

        <div class="pan" id="w-pan-bank" hidden>
          <div class="ai"><span class="dotp" id="w-pulse" hidden></span> @i18n["tabBankHint"]</div>
          <div class="search"><input id="w-q" type="text" dir="auto" placeholder="@i18n["searchPlaceholder"]" aria-label="@i18n["tabBankHint"]"></div>
          <div class="chips" id="w-chips"></div>
          <p class="status" id="w-status" aria-live="polite">@i18n["searchReady"]</p>
          <div class="gridcards" id="w-grid"></div>
        </div>

        <div class="pan" id="w-pan-upload" hidden>
          <div class="drop" id="w-drop">
            <span class="ic">☁️</span>
            <b>@i18n["dropTitle"]</b>
            <small>@i18n["dropHint"]</small>
            <label class="btn btn-ghost btn-sm">@i18n["pickFile"]<input id="w-file" type="file" accept="image/*" hidden></label>
          </div>
          <div class="check" id="w-check" hidden>
            <div class="row"><span style="font-size:20px">🔎</span><div><b>@i18n["analysis"]</b><span class="msg" id="w-checkmsg">—</span></div></div>
            <div class="meter"><span id="w-meter"></span></div>
            <ul class="hints">
              <li>@i18n["bgRemove"] <span class="ok">@i18n["ready"]</span></li>
              <li>@i18n["optimize"] <span class="ok">@i18n["active"]</span></li>
              <li>@i18n["bestSize"]: <b id="w-best">A3</b></li>
            </ul>
          </div>
        </div>

        <div class="pan" id="w-pan-text" hidden>
          <div class="lbl" for="w-textin">@i18n["textLabel"] <span dir="ltr">RTL ← fa/ar · LTR ← EN</span></div>
          <textarea class="tin" id="w-textin" rows="2" dir="auto" placeholder="@i18n["textPlaceholder"]"></textarea>
          <div class="lbl">@i18n["font"]</div>
          <div class="fonts">
            <button type="button" class="fbtn" data-f="1" style="font-weight:900">@i18n["font1"]</button>
            <button type="button" class="fbtn" data-f="2" style="font-weight:500;letter-spacing:.06em">@i18n["font2"]</button>
            <button type="button" class="fbtn" data-f="3" style="font-style:italic;font-weight:700">@i18n["font3"]</button>
            <button type="button" class="fbtn" data-f="4" style="font-weight:800;letter-spacing:.2em">@i18n["font4"]</button>
          </div>
          <div class="lbl">@i18n["textColor"]</div>
          <div class="dots" id="w-tdots"></div>
          <div class="lbl">@i18n["textSize"] <output id="w-tsout">@BARANG.B2C.Web.Services.AppDate.Digits("100", culture)</output></div>
          <input class="rng" id="w-tsz" type="range" min="55" max="150" value="100">
        </div>
      </aside>

      <main style="display:flex;flex-direction:column;gap:14px;min-width:0">
        <div class="stagebox">
          <div class="stagewrap">
            <div class="seg" id="w-side">
              <button type="button" class="on" data-side="FRONT">@i18n["front"]</button>
              <button type="button" data-side="BACK">@i18n["back"]</button>
            </div>
            <div class="seg" id="w-code"></div>
            <button type="button" class="btn btn-ghost btn-sm" id="w-center">🎯 @i18n["autoCenter"]</button>
          </div>
          <div class="scene">
            <div class="garm" id="w-garm">
              <div class="face" id="w-ff"></div>
              <div class="face bk" id="w-fb"></div>
            </div>
          </div>
        </div>

        <div>
          <h3 class="sec">@i18n["productType"]</h3>
          <div class="products" id="w-products"><div class="sk" style="aspect-ratio:auto;height:90px"></div></div>
        </div>
        <div>
          <h3 class="sec">@i18n["shirtSize"]</h3>
          <div class="seg" id="w-ssize" style="flex-wrap:wrap"></div>
        </div>

        <div class="sumbar">
          <div class="sumchips" id="w-sumchips" aria-live="polite"></div>
          <div class="liveprice">@i18n["orderTotal"]: <b id="w-price">—</b> @i18n["toman"]</div>
          <button type="button" class="btn btn-main" id="w-next1" disabled>@i18n["next1"]</button>
        </div>
      </main>
    </div>
  </section>

  <section class="phase" id="w-p2" hidden>
    <h2 class="ph">@i18n["p2Title"]</h2>
    <p class="phd">@i18n["p2Desc"]</p>
    <p class="phd">🚚 @i18n["shipTime"]: <b style="color:#ffd98a">@i18n["shipTimeValue"]</b></p>

    <div>
      <h3 class="sec">@i18n["packaging"]</h3>
      <div class="cards3" id="w-pack"></div>
    </div>

    <div>
      <h3 class="sec">@i18n["address"]</h3>
      <div class="addrlist" id="w-addrs"></div>
      <div style="margin-top:10px" id="w-newaddr" hidden>
        <span class="lbl">@i18n["newAddress"]</span>
        <div class="frow1">
          <input class="fin" type="text" dir="auto" placeholder="@i18n["fullAddress"]" aria-label="@i18n["fullAddress"]" id="w-na-line">
          <input class="fin" type="text" dir="auto" placeholder="@i18n["city"]" aria-label="@i18n["city"]" id="w-na-city">
          <input class="fin" type="text" dir="auto" placeholder="@i18n["postalCode"]" aria-label="@i18n["postalCode"]" inputmode="numeric" id="w-na-postal">
        </div>
      </div>
      <label class="sw" style="margin-top:12px"><input type="checkbox" id="w-gift"> 🎁 @i18n["gift"]</label>
      <div class="giftbox" id="w-giftbox" hidden>
        <span class="lbl" style="margin:0">@i18n["giftDetails"]</span>
        <div class="frow">
          <input class="fin" type="text" dir="auto" placeholder="@i18n["giftName"]" aria-label="@i18n["giftName"]" id="w-g-name">
          <input class="fin" type="text" dir="ltr" placeholder="@i18n["giftPhone"]" aria-label="@i18n["giftPhone"]" inputmode="tel" id="w-g-phone">
        </div>
        <input class="fin" type="text" dir="auto" placeholder="@i18n["giftAddress"]" aria-label="@i18n["giftAddress"]" id="w-g-addr">
        <input class="fin" type="text" dir="auto" placeholder="@i18n["giftMessage"]" aria-label="@i18n["giftMessage"]" id="w-g-msg">
      </div>
    </div>

    <div class="navrow">
      <button type="button" class="btn btn-ghost" id="w-back2">@i18n["back2"]</button>
      <button type="button" class="btn btn-main" id="w-next2">@i18n["next2"]</button>
    </div>
  </section>

  <section class="phase" id="w-p3" hidden>
    <h2 class="ph">@i18n["p3Title"]</h2>
    <p class="phd">@i18n["p3Desc"]</p>
    <div class="rev">
      <div class="revcard">
        <div class="revtee" id="w-revtee"></div>
        <div id="w-revlist"></div>
      </div>
      <div class="pricebox">
        <h3 class="sec" style="margin-top:0">@i18n["priceBreakdown"]</h3>
        <div id="w-pricelines"></div>
        <div class="ptotal"><span>@i18n["payable"]</span><b id="w-total">—</b></div>
        <p class="pnote">⚙️ @i18n["serverPriceNote"]</p>
        <div class="navrow" style="margin-top:16px">
          <button type="button" class="btn btn-ghost" id="w-back3">@i18n["back3"]</button>
          <button type="button" class="btn btn-main" id="w-confirm">@i18n["confirm"]</button>
        </div>
      </div>
    </div>
  </section>

  <section class="phase" id="w-p4" hidden>
    <div id="w-payarea">
      <h2 class="ph">@i18n["p4Title"]</h2>
      <p class="phd">@i18n["p4Desc"]</p>
      <div class="totalhero"><div class="n" id="w-paytotal">—</div><small>@i18n["toman"] — @i18n["payable"]</small></div>
      <div class="paygrid" style="margin-top:14px">
        <div class="paycard" id="w-paygw" role="button" tabindex="0">
          <span class="ic">🏦</span>
          <b>@i18n["payGateway"]</b>
          <small>@i18n["payGatewayDesc"]</small>
        </div>
        <div class="paycard" id="w-paywallet" role="button" tabindex="0">
          <span class="ic">👛</span>
          <b>@i18n["payWallet"]</b>
          <small>@i18n["payWalletDesc"]</small>
          <div class="bal" id="w-walletbal">—</div>
        </div>
      </div>
      <div class="navrow" style="margin-top:16px">
        <button type="button" class="btn btn-ghost" id="w-back4">@i18n["back4"]</button>
      </div>
    </div>
    <div id="w-success" class="success" hidden>
      <div class="big">✓</div>
      <h2>@i18n["successTitle"]</h2>
      <div class="ord" id="w-ordno"></div>
      <p id="w-successinfo">—</p>
      <button type="button" class="btn btn-ghost" id="w-track">📍 @i18n["track"]</button>
      <button type="button" class="btn btn-main" id="w-again">@i18n["again"]</button>
    </div>
  </section>
</div>
</section>

<div class="overlay" id="w-gw" hidden>
  <div class="gw">
    <div class="bank ltr" style="text-align:center">ZARINPAL-DEMO GATEWAY · @i18n["gwDemo"]</div>
    <div class="amt" id="w-gwamt">—</div>
    <small>@i18n["gwPayOrder"]</small>
    <div class="gwcard ltr">
      <div class="row"><span>Card</span><b>6104 **** **** 3394</b></div>
      <div class="row"><span>Holder</span><b>PEYRANG KHAN</b></div>
      <div class="row"><span>OTP</span><b>••••</b></div>
    </div>
    <button type="button" class="btn btn-main btn-lg" id="w-gwpay">@i18n["gwPay"] ✓</button>
    <div><button type="button" class="btn btn-ghost btn-sm" id="w-gwcancel" style="margin-top:10px">@i18n["gwCancel"]</button></div>
  </div>
</div>

<script id="wz-i18n" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(i18n))</script>
<script id="wz-bootstrap" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { auth = Model.IsAuthenticated, entryDesign = Model.EntryDesignId?.ToString() ?? "" }))</script>
<script src="~/js/wizard.js" asp-append-version="true" defer></script>
