@page "/order/new/{designId:guid?}"
@model NewModel
@using System.Globalization
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    ViewData["Title"] = T("سفارش طرح", "Order design", "طلب التصميم");
}
<partial name="_WizardSteps" model="1" />
<section class="container section wizard">
    @if (!Model.DesignFound)
    {
        <p class="empty">@T("طرح پیدا نشد.", "Design not found.", "لم يتم العثور على التصميم.")</p>
    }
    else
    {
        <div class="wizard-design-strip">
            @if (!string.IsNullOrWhiteSpace(Model.DesignPreview))
            {
                <img src="@Model.DesignPreview" alt="@Model.DesignTitle" />
            }
            <div>
                <strong>@Model.DesignTitle</strong>
                <span class="muted small" dir="ltr">@Model.DesignCode</span>
            </div>
        </div>

        @if (Model.Error is not null)
        {
            <div class="alert alert-error" role="alert">
                @(Model.Error switch
                {
                    "variant" => T("واریانت و تعداد را انتخاب کنید.", "Pick a variant and quantity.", "اختر المتغير والكمية."),
                    "branch" => T("شعبه در دسترس نیست؛ بعداً تلاش کنید.", "No branch available; try later.", "لا يوجد فرع متاح."),
                    "customer.not_found" => T("پروفایل مشتری یافت نشد.", "Customer profile not found.", "لم يتم العثور على ملف العميل."),
                    "order.duplicate_external_reference" => T("درخواست تکراری؛ چند لحظه بعد دوباره تلاش کنید.", "Duplicate request; retry shortly.", "طلب مكرر؛ حاول لاحقاً."),
                    _ => T("ایجاد سفارش انجام نشد؛ دوباره تلاش کنید.", "Could not create the order; try again.", "فشل إنشاء الطلب؛ حاول مجدداً.")
                })
                <span class="muted small" dir="ltr"> @Model.Error</span>
            </div>
        }

        @if (!Model.HasProfile)
        {
            <p class="empty">@T("برای سفارش ابتدا پروفایل مشتری بسازید.", "Create your customer profile first.", "أنشئ ملفك كعميل أولاً.")</p>
        }
        else
        {
            <form method="get" class="wizard-form">
                <input type="hidden" name="designId" value="@Model.DesignId" />
                <input type="hidden" name="search" value="@(Model.Search ?? "")" />
                <div class="card wizard-card">
                    <h2>۱. @T("انتخاب محصول", "Choose a product", "اختر المنتج")</h2>
                    @if (Model.Products.Count == 0)
                    {
                        <p class="muted">@T("محصولی یافت نشد.", "No products found.", "لا توجد منتجات.")</p>
                    }
                    else
                    {
                        <div class="pick-list">
                            @foreach (var p in Model.Products)
                            {
                                <label class="pick-item @(Model.ProductId == p.Id ? "picked" : null)">
                                    <input type="radio" name="productId" value="@p.Id" checked="@(Model.ProductId == p.Id)" />
                                    <span class="pick-body"><strong>@p.Name</strong><small dir="ltr">@p.Code</small></span>
                                </label>
                            }
                        </div>
                        <button type="submit" class="btn btn-ghost btn-sm">
                            @T("نمایش واریانت‌ها", "Show variants", "اعرض المتغيرات")
                        </button>
                    }
                </div>
            </form>

            @if (Model.ProductId is not null && Model.Variants.Count == 0)
            {
                <p class="empty">@T("برای این محصول واریانت قابل سفارشی یافت نشد.", "No orderable variant for this product.", "لا يوجد متغير قابل للطلب لهذا المنتج.")</p>
            }

            @if (Model.Variants.Count > 0)
            {
                <form method="post" asp-page-handler="Create" class="wizard-form">
                    <input type="hidden" name="designId" value="@Model.DesignId" />
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <div class="wizard-cols">
                        <div class="card wizard-card">
                            <h3>۲. @T("واریانت و تعداد", "Variant and quantity", "المتغير والكمية")</h3>
                            <div class="pick-list">
                                @foreach (var v in Model.Variants)
                                {
                                    <label class="pick-item @(Model.VariantId == v.Id ? "picked" : null)">
                                        <input type="radio" name="VariantId" value="@v.Id" checked="@(Model.VariantId == v.Id)" />
                                        <span class="pick-body"><span dir="ltr">@v.Label</span></span>
                                    </label>
                                }
                            </div>
                            <label class="qty-row"><span>@T("تعداد", "Quantity", "الكمية")</span>
                                <input type="number" name="Quantity" value="@(Model.Quantity == 0 ? 1 : Model.Quantity)" min="1" step="1" />
                            </label>
                            <label class="mt notes-label"><span>@T("توضیحات سفارش (اختیاری)", "Order notes (optional)", "ملاحظات الطلب")</span>
                                <input type="text" name="Notes" />
                            </label>
                        </div>

                        <div class="card wizard-card">
                            <h3>۳. @T("ارسال به", "Shipping", "الشحن")</h3>
                            @if (Model.Addresses.Count == 0)
                            {
                                <p class="muted">@T("نشانی ذخیره‌شده ندارید.", "No saved address.", "لا عناوين محفوظة.")</p>
                                <a class="btn btn-ghost btn-sm" href="/account/addresses">@T("افزودن نشانی", "Add address", "إضافة عنوان")</a>
                            }
                            else
                            {
                                <div class="pick-list">
                                    @foreach (var a in Model.Addresses)
                                    {
                                        <label class="pick-item @(Model.AddressId == a.Id || (Model.AddressId is null && a.IsDefault) ? "picked" : null)">
                                            <input type="radio" name="AddressId" value="@a.Id" checked="@(Model.AddressId == a.Id || (Model.AddressId is null && a.IsDefault))" />
                                            <span class="pick-body"><strong>@a.Title</strong><small>@a.Line</small></span>
                                        </label>
                                    }
                                </div>
                            }

                            <h3 class="mt">@T("شعبه اجرای سفارش", "Fulfilling branch", "فرع التنفيذ")</h3>
                            @if (Model.Branches.Count <= 1)
                            {
                                <p class="muted">@(Model.Branches.Count == 1 ? Model.Branches[0].Name : "—")</p>
                                <input type="hidden" name="BranchId" value="@(Model.Branches.Count == 1 ? Model.Branches[0].Id : "")" />
                            }
                            else
                            {
                                <select name="BranchId" required>
                                    @foreach (var b in Model.Branches)
                                    {
                                        <option value="@b.Id">@b.Name</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>

                    <div class="wizard-footer">
                        <a class="btn btn-ghost" href="/design/@Model.DesignId">→ @T("بازگشت به طرح", "Back to design", "العودة للتصميم")</a>
                        <button type="submit" class="btn btn-primary btn-lg">@T("ادامه: جزئیات چاپ و ثبت", "Continue: print details", "متابعة: تفاصيل الطباعة")</button>
                    </div>
                </form>
            }
        }
    }
</section>
