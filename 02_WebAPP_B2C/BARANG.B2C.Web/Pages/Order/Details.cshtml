@page "/order/details/{orderId:guid}"
@model DetailsModel
@using System.Globalization
@using System.Text.Json
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    string PositionLabel(string p) => p switch
    {
        "FRONT" => T("جلو", "Front", "الأمام"),
        "BACK" => T("پشت", "Back", "الخلف"),
        "SLEEVE" => T("آستین", "Sleeve", "الكم"),
        "OTHER" => T("سایر", "Other", "أخرى"),
        _ => p
    };
    string IssueLabel(string code) => code switch
    {
        "order.item_required" => T("سفارش باید حداقل یک آیتم داشته باشد.", "The order needs at least one item.", "يحتاج الطلب إلى بند واحد على الأقل."),
        "order.invalid_customer" => T("مشتری سفارش معتبر نیست.", "The order customer is invalid.", "عميل الطلب غير صالح."),
        "order.invalid_product" => T("یکی از آیتم‌ها معتبر نیست.", "One of the items is invalid.", "أحد البنود غير صالح."),
        "order.not_draft" => T("سفارش دیگر در حالت پیش‌نویس نیست.", "The order is no longer a draft.", "لم يعد الطلب مسودة."),
        _ => code
    };
    (string Label, string Value)? TotalRow = null;
    List<(string Label, string Value)> QuoteRows = new();
    if (Model.Quote is JsonElement q && q.ValueKind == JsonValueKind.Object)
    {
        foreach (var prop in q.EnumerateObject())
        {
            string text = prop.Value.ValueKind switch
            {
                JsonValueKind.Number => prop.Value.GetRawText(),
                JsonValueKind.String => prop.Value.GetString() ?? "",
                _ => ""
            };
            if (text.Length == 0) continue;
            string ql = prop.Name switch
            {
                "rawProductTotal" => T("محصول خام", "Raw product", "المنتج الخام"),
                "printTotal" => T("چاپ", "Printing", "الطباعة"),
                "packagingTotal" => T("بسته‌بندی", "Packaging", "التغليف"),
                "shippingTotal" => T("ارسال", "Shipping", "الشحن"),
                "additionalServiceTotal" => T("خدمات افزوده", "Additional services", "خدمات إضافية"),
                "subtotal" => T("جمع کل", "Subtotal", "المجموع"),
                "discountTotal" => T("تخفیف", "Discount", "الخصم"),
                "taxableTotal" => T("مشمول مالیات", "Taxable", "خاضع للضريبة"),
                "taxTotal" => T("مالیات", "Tax", "الضريبة"),
                _ => prop.Name
            };
            if (prop.Name.Equals("total", StringComparison.OrdinalIgnoreCase) || prop.Name.Equals("totalAmount", StringComparison.OrdinalIgnoreCase) || prop.Name.Equals("grandTotal", StringComparison.OrdinalIgnoreCase))
            {
                TotalRow = (T("مبلغ کل", "Total", "الإجمالي"), text);
            }
            else if (prop.Value.ValueKind == JsonValueKind.Number)
            {
                QuoteRows.Add((ql, text));
            }
        }
    }
    ViewData["Title"] = T("جزئیات سفارش", "Order details", "تفاصيل الطلب");
}
<partial name="_WizardSteps" model="2" />
<section class="container section wizard">
    <nav class="breadcrumbs" aria-label="breadcrumb">
        <a href="/account/orders">@T("سفارش‌های من", "My orders", "طلباتي")</a> ›
        <span dir="ltr">@(Model.OrderNumber ?? "—")</span>
    </nav>

    @if (Model.Error is not null)
    {
        <div class="alert alert-error" role="alert">
            @(Model.Error switch
            {
                "upload-failed" or "file.invalid" => T("آپلود فایل انجام نشد؛ حجم/نوع فایل را بررسی کنید.", "File upload failed; check size/type.", "فشل رفع الملف؛ تحقق من الحجم والنوع."),
                "api.idempotency_key.required" => T("درخواست تکراری؛ دوباره تلاش کنید.", "Duplicate request; try again.", "طلب مكرر؛ حاول مجدداً."),
                "order.concurrency_conflict" or "core.database.concurrency_conflict" => T("سفارش هم‌زمان تغییر کرده؛ صفحه را تازه کنید.", "Order changed concurrently; refresh.", "تم تغيير الطلب بالتزامن؛ حدّث الصفحة."),
                "order.not_draft" => T("سفارش دیگر قابل ویرایش نیست.", "The order is no longer editable.", "لم يعد الطلب قابلاً للتحرير."),
                "order.item_required" => T("آیتم سفارش یافت نشد.", "Order item not found.", "لم يتم العثور على بند الطلب."),
                "pricing.tariff.missing" => T("برای این محصول هنوز تعرفه قیمت‌گذاری ثبت نشده است؛ با پشتیبانی هماهنگ کنید.", "No pricing tariff exists for this product yet; contact support.", "لا توجد تعريفة تسعير لهذا المنتج بعد."),
                "submit-failed" or "order.incomplete" => T("ثبت نهایی انجام نشد؛ موارد اعتبارسنجی را برطرف کنید.", "Submit failed; resolve the validation issues.", "فشل الإرسال؛ عالج ملاحظات التحقق."),
                _ => T("عملیات انجام نشد؛ دوباره تلاش کنید.", "Operation failed; try again.", "فشلت العملية؛ حاول مجدداً.")
            })
            <span class="muted small" dir="ltr"> @Model.Error</span>
        </div>
    }
    @if (Model.Message == "saved")
    {
        <div class="alert alert-ok" role="status">@T("جزئیات چاپ ذخیره شد.", "Print details saved.", "تم حفظ تفاصيل الطباعة.")</div>
    }

    <form method="post" asp-page-handler="SavePrint" enctype="multipart/form-data" class="wizard-form">
        <div class="wizard-cols">
            <div class="card wizard-card">
                <h2>۲. @T("عملیات چاپ", "Print operation", "عملية الطباعة")</h2>
                <div class="form-cols">
                    <label><span>@T("محل چاپ", "Placement", "موضع الطباعة")</span>
                        <select name="PrintPosition">
                            @foreach (var p in Model.PrintPositions)
                            {
                                <option value="@p" selected="@(p == Model.PrintPosition)">@PositionLabel(p)</option>
                            }
                        </select>
                    </label>
                    <label><span>@T("روش چاپ (اختیاری)", "Print method (optional)", "طريقة الطباعة")</span>
                        <input type="text" name="PrintMethod" dir="ltr" placeholder="DTF / Silkscreen…" />
                    </label>
                    <label><span>@T("عرض چاپ (cm)", "Print width (cm)", "عرض الطباعة")</span>
                        <input type="number" name="Width" min="0.1" step="0.1" />
                    </label>
                    <label><span>@T("ارتفاع چاپ (cm)", "Print height (cm)", "ارتفاع الطباعة")</span>
                        <input type="number" name="Height" min="0.1" step="0.1" />
                    </label>
                    <label class="span2"><span>@T("فایل اختصاصی شما (اختیاری)", "Your custom file (optional)", "ملفك الخاص (اختياري)")</span>
                        <input type="file" name="CustomFile" />
                    </label>
                    <label class="span2"><span>@T("توضیحات چاپ", "Print notes", "ملاحظات الطباعة")</span>
                        <input type="text" name="PrintNotes" />
                    </label>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.DesignCode))
                {
                    <p class="muted small">@T("طرح انتخاب‌شده:", "Selected design:", "التصميم المختار:") <span dir="ltr">@Model.DesignCode</span> — @T("در یادداشت چاپ ثبت می‌شود.", "recorded on the print notes.", "يُسجل في ملاحظات الطباعة.")</p>
                }
                <button type="submit" class="btn btn-ghost">@T("ذخیره عملیات چاپ", "Save print operation", "حفظ عملية الطباعة")</button>
            </div>

            <div class="card wizard-card price-panel">
                <h2>@T("قیمت سفارش", "Order price", "سعر الطلب")</h2>
                @if (Model.Quote is null)
                {
                    <p class="muted">@T("قیمت محاسبه نشد؛ پس از ذخیره جزئیات دوباره بررسی کنید.", "Price not computed; recheck after saving details.", "لم يُحسب السعر؛ تحقق بعد الحفظ.")</p>
                }
                else
                {
                    <ul class="quote-list">
                        @foreach (var (label, value) in QuoteRows)
                        {
                            <li><span>@label</span><strong dir="ltr">@value</strong></li>
                        }
                    </ul>
                    @if (TotalRow is var (tLabel, tValue))
                    {
                        <div class="quote-total"><span>@tLabel</span><strong dir="ltr">@tValue</strong></div>
                    }
                }
                @if (Model.Issues.Count > 0)
                {
                    <div class="alert alert-error" role="alert">
                        <strong>@T("قبل از ثبت نهایی:", "Before submitting:", "قبل من الإرسال:")</strong>
                        <ul class="issue-list">
                            @foreach (var issue in Model.Issues)
                            {
                                <li>@IssueLabel(issue.Code)</li>
                            }
                        </ul>
                    </div>
                }
                else
                {
                    <div class="alert alert-ok" role="status">@T("سفارش آماده ثبت نهایی است.", "The order is ready to submit.", "الطلب جاهز للإرسال.")</div>
                }
                <button type="submit" class="btn btn-primary btn-lg btn-block" asp-page-handler="Submit" disabled="@(Model.Issues.Count > 0)">
                    ✓ @T("ثبت نهایی سفارش", "Submit order", "إرسال الطلب")
                </button>
                <p class="muted small">@T("پس از ثبت، سفارش برای تأیید و ورود به تولید ارسال می‌شود و از «سفارش‌های من» قابل رهگیری است.", "After submission the order enters production approval and can be tracked from My orders.", "بعد الإرسال يدخل الطلب اعتماد الإنتاج ويمكن تتبعه من طلباتي.")</p>
            </div>
        </div>
    </form>
</section>
