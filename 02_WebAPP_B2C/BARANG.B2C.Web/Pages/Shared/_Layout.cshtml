@{
    Context.Response.Headers.CacheControl = "no-cache, no-store";
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    var dir = culture == "en" ? "ltr" : "rtl";
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    var route = (Context.Request.Path.Value ?? "/").Trim('/');
    string CultureLink(string c)
    {
        var target = "/" + route + (Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : string.Empty);
        return "/language/set?culture=" + c + "&returnUrl=" + Uri.EscapeDataString(target);
    }
    var q = Context.Request.Query["search"].ToString();
    string Brand() => culture switch { "en" => "Pirang Khan", "ar" => "بيرنگ خان", _ => "پیرنگ خان" };

}
<!DOCTYPE html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? $"{t} · {Brand()}" : $"{Brand()} — {T("فروشگاه طرح‌های چاپی", "Print-ready designs store", "متجر التصاميم الجاهزة للطباعة")}")</title>
    <meta name="description" content="@(ViewData["Description"] ?? $"{Brand()} — {T("سفارش آنلاین چاپ طرح‌های مورد علاقه‌ات روی تیشرت", "Order your favourite designs printed on t-shirts online", "اطبع تصاميمك المفضلة على التيشرت عبر الإنترنت")}")" />
    <meta name="theme-color" content="#111114" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:site_name" content="@Brand()" />
    <meta property="og:title" content="@(ViewData["Title"] is string ot && ot.Length > 0 ? ot : $"{Brand()} — {T("فروشگاه طرح‌های چاپی", "Print-ready designs store", "متجر التصاميم الجاهزة للطباعة")}")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "سفارش آنلاین چاپ طرح‌های مورد علاقه‌ات روی تیشرت")" />
    @if (ViewData["OgImage"] is string ogImage && ogImage.Length > 0)
    {
        <meta property="og:image" content="@ogImage" />
    }
    <link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />
</head>
<body>
<header class="store-header">
    <div class="container header-inner">
        <a class="brand" href="/">
            <span class="brand-crown" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M3 8l4.5 4L12 5l4.5 7L21 8l-1.6 10.2a1.5 1.5 0 0 1-1.48 1.3H6.08a1.5 1.5 0 0 1-1.48-1.3L3 8z"/></svg>
            </span>
            <span class="brand-name">@Brand()</span>
        </a>
        <nav class="main-nav" aria-label="@T("منوی اصلی", "Main menu", "القائمة الرئيسية")">
            <a href="/" class="@(route.Length == 0 ? "active" : null)">@T("صفحه اصلی", "Home", "الرئيسية")</a>
            <a href="/catalog" class="@(route.StartsWith("catalog") ? "active" : null)">@T("طرح‌ها", "Designs", "التصاميم")</a>
            <a href="/catalog">@T("تیشرت‌ها", "T-shirts", "التيشرتات")</a>
            <a href="/account/orders">@T("سفارش‌های من", "My orders", "طلباتي")</a>
            <a href="/#features">@T("چاپ و بسته‌بندی", "Printing", "الطباعة")</a>
            <a href="/#about">@T("درباره ما", "About", "من نحن")</a>
            <a href="/#contact">@T("تماس با ما", "Contact", "اتصل بنا")</a>
        </nav>
        <form class="header-search" action="/catalog" method="get" role="search">
            <input type="search" name="search" value="@q" placeholder="@T("جستجوی طرح میان هزاران طرح متنوع برای شما...", "Search among thousands of designs...", "ابحث بين آلاف التصاميم...")" aria-label="@T("جستجو", "Search", "بحث")" />
            <label class="mode-toggle compact" title="@T("جستجوی مفهومی: پیدا کردن طرح‌ها بر اساس معنا و مفهوم", "Concept search: find designs by meaning", "بحث مفاهيمي: إيجاد التصاميم حسب المعنى")">
                <input type="checkbox" name="mode" value="concept" @(string.Equals(Context.Request.Query["mode"].ToString(), "concept", StringComparison.OrdinalIgnoreCase) ? "checked" : null) aria-label="@T("جستجوی مفهومی", "Concept search", "بحث مفاهيمي")" />
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.8H20l-4.9 3.6 1.9 5.8-5-3.6-5 3.6 1.9-5.8L4 8.8h6.1z"/></svg>
            </label>
            <button type="submit" aria-label="@T("جستجو", "Search", "بحث")">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </button>
        </form>
        <nav class="header-actions" aria-label="@T("حساب کاربری", "Account", "الحساب")">
            <details class="lang-menu">
                <summary aria-label="@T("زبان", "Language", "اللغة")">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.9 5.7 3.9 9S14.5 18.4 12 21M12 3C9.5 5.6 8.1 8.7 8.1 12s1.4 6.4 3.9 9"/></svg>
                </summary>
                <div class="lang-pop">
                    <a href="@CultureLink("fa")" hreflang="fa">فارسی</a>
                    <a href="@CultureLink("en")" hreflang="en">English</a>
                    <a href="@CultureLink("ar")" hreflang="ar">العربية</a>
                </div>
            </details>
            <a class="icon-btn" href="/account/orders" aria-label="@T("سفارش‌های من", "My orders", "طلباتي")">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 7h12l1.2 12.2a1.5 1.5 0 0 1-1.5 1.8H6.3a1.5 1.5 0 0 1-1.5-1.8L6 7z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>
            </a>
            <a class="icon-btn" href="/account" aria-label="@T("حساب کاربری", "Account", "الحساب")">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-3.6 4.5-5.5 8-5.5s6.5 1.9 8 5.5"/></svg>
            </a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-primary btn-sm" href="/account/login">@T("ورود / ثبت‌نام", "Sign in", "تسجيل الدخول")</a>
            }
        </nav>
    </div>
</header>

<main class="store-main">
    @RenderBody()
</main>

<footer class="store-footer" id="contact">
    <div class="container footer-grid">
        <div>
            <span class="brand-name">@Brand()</span>
            <p>@T("طرح‌های آماده چاپ روی پوشاک و هدایای تبلیغاتی؛ سفارش آنلاین، پیگیری تا تحویل.", "Ready-to-print designs for apparel and promotional gifts; order online, track until delivery.", "تصاميم جاهزة للطباعة على الملابس والهدايا الدعائية؛ اطلب عبر الإنترنت وتتبع حتى التسليم.")</p>
        </div>
        <div>
            <h3>@T("فروشگاه", "Store", "المتجر")</h3>
            <a href="/catalog">@T("همه طرح‌ها", "All designs", "كل التصاميم")</a>
            <a href="/account/orders">@T("پیگیری سفارش", "Track order", "تتبع الطلب")</a>
            <a href="/account">@T("حساب کاربری", "My account", "حسابي")</a>
        </div>
        <div>
            <h3>@T("تماس با ما", "Contact", "اتصل بنا")</h3>
            <a href="mailto:salam@pirang.ir">salam@pirang.ir</a>
            <a href="/#about">@T("درباره پیرنگ خان", "About Pirang Khan", "عن پیرنگ خان")</a>
        </div>
    </div>
    <div class="footer-base">
        <div class="container">
            <span>© @Brand() @DateTime.Now.Year</span>
            <span dir="ltr" class="muted">PIRANG KHAN · B2C</span>
        </div>
    </div>
</footer>
<script src="~/js/store.js" asp-append-version="true" defer></script>
</body>
</html>
