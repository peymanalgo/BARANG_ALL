@inject BARANG.B2C.Web.Services.SiteContext Site
@{
    Context.Response.Headers.CacheControl = "no-cache, no-store";
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    var dir = culture is "en" or "es" ? "ltr" : "rtl";
    string T(string fa, string en, string ar, string? es = null) => culture switch { "en" => en, "ar" => ar, "es" => es ?? en, _ => fa };
    var route = (Context.Request.Path.Value ?? "/").Trim('/');
    string CultureLink(string c)
    {
        var target = "/" + route + (Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : string.Empty);
        return "/language/set?culture=" + c + "&returnUrl=" + Uri.EscapeDataString(target);
    }
    var q = Context.Request.Query["search"].ToString();
    // منو/فوتر/تنظیمات از CMS داخل ERP می‌آیند (کش ۶۰ ثانیه؛ در نبود API حالت ایستای فعلی)
    var site = Site.LoadAsync().GetAwaiter().GetResult();
    var SiteBrand = site.Settings?.SiteName;
    string Brand() => SiteBrand ?? (culture switch { "en" => "Peyrang", "ar" => "بي‌رنگ", "es" => "Peyrang", _ => "پی‌رنگ" });
    var siteLogo = site.Settings?.LogoUrl;
    var cmsMenu = site.Menu;
    var cmsFooter = site.Footer;
    // فیچر «وبلاگ» (اسکوپ store): خاموش باشد → آیتم وبلاگ از منو حذف می‌شود (خطا = روشن)
    var blogOn = Site.FeatureEnabledAsync("blog").GetAwaiter().GetResult();
    // تلفن واقعی از تنظیمات CMS؛ اگر هنوز مقدار صفر/پیش‌فرض بود نمایش داده نمی‌شود (نماد ساختگی ممنوع)
    string? contactPhone = site.Settings?.Phone;
    bool phoneIsPlaceholder = string.IsNullOrWhiteSpace(contactPhone) || contactPhone.Replace(" ", "").StartsWith("02100000000");
    // شبکه‌های اجتماعی — در نبود نشانی واقعی از CMS، آیکون‌ها رندر نمی‌شوند (لینک ساختگی ممنوع)
    string socialInstagram = "https://instagram.com/peyrang.ir";
    string socialTelegram = "https://t.me/peyrang_ir";
    string socialWhatsapp = "https://wa.me/989120000000";

}
<!DOCTYPE html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? $"{t} · {Brand()}" : $"{Brand()} — {T("فروشگاه طرح‌های چاپی", "Print-ready designs store", "متجر التصاميم الجاهزة للطباعة", "Tienda de diseños listos para imprimir")}")</title>
    <meta name="description" content="@(ViewData["Description"] ?? $"{Brand()} — {T("سفارش آنلاین چاپ طرح‌های مورد علاقه‌ات روی تیشرت", "Order your favourite designs printed on t-shirts online", "اطبع تصاميمك المفضلة على التيشرت عبر الإنترنت", "Pide en línea tus diseños favoritos impresos en camisetas")}")" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    @if (ViewData["Keywords"] is string kw && kw.Length > 0)
    {
        <meta name="keywords" content="@kw" />
    }
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="@T("پی‌رنگ خان", "Peyrang Khan", "پی‌رنگ خان", "Peyrang Khan")" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:site_name" content="@Brand()" />
    <meta property="og:title" content="@(ViewData["Title"] is string ot && ot.Length > 0 ? ot : $"{Brand()} — {T("فروشگاه طرح‌های چاپی", "Print-ready designs store", "متجر التصاميم الجاهزة للطباعة", "Tienda de diseños listos para imprimir")}")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? T("سفارش آنلاین چاپ طرح‌های مورد علاقه‌ات روی تیشرت", "Order your favourite designs printed on t-shirts online", "اطبع تصاميمك المفضلة على التيشرت عبر الإنترنت", "Pide en línea tus diseños favoritos impresos en camisetas"))" />
    @if (ViewData["OgImage"] is string ogImage && ogImage.Length > 0)
    {
        <meta property="og:image" content="@ogImage" />
    }
    <link rel="canonical" href="@Context.Request.Path.Value?.ToLowerInvariant()@(Context.Request.QueryString.HasValue ? "?" + Context.Request.QueryString.Value.ToLowerInvariant() : "")" />
    <link rel="alternate" hreflang="fa" href="@Context.Request.Path.Value?culture=fa" />
    <link rel="alternate" hreflang="en" href="@Context.Request.Path.Value?culture=en" />
    <link rel="alternate" hreflang="ar" href="@Context.Request.Path.Value?culture=ar" />
    <link rel="alternate" hreflang="es" href="@Context.Request.Path.Value?culture=es" />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/images/pirang-khan.jpg")" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path.Value}")" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />
</head>
<body>
<header class="store-header">
    <div class="container header-inner">
        <button type="button" class="nav-toggle" data-nav-toggle aria-label="@T("منو", "Menu", "القائمة", "Menú")" aria-expanded="false">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <a class="brand" href="/">
            @if (siteLogo is { Length: > 0 })
            {
                <img class="brand-logo" src="@siteLogo" alt="@Brand()" />
            }
            else
            {
                <img class="brand-logo" src="~/images/logo-wordmark-final.png" alt="@Brand()" asp-append-version="true" />
            }
        </a>
        <nav class="main-nav" id="main-nav" data-main-nav aria-label="@T("منوی اصلی", "Main menu", "القائمة الرئيسية", "Menú principal")">
            @if (cmsMenu.Count > 0)
            {
                foreach (var m in cmsMenu)
                {
                    if (!blogOn && (m.Href == "/blog" || m.Href.StartsWith("/blog/", StringComparison.OrdinalIgnoreCase))) { continue; }
                    var isActive = route.Length == 0 ? m.Href == "/" : (m.Href != "/" && route.StartsWith(m.Href.TrimStart('/'), StringComparison.OrdinalIgnoreCase));
                    <a href="@m.Href" class="@(m.Cta ? "nav-cta " : "")@(isActive ? "active" : null)">@m.Title</a>
                }
            }
            else
            {
                <a href="/" class="@(route.Length == 0 ? "active" : null)">@T("صفحه اصلی", "Home", "الرئيسية", "Inicio")</a>
                <a href="/order/wizard" class="nav-cta @(route.StartsWith("order/wizard") ? "active" : null)">@T("شروع طراحی تیشرت", "Start designing", "ابدأ التصميم", "Empezar a diseñar")</a>
                <a href="/catalog" class="@(route.StartsWith("catalog") ? "active" : null)">@T("طرح‌ها", "Designs", "التصامیم", "Diseños")</a>
                <a href="/#features">@T("چاپ و بسته‌بندی", "Printing", "الطباعة", "Impresión")</a>
                <a href="/about" class="@(route.StartsWith("about") ? "active" : null)">@T("درباره ما", "About", "من نحن", "Acerca de")</a>
                <a href="/contact" class="@(route.StartsWith("contact") ? "active" : null)">@T("تماس با ما", "Contact", "اتصل بنا", "Contacto")</a>
                @if (blogOn)
                {
                    <a href="/blog" class="@(route.StartsWith("blog") ? "active" : null)">@T("وبلاگ", "Blog", "المدونة", "Blog")</a>
                }
            }
        </nav>
        <nav class="header-actions" aria-label="@T("حساب کاربری", "Account", "الحساب", "Cuenta")">
            <details class="lang-menu">
                <summary aria-label="@T("زبان", "Language", "اللغة", "Idioma")">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.9 5.7 3.9 9S14.5 18.4 12 21M12 3C9.5 5.6 8.1 8.7 8.1 12s1.4 6.4 3.9 9"/></svg>
                </summary>
                <div class="lang-pop">
                    <a href="@CultureLink("fa")" hreflang="fa">فارسی</a>
                    <a href="@CultureLink("en")" hreflang="en">English</a>
                    <a href="@CultureLink("ar")" hreflang="ar">العربية</a>
                    <a href="@CultureLink("es")" hreflang="es">Español</a>
                </div>
            </details>
            <details class="cart-menu lang-menu" data-cart-menu>
                <summary aria-label="@T("سبد خرید", "Cart", "السلة", "Carrito")">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    <span class="cart-badge" data-cart-badge hidden>0</span>
                </summary>
                <div class="cart-pop">
                    <div class="cart-pop-items" data-cart-items></div>
                    <a class="cart-pop-link" href="/cart">@T("مشاهده سبد خرید", "View cart", "عرض السلة", "Ver carrito")</a>
                </div>
            </details>
            <a class="icon-btn" href="/account/orders" aria-label="@T("سفارش‌های من", "My orders", "طلباتي", "Mis pedidos")">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 7h12l1.2 12.2a1.5 1.5 0 0 1-1.5 1.8H6.3a1.5 1.5 0 0 1-1.5-1.8L6 7z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>
            </a>
            <a class="icon-btn" href="/account" aria-label="@T("حساب کاربری", "Account", "الحساب", "Cuenta")">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-3.6 4.5-5.5 8-5.5s6.5 1.9 8 5.5"/></svg>
            </a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-primary btn-sm" href="/account/login">@T("ورود / ثبت‌نام", "Sign in", "تسجيل الدخول", "Iniciar sesión")</a>
            }
        </nav>
    </div>
    @* جستجو در صفحه اول وسط هیرو است؛ بقیه صفحات نوار جستجوی هدر را دارند *@
    @if (route.Length > 0)
    {
        <div class="container header-searchbar">
            <form class="header-search" action="/catalog" method="get" role="search">
                <div class="hs-field">
                    <svg class="hs-icon-mag" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M11 8a3 3 0 0 1 3 3" opacity=".55"/></svg>
                    <input type="search" name="search" value="@q" placeholder="@T("جستجوی مفهومی طرح میان هزاران طرح متنوع برای شما...", "Concept-search thousands of designs...", "بحث مفاهيمي بين آلاف التصاميم...", "Busca conceptualmente entre miles de diseños...")" aria-label="@T("جستجوی مفهومی", "Concept search", "بحث مفاهيمي", "Búsqueda por conceptos")" />
                    <button type="submit" class="hs-go">@T("جستجو", "Search", "بحث", "Buscar")</button>
                </div>
            </form>
        </div>
    }
</header>

<main class="store-main">
    @RenderBody()
</main>

<footer class="store-footer" id="contact">
    @if (cmsFooter.Count > 0)
    {
        <div class="container footer-grid">
            @for (int col = 1; col <= 4; col++)
            {
                var colImages = cmsFooter.Where(x => x.Column == col && x.Type == "image").ToList();
                var colOthers = cmsFooter.Where(x => x.Column == col && x.Type != "image").ToList();
                <div class="footer-col">
                    @if (colImages.Count > 0)
                    {
                        <div class="license-grid">
                            @foreach (var w in colImages)
                            {
                                <a href="@w.Href" class="license-thumb"><img src="@(w.ImageUrl ?? w.Href)" alt="@(w.Title ?? "")" loading="lazy" /></a>
                            }
                        </div>
                    }
                    @foreach (var w in colOthers)
                    {
                        if (w.Type == "text")
                        {
                            <p>@w.Text</p>
                        }
                        else if (w.Type == "html")
                        {
                            @Html.Raw(w.Html)
                        }
                        else if (w.Href is { Length: > 0 })
                        {
                            <a href="@w.Href">@(w.Title ?? w.Href)</a>
                        }
                    }
                </div>
            }
        </div>
        @* شبکه‌های اجتماعی زیر ستون‌ها — در هر دو حالت CMS و جایگزین *@
        <div class="container footer-social-row">
            <div class="footer-social">
                <a href="@socialInstagram" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
                </a>
                <a href="@socialTelegram" target="_blank" rel="noopener" aria-label="Telegram" title="Telegram">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M21.9 4.3 18.9 19c-.2 1-.8 1.2-1.6.8l-4.5-3.3-2.2 2.1c-.2.2-.4.4-.9.4l.3-4.6L18.5 6.6c.4-.3-.1-.5-.6-.2L7.5 13.2l-4.4-1.4c-1-.3-1-1 .2-1.4L20.5 3.3c.8-.3 1.6.2 1.4 1z"/></svg>
                </a>
                <a href="@socialWhatsapp" target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm5.7 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-2.7-.9-4.5-3.2-4.6-3.4-.1-.1-1.1-1.5-1.1-2.8 0-1.4.7-2 .9-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.8 2c.1.2.1.4 0 .6l-.4.6c-.1.2-.3.4-.1.7.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.4.1.1.1.7-.5 1.7z"/></svg>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="container footer-grid">
            <div>
                <span class="footer-brand"><img class="footer-brand-logo" src="~/images/logo-wordmark-final.png" alt="@Brand()" asp-append-version="true" /></span>
                <p>@T("طرح‌های آماده چاپ روی پوشاک و هدایای تبلیغاتی؛ سفارش آنلاین، پیگیری تا تحویل.", "Ready-to-print designs for apparel and promotional gifts; order online, track until delivery.", "تصاميم جاهزة للطباعة على الملابس والهدايا الدعائية؛ اطلب عبر الإنترنت وتتبع حتى التسليم.", "Diseños listos para imprimir en prendas y regalos publicitarios; pide en línea y sigue hasta la entrega.")</p>
                <p class="footer-slogan">@(string.IsNullOrWhiteSpace(site.Settings?.Slogan) ? T("پی‌رنگ؛ طرح دلخواهت را انتخاب کن، ما چاپش می‌کنیم.", "Peyrang: pick a design and we print it!", "پی‌رنگ خان لديه التصاميم من أجلك!", "¡Peyrang Khan tiene los diseños para ti!") : site.Settings.Slogan)</p>
            </div>
            <div>
                <h3>@T("فروشگاه", "Store", "المتجر", "Tienda")</h3>
                <a href="/catalog">@T("همه طرح‌ها", "All designs", "كل التصاميم", "Todos los diseños")</a>
                <a href="/account/orders">@T("پیگیری سفارش", "Track order", "تتبع الطلب", "Seguir pedido")</a>
                <a href="/faq">@T("سوالات متداول", "FAQ", "الأسئلة الشائعة", "Preguntas frecuentes")</a>
                @if (!phoneIsPlaceholder)
                {
                    <a href="tel:@contactPhone.Replace(" ", "")" dir="ltr">@contactPhone</a>
                }
                <a href="/account">@T("حساب کاربری", "My account", "حسابي", "Mi cuenta")</a>
            </div>
            <div>
                <h3>@T("تماس با ما", "Contact", "اتصل بنا", "Contacto")</h3>
                <a href="mailto:salam@pirang.ir">salam@pirang.ir</a>
                <a href="/about">@T("درباره پی‌رنگ", "About Peyrang", "عن پی‌رنگ", "Acerca de Peyrang")</a>
                <div class="footer-social">
                    <a href="@socialInstagram" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
                    </a>
                    <a href="@socialTelegram" target="_blank" rel="noopener" aria-label="Telegram" title="Telegram">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M21.9 4.3 18.9 19c-.2 1-.8 1.2-1.6.8l-4.5-3.3-2.2 2.1c-.2.2-.4.4-.9.4l.3-4.6L18.5 6.6c.4-.3-.1-.5-.6-.2L7.5 13.2l-4.4-1.4c-1-.3-1-1 .2-1.4L20.5 3.3c.8-.3 1.6.2 1.4 1z"/></svg>
                    </a>
                    <a href="@socialWhatsapp" target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm5.7 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-2.7-.9-4.5-3.2-4.6-3.4-.1-.1-1.1-1.5-1.1-2.8 0-1.4.7-2 .9-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.8 2c.1.2.1.4 0 .6l-.4.6c-.1.2-.3.4-.1.7.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.4.1.1.1.7-.5 1.7z"/></svg>
                    </a>
                </div>
            </div>
        </div>
    }
    <div class="footer-base">
        <div class="container">
            <span>© @Brand() @DateTime.Now.Year</span>
            <span dir="ltr" class="muted">PEYRANG · B2C</span>
        </div>
    </div>
</footer>
<script src="~/js/store.js" asp-append-version="true" defer></script>
<script src="~/js/design-preview.js" asp-append-version="true" defer></script>

<partial name="_AiAssistant" />

@* ---------- نوار تب پایین (تجربه اپ موبایلی) — دکمه مرکزی برجسته «شروع طراحی» ---------- *@
<nav class="mobile-tabbar" aria-label="@T("منوی اصلی", "Main menu", "القائمة الرئيسية", "Menú principal")">
    <a href="/" class="@(route.Length == 0 ? "active" : null)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>@T("خانه", "Home", "الرئيسية", "Inicio")</span>
    </a>
    <a href="/catalog" class="@(route.StartsWith("catalog") || route.StartsWith("design") ? "active" : null)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7.5" height="7.5" rx="1.8"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.8"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.8"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.8"/></svg>
        <span>@T("طرح‌ها", "Designs", "التصاميم", "Diseños")</span>
    </a>
    <a href="/order/wizard" class="tabbar-cta" aria-label="@T("شروع طراحی تیشرت", "Start designing", "ابدأ التصميم", "Empezar a diseñar")">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5 13.8 8l5.7 1.9-4.7 3.6 1.8 5.9-5.1-3.5-5.1 3.5 1.8-5.9L3.2 9.9 8.9 8z"/></svg>
        <span>@T("شروع طراحی", "Design", "صمّم", "Diseñar")</span>
    </a>
    <a href="/account/orders" class="@(route.StartsWith("account/orders") ? "active" : null)">
