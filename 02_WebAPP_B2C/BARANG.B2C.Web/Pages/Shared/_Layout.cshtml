@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    var dir = culture == "en" ? "ltr" : "rtl";
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    var route = (Context.Request.Path.Value ?? "/").Trim('/');
    string CultureLink(string c)
    {
        var path = "/" + route;
        return path + (path.Contains('?') ? "&" : "?") + "culture=" + c;
    }
}
<!DOCTYPE html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? $"{t} · برنگ" : "برنگ — فروشگاه طرح‌های چاپی")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "فروشگاه طرح‌های چاپی برنگ — سفارش آنلاین چاپ روی لباس و هدایا")" />
    <link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />
</head>
<body>
<header class="store-header">
    <div class="container header-inner">
        <a class="brand" href="/">
            <span class="brand-word">برنگ</span>
            <span class="brand-sub">@T("فروشگاه طرح‌های چاپی", "Print design store", "متجر تصاميم الطباعة")</span>
        </a>
        <form class="header-search" action="/catalog" method="get" role="search">
            <input type="search" name="search" value="@(Context.Request.Query["search"].ToString())" placeholder="@T("جستجوی طرح…", "Search designs…", "ابحث عن تصميم…")" aria-label="@T("جستجو", "Search", "بحث")" />
            <button type="submit" aria-label="@T("جستجو", "Search", "بحث")">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </button>
        </form>
        <nav class="header-actions" aria-label="@T("حساب کاربری", "Account", "الحساب")">
            <details class="lang-menu">
                <summary aria-label="@T("زبان", "Language", "اللغة")">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.9 5.7 3.9 9S14.5 18.4 12 21M12 3C9.5 5.6 8.1 8.7 8.1 12s1.4 6.4 3.9 9"/></svg>
                </summary>
                <div class="lang-pop">
                    <a href="@CultureLink("fa")" hreflang="fa">فارسی</a>
                    <a href="@CultureLink("en")" hreflang="en">English</a>
                    <a href="@CultureLink("ar")" hreflang="ar">العربية</a>
                </div>
            </details>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn btn-account" href="/account" title="@User.Identity!.Name">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-3.6 4.5-5.5 8-5.5s6.5 1.9 8 5.5"/></svg>
                    <span class="account-name">@User.Identity.Name</span>
                </a>
            }
            else
            {
                <a class="btn btn-primary btn-sm" href="/account/login">@T("ورود", "Sign in", "تسجيل الدخول")</a>
            }
        </nav>
    </div>
</header>

<main class="store-main">
    @RenderBody()
</main>

<footer class="store-footer">
    <div class="container footer-grid">
        <div>
            <span class="brand-word">برنگ</span>
            <p>@T("طرح‌های آماده چاپ روی پوشاک و هدایای تبلیغاتی؛ سفارش آنلاین، پیگیری تا تحویل.", "Ready-to-print designs for apparel and promotional gifts; order online and track until delivery.", "تصاميم جاهزة للطباعة على الملابس والهدايا الدعائية؛ اطلب عبر الإنترنت وتتبع حتى التسليم.")</p>
        </div>
        <div>
            <h3>@T("فروشگاه", "Store", "المتجر")</h3>
            <a href="/catalog">@T("همه طرح‌ها", "All designs", "كل التصاميم")</a>
            <a href="/account">@T("حساب کاربری", "My account", "حسابي")</a>
        </div>
        <div>
            <h3>@T("راهنما", "Help", "المساعدة")</h3>
            <a href="/catalog">@T("جستجوی طرح", "Find a design", "ابحث عن تصميم")</a>
            <a href="/account">@T("پیگیری سفارش", "Track order", "تتبع الطلب")</a>
        </div>
    </div>
    <div class="footer-base">
        <div class="container">
            <span>© برنگ @DateTime.Now.Year</span>
            <span dir="ltr" class="muted">BARANG · B2C</span>
        </div>
    </div>
</footer>
<script src="~/js/store.js" asp-append-version="true" defer></script>
</body>
</html>
