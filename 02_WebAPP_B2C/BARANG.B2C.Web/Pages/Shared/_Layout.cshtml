@inject BARANG.B2C.Web.Services.SiteContext Site
@{
    Context.Response.Headers.CacheControl = "no-cache, no-store";
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    var dir = culture == "en" ? "ltr" : "rtl";
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    var route = (Context.Request.Path.Value ?? "/").Trim('/');
    string CultureLink(string c)
    {
        var target = "/" + route + (Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : string.Empty);
        return "/language/set?culture=" + c + "&returnUrl=" + Uri.EscapeDataString(target);
    }
    var q = Context.Request.Query["search"].ToString();
    // منو/فوتر/تنظیمات از CMS داخل ERP می‌آیند (کش ۶۰ ثانیه؛ در نبود API حالت ایستای فعلی)
    var site = Site.LoadAsync().GetAwaiter().GetResult();
    var SiteBrand = site.Settings?.SiteName;
    string Brand() => SiteBrand ?? (culture switch { "en" => "Peyrang", "ar" => "بي‌رنگ", _ => "پی‌رنگ" });
    var siteLogo = site.Settings?.LogoUrl;
    var cmsMenu = site.Menu;
    var cmsFooter = site.Footer;

}
<!DOCTYPE html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? $"{t} · {Brand()}" : $"{Brand()} — {T("فروشگاه طرح‌های چاپی", "Print-ready designs store", "متجر التصاميم الجاهزة للطباعة")}")</title>
    <meta name="description" content="@(ViewData["Description"] ?? $"{Brand()} — {T("سفارش آنلاین چاپ طرح‌های مورد علاقه‌ات روی تیشرت", "Order your favourite designs printed on t-shirts online", "اطبع تصاميمك المفضلة على التيشرت عبر الإنترنت")}")" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    @if (ViewData["Keywords"] is string kw && kw.Length > 0)
    {
        <meta name="keywords" content="@kw" />
    }
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="@T("پی‌رنگ خان", "Peyrang Khan", "پی‌رنگ خان")" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:site_name" content="@Brand()" />
    <meta property="og:title" content="@(ViewData["Title"] is string ot && ot.Length > 0 ? ot : $"{Brand()} — {T("فروشگاه طرح‌های چاپی", "Print-ready designs store", "متجر التصاميم الجاهزة للطباعة")}")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? T("سفارش آنلاین چاپ طرح‌های مورد علاقه‌ات روی تیشرت", "Order your favourite designs printed on t-shirts online", "اطبع تصاميمك المفضلة على التيشرت عبر الإنترنت"))" />
    @if (ViewData["OgImage"] is string ogImage && ogImage.Length > 0)
    {
        <meta property="og:image" content="@ogImage" />
    }
    <link rel="canonical" href="@Context.Request.Path.Value?.ToLowerInvariant()@(Context.Request.QueryString.HasValue ? "?" + Context.Request.QueryString.Value.ToLowerInvariant() : "")" />
    <link rel="alternate" hreflang="fa" href="@Context.Request.Path.Value?culture=fa" />
    <link rel="alternate" hreflang="en" href="@Context.Request.Path.Value?culture=en" />
    <link rel="alternate" hreflang="ar" href="@Context.Request.Path.Value?culture=ar" />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/images/pirang-khan.jpg")" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path.Value}")" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />
</head>
<body>
<header class="store-header">
    <div class="container header-inner">
        <a class="brand" href="/">
            @if (siteLogo is { Length: > 0 })
            {
                <img class="brand-logo" src="@siteLogo" alt="@Brand()" />
            }
            else
            {
                <img class="brand-logo" src="~/images/logo-wordmark-final.png" alt="@Brand()" asp-append-version="true" />
            }
        </a>
        <nav class="main-nav" aria-label="@T("منوی اصلی", "Main menu", "القائمة الرئيسية")">
            @if (cmsMenu.Count > 0)
            {
                foreach (var m in cmsMenu)
                {
                    var isActive = route.Length == 0 ? m.Href == "/" : (m.Href != "/" && route.StartsWith(m.Href.TrimStart('/'), StringComparison.OrdinalIgnoreCase));
                    <a href="@m.Href" class="@(m.Cta ? "nav-cta " : "")@(isActive ? "active" : null)">@(m.Cta ? "✨ " : "")@m.Title</a>
                }
            }
            else
            {
                <a href="/" class="@(route.Length == 0 ? "active" : null)">@T("صفحه اصلی", "Home", "الرئيسية")</a>
                <a href="/order/wizard" class="nav-cta @(route.StartsWith("order/wizard") ? "active" : null)">✨ @T("شروع طراحی تیشرت", "Start designing", "ابدأ التصميم")</a>
                <a href="/catalog" class="@(route.StartsWith("catalog") ? "active" : null)">@T("طرح‌ها", "Designs", "التصامیم")</a>
                <a href="/#features">@T("چاپ و بسته‌بندی", "Printing", "الطباعة")</a>
                <a href="/about" class="@(route.StartsWith("about") ? "active" : null)">@T("درباره ما", "About", "من نحن")</a>
                <a href="/contact" class="@(route.StartsWith("contact") ? "active" : null)">@T("تماس با ما", "Contact", "اتصل بنا")</a>
                <a href="/blog" class="@(route.StartsWith("blog") ? "active" : null)">@T("وبلاگ", "Blog", "المدونة")</a>
            }
        </nav>
        <nav class="header-actions" aria-label="@T("حساب کاربری", "Account", "الحساب")">
            <details class="lang-menu">
                <summary aria-label="@T("زبان", "Language", "اللغة")">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.9 5.7 3.9 9S14.5 18.4 12 21M12 3C9.5 5.6 8.1 8.7 8.1 12s1.4 6.4 3.9 9"/></svg>
                </summary>
                <div class="lang-pop">
                    <a href="@CultureLink("fa")" hreflang="fa">فارسی</a>
                    <a href="@CultureLink("en")" hreflang="en">English</a>
                    <a href="@CultureLink("ar")" hreflang="ar">العربية</a>
                </div>
            </details>
            <details class="cart-menu lang-menu" data-cart-menu>
                <summary aria-label="@T("سبد خرید", "Cart", "السلة")">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    <span class="cart-badge" data-cart-badge hidden>0</span>
                </summary>
                <div class="cart-pop">
                    <div class="cart-pop-items" data-cart-items></div>
                    <a class="cart-pop-link" href="/cart">@T("مشاهده سبد خرید", "View cart", "عرض السلة")</a>
                </div>
            </details>
            <a class="icon-btn" href="/account/orders" aria-label="@T("سفارش‌های من", "My orders", "طلباتي")">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 7h12l1.2 12.2a1.5 1.5 0 0 1-1.5 1.8H6.3a1.5 1.5 0 0 1-1.5-1.8L6 7z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>
            </a>
            <a class="icon-btn" href="/account" aria-label="@T("حساب کاربری", "Account", "الحساب")">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-3.6 4.5-5.5 8-5.5s6.5 1.9 8 5.5"/></svg>
            </a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-primary btn-sm" href="/account/login">@T("ورود / ثبت‌نام", "Sign in", "تسجيل الدخول")</a>
            }
        </nav>
    </div>
    @* جستجو در صفحه اول وسط هیرو است؛ بقیه صفحات نوار جستجوی هدر را دارند *@
    @if (route.Length > 0)
    {
        <div class="container header-searchbar">
            <form class="header-search" action="/catalog" method="get" role="search">
                <div class="hs-field">
                    <svg class="hs-icon-mag" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M11 8a3 3 0 0 1 3 3" opacity=".55"/></svg>
                    <input type="search" name="search" value="@q" placeholder="@T("جستجوی مفهومی طرح میان هزاران طرح متنوع برای شما...", "Concept-search thousands of designs...", "بحث مفاهيمي بين آلاف التصاميم...")" aria-label="@T("جستجوی مفهومی", "Concept search", "بحث مفاهيمي")" />
                    <button type="submit" class="hs-go">@T("جستجو", "Search", "بحث")</button>
                </div>
            </form>
        </div>
    }
</header>

<main class="store-main">
    @RenderBody()
</main>

<footer class="store-footer" id="contact">
    @if (cmsFooter.Count > 0)
    {
        <div class="container footer-grid">
            @for (int col = 1; col <= 4; col++)
            {
                var colImages = cmsFooter.Where(x => x.Column == col && x.Type == "image").ToList();
                var colOthers = cmsFooter.Where(x => x.Column == col && x.Type != "image").ToList();
                <div class="footer-col">
                    @if (colImages.Count > 0)
                    {
                        <div class="license-grid">
                            @foreach (var w in colImages)
                            {
                                <a href="@w.Href" class="license-thumb"><img src="@(w.ImageUrl ?? w.Href)" alt="@(w.Title ?? "")" loading="lazy" /></a>
                            }
                        </div>
                    }
                    @foreach (var w in colOthers)
                    {
                        if (w.Type == "text")
                        {
                            <p>@w.Text</p>
                        }
                        else if (w.Type == "html")
                        {
                            @Html.Raw(w.Html)
                        }
                        else if (w.Href is { Length: > 0 })
                        {
                            <a href="@w.Href">@(w.Title ?? w.Href)</a>
                        }
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="container footer-grid">
            <div>
                <span class="footer-brand"><img class="footer-brand-logo" src="~/images/logo-wordmark-final.png" alt="@Brand()" asp-append-version="true" /></span>
                <p>@T("طرح‌های آماده چاپ روی پوشاک و هدایای تبلیغاتی؛ سفارش آنلاین، پیگیری تا تحویل.", "Ready-to-print designs for apparel and promotional gifts; order online, track until delivery.", "تصاميم جاهزة للطباعة على الملابس والهدايا الدعائية؛ اطلب عبر الإنترنت وتتبع حتى التسليم.")</p>
                <p class="footer-slogan">@T("پی‌رنگ خان، نقشه‌ها داره برات!", "Peyrang Khan has the designs for you!", "پی‌رنگ خان لديه التصاميم من أجلك!")</p>
            </div>
            <div>
                <h3>@T("فروشگاه", "Store", "المتجر")</h3>
                <a href="/catalog">@T("همه طرح‌ها", "All designs", "كل التصاميم")</a>
                <a href="/account/orders">@T("پیگیری سفارش", "Track order", "تتبع الطلب")</a>
                <a href="/faq">@T("سوالات متداول", "FAQ", "الأسئلة الشائعة")</a>
                <a href="tel:02100000000" dir="ltr">021-00000000</a>
                <a href="/account">@T("حساب کاربری", "My account", "حسابي")</a>
            </div>
            <div>
                <h3>@T("تماس با ما", "Contact", "اتصل بنا")</h3>
                <a href="mailto:salam@pirang.ir">salam@pirang.ir</a>
                <a href="/about">@T("درباره پی‌رنگ", "About Peyrang", "عن پی‌رنگ")</a>
            </div>
            <div class="footer-licenses">
                <h3>@T("مجوزها", "Licenses", "التراخيص")</h3>
                <div class="license-grid">
                    <img src="~/images/license-badge-1.svg" alt="@T("مجوز نمونه ۱", "Sample license 1", "ترخيص نموذجي ١")" asp-append-version="true" />
                    <img src="~/images/license-badge-2.svg" alt="@T("مجوز نمونه ۲", "Sample license 2", "ترخيص نموذجي ٢")" asp-append-version="true" />
                    <img src="~/images/license-badge-3.svg" alt="@T("مجوز نمونه ۳", "Sample license 3", "ترخيص نموذجي ٣")" asp-append-version="true" />
                    <img src="~/images/license-badge-4.svg" alt="@T("مجوز نمونه ۴", "Sample license 4", "ترخيص نموذجي ٤")" asp-append-version="true" />
                </div>
            </div>
        </div>
    }
    <div class="footer-base">
        <div class="container">
            <span>© @Brand() @DateTime.Now.Year</span>
            <span dir="ltr" class="muted">PEYRANG · B2C</span>
        </div>
    </div>
</footer>
<script src="~/js/store.js" asp-append-version="true" defer></script>
<script src="~/js/design-preview.js" asp-append-version="true" defer></script>

@* ---------- نوار تب پایین (تجربه اپ موبایلی) ---------- *@
<nav class="mobile-tabbar" aria-label="@T("منوی اصلی", "Main menu", "القائمة الرئيسية")">
    <a href="/" class="@(route.Length == 0 ? "active" : null)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>@T("خانه", "Home", "الرئيسية")</span>
    </a>
    <a href="/catalog" class="@(route.StartsWith("catalog") || route.StartsWith("design") ? "active" : null)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7.5" height="7.5" rx="1.8"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.8"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.8"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.8"/></svg>
        <span>@T("طرح‌ها", "Designs", "التصاميم")</span>
    </a>
    <a href="/account/orders" class="@(route.StartsWith("account/orders") ? "active" : null)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l1.2 12.2a1.5 1.5 0 0 1-1.5 1.8H6.3a1.5 1.5 0 0 1-1.5-1.8L6 7z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>
        <span>@T("سفارش‌ها", "Orders", "طلباتي")</span>
    </a>
    <a href="/account" class="@(route.StartsWith("account") && !route.StartsWith("account/orders") ? "active" : null)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-3.6 4.5-5.5 8-5.5s6.5 1.9 8 5.5"/></svg>
        <span>@T("حساب", "Account", "حسابي")</span>
    </a>
</nav>
</body>
</html>
