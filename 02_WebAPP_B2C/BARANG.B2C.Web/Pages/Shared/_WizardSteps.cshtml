@model int
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar, string? es = null) => culture switch { "en" => en, "ar" => ar, "es" => es ?? en, _ => fa };
    string[] steps = {
        T("انتخاب تیشرت", "Choose shirt", "اختر التيشرت", "Elegir camiseta"),
        T("تنظیمات چاپ", "Print settings", "إعدادات الطباعة", "Ajustes de impresión"),
        T("بسته‌بندی", "Packaging", "التغليف", "Embalaje"),
        T("ثبت سفارش و پرداخت", "Submit & pay", "إرسال ودفع", "Enviar y pagar")
    };
}
<div class="container wizard-steps" aria-label="steps">
    @for (int i = 0; i < steps.Length; i++)
    {
        var state = i + 1 < Model ? "done" : i + 1 == Model ? "current" : "todo";
        <span class="wstep @state"><b>@(i + 1)</b> @steps[i]</span>
        @if (i < steps.Length - 1)
        {
            <span class="wstep-line @(i + 1 < Model ? "done" : "")"></span>
        }
    }
</div>
