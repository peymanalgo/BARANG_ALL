@page
@model IndexModel
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    ViewData["Title"] = T("خانه", "Home", "الرئيسية");
}
@* ---------- HERO: عکس تیشرت‌ها (۷۵٪) + جستجوی شیشه‌ای تمام‌عرض ---------- *@
<section class="hero2">
    <div class="hero2-inner">
        <div class="hero-frame">
            <img class="hero2-photo" src="~/images/hero-shirts.jpg" width="1200" height="800" loading="eager" fetchpriority="high"
                 alt="@T("تیشرت‌های چاپ‌شده با طرح‌های دلخواه روی چوب‌لباسی، بسته‌بندی و تیشرت روی زمین", "Printed custom t-shirts on hangers, packaging and a shirt on the floor", "تيشرتات مطبوعة بالتصاميم المخصصة على الشماعات والعبوة والتيشرت على الأرض")" />
        <h1 class="sr-only">@T("پی‌رنگ خان — فروشگاه طرح‌های چاپی", "Peyrang — print designs store", "پی‌رنگ — متجر التصاميم الجاهزة للطباعة")</h1>
        <div class="hero2-search reveal">
            <form class="header-search" action="/catalog" method="get" role="search">
                <div class="hs-field">
                    <svg class="hs-icon-mag" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M11 8a3 3 0 0 1 3 3" opacity=".55"/></svg>
                    <input type="search" name="search" placeholder="@T("جستجوی طرح میان هزاران طرح متنوع برای شما...", "Search among thousands of designs...", "ابحث بين آلاف التصاميم...")" aria-label="@T("جستجو", "Search", "بحث")" />
                    <label class="mode-toggle compact" title="@T("جستجوی مفهومی: پیدا کردن طرح‌ها بر اساس معنا و مفهوم، نه فقط کلمات", "Concept search: find designs by meaning, not just keywords", "بحث مفاهيمي: إيجاد التصاميم حسب المعنى وليس الكلمات فقط")">
                        <input type="checkbox" name="mode" value="concept" aria-label="@T("جستجوی مفهومی", "Concept search", "بحث مفاهيمي")" />
                        <svg class="hs-spark" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5 13.8 8l5.7 1.9-4.7 3.6 1.8 5.9-5.1-3.5-5.1 3.5 1.8-5.9L3.2 9.9 8.9 8z"/><path d="M19 3v4M21 5h-4" stroke-width="1.4"/></svg>
                    </label>
                    <button type="submit" class="hs-go">@T("جستجو", "Search", "بحث")</button>
                </div>
            </form>
            </div>
        </div>
    </div>
</section>

@* ---------- FEATURES ---------- *@
<section class="features2" aria-label="@T("ویژگی‌ها", "Features", "الميزات")">
    <div class="container features2-grid">
        <div class="feat2">@T("طرح‌های متنوع و منحصر", "Diverse & unique designs", "تصاميم متنوعة وفريدة")</div>
        <div class="feat2">@T("چاپ حرفه‌ای و متنوع", "Professional & varied printing", "طباعة احترافية ومتنوعة")</div>
        <div class="feat2">@T("بسته‌بندی شیک و امن", "Chic & safe packaging", "تغليف أنيق وآمن")</div>
        <div class="feat2">@T("کیفیت چاپ حرفه‌ای", "Professional print quality", "جودة طباعة احترافية")</div>
    </div>
</section>

@* ---------- CATEGORY STRIP ---------- *@
<section class="catstrip-wrap reveal" id="cats">
    <div class="container catstrip-head">
        <button type="button" class="strip-arrow" data-strip-scroll="-1" aria-label="@T("قبلی", "Previous", "السابق")">›</button>
        <div class="catstrip" data-strip>
            <a class="catstrip-card strip-hot" href="/catalog">
                <span class="strip-heart" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 21s-7.5-4.7-10-9.3C.6 8.6 2.4 5 6 5c2.2 0 3.6 1.2 4.5 2.5h3C14.4 6.2 15.8 5 18 5c3.6 0 5.4 3.6 4 6.7-2.5 4.6-10 9.3-10 9.3z"/></svg>
                </span>
                <strong>@T("محبوب‌ترین‌ها", "Most popular", "الأكثر شعبية")</strong>
            </a>
            @foreach (var c in Model.Categories)
            {
                <a class="catstrip-card" href="/catalog?category=@Uri.EscapeDataString(c.Code)">
                    <strong>@c.DisplayName</strong>
                    <small class="muted">@c.Count @T("طرح", "designs", "تصميم")</small>
                </a>
            }
        </div>
        <button type="button" class="strip-arrow" data-strip-scroll="1" aria-label="@T("بعدی", "Next", "التالي")">‹</button>
    </div>
</section>

@* ---------- FEATURED ---------- *@
<section class="container section reveal" id="featured">
    <div class="section-head">
        <h2>@T("طرح‌های منتخب", "Featured designs", "تصاميم مختارة")</h2>
        <a class="link-more" href="/catalog">@T("همه طرح‌ها ←", "All designs →", "كل التصاميم ←")</a>
    </div>
    @if (Model.Featured.Count == 0)
    {
        <p class="empty">@T("فعلاً طرحی منتشر نشده است.", "No designs published yet.", "لا توجد تصاميم منشورة بعد.")</p>
    }
    else
    {
        <div class="design-grid">
            @foreach (var d in Model.Featured)
            {
                <div class="design-card-wrap">
                    <a class="design-card" href="/design/@d.Id">
                        <span class="design-thumb">
                            @if (!string.IsNullOrWhiteSpace(d.Thumbnail))
                            {
                                <img src="@d.Thumbnail" alt="@d.Title" width="600" height="600" loading="lazy" decoding="async" />
                            }
                        </span>
                        <span class="design-meta">
                            <strong>@d.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(d.CategoryCode))
                            {
                                <span class="chip">@Model.CatName(d.CategoryCode)</span>
                            }
                        </span>
                    </a>

                </div>
            }
        </div>
    }
</section>

@* ---------- MASCOT ---------- *@
<section class="container mascot-band reveal">
    <img class="mascot-img" src="~/images/pirang-khan.jpg" asp-append-version="true" alt="پی‌رنگ خان" />
    <div class="mascot-bubble">
        <strong>@T("پی‌رنگ‌خان می‌گه:", "Peyrang Khan says:", "پی‌رنگ‌خان يقول:")</strong>
        <p class="mascot-slogan">@T("پی‌رنگ خان، نقشه‌ها داره برات!", "Peyrang Khan has the designs for you!", "پی‌رنگ خان لديه التصاميم من أجلك!")</p>
        <button type="button" class="btn btn-primary btn-lg btn-shine mascot-cta start-design-btn" data-designs='@System.Text.Json.JsonSerializer.Serialize(Model.Featured.Select(d => new { id = d.Id.ToString(), title = d.Title, thumb = d.Thumbnail }))'>@T("شروع طراحی تیشرت ←", "Start designing ←", "ابدأ التصميم ←")</button>
        <p>@T("هر طرحی پسندیدی، بگو تا با چند کلیک برات چاپش کنیم!", "Pick any design and we'll print it in a few clicks!", "أي تصميم يعجبك نطبعه بضغوطات!")</p>
    </div>
</section>

@* ---------- WHY / ABOUT ---------- *@
<section class="why-band reveal" id="about">
    <div class="container why-grid">
        <div class="why-card">
            <span class="why-icon wi-r"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/><circle cx="12" cy="12" r="4"/></svg></span>
            <h3>@T("طرح‌های متنوع و منحصر", "Diverse & unique designs", "تصاميم متنوعة وفريدة")</h3>
            <p>@T("هر هفته طرح‌های تازه از طراحی‌های مستقل اضافه می‌شود.", "Fresh designs from independent artists every week.", "تصاميم جديدة كل أسبوع.")</p>
        </div>
        <div class="why-card">
            <span class="why-icon wi-y"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"/><circle cx="19" cy="17" r="2.5"/></svg></span>
            <h3>@T("چاپ حرفه‌ای روی پارچه", "Professional fabric printing", "طباعة احترافية على القماش")</h3>
            <p>@T("چاپ DTF و سیلک‌اسکرین با ماندگاری بالا.", "DTF and silkscreen printing with high durability.", "طباعة DTF وحجر الطباعة بثبات عالٍ.")</p>
        </div>
        <div class="why-card">
            <span class="why-icon wi-b"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 12h4l2.5 6 4-13L16 12h5"/><circle cx="12" cy="21" r="1"/><circle cx="12" cy="3" r="1"/></svg></span>
            <h3>@T("رهگیری زنده تا تحویل", "Live tracking to delivery", "تتبع مباشر حتى التسليم")</h3>
            <p>@T("هر مرحله از سفارش را همین‌جا ببینید؛ از کارگاه تا دم در.", "Follow every stage here — from workshop to your door.", "تابع كل مرحلة من الورشة حتى باب منزلك.")</p>
        </div>
    </div>
</section>

