@page
@model IndexModel
@inject BARANG.B2C.Web.Services.SiteContext Site
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar, string? es = null) => culture switch { "en" => en, "ar" => ar, "es" => es ?? en, _ => fa };
    ViewData["Title"] = T("خانه", "Home", "الرئيسية", "Inicio");
    // شعار از CMS (تنظیمات سایت در ERP)؛ در نبودش متن پیش‌فرض
    var cmsSlogan = Site.LoadAsync().GetAwaiter().GetResult().Settings?.Slogan;
}
@* ---------- HERO: تیتر و ارزش پیشنهادی + CTA + عکس تیشرت‌ها + جستجو ---------- *@
<section class="hero2">
    <div class="hero2-inner">
        <div class="hero-copy">
            <h1>@T("طرح دلخواهت را روی تیشرت چاپ کن", "Print your favourite design on a t-shirt", "اطبع تصميمك المفضل على التيشرت", "Imprime tu diseño favorito en una camiseta")</h1>
            <p>@T("هزاران طرح آماده چاپ — انتخاب کن، سایز و رنگ را بزن، ۳ تا ۵ روز کاری بعد در خانه‌ات.", "Thousands of print-ready designs — pick one, choose size & color, delivered in 3–5 business days.", "آلاف التصاميم الجاهزة — اختر وحدد المقاس واللون، يصلك خلال ٣-٥ أيام عمل.", "Miles de diseños listos: elige, escoge talla y color, y recíbelo en 3-5 días hábiles.")</p>
            <div class="hero-ctas">
                <a class="btn btn-primary btn-lg btn-shine" href="/order/wizard">@T("شروع طراحی تیشرت ←", "Start designing →", "ابدأ التصميم ←", "Empezar a diseñar →")</a>
                <a class="btn btn-light btn-lg" href="/catalog">@T("مشاهده طرح‌ها", "Browse designs", "استعرض التصاميم", "Ver diseños")</a>
            </div>
            <ul class="hero-trust" aria-label="@T("مزایا", "Benefits", "المزايا", "Beneficios")">
                <li>@T("تضمین کیفیت چاپ", "Print quality guarantee", "ضمان جودة الطباعة", "Garantía de impresión")</li>
                <li>@T("لغو رایگان تا شروع چاپ", "Free cancellation before printing", "إلغاء مجاني قبل الطباعة", "Cancelación gratis antes de imprimir")</li>
                <li>@T("پرداخت امن", "Secure payment", "دفع آمن", "Pago seguro")</li>
            </ul>
        </div>
        <div class="hero-frame">
            <img class="hero2-photo" src="~/images/hero-shirts.jpg" width="1200" height="800" loading="eager" fetchpriority="high"
                 alt="@T("تیشرت‌های چاپ‌شده با طرح‌های دلخواه روی چوب‌لباسی، بسته‌بندی و تیشرت روی زمین", "Printed custom t-shirts on hangers, packaging and a shirt on the floor", "تيشرتات مطبوعة بالتصاميم المخصصة على الشماعات والعبوة والتيشرت على الأرض", "Camisetas personalizadas impresas en perchas, embalaje y una camiseta en el suelo")" />
        <div class="hero2-search reveal">
            <form class="header-search" action="/catalog" method="get" role="search">
                <div class="hs-field">
                    <svg class="hs-icon-mag" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M11 8a3 3 0 0 1 3 3" opacity=".55"/></svg>
                    <input type="search" name="search" placeholder="@T("جستجوی طرح میان هزاران طرح متنوع برای شما...", "Search among thousands of designs...", "ابحث بين آلاف التصاميم...", "Busca entre miles de diseños...")" aria-label="@T("جستجو", "Search", "بحث", "Buscar")" />
                    <label class="mode-toggle compact" title="@T("جستجوی مفهومی: پیدا کردن طرح‌ها بر اساس معنا و مفهوم، نه فقط کلمات", "Concept search: find designs by meaning, not just keywords", "بحث مفاهيمي: إيجاد التصاميم حسب المعنى وليس الكلمات فقط", "Búsqueda por conceptos: encuentra diseños por significado, no solo por palabras clave")">
                        <input type="checkbox" name="mode" value="concept" aria-label="@T("جستجوی مفهومی", "Concept search", "بحث مفاهيمي", "Búsqueda por conceptos")" />
                        <svg class="hs-spark" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5 13.8 8l5.7 1.9-4.7 3.6 1.8 5.9-5.1-3.5-5.1 3.5 1.8-5.9L3.2 9.9 8.9 8z"/><path d="M19 3v4M21 5h-4" stroke-width="1.4"/></svg>
                    </label>
                    <button type="submit" class="hs-go">@T("جستجو", "Search", "بحث", "Buscar")</button>
                </div>
            </form>
            </div>
        </div>
    </div>
</section>

@* ---------- FEATURES: آیکون‌دار — نوار تیره کم‌کنتراست قبلی حذف شد ---------- *@
<section class="features2" aria-label="@T("ویژگی‌ها", "Features", "الميزات", "Características")">
    <div class="container features2-grid">
        <div class="feat2">
            <span class="feat2-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="2"/><path d="m21 15-4-4-9 9"/></svg></span>
            <div><b>@T("طرح‌های متنوع و منحصر", "Diverse & unique designs", "تصاميم متنوعة وفريدة", "Diseños diversos y únicos")</b><small>@T("هزاران طرح از هنرمندان مستقل", "Thousands from independent artists", "آلاف من فنانين مستقلين", "Miles de artistas independientes")</small></div>
        </div>
        <div class="feat2">
            <span class="feat2-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 9V4h12v5M6 18v3h12v-3M4 9h16v9H4z"/><circle cx="9" cy="13.5" r="1.4"/></svg></span>
            <div><b>@T("چاپ DTF با ماندگاری بالا", "Durable DTF printing", "طباعة DTF ثابتة", "Impresión DTF duradera")</b><small>@T("رنگ‌ثبات و دوخت تمیز", "Colorfast inks & clean stitching", "ألوان ثابتة وخياطة نظيفة", "Tintas fijas y costura limpia")</small></div>
        </div>
        <div class="feat2">
            <span class="feat2-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg></span>
            <div><b>@T("بسته‌بندی شیک و امن", "Chic & safe packaging", "تغليف أنيق وآمن", "Embalaje elegante y seguro")</b><small>@T("سالم و مرتب دم درت", "Arrives neat & intact", "يصلك سليمًا ومرتبًا", "Llega intacto y ordenado")</small></div>
        </div>
        <div class="feat2">
            <span class="feat2-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5 6 4-13L16 12h5"/></svg></span>
            <div><b>@T("رهگیری زنده تا تحویل", "Live tracking to delivery", "تتبع مباشر حتى التسليم", "Seguimiento hasta la entrega")</b><small>@T("از کارگاه تا دم در، آنلاین", "Workshop to door, online", "من الورشة إلى بابك، أونلاين", "Del taller a tu puerta, online")</small></div>
        </div>
    </div>
</section>

@* ---------- CATEGORY STRIP ---------- *@
<section class="catstrip-wrap reveal" id="cats">
    <div class="container catstrip-head">
        <button type="button" class="strip-arrow" data-strip-scroll="-1" aria-label="@T("قبلی", "Previous", "السابق", "Anterior")">›</button>
        <div class="catstrip" data-strip>
            <a class="catstrip-card strip-hot" href="/catalog">
                <span class="strip-heart" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 21s-7.5-4.7-10-9.3C.6 8.6 2.4 5 6 5c2.2 0 3.6 1.2 4.5 2.5h3C14.4 6.2 15.8 5 18 5c3.6 0 5.4 3.6 4 6.7-2.5 4.6-10 9.3-10 9.3z"/></svg>
                </span>
                <strong>@T("محبوب‌ترین‌ها", "Most popular", "الأكثر شعبية", "Más populares")</strong>
            </a>
            @foreach (var c in Model.Categories)
            {
                <a class="catstrip-card" href="/catalog?category=@Uri.EscapeDataString(c.Code)">
                    <strong>@c.DisplayName</strong>
                    <small class="muted">@BARANG.B2C.Web.Services.AppDate.Digits(c.Count.ToString("N0"), culture) @T("طرح", "designs", "تصميم", "diseños")</small>
                </a>
            }
        </div>
        <button type="button" class="strip-arrow" data-strip-scroll="1" aria-label="@T("بعدی", "Next", "التالي", "Siguiente")">‹</button>
    </div>
</section>

@* ---------- FEATURED ---------- *@
<section class="container section reveal" id="featured">
    <div class="section-head">
        <h2>@T("طرح‌های منتخب", "Featured designs", "تصاميم مختارة", "Diseños destacados")</h2>
        <a class="link-more" href="/catalog">@T("همه طرح‌ها ←", "All designs →", "كل التصاميم ←", "Todos los diseños →")</a>
    </div>
    @if (Model.Featured.Count == 0)
    {
        <p class="empty">@T("فعلاً طرحی منتشر نشده است.", "No designs published yet.", "لا توجد تصاميم منشورة بعد.", "Aún no hay diseños publicados.")</p>
    }
    else
    {
        <div class="design-grid">
            @foreach (var d in Model.Featured)
            {
                var cardTitle = Model.CardTitle(d.Title);
                <div class="design-card-wrap">
                    <a class="design-card" href="/design/@d.Id">
                        <span class="design-thumb">
                            @if (!string.IsNullOrWhiteSpace(d.Thumbnail))
                            {
                                <img src="@d.Thumbnail" alt="@cardTitle" width="600" height="600" loading="lazy" decoding="async" />
                            }
                        </span>
                        <span class="design-meta">
                            <strong>@cardTitle</strong>
                            @if (!string.IsNullOrWhiteSpace(d.CategoryCode))
                            {
                                <span class="chip">@Model.CatName(d.CategoryCode)</span>
                            }
                        </span>
                        @if (d.FromPrice is { } fp)
                        {
                            <span class="design-price">@T("از", "from", "من", "desde") @Model.PriceFrom(fp) @T("تومان", "Toman", "تومان", "tomán")</span>
                        }
                        <span class="design-hover" aria-hidden="true"><b>@T("سفارش این طرح ←", "Order this design →", "اطلب هذا التصميم ←", "Pedir este diseño →")</b></span>
                    </a>
                    <form method="post" asp-page="/Account/Favorites" asp-page-handler="Toggle" class="card-fav-form">
                        <input type="hidden" name="artworkId" value="@d.Id" />
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="card-fav" title="@T("افزودن به علاقه‌مندی‌ها", "Add to favorites", "أضف إلى المفضلة", "Añadir a favoritos")" aria-label="@T("افزودن به علاقه‌مندی‌ها", "Add to favorites", "أضف إلى المفضلة", "Añadir a favoritos")">♥</button>
                    </form>
                </div>
            }
        </div>
    }
</section>

@* ---------- MASCOT ---------- *@
<section class="container mascot-band reveal">
    <img class="mascot-img" src="~/images/pirang-khan.jpg" asp-append-version="true" alt="@T("پی‌رنگ خان", "Peyrang Khan", "پی‌رنگ خان", "Peyrang Khan")" />
    <div class="mascot-bubble">
        <strong>@T("پی‌رنگ‌خان می‌گه:", "Peyrang Khan says:", "پی‌رنگ‌خان يقول:", "Peyrang Khan dice:")</strong>
        <p class="mascot-slogan">@(string.IsNullOrWhiteSpace(cmsSlogan) ? T("پی‌رنگ؛ طرح دلخواهت را انتخاب کن، ما چاپش می‌کنیم.", "Peyrang: pick a design and we print it!", "پی‌رنگ خان لديه التصاميم من أجلك!", "¡Peyrang Khan tiene los diseños para ti!") : cmsSlogan)</p>
        <a class="btn btn-primary btn-lg btn-shine mascot-cta" href="/order/wizard">@T("شروع طراحی تیشرت ←", "Start designing ←", "ابدأ التصميم ←", "Empezar a diseñar ←")</a>
        <p>@T("هر طرحی پسندیدی، بگو تا با چند کلیک برات چاپش کنیم!", "Pick any design and we'll print it in a few clicks!", "أي تصميم يعجبك نطبعه بضغوطات!", "¡Elige cualquier diseño y lo imprimimos en unos clics!")</p>
        <ul class="mascot-trust" aria-label="@T("تعهد ما", "Our promise", "وعدنا", "Nuestra promesa")">
            <li>✓ @T("کیفیت چاپ تضمینی", "Guaranteed print quality", "جودة طباعة مضمونة", "Calidad de impresión garantizada")</li>
            <li>✓ @T("لغو رایگان تا شروع چاپ", "Free cancellation before printing", "إلغاء مجاني قبل الطباعة", "Cancelación gratis antes de imprimir")</li>
            <li>✓ @T("پشتیبانی پاسخ‌گو", "Responsive support", "دعم متجاوب", "Soporte receptivo")</li>
        </ul>
    </div>
</section>

@* ---------- WHY / ABOUT ---------- *@
<section class="why-band reveal" id="about">
    <div class="container why-grid">
        <div class="why-card">
            <span class="why-icon wi-r"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/><circle cx="12" cy="12" r="4"/></svg></span>
            <h3>@T("طرح‌های متنوع و منحصر", "Diverse & unique designs", "تصاميم متنوعة وفريدة", "Diseños diversos y únicos")</h3>
            <p>@T("هر هفته طرح‌های تازه از طراحی‌های مستقل اضافه می‌شود.", "Fresh designs from independent artists every week.", "تصاميم جديدة كل أسبوع.", "Diseños nuevos de artistas independientes cada semana.")</p>
        </div>
        <div class="why-card">
            <span class="why-icon wi-y"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"/><circle cx="19" cy="17" r="2.5"/></svg></span>
            <h3>@T("چاپ حرفه‌ای روی پارچه", "Professional fabric printing", "طباعة احترافية على القماش", "Impresión profesional en telas")</h3>
            <p>@T("چاپ DTF و سیلک‌اسکرین با ماندگاری بالا.", "DTF and silkscreen printing with high durability.", "طباعة DTF وحجر الطباعة بثبات عالٍ.", "Impresión DTF y serigrafía de alta durabilidad.")</p>
        </div>
        <div class="why-card">
            <span class="why-icon wi-b"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 12h4l2.5 6 4-13L16 12h5"/><circle cx="12" cy="21" r="1"/><circle cx="12" cy="3" r="1"/></svg></span>
            <h3>@T("رهگیری زنده تا تحویل", "Live tracking to delivery", "تتبع مباشر حتى التسليم", "Seguimiento en vivo hasta la entrega")</h3>
            <p>@T("هر مرحله از سفارش را همین‌جا ببینید؛ از کارگاه تا دم در.", "Follow every stage here — from workshop to your door.", "تابع كل مرحلة من الورشة حتى باب منزلك.", "Sigue aquí cada etapa, del taller a tu puerta.")</p>
        </div>
    </div>
</section>

