@page
@model CatalogModel
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar) => culture switch { "en" => en, "ar" => ar, _ => fa };
    ViewData["Title"] = T("کاتالوگ طرح‌ها", "Design catalog", "كتالوج التصاميم");
}
<section class="container section">
    <header class="catalog-head">
        <h1>@T("کاتالوگ طرح‌ها", "Design catalog", "كتالوج التصاميم")</h1>
        @if (Model.ConceptActive)
        {
            <p class="muted">@T($"{Model.ConceptResults.Count} نتیجه مفهومی", $"{Model.ConceptResults.Count} concept matches", $"{Model.ConceptResults.Count} نتيجة مفاهيمية")</p>
        }
        else
        {
            <p class="muted">@T($"{Model.Total} طرح آماده چاپ", $"{Model.Total} print-ready designs", $"{Model.Total} تصميم جاهز للطباعة")</p>
        }
    </header>

    <form class="catalog-filter" action="/catalog" method="get">
        <input type="hidden" name="category" value="@(Model.Category ?? "")" />
        <input type="search" name="search" value="@(Model.Search ?? "")" placeholder="@(Model.ConceptMode ? T("جستجوی مفهومی (مطابقت معنا)…", "Concept search (semantic match)…", "بحث مفاهيمي (مطابقة معنوية)…") : T("جستجو در کد یا نام طرح…", "Search code or title…", "ابحث في الرمز أو العنوان…"))" />
        @if (Model.Page > 1)
        {
            <input type="hidden" name="page" value="1" />
        }
        <label class="mode-toggle" title="@T("جستجوی مفهومی: پیدا کردن طرح‌ها بر اساس معنا و مفهوم، نه فقط کلمات", "Concept search: find designs by meaning, not just keywords", "بحث مفاهيمي: إيجاد التصاميم حسب المعنى وليس الكلمات فقط")">
            <input type="checkbox" name="mode" value="concept" @(Model.ConceptMode ? "checked" : null) aria-label="@T("جستجوی مفهومی", "Concept search", "بحث مفاهيمي")" />
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.8H20l-4.9 3.6 1.9 5.8-5-3.6-5 3.6 1.9-5.8L4 8.8h6.1z"/></svg>
        </label>
        <button class="btn btn-primary" type="submit">@T("جستجو", "Search", "بحث")</button>
    </form>

    @if (Model.Categories.Count > 0)
    {
        <div class="chip-row" role="navigation" aria-label="@T("دسته‌ها", "Categories", "الفئات")">
            <a class="fchip @(string.IsNullOrWhiteSpace(Model.Category) ? "active" : null)" href="/catalog@(string.IsNullOrWhiteSpace(Model.Search) ? "" : "?search=" + Uri.EscapeDataString(Model.Search.Trim()))">@T("همه", "All", "الكل")</a>
            @foreach (var cat in Model.Categories)
            {
                <a class="fchip @(Model.Category == cat.Code ? "active" : null)" href="/catalog?category=@Uri.EscapeDataString(cat.Code)@(string.IsNullOrWhiteSpace(Model.Search) ? "" : "&search=" + Uri.EscapeDataString(Model.Search.Trim()))@(Model.ConceptMode ? "&mode=concept" : "")" title="@cat.DisplayName">@(string.IsNullOrWhiteSpace(cat.DisplayName) ? cat.Code : cat.DisplayName) <small>@cat.Count</small></a>
            }
        </div>
    }

    @if (Model.ConceptMode && !Model.ConceptActive)
    {
        <p class="empty">@T("برای جستجوی مفهومی، حداقل ۲ نویسه بنویسید.", "Type at least 2 characters for concept search.", "اكتب حرفين على الأقل للبحث المفاهيمي.")</p>
    }

    @if (Model.ConceptActive)
    {
        <div class="section-head" style="margin-top:.4rem">
            <h2>@T("جستجوی مفهومی", "Concept search", "البحث المفهومي")</h2>
            <span class="chip">@T("مرتب‌شده بر اساس شباهت معنایی", "sorted by semantic match", "مرتب حسب التشابه الدلالي")</span>
        </div>
        @if (Model.ConceptResults.Count == 0)
        {
            <p class="empty">@T("طرح مشابه‌ای برای این عبارت پیدا نشد.", "No similar designs for this phrase.", "لا توجد تصاميم مشابهة.")</p>
        }
        else
        {
            <div class="design-grid">
                @foreach (var m in Model.ConceptResults)
                {
                    <a class="design-card" href="/design/@m.Id">
                        <span class="design-thumb">
                            @if (!string.IsNullOrWhiteSpace(m.Thumbnail))
                            {
                                <img src="@m.Thumbnail" alt="@m.Title" width="600" height="600" loading="lazy" decoding="async" />
                            }
                        </span>
                        <span class="design-meta">
                            <strong>@m.Title</strong>
                            <span class="score-chip">@m.Score٪ @T("تطابق", "match", "تطابق")</span>
                        </span>
                    </a>
                }
            </div>
        }
    }

    @if (!Model.ConceptMode)
    {
        @if (Model.Designs.Count == 0)
        {
            <p class="empty">@T("طرحی با این جستجو پیدا نشد.", "No designs match your search.", "لا توجد تصاميم مطابقة.")</p>
        }
        else
        {
        <div class="design-grid">
            @foreach (var d in Model.Designs)
            {
                <div class="design-card-wrap">
                    <a class="design-card" href="/design/@d.Id">
                        <span class="design-thumb">
                            @if (!string.IsNullOrWhiteSpace(d.Thumbnail))
                            {
                                <img src="@d.Thumbnail" alt="@d.Title" width="600" height="600" loading="lazy" decoding="async" />
                            }
                        </span>
                        <span class="design-meta">
                            <strong>@d.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(Model.CategoryNames.GetValueOrDefault(d.CategoryCode ?? "")))
                            {
                                <span class="chip">@Model.CategoryNames.GetValueOrDefault(d.CategoryCode ?? "")</span>
                            }
                            @if (d.FromPrice is decimal fp && fp > 0)
                            {
                                <span class="price-from">@T("از", "from", "من") @fp.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo(culture == "en" ? "en" : "fa")) @T("تومان", "Toman", "تومان")</span>
                            }
                        </span>
                    </a>
                    @if (Model.IsAuthenticated)
                    {
                        <form method="post" asp-page="/Account/Favorites" asp-page-handler="Toggle" class="fav-heart-form">
                            <input type="hidden" name="artworkId" value="@d.Id" />
                            <input type="hidden" name="returnUrl" value="@Model.CurrentUrl" />
                            <button type="submit" class="fav-heart @(Model.FavoriteIds.Contains(d.Id.ToString()) ? "on" : null)" title="@T("علاقه‌مندی", "Favorite", "مفضل")" aria-label="@T("افزودن/حذف از علاقه‌مندی‌ها", "Toggle favorite", "تبديل المفضلة")">♥</button>
                        </form>
                    }
                </div>
            }
        </div>

        <nav class="pagination" aria-label="@T("صفحه‌بندی", "Pagination", "ترقيم الصفحات")">
            @if (Model.HasPrev)
            {
                <a class="btn btn-ghost btn-sm" href="@Model.PageLink(Model.Page - 1)">← @T("قبلی", "Previous", "السابق")</a>
            }
            <span class="page-info">@Model.Page / @Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Model.PageSize))</span>
            @if (Model.HasNext)
            {
                <a class="btn btn-ghost btn-sm" href="@Model.PageLink(Model.Page + 1)">@T("بعدی", "Next", "التالي") →</a>
            }
        </nav>
    }
    }
</section>
