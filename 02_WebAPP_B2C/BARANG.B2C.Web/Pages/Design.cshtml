@page "/design/{id:guid}"
@model DesignModel
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    string T(string fa, string en, string ar, string? es = null) => culture switch { "en" => en, "ar" => ar, "es" => es ?? en, _ => fa };
}
@if (!Model.Found)
{
    <section class="container section"><p class="empty">@T("این طرح پیدا نشد.", "This design was not found.", "لم يتم العثور على هذا التصميم.", "Este diseño no fue encontrado.")</p></section>
}
else
{
    ViewData["OgType"] = "product";
    if (!string.IsNullOrWhiteSpace(Model.Preview))
    {
        ViewData["OgImage"] = Model.Preview;
    }

    var ld = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Product",
            ["name"] = Model.Title,
            ["sku"] = Model.Code,
            ["category"] = Model.CategoryCode ?? "",
            ["description"] = Model.Description ?? Model.Title,
            ["image"] = Model.Thumbnail,
            ["offers"] = new Dictionary<string, object?>
            {
                ["@type"] = "Offer",
                ["availability"] = "https://schema.org/InStock",
                ["priceCurrency"] = "IRR"
            }
        });
    <script type="application/ld+json">@Html.Raw(ld)</script>
    <section class="container section design-detail">
        <nav class="breadcrumbs" aria-label="breadcrumb">
            <a href="/">@T("خانه", "Home", "الرئيسية", "Inicio")</a> ›
            <a href="/catalog">@T("کاتالوگ", "Catalog", "الكتالوج", "Catálogo")</a> ›
            <span>@BARANG.B2C.Web.Services.Display.Title(Model.Title, culture)</span>
        </nav>
        <figure class="design-hero">
            @if (!string.IsNullOrWhiteSpace(Model.Preview))
            {
                <img src="@Model.Preview" alt="@BARANG.B2C.Web.Services.Display.Title(Model.Title, culture)" />
            }
            else if (!string.IsNullOrWhiteSpace(Model.Thumbnail))
            {
                <img src="@Model.Thumbnail" alt="@BARANG.B2C.Web.Services.Display.Title(Model.Title, culture)" />
            }
            <figcaption class="muted">@T("پیش‌نمایش با علامت آب — فایل اصلی پس از سفارش تحویل می‌شود.", "Watermarked preview — the original file is delivered with your order.", "معاينة بعلامة مائية — يُسلّم الملف الأصلي مع طلبك.", "Vista previa con marca de agua: el archivo original se entrega con tu pedido.")</figcaption>
        </figure>
        <div class="design-specs">
            <h1>@BARANG.B2C.Web.Services.Display.Title(Model.Title, culture)</h1>
            <p class="design-code" dir="ltr">@Model.Code</p>
            @if (!string.IsNullOrWhiteSpace(Model.CategoryCode))
            {
                <span class="chip">@Model.CategoryCode</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="design-desc">@Model.Description</p>
            }
            <ul class="design-notes">
                <li>@T("فایل اصلی بدون علامت آب با کیفیت چاپ تحویل می‌شود.", "Original watermark-free print-quality file is delivered.", "يُسلّم الملف الأصلي بجودة الطباعة بدون علامة مائية.", "Se entrega el archivo original con calidad de impresión y sin marca de agua.")</li>
                <li>@T("امکان افزودن فایل طرح اختصاصی شما.", "You can attach your own custom file.", "يمكنك إرفاق ملفك الخاص.", "Puedes adjuntar tu propio archivo.")</li>
            </ul>
            <div class="design-cta">
                <a class="btn btn-primary btn-lg" href="/order/wizard?design=@Model.Id">@T("با همین طرح تیشرتت رو طراحی کن", "Design your shirt with this", "صمّم تيشيرتك بهذا التصميم", "Diseña tu camiseta con este")</a>
            </div>
        </div>
        @if (Model.Similar.Count > 0)
        {
            <div class="section-head" style="margin-top:1.6rem">
                <h2>@T("طرح‌های مشابه", "Similar designs", "تصاميم مشابهة", "Diseños similares")</h2>
                <span class="chip">@T("جستجوی مفهومی", "concept search", "بحث مفهومي", "búsqueda por conceptos")</span>
            </div>
            <div class="design-grid">
                @foreach (var sm in Model.Similar)
                {
                    <a class="design-card" href="/design/@sm.Id">
                        <span class="design-thumb">
                            @if (!string.IsNullOrWhiteSpace(sm.Thumbnail))
                            {
                                <img src="@sm.Thumbnail" alt="@BARANG.B2C.Web.Services.Display.Title(sm.Title, culture)" width="600" height="600" loading="lazy" decoding="async" />
                            }
                        </span>
                        <span class="design-meta">
                            <strong>@BARANG.B2C.Web.Services.Display.Title(sm.Title, culture)</strong>
                            <span class="score-chip">@BARANG.B2C.Web.Services.AppDate.Percent(sm.Score, culture) @T("تطابق", "match", "تطابق", "coincidencia")</span>
                        </span>
                    </a>
                }
            </div>
        }
    </section>
}
